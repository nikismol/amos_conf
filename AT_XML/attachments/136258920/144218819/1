    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="234_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac.ac_registr" id="ac.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             to_char(to_date('31.12.1971' 'dd.mm.yyyy') + ac.validity'dd.mm.yyyy') as last_arrivail_date" id="last_arrivail_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac.leg_number" id="ac.leg_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.description" id="wp_header.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.station" id="wp_header.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;            to_char(to_date('31.12.1971' 'dd.mm.yyyy') + wp_header.start_date'dd.mm.yyyy') as sched_start_date" id="sched_start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             DECODE(wp_header.wp_status -1 'OPEN' -2 'CLOSED' -3 'IN_PROGRESS''') as wp_status" id="wp_status"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ac.ac_registr,
             to_char(to_date('31.12.1971', 'dd.mm.yyyy') + ac.validity, 'dd.mm.yyyy') as last_arrivail_date,
             ac.leg_number,
             wp_header.wpno,
             wp_header.description,
             wp_header.station,
             to_char(to_date('31.12.1971', 'dd.mm.yyyy') + wp_header.start_date, 'dd.mm.yyyy') as sched_start_date,
             DECODE(wp_header.wp_status, -1, 'OPEN', -2, 'CLOSED', -3, 'IN_PROGRESS', '') as wp_status
FROM (
             select ac_utilization.ac_registr,
                        ac_utilization.validity,
                        max(ac_utilization.validity) over (partition by ac_utilization.ac_registr) as max_validity,
                        ac_utilization.legno_i,
                        ac_utilization.null_leg_commited,
                        ac_utilization.leg_number,
                        ac_utilization.recno,
                        max (ac_utilization.recno) over (partition by ac_utilization.ac_registr, ac_utilization.validity) as max_recno 
             from ac_utilization
             join aircraft on ac_utilization.ac_registr=aircraft.ac_registr AND aircraft.status&lt;&gt;9
             where 1=1
                         and aircraft.ac_typ='B737'
                         and ac_utilization.null_leg_commited=0
                         and ac_utilization.recno&gt;0
            ) ac
LEFT JOIN wp_header ON ac.ac_registr=wp_header.ac_registr AND wp_header.station='ZZZ' AND UPPER(wp_header.description) LIKE ('%PARKING%') AND wp_header.start_date&gt;=ac.validity AND wp_header.wp_status IN (-1, -2, -3)
WHERE 1=1
             AND validity=max_validity
             AND recno=max_recno
             AND validity &lt;= TRUNC (SYSDATE) - TO_DATE ('31.12.1971', 'dd.mm.yyyy') - 6
             AND wp_header.wpno_i is NULL
ORDER BY 2, 4</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="234_CURRENT_DATE" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
