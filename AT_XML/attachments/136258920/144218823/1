      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT&#10;            &#9;aircraft.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.ata_chapter as ata_chapter" id="ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.revision_no as Rev_no" id="Rev_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno as taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="check_type_int.internal_check as checkaA" id="checkaA"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.partno as parto" id="parto"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.qty as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event_finding.event_perfno_i as WO" id="WO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.header as WO_header" id="WO_header"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char (wo_text_description.text) as textik" id="textik"/>
