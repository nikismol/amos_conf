      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT
            	aircraft.ac_typ as ac_typ,
            	wo_header.ac_registr as ac_registr,
 	           msc_taskcard.ata_chapter as ata_chapter,
            	msc_taskcard_version.revision_no as Rev_no,
                            msc_taskcard.taskcardno as taskcardno,
                            check_type_int.internal_check as checkaA,
                            part_request_2.partno as parto,
	            part_request_2.qty as qty,
                           event_finding.event_perfno_i as WO,
                           wo_text_description.header as WO_header,
            	to_char (wo_text_description.text) as textik
FROM msc_taskcard_version
	JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i=msc_taskcard.taskcardno_i
	JOIN msc_maintenance_program ON msc_taskcard.mpno_i=msc_maintenance_program.mpno_i 
               		AND msc_maintenance_program.mpno IN ('A32S', 'B737', 'A330', 'B777', 'RRJ', 'A350')
	JOIN msc_requirement_tc_link ON msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i 
                  	             AND (   msc_maintenance_program.mpno='B737' AND msc_taskcard.taskcardno='B3-25-0304' 
                    	 		OR msc_maintenance_program.mpno='B777' AND msc_taskcard.taskcardno='05-00-00-AFL' 
                     			OR msc_maintenance_program.mpno='RRJ' AND msc_taskcard.taskcardno='256000MT-AFL02' 
                     	 	               OR msc_maintenance_program.mpno='A32S' AND msc_taskcard.taskcardno='256652-01-AFL' 
                    	 		OR msc_maintenance_program.mpno='A330' AND msc_taskcard.taskcardno='A30-25-0538' 
                     	 	               OR msc_maintenance_program.mpno='A350' AND msc_taskcard.taskcardno='256XXX-00M03-AFL' 
                                                          )
	JOIN wo_event_link ON wo_event_link.event_key_parent = msc_requirement_tc_link.req_linkno_i
                  	              AND (wo_event_link.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MET' AND '@AMOS_VERSION@' NOT LIKE '19.12%') 
	JOIN event_finding ON wo_event_link.effectivity_linkno_i = event_finding.headerno_i AND event_finding.primkey = wo_event_link.event_perfno_i 
                    	            AND event_finding.header_type = 'EFL' 
	JOIN wo_header ON event_finding.event_perfno_i = wo_header.event_perfno_i
	LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
	JOIN aircraft ON aircraft.ac_registr = wo_header.ac_registr
	JOIN workstep_link ON event_finding.event_perfno_i = workstep_link.event_perfno_i
	JOIN wo_text_description ON workstep_link.descno_i = wo_text_description.descno_i
	JOIN wo_event_chain ON wo_event_chain.source_event_perfno_i = wo_event_link.event_perfno_i
	JOIN wo_event_link wo_event_link_check ON wo_event_link_check.event_perfno_i = wo_event_chain.target_event_perfno_i
	JOIN check_type_int ON check_type_int.check_intno_i = wo_event_link_check.event_key_parent
	JOIN check_type on check_type_int.checkno_i = check_type.checkno_i
	LEFT JOIN part_request_2 ON part_request_2.event_key = workstep_link.workstep_linkno_i AND part_request_2.event_type = 'WSL'
WHERE (
                               REGEXP_LIKE(wo_text_description.header, '(LIFE VEST)','i')
        	OR REGEXP_LIKE(wo_text_description.text, '(LIFE VEST)','i')
                 )
                 AND check_type.check_type = 'A'
                 AND  part_request_2.partno in ('63600-101',
                                   		             '63600-501',
                                    		            '216201-0-AFL',
                                     		           'P01202-101',
                                   		             '63600-587',
                                  		              '63600-187'
                                                                               )
	AND (wo_header.issue_date&gt;= '@VAR.v01_date_from@' OR '@VAR.v01_date_from@' IS NULL)
	AND (wo_header.issue_date&lt;='@VAR.v02_date_to@' OR '@VAR.v02_date_to@' IS NULL)
ORDER BY 1</se:textStatement>
        </se:sqlStatement>
