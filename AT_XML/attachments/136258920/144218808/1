    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_APU_PSN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="NVL ( r.psnh.psn) as psn" id="psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             NVL (r.partnoh.partno) as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             NVL (r.serialnoh.serialno) as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             DECODE(r.psn NULL h.historyno_iNULL) as historyno_i" id="historyno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + apu.del_date'dd.mm.yyyy') as del_date" id="del_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu.labelno as labelno" id="labelno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_partno@">
          <ds:object>@VAR.v01_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_serialno@">
          <ds:object>@VAR.v02_serialno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT apu.psn as psn,
             apu.partno as partno,
             apu.serialno serialno,
             apu.historyno_i as historyno_i,
             part.description as description,
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + apu.del_date, 'dd.mm.yyyy') as del_date,
             apu.labelno as labelno
FROM (
             SELECT history.psn,
                          history.partno,
                          history.serialno,
                          history.historyno_i,
                          MAX (history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i,
                          history.del_date,
                          history.labelno
             FROM history
             join part_special ON history.partno=part_special.partno AND part_special.special IN ('APU')
             WHERE history.psn&gt;0
             AND (REGEXP_LIKE(history.partno, REPLACE('@VAR.v01_partno@', ', ', '|')) OR '@VAR.v01_partno@' IS NULL )
             AND (REGEXP_LIKE(history.serialno, REPLACE('@VAR.v02_serialno@', ', ', '|')) OR '@VAR.v02_serialno@' IS NULL)
            ) apu
LEFT JOIN rotables ON apu.psn=rotables.psn
LEFT JOIN part ON apu.partno=part.partno
WHERE historyno_i=max_historyno_i
              AND rotables.psn is null
ORDER BY historyno_i DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
