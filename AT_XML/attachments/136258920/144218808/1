    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_APU_TREE_PSN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu_tree.psn as psn" id="psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu_tree.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu_tree.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu_tree.partno_root as partno_root" id="partno_root"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu_tree.serialno_root as serialno_root" id="serialno_root"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             TO_CHAR(TO_DATE('31.12.2971' 'dd.mm.yyyy') + apu_tree.del_date'dd.mm.yyyy') as del_date" id="del_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" &#10;             TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + apu_tree.root_del_date'dd.mm.yyyy') as root_del_date" id="root_del_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu_tree.vm as vm" id="vm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu_tree.root_vm as root_vm" id="root_vm"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_APU_PSN.psn@">
          <ds:object>@AFL_APU_PSN.psn@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT apu_tree.psn as psn,
             apu_tree.partno as partno,
             apu_tree.serialno as serialno,
             part.description as description,
             apu_tree.partno_root as partno_root,
             apu_tree.serialno_root as serialno_root,
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + apu_tree.del_date, 'dd.mm.yyyy') as del_date, 
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + apu_tree.root_del_date, 'dd.mm.yyyy') as root_del_date,
             apu_tree.vm as vm,
             apu_tree.root_vm as root_vm
FROM (
             SELECT psn,
                          partno,
                          serialno,
                          del_date,
                          vm,
                          CONNECT_BY_ROOT psn as psn_root,
                          CONNECT_BY_ROOT partno as partno_root,
                          CONNECT_BY_ROOT serialno as serialno_root,
                          CONNECT_BY_ROOT historyno_i as root_historyno_i,
                          CONNECT_BY_ROOT vm as root_vm,
                          CONNECT_BY_ROOT del_date as root_del_date
             FROM(
                         SELECT h.psn,
                                      h_parent.psn as psn_parent,
                                      h.partno,
                                      h.serialno,
                                      h.higher_partno,
                                      h.higher_serialno,
                                      h.historyno_i,
                                      h.del_date,
                                      h.vm
                          FROM (
                                      SELECT history.psn,
                                                   history.partno,
                                                   history.serialno,
                                                   history.higher_partno,
                                                   history.higher_serialno,
                                                   history.historyno_i,
                                                   MAX(history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i,
                                                   history.del_date,
                                                   history.transaction_id,
                                                   history.vm
                                      FROM history
                                      WHERE history.vm IN ('DE', 'LE', 'PS', 'EX', 'OC', 'SJ')
                                     ) h
                         LEFT JOIN (
                                            SELECT history.psn,
                                                         history.partno,
                                                         history.serialno,
                                                         history.historyno_i,
                                                         MAX(history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i,
                                                         history.transaction_id
                                            FROM history
                                            WHERE history.vm IN ('DE', 'LE', 'PS', 'EX', 'OC', 'SJ')
                                           ) h_parent ON h_parent.partno=h.higher_partno AND h_parent.serialno=h.higher_serialno AND h_parent.historyno_i=h_parent.max_historyno_i AND h.transaction_id = h_parent.transaction_id
                         WHERE h.historyno_i=h.max_historyno_i
                        ) ht
             START WITH ht.psn_parent IS NULL
             CONNECT BY PRIOR ht.psn=ht.psn_parent
            ) apu_tree
LEFT JOIN part ON apu_tree.partno=part.partno
WHERE apu_tree.psn_root='@AFL_APU_PSN.psn@'
              AND apu_tree.psn_root&lt;&gt;apu_tree.psn</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
