    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="Full tab" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>full tab</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpno" id="wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" &#10;&#9;TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (end_date)'DD.MM.YYYY') as end_date1" id="end_date1"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9; TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (act_end_date)'DD.MM.YYYY') as act_end_date1" id="act_end_date1"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateF@">
          <ds:object>@VAR.dateF@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateTO@">
          <ds:object>@VAR.dateTO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac@">
          <ds:object>@VAR.ac@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT ac_registr, 
	wpno, 
	description, 
	TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (end_date), 'DD.MM.YYYY') as end_date1,
	 TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (act_end_date), 'DD.MM.YYYY') as act_end_date1	
	FROM wp_header
WHERE description NOT LIKE 'AOG%'
AND description NOT LIKE 'ADD%'
AND description NOT LIKE 'F%'
AND description NOT LIKE 'BDCA'
AND description NOT LIKE 'BCAA'
AND description NOT LIKE 'DY%'
AND description NOT LIKE '3DY%'
AND description NOT LIKE 'T%'
AND description NOT LIKE 'УСТР%'
AND description NOT LIKE 'МОЙК%'
AND description NOT LIKE 'STAND%'
AND description NOT LIKE 'A0G'
AND start_date &gt;= '@VAR.dateF@' 
AND start_date &lt;= '@VAR.dateTO@'
AND ac_registr = '@VAR.ac@'
ORDER BY end_date</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="Вывод даты (с, по)" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE(`01.01.1970``DD.MM.YYYY`) + (`@VAR.DateF@`+729)`DD.Mon.YYYY`) as d_beg" id="d_beg"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970''DD.MM.YYYY') + ('@VAR.DateTO@'+729)'DD.Mon.YYYY') as d_end" id="d_end"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateF@">
          <ds:object>@VAR.dateF@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateTO@">
          <ds:object>@VAR.dateTO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT
TO_CHAR(TO_DATE('31.12.1971','DD.MM.YYYY') + ('@VAR.dateF@'),'DD.Mon.YYYY') as d_beg,
TO_CHAR(TO_DATE('31.12.1971','DD.MM.YYYY') + ('@VAR.dateTO@'),'DD.Mon.YYYY') as d_end 
FROM dual</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
