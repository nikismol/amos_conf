        <ds:columnDescriptor amosType="ALPHANUM" description="&#10; TRUNC(MONTHS_BETWEEN(TO_DATE(SYSDATE 'DD.MM.YY') TO_DATE(forecast_error.mfg_date 'DD.MM.YYYY'))/12)||'y '&#10; ||TRUNC(MONTHS_BETWEEN(TO_DATE(SYSDATE 'DD.MM.YY') TO_DATE(forecast_error.mfg_date 'DD.MM.YYYY'))-(TRUNC(MONTHS_BETWEEN(TO_DATE(SYSDATE 'DD.MM.YY') TO_DATE(forecast_error.mfg_date 'DD.MM.YYYY'))/12)*12))||'m '&#10; ||TO_CHAR(TRUNC(SYSDATE)-ADD_MONTHS(TO_DATE(forecast_error.mfg_date 'DD.MM.YYYY') trunc(MONTHS_BETWEEN(TO_DATE(SYSDATE 'DD.MM.YY') TO_DATE(forecast_error.mfg_date'DD.MM.YYYY')))))||'d ' as age" id="age"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast_error.event_display" id="forecast_error.event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast_error.ac_registr" id="forecast_error.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast_error.ac_typ" id="forecast_error.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;       TRUNC(forecast_error.togo/24/600)||forecast_error.dimension as to_go" id="to_go"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(forecast_error.interval_value)||forecast_error.interval_dimension as interval" id="interval"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT forecast_error.partno,
       forecast_error.serialno,
       SYS_CONNECT_BY_PATH (treq_interval.amount_interval||' '||treq_interval.unit, '-&gt;') as requirements,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (forecast_error.num_mfg_date+729), 'DD.MM.YYYY') as mfg_date,
 TRUNC(MONTHS_BETWEEN(TO_DATE(SYSDATE, 'DD.MM.YY'), TO_DATE(forecast_error.mfg_date, 'DD.MM.YYYY'))/12)||'y '
 ||TRUNC(MONTHS_BETWEEN(TO_DATE(SYSDATE, 'DD.MM.YY'), TO_DATE(forecast_error.mfg_date, 'DD.MM.YYYY'))-(TRUNC(MONTHS_BETWEEN(TO_DATE(SYSDATE, 'DD.MM.YY'), TO_DATE(forecast_error.mfg_date, 'DD.MM.YYYY'))/12)*12))||'m '
 ||TO_CHAR(TRUNC(SYSDATE)-ADD_MONTHS(TO_DATE(forecast_error.mfg_date, 'DD.MM.YYYY'), trunc(MONTHS_BETWEEN(TO_DATE(SYSDATE, 'DD.MM.YY'), TO_DATE(forecast_error.mfg_date, 'DD.MM.YYYY')))))||'d ' as age,
       forecast_error.event_display,
       forecast_error.ac_registr,
       forecast_error.ac_typ,

       TRUNC(forecast_error.togo/24/60, 0)||forecast_error.dimension as to_go,
       TO_NUMBER(forecast_error.interval_value)||forecast_error.interval_dimension as interval

FROM
part
LEFT JOIN part_req ON part.partseqno_i = part_req.partseqno_i 
LEFT JOIN part_add_req ON part_req.reqseqno_i = part_add_req.reqseqno_i
LEFT JOIN treq_time_requirement ON part_add_req.add_reqseqno_i=treq_time_requirement.event_key
LEFT JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i
LEFT JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
LEFT JOIN (SELECT treq_interval_group.interval_groupno_i as interval_groupno_i,
                  treq_interval.dimension_type as dimension_type,
                  treq_interval.counter_defno_i as counter_defno_i
           FROM treq_interval_group
           LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i
          ) check_parent ON check_parent.interval_groupno_i=treq_interval_group.parent_interval_groupno_i 
LEFT JOIN (SELECT wo_event_link.event_key_parent,
                  forecast.partno,
                  forecast.serialno,
                  forecast.event_display,
                  forecast.ac_registr,
                  forecast.ac_typ,
                  forecast.station,
                  TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (rotables.mfg_date+729), 'DD.MM.YYYY') as mfg_date,
                  rotables.mfg_date as num_mfg_date,
                  forecast.togo,
                  forecast.since_req,
                  forecast.absolute_due_at_ac,
                  forecast.relative_due_at,
                  forecast.interval_value,
                  forecast.ref_date,
                  forecast.expected_date,
                  forecast.expected_time,
                  forecast.expected_date_pln,
                  forecast.expected_time_pln,
                  forecast.date_planned,
                  forecast.planned_time,
                  forecast.togo_pln,
                  forecast.wpno_i,
                  forecast.workorderno_display,
                  forecast.event_perfno_i,
                  forecast.status,
                  forecast.dimension,
                  forecast.interval_dimension
            FROM wo_event_link
            LEFT JOIN forecast ON forecast.event_perfno_i = wo_event_link.event_perfno_i
            LEFT JOIN rotables ON forecast.psn=rotables.psn
            WHERE wo_event_link.event_type = 'RORE' 
                  AND wo_event_link.pending_status &gt;= 0 
                  AND wo_event_link.pending_status &lt;= 0 
                  AND wo_event_link.planable_status = 0
                  AND forecast.event_type='R'
                  AND forecast.calculation_status='E'

           ) forecast_error ON forecast_error.event_key_parent = part_req.reqseqno_i
WHERE treq_time_requirement.event_type = 'RORE'
      AND treq_time_requirement.status='0'
      AND treq_interval.dimension_type='I'
      AND treq_time_requirement.type = 'OP'
      AND check_parent.dimension_type='I'
      AND treq_interval.counter_defno_i='3'
      AND check_parent.counter_defno_i='3'
      AND CONNECT_BY_ISLEAF=1
      AND forecast_error.event_perfno_i IS NOT NULL
START WITH treq_interval_group.parent_interval_groupno_i IS NULL
CONNECT BY PRIOR treq_interval_group.interval_groupno_i=treq_interval_group.parent_interval_groupno_i</se:textStatement>
