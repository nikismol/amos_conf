    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="235_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="(select ac_typ from aircraft where aircraft.ac_registr=s.ac_registr) as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.legno_i as arrival_legno_i" id="arrival_legno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s2.root_legno_i as departure_legno_i" id="departure_legno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.count_null_legs as count_null_legs" id="count_null_legs"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v06_active_ac@">
          <ds:object>@VAR.v06_active_ac@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_ac_typ@">
          <ds:object>@VAR.v04_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_ac_registr@">
          <ds:object>@VAR.v05_ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_null_legs@">
          <ds:object>@VAR.v03_null_legs@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v07_show_every_x_parking_day@">
          <ds:object>@VAR.v07_show_every_x_parking_day@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v09_excluded_wp_heavy@">
          <ds:object>@VAR.v09_excluded_wp_heavy@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v10_is_parked_now_only@">
          <ds:object>@VAR.v10_is_parked_now_only@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT s.ac_typ as ac_typ,
             s.ac_registr as ac_registr,
             s.root_legno_i as arrival_legno_i,
             s2.legno_i as departure_legno_i,
             s.count_null_legs as count_null_legs
FROM (
             SELECT n.ac_registr,
                          n.ac_typ,
                          n.root_legno_i,
                          n.count_null_legs
             FROM (
                          SELECT a.ac_registr,
                                       a.ac_typ,
                                       a.legno_i,
                                       connect_by_root a.legno_i as root_legno_i,
                                       COUNT(a.legno_i) OVER (PARTITION BY connect_by_root a.legno_i) as count_null_legs,
                                       level as lev,
                                       MAX (level) OVER (PARTITION BY connect_by_root a.legno_i) as max_lev
                          FROM ( 
                                       SELECT ac_utilization.ac_registr,
                                                    aircraft.ac_typ,
                                                    ac_utilization.legno_i,
                                                    u2.legno_i as parent_legno_i
                                       FROM ac_utilization /* all null legs */
                                       JOIN aircraft ON ac_utilization.ac_registr=aircraft.ac_registr AND (aircraft.status&lt;&gt;9 OR '@VAR.v06_active_ac@'='N')
                                                                                                                                                    AND (aircraft.ac_typ='@VAR.v04_ac_typ@' OR '@VAR.v04_ac_typ@'='ALL')
                                       LEFT JOIN ac_utilization u2 ON ac_utilization.ac_registr=u2.ac_registr AND u2.validity+1=ac_utilization.validity
                                                                                                                                                                      AND u2.recno=0
                                                                                                                                                                      AND u2.validity between @VAR.v01_date_from@ AND @VAR.v02_date_to@
                                       WHERE 1=1
                                                     AND ac_utilization.recno=0
                                                     AND ac_utilization.validity between @VAR.v01_date_from@ AND @VAR.v02_date_to@
                                                     AND (REGEXP_LIKE(ac_utilization.ac_registr, REPLACE('@VAR.v05_ac_registr@', ', ', '|')) OR '@VAR.v05_ac_registr@' IS NULL)
                                      ) a
                          START WITH a.parent_legno_i is NULL
                          CONNECT BY PRIOR a.legno_i=a.parent_legno_i
                         ) n
             WHERE 1=1
                           AND n.count_null_legs&gt;=@VAR.v03_null_legs@
                           AND (MOD (n.count_null_legs, '@VAR.v07_show_every_x_parking_day@') = 0 OR '@VAR.v07_show_every_x_parking_day@' IS NULL)
                           AND n.legno_i=n.root_legno_i
            ) s
JOIN (
          SELECT n.ac_registr,
                       n.ac_typ,
                       n.legno_i,
                       n.root_legno_i
          FROM (
                       SELECT a.ac_registr,
                                    a.ac_typ,
                                    a.legno_i,
                                    connect_by_root a.legno_i as root_legno_i,
                                    COUNT(a.legno_i) OVER (PARTITION BY connect_by_root a.legno_i) as count_null_legs,
                                    level as lev,
                                    MAX (level) OVER (PARTITION BY connect_by_root a.legno_i) as max_lev
                       FROM ( 
                                    SELECT ac_utilization.ac_registr,
                                                 aircraft.ac_typ,
                                                 ac_utilization.legno_i,
                                                 u2.legno_i as parent_legno_i
                                    FROM ac_utilization /* all null legs */
                                    JOIN aircraft ON ac_utilization.ac_registr=aircraft.ac_registr AND (aircraft.status&lt;&gt;9 OR '@VAR.v06_active_ac@'='N')
                                                                                                                                                 AND (aircraft.ac_typ='@VAR.v04_ac_typ@' OR '@VAR.v04_ac_typ@'='ALL')
                                    LEFT JOIN ac_utilization u2 ON ac_utilization.ac_registr=u2.ac_registr AND u2.validity+1=ac_utilization.validity 
                                                                                                                                                                  AND u2.recno=0
                                                                                                                                                                  AND u2.validity between @VAR.v01_date_from@ AND @VAR.v02_date_to@
                                    WHERE 1=1
                                                  AND ac_utilization.recno=0
                                                  AND ac_utilization.validity between @VAR.v01_date_from@ AND @VAR.v02_date_to@
                                                  AND (REGEXP_LIKE(ac_utilization.ac_registr, REPLACE('@VAR.v05_ac_registr@', ', ', '|')) OR '@VAR.v05_ac_registr@' IS NULL)
                                   ) a
                       START WITH a.parent_legno_i is NULL
                       CONNECT BY PRIOR a.legno_i=a.parent_legno_i
                      ) n
          WHERE 1=1
                        AND n.count_null_legs&gt;=@VAR.v03_null_legs@
                        AND (MOD (n.count_null_legs, '@VAR.v07_show_every_x_parking_day@') = 0 OR '@VAR.v07_show_every_x_parking_day@' IS NULL)
                        AND n.lev=n.max_lev
         ) s2 ON s.root_legno_i=s2.root_legno_i 
LEFT JOIN (
                   SELECT 'Y' as is_current_heavy_wp,
                                 wp_header.ac_registr
                   FROM wp_header
                   WHERE 1=1
                                 AND '@VAR.v09_excluded_wp_heavy@' = 'YES'
                                 AND wp_header.hidden = 'H'
                                 AND wp_header.status = -1
		    AND (/* выбираю пакеты, которые "выполняются" на момент выгрузки отчета */ 
                                          NVL(case when wp_header.act_start_date&gt;0 and wp_header.act_start_time&gt;0
                                                            then TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.act_start_date, 'day') + NUMTODSINTERVAL(wp_header.act_start_time * 60, 'SECOND')
                                                            else null
                                                   end,
                                                   TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.start_date, 'day') + NUMTODSINTERVAL(wp_header.start_time * 60, 'SECOND')
                                                  ) AT TIME ZONE 'Europe/Moscow'
                                                    BETWEEN from_tz(CAST (TRUNC(systimestamp)+ numtodsinterval(0, 'day') AS TIMESTAMP), 'Europe/Moscow')
                                                                       AND from_tz(CAST (TRUNC(systimestamp)+ numtodsinterval(0, 'day') AS TIMESTAMP), 'Europe/Moscow')
                                               OR
                                                  NVL(
                                                          case when wp_header.act_start_date&gt;0 and wp_header.act_start_time&gt;0
                                                                   then TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.act_start_date, 'day') + NUMTODSINTERVAL(wp_header.act_start_time * 60, 'SECOND')
                                                                   else null
                                                          end,
                                                          TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.start_date, 'day') + NUMTODSINTERVAL(wp_header.start_time * 60, 'SECOND')
                                                         ) AT TIME ZONE 'Europe/Moscow' &lt; from_tz(CAST (TRUNC(systimestamp)+ numtodsinterval(0, 'day') AS TIMESTAMP), 'Europe/Moscow')
                                                  AND NVL(case when wp_header.act_end_date&gt;0 and wp_header.act_end_time&gt;0
                                                                            then TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.act_end_date, 'day') + NUMTODSINTERVAL(wp_header.act_end_time * 60, 'SECOND')
                                                                            else null
                                                                    end,
                                                                    TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.end_date, 'day') + NUMTODSINTERVAL(wp_header.end_time * 60, 'SECOND')
                                                                   ) AT TIME ZONE 'Europe/Moscow' &gt;= from_tz(CAST (TRUNC(systimestamp)+ numtodsinterval(0, 'day') AS TIMESTAMP), 'Europe/Moscow')
                                         )
             ) wp_heavy ON s.ac_registr = wp_heavy.ac_registr
WHERE 1=1
              AND (wp_heavy.is_current_heavy_wp IS NULL OR '@VAR.v09_excluded_wp_heavy@' IS NULL)
              AND (s2.legno_i is NULL OR '@VAR.v10_is_parked_now_only@' IS NULL)
          
ORDER BY ac_typ, ac_registr, arrival_legno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="235_Arrival_flight" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.arrival as station" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;           decode(ac_utilization.recno&#10;                         0 'earlier than date from'ac_utilization.leg_number&#10;                        ) as arrival_leg_number" id="arrival_leg_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="parking_start_date" id="parking_start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;           decode(nvl(ac_utilization.validity 0)&#10;                         0 to_char(to_date('31.12.1971' 'dd.mm.yyyy') + @VAR.v02_date _from@ 'dd.mm.yyyy')&#10;                         to_char(to_date('31.12.1971' 'dd.mm.yyyy') + ac_utilization.validity'dd.mm.yyyy')&#10;                        ) as arrival_date" id="arrival_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;           TO_CHAR(TO_DATE(ac_utilization.arrival_time*60'sssss')'hh24:mi') as arrival_time" id="arrival_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.departure as arrival_from" id="arrival_from"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@235_MAIN.arrival_legno_i@">
          <ds:object>@235_MAIN.arrival_legno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select station,
           arrival_leg_number,
           parking_start_date,
           arrival_date,
           arrival_time,
           arrival_from
from (
           SELECT TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + ac_utilization.validity, 'dd.mm.yyyy') as parking_start_date,
                         u_arrival_flight.arrival as station,
                         u_arrival_flight.leg_number as arrival_leg_number,
                         TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + u_arrival_flight.validity, 'dd.mm.yyyy') as arrival_date,
                         TO_CHAR(TO_DATE(u_arrival_flight.arrival_time*60,'sssss'),'hh24:mi') as arrival_time,
                         u_arrival_flight.departure as arrival_from,
                         u_arrival_flight.recno as arrival_recno,
                         u_arrival_flight.validity as arrival_validity,
                         max(u_arrival_flight.recno) over (partition by u_arrival_flight.validity) as max_arrival_recno,
                         max(u_arrival_flight.validity) over(partition by ac_utilization.ac_registr) as max_arrival_validity
           FROM ac_utilization
           LEFT JOIN ac_utilization u_arrival_flight ON ac_utilization.ac_registr=u_arrival_flight.ac_registr and u_arrival_flight.validity&lt;ac_utilization.validity and u_arrival_flight.recno&gt;0
           where 1=1
                       and ac_utilization.legno_i=@235_MAIN.arrival_legno_i@
          )
where 1=1
            and arrival_validity=max_arrival_validity
            and arrival_recno=max_arrival_recno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="235_Departure_flight" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="station" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="decode(ac_utilization.recno&#10;                         0 'вне заданного периода'ac_utilization.leg_number) as departure_leg_number" id="departure_leg_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="parking_end_date" id="parking_end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;           decode (nvl(ac_utilization.departure_date 0)&#10;                         0 to_char(to_date('31.12.1971' 'dd.mm.yyyy') + @VAR.v03_date_to@ 'dd.mm.yyyy')&#10;                         to_char(to_date('31.12.1971' 'dd.mm.yyyy') + ac_utilization.departure_date'dd.mm.yyyy')) as departure_date" id="departure_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;           TO_CHAR(TO_DATE(nvl(ac_utilization.departure_time0)*60'sssss')'hh24:mi') as departure_time" id="departure_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.arrival as departure_to" id="departure_to"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@235_MAIN.departure_legno_i@">
          <ds:object>@235_MAIN.departure_legno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select station,
           departure_leg_number,
           parking_end_date,
           departure_date,
           departure_time,
           departure_to
from (
           SELECT TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + ac_utilization.validity, 'dd.mm.yyyy') as parking_end_date,
                         u_departure_flight.departure as station,
                         u_departure_flight.leg_number as departure_leg_number,
                         TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + u_departure_flight.departure_date, 'dd.mm.yyyy') as departure_date,
                         TO_CHAR(TO_DATE(u_departure_flight.departure_time*60,'sssss'),'hh24:mi') as departure_time,
                         u_departure_flight.arrival as departure_to,
                         u_departure_flight.validity as arrival_validity,
                         u_departure_flight.departure_date*24*60 + u_departure_flight.departure_time as departure_ts,
                         MIN (u_departure_flight.departure_date*24*60 + u_departure_flight.departure_time) OVER (PARTITION BY ac_utilization.ac_registr)  as min_departure_ts
           FROM ac_utilization
           LEFT JOIN ac_utilization u_departure_flight ON ac_utilization.ac_registr=u_departure_flight.ac_registr and u_departure_flight.validity&gt;ac_utilization.validity and u_departure_flight.recno=1
           where 1=1
                       and ac_utilization.legno_i=@235_MAIN.departure_legno_i@
          )
where 1=1
            and departure_ts=min_departure_ts</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
