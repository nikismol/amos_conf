    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="forecast" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>forecast_due</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(case when wo_transfer.is_last_transfer = 'Y' then wtd.due_at&#10;             else wtd.due_at&#10;        end) due_at" id="due_at"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_NUMB@">
          <ds:object>@VAR.WO_NUMB@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
        wo_header.event_perfno_i,
        LISTAGG(
        (CASE  	WHEN   forecast_dimension.dimension = 'C' 
        THEN TO_CHAR(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC))||' '||forecast_dimension.dimension
        WHEN   forecast_dimension.dimension = 'D' 
        THEN to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( forecast_dimension.ABSOLUTE_DUE_AT_AC+729), 'dd.mm.yyyy')||' '||forecast_dimension.dimension
        ELSE TO_CHAR(FLOOR (TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC)/60))||':'
             ||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC), 60)))&lt;10
             THEN '0'||(TO_CHAR(MOD(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC), 60)))||' '||forecast_dimension.dimension
             ELSE (TO_CHAR(MOD(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC), 60)))||' '||forecast_dimension.dimension
             END
        END),' / ') WITHIN GROUP (ORDER BY forecast_dimension.event_perfno_i) AS due_at
FROM wo_header
LEFT JOIN wo_transfer ON wo_header.event_perfno_i = wo_transfer.event_perfno_i AND wo_transfer.is_last_transfer= 'Y'
LEFT JOIN wo_transfer_event ON wo_transfer.event_transferno_i = wo_transfer_event.event_transferno_i
LEFT JOIN forecast_dimension ON wo_transfer_event.event_perfno_i = forecast_dimension.event_perfno_i
WHERE wo_header.event_perfno_i = '@VAR.WO_NUMB@'
GROUP BY 
wo_header.event_perfno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
