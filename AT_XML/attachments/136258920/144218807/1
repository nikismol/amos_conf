        <ds:columnDescriptor amosType="ALPHANUM" description="history_on.partno as pn_on" id="pn_on"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history_on.serialno as sn_on" id="sn_on"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history_off.partno as pn_off" id="pn_off"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history_off.serialno as sn_off" id="sn_off"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date+729)'DD.MM.YYYY') as transaction_date" id="transaction_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.del_date" id="history.del_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.position@">
          <ds:object>@VAR.position@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.from@">
          <ds:object>@VAR.from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.to@">
          <ds:object>@VAR.to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT
DISTINCT (aircraft.ac_registr) as ac_registr,
aircraft.ac_typ as ac_typ,
history.location as position,
history.event_perfno_i as wo,
history.labelno,
history_on.partno as pn_on,
history_on.serialno as sn_on,
history_off.partno as pn_off,
history_off.serialno as sn_off,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date+729), 'DD.MM.YYYY') as transaction_date,
history.del_date
FROM
aircraft
LEFT JOIN history ON aircraft.ac_registr=history.ac_registr
LEFT JOIN (SELECT
				history.historyno_i as historyno_i,
				history.psn as psn,
				rotables.partno as partno,
				rotables.serialno as serialno,
				history.del_date as del_date,
				history.ac_registr as ac_registr,
				history.ac_typ as ac_typ,
				history.event_perfno_i as event_perfno_i,
				history.vm as vm,
				history.station as station,
				history.labelno as labelno,
				history.location as location 
			FROM
				history
				LEFT JOIN rotables ON history.psn=rotables.psn
			WHERE
				history.vm IN ('YE')
				AND history.ac_registr='@VAR.ac_registr@'
				AND history.location='@VAR.position@'
				AND history.del_date &gt;= @VAR.from@
				AND history.del_date &lt;= @VAR.to@
		   ) history_on ON history.labelno=history_on.labelno
LEFT JOIN (SELECT
				history.historyno_i as historyno_i,
				history.psn as psn,
				rotables.partno as partno,
				rotables.serialno as serialno,
				history.del_date as del_date,
				history.ac_registr as ac_registr,
				history.ac_typ as ac_typ,
				history.event_perfno_i as event_perfno_i,
				history.vm as vm,
				history.station as station,
				history.labelno as labelno,
				history.location as location
			FROM
				history
				LEFT JOIN rotables ON history.psn=rotables.psn
			WHERE
				history.vm IN ('YA')
				AND history.ac_registr='@VAR.ac_registr@'
				AND history.location='@VAR.position@'
				AND history.del_date &gt;= @VAR.from@
				AND history.del_date &lt;= @VAR.to@
		   ) history_off ON history.labelno=history_off.labelno
WHERE
aircraft.ac_registr='@VAR.ac_registr@'
AND history.location='@VAR.position@'
AND history.del_date &gt;= @VAR.from@
AND history.del_date &lt;= @VAR.to@
ORDER BY
history.del_date DESC,
wo DESC,
pn_on</se:textStatement>
