      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.event_display AS event" id="event"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.ac_typ AS ac_typ" id="ac_typ"/>
