        <ds:columnDescriptor amosType="ALPHANUM" description="counter_h.value AS AH" id="AH"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="counter_c.value AS AC" id="AC"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;                WHEN forecast.dimension = 'D' THEN TO_CHAR(TRUNC(TO_NUMBER((forecast.togo)/60)/24)) ||' D'&#10;                WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.togo))||' C'&#10;                ELSE  TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.togo)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.togo)60))'FM00') ||' H' END AS Togo" id="Togo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;&#9;&#9;&#9;&#9;WHEN forecast.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (forecast.absolute_due_at_ac+729) 'dd.Mm.yyyy')&#10;&#9;&#9;&#9;&#9;WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.absolute_due_at_ac))||' C'&#10;&#9;&#9;&#9;&#9;ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.absolute_due_at_ac)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.absolute_due_at_ac)60))'FM00') ||' H' &#10;&#9;&#9; END AS Due_at" id="Due_at"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (expected_date+729)'DD.MM.YYYY') Expected_date" id="Expected_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tc_interval.interval AS interval" id="interval"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rot.PN AS PN" id="PN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rot.SN AS SN" id="SN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rot.TAH AS TAH" id="TAH"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rot.TAC AS TAC" id="TAC"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.PN@">
          <ds:object>@VAR.PN@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.TC@">
          <ds:object>@VAR.TC@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.MP@">
          <ds:object>@VAR.MP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  
forecast.event_display AS event
,forecast.ac_typ AS ac_typ
,forecast.ac_registr AS aircraft
,counter_h.value AS AH
,counter_c.value AS AC
		,CASE 
                WHEN forecast.dimension = 'D' THEN TO_CHAR(TRUNC(TO_NUMBER((forecast.togo)/60)/24)) ||' D'
                WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.togo))||' C'
                ELSE  TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.togo)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.togo),60)),'FM00') ||' H' END AS Togo
		,CASE 
				WHEN (forecast.dimension = 'D' AND forecast.absolute_due_at_ac = 2147483647) THEN 'Unlimited'
				WHEN forecast.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (forecast.absolute_due_at_ac+729), 'dd.Mm.yyyy')
				WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.absolute_due_at_ac))||' C'
				ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.absolute_due_at_ac)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.absolute_due_at_ac),60)),'FM00') ||' H' 
		 END AS Due_at
		,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (expected_date+729), 'DD.MM.YYYY') Expected_date 
,tc_interval.interval AS interval
,rot.PN AS PN
,rot.SN AS SN
,rot.TAH AS TAH
,rot.TAC AS TAC
FROM forecast
JOIN wo_event_link ON forecast.event_perfno_i = wo_event_link.event_perfno_i AND wo_event_link.pending_status = '0' AND wo_event_link.event_status = 'O'
JOIN msc_requirement_tc_link ON wo_event_link.event_key_parent = msc_requirement_tc_link.req_linkno_i AND (wo_event_link.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MET' AND '@AMOS_VERSION@' NOT LIKE '19.12%') AND wo_event_link.pending_status = 0 
JOIN msc_taskcard_version ON msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i=msc_taskcard.taskcardno_i 
JOIN msc_maintenance_program ON msc_taskcard.mpno_i=msc_maintenance_program.mpno_i 
JOIN aircraft ON forecast.ac_registr = aircraft.ac_registr
JOIN (
        SELECT 
            aircraft.aircraftno_i AS aircraftno_i
            ,TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter.life_value)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(counter.life_value),60)),'FM00') AS value
        FROM aircraft 
        JOIN counter ON aircraft.aircraftno_i = counter.ref_key AND counter.ref_type = 'AC_INT'
        JOIN counter_template ON counter.counter_templateno_i = counter_template.counter_templateno_i 
        JOIN counter_definition counter_definition_h ON counter_template.counter_defno_i = counter_definition_h.counter_defno_i AND counter_definition_h.counter_defno_i =1 ) counter_h ON aircraft.aircraftno_i = counter_h.aircraftno_i
JOIN (
        SELECT 
            aircraft.aircraftno_i AS aircraftno_i
           ,counter.life_value AS value
        FROM aircraft 
        JOIN counter ON aircraft.aircraftno_i = counter.ref_key AND counter.ref_type = 'AC_INT'
        JOIN counter_template ON counter.counter_templateno_i = counter_template.counter_templateno_i 
        JOIN counter_definition counter_definition_c ON counter_template.counter_defno_i = counter_definition_c.counter_defno_i AND counter_definition_c.counter_defno_i =2)counter_c ON aircraft.aircraftno_i = counter_c.aircraftno_i
LEFT JOIN (SELECT treq_time_requirement.event_key as event_key,
                                  LISTAGG ('I:'
                                                    ||treq_interval.amount_interval
                                                    ||' '
                                                    ||CASE WHEN treq_interval.counter_defno_i='1' THEN 'FH '
                                                                   WHEN treq_interval.counter_defno_i='2' THEN 'FC '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='D' THEN 'DY '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='H' THEN 'HRS '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='MT' THEN 'MO '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='YR' THEN 'YE '
                                                                   WHEN treq_interval.counter_defno_i='101' THEN 'AH '
                                                                   WHEN treq_interval.counter_defno_i='102' THEN 'AC '
                                                                   ELSE '' 
                                                          END, CHR(10)
                                                      ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as interval
                    FROM
                    treq_time_requirement
                    LEFT JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
                    LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i
