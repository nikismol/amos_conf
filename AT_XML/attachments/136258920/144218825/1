        <ds:columnDescriptor amosType="ALPHANUM" description="pns.last_oh" id="pns.last_oh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pns.requirement" id="pns.requirement"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pns.due" id="pns.due"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pns.condition" id="pns.condition"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.pns@">
          <ds:object>@VAR.pns@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.alt@">
          <ds:object>@VAR.alt@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>
select pns.partno,
       pns.serialno,
       pns.mfg_date,
       pns.last_oh,
       pns.requirement,
       pns.due,
       pns.condition
from(
(select distinct rotables.partno,
       rotables.serialno,
       CASE 
            WHEN rotables.mfg_unknown = 'Y' THEN 'UNKNOWN'
            WHEN rotables.mfg_date = '0' THEN 'UNKNOWN'
            ELSE to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (rotables.mfg_date + 729),'dd.mm.yyyy') 
        END as mfg_date, 
        CASE 
            WHEN rotables.oh_at_date_unknown = 'Y' AND rotables.oh_at_date IN ('0','1') THEN 'UNKNOWN'
             WHEN rotables.oh_at_date_unknown = ' ' OR rotables.oh_at_date = '0' THEN to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (rotables.mfg_date + 729),'dd.mm.yyyy')
            ELSE to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (rotables.oh_at_date + 729),'dd.mm.yyyy')
        END as last_oh,
        fo.requirement,
        rotables.condition,
        due
from rotables
left join wo_header on rotables.psn = wo_header.psn
left join wo_event_link on wo_header.event_perfno_i = wo_event_link.event_perfno_i
left join part_requirement on wo_event_link.event_key_parent = part_requirement.part_requirementno_i
LEFT JOIN (
           select listagg ( 
             CASE 
                WHEN fo.dimension = 'SD' THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (fo.absolute_due_at_ac+729), 'dd.Mm.yyyy')
                WHEN fo.dimension = 'H' THEN TO_CHAR(FLOOR (TO_NUMBER(fo.relative_due_at)/60))||':'
                  ||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(fo.relative_due_at), 60)))&lt;10
                         THEN '0'||(TO_CHAR(MOD(TO_NUMBER(fo.relative_due_at), 60)))
                         ELSE (TO_CHAR(MOD(TO_NUMBER(fo.relative_due_at), 60)))
                    END
                 
                WHEN fo.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (fo.absolute_due_at_ac+729), 'dd.Mm.yyyy')
                WHEN fo.dimension = 'AC' THEN TO_CHAR(TO_NUMBER (fo.relative_due_at))
                WHEN fo.dimension = 'C' THEN TO_CHAR(TO_NUMBER(fo.relative_due_at))
                ELSE TO_CHAR(TO_NUMBER(fo.absolute_due_at_ac))
                END
                , ', ') within group (order by dimension) due,
                fo.psn,
                fo.requirement
           from (
           select distinct fo.psn,
                  fo.absolute_due_at_ac,
                  fo.relative_due_at,
                  fo.dimension,
                  fo.requirement
           from forecast fo
           where fo.event_type IS NOT NULL
             and fo.event_type &lt;&gt;'V'
             and fo.expected_date &lt; 1491308
           ) fo
           group by psn, fo.requirement) fo ON rotables.psn = fo.psn
WHERE rotables.psn = wo_header.psn
      AND wo_event_link.pending_status &gt;= 0
      AND rotables.partno = '@VAR.pns@'
      AND wo_event_link.event_type='MEP')
UNION
(select distinct rotables.partno,
       rotables.serialno,
       CASE 
            WHEN rotables.mfg_unknown = 'Y' THEN 'UNKNOWN'
            ELSE to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (rotables.mfg_date + 729),'dd.mm.yyyy') 
        END as mfg_date, 
        CASE 
            WHEN rotables.oh_at_date_unknown = 'Y' AND rotables.oh_at_date IN ('0','1') THEN 'UNKNOWN'
            WHEN rotables.oh_at_date = '0' AND rotables.mfg_date = '0' THEN 'UNKNOWN'
            WHEN rotables.oh_at_date_unknown = ' ' OR rotables.oh_at_date = '0' THEN to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (rotables.mfg_date + 729),'dd.mm.yyyy')
            ELSE to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (rotables.oh_at_date + 729),'dd.mm.yyyy')
        END as last_oh,
        fo.requirement,
        rotables.condition,
        due
FROM part_alternate alt
LEFT JOIN rotables ON alt.altpartno = rotables.partno
left join wo_header on rotables.psn = wo_header.psn
left join wo_event_link on wo_header.event_perfno_i = wo_event_link.event_perfno_i
/* due_ate*/
LEFT JOIN (
           select listagg ( 
             CASE 
                WHEN fo.dimension = 'SD' THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (fo.absolute_due_at_ac+729), 'dd.Mm.yyyy')
                WHEN fo.dimension = 'H' THEN TO_CHAR(FLOOR (TO_NUMBER(fo.relative_due_at)/60))||':'
                  ||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(fo.relative_due_at), 60)))&lt;10
                         THEN '0'||(TO_CHAR(MOD(TO_NUMBER(fo.relative_due_at), 60)))
                         ELSE (TO_CHAR(MOD(TO_NUMBER(fo.relative_due_at), 60)))
                    END
                 
                WHEN fo.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (fo.absolute_due_at_ac+729), 'dd.Mm.yyyy')
                WHEN fo.dimension = 'AC' THEN TO_CHAR(TO_NUMBER (fo.relative_due_at))
                WHEN fo.dimension = 'C' THEN TO_CHAR(TO_NUMBER(fo.relative_due_at))
                ELSE TO_CHAR(TO_NUMBER(fo.absolute_due_at_ac))
                END
                , ', ') within group (order by dimension) due,
                fo.psn,
                fo.requirement
           from (
           select distinct fo.psn,
                  fo.absolute_due_at_ac,
                  fo.relative_due_at,
                  fo.dimension,
                  fo.requirement
           from forecast fo
           where fo.event_type IS NOT NULL
             and fo.event_type &lt;&gt;'V'
             and fo.expected_date &lt; 1491308
           ) fo
           group by psn, fo.requirement) fo ON rotables.psn = fo.psn 
WHERE rotables.psn = wo_header.psn
      AND wo_event_link.pending_status &gt;= 0
      AND alt.partno = '@VAR.pns@'
      AND wo_event_link.event_type='MEP'
      AND '@VAR.alt@' = 'Y')
) pns
order by partno, serialno</se:textStatement>
