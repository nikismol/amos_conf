               CASE WHEN '@VAR.v06_show_detailed_table@'= 'Y' THEN departure_time ELSE NULL END as departure_time,
               CASE WHEN '@VAR.v06_show_detailed_table@'= 'Y' THEN departure_leg_number ELSE NULL END as departure_leg_number,
               CASE WHEN '@VAR.v06_show_detailed_table@'= 'Y' THEN is_t_check ELSE NULL END as is_t_check,
               CASE WHEN '@VAR.v06_show_detailed_table@'= 'Y' THEN is_l_check ELSE NULL END as is_l_check 
