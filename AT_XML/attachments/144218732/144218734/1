	l_check,
	all_checks,
               CASE WHEN '@VAR.v06_show_detailed_table@'= 'Y' THEN arr_date ELSE NULL END as arr_date,
               CASE WHEN '@VAR.v06_show_detailed_table@'= 'Y' THEN arr_time ELSE NULL END as arr_time,
