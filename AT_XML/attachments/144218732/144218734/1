    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AT_LM_T_Check_counter_by_ac" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>for A-Technics</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="acreg" id="acreg"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t_check" id="t_check"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="l_check" id="l_check"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="all_checks" id="all_checks"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.thr@">
          <ds:object>@VAR.thr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.start_date@">
          <ds:object>@VAR.start_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end_date@">
          <ds:object>@VAR.end_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_exclude _if_contains_checks@">
          <ds:object>@VAR.v05_exclude _if_contains_checks@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  
	acreg,
	t_check,
	l_check,
	all_checks
FROM (  
  SELECT
    layover_legs.acreg as acreg,
    count(CASE WHEN layover_legs.layover_time &lt;= @VAR.thr@ THEN 1 END) OVER (PARTITION BY layover_legs.acreg) as t_check,
    count(CASE WHEN layover_legs.layover_time &gt;  @VAR.thr@ THEN 1 END) OVER (PARTITION BY layover_legs.acreg) as l_check,
    count(*) OVER (PARTITION BY layover_legs.acreg) as all_checks    
  FROM
  (
    SELECT
      acu_a.ac_registr as acreg,
      acu_a.validity as arr_date,
      acu_a.arrival_time as arr_time,
      acu_d.departure_date,
      acu_d.departure_time,
      acu_a.departure||'-'||acu_a.arrival||'&gt;&gt;'||acu_d.departure||'-'||acu_d.arrival as route,
      acu_a.legno_i as a_legno_i, 
      acu_d.legno_i as d_legno_i,
      (acu_d.departure_date - acu_a.validity)*24*60 + (acu_d.departure_time - acu_a.arrival_time) as layover_time,
      ROW_NUMBER() OVER (PARTITION BY acu_a.legno_i ORDER BY acu_d.departure_date ASC, acu_d.departure_time ASC) AS rnum
    FROM ac_utilization acu_a
