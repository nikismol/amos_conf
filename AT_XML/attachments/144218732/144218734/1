  SELECT
    count(CASE WHEN layover_legs.layover_time &lt;= @VAR.thr@ THEN 1 END) as t_check,
    count(CASE WHEN layover_legs.layover_time &gt;  @VAR.thr@ THEN 1 END) as l_check,
    count(*) as all_checks    
  FROM
  (
    SELECT
	  acu_d.legno_i as d_legno_i,
      (acu_d.departure_date - acu_a.validity)*24*60 + (acu_d.departure_time - acu_a.arrival_time) as layover_time,
      ROW_NUMBER() OVER (PARTITION BY acu_a.legno_i ORDER BY acu_d.departure_date ASC, acu_d.departure_time ASC) AS rnum,
      acu_a.ac_registr as acreg,
      acu_a.validity as arr_date,
      acu_a.arrival_time as arr_time,
      acu_d.departure_date,
      acu_d.departure_time
    FROM ac_utilization acu_a
    LEFT JOIN ac_utilization acu_d ON acu_d.ac_registr = acu_a.ac_registr AND acu_d.departure='SVO' AND ((acu_d.departure_date &gt; acu_a.validity) OR (acu_d.departure_date = acu_a.validity AND acu_d.departure_time &gt; acu_a.arrival_time))
	LEFT JOIN aircraft a ON a.ac_registr = acu_a.ac_registr
