  SELECT
    layover_legs.acreg as acreg,
    count(CASE WHEN layover_legs.layover_time &lt;= @VAR.thr@ THEN 1 END) OVER (PARTITION BY layover_legs.acreg) as t_check,
    count(CASE WHEN layover_legs.layover_time &gt;  @VAR.thr@ THEN 1 END) OVER (PARTITION BY layover_legs.acreg) as l_check,
    count(*) OVER (PARTITION BY layover_legs.acreg) as all_checks,
    layover_legs.arr_date,
    layover_legs.arr_time,
    layover_legs.departure_date,
    layover_legs.departure_time,
    layover_legs.arrival_leg_number,
    layover_legs.departure_leg_number,
    CASE WHEN layover_legs.layover_time &lt;= @VAR.thr@ THEN 'Y' ELSE 'N' END as is_t_check,
    CASE WHEN layover_legs.layover_time &gt;  @VAR.thr@ THEN 'Y' ELSE 'N' END as is_l_check
