        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  'DY' as type, COUNT(wh.description) as cnt
FROM wp_header wh
LEFT JOIN aircraft at ON at.ac_registr = wh.ac_registr
WHERE at.ac_model = '@VAR.ac@'
               AND wh.station='SVO'
               AND wh.start_date &gt;= '@VAR.fromd@' 
               AND wh.start_date &lt;= '@VAR.tod@' 
               AND wh.hidden = '@VAR.classif@'
               AND REGEXP_LIKE (wh.description, '^DY|\+DY|\sDY|\,DY', 'i')
               AND (
                        (
                            at.ac_registr = '89115' AND (wh.start_date &lt; 17163)
                            OR at.ac_registr = '89116' AND (wh.start_date &lt; 17163)
                            OR at.ac_registr = '89114' AND (wh.start_date &lt; 17165)
                            OR at.ac_registr = '89023' AND (wh.start_date &lt; 17177)       
                            OR at.ac_registr = '89047' AND (wh.start_date &lt; 17181)
                            OR at.ac_registr = '89112' AND (wh.start_date &lt; 17182)
                            OR at.ac_registr = '89113' AND (wh.start_date &lt; 17190)
                            OR at.ac_registr = '89057' AND (wh.start_date &lt; 17203)
                            OR at.ac_registr = '89111' AND (wh.start_date &lt; 17203)
                            OR at.ac_registr = '89108' AND (wh.start_date &lt; 17216)
                            OR at.ac_registr = '89109' AND (wh.start_date &lt; 17223)
                            OR at.ac_registr = '89110' AND (wh.start_date &lt; 17224)   
                        )
                    OR at.ac_registr NOT IN ('89115','89116','89114','89023','89047','89112','89113','89057','89111','89108','89109','89110')
                    )
UNION
SELECT  '3DY' as type, COUNT(wh.description) as cnt
FROM wp_header wh
LEFT JOIN aircraft at ON at.ac_registr = wh.ac_registr
WHERE at.ac_model = '@VAR.ac@'
               AND wh.station='SVO'
               AND wh.start_date &gt;= '@VAR.fromd@' 
               AND wh.start_date &lt;= '@VAR.tod@' 
               AND wh.hidden = '@VAR.classif@'
