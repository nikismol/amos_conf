      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="'DY' as type" id="type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT(wh.description) as cnt" id="cnt"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac@">
          <ds:object>@VAR.ac@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.fromd@">
          <ds:object>@VAR.fromd@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tod@">
          <ds:object>@VAR.tod@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.classif@">
