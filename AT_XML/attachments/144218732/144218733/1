    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="dcheck" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="at.ac_model" id="at.ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wh.ac_registr" id="wh.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wh.wpno" id="wh.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wh.description" id="wh.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wh.hidden" id="wh.hidden"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wh.start_date" id="wh.start_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac@">
          <ds:object>@VAR.ac@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.fromd@">
          <ds:object>@VAR.fromd@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tod@">
          <ds:object>@VAR.tod@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.classif@">
          <ds:object>@VAR.classif@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT at.ac_model,
               wh.ac_registr,
               wh.wpno,
               wh.description,
               wh.hidden,
               wh.start_date
FROM wp_header wh
JOIN aircraft at ON at.ac_registr = wh.ac_registr
WHERE at.ac_model = '@VAR.ac@'
               AND wh.start_date &gt;= '@VAR.fromd@' 
               AND wh.start_date &lt;= '@VAR.tod@' 
               AND wh.hidden = '@VAR.classif@'
               AND wh.station='SVO'
               AND (
                        (
                            at.ac_registr = '89115' AND (wh.start_date &lt; 17163)
                            OR at.ac_registr = '89116' AND (wh.start_date &lt; 17163)
                            OR at.ac_registr = '89114' AND (wh.start_date &lt; 17165)
                            OR at.ac_registr = '89023' AND (wh.start_date &lt; 17177)       
                            OR at.ac_registr = '89047' AND (wh.start_date &lt; 17181)
                            OR at.ac_registr = '89112' AND (wh.start_date &lt; 17182)
                            OR at.ac_registr = '89113' AND (wh.start_date &lt; 17190)
                            OR at.ac_registr = '89057' AND (wh.start_date &lt; 17203)
                            OR at.ac_registr = '89111' AND (wh.start_date &lt; 17203)
                            OR at.ac_registr = '89108' AND (wh.start_date &lt; 17216)
                            OR at.ac_registr = '89109' AND (wh.start_date &lt; 17223)
                            OR at.ac_registr = '89110' AND (wh.start_date &lt; 17224)   
                        )
                    OR at.ac_registr NOT IN ('89115','89116','89114','89023','89047','89112','89113','89057','89111','89108','89109','89110')
                    )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="check_count" type="SQL_EDITOR_DATASOURCE" version="2.0">
