    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AUDIT_TABLE_2" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rownum" id="rownum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_pool.item" id="qa_item_pool.item"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_category.item_category" id="qa_item_category.item_category"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_pool.requirement" id="qa_item_pool.requirement"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       DECODE (&#10;       qa_item_findings_history.qa_findno_i '1' 'Failed'&#10;                                             '2' 'Not applicable'&#10;                                             '4' 'Passed'&#10;                                             '102' 'Несоответствие'&#10;                                             '103' 'Не применяется'&#10;                                             '105''Прошел' ) as status" id="status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_findings_history.qa_find_historyno_i" id="qa_item_findings_history.qa_find_historyno_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@QA@">
          <ds:object>@QA@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT rownum,
       qa_item_pool.item,
       qa_item_category.item_category,
       qa_item_pool.requirement,
       DECODE (
       qa_item_findings_history.qa_findno_i, '1', 'Failed',
                                             '2', 'Not applicable',
                                             '4', 'Passed',
                                             '102', 'Несоответствие',
                                             '103', 'Не применяется',
                                             '105', 'Прошел' ) as status,
       qa_item_findings_history.qa_find_historyno_i
FROM qa_audit
JOIN qa_audit_section ON qa_audit.qa_auditno_i = qa_audit_section.qa_auditno_i
LEFT JOIN qa_audit_section_item si ON qa_audit_section.qa_sectionno_i = si.qa_sectionno_i
LEFT JOIN qa_item_pool ON si.qa_itemno_i = qa_item_pool.qa_itemno_i
LEFT JOIN qa_item_category ON qa_item_pool.qa_item_categoryno_i = qa_item_category.qa_item_categoryno_i
LEFT JOIN qa_item_findings_history ON si.recno = qa_item_findings_history.recno AND si.qa_sectionno_i = qa_item_findings_history.qa_sectionno_i
LEFT JOIN qa_item_find_problems ON qa_item_findings_history.qa_find_historyno_i = qa_item_find_problems.qa_find_historyno_i
LEFT JOIN qa_priority ON qa_item_find_problems.qa_priorityno_i = qa_priority.qa_priorityno_i
WHERE qa_audit.qa_auditno_i = '@QA@'
ORDER BY rownum</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
