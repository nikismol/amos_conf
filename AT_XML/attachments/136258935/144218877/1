        <ds:columnDescriptor amosType="ALPHANUM" description="a.lead_auditor" id="a.lead_auditor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.distribution" id="a.distribution"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.assistant" id="a.assistant"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.assistant_2" id="a.assistant_2"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.assistant_3" id="a.assistant_3"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.checklist" id="a.checklist"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.duration" id="a.duration"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="c.category" id="c.category"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_organisation.description" id="qa_organisation.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="c.description" id="c.description"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@QA@">
          <ds:object>@QA@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT a.qa_auditno_i,
       a.qa_audit_name,
       to_char(sysdate,'YY'),
       a.description,
       a.notes,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (a.scheduled+729), 'DD.Mon.YYYY') as scheduled,
       a.lead_auditor,
       a.distribution,
       a.assistant,
       a.assistant_2,
       a.assistant_3,
       a.checklist,
       a.duration,
       c.category,
        qa_organisation.description,
       c.description
FROM qa_audit a
LEFT JOIN qa_category c ON c.qa_category_i = a.qa_category_i
LEFT JOIN qa_organisation ON a.checklist = qa_organisation.organisation
WHERE qa_auditno_i = @QA@</se:textStatement>
