    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_SPA_List_orders" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.partno" id="sd.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.ideal_qty" id="sd.ideal_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.reorder_level" id="sd.reorder_level"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ps.qty_sys" id="ps.qty_sys"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.spa_list@">
          <ds:object>@VAR.spa_list@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
sd.partno,
sd.ideal_qty,
sd.reorder_level, 
ps.qty_sys
