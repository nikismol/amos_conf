        <ds:columnDescriptor amosType="ALPHANUM" description="h.partno" id="h.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.serialno" id="h.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.condition" id="h.condition"/>
