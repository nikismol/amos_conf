        <ds:columnDescriptor amosType="ALPHANUM" description="AC_TYP" id="AC_TYP"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="AC_REGISTR" id="AC_REGISTR"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CHECK_TYPE" id="CHECK_TYPE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="LAST_REPAIR_DATE" id="LAST_REPAIR_DATE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="NEXT_REPAIR_DATE" id="NEXT_REPAIR_DATE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + aircraft.del_date'dd.mm.yyyy') as del_date" id="del_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + aircraft.expire_date'dd.mm.yyyy') as expire_date" id="expire_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT v.AC_TYP as AC_TYP,
              v.AC_REGISTR as AC_REGISTR,
              aircraft.description as description,
              v.CHECK_TYPE as CHECK_TYPE,
              v.LAST_REPAIR_DATE as LAST_REPAIR_DATE,
              v.NEXT_REPAIR_DATE as NEXT_REPAIR_DATE,
              TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + aircraft.del_date, 'dd.mm.yyyy') as del_date,
              DECODE(aircraft.expire_date,
                               0, null,
                               null, null,
                               TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + aircraft.expire_date, 'dd.mm.yyyy')) as expire_date
FROM AMOS_SAP_USER.FINANCE_REPORT_AC_CHECKS_CAD_EDITION v
LEFT JOIN aircraft ON v.ac_registr=aircraft.ac_registr</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
