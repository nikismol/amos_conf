        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;               TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + finding.closing_date'dd.mm.yyyy') as closing_date" id="closing_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_issue_date_from@">
          <ds:object>@VAR.v04_issue_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_issue_date_to@">
          <ds:object>@VAR.v05_issue_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v06_closing_date_from@">
          <ds:object>@VAR.v06_closing_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v07_closing_date_to@">
          <ds:object>@VAR.v07_closing_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_mpno_i@">
          <ds:object>@VAR.v01_mpno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_taskcardno_i@">
          <ds:object>@VAR.v02_taskcardno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_ac_registr@">
          <ds:object>@VAR.v03_ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT
               CASE WHEN event_finding.event_perfno_i IS NULL THEN 0 ELSE 1 END sort,
               aircraft.ac_typ as ac_typ,
               aircraft.ac_registr as ac_registr,
               msc_taskcard.taskcardno as taskcardno,
               msc_taskcard.ata_chapter as ata_chapter,
               event_finding.event_perfno_i as finding,
               TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + finding.issue_date, 'dd.mm.yyyy') as issue_date,
               TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + finding.closing_date, 'dd.mm.yyyy') as closing_date
FROM msc_taskcard_version
JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i=msc_taskcard.taskcardno_i
JOIN msc_maintenance_program ON msc_taskcard.mpno_i=msc_maintenance_program.mpno_i AND msc_maintenance_program.mpno IN ('A32S', 'B737', 'A330', 'B777', 'RRJ', 'A350') AND msc_maintenance_program.program_type='MP'
JOIN msc_requirement_tc_link ON msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
                                                                AND (msc_requirement_tc_link.mpno_i_operator=6 AND msc_maintenance_program.mpno='B737' 
                                                                           OR msc_requirement_tc_link.mpno_i_operator=7 AND msc_maintenance_program.mpno='B777'
                                                                           OR msc_requirement_tc_link.mpno_i_operator=8 AND msc_maintenance_program.mpno='RRJ'
                                                                           OR msc_requirement_tc_link.mpno_i_operator=9 AND msc_maintenance_program.mpno='A32S'
                                                                           OR msc_requirement_tc_link.mpno_i_operator=10 AND msc_maintenance_program.mpno='A330'
                                                                           OR msc_requirement_tc_link.mpno_i_operator=407 AND msc_maintenance_program.mpno='A350')
JOIN wo_event_link ON wo_event_link.event_key_parent = msc_requirement_tc_link.req_linkno_i AND (wo_event_link.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MET' AND '@AMOS_VERSION@' NOT LIKE '19.12%') AND wo_event_link.pending_status &lt; 0 AND wo_event_link.event_status &lt;&gt; 'Z'
JOIN wo_header ON wo_event_link.event_perfno_i = wo_header.event_perfno_i
JOIN aircraft ON aircraft.ac_registr=wo_header.ac_registr
LEFT JOIN workstep_link ON wo_event_link.event_perfno_i = workstep_link.event_perfno_i
LEFT JOIN workstep_classification ON workstep_classification.descno_i = workstep_link.descno_i AND workstep_classification.etops_relevant='Y'
LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i AND REGEXP_LIKE(NVL(wo_text_description.text, wo_text_description.text_html), 'ETOPS', 'i')
LEFT JOIN event_finding ON wo_event_link.effectivity_linkno_i = event_finding.headerno_i AND event_finding.primkey = wo_event_link.event_perfno_i AND event_finding.header_type = 'EFL' AND event_finding.type &lt;&gt; 'TC'
LEFT JOIN wo_header finding ON event_finding.event_perfno_i=finding.event_perfno_i AND finding.state&lt;&gt;'V'
                                                             AND finding.issue_date BETWEEN @VAR.v04_issue_date_from@ AND DECODE(@VAR.v05_issue_date_to@, 0, 999999, @VAR.v05_issue_date_to@)
                                                             AND NVL(finding.closing_date, 999998) BETWEEN @VAR.v06_closing_date_from@ AND DECODE(@VAR.v07_closing_date_to@, 0, 999999, @VAR.v07_closing_date_to@)
LEFT JOIN wo_header_more ON finding.event_perfno_i=wo_header_more.event_perfno_i AND NVL(wo_header_more.nonrelevant_finding, 'N')&lt;&gt;'Y'
WHERE 1=1
              AND @VAR.v01_mpno_i@= msc_maintenance_program.mpno_i
              AND (msc_taskcard.taskcardno_i='@VAR.v02_taskcardno_i@' OR '@VAR.v02_taskcardno_i@' IS NULL)
              AND (aircraft.ac_registr='@VAR.v03_ac_registr@' OR '@VAR.v03_ac_registr@' IS NULL)
              AND (wo_text_description.descno_i IS NOT NULL OR workstep_classification.etops_relevant='Y')
ORDER BY 1, 2, 3, 4, 6</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
