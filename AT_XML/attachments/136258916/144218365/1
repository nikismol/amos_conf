      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
        wo_header.event_perfno_i as workorder
       ,wo_header.ata_chapter as ata_chapter
       ,DECODE(wo_header.state, 'O', 'Open', 'C', 'Closed', '') as wo_state
       ,aircraft.ac_typ as ac_typ
       ,wo_header.ac_registr as ac_registr
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.issue_date+729), 'DD.MM.YYYY') as issue_date
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.closing_date+729), 'DD.MM.YYYY') as closing_date
       ,wo_header_more.mel_chapter as mel_chapter
       ,wo_header.mel_code as mel_code
       ,(wo_header.closing_date - wo_header.issue_date) as wo_duration 
       ,NVL(TO_CHAR(wo_transfer.recno), 'unknown (transfer has been removed)') as transfer_qty
       ,wo_header.hil
FROM 
wo_header
LEFT JOIN aircraft ON aircraft.ac_registr = wo_header.ac_registr
LEFT JOIN wo_transfer ON wo_header.event_perfno_i = wo_transfer.event_perfno_i AND wo_transfer.is_last_transfer = 'Y'
LEFT JOIN wo_transfer wt ON wo_header.event_perfno_i = wt.event_perfno_i
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN wo_opus ON wo_header.event_perfno_i = wo_opus.event_perfno_i
LEFT JOIN wo_header_4 on wo_header_4.event_perfno_i = wo_header.event_perfno_i
WHERE (aircraft.ac_typ = '@VAR.v01_ac_typ@' OR '@VAR.v01_ac_typ@'='ALL')
             AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.v02_ac_registr@', ', ', '|')) OR '@VAR.v02_ac_registr@' IS NULL)
             AND (wo_header.issue_date &gt;= '@VAR.v03_wo_issue_from@' OR '@VAR.v03_wo_issue_from@' IS NULL)
             AND (wo_header.issue_date &lt;= '@VAR.v04_wo_issue_to@' OR '@VAR.v04_wo_issue_to@' IS NULL)
             AND (wo_header.closing_date &gt;= '@VAR.v05_wo_closing_from@' OR '@VAR.v05_wo_closing_from@' IS NULL)
             AND (wo_header.closing_date &lt;= '@VAR.v06_wo_closing_to@' OR '@VAR.v06_wo_closing_to@' IS NULL)
             AND (wo_header.state = '@VAR.v07_wo_state@' OR '@VAR.v07_wo_state@'='ALL')
             AND (wo_header.mel_code IS NOT NULL
                       AND wo_header.mel_code&lt;&gt;'L'
                       OR 
                       wo_header.mel_code IS NULL 
                       AND wo_header.hil = 'Y'
                       AND wo_opus.free_text IS NOT NULL
                       AND '@VAR.v08_incl_dd_wo@'='Y')
             AND (aircraft.status&lt;&gt;9 AND '@VAR.v09_incl_inactive_ac@'='N' OR '@VAR.v09_incl_inactive_ac@'='Y')
             AND wo_header.type != 'S'
             AND wo_header.state &lt;&gt; 'V'
ORDER BY ac_typ, ac_registr, workorder</se:textStatement>
        </se:sqlStatement>
