    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_RRJ_MFR_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT&#10;             msc_taskcard.taskcardno as taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ata_chapter as ata_chapter" id="ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event_finding.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + wo_header.issue_date'dd.mm.yyyy') as issue_date" id="issue_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_mpno_i@">
          <ds:object>@v05_mpno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_taskcardno_i@">
          <ds:object>@VAR.v04_taskcardno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_wo@">
          <ds:object>@VAR.v03_wo@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT
             msc_taskcard.taskcardno as taskcardno,
              chr(39)||msc_taskcard.ata_chapter as ata_chapter,
             event_finding.event_perfno_i as event_perfno_i,
             aircraft.serialno as serialno,
             wo_header.ac_registr as ac_registr,
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + finding.issue_date, 'dd.mm.yyyy') as issue_date


FROM msc_taskcard
JOIN msc_taskcard_version ON msc_taskcard.taskcardno_i = msc_taskcard_version.taskcardno_i
JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i
JOIN msc_mp_revision ON msc_mprev_taskcards.revisionno_i = msc_mp_revision.revisionno_i AND msc_mp_revision.revision_status IN ('a','b')
JOIN msc_mp_issue ON msc_mp_revision.issueno_i = msc_mp_issue.issueno_i
JOIN msc_maintenance_program ON msc_mp_issue.mpno_i = msc_maintenance_program.mpno_i
                                                                   AND msc_taskcard.mpno_i=msc_maintenance_program.mpno_i
                                                                   AND msc_maintenance_program.program_type='MP'
JOIN msc_requirement_tc_link ON msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
                                                              AND (msc_requirement_tc_link.mpno_i_operator=6 AND msc_maintenance_program.mpno='B737' 
                                                                        OR msc_requirement_tc_link.mpno_i_operator=7 AND msc_maintenance_program.mpno='B777'
                                                                        OR msc_requirement_tc_link.mpno_i_operator=8 AND msc_maintenance_program.mpno='RRJ'
                                                                        OR msc_requirement_tc_link.mpno_i_operator=9 AND msc_maintenance_program.mpno='A32S'
                                                                        OR msc_requirement_tc_link.mpno_i_operator=10 AND msc_maintenance_program.mpno='A330'
                                                                        OR msc_requirement_tc_link.mpno_i_operator=407 AND msc_maintenance_program.mpno='A350')

JOIN wo_event_link ON wo_event_link.event_key_root = msc_requirement_tc_link.req_link_headerno_i
                                          AND (wo_event_link.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%'
                                                    OR wo_event_link.event_type = 'MET' AND '@AMOS_VERSION@' NOT LIKE '19.12%')
                                          AND wo_event_link.pending_status &lt; 0 AND wo_event_link.event_status &lt;&gt; 'Z'
JOIN wo_transfer ON wo_transfer.event_perfno_i = wo_event_link.event_perfno_i
JOIN wo_transfer_dimension ON wo_transfer.event_transferno_i = wo_transfer_dimension.event_transferno_i AND wo_transfer.transfer_type = 'R'
JOIN treq_interval ON wo_transfer_dimension.treq_intervalno_i=treq_interval.intervalno_i AND treq_interval.dimension_type IN ('W', 'B', 'I')
JOIN treq_dimension_group ON treq_interval.dimension_groupno_i=treq_dimension_group.dimension_groupno_i
JOIN treq_interval_group ON treq_interval_group.interval_groupno_i=treq_dimension_group.interval_groupno_i
JOIN treq_time_requirement ON treq_interval_group.timerequirementno_i=treq_time_requirement.timerequirementno_i AND treq_time_requirement.event_type = 'REQH' AND treq_time_requirement.type = 'OP'
JOIN event_finding ON wo_event_link.effectivity_linkno_i = event_finding.headerno_i AND event_finding.primkey = wo_event_link.event_perfno_i AND event_finding.header_type = 'EFL' AND event_finding.type &lt;&gt; 'TC'
JOIN wo_header ON wo_event_link.event_perfno_i = wo_header.event_perfno_i
JOIN wo_header finding ON event_finding.event_perfno_i=finding.event_perfno_i
LEFT JOIN wo_header_more ON finding.event_perfno_i=wo_header_more.event_perfno_i
JOIN aircraft ON aircraft.ac_registr=finding.ac_registr
WHERE 1=1
              AND '@v05_mpno_i@'= msc_maintenance_program.mpno_i
              AND (msc_taskcard.taskcardno_i='@VAR.v04_taskcardno_i@' OR '@VAR.v04_taskcardno_i@' IS NULL)
              AND wo_header.closing_date BETWEEN DECODE(@VAR.v01_date_from@, -1, ADD_MONTHS(TRUNC(SYSDATE, 'Q'), -3) - to_date('31.12.1971', 'dd.mm.yyyy'), @VAR.v01_date_from@) AND DECODE(@VAR.v02_date_to@, -1, TRUNC(SYSDATE, 'Q') - 1 -  to_date('31.12.1971', 'dd.mm.yyyy'), @VAR.v02_date_to@)
              AND (REGEXP_LIKE(event_finding.event_perfno_i, REPLACE('@VAR.v03_wo@', ', ', '|')) OR '@VAR.v03_wo@' IS NULL)
              AND finding.state&lt;&gt;'V'
              AND NVL(wo_header_more.nonrelevant_finding, 'N')&lt;&gt;'Y'
ORDER BY 1</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_RRJ_MRF_Actions" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             RTRIM(&#10;                         XMLAGG(&#10;                                          XMLELEMENT(Ewo_text_action.text CHR(10) ).EXTRACT('//text()')&#10;                                                          ORDER BY workstep_link.sequenceno wo_text_action.actionno_i&#10;                                                         ).GetClobVal()CHR(10)&#10;                                       ) as action_text" id="action_text"/>
