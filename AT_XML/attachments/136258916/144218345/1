    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_CertPaths" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_sequence.seqno_i" id="wp_sequence.seqno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as met_link" id="met_link"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.pickslipno" id="pickslip_booked.pickslipno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.partno" id="pickslip_booked.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.serialno" id="pickslip_booked.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.batchno" id="pickslip_booked.batchno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;  CASE WHEN dbl.linkno_i IS NULL THEN `Certificate_not_found` &#10;    ELSE&#10;      TO_CHAR(`\\msk.aeroflot.ru\amos\PROD\WEB_DRIVE\`)||&#10;      CASE WHEN (dbl.link_type = `D`) THEN REPLACE(dbl.destination_key `/``\`) ELSE TO_CHAR(ste_content_list.engine_id) END&#10;    END as certificate_path" id="certificate_path"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.cert_date@">
          <ds:object>@VAR.cert_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
  wp_header.wpno,
  wo_header.ac_registr,
  wp_sequence.seqno_i,
  wo_header.event_perfno_i as met_link,
  pickslip_booked.pickslipno, 
  pickslip_booked.partno,
  pickslip_booked.serialno,
  pickslip_booked.batchno,
  CASE WHEN dbl.linkno_i IS NULL THEN 'Certificate_not_found' 
    ELSE
      TO_CHAR('\\msk.aeroflot.ru\amos\PROD\WEB_DRIVE\')||
      CASE WHEN (dbl.link_type = 'D') THEN REPLACE(dbl.destination_key, '/', '\') ELSE TO_CHAR(ste_content_list.engine_id) END
    END as certificate_path
FROM wo_header
LEFT JOIN wp_assignment ON wp_assignment.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wp_header ON wp_header.wpno_i = wp_assignment.wpno_i
LEFT JOIN wp_sequence ON wo_header.event_perfno_i = wp_sequence.event_perfno_i AND wp_sequence.status = 0
LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wo_text_action ON wo_text_action.workstep_linkno_i = workstep_link.workstep_linkno_i
LEFT JOIN part_request_2 ON part_request_2.event_type = 'WSL' AND part_request_2.event_key = workstep_link.workstep_linkno_i
LEFT JOIN pickslip_detail ON (pickslip_detail.part_requestno_i = part_request_2.part_requestno_i)
LEFT JOIN pickslip_booked ON pickslip_booked.recno = pickslip_detail.recno AND pickslip_booked.pickslipno = pickslip_detail.pickslipno
LEFT JOIN history ON history.recdetailno_i = pickslip_booked.recdetailno_i AND history.vm = 'B1'
LEFT JOIN rotables ON rotables.psn = history.psn
LEFT JOIN certificate_link ON certificate_link.source_type = 'RO' AND certificate_link.source_key = rotables.psn
LEFT JOIN certificate ON certificate.certificate_i = certificate_link.certificate_i
LEFT JOIN db_link dbl_cert ON dbl_cert.source_type = 'CERT' AND dbl_cert.source_pk = certificate.certificate_i
LEFT JOIN db_link dbl_rec ON dbl_rec.source_type = 'RD' AND dbl_rec.source_pk = pickslip_booked.recdetailno_i
LEFT JOIN db_link dbl ON (dbl_rec.linkno_i IS NULL AND dbl_cert.linkno_i = dbl.linkno_i) OR (dbl_rec.linkno_i IS NOT NULL AND dbl_rec.linkno_i = dbl.linkno_i)
LEFT JOIN ste_content_list ON dbl.link_type = 'S' AND TO_CHAR(ste_content_list.storage_id) = dbl.destination_key
