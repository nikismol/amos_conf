    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL__RRJ_CI_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as part_description" id="part_description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ata_chapter as part_ata_chapter" id="part_ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.historyno_i as historyno_i" id="historyno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.vm as vm" id="vm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.label_start as label_start" id="label_start"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.type as wo_type" id="wo_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ata_chapter as wo_ata_chapter" id="wo_ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.psn" id="history.psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;           TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + history.del_date'dd.mm.yyyy') as instal_date" id="instal_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select
           history.partno as partno,
           history.serialno as serialno,
           part.description as part_description,
           part.ata_chapter as part_ata_chapter,
           history.historyno_i as historyno_i,
           history.vm as vm,
           history.label_start as label_start,
           wo_header.type as wo_type,
           wo_header.event_perfno_i as event_perfno_i,
           wo_header.ata_chapter as wo_ata_chapter,
           history.psn,
           TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + history.del_date, 'dd.mm.yyyy') as instal_date
      from history
      left join (
                 select
                      history.partno,
                      history.historyno_i,
                      min(history.historyno_i) over (partition by history.psn) as  min_historyno_i,
                      history.vm
                 from history
                 where 1=1 
                ) m on history.historyno_i=m.historyno_i and m.historyno_i=m.min_historyno_i and m.vm='YE'
      left join wo_header ON history.event_perfno_i=wo_header.event_perfno_i
      left join aircraft ON history.ac_registr=aircraft.ac_registr
      left join part ON history.partno=part.partno      
      where 1=1
            and history.vm IN ('YE')
            and history.del_date &gt;=@VAR.v01_date_from@
            and history.del_date &lt;=@VAR.v02_date_to@
            and history.created_by&lt;&gt;'MIGRUSR'
            and history.label_start='Y'
            and m.historyno_i is null
            and aircraft.ac_typ='RRJ'
      order by 1, 2, historyno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_RRJ_Last_Receiving" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="historyno_i" id="historyno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="orderno" id="orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="purch_price" id="purch_price"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="order_type" id="order_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="vendor" id="vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="currency" id="currency"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL__RRJ_CI_MAIN.history.psn@">
          <ds:object>@AFL__RRJ_CI_MAIN.history.psn@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL__RRJ_CI_MAIN.historyno_i@">
          <ds:object>@AFL__RRJ_CI_MAIN.historyno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT historyno_i,
             orderno,
             purch_price,
             order_type,
             vendor,
             currency 
FROM (
             SELECT history.historyno_i, 
                          MAX(history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i,
                          history.vm,
                          od_header.orderno,
                          od_detail.purch_price,
                          od_header.vendor||' '||address.name||' '||address.name_1||' '||address.name_2 as vendor,
                          od_header.order_type,
                          od_detail.currency
             FROM history
             JOIN od_rec_detail ON history.recdetailno_i=od_rec_detail.recdetailno_i AND od_rec_detail.status &lt;&gt; 9 AND od_rec_detail.recno &lt;&gt; -1
             JOIN od_detail ON od_rec_detail.detailno_i=od_detail.detailno_i
             JOIN od_header ON od_header.orderno=od_rec_detail.orderno AND od_header.order_type IN ('P', 'L', 'Y', 'PR')
             LEFT JOIN address ON address.vendor=od_header.vendor
             WHERE history.vm IN ('B1', 'YA')
                          AND history.psn = @AFL__RRJ_CI_MAIN.history.psn@
                          AND history.historyno_i &lt; @AFL__RRJ_CI_MAIN.historyno_i@
                          AND od_header.ext_state NOT IN ('CA', 'D', 'T', 'C', 'IC')
                          AND od_detail.ext_state NOT IN ('CA', 'D', 'T', 'C', 'IC')
            )
WHERE historyno_i=max_historyno_i
             AND vm='B1'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
