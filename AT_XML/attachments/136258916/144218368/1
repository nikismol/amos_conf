        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN forecast.dimension = 'H' THEN &#10;TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.togo)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.togo)60))'FM00')      &#10;     WHEN forecast.dimension IN ('C''AC') THEN &#10;                        TO_CHAR(TO_NUMBER((forecast.togo + (counter_c.life_value - h2.tac))))&#10;ELSE '' &#10;END AS togo" id="togo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN forecast.dimension = 'H' THEN &#10;TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.togo + (counter_h.life_value - h2.tam))/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.togo + (counter_h.life_value - h2.tam))60))'FM00')      &#10;     WHEN forecast.dimension IN ('C''AC') THEN &#10;                        TO_CHAR(TO_NUMBER((forecast.togo + (counter_c.life_value - h2.tac))))&#10;ELSE '' &#10;END AS sum_togo" id="sum_togo"/>
