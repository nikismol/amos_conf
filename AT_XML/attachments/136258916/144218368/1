      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
rotables.location,
position.description,
rotables.tree_position,
rotables.partno,
rotables.serialno,
rotables.partnonew,
rotables.serialnonew,
rotables.ac_registr,
part.description,
aircraft.ac_typ,
part.ata_chapter,
h2.event_perfno_i,
wp_header.wpno,
wp_seq.seqno_i,
forecast.requirement,
h2.tsn,
h2.csn,
rotables.psn,
forecast.dimension,
CASE WHEN forecast.dimension = 'H' THEN 
TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.togo)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.togo),60)),'FM00')||' H'      
     WHEN forecast.dimension IN ('C', 'AC') THEN 
                        TO_CHAR(TO_NUMBER(forecast.togo))||' C'
     WHEN  forecast.dimension IN ('D', 'ID', 'SD') AND forecast.interval_dimension != 'MT' THEN   
                         TO_CHAR(TRUNC(TO_NUMBER(forecast.togo)))||' D'
     WHEN  forecast.dimension IN ('D', 'ID', 'SD') AND forecast.interval_dimension = 'MT' THEN   
                         TO_CHAR(TRUNC(TO_NUMBER(forecast.togo)/60/24))||' D'
ELSE '' 
END AS togo,
CASE WHEN forecast.dimension = 'H' THEN 
TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.togo + (counter_h.life_value - h2.tam))/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.togo + (counter_h.life_value - h2.tam)),60)),'FM00')||' H'      
     WHEN forecast.dimension IN ('C', 'AC') THEN 
                        TO_CHAR(TO_NUMBER((forecast.togo + (counter_c.life_value - h2.tac))))||' C'
     WHEN  forecast.dimension IN ('D', 'ID', 'SD') AND forecast.interval_dimension != 'MT' THEN   
                         TO_CHAR(TRUNC(TO_NUMBER((forecast.togo + (counter_c.life_value - h2.tac)))))||' D'  
     WHEN  forecast.dimension IN ('D', 'ID', 'SD') AND forecast.interval_dimension = 'MT' THEN   
                         TO_CHAR(TRUNC(TO_NUMBER(forecast.togo + (counter_c.life_value - h2.tac))/60/24))||' D'
ELSE '' 
END AS sum_togo
FROM rotables
LEFT JOIN part ON rotables.partno = part.partno
LEFT JOIN aircraft ON rotables.ac_registr = aircraft.ac_registr
LEFT JOIN position ON rotables.locid_pk = position.locid_pk
LEFT JOIN ( 
            SELECT  h1.psn,
                    h1.del_date,
                    h1.event_perfno_i,
                    h1.max_del,
                    h1.historyno_i,
                    h1.tsn,
                    h1.csn,
                    h1.tam,
                    h1.tac
            FROM
                (
                    SELECT history.psn,
                    history.event_perfno_i,
                    history.historyno_i,
                    history.del_date,
                    MAX(history.del_date) OVER (PARTITION BY history.psn) AS max_del,
                CASE WHEN history.tsn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn),60)),'FM00') END AS tsn,
              	CASE WHEN history.csn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(history.csn) END AS csn,
                TO_NUMBER(history.tam) AS tam,
              	TO_NUMBER(history.tac) AS tac
                    FROM history
                    WHERE history.vm = 'YE'
                ) h1
            WHERE h1.del_date = h1.max_del
            ) h2 ON rotables.psn = h2.psn
LEFT JOIN wo_header ON h2.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i = wp_header.wpno_i
LEFT JOIN (         SELECT wp_sequence.event_perfno_i,
                                   wp_sequence.seqno_i
                    FROM wp_sequence
                    WHERE wp_sequence.status&lt;&gt;9
                   ) wp_seq ON wp_assignment.event_perfno_i = wp_seq.event_perfno_i
LEFT JOIN forecast ON rotables.serialno = forecast.serialno AND forecast.partno = rotables.partno
LEFT JOIN 
            (
                        SELECT 
                                aircraft.ac_registr
                                ,counter_definition.code
                                ,counter_definition.name
                                ,counter.life_value
                        FROM counter
                        LEFT JOIN aircraft ON counter.ref_key = aircraft.aircraftno_i AND counter.ref_type = 'AC_INT'
                        LEFT JOIN counter_template ON counter.counter_templateno_i = counter_template.counter_templateno_i
                        LEFT JOIN counter_definition ON counter_template.counter_defno_i = counter_definition.counter_defno_i
                        WHERE counter_definition.counter_defno_i = 1
                        GROUP BY 
                                aircraft.ac_registr
                                ,counter_definition.code
                                ,counter_definition.name
                                ,counter.life_value
            ) counter_h ON aircraft.ac_registr = counter_h.ac_registr
LEFT JOIN 
            (
                        SELECT 
                                aircraft.ac_registr
                                ,counter_definition.code
                                ,counter_definition.name
                                ,counter.life_value
                        FROM counter
                        LEFT JOIN aircraft ON counter.ref_key = aircraft.aircraftno_i AND counter.ref_type = 'AC_INT'
                        LEFT JOIN counter_template ON counter.counter_templateno_i = counter_template.counter_templateno_i
                        LEFT JOIN counter_definition ON counter_template.counter_defno_i = counter_definition.counter_defno_i
                        WHERE counter_definition.counter_defno_i = 2
                        GROUP BY 
                                aircraft.ac_registr
                                ,counter_definition.code
                                ,counter_definition.name
                                ,counter.life_value
            ) counter_c ON aircraft.ac_registr = counter_c.ac_registr
WHERE
aircraft.status &lt;&gt; 9
AND ((ASCII(forecast.requirement) != 49824) OR forecast.requirement IS NULL)
AND (REGEXP_LIKE(rotables.ac_registr, REPLACE('@VAR.acreg@', ', ', '|')) OR '@VAR.acreg@' IS NULL)
AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.actype@', ', ', '|')) OR '@VAR.actype@' IS NULL)
AND (REGEXP_LIKE(part.ata_chapter, REPLACE('@VAR.ata@', ', ', '|')) OR '@VAR.ata@' IS NULL)
AND 
(
('@VAR.limit@' = 'LL' AND forecast.requirement = 'LL') OR
('@VAR.limit@' = 'HT' AND forecast.requirement IS NOT NULL AND forecast.requirement != 'LL') OR
('@VAR.limit@' = 'ALL')
)
Order by part.ata_chapter</se:textStatement>
        </se:sqlStatement>
