      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT WO_SUM.wono_display as wono_display,
       WO_SUM.ac_registr as ac_registr,
       WO_SUM.ac_typ as ac_typ,
       WO_SUM.wo_issue_date as wo_issue_date,
       WO_SUM.wo_issue_time as wo_issue_time,
       WO_SUM.l_c_date as l_c_date,
       WO_SUM.ata_chapter as ata_chapter,
       WO_SUM.type as wo_type,
       WO_SUM.issue as issue,
       WO_SUM.pn as pn,
       WO_SUM.store_report as store_report,
       WO_SUM.partno_off as partno_off,
       WO_SUM.state as state,
       RTRIM(
             XMLAGG(
                    XMLELEMENT(E,WO_SUM.action, CHR(10)
                              ).EXTRACT('//text()')
                              ORDER BY WO_SUM.sequenceno
                    ).GetClobVal(), CHR(10)
             ) as action

FROM (
      SELECT DISTINCT wo_header.workorderno_display as wono_display,
             wo_header.ac_registr as ac_registr,
             aircraft.ac_typ as ac_typ,
             DECODE (wo_header.state,
                     'O', 'Open',
                     'C', 'Closed',
                     '') as state,
             TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.issue_date+729), 'DD.MM.YYYY') as wo_issue_date,
             DECODE (wo_header.issue_time,
                     NULL, NULL,
                     TO_CHAR(TRUNC(wo_header.issue_time/60),'FM9900')||':'||TO_CHAR(TRUNC(MOD(wo_header.issue_time,60)),'FM00')) as wo_issue_time,
             CASE WHEN wo_header.state='O' AND forecast.expected_date&lt;1491308 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (forecast.expected_date+729), 'DD.MM.YYYY')
                  WHEN wo_header.state='O' AND forecast.expected_date&gt;=1491308 THEN 'No Limit'
                  WHEN wo_header.state='C' THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.closing_date+729), 'DD.MM.YYYY')
                  ELSE ''
             END as l_c_date,
             CASE WHEN wo_header.state='O' AND forecast.expected_date!=1491308 THEN TO_CHAR(TRUNC(forecast.expected_time/60),'FM9900')||':'||TO_CHAR(TRUNC(MOD(forecast.expected_time,60)),'FM00')
                 WHEN wo_header.state='C' THEN REGEXP_REPLACE(wo_header.release_time, '([[:digit:]]{2})([[:digit:]]{2})', '\1:\2')
                 ELSE ''
                 END as l_c_time,
             wo_header.ata_chapter as ata_chapter,
             DECODE (wo_header.type,
                     'C', 'CABIN',
                     'M', 'MAINT',
                     'P', 'PIREP',
                     'S', 'SCHED',
                     '') as type,
             wo_desc.issue as issue,
	         part_req.pn as pn,
	         part_accessable_qty.store_report as store_report,
             pn_off.partno_off as partno_off,
             action_text.action as action, 
             action_text.sequenceno as sequenceno
      FROM wo_header
      LEFT JOIN forecast ON wo_header.event_perfno_i=forecast.event_perfno_i
      LEFT JOIN (SELECT workstep_link.event_perfno_i as event_perfno_i,
                        CASE WHEN wo_text_description.text IS NULL THEN TO_CHAR(wo_text_description.text_html) ELSE TO_CHAR(wo_text_description.text) END as issue
                 FROM workstep_link 
                 LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
                 WHERE workstep_link.sequenceno='1'
                 ) wo_desc ON wo_header.event_perfno_i=wo_desc.event_perfno_i
      LEFT JOIN (
		         SELECT workstep_link.event_perfno_i as event_perfno_i,
		                wo_text_action.action_date as ac_date
		         FROM workstep_link
	             LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i=wo_text_action.workstep_linkno_i
		        ) action_date ON wo_header.event_perfno_i=action_date.event_perfno_i 
      LEFT JOIN (SELECT workstep_link.event_perfno_i as event_perfno_i,
                        LISTAGG (CASE WHEN LENGTH(part.description) + LENGTH(part_request_2.partno) &lt;= 48
					      	        THEN part.description||';'||part_request_2.partno||';'||TO_CHAR(ROUND(TO_NUMBER(part_request_2.qty), 2))||'ea'
                                      ELSE SUBSTR(part.description, 1, 42)||'...'||';'||part_request_2.partno||';'||TO_CHAR(ROUND(TO_NUMBER(part_request_2.qty), 2))||'ea'
                                 END, CHR(10)) WITHIN GROUP (ORDER BY part_request_2.part_requestno_i) as pn
		         FROM workstep_link
                 LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key
		         LEFT JOIN part ON part_request_2.partno=part.partno
		         WHERE part_request_2.event_type = 'WSL'
		         GROUP BY workstep_link.event_perfno_i
                ) part_req ON wo_header.event_perfno_i=part_req.event_perfno_i
      LEFT JOIN (SELECT workstep_link.event_perfno_i as event_perfno_i,
                        LISTAGG (part_frcst.store_report, CHR(10)) WITHIN GROUP (ORDER BY part_request_2.part_requestno_i) as store_report
		         FROM workstep_link
                 LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key
		         LEFT JOIN (
                            SELECT part_request_2.part_requestno_i as part_requestno_i,
					      	     CASE WHEN part_request_2.status IN ('1', '2') THEN ' '
                                        WHEN part_request_2.status='3' THEN 'Suspended'
								        ELSE CASE WHEN planned_station IS NULL THEN TRUNC(TO_NUMBER(part_forecast.accessable_system_qty), 2)||'ea on stock'
							                 ELSE TO_NUMBER(part_forecast.accessable_station_qty)||'ea on stock'
						                     END
                                   END as store_report
                            FROM part_request_2
                            LEFT JOIN part_forecast ON part_request_2.part_requestno_i=part_forecast.part_requestno_i
                           ) part_frcst ON part_request_2.part_requestno_i=part_frcst.part_requestno_i
		         WHERE part_request_2.event_type = 'WSL'
	      	     GROUP BY workstep_link.event_perfno_i
                ) part_accessable_qty ON wo_header.event_perfno_i=part_accessable_qty.event_perfno_i
      LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
      LEFT JOIN (SELECT wo_part_on_off.event_perfno_i as event_perfno_i,
                 LISTAGG (wo_part_on_off.partno_off, CHR(10)) WITHIN GROUP (ORDER BY wo_part_on_off.partno_off) as partno_off
                 FROM wo_part_on_off
                 GROUP BY wo_part_on_off.event_perfno_i
                ) pn_off ON wo_header.event_perfno_i=pn_off.event_perfno_i
      LEFT JOIN (SELECT workstep_link.event_perfno_i as event_perfno_i,
                        workstep_link.sequenceno as sequenceno,
                        (TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_text_action.action_date+729), 'DD.MM.YYYY'))
                        ||' '||TO_CHAR(TRUNC(wo_text_action.action_time/60),'FM9900')||':'||TO_CHAR(TRUNC(MOD(wo_text_action.action_time,60)),'FM00')
                        ||': '||TO_CHAR(wo_text_action.text) as action
		         FROM workstep_link
	             LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i=wo_text_action.workstep_linkno_i
	      	     WHERE wo_text_action.action_date IS NOT NULL
                 ORDER BY workstep_link.sequenceno
                ) action_text ON wo_header.event_perfno_i=action_text.event_perfno_i
      WHERE wo_header.type NOT IN ('T', 'PD')
                     AND (
                                '@VAR.ATA_FILTER@'='Y' AND (REGEXP_LIKE (wo_header.ata_chapter, REPLACE (REPLACE ('@VAR.ata@', '@VAR.ata@', '^'||'@VAR.ata@'), ', ', '|^')) OR '@VAR.ata@' IS NULL)
                                OR
                                '@VAR.ATA_FILTER@'='N' AND (REGEXP_LIKE (wo_header.ata_chapter, REPLACE ('@VAR.ata@', ', ', '|')) OR '@VAR.ata@' IS NULL)
                               )
            AND aircraft.status&lt;&gt;9
            AND (
                 aircraft.ac_typ='A32S' AND '@VAR.AC_A32S@'='Y'
                 OR
                 aircraft.ac_typ='A330' AND '@VAR.AC_A330@'='Y'
                 /* 16-01-2020 
                    vtsymbal add new ac_typ A350
                */
                 OR
                 aircraft.ac_typ='A350' AND '@VAR.AC_A350@'='Y'
                 OR
                 aircraft.ac_typ='B737' AND '@VAR.AC_B737@'='Y'
                 OR
                 aircraft.ac_typ='B777' AND '@VAR.AC_B777@'='Y'
                 OR
                 aircraft.ac_typ='RRJ' AND '@VAR.AC_RRJ@'='Y'
                )                 

            AND (REGEXP_LIKE(wo_header.state, REPLACE('@VAR.wo_state@', ', ', '|')) OR REPLACE('@VAR.wo_state@', 'all', '') IS NULL)
            AND (
                 @VAR.wo_issue_from@ = 0 AND @VAR.wo_issue_to@ = 0 AND wo_header.issue_date LIKE '%'
                 OR @VAR.wo_issue_from@ &gt; 0 AND @VAR.wo_issue_to@ = 0 AND wo_header.issue_date &gt;= @VAR.wo_issue_from@
                 OR @VAR.wo_issue_from@ = 0 AND @VAR.wo_issue_to@ &gt; 0 AND wo_header.issue_date &lt;= @VAR.wo_issue_to@
                 OR @VAR.wo_issue_from@ &gt; 0 AND @VAR.wo_issue_to@ &gt; 0 AND wo_header.issue_date &gt;= @VAR.wo_issue_from@ AND wo_header.issue_date &lt;= @VAR.wo_issue_to@
                )
            AND (
                 '@VAR.wo_state@'='O' AND wo_header.closing_date IS NULL
                 OR '@VAR.wo_state@'='all' AND @VAR.wo_closing_from@ = 0 AND @VAR.wo_closing_to@ = 0 AND (wo_header.closing_date IS NULL OR wo_header.closing_date LIKE '%')
                 OR '@VAR.wo_state@'='all' AND @VAR.wo_closing_from@ &gt; 0 AND @VAR.wo_closing_to@ = 0 AND wo_header.closing_date &gt;= @VAR.wo_closing_from@
                 OR '@VAR.wo_state@'='all' AND @VAR.wo_closing_from@ = 0 AND @VAR.wo_closing_to@ &gt; 0 AND wo_header.closing_date &lt;= @VAR.wo_closing_to@
                 OR '@VAR.wo_state@'='all' AND @VAR.wo_closing_from@ &gt; 0 AND @VAR.wo_closing_to@ &gt; 0 AND wo_header.closing_date &gt;= @VAR.wo_closing_from@ AND wo_header.closing_date &lt;= @VAR.wo_closing_to@
                 OR '@VAR.wo_state@'='C' AND @VAR.wo_closing_from@ = 0 AND @VAR.wo_closing_to@ = 0 AND wo_header.closing_date IS NOT NULL
                 OR '@VAR.wo_state@'='C' AND @VAR.wo_closing_from@ &gt; 0 AND @VAR.wo_closing_to@ = 0 AND wo_header.closing_date &gt;= @VAR.wo_closing_from@
                 OR '@VAR.wo_state@'='C' AND @VAR.wo_closing_from@ = 0 AND @VAR.wo_closing_to@ &gt; 0 AND wo_header.closing_date &lt;= @VAR.wo_closing_to@
                 OR '@VAR.wo_state@'='C' AND @VAR.wo_closing_from@ &gt; 0 AND @VAR.wo_closing_to@ &gt; 0 AND wo_header.closing_date &gt;= @VAR.wo_closing_from@ AND wo_header.closing_date &lt;= @VAR.wo_closing_to@
                )
            AND (
                 @VAR.action_from@ = 0 AND @VAR.action_to@ = 0 AND (action_date.ac_date IS NULL OR action_date.ac_date LIKE '%')
                 OR @VAR.action_from@ &gt; 0 AND @VAR.action_to@ = 0 AND action_date.ac_date &gt;= @VAR.action_from@
                 OR @VAR.action_from@ = 0 AND @VAR.action_to@ &gt; 0 AND action_date.ac_date &lt;= @VAR.action_to@
                 OR @VAR.action_from@ &gt; 0 AND @VAR.action_to@ &gt; 0 AND action_date.ac_date &gt;= @VAR.action_from@ AND action_date.ac_date &lt;= @VAR.action_to@
                )
     ) WO_SUM
GROUP BY WO_SUM.wono_display,
         WO_SUM.ac_registr,
         WO_SUM.ac_typ,
         WO_SUM.wo_issue_date,
         WO_SUM.wo_issue_time,
         WO_SUM.l_c_date,
         WO_SUM.ata_chapter,
         WO_SUM.type,
         WO_SUM.issue,
         WO_SUM.pn,
         WO_SUM.store_report,
         WO_SUM.partno_off,
         WO_SUM.state
ORDER BY ac_typ, ac_registr, wono_display</se:textStatement>
        </se:sqlStatement>
