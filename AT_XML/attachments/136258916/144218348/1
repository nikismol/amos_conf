      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT 
ac_registr,
event_perfno_i,
type,
WOissued,
event_type,
event_name,
event_display,
event_status,
state,
headerstatus,
taskcard_type,
orderdate,
ext_state,
orderno,
confirmed_date,
target_date,
planned_date,
partno,
workstep_linkno_i,
serialno

FROM

(SELECT DISTINCT
       aircraft_event.ac_registr||CASE WHEN aircraft_od.ac_registr IS NOT NULL AND aircraft_event.ac_registr!=aircraft_od.ac_registr THEN ', '||aircraft_od.ac_registr ELSE '' END as ac_registr,
       wo_header.event_perfno_i as event_perfno_i,
       wo_header.type as type,
CASE WHEN wo_header.type NOT IN ('T', 'PD')  THEN 'Y'
     ELSE ''
END as WOissued,
CASE WHEN '@AMOS_VERSION@' LIKE '19.12%'
           THEN DECODE (wo_event_link.event_type,
                                        'RORE', 'Part Requirement',
                                        'CHTI', 'Check',
                                        'PARE', 'Component Replacement',
                                        'DOC_EFF', 'Document Eff.',
                                        'TCEFFLI', 'Taskcard Eff.'
                                       )
            ELSE DECODE(wo_event_link.event_type,
                                       'MEC', 'Check',
                                       'MED', 'Document',
                                       'MEP', 'Part Requirement',
                                       'MER', 'Part Replacment',
                                       'MET', 'Taskcard',
                                       '')
END as event_type,
       wo_event_link.event_name as event_name,
       wo_event_link.event_display as event_display,
       wo_event_link.event_status as event_status,
       wo_event_link.pending_status,
       wo_header.state as state,
       wo_header.status as headerstatus,
       wo_event_link.taskcard_type as taskcard_type,
       od_header.orderdate as orderdate,
       od_header.orderno as orderno, 
       od_header.ext_state as ext_state,
       od_detail.target_date as target_date,
       od_detail.confirmed_date confirmed_date,
       part_forecast.planned_date as planned_date,
       od_detail.partno as partno,
       od_detail.serialno as serialno,
       workstep_link.workstep_linkno_i as workstep_linkno_i   
FROM od_header
LEFT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i   
LEFT JOIN part_forecast ON od_detail.partno = part_forecast.partno
LEFT JOIN part_request_od_detail ON od_detail.detailno_i = part_request_od_detail.od_detailno_i 
LEFT JOIN part_request_2 ON part_request_od_detail.part_requestno_i = part_request_2.part_requestno_i
LEFT JOIN workstep_link ON part_request_2.event_key = workstep_link.workstep_linkno_i  
LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i       
LEFT JOIN wo_event_link ON wo_header.event_perfno_i=wo_event_link.event_perfno_i 
LEFT JOIN aircraft aircraft_event ON wo_header.ac_registr = aircraft_event.ac_registr  
LEFT JOIN aircraft aircraft_od ON wo_header.ac_registr = aircraft_od.ac_registr  
WHERE (REGEXP_LIKE(od_header.ext_state, REPLACE('@VAR.OState@', ', ', '|')) OR '@OState@' IS NULL) 
      AND (
           (REGEXP_LIKE(wo_header.ac_registr, REPLACE('@VAR.AC@', ', ', '|')) OR '@AC@' IS NULL)
           AND aircraft_event.status&lt;&gt;9 
           OR 
           part_request_od_detail.part_requestno_i IS NOT NULL
           AND (REGEXP_LIKE(aircraft_od.ac_registr, REPLACE('@VAR.AC@', ', ', '|')) OR '@AC@' IS NULL) 
           AND (REGEXP_LIKE(od_header.ext_state, REPLACE('@VAR.OState@', ', ', '|')) OR '@OState@' IS NULL) 
           AND (
                od_header.order_type = 'PR' 
                OR od_header.order_type = 'P' 
                OR od_header.order_type = 'L' 
                OR od_header.order_type = 'X'
               )
           AND aircraft_od.status &lt;&gt;9
          )
ORDER BY ac_registr, od_header.orderdate)
ORDER BY ac_registr, orderdate</se:textStatement>
        </se:sqlStatement>
