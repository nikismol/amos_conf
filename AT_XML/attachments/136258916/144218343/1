      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT

DISTINCT (aircraft.ac_registr) as ac_registr,
CASE WHEN REGEXP_LIKE(rotables.partno, '^[0-9]+$') AND rotables.partno LIKE ('0%') THEN chr(39)||rotables.partno ELSE rotables.partno END as partno,
CASE WHEN REGEXP_LIKE(rotables.serialno, '^[0-9]+$') AND rotables.serialno LIKE ('0%') THEN chr(39)||rotables.serialno ELSE rotables.serialno END as serialno,
part.description as description,
rotables.condition as condition,
part.ata_chapter as ata_chapter,
d_ata.ata_description as ata_description,
rotables.location as position,
CASE WHEN rotables.releaseno IS NOT NULL THEN TO_CHAR(rotables.releaseno) ELSE '-' END as releaseno,
CASE WHEN rotables.labelno IS NOT NULL THEN TO_CHAR(rotables.labelno) ELSE '-' END as  labelno,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (rotables.date_inst+729), 'DD.MM.YYYY') as inst_date,

CASE WHEN counter_h.is_unknown = 'Y' THEN 'Unknown' ELSE
(TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value)/60),'FM999999999900')) || ':' ||
TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value),60)),'FM00') ||' H') END as TAH,

CASE WHEN counter_c.is_unknown = 'Y' THEN 'Unknown' ELSE
(TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on+counter_c.life_value)||' C') END as TAC,

CASE WHEN counter_d.is_unknown='Y' THEN 'Unknown' ELSE
TRUNC(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE, 'DD.MM.YYYY'), 'DD.MM.YYYY') - TO_DATE(TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (counter_value_d.readout_date+729), 'DD.MM.YYYY'), 'DD.MM.YYYY'))/365)||'y'||' ,'||
MOD(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE, 'DD.MM.YYYY'), 'DD.MM.YYYY') - TO_DATE(TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (counter_value_d.readout_date+729), 'DD.MM.YYYY'), 'DD.MM.YYYY')),365)||'d'
END as tsn_d,

TO_NUMBER (TO_DATE(TO_CHAR(SYSDATE, 'DD.MM.YYYY'), 'DD.MM.YYYY') - TO_DATE(TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (counter_id.readout_date+729), 'DD.MM.YYYY'), 'DD.MM.YYYY')) + counter_id.life_value as id,

CASE WHEN counter_ah.is_unknown = 'Y'
           THEN 'Unknown'
           WHEN counter_ah.is_unknown &lt;&gt; 'Y' AND counter_ah.master_counterno_i IS NULL
           THEN CASE WHEN counter_ah.life_value IS NOT NULL 
                                  THEN TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_ah.life_value)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_ah.life_value),60)),'FM00')||' AH'
                                  ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_ah.counter_life_value)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_ah.counter_life_value),60)),'FM00')||' AH'
                        END
           ELSE 
	CASE WHEN counter_ah_r.is_unknown = 'Y'
		   THEN 'Unknown'
		   WHEN counter_ah_r.is_unknown &lt;&gt; 'Y' AND counter_ah_r.life_value_apu IS NOT NULL
                                THEN TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_ah_r.life_value_r_on+counter_ah_r.life_value_apu-counter_ah_r.life_value_apu_on)/60),'FM999999999900')) 
                                 || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_ah_r.life_value_r_on+counter_ah_r.life_value_apu-counter_ah_r.life_value_apu_on),60)),'FM00')||' AH'
                                 ELSE ''
                      END
END as AH,

CASE WHEN counter_ac.is_unknown = 'Y'
	 THEN 'Unknown'
	 WHEN counter_ac.is_unknown &lt;&gt; 'Y' AND counter_ac.master_counterno_i IS NULL
	 THEN CASE WHEN counter_ac.life_value IS NOT NULL
			   THEN TO_CHAR(ROUND(TO_NUMBER(counter_ac.life_value), 2))||' AC'
			   ELSE TO_CHAR(ROUND(TO_NUMBER(counter_ac.counter_life_value), 2))||' AC'
		  END
	 ELSE 
	 CASE WHEN counter_ac_r.is_unknown = 'Y' THEN 'Unknown'
	 WHEN counter_ac_r.is_unknown &lt;&gt; 'Y' AND counter_ac_r.life_value_apu IS NOT NULL
			   THEN TO_CHAR(ROUND(TO_NUMBER(counter_ac_r.life_value_r_on+counter_ac_r.life_value_apu-counter_ac_r.life_value_apu_on), 2))||' AC'
			   ELSE ''
		  END
END as AC,


TO_CHAR(FLOOR (TO_NUMBER(counter_value_m_h.life_value)/60))||':'
||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(counter_value_m_h.life_value), 60)))&lt;10
	   THEN '0'||(TO_CHAR(MOD(TO_NUMBER(counter_value_m_h.life_value), 60)))
	   ELSE (TO_CHAR(MOD(TO_NUMBER(counter_value_m_h.life_value), 60)))
  END
||' H' as ACREG_TAH,

TO_NUMBER(counter_value_m_c.life_value)||' C' as ACREG_TAC,

forecast_dimension_i.requirement as requirement,
forecast_dimension_i.taskcardno as taskcardno,
forecast_dimension_i.dimension as dimension,
CASE WHEN forecast_dimension_i.counter_defno_i='1'
	 THEN CASE WHEN forecast_dimension_i.relative_due_at IS NOT NULL
			   THEN TO_CHAR(FLOOR (forecast_dimension_i.relative_due_at/60))||':'||CASE WHEN (TO_CHAR(MOD(forecast_dimension_i.relative_due_at, 60)))&lt;10
																	  					  THEN '0'||(TO_CHAR(MOD(forecast_dimension_i.relative_due_at, 60)))
																						  ELSE (TO_CHAR(MOD(forecast_dimension_i.relative_due_at, 60)))
																				      END ||' '||'H'
	 		   ELSE ''
		  END
	 WHEN forecast_dimension_i.counter_defno_i='2'
     THEN CASE WHEN forecast_dimension_i.relative_due_at IS NOT NULL THEN TO_CHAR(forecast_dimension_i.relative_due_at)||' '||'C' ELSE '' END
	 WHEN forecast_dimension_i.counter_defno_i='3'
	 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (forecast_dimension_i.absolute_due_at_ac+729), 'DD.MM.YYYY')
	 WHEN forecast_dimension_i.counter_defno_i='101'
	 THEN CASE WHEN forecast_dimension_i.relative_due_at IS NOT NULL THEN TO_CHAR(forecast_dimension_i.relative_due_at/60)||' '||'AH' ELSE '' END
	 WHEN forecast_dimension_i.counter_defno_i='102'
	 THEN CASE WHEN forecast_dimension_i.relative_due_at IS NOT NULL THEN TO_CHAR(forecast_dimension_i.relative_due_at)||' '||'AC' ELSE '' END
	 WHEN forecast_dimension_i.counter_defno_i='103'
	 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (forecast_dimension_i.absolute_due_at_ac+729), 'DD.MM.YYYY')
	 WHEN forecast_dimension_i.counter_defno_i='104'
	 THEN TO_CHAR(forecast_dimension_i.relative_due_at)
	 ELSE ''
END as due_at,

CASE WHEN forecast_dimension_i.interval_value IS NOT NULL THEN TO_CHAR(forecast_dimension_i.interval_value)||' '||forecast_dimension_i.interval_dimension ELSE '' END as interval_value,

CASE WHEN forecast_dimension_i.counter_defno_i='1'
	 THEN CASE WHEN forecast_dimension_i.since_req IS NOT NULL
			   THEN TO_CHAR(FLOOR(TO_NUMBER(forecast_dimension_i.since_req/60)))||':'||CASE WHEN (TO_CHAR(MOD(forecast_dimension_i.since_req, 60)))&lt;10
