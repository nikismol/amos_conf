                                                                        MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                                                        counter_value.readout_date*86400000+counter_value.readout_time as readout,
					  counter_value.life_value as life_value,
					  counter_definition.counter_defno_i,
					  counter.master_counterno_i
				 FROM
				 	  counter_value
				 LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 WHERE counter_definition.counter_defno_i='101'
				 ORDER BY
					  counter_value.counterno_i
				) max_counter_value
		   WHERE
				max_counter_value.readout=max_counter_value.max_readout
		  ) counter_value_m_ah ON counter_m_ah_apu.counterno_i=counter_value_m_ah.counterno_i

LEFT JOIN (SELECT
				DISTINCT (counter.ref_key),
				counter.counterno_i,
				counter.is_unknown AS is_unknown,
				counter.master_counterno_i,
				max_counter_value.on_counter_valueno_i,
				counter_definition.code,
				max_counter_value.life_value,
                                                        counter.life_value as counter_life_value,
				counter_value_on.life_value as life_value_on
		   FROM 
				counter
		   		LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
		   		LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
		   		LEFT JOIN (SELECT
					  			counter_value.counter_valueno_i as counter_valueno_i,
					  			counter_value.counterno_i as counterno_i,
						  		counter_value.on_counter_valueno_i,
                                                                                                                  MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                                                                                                  counter_value.readout_date*86400000+counter_value.readout_time as readout,
					  			counter_value.life_value as life_value,
					  			counter_definition.counter_defno_i
				 		   FROM
					  			counter_value
				 		   LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 		   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 		   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 		   WHERE
								counter_definition.counter_defno_i='102'
                                                                                                                AND counter_value.on_counter_valueno_i IS NOT NULL
				 		   ORDER BY
					            counter_value.counterno_i
						  ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
				LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
		   		WHERE
					 counter.ref_type='RO'
			   	            AND counter_definition.counter_defno_i='102'
					 AND (max_counter_value.readout=max_counter_value.max_readout OR max_counter_value.counterno_i IS NULL)
		  ) counter_ac ON rotables.psn=counter_ac.ref_key 
 
LEFT JOIN counter counter_m_ac ON counter_ac.master_counterno_i=counter_m_ac.counterno_i
LEFT JOIN counter counter_m_ac_apu ON counter_m_ac.ref_key=counter_m_ac_apu.ref_key AND counter_m_ac.ref_type=counter_m_ac_apu.ref_type
LEFT JOIN (SELECT 
				max_counter_value.counterno_i as counterno_i,
				max_counter_value.counter_valueno_i as counter_valueno_i,
			    max_counter_value.life_value as life_value,
				max_counter_value.master_counterno_i as master_counterno_i
		   FROM (SELECT
					  counter_value.counter_valueno_i as counter_valueno_i,
					  counter_value.counterno_i as counterno_i,
                                                                        MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                                                        counter_value.readout_date*86400000+counter_value.readout_time as readout,
					  counter_value.life_value as life_value,
					  counter_definition.counter_defno_i,
					  counter.master_counterno_i

				 FROM
				 	  counter_value
				 LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 WHERE counter_definition.counter_defno_i='102'
				 ORDER BY
					  counter_value.counterno_i
				) max_counter_value
		   WHERE
				max_counter_value.readout=max_counter_value.max_readout
		  ) counter_value_m_ac ON counter_m_ac_apu.counterno_i=counter_value_m_ac.counterno_i

LEFT JOIN (SELECT
				counter.ref_key as ref_key,
				counter.counterno_i as counterno_i_r,
				counter.is_unknown AS is_unknown,
				counter.life_value as life_value_r_on,
				counter.master_counterno_i master_counterno_i_r,
				counter_m.counterno_i as counterno_i_m,
				counter_m.master_counterno_i as master_counterno_i_m,
				counter_m.ref_key as ref_key_m,
				NVL(counter_m.life_value, 0) as life_value_apu,
				NVL(counter_value_apu_on.life_value, 0) as life_value_apu_on 
		   FROM
				counter
				LEFT JOIN counter_template ON counter_template.counter_templateno_i=counter.counter_templateno_i
				LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				LEFT JOIN counter_value counter_value ON counter.counterno_i=counter_value.counterno_i
				LEFT JOIN counter_value counter_value_apu_on ON counter_value.on_counter_valueno_i=counter_value_apu_on.counter_valueno_i 
				LEFT JOIN counter counter_m ON counter.master_counterno_i=counter_m.counterno_i
		   WHERE
				counter_definition.code='AH' 
				AND counter.ref_type='RO'
				AND counter_value_apu_on.life_value IS NOT NULL
		  ) counter_ah_r ON rotables.psn=counter_ah_r.ref_key

LEFT JOIN (SELECT
				counter.ref_key as ref_key,
				counter.counterno_i as counterno_i_r,
				counter.is_unknown as is_unknown,
				counter.life_value as life_value_r_on,
				counter.master_counterno_i master_counterno_i_r,
				counter_m.counterno_i as counterno_i_m,
				counter_m.master_counterno_i as master_counterno_i_m,
				counter_m.ref_key as ref_key_m,
				NVL(counter_m.life_value, 0) as life_value_apu, 
				NVL(counter_value_apu_on.life_value, 0) as life_value_apu_on
		   FROM
				counter
				LEFT JOIN counter_template ON counter_template.counter_templateno_i=counter.counter_templateno_i
				LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				LEFT JOIN counter_value counter_value ON counter.counterno_i=counter_value.counterno_i
				LEFT JOIN counter_value counter_value_apu_on ON counter_value.on_counter_valueno_i=counter_value_apu_on.counter_valueno_i 
				LEFT JOIN counter counter_m ON counter.master_counterno_i=counter_m.counterno_i
		   WHERE
				counter_definition.code='AC' 
				AND counter.ref_type='RO'
				AND counter_value_apu_on.life_value IS NOT NULL
		  ) counter_ac_r ON rotables.psn=counter_ac_r.ref_key

LEFT JOIN (SELECT
                forecast_dimension.interval_dimension as interval_dimension,
                forecast_dimension.dimension as dimension,
                TO_NUMBER(forecast_dimension.togo) as togo,
                TO_NUMBER(forecast_dimension.interval_value) as interval_value,
                TO_NUMBER(forecast_dimension.relative_due_at) as relative_due_at,
                forecast_dimension.expected_date as expected_date,
                TO_NUMBER(forecast_dimension.since_req) as since_req,
                forecast_dimension.event_perfno_i as event_perfno_i,
                wo_header.psn as psn,
                wo_event_link.event_key as event_key,
                wo_event_link.event_key_parent as event_key_parent,
                wo_event_link.event_key_root as event_key_root,
				tc.requirement as requirement,
				tc.taskcardno as taskcardno,
				forecast_dimension.counter_defno_i as counter_defno_i,
				TO_NUMBER(forecast_dimension.absolute_due_at_ac) as absolute_due_at_ac
           FROM
                forecast_dimension
                LEFT JOIN wo_header ON forecast_dimension.event_perfno_i=wo_header.event_perfno_i
                LEFT JOIN wo_event_link ON wo_header.event_perfno_i=wo_event_link.event_perfno_i
				LEFT JOIN (SELECT
                			DISTINCT part_req.partseqno_i as partseqno_i,
                			msc_taskcard.taskcardno as taskcardno,
               				part_req.reqseqno_i as reqseqno_i,
							requirement.description as requirement
           					FROM 
               				part_req
			   				LEFT JOIN requirement ON requirement.requirement=part_req.requirement
               				LEFT JOIN (SELECT
							   			DISTINCT (requirement_link.target) as target,
                               			requirement_link.source as source 
                          				FROM requirement_link 
                         				WHERE EXISTS (SELECT 1 
                                       				  FROM rotables 
                                        			  JOIN part_add_req ON rotables.psn = part_add_req.psn 
                                       				  JOIN requirement_link rl ON rl.source = part_add_req.add_reqseqno_i 
                                        			  WHERE requirement_link.source = rl.source 
                                        			  AND requirement_link.target = rl.target 
                                        			  AND requirement_link.source_mimetype = rl.source_mimetype 
                                        			  AND requirement_link.target_mimetype = rl.target_mimetype 
                                        			  AND rotables.ac_registr = '@VAR.ac_reg@'
                                       				 ) 
                               			AND requirement_link.source_mimetype = 'RORE'
                               			AND requirement_link.target_mimetype = 'TCREQLIH'
                               			AND requirement_link.code = 'W'
                               			OR EXISTS (SELECT 1 
                                          			FROM requirement_link rl 
                                          			JOIN part_req ON rl.source = part_req.reqseqno_i 
                                          			JOIN part ON part.partseqno_i = part_req.partseqno_i 
                                         			JOIN rotables ON rotables.partno = part.partno 
                                          			WHERE requirement_link.source = rl.source 
                                          			AND requirement_link.target = rl.target 
                                         			AND requirement_link.source_mimetype = rl.source_mimetype 
                                          			AND requirement_link.target_mimetype = rl.target_mimetype 
                                          			AND rotables.ac_registr = '@VAR.ac_reg@'
                                         		  )  
                               			AND requirement_link.source_mimetype = 'PAREQ' 
                               			AND requirement_link.target_mimetype = 'TCREQLIH' 
                               			AND requirement_link.code = 'W'
                         			 ) reqlink ON part_req.reqseqno_i=reqlink.source
               				LEFT JOIN (SELECT
							   				DISTINCT msc_requirement_tc_link.req_linkno_i,
                               				aircraft.ac_registr,
                               				msc_mp_link.mpno_i_operator,
                               				msc_taskcard_version.taskcard_verno_i as taskcard_verno_i,
                               				msc_taskcard_version.taskcardno_i as taskcardno_i,
                              				msc_requirement_tc_link.taskcardno as taskcardno,
                               				msc_requirement_tc_link.req_link_headerno_i as req_link_headerno_i
                          			   FROM msc_taskcard_version 
                         			   JOIN msc_operator_rev_req ON msc_taskcard_version.taskcard_verno_i = msc_operator_rev_req.taskcard_verno_i 
                          			   JOIN msc_requirement_tc_link ON msc_requirement_tc_link.req_linkno_i = msc_operator_rev_req.req_linkno_i 
                          			   JOIN msc_item ON msc_taskcard_version.taskcard_verno_i = msc_item.taskcard_verno_i 
                          			   JOIN msc_operator_revision ON msc_operator_rev_req.op_revisionno_i = msc_operator_revision.op_revisionno_i
																	 AND msc_operator_revision.revision_status IN ('a','b')
																	 AND msc_item.itemno_i = msc_requirement_tc_link.itemno_i_mri 
                          			   JOIN msc_mp_link ON msc_operator_revision.mp_linkno_i = msc_mp_link.mp_linkno_i 
                         			   JOIN msc_maintenance_program ON msc_mp_link.mpno_i_operator = msc_maintenance_program.mpno_i
																	   AND msc_maintenance_program.program_type = 'OMP' 
                          			   JOIN msc_ac_configuration ON msc_maintenance_program.mpno_i = msc_ac_configuration.mpno_i
																	AND msc_ac_configuration.program_type = 'OMP'
																	AND msc_ac_configuration.status = 0
																	AND msc_mp_link.mpno_i_requirement &lt;&gt; -11 
                          			   JOIN aircraft ON msc_ac_configuration.aircraftno_i = aircraft.aircraftno_i
														AND msc_maintenance_program.operated_by = aircraft.operator 
                          			   WHERE
                               		   aircraft.ac_registr = '@VAR.ac_reg@'
                        			  ) reqtc ON reqlink.target=reqtc.req_link_headerno_i
               			    LEFT JOIN msc_taskcard ON reqtc.taskcardno_i=msc_taskcard.taskcardno_i
           				    WHERE
                 				 (part_req.requirement_status!=9 OR part_req.requirement_status IS NULL)
								 AND reqtc.req_linkno_i IS NOT NULL
          				   ) tc ON wo_event_link.event_key_parent=tc.reqseqno_i
           WHERE
                wo_header.psn IS NOT NULL
                AND wo_event_link.event_type = 'RORE'
                AND wo_event_link.planable_status = 0
                AND wo_event_link.pending_status = 0
          ) forecast_dimension_i ON rotables.psn = forecast_dimension_i.psn

LEFT JOIN (SELECT
				ac_daily_average.ac_register as ac_register,
				TO_NUMBER(ac_average_period.average) as average
		   FROM 
				ac_daily_average
		   		LEFT JOIN ac_average_period ON ac_daily_average.daily_averageno_i=ac_average_period.daily_averageno_i
		   WHERE
				ac_daily_average.counter_defno_i='1'		   
		  ) ac_daily_h ON aircraft.ac_registr=ac_daily_h.ac_register

LEFT JOIN (SELECT
				ac_daily_average.ac_register as ac_register,
				TO_NUMBER(ac_average_period.average) as average
		   FROM 
				ac_daily_average
		   		LEFT JOIN ac_average_period ON ac_daily_average.daily_averageno_i=ac_average_period.daily_averageno_i
		   WHERE
				ac_daily_average.counter_defno_i='2'		   
		  ) ac_daily_c ON aircraft.ac_registr=ac_daily_c.ac_register

LEFT JOIN (SELECT
				ac_daily_average.ac_register as ac_register,
				TO_NUMBER(ac_average_period.average) as average
		   FROM 
				ac_daily_average
		   		LEFT JOIN ac_average_period ON ac_daily_average.daily_averageno_i=ac_average_period.daily_averageno_i
		   WHERE
				ac_daily_average.counter_defno_i='101'		   
		  ) ac_daily_ah ON aircraft.ac_registr=ac_daily_ah.ac_register

LEFT JOIN (SELECT
				ac_daily_average.ac_register as ac_register,
				TO_NUMBER(ac_average_period.average) as average
		   FROM 
				ac_daily_average
		   		LEFT JOIN ac_average_period ON ac_daily_average.daily_averageno_i=ac_average_period.daily_averageno_i
		   WHERE
				ac_daily_average.counter_defno_i='102'		   
		  ) ac_daily_ac ON aircraft.ac_registr=ac_daily_ac.ac_register

WHERE 
aircraft.ac_registr='@VAR.ac_reg@'
AND ('@VAR.req@'='all'
	 OR '@VAR.req@'='req' AND part_req.reqseqno_i IS NOT NULL
	 OR '@VAR.req@'='noreq' AND part_req.reqseqno_i IS NULL
	)
AND (REGEXP_LIKE(part_special.special, REPLACE('@VAR.special@', ', ', '|')) OR '@VAR.special@' IS NULL)
AND (REGEXP_LIKE(part.ata_chapter, REPLACE('@VAR.ata@', ', ', '|')) OR '@VAR.ata@' IS NULL)
AND (REGEXP_LIKE(rotables.location, REPLACE('@VAR.incl_position@', ', ', '|')) OR '@VAR.incl_position@' IS NULL)
AND (NOT REGEXP_LIKE(rotables.location, REPLACE('@VAR.excl_position@', ', ', '|')) OR '@VAR.excl_position@' IS NULL)
AND (NOT REGEXP_LIKE(rotables.location, REPLACE('^@VAR.excl_position_like@', ', ', '|')) OR '@VAR.excl_position_like@' IS NULL)
AND (part_req.requirement_status!=9 OR part_req.requirement_status IS NULL)
ORDER BY
part.ata_chapter, 2,3</se:textStatement>
        </se:sqlStatement>
