        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
DISTINCT (doc_cor.docno_i) as docno_i,
doc_cor.docno as docno,
doc_cor.rev as rev,
doc_cor.doc_type as doc_type,
doc_cor.ref_docno as ref_docno,
CASE WHEN doc_cor.ref_docno IS NOT NULL THEN doc_cor.docno||' &gt; '||doc_cor.ref_docno ELSE '' END as reference,
doc_cor.issue_date as issue_date,
doc_cor.ac_or_comp_doc as ac_or_comp_doc,
doc_cor.description as description,
doc_cor.effdate as effdate,
doc_cor.status as status,
doc_cor.superseded_by as superseded_by,
CASE WHEN doc_cor.tech_reason IN ('3', '4', '5', '12', '16', '20', '22') THEN doc_cor.reason
	 WHEN doc_cor.tech_reason IN ('6', '7', '13', '14', '15') THEN doc_cor.reason||' '||doc_cor.special_text_open
	 WHEN doc_cor.tech_reason IN ('1', '2', '8', '9', '10') THEN doc_cor.reason||' '||doc_cor.special_text_unknown
	 WHEN doc_cor.tech_reason='6' THEN 'Open / Next Due:'||doc_cor.due_dim1||' / WO:'||doc_cor.wono_new||' '||doc_cor.special_text_open
	 WHEN doc_cor.tech_reason='17' AND CONNECT_BY_ISLEAF='0' THEN 'THEN NEED CHECK - SEE CHILD'||doc_cor.special_text_closed
	 WHEN doc_cor.tech_reason='17' AND CONNECT_BY_ISLEAF='1' THEN 'Closed '||doc_cor.perf_dim1||' '||'WO:'||doc_cor.wono||' '||doc_cor.reason||doc_cor.special_text_closed
	 WHEN doc_cor.tech_reason='18' THEN ''
 	 WHEN doc_cor.tech_reason='19' THEN ''
	 WHEN doc_cor.tech_reason='21' THEN 'Closed '||doc_cor.perf_dim1||' '||'WO:'||doc_cor.wono||' '||doc_cor.special_text_closed
 	 WHEN doc_cor.tech_reason='23' THEN ''
	 WHEN doc_cor.tech_reason='11' THEN ''
	 ELSE ''
END as reason,
doc_cor.wono as wono,
doc_cor.wpno as wpno,
doc_cor.seqno as seqno,
doc_cor.wono_new as wono_new,
doc_cor.wpno_new as wpno_new,
doc_cor.seqno_new as seqno_new,
doc_cor.perf_dim1 as perf_dim1,
doc_cor.perf_dim2 as perf_dim2,
doc_cor.perf_dim3 as perf_dim3,
doc_cor.due_dim1 as due_dim1,
doc_cor.due_dim2 as due_dim2,
doc_cor.due_dim3 as due_dim3,
doc_cor.threshold as threshold,
doc_cor.interval as interval,
doc_cor.part as part
FROM
(
SELECT
DISTINCT (doc_base.docno_i) as docno_i,
rotables_aff.ac_registr as rotables_ac_registr,
doc_base.docno as docno,
doc_base.rev as rev,
ref_doc.ref_docno_i as ref_docno_i, 
ref_doc.ref_docno as ref_docno,
doc_base.parent_docno_i as parent_docno_i,
doc_base.ac_registr_map as ac_registr_map,
doc_base.event_type_part as event_type_part,
doc_base.ac_registr_part as ac_registr_part,
doc_base.ac_typ_doc as ac_typ_doc,
doc_header.doc_type as doc_type,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (doc_header.issue_date+729), 'DD.MM.YYYY') as issue_date,
doc_header.ac_or_comp_doc as ac_or_comp_doc,
CASE WHEN event_effectivity_mapping.event_status='O' THEN 'Open'
	 WHEN event_effectivity_mapping.event_status='C' THEN 'Closed'
	 WHEN event_effectivity_mapping.event_status='R' THEN 'Repetitive'
	 WHEN event_effectivity_mapping.event_status='M' THEN 'TASKCARD CONTROLLED'
	 WHEN event_effectivity_mapping.event_status='Q' THEN 'Part-Requirem.Contr.'
	 WHEN event_effectivity_mapping.event_status='T' THEN 'Terminated by third party'
	 WHEN event_effectivity_mapping.event_status='F' THEN 'Ex Factory'
	 WHEN event_effectivity_mapping.event_status='J' THEN 'Rejected by Operator'
	 WHEN event_effectivity_mapping.event_status='W' THEN 'See prev. Docstatus'
	 WHEN event_effectivity_mapping.event_status='U' THEN 'Cancelled'
	 WHEN event_effectivity_mapping.event_status='P' THEN 'Partly Performed'
	 WHEN event_effectivity_mapping.event_status='G' THEN 'Term.Action open'
	 WHEN event_effectivity_mapping.event_status='I' THEN 'Information Only'
	 WHEN event_effectivity_mapping.event_status='L' THEN 'Logbook Controlled'
	 WHEN event_effectivity_mapping.event_status='V' THEN 'Performed by prev. Operator'
	 WHEN event_effectivity_mapping.event_status='Y' THEN 'Reopened'
	 WHEN event_effectivity_mapping.event_status='!' THEN 'UNKNOWN'
	 WHEN event_effectivity_mapping.event_status='-' THEN 'Not Assigned'
	 WHEN event_effectivity_mapping.event_status=' ' THEN 'UNKNOWN'
	 WHEN event_effectivity_mapping.event_status='N' AND doc_rpl.docno_rpl IS NOT NULL THEN 'Superseded (Not Applicable)'
	 WHEN event_effectivity_mapping.event_status='N' AND doc_rpl.docno_rpl IS NULL THEN 'Not Applicable'
	 WHEN event_effectivity_mapping.event_status='Z' THEN 'Superseded'
	 ELSE ''
END as status,
CASE WHEN event_effectivity_mapping.event_status='Z' OR event_effectivity_mapping.event_status='N' AND doc_rpl.docno_rpl IS NOT NULL THEN doc_rpl.docno_rpl||' '||'rev.'||doc_rpl.revision ELSE '' END as superseded_by,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (doc_header.effective_date+729), 'DD.MM.YYYY') as effdate,
CASE WHEN (
			event_effectivity_mapping.event_status='N'
			AND
			(wo_event_link.pending_status IS NULL
			OR
			wo_event_link.pending_status&lt;0)	
		  ) 
		  AND event_open.status_remarks IS NOT NULL
		  AND event_open.status_remarks NOT LIKE ' '
	 THEN TO_CHAR(event_open.status_remarks) 
	 WHEN event_effectivity_mapping.event_status='N'
		  AND ( 
	 	  		event_effectivity_mapping.last_event_perfno_i=0
	 	  		AND	wo_event_link.pending_status IS NULL
		  		AND	TO_CHAR(wo_event_link.status_remarks) IS NULL
		  		AND	event_effectivity_mapping.event_perfno_i &gt; 0
		  		AND event_open.pending_status=0
		  		AND	event_open.status_remarks LIKE ' '
			  )
	 THEN 'Not applicable by Serial Number'
	 WHEN event_effectivity_mapping.event_status='N'
		  AND event_effectivity_mapping.last_event_perfno_i=0
		  AND event_effectivity_mapping.event_perfno_i=0
	 THEN 'Not applicable'
	 WHEN event_effectivity_mapping.event_status='O'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks LIKE ' '
		  AND interval_group_doc.group_name IS NULL
	 THEN 'Open / Next Due: / WO:'
	 WHEN event_effectivity_mapping.event_status='O'
	  	  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND (event_open.status_remarks LIKE (' ') OR event_open.status_remarks IS NULL)
		  AND interval_group_doc.group_name='Unlimited'
	 THEN 'Open / Next Due: No limit'  	
	 WHEN event_effectivity_mapping.event_status='Z'
		  AND event_open.status_remarks NOT LIKE ' '
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NOT NULL
	 THEN TO_CHAR(event_open.status_remarks)
	 WHEN event_effectivity_mapping.event_status='!'
		  AND(
			  (
			   event_effectivity_mapping.event_perfno_i&gt;0
		  	   OR
	           event_effectivity_mapping.event_perfno_i&gt;0
			  )
		      OR
			  (
			   event_effectivity_mapping.event_perfno_i=0
		  	   AND
	           event_effectivity_mapping.event_perfno_i=0
			  )
			 )
	 THEN '!!!NEED CHECK - SEE CHILD!!!'
	 WHEN event_effectivity_mapping.event_status='-'
		  AND event_effectivity_mapping.event_perfno_i=0
		  AND event_effectivity_mapping.event_perfno_i=0
	 THEN 'Not Assigned' 
	 WHEN event_effectivity_mapping.event_status='Z'
		  AND (
				event_open.status_remarks LIKE ' ' AND event_effectivity_mapping.event_perfno_i&gt;0
		        OR
		 	    event_effectivity_mapping.event_perfno_i=0 AND event_open.status_remarks IS NULL
		        OR
		 	    event_effectivity_mapping.event_perfno_i&gt;0 AND event_open.status_remarks IS NULL
			  )
	 THEN 'Superseded (Superseded)'
	 WHEN event_effectivity_mapping.event_status='M'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NOT NULL
	 THEN TO_CHAR(event_open.status_remarks)
	 WHEN event_effectivity_mapping.event_status='O'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NULL
		  AND interval_group_doc.group_name IS NULL
	 THEN 'Open'
	 WHEN event_effectivity_mapping.event_status='O'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NOT NULL
		  AND event_open.status_remarks NOT LIKE ' '
		  AND interval_group_doc.group_name IS NULL
		  AND ref_doc.ref_docno_i IS NOT NULL
	 THEN 'NEED CHECK - SEE CHILD'
	 WHEN event_effectivity_mapping.event_status='O'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NOT NULL
		  AND event_open.status_remarks NOT LIKE ' '
		  AND interval_group_doc.group_name IS NULL
		  AND ref_doc.ref_docno_i IS NULL
	 THEN TO_CHAR(event_open.status_remarks)
	 WHEN event_effectivity_mapping.event_status='J'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NOT NULL
	 THEN TO_CHAR(event_open.status_remarks)
	 WHEN event_effectivity_mapping.event_status='C'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_effectivity_mapping.last_event_perfno_i&gt;0
		  AND event_open.status_remarks IS NOT NULL
	 THEN 'Closed WO:'||' '|| TO_CHAR(event_open.status_remarks)
	 WHEN event_effectivity_mapping.event_status='R'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_effectivity_mapping.last_event_perfno_i&gt;0
		  AND event_open.status_remarks IS NULL
	 THEN 'Repetitive'
	 WHEN event_effectivity_mapping.event_status='M'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NULL
	 THEN 'Taskcard Controlled'
	 WHEN event_effectivity_mapping.event_status='Q'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NOT NULL
	 THEN TO_CHAR(event_open.status_remarks)	 
	 WHEN event_effectivity_mapping.event_status='C'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_effectivity_mapping.last_event_perfno_i&gt;0
		  AND event_open.status_remarks IS NULL
	 THEN 'Closed WO:'
	 WHEN event_effectivity_mapping.event_status='F'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NOT NULL
	 THEN TO_CHAR(event_open.status_remarks)
	 WHEN event_effectivity_mapping.event_status='U'
		  AND event_effectivity_mapping.event_perfno_i&gt;0
		  AND event_open.status_remarks IS NULL
	 THEN 'Cancelled'
	 ELSE CASE WHEN wo_event_link.status_remarks IS NOT NULL THEN TO_CHAR(wo_event_link.status_remarks)
			   ELSE 'see child'
		  END
	 END as reason,
TO_CHAR(
		CASE WHEN (
					event_effectivity_mapping.event_status='N'
					AND	(
						 wo_event_link.pending_status IS NULL
					     OR
					     wo_event_link.pending_status&lt;0	
						)
				  ) 
				  AND event_open.status_remarks IS NOT NULL
				  AND event_open.status_remarks NOT LIKE ' '
			 THEN '1' 

			 WHEN event_effectivity_mapping.event_status='N'
		  		  AND ( 
	 	  				event_effectivity_mapping.last_event_perfno_i=0
	 	  				AND	wo_event_link.pending_status IS NULL
		  				AND	TO_CHAR(wo_event_link.status_remarks) IS NULL
		  				AND	event_effectivity_mapping.event_perfno_i &gt; 0
		  				AND	event_open.pending_status=0
		  				AND	event_open.status_remarks LIKE ' '
					  )
			 THEN '2'

			 WHEN event_effectivity_mapping.event_status='N'
				  AND event_effectivity_mapping.last_event_perfno_i=0
				  AND event_effectivity_mapping.event_perfno_i=0
			 THEN '8'

			 WHEN event_effectivity_mapping.event_status='O'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks LIKE ' '
				  AND interval_group_doc.group_name IS NULL
			 THEN '6'

			 WHEN event_effectivity_mapping.event_status='O'
			  	  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND (event_open.status_remarks LIKE (' ') OR event_open.status_remarks IS NULL)
				  AND interval_group_doc.group_name='Unlimited'
			 THEN '7'  

			 WHEN event_effectivity_mapping.event_status='Z'
				  AND event_open.status_remarks NOT LIKE ' '
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NOT NULL
			 THEN '8'

			 WHEN event_effectivity_mapping.event_status='!'
				  AND(
					  (
					   event_effectivity_mapping.event_perfno_i&gt;0
				  	   OR
			           event_effectivity_mapping.event_perfno_i&gt;0
					  )
				      OR
					  (
					   event_effectivity_mapping.event_perfno_i=0
				  	   AND
			           event_effectivity_mapping.event_perfno_i=0
					  )
					 )
	 		 THEN '9'

			 WHEN event_effectivity_mapping.event_status='-'
				  AND event_effectivity_mapping.event_perfno_i=0
				  AND event_effectivity_mapping.event_perfno_i=0
			 THEN '10'

			 WHEN event_effectivity_mapping.event_status='Z'
				  AND (
						event_open.status_remarks LIKE ' ' AND event_effectivity_mapping.event_perfno_i&gt;0
				        OR
				 	    event_effectivity_mapping.event_perfno_i=0 AND event_open.status_remarks IS NULL
				        OR
				 	    event_effectivity_mapping.event_perfno_i&gt;0 AND event_open.status_remarks IS NULL
					  )
			 THEN '11'

	 		 WHEN event_effectivity_mapping.event_status='M'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NOT NULL
			 THEN '12'

			 WHEN event_effectivity_mapping.event_status='O'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NULL
				  AND interval_group_doc.group_name IS NULL
	 		 THEN '13'

			 WHEN event_effectivity_mapping.event_status='O'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NOT NULL
				  AND event_open.status_remarks NOT LIKE ' '
				  AND interval_group_doc.group_name IS NULL
				  AND ref_doc.ref_docno_i IS NOT NULL
			 THEN '14'

			 WHEN event_effectivity_mapping.event_status='O'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NOT NULL
				  AND event_open.status_remarks NOT LIKE ' '
				  AND interval_group_doc.group_name IS NULL
				  AND ref_doc.ref_docno_i IS NULL
			 THEN '15'

			 WHEN event_effectivity_mapping.event_status='J'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NOT NULL
			 THEN '16'

			 WHEN event_effectivity_mapping.event_status='C'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_effectivity_mapping.last_event_perfno_i&gt;0
				  AND event_open.status_remarks IS NOT NULL
			 THEN '17'

			 WHEN event_effectivity_mapping.event_status='R'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_effectivity_mapping.last_event_perfno_i&gt;0
				  AND event_open.status_remarks IS NULL
			 THEN '18'

			 WHEN event_effectivity_mapping.event_status='M'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NULL
			 THEN '19'

			 WHEN event_effectivity_mapping.event_status='Q'
				  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NOT NULL
			 THEN '20'

			 WHEN event_effectivity_mapping.event_status='C'
		 		  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_effectivity_mapping.last_event_perfno_i&gt;0
				  AND event_open.status_remarks IS NULL
			 THEN '21'

			 WHEN event_effectivity_mapping.event_status='F'
		  		  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NOT NULL
			 THEN '22'

			 WHEN event_effectivity_mapping.event_status='U'
		  		  AND event_effectivity_mapping.event_perfno_i&gt;0
				  AND event_open.status_remarks IS NULL
			 THEN '23'

			 ELSE CASE WHEN wo_event_link.status_remarks IS NOT NULL THEN '3'
					   ELSE 'NEED CHECK'
				  END
			 END
       ) as tech_reason,
TO_CHAR (event_effectivity_mapping.event_status) as event_status,
doc_ac_applic.applicable as ac_applicable,
event_effectivity_mapping.last_event_perfno_i as last_event_perfno_i,
event_effectivity_mapping.event_perfno_i as open_event_perfno_i,
wo_event_link.pending_status as last_pending_status,
event_open.pending_status as open_pending_status,
TO_CHAR (wo_event_link.status_remarks) as last_status_remarks,
TO_CHAR (event_open.status_remarks) as open_status_remarks,
CASE WHEN rotables_aff.partno IS NOT NULL OR rotables_aff.serialno IS NOT NULL THEN rotables_aff.partno||' / '||rotables_aff.serialno ELSE '' END as part,
wo_header.workorderno_display as wono,
wo_header_new.workorderno_display as wono_new,
wp_header.wpno as wpno,
wp_header_new.wpno as wpno_new,
wp_sequence.seqno_i as seqno,
wp_sequence_new.seqno_i as seqno_new,
CASE WHEN last_dim_d.due_at IS NOT NULL THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (aircraft.mfg_date+729+last_dim_d.due_at/60/24), 'DD.MM.YYYY') ELSE '' END as perf_dim1,
CASE WHEN last_dim_h.due_at IS NOT NULL THEN FLOOR (TO_NUMBER(last_dim_h.due_at)/60)||':'||MOD (TO_NUMBER(last_dim_h.due_at), 60)||'/'||'H' ELSE '' END as perf_dim2,
CASE WHEN last_dim_c.due_at IS NOT NULL THEN TO_NUMBER(last_dim_c.due_at)||'/'||'C' ELSE '' END as perf_dim3,
CASE WHEN due_dim_d.due_at IS NOT NULL AND interval_group_doc.group_name='Unlimited' THEN 'No limit'
	 WHEN due_dim_d.due_at IS NOT NULL AND interval_group_doc.group_name IS NULL THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (aircraft.mfg_date+729+due_dim_d.due_at/60/24), 'DD.MM.YYYY')
     ELSE '' END as due_dim1,
CASE WHEN due_dim_h.due_at IS NOT NULL THEN FLOOR (TO_NUMBER(due_dim_h.due_at)/60)||':'||MOD (TO_NUMBER(due_dim_h.due_at), 60)||'/'||'H' ELSE '' END as due_dim2,
CASE WHEN due_dim_c.due_at IS NOT NULL THEN TO_NUMBER(due_dim_c.due_at)||'/'||'C' ELSE '' END as due_dim3,
int_threshold.threshold as threshold,
int_interval.interval as interval,
doc_header.text||' '||doc_header.text2 as description,
interval_group_doc.group_name as group_name,
doc_special_text.special_text_open as special_text_open,
doc_special_text.special_text_closed as special_text_closed,
doc_special_text.special_text_unknown as special_text_unknown

FROM (
	   SELECT
       fix_signoff.ref_docno_i as docno_i,
       fix_signoff.fix_docno_i as parent_docno_i,
       all_applic_doc.docno as docno,
       all_applic_doc.rev as rev,
       all_applic_doc.ac_registr_map as ac_registr_map,
       all_applic_doc.event_type_part as event_type_part,
       all_applic_doc.ac_registr_part as ac_registr_part,
       all_applic_doc.ac_typ_doc as ac_typ_doc,
	   MAX(fix_signoff.fix_docno_i) OVER (PARTITION BY fix_signoff.ref_docno_i) as max_parent_docno_i
	   FROM (
        	  SELECT
			  DISTINCT (doc_header.docno_i) as docno_i,
			  doc_header.docno as docno,
              doc_header.revision as rev,
			  event_effectivity_mapping.ac_registr as ac_registr_map,
			  '' as event_type_part,
			  '' as ac_registr_part,
			  '' as ac_typ_doc
			  FROM
			  doc_header
			  LEFT JOIN event_effectivity_mapping ON doc_header.docno_i=event_effectivity_mapping.event_key_parent
			  WHERE
			  event_effectivity_mapping.ac_registr='@VAR.ac_registr@'
              AND
              doc_header.release_state NOT IN ('U','I','P')
            ) all_applic_doc
      LEFT JOIN (
                  SELECT
                  doc_signoff_tree.docno_i as docno_i,
                  doc_signoff_tree.ref_docno_i as ref_docno_i,
                  TO_NUMBER(CASE WHEN doc_signoff_tree.docno_i=doc_signoff_tree.ref_docno_i THEN '' ELSE TO_CHAR(doc_signoff_tree.docno_i) END) as fix_docno_i
			      FROM
                  doc_signoff_tree
				  
				  UNION

				  SELECT
				  DISTINCT TO_NUMBER ('') as docno_i,
				  doc_signoff_tree.docno_i as ref_docno_i,
				  fix_sign.ref_docno_i as fix_docno_i
			      FROM
				  doc_signoff_tree
				  LEFT JOIN doc_signoff_tree fix_sign ON doc_signoff_tree.docno_i=fix_sign.ref_docno_i
				  WHERE
				  fix_sign.ref_docno_i IS NULL
                ) fix_signoff ON all_applic_doc.docno_i = fix_signoff.ref_docno_i
	   ORDER BY fix_signoff.ref_docno_i
     ) doc_base
LEFT JOIN doc_header ON doc_base.docno_i=doc_header.docno_i
LEFT JOIN (
			SELECT
		    doc_signoff_tree.docno_i as docno_i,
			TO_NUMBER( CASE WHEN TO_CHAR(doc_signoff_tree.ref_docno_i)=TO_CHAR(doc_signoff_tree.docno_i) THEN '' ELSE TO_CHAR(doc_signoff_tree.ref_docno_i) END) as ref_docno_i,
			CASE WHEN TO_CHAR(doc_signoff_tree.ref_docno_i)=TO_CHAR(doc_signoff_tree.docno_i) THEN '' ELSE doc_header.docno END as ref_docno
		    FROM	
		    doc_signoff_tree
		    LEFT JOIN doc_header ON doc_header.docno_i=doc_signoff_tree.ref_docno_i
		  ) ref_doc ON doc_header.docno_i=ref_doc.docno_i
LEFT JOIN event_effectivity_mapping ON doc_header.docno_i=event_effectivity_mapping.event_key_parent
LEFT JOIN (
			SELECT
			DISTINCT doc_header.docno_i as docno_i,
			applicability.applicable as applicable
			FROM
			doc_header
			LEFT JOIN event_effectivity_link ON doc_header.docno_i=event_effectivity_link.event_key 
			LEFT JOIN applicability ON event_effectivity_link.effectivityno_i=applicability.effectivityno_i
			RIGHT JOIN aircraft ac_applic ON applicability.ref_key=ac_applic.aircraftno_i AND ac_applic.ac_registr='@VAR.ac_registr@'
		  ) doc_ac_applic ON doc_header.docno_i=doc_ac_applic.docno_i

LEFT JOIN wo_event_link ON event_effectivity_mapping.last_event_perfno_i=wo_event_link.event_perfno_i
LEFT JOIN wo_event_link event_open ON event_effectivity_mapping.event_perfno_i=event_open.event_perfno_i
LEFT JOIN (
			SELECT
		    event_effectivity_link.effectivity_linkno_i as effectivity_linkno_i,
			treq_time_requirement.timerequirementno_i as timerequirementno_i
			FROM 
			event_effectivity_link
			LEFT JOIN treq_time_requirement ON event_effectivity_link.effectivity_linkno_i=treq_time_requirement.event_key 
			WHERE
 			event_effectivity_link.event_type='DO'
			AND
			treq_time_requirement.event_type = 'EFL'
			AND
			treq_time_requirement.status='0'
		  ) ev_ef_link ON event_effectivity_mapping.effectivity_linkno_i=ev_ef_link.effectivity_linkno_i
LEFT JOIN (
			SELECT
			treq_interval_group.timerequirementno_i as timerequirementno_i,
			CASE WHEN treq_interval_group.group_name='Unlimited' OR treq_interval_group.group_name='UNLIMITED' THEN 'Unlimited' ELSE '' END as group_name
			FROM
			treq_interval_group
			WHERE
			treq_interval_group.group_name='Unlimited'
			OR
			treq_interval_group.group_name='UNLIMITED'
		  ) interval_group_doc ON ev_ef_link.timerequirementno_i=interval_group_doc.timerequirementno_i
LEFT JOIN wo_header ON event_effectivity_mapping.last_event_perfno_i=wo_header.event_perfno_i
LEFT JOIN wo_header wo_header_new ON event_effectivity_mapping.event_perfno_i=wo_header_new.event_perfno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i=wp_assignment.event_perfno_i
LEFT JOIN wp_assignment wp_assignment_new ON wo_header_new.event_perfno_i=wp_assignment_new.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i=wp_header.wpno_i
LEFT JOIN wp_header wp_header_new ON wp_assignment_new.wpno_i=wp_header_new.wpno_i
LEFT JOIN wp_sequence ON wp_sequence.event_perfno_i = wo_header.event_perfno_i and wp_sequence.wpno_i = wp_header.wpno_i
LEFT JOIN wp_sequence wp_sequence_new ON wp_sequence_new.event_perfno_i = wo_header_new.event_perfno_i and wp_sequence_new.wpno_i = wp_header_new.wpno_i
LEFT JOIN ( SELECT
			doc_replacement.docno_i as docno_i,
			doc_replacement.ref_docno_i as ref_docno_i,
			doc_header.docno as docno_rpl,
			doc_header.revision as revision,
			doc_replacement.replacement_code as rpl_code,
			doc_replacement.text
			FROM
			doc_replacement
			LEFT JOIN doc_header ON doc_replacement.ref_docno_i=doc_header.docno_i
			WHERE doc_replacement.replacement_code='SB'
		  ) doc_rpl ON doc_header.docno_i=doc_rpl.docno_i
LEFT JOIN ( SELECT
			wo_last_tranf_max.event_perfno_i as event_perfno_i,
			wo_last_tranf_max.recno as recno_max,
			wo_last_tranf_max.event_transferno_i as event_transferno_i,
			wo_last_tranf_max.transfer_type as transfer_type,
			wo_last_tranf_max.is_last_transfer as is_last_transfer
			FROM (
                   SELECT 
				   wo_transfer.event_perfno_i as event_perfno_i,
				   wo_transfer.recno as recno,
				   wo_transfer.event_transferno_i as event_transferno_i,
				   wo_transfer.transfer_type as transfer_type,
				   wo_transfer.is_last_transfer as is_last_transfer,
				   MAX(wo_transfer.recno) OVER (PARTITION BY wo_transfer.event_perfno_i) as max_recno
				   FROM wo_transfer
				   WHERE 
				   wo_transfer.is_last_transfer='Y'
				   ORDER BY wo_transfer.recno
				 ) wo_last_tranf_max
			WHERE
			wo_last_tranf_max.max_recno=wo_last_tranf_max.recno
		  )	last_transf ON event_effectivity_mapping.last_event_perfno_i=last_transf.event_perfno_i
LEFT JOIN wo_transfer wo_transfer_last ON last_transf.event_perfno_i=wo_transfer_last.event_perfno_i AND last_transf.recno_max=wo_transfer_last.recno AND last_transf.event_transferno_i=wo_transfer_last.event_transferno_i
LEFT JOIN (
                   SELECT DISTINCT wo_transfer_dimension.event_transferno_i,
                                                 wo_transfer_dimension.treq_intervalno_i,
                                                 wo_transfer_dimension.due_at,
                                                 wo_transfer_dimension.counterno_i,
                                                 wo_transfer_dimension.wo_transfer_dimensionno_i
                   FROM wo_transfer_dimension
                   LEFT JOIN counter ON wo_transfer_dimension.counterno_i=counter.counterno_i
                   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                   WHERE counter_definition.counter_defno_i='3' /* dimension - D */
                  ) last_dim_d ON wo_transfer_last.event_transferno_i=last_dim_d.event_transferno_i
LEFT JOIN (
                   SELECT DISTINCT wo_transfer_dimension.event_transferno_i,
                                                 wo_transfer_dimension.treq_intervalno_i,
                                                 wo_transfer_dimension.due_at,
                                                 wo_transfer_dimension.counterno_i,
                                                 wo_transfer_dimension.wo_transfer_dimensionno_i
                   FROM wo_transfer_dimension
                   LEFT JOIN counter ON wo_transfer_dimension.counterno_i=counter.counterno_i
                   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                   WHERE counter_definition.counter_defno_i='1' /* dimension - H */
                  ) last_dim_h ON wo_transfer_last.event_transferno_i=last_dim_h.event_transferno_i
LEFT JOIN (
                   SELECT DISTINCT wo_transfer_dimension.event_transferno_i,
                                                 wo_transfer_dimension.treq_intervalno_i,
                                                 wo_transfer_dimension.due_at,
                                                 wo_transfer_dimension.counterno_i,
                                                 wo_transfer_dimension.wo_transfer_dimensionno_i
                   FROM wo_transfer_dimension
                   LEFT JOIN counter ON wo_transfer_dimension.counterno_i=counter.counterno_i
                   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                   WHERE counter_definition.counter_defno_i='2' /* dimension - C */
                  ) last_dim_c ON wo_transfer_last.event_transferno_i=last_dim_c.event_transferno_i
LEFT JOIN ( SELECT
			wo_due_tranf_max.event_perfno_i as event_perfno_i,
			wo_due_tranf_max.recno as recno_max,
			wo_due_tranf_max.event_transferno_i as event_transferno_i,
			wo_due_tranf_max.transfer_type as transfer_type,
			wo_due_tranf_max.is_last_transfer as is_last_transfer
			FROM
				(
					SELECT 
					wo_transfer.event_perfno_i as event_perfno_i,
					wo_transfer.recno as recno,
					wo_transfer.event_transferno_i as event_transferno_i,
					wo_transfer.transfer_type as transfer_type,
					wo_transfer.is_last_transfer as is_last_transfer,
					MAX(wo_transfer.recno) OVER (PARTITION BY wo_transfer.event_perfno_i) as max_recno
					FROM wo_transfer
					WHERE 
					wo_transfer.is_last_transfer='Y'
					ORDER BY wo_transfer.recno
				 ) wo_due_tranf_max
			WHERE
			wo_due_tranf_max.max_recno=wo_due_tranf_max.recno
		  )	due_transf ON event_effectivity_mapping.event_perfno_i=due_transf.event_perfno_i
LEFT JOIN wo_transfer wo_transfer_due ON due_transf.event_perfno_i=wo_transfer_due.event_perfno_i AND due_transf.recno_max=wo_transfer_due.recno AND due_transf.event_transferno_i=wo_transfer_due.event_transferno_i
LEFT JOIN (
                   SELECT DISTINCT wo_transfer_dimension.event_transferno_i,
                                                 wo_transfer_dimension.treq_intervalno_i,
                                                 wo_transfer_dimension.due_at,
                                                 wo_transfer_dimension.counterno_i,
                                                 wo_transfer_dimension.wo_transfer_dimensionno_i
                   FROM wo_transfer_dimension
                   LEFT JOIN counter ON wo_transfer_dimension.counterno_i=counter.counterno_i
                   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                   WHERE counter_definition.counter_defno_i='3' /* dimension - D */
                  ) due_dim_d ON wo_transfer_due.event_transferno_i=due_dim_d.event_transferno_i
LEFT JOIN (
                   SELECT DISTINCT wo_transfer_dimension.event_transferno_i,
                                                 wo_transfer_dimension.treq_intervalno_i,
                                                 wo_transfer_dimension.due_at,
                                                 wo_transfer_dimension.counterno_i,
                                                 wo_transfer_dimension.wo_transfer_dimensionno_i
                   FROM wo_transfer_dimension
                   LEFT JOIN counter ON wo_transfer_dimension.counterno_i=counter.counterno_i
                   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                   WHERE counter_definition.counter_defno_i='1' /* dimension - H */
                  ) due_dim_h ON wo_transfer_due.event_transferno_i=due_dim_h.event_transferno_i
LEFT JOIN (
                   SELECT DISTINCT wo_transfer_dimension.event_transferno_i,
                                                 wo_transfer_dimension.treq_intervalno_i,
                                                 wo_transfer_dimension.due_at,
                                                 wo_transfer_dimension.counterno_i,
                                                 wo_transfer_dimension.wo_transfer_dimensionno_i
                   FROM wo_transfer_dimension
                   LEFT JOIN counter ON wo_transfer_dimension.counterno_i=counter.counterno_i
                   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                   WHERE counter_definition.counter_defno_i='2' /* dimension - C */
                  ) due_dim_c ON wo_transfer_due.event_transferno_i=due_dim_c.event_transferno_i
LEFT JOIN aircraft ON aircraft.ac_registr=event_effectivity_mapping.ac_registr
LEFT JOIN( SELECT	treq_interval.interval_groupno_i as interval_groupno_i,
					LISTAGG (	CASE WHEN treq_interval.dimension_type='W' THEN 'Threshold: '
									 WHEN treq_interval.dimension_type='B' THEN 'Before: '
									 ELSE '' END
								||	CASE WHEN treq_interval.amount_interval='-1' THEN treq_interval.due_at ELSE treq_interval.amount_interval END
								||	'/'
								||  CASE
									WHEN (treq_interval.unit IS NULL) OR (treq_interval.unit='D') THEN counter_definition.code
									ELSE treq_interval.unit
									END, CHR(10)
                            )
					WITHIN GROUP (ORDER BY treq_interval.amount_interval) as threshold
			    FROM
					treq_interval
					LEFT JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
				WHERE
					treq_interval.dimension_type IN ('W', 'B')
				GROUP BY
					treq_interval.interval_groupno_i
			 ) int_threshold ON wo_transfer_due.treq_interval_groupno_i=int_threshold.interval_groupno_i
LEFT JOIN( SELECT
					treq_interval.interval_groupno_i as interval_groupno_i,
					LISTAGG (	'Interval: '
								||treq_interval.amount_interval
								||'/'
								||  CASE
									WHEN (treq_interval.unit IS NULL) OR (treq_interval.unit='D') THEN counter_definition.code
									ELSE treq_interval.unit
									END, CHR(10)
							) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as interval
				FROM
					treq_interval
					LEFT JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
				WHERE
					treq_interval.dimension_type='I'
				GROUP BY
					treq_interval.interval_groupno_i
			 ) int_interval ON wo_transfer_due.treq_interval_groupno_i=int_interval.interval_groupno_i
LEFT JOIN (
            SELECT 
            rotables.psn,
            rotables.partno,
            rotables.serialno,
            rotables.ac_registr
            FROM
            rotables
            WHERE
            rotables.ac_registr='@VAR.ac_registr@'
           ) rotables_aff ON event_effectivity_mapping.psn=rotables_aff.psn																						 

LEFT JOIN (	SELECT
			doc_eff_special_text.effectivity_linkno_i as effectivity_linkno_i,
			doc_eff_special_text.special_text_open as special_text_open,
      		doc_eff_special_text.special_text_closed as special_text_closed,
       		doc_eff_special_text.special_text_unknown as special_text_unknown
			FROM doc_eff_special_text 
		  ) doc_special_text ON event_effectivity_mapping.effectivity_linkno_i=doc_special_text.effectivity_linkno_i

WHERE
(
	(REGEXP_LIKE(event_effectivity_mapping.event_status, REPLACE('all', 'all', 'W|V|R|U|P|I|M|Q|Y| |C|-|J|T|!|N|O|Z|2|F|G|L')))
	 OR
	(REGEXP_LIKE(event_effectivity_mapping.event_status, REPLACE ('all', 'unk', '!| ')))
)
AND
doc_header.release_state NOT IN ('U','I','P')
AND 
doc_base.ac_registr_map='@VAR.ac_registr@'
AND (
	  doc_header.ac_or_comp_doc='A'
	  OR
	  doc_header.ac_or_comp_doc='C'
	  AND
	  rotables_aff.ac_registr='@VAR.ac_registr@'
    )
AND
event_effectivity_mapping.ac_registr='@VAR.ac_registr@'
AND
(doc_base.max_parent_docno_i=doc_base.parent_docno_i OR doc_base.max_parent_docno_i IS NULL)
AND
(REGEXP_LIKE(doc_header.doc_type, REPLACE('@VAR.doc_type@', ', ', '|')) OR '@VAR.doc_type@' IS NULL)

UNION

SELECT
DISTINCT (doc_base.docno_i) as docno_i,
'' as rotables_ac_registr,
doc_base.docno as docno,
doc_base.rev as rev,
TO_NUMBER ('') as ref_docno_i,
TO_CHAR ('') as ref_docno,
doc_base.parent_docno_i as parent_docno_i,
'' as ac_registr_map,
'DO' as event_type_part,
'@VAR.ac_registr@' as ac_registr_part,
'' as ac_typ_doc,
doc_header.doc_type as doc_type,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (doc_header.issue_date+729), 'DD.MM.YYYY') as issue_date,
doc_header.ac_or_comp_doc as ac_or_comp_doc,
'Not Applcable' as status,
'' as superseded_by,
'' as effdate,
TO_CHAR('Not Applicable by Serial Number') as reason,
TO_CHAR ('4') as tech_reason,
TO_CHAR ('') as event_status,
TO_CHAR ('') as ac_applicable,
TO_NUMBER ('') as last_event_perfno_i,
TO_NUMBER ('') as open_event_perfno_i,
TO_NUMBER ('') as last_pending_status,
TO_NUMBER ('') as open_pending_status,
TO_CHAR ('') as last_status_remarks,
TO_CHAR ('') as open_status_remarks,
TO_CHAR ('') as part,
TO_NUMBER('') as wono,
TO_NUMBER('') as wono_new,
'' as wpno,
'' as wpno_new,
TO_NUMBER('') as seqno,
TO_NUMBER('') as seqno_new,
'' as perf_dim1,
'' as perf_dim2,
'' as perf_dim3,
'' as due_dim1,
'' as due_dim2,
'' as due_dim3,
'' as threshold,
'' as interval,
doc_header.text||' '||doc_header.text2 as description,
TO_CHAR ('') as group_name,
TO_CHAR ('') as special_text_open,
TO_CHAR ('') as special_text_closed,
TO_CHAR ('') as special_text_unknown

FROM (
	   SELECT
       fix_signoff.ref_docno_i as docno_i,
       fix_signoff.fix_docno_i as parent_docno_i,
       all_applic_doc.docno as docno,
       all_applic_doc.rev as rev,
       all_applic_doc.ac_registr_map as ac_registr_map,
       all_applic_doc.event_type_part as event_type_part,
       all_applic_doc.ac_registr_part as ac_registr_part,
       all_applic_doc.ac_typ_doc as ac_typ_doc,
	   MAX(fix_signoff.fix_docno_i) OVER (PARTITION BY fix_signoff.ref_docno_i) as max_parent_docno_i

	   FROM (
			  SELECT
			  DISTINCT (doc_header.docno_i) as docno_i,
			  doc_header.docno as docno,
              doc_header.revision as rev,
			  '' as ac_registr_map,
			  event_effectivity_link.event_type as event_type_part,
			  actype_part.ac_registr as ac_registr_part,
			  '' as ac_typ_doc
			  FROM
			  doc_header
			  LEFT JOIN event_effectivity_link ON event_effectivity_link.event_key=doc_header.docno_i
			  LEFT JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
			  LEFT JOIN event_effectivity_parts ON event_effectivity.effectivityno_i = event_effectivity_parts.effectivityno_i
			  LEFT JOIN part_ac_type ON event_effectivity_parts.partno=part_ac_type.partno
			  LEFT JOIN aircraft actype_part ON part_ac_type.ac_typ=actype_part.ac_typ
			  WHERE
			  event_effectivity_link.event_type='DO'
			  AND
			  actype_part.ac_registr='@VAR.ac_registr@'
			  AND
			  doc_header.docno_i NOT IN(  SELECT
										  doc_header.docno_i
										  FROM
										  doc_header
										  LEFT JOIN event_effectivity_mapping ON doc_header.docno_i=event_effectivity_mapping.event_key_parent
										  WHERE
										  event_effectivity_mapping.ac_registr='@VAR.ac_registr@'
						 			   )
              AND
              doc_header.release_state NOT IN ('U','I','P')
            ) all_applic_doc
              
	   LEFT JOIN (
                  SELECT
                  doc_signoff_tree.docno_i as docno_i,
                  doc_signoff_tree.ref_docno_i as ref_docno_i,
                  TO_NUMBER(CASE WHEN doc_signoff_tree.docno_i=doc_signoff_tree.ref_docno_i THEN '' ELSE TO_CHAR(doc_signoff_tree.docno_i) END) as fix_docno_i
			      FROM
                  doc_signoff_tree
				  
				  UNION

				  SELECT
				  DISTINCT TO_NUMBER ('') as docno_i,
				  doc_signoff_tree.docno_i as ref_docno_i,
				  fix_sign.ref_docno_i as fix_docno_i
			      FROM
				  doc_signoff_tree
				  LEFT JOIN doc_signoff_tree fix_sign ON doc_signoff_tree.docno_i=fix_sign.ref_docno_i
				  WHERE
				  fix_sign.ref_docno_i IS NULL
                ) fix_signoff ON all_applic_doc.docno_i = fix_signoff.ref_docno_i
	   ORDER BY fix_signoff.ref_docno_i
     ) doc_base
LEFT JOIN doc_header ON doc_base.docno_i=doc_header.docno_i
WHERE
doc_header.release_state NOT IN ('U','I','P')
AND 
    (
      doc_base.event_type_part='DO'
      OR
      doc_base.ac_registr_part='@VAR.ac_registr@'
    )
AND
(doc_base.max_parent_docno_i=doc_base.parent_docno_i OR doc_base.max_parent_docno_i IS NULL)
AND
(REGEXP_LIKE(doc_header.doc_type, REPLACE('@VAR.doc_type@', ', ', '|')) OR '@VAR.doc_type@' IS NULL)

UNION

SELECT
DISTINCT (doc_base.docno_i) as docno_i,
'' as rotables_ac_registr,
doc_base.docno as docno,
doc_base.rev as rev,
TO_NUMBER ('') as ref_docno_i,
TO_CHAR ('') as ref_docno,
doc_base.parent_docno_i as parent_docno_i,
'' as ac_registr_map,
'' as event_type_part,
'' as ac_registr_part,
'A23S' as ac_typ_doc,
doc_header.doc_type as doc_type,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (doc_header.issue_date+729), 'DD.MM.YYYY') as issue_date,
doc_header.ac_or_comp_doc as ac_or_comp_doc,
'Not Applcable' as status,
'' as superseded_by,
'' as effdate,
TO_CHAR('Not Applicable by Serial Number') as reason,
TO_CHAR ('5') as tech_reason,
TO_CHAR ('') as event_status,
TO_CHAR ('') as ac_applicable,
TO_NUMBER ('') as last_event_perfno_i,
TO_NUMBER ('') as open_event_perfno_i,
TO_NUMBER ('') as last_pending_status,
TO_NUMBER ('') as open_pending_status,
TO_CHAR ('') as last_status_remarks,
TO_CHAR ('') as open_status_remarks,
TO_CHAR ('') as part,
TO_NUMBER('') as wono,
TO_NUMBER('') as wono_new,
'' as wpno,
'' as wpno_new,
TO_NUMBER('') as seqno,
TO_NUMBER('') as seqno_new,
'' as perf_dim1,
'' as perf_dim2,
'' as perf_dim3,
'' as due_dim1,
'' as due_dim2,
'' as due_dim3,
'' as threshold,
'' as interval,
doc_header.text||' '||doc_header.text2 as description,
TO_CHAR ('') as group_name,
TO_CHAR ('') as special_text_open,
TO_CHAR ('') as special_text_closed,
TO_CHAR ('') as special_text_unknown

FROM (
	   SELECT
       fix_signoff.ref_docno_i as docno_i,
       fix_signoff.fix_docno_i as parent_docno_i,
       all_applic_doc.docno as docno,
       all_applic_doc.rev as rev,
       all_applic_doc.ac_registr_map as ac_registr_map,
       all_applic_doc.event_type_part as event_type_part,
       all_applic_doc.ac_registr_part as ac_registr_part,
       all_applic_doc.ac_typ_doc as ac_typ_doc,
	   MAX(fix_signoff.fix_docno_i) OVER (PARTITION BY fix_signoff.ref_docno_i) as max_parent_docno_i

	   FROM (
			  SELECT
			  DISTINCT (doc_header.docno_i) as docno_i,
			  doc_header.docno as docno,
              doc_header.revision as rev,
			  '' as ac_registr_map,
			  '' as event_type_part,
			  '' as ac_registr_part,
			  doc_comp_ac_typ.ac_typ as ac_typ_doc

			  FROM
			  doc_header
			  LEFT JOIN doc_comp_ac_typ ON doc_header.docno_i=doc_comp_ac_typ.docno_i
			  LEFT JOIN aircraft actype_doc ON doc_comp_ac_typ.ac_typ=actype_doc.ac_typ
			  WHERE
			  actype_doc.ac_registr='@VAR.ac_registr@'
			  AND
			  doc_header.docno_i NOT IN(  SELECT
										  doc_header.docno_i
										  FROM
										  doc_header
										  LEFT JOIN event_effectivity_mapping ON doc_header.docno_i=event_effectivity_mapping.event_key_parent
										  WHERE
										  event_effectivity_mapping.ac_registr='@VAR.ac_registr@'
						 			   )
			  AND
			  doc_header.docno_i NOT IN(  SELECT
										  doc_header.docno_i
										  FROM
										  doc_header
										  LEFT JOIN event_effectivity_link ON event_effectivity_link.event_key=doc_header.docno_i
										  LEFT JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
										  LEFT JOIN event_effectivity_parts ON event_effectivity.effectivityno_i = event_effectivity_parts.effectivityno_i
										  LEFT JOIN part_ac_type ON event_effectivity_parts.partno=part_ac_type.partno
										  LEFT JOIN aircraft actype_part ON part_ac_type.ac_typ=actype_part.ac_typ
										  WHERE
										  event_effectivity_link.event_type='DO'
										  AND
										  actype_part.ac_registr='@VAR.ac_registr@'
						 			   )
              AND
              doc_header.release_state NOT IN ('U','I','P')
            ) all_applic_doc
	   LEFT JOIN (
                  SELECT
                  doc_signoff_tree.docno_i as docno_i,
                  doc_signoff_tree.ref_docno_i as ref_docno_i,
                  TO_NUMBER(CASE WHEN doc_signoff_tree.docno_i=doc_signoff_tree.ref_docno_i THEN '' ELSE TO_CHAR(doc_signoff_tree.docno_i) END) as fix_docno_i
			      FROM
                  doc_signoff_tree
				  
				  UNION

				  SELECT
				  DISTINCT TO_NUMBER ('') as docno_i,
				  doc_signoff_tree.docno_i as ref_docno_i,
				  fix_sign.ref_docno_i as fix_docno_i
			      FROM
				  doc_signoff_tree
				  LEFT JOIN doc_signoff_tree fix_sign ON doc_signoff_tree.docno_i=fix_sign.ref_docno_i
				  WHERE
				  fix_sign.ref_docno_i IS NULL
                ) fix_signoff ON all_applic_doc.docno_i = fix_signoff.ref_docno_i
	   ORDER BY fix_signoff.ref_docno_i
     ) doc_base
LEFT JOIN doc_header ON doc_base.docno_i=doc_header.docno_i
WHERE
doc_header.release_state NOT IN ('U','I','P')
AND 
doc_base.ac_typ_doc='@AC.ac_typ@'
AND
(doc_base.max_parent_docno_i=doc_base.parent_docno_i OR doc_base.max_parent_docno_i IS NULL)
AND
(REGEXP_LIKE(doc_header.doc_type, REPLACE('@VAR.doc_type@', ', ', '|')) OR '@VAR.doc_type@' IS NULL)
)doc_cor

START WITH doc_cor.parent_docno_i IS NULL
CONNECT BY PRIOR doc_cor.docno_i=doc_cor.parent_docno_i
ORDER SIBLINGS BY doc_cor.docno</se:textStatement>
