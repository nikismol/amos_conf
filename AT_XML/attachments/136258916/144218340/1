    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="78_Modific_Stat_airframe_header" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>header for airframe window</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ || '-' || ac_subtype ac_type" id="ac_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_registr" id="a.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="trunc(serialno) msn" id="msn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="trunc(max(u.tah)/60) || ':' ||(max(u.tah) - (trunc(max(u.tah)/60) * 60) ) tsn" id="tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="max(tac) csn" id="csn"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.aircraft@">
          <ds:object>@VAR.aircraft@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select ac_typ || '-' || ac_subtype ac_type
     , a.ac_registr
     , trunc(serialno) msn
     , trunc(max(u.tah)/60) || ':' ||(max(u.tah) - (trunc(max(u.tah)/60) * 60) ) tsn
     , max(tac) csn
  from aircraft a
  join ac_utilization u on a.ac_registr = u.ac_registr
 where /* Aircraft's */
   ('@VAR.aircraft@' is null or
        aircraftno_i in
          (select trim(substr('@VAR.aircraft@' || ',',
                        decode(level,
                             1,
                             0,
                             instr('@VAR.aircraft@' || ',', ',', 1, level - 1) + 2),
                        instr('@VAR.aircraft@' || ',', ',', 1, level) -
                        decode(level,
                             1,
                             1,
                             instr('@VAR.aircraft@' || ',', ',', 1, level - 1) + 2)))
       from dual
     connect by level &lt;= length('@VAR.aircraft@') -
              length(replace('@VAR.aircraft@', ',', '')) + 1))
 group by ac_typ
        , ac_subtype
        , a.ac_registr
        , serialno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="78_Modific_Stat_airframe_table" type="SQL_EDITOR_DATASOURCE" version="2.0">
