        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
rotables.location,
rotables.partno,
rotables.serialno,
rotables.ac_registr,
rotables.owner,
rotables.del_date,
rotables.mfg_date,
rotables.date_inst,
part.description,
position.status,
aircraft.ac_typ
FROM rotables
LEFT JOIN part on rotables.partno = part.partno
LEFT JOIN aircraft on rotables.ac_registr = aircraft.ac_registr
LEFT JOIN position on rotables.locid_pk = position.locid_pk
WHERE 
(
       rotables.location = '2566041-A32S-B' AND '@VAR.COT BABY FLOATING SURVIVAL 2566041-A32S-B@' = 'Y'
       OR rotables.location = '2566042-A32S-C' AND '@VAR.COT BABY FLOATING SURVIVAL 2566042-A32S-C@' = 'Y'
       OR rotables.location = '2566043-A32S-C' AND '@VAR.COT BABY FLOATING SURVIVAL 2566043-A32S-C@' = 'Y'
       OR rotables.location = '2566044-A32S-C' AND '@VAR.COT BABY FLOATING SURVIVAL 2566044-A32S-C@' = 'Y'
       OR rotables.location = '2566045-A32S-C' AND '@VAR.COT BABY FLOATING SURVIVAL 2566045-A32S-C@' = 'Y'
       OR rotables.location = '250009-A32S' AND '@VAR.ELT_EMERGENCY_LOCATOR_TRA_250009-A32S@' = 'Y'
       OR rotables.location = '250041-A32S-A' AND '@VAR.EMERGENCY_LOCATOR_TRANSMITTER_250041-A32S-A@' = 'Y'
       OR rotables.location = '260025-A32S' AND '@VAR.EXTINGUISHER-FIRE HALON 260025-A32S@' = 'Y'
       OR rotables.location = '260026-A32S' AND '@VAR.EXTINGUISHER-FIRE_HALON_260026-A32S@' = 'Y'
       OR rotables.location = '260028-A32S' AND '@VAR.EXTINGUISHER-FIRE_HALON_260028-A32S@' = 'Y'
       OR rotables.location = '260029-A32S' AND '@VAR.EXTINGUISHER-FIRE_HALON_260029-A32S@' = 'Y'
       OR rotables.location = '256401-A32S' AND '@VAR.FIRST AID KIT 256401-A32S@' = 'Y'
       OR rotables.location = '256402-A32S' AND '@VAR.FIRST AID KIT 256402-A32S@' = 'Y'
       OR rotables.location = '350014-A32S-C' AND '@VAR.PBE-PROTECTIVE BREATHING 350014-A32S-C@' = 'Y'
       OR rotables.location = '3500142-A32S' AND '@VAR.PBE-PROTECTIVE BREATHING 3500142-A32S@' = 'Y'
       OR rotables.location = '350016-A32S-A' AND '@VAR.PBE-PROTECTIVE BREATHING 350016-A32S-A@' = 'Y'
       OR rotables.location = '350017-A32S-A' AND '@VAR.PBE-PROTECTIVE BREATHING 350017-A32S-A@' = 'Y'
       OR rotables.location = '350020-A32S-B' AND '@VAR.PORTABLE_OXYGEN_CYLINDER_ASSY_350020-A32S-B@' = 'Y'
       OR rotables.location = '350021-A32S-B' AND '@VAR.PORTABLE_OXYGEN_CYLINDER_ASSY_350021-A32S-B@' = 'Y'
       OR rotables.location = '350021-A32S-E' AND '@VAR.PORTABLE_OXYGEN_CYLINDER_ASSY_350021-A32S-E@' = 'Y'
       OR rotables.location = '350022-A32S-B' AND '@VAR.PORTABLE_OXYGEN_CYLINDER_ASSY_350022-A32S-B@' = 'Y'
       OR rotables.location = '250062-A32S' AND '@VAR.SLIDE ASSY-ESCAPE 250062-A32S@' = 'Y'
       OR rotables.location = '250063-A32S' AND '@VAR.SLIDE ASSY-ESCAPE 250063-A32S@' = 'Y'
       OR rotables.location = '250064-A32S' AND '@VAR.SLIDE ASSY-ESCAPE 250064-A32S@' = 'Y'
       OR rotables.location = '250065-A32S' AND '@VAR.SLIDE ASSY-ESCAPE 250065-A32S@' = 'Y'
       OR rotables.location = '250035-A32S-B' AND '@VAR.SLIDE-ESCAPE AFT 250035-A32S-B@' = 'Y'
       OR rotables.location = '250036-A32S-B' AND '@VAR.SLIDE-ESCAPE AFT 250036-A32S-B@' = 'Y'
       OR rotables.location = '250033-A32S-B' AND '@VAR.SLIDE-ESCAPE FWD 250033-A32S-B@' = 'Y'
       OR rotables.location = '250034-A32S-B' AND '@VAR.SLIDE-ESCAPE FWD 250034-A32S-B@' = 'Y'
      
       OR (REGEXP_LIKE(rotables.location, REPLACE('@VAR.ADD@', ', ', '|')) )
)
AND rotables.ac_registr IS NOT NULL
AND aircraft.status &lt;&gt; 9
Order by rotables.location</se:textStatement>
