    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="248_wo_structure_damage" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ata_chapter" id="wo_header.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.state" id="wo_header.state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="desc_text.ws_text||' ; '||act_text.wa_text AS content" id="content"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tql.queryno_i" id="tql.queryno_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.start_date@">
          <ds:object>@VAR.start_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end_date@">
          <ds:object>@VAR.end_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT   
	  wo_header.ac_registr
                ,aircraft.ac_typ
                ,wo_header.event_perfno_i
                ,wo_header.ata_chapter
                ,wo_header.state
                ,desc_text.ws_text||' ; '||act_text.wa_text AS content
                ,tql.queryno_i
FROM wo_header
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN 	(
				SELECT workstep_link.event_perfno_i as event_perfno_i,
				RTRIM(XMLAGG(XMLELEMENT(E, wo_text_action.text, ';').EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as wa_text
				FROM workstep_link
				LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i = wo_text_action.workstep_linkno_i
				GROUP BY workstep_link.event_perfno_i
			) act_text ON wo_header.event_perfno_i = act_text.event_perfno_i
LEFT JOIN 	(
				SELECT workstep_link.event_perfno_i as event_perfno_i,
				RTRIM(XMLAGG(XMLELEMENT(E, wo_text_description.text, ';').EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as ws_text
				FROM workstep_link
				LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
				GROUP BY workstep_link.event_perfno_i
			) desc_text ON wo_header.event_perfno_i = desc_text.event_perfno_i
left join ( (select tq.queryno_i,
                    tqa.event_perfno_i
            from tech_query tq
            left join tech_query_ac tqa on tq.queryno_i = tqa.queryno_i)
            union
            (select tq.queryno_i,
                    wo.event_perfno_i
            from tech_query tq
            left join wo_header wo on wo.event_perfno_i = tq.queryno_i and tq.ref_type = 'WO')
            ) tql on tql.event_perfno_i = wo_header.event_perfno_i
WHERE
( tql.queryno_i not in (select tq.queryno_i
    from tech_query tq
    where REGEXP_LIKE (tq.headline, '^SDR(*)') or REGEXP_LIKE (tq.headline, '(*)SDR(*)') or REGEXP_LIKE (tq.headline, '(*)SDR$')) or  tql.queryno_i is null)
AND wo_header_more.struc_damage = 'Y'
and (aircraft.ac_typ='@VAR.ac_typ@' or aircraft.ac_model = '@VAR.ac_typ@')
and (wo_header.issue_date &gt;= '@VAR.start_date@' and wo_header.issue_date &lt;= '@VAR.end_date@')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
