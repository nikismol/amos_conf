            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>ALL</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_APU" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT (aircraft.ac_typ) as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.serialno as msn" id="msn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu.tah as tah" id="tah"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu.tac as tac" id="tac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu.ah as ah" id="ah"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu.ac as ac" id="ac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="apu.mfg_date as mfg_date" id="mfg_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;               row_number() over (ORDER BY aircraft.ac_typaircraft.serialno) as num" id="num"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_ac_typ@">
          <ds:object>@VAR.v01_ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT (aircraft.ac_typ) as ac_typ,
               aircraft.serialno as msn,
               aircraft.ac_registr as ac_registr,
               apu.partno as partno,
               apu.serialno as serialno,
               apu.tah as tah,
               apu.tac as tac,
               apu.ah as ah,
               apu.ac as ac,
               apu.mfg_date as mfg_date,
               row_number() over (ORDER BY aircraft.ac_typ, aircraft.serialno) as num
FROM aircraft
LEFT JOIN (
                    SELECT rotables.partno as partno,
                                  rotables.serialno as serialno,
                                  rotables.psn as psn,
                                  rotables.ac_registr as ac_registr,

/* flight hours value for APU */
                                  TO_CHAR(FLOOR (TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value)/60))||':'
                                  ||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value), 60)))&lt;10
                                                 THEN '0'||(TO_CHAR(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value), 60)))
                                                 ELSE (TO_CHAR(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value), 60)))
                                       END 
                                  ||' H' as tah,

/* flight cycles value for APU */
                                  TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on+counter_c.life_value)||' C' as tac,

/* manufacture date for APU */
                                  CASE WHEN rotables.mfg_unknown!='Y' AND rotables.mfg_date IS NOT NULL AND rotables.mfg_date&gt;0
                                            THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (rotables.mfg_date+729), 'DD.MM.YYYY')
                                            WHEN rotables.mfg_unknown='Y'
                                            THEN 'UNKNOWN'
                                            ELSE '---'
                                  END as mfg_date,

/* APU-hours value for APU */
                                  CASE WHEN counter_ah.life_value IS NOT NULL 
                                            THEN TO_CHAR(TRUNC(FLOOR(TO_NUMBER(counter_ah.life_value)/60)))||':'||CASE WHEN (TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_ah.life_value), 60))))&lt;10
                                                                                                                                                                                                         THEN '0'||(TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_ah.life_value), 60))))
                                                                                                                                                                                                         ELSE (TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_ah.life_value), 60))))
                                                                                                                                                                                              END ||' AH'
                                            ELSE ''
                                  END as ah,

/* APU-cycles value for APU */
                                  CASE WHEN counter_ac.life_value IS NOT NULL
                                            THEN TO_CHAR(ROUND(TO_NUMBER(counter_ac.life_value), 2))||' AC'
                                            ELSE ''
                                  END as ac

                    FROM rotables
                    LEFT JOIN part ON rotables.partno=part.partno
                    LEFT JOIN part_special ON part.partno=part_special.partno
                    LEFT JOIN part_req ON part.partseqno_i=part_req.partseqno_i
                    LEFT JOIN (
                                        SELECT DISTINCT (counter.ref_key),
                                                       counter.counterno_i,
                                                       counter.master_counterno_i,
                                                       max_counter_value.on_counter_valueno_i,
                                                       counter_definition.code,
                                                       max_counter_value.life_value,
                                                       NVL(counter_value_on.life_value, 0) as life_value_on
		          FROM counter
                                        LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                        LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                        LEFT JOIN (
                                                            SELECT counter_value.counter_valueno_i as counter_valueno_i,
                                                                           counter_value.counterno_i as counterno_i,
                                                                           counter_value.on_counter_valueno_i,
                                                                           MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
                                                                           counter_value.life_value as life_value,
                                                                           counter_definition.counter_defno_i
                                                            FROM counter_value
                                                            LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
                                                            LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                                            LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                                            WHERE counter_definition.counter_defno_i='1'
                                                            ORDER BY counter_value.counterno_i
			              ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
                                        LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
                                        WHERE counter.ref_type='RO'
                                                       AND counter_definition.counter_defno_i='1'
                                                       AND max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
                                       ) counter_h ON rotables.psn=counter_h.ref_key 
                    LEFT JOIN counter counter_m_h ON counter_h.master_counterno_i=counter_m_h.counterno_i
                    LEFT JOIN (
                                        SELECT max_counter_value.counterno_i as counterno_i,
                                                       max_counter_value.counter_valueno_i as counter_valueno_i,
                                                       max_counter_value.life_value as life_value
                                        FROM (
                                                     SELECT counter_value.counter_valueno_i as counter_valueno_i,
                                                                    counter_value.counterno_i as counterno_i,
                                                                    MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
                                                                    counter_value.life_value as life_value,
                                                                    counter_definition.counter_defno_i
                                                     FROM counter_value
                                                     LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
                                                     LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                                     LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                                     WHERE counter_definition.counter_defno_i='1'
                                                                    AND counter_value.readout_ref_type!='LB'
                                                     ORDER BY counter_value.counterno_i
                                                    ) max_counter_value
                                        WHERE max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
                                       ) counter_value_m_h ON counter_m_h.counterno_i=counter_value_m_h.counterno_i
                    LEFT JOIN (
                                        SELECT DISTINCT (counter.ref_key),
                                                       counter.counterno_i,
                                                       counter.master_counterno_i,
                                                       max_counter_value.on_counter_valueno_i,
                                                       counter_definition.code,
                                                       max_counter_value.life_value,
                                                       NVL(counter_value_on.life_value, 0) as life_value_on
                                                       FROM counter
                                                       LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                                       LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                                       LEFT JOIN (
                                                                           SELECT counter_value.counter_valueno_i as counter_valueno_i,
                                                                                         counter_value.counterno_i as counterno_i,
                                                                                         counter_value.on_counter_valueno_i,
                                                                                         MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
                                                                                         counter_value.life_value as life_value,
                                                                                         counter_definition.counter_defno_i
                                                                           FROM counter_value
                                                                           LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
                                                                           LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                                                           LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                                                           WHERE counter_definition.counter_defno_i='2'
                                                                           ORDER BY counter_value.counterno_i
                                                                          ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
                                                       LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
                                                       WHERE counter.ref_type='RO'
                                                                      AND counter_definition.counter_defno_i='2'
                                                                      AND max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
		         ) counter_c ON rotables.psn=counter_c.ref_key 
                    LEFT JOIN counter counter_m_c ON counter_c.master_counterno_i=counter_m_c.counterno_i
                    LEFT JOIN (
                                        SELECT max_counter_value.counterno_i as counterno_i,
                                                       max_counter_value.counter_valueno_i as counter_valueno_i,
                                                       max_counter_value.life_value as life_value
                                        FROM (
                                                     SELECT counter_value.counter_valueno_i as counter_valueno_i,
                                                                   counter_value.counterno_i as counterno_i,
                                                                   MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
                                                                   counter_value.life_value as life_value,
                                                                   counter_definition.counter_defno_i
                                                     FROM counter_value
                                                     LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
                                                     LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                                     LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                                     WHERE counter_definition.counter_defno_i='2'
                                                                    AND counter_value.readout_ref_type!='LB'
                                                     ORDER BY counter_value.counterno_i
                                                    ) max_counter_value
                                        WHERE max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
                                       ) counter_value_m_c ON counter_m_c.counterno_i=counter_value_m_c.counterno_i

/* APU counter - AH */ 
                    LEFT JOIN (
                                        SELECT DISTINCT (counter.ref_key),
                                                      max_counter_value.life_value,
                                                      counter_value_on.life_value as life_value_on
                                        FROM counter
                                        LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                        LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                        LEFT JOIN (
                                                            SELECT counter_value.counter_valueno_i as counter_valueno_i,
                                                                          counter_value.counterno_i as counterno_i,
                                                                          counter_value.on_counter_valueno_i,
                                                                          MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
                                                                          counter_value.life_value as life_value,
                                                                          counter_definition.counter_defno_i
                                                            FROM counter_value
                                                            LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
                                                            LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                                            LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                                            WHERE 	counter_definition.counter_defno_i='101'
                                                            ORDER BY counter_value.counterno_i
                                                           ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
                                        LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
                                        WHERE counter.ref_type='RO'
                                                       AND counter_definition.counter_defno_i='101'
                                                       AND max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
                                       ) counter_ah ON rotables.psn=counter_ah.ref_key

/* APU counter - AC */ 
                    LEFT JOIN (
                                        SELECT DISTINCT (counter.ref_key),
                                                       max_counter_value.life_value
                                        FROM counter
                                        LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                        LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                        LEFT JOIN (
                                                            SELECT counter_value.counter_valueno_i as counter_valueno_i,
                                                                           counter_value.counterno_i as counterno_i,
                                                                           counter_value.on_counter_valueno_i,
                                                                           MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
                                                                           counter_value.life_value as life_value,
                                                                           counter_definition.counter_defno_i
                                                            FROM counter_value
                                                            LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
                                                            LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                                            LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                                            WHERE 	counter_definition.counter_defno_i='102'
                                                            ORDER BY counter_value.counterno_i
                                                           ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
                                        LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
                                        WHERE counter.ref_type='RO'
                                                       AND counter_definition.counter_defno_i='102'
                                                       AND max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
                                       ) counter_ac ON rotables.psn=counter_ac.ref_key 
                    WHERE part_special.special LIKE 'APU'
                   ) apu ON aircraft.ac_registr=apu.ac_registr
WHERE 1=1
               AND (aircraft.ac_typ IN ('@VAR.v01_ac_typ@') OR '@VAR.v01_ac_typ@'='ALL')
               AND aircraft.status &lt;&gt; 9
               AND aircraft.operator = 'AFL'
GROUP BY aircraft.ac_typ,
                     aircraft.serialno,
                     aircraft.ac_registr,
                     apu.partno,
                     apu.serialno,
                     apu.tah,
                     apu.tac,
                     apu.ah,
                     apu.ac,
                     apu.mfg_date
ORDER BY aircraft.ac_typ,
                    aircraft.serialno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
