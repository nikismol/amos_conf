        <ds:columnDescriptor amosType="ALPHANUM" description=" case when h.docno like '%ITEM%'&#10;             then substr(h.docno instr(h.docno'ITEM-')+5)&#10;        else ' ' end item" id="item"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ref_doc" id="ref_doc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when (&#10;                  select replacement_code&#10;                    from doc_replacement&#10;                   where h.docno_i = doc_replacement.docno_i&#10;                     and replacement_code = 'SB'&#10;                 ) = 'SB' then 'SUP'&#10;           when e.event_status = 'W' then 'See prev. Docstatus'&#10;           when e.event_status = 'R' then 'REP'&#10;           when e.event_status = 'U' then 'Cancelled'&#10;           when e.event_status = 'M' then 'Taskcard Controlled'&#10;           when e.event_status = ' ' then 'N/A'&#10;           when e.event_status = 'J' then 'Rejected by Operator'&#10;           when e.event_status = '!' then 'Unknown'&#10;           when e.event_status = '-' then 'Not Assigned'&#10;           when e.event_status = 'T' then 'Terminated by third party'&#10;           when e.event_status = 'N' then 'N/A'&#10;           when e.event_status = 'O' then 'Open'&#10;           when e.event_status = 'Z' then 'Superseded'&#10;           when e.event_status = 'F' then 'Ex Factory'&#10;           when e.event_status = 'G' then 'Term. Action open'&#10;           when e.event_status = 'C' then 'Closed'&#10;           when (&#10;                 select count(docno_i)&#10;                   from doc_signoff_tree&#10;                  where doc_signoff_tree.docno_i &lt;&gt; doc_signoff_tree.ref_docno_i&#10;                    and doc_signoff_tree.docno_i = h.docno_i&#10;                ) &gt; 0 then 'CPW'&#10;            else e.event_status end status" id="status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" to_char(to_date('31.12.1971' 'dd.mm.yyyy') + effective_date'yyyy') eff_year" id="eff_year"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" to_char(to_date('31.12.1971' 'dd.mm.yyyy') + effective_date'mm') eff_month" id="eff_month"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" to_char(to_date('31.12.1971' 'dd.mm.yyyy') + effective_date'dd') eff_day" id="eff_day"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sup_ref_docno" id="sup_ref_docno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sup_ref_revision" id="sup_ref_revision"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="i.fh int_fh" id="int_fh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="i.fc int_fc" id="int_fc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="i.fd int_fd" id="int_fd"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when g.fd &lt; 1&#10;             then null&#10;        else to_char(to_date('31.12.1971' 'dd.mm.yyyy') + g.fd'yyyy') end last_year" id="last_year"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when g.fd &lt; 1&#10;             then null&#10;        else to_char(to_date('31.12.1971' 'dd.mm.yyyy') + g.fd'mm') end last_month" id="last_month"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when g.fd &lt; 1&#10;             then null&#10;        else to_char(to_date('31.12.1971' 'dd.mm.yyyy') + g.fd'dd') end last_day" id="last_day"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when g.fh &gt; 0 then trunc(g.fh/60 0) || ':'  || trunc(( mod(g.fh/60 1) * (60/100) ) * 1000) &#10;        else null end last_fh" id="last_fh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when g.fc &gt; 0 then trunc(g.fc0)&#10;        else null end last_fc" id="last_fc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="g.event_perfno_i last_wo" id="last_wo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpno" id="wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when z.fd &lt; 1&#10;             then null&#10;        else to_char(to_date('31.12.1971' 'dd.mm.yyyy') + z.fd'yyyy') end due_year" id="due_year"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when z.fd &lt; 1&#10;             then null&#10;        else to_char(to_date('31.12.1971' 'dd.mm.yyyy') + z.fd'mm') end due_month" id="due_month"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when z.fd &lt; 1&#10;             then null&#10;        else to_char(to_date('31.12.1971' 'dd.mm.yyyy') + z.fd'dd') end due_day" id="due_day"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when z.fh &gt; 0 then trunc(z.fh/60 0) || ':'  || trunc(( mod(z.fh/60 1) * (60/100) ) * 1000) &#10;        else null end due_fh" id="due_fh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when z.fc &gt; 0 then trunc(z.fc0)&#10;        else null end due_fc" id="due_fc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="text ||chr(13)||chr(10)|| text2 ad_title" id="ad_title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dr.remarks" id="dr.remarks"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@78_Modific_Stat_airframe_header.a.ac_registr@">
          <ds:object>@78_Modific_Stat_airframe_header.a.ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.doc@">
          <ds:object>@VAR.doc@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ata@">
          <ds:object>@VAR.ata@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ad_status@">
          <ds:object>@VAR.ad_status@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select distinct
       h.docno_i
     , e.ac_registr
     , case when h.docno like '%ITEM%' 
             then substr(h.docno, 0, instr(h.docno,'-ITEM',-1) -1) 
        else h.docno end docno
     , h.revision
     , h.issued_by
     , h.doc_type
     , case when h.docno like '%ITEM%'
             then substr(h.docno, instr(h.docno, 'ITEM-')+5)
        else ' ' end item
     , ref_doc
     , case when (
                  select distinct replacement_code
                    from doc_replacement
                   where h.docno_i = doc_replacement.docno_i
                     and replacement_code = 'SB'
                 ) = 'SB' then 'SUP'
           when e.event_status = 'W' then 'See prev. Docstatus'
           when e.event_status = 'R' then 'REP'
           when e.event_status = 'U' then 'Cancelled'
           when e.event_status = 'M' then 'Taskcard Controlled'
           when e.event_status = ' ' then 'N/A'
           when e.event_status = 'J' then 'Rejected by Operator'
           when e.event_status = '!' then 'Unknown'
           when e.event_status = '-' then 'Not Assigned'
           when e.event_status = 'T' then 'Terminated by third party'
           when e.event_status = 'N' then 'N/A'
           when e.event_status = 'O' then 'Open'
           when e.event_status = 'Z' then 'SUP'
           when e.event_status = 'F' then 'Ex Factory'
           when e.event_status = 'G' then 'Term. Action open'
           when e.event_status = 'C' then 'Closed'
           when (
                 select count(docno_i)
                   from doc_signoff_tree
                  where doc_signoff_tree.docno_i &lt;&gt; doc_signoff_tree.ref_docno_i
                    and doc_signoff_tree.docno_i = h.docno_i
                ) &gt; 0 then 'CPW'
            else e.event_status end status
     , case when effective_date &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + effective_date, 'yyyy') end eff_year
     , case when effective_date &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + effective_date, 'mm') end eff_month
     , case when effective_date &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + effective_date, 'dd') end eff_day
     , sup_ref_docno
     , sup_ref_revision
     , i.fh int_fh
     , i.fc int_fc
     , i.fd int_fd
     , case when g.fd &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + g.fd, 'yyyy') end last_year
     , case when g.fd &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + g.fd, 'mm') end last_month
     , case when g.fd &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + g.fd, 'dd') end last_day
     , case when g.fh &gt; 0 then trunc(g.fh/60, 0) || ':'  || trunc(( mod(g.fh/60, 1) * (60/100) ) * 100, 0) 
        else null end last_fh
     , case when g.fc &gt; 0 then trunc(g.fc, 0)
        else null end last_fc
     , g.event_perfno_i last_wo
     , wpno
     , case when z.fd &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + z.fd, 'yyyy') end due_year
     , case when z.fd &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + z.fd, 'mm') end due_month
     , case when z.fd &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + z.fd, 'dd') end due_day
     , case when z.fh &gt; 0 then trunc(z.fh/60, 0) || ':'  || trunc(( mod(z.fh/60, 1) * (60/100) ) * 100, 0) 
        else null end due_fh
     , case when z.fc &gt; 0 then trunc(z.fc, 0)
        else null end due_fc
     , text ||chr(13)||chr(10)|| text2 ad_title
     , dr.remarks
  from doc_header h
  left join event_effectivity_mapping e on h.docno_i = e.event_key_parent and e.event_type = 'EFL'
/* Reference Doc Search*/
  left join (
              select docno_i
                   , listagg(doc_type  || ' ' || case when docno like '%ITEM%' 
                                                       then substr(docno, 0, instr(docno,'-ITEM',-1) -1)
                                                  else docno end || 
                                                  case when revision &lt;&gt; ' '
                                                        then ' (rev. ' || revision || ')'
                                                  else '' end
                                       || case when docno like '%ITEM%'
                                                then '/ item ' || substr(docno, instr(docno, 'ITEM-')+5)
                                           else ' ' end, ', ' 
                            ) within group (order by docno) ref_doc
                from (
                       select distinct d.docno_i, b.docno, b.revision, b.doc_type
                         from (
                                select level lev
                                     , id docno_i
                                     , pid
                                     , i.docno
                                     , i.revision
                                     , connect_by_isleaf IsLea
                                     , connect_by_root i.docno_i root
                                     , w_off_logic
                                     , doc_type
                                from ( 
                                      /* иерархия документов */
                                      select a.id
                                           , case when a.id = a.pid 
                                                   then null
                                              else a.pid end pid
                                           , h.docno_i
                                           , h.docno
                                           , revision
                                           , w_off_logic
                                           , h.doc_type
                                        from ( 
                                        /* 1. документа-родителя нет в ref_docno_i, при условии что у него есть дочерние документы, иначе docno_i = ref_docno_i */
                                               select distinct 
                                                      t.docno_i id
                                                    , case when (
                                                                  select count(doc_signoff_tree.ref_docno_i) cnt
                                                                    from doc_signoff_tree
                                                                   where t.docno_i = doc_signoff_tree.ref_docno_i
                                                                ) &gt; 0
                                                            then t.docno_i else null end pid
                                                    , docno
                                                from doc_signoff_tree t
                                                join doc_header d on t.docno_i = d.docno_i
                                             union
                                              select ref_docno_i id
                                                   , t.docno_i pid
                                                   , docno
                                                from doc_signoff_tree t
                                                join doc_header d on t.ref_docno_i = d.docno_i
                                            ) a
                                        join doc_header h on a.id = h.docno_i
                                        /* 2. document write-off logic */
                                        left join (
                                                    select case when count(docno_i) &gt; '0' 
                                                                 then 'Y'
                                                            else 'N' end w_off_logic
                                                         , docno_i
                                                      from doc_signoff_tree
                                                     where docno_i = ref_docno_i
                                                     group by docno_i
                                                  ) o on h.docno_i = o.docno_i
                                     ) i
                               /* start with id = -- 15000 (ex. docno_i) */
                                connect by prior i.id = i.pid
                                 order siblings by i.id, revision
                              ) b
                           join doc_header d on b.root = d.docno_i
                          where pid is not null
                            and islea = 1
                     ) b
               group by docno_i
            ) s on h.docno_i = s.docno_i
  left join (
             select docno_i
                  , listagg(docno || item, ', ') within group (order by docno) sup_ref_docno
                  , listagg(revision, ' / ') within group (order by docno) sup_ref_revision
               from
                    (
                      select r.docno_i
                           , case when docno like '%ITEM%'
                                   then substr(docno, 0, instr(docno,'-ITEM',-1) -1) 
                              else docno end docno
                           , revision
                           , case when docno like '%ITEM%'
                                   then ' (' || substr(docno, instr(docno, 'ITEM-')+5) || ')'
                              else null end item
                        from doc_replacement r
                        join doc_header h on r.ref_docno_i = h.docno_i
                    ) s
              group by docno_i
            ) re on h.docno_i = re.docno_i
/* INTERVALS */
 left join (
             select event_key, fh, fc, fd
               from (
                     select el.event_key
                          , ti.counter_defno_i
                          , case when unit &lt;&gt; ' ' and ti.counter_defno_i = 3
                                  then to_char(amount_interval) || ' ' || unit
                             else to_char(amount_interval) end amount_interval
                       from event_effectivity_link el
                       join event_effectivity ee on el.effectivityno_i = ee.effectivityno_i and higher_effectivityno_i is null
                       left join treq_time_requirement ttr on el.effectivity_linkno_i = ttr.event_key
                       left join treq_interval_group tig on ttr.timerequirementno_i = tig.timerequirementno_i
                       left join treq_interval ti on tig.interval_groupno_i = ti.interval_groupno_i
                       left join counter_definition cd on ti.counter_defno_i = cd.counter_defno_i
                      where threshold = 'N'
                        and dimension_type = 'I'
                        and ttr.event_type = 'EFL'
                    ) x
              pivot (max(amount_interval) for counter_defno_i in (1 as fh, 2 as fc, 3 as fd))
            ) i on h.docno_i = i.event_key
/* Last Done */
 left join (
             select row_number() over(partition by event_key_parent order by fd desc) rnk
                  , case when h.type = 'PD' then null
                     else h.event_perfno_i end event_perfno_i
                  , event_key_parent
                  , fh
                  , fc
                  , fd
               from (
                      select event_perfno_i, fh, fc, fd
                        from (
                               select distinct 
                                      h.event_perfno_i
                                    , due_at
                                    , counter_defno_i
                                 from doc_header o
                                 join wo_event_link e on o.docno_i = e.event_key_parent
                                 join wo_header h on e.event_perfno_i = h.event_perfno_i
                                 join (
                                        select event_perfno_i, due_at, counter_defno_i
                                          from wo_transfer wt
                                          join wo_transfer_dimension wd on wt.event_transferno_i = wd.event_transferno_i
                                          join counter u on wd.counterno_i = u.counterno_i
                                          join counter_template ct on u.counter_templateno_i = ct.counter_templateno_i
                                         where wt.is_last_transfer = 'Y'
                                           and wt.transfer_type = 'R'
                                           and ct.counter_defno_i in (1, 2)
                                       union
                                        select event_perfno_i, absolute_due_date due_at, counter_defno_i
                                          from wo_transfer wt
                                          join wo_transfer_dimension wd on wt.event_transferno_i = wd.event_transferno_i
                                          join counter u on wd.counterno_i = u.counterno_i
                                          join counter_template ct on u.counter_templateno_i = ct.counter_templateno_i
                                         where wt.is_last_transfer = 'Y'
                                           and wt.transfer_type = 'R'
                                           and (wt.absolute_due_date is not null and wt.absolute_due_date &lt; '1491308')
                                           and ct.counter_defno_i in (3)
                                      ) wt on h.event_perfno_i = wt.event_perfno_i
                                where o.ac_or_comp_doc = 'A'
                                  and e.event_type = 'DOC_EFF'
                                  and e.pending_status &lt;= 0
                                  and h.ac_registr = '@78_Modific_Stat_airframe_header.a.ac_registr@'
                             ) x
                       pivot (avg(due_at) for counter_defno_i in (1 as fh, 2 as fc, 3 as fd)) d
                    ) s 
               join wo_event_link e on s.event_perfno_i = e.event_perfno_i
               join wo_header h on e.event_perfno_i = h.event_perfno_i
           ) g on h.docno_i = g.event_key_parent and g.rnk = 1
/* Last Done
   PP Item
*/
 left join (
            select docno_i
                 , case when wpno like '%-%' 
                         then substr(wpno, instr(wpno,'-')+5) 
                    else wpno end || ' ' || seq_no wpno
              from (
                     select distinct 
                            rank() over(partition by docno_i, ac_registr order by h.act_end_date desc) rnk
                          , docno_i
                          , wpno
                          , act_end_date
                          , seqno_i seq_no
                       from doc_header o
                       join wo_event_link e on o.docno_i = e.event_key_parent
                       join wp_assignment wa on e.event_perfno_i = wa.event_perfno_i
                       join wp_header h on wa.wpno_i = h.wpno_i
                       left join wp_sequence q on e.event_perfno_i = q.event_perfno_i
                      where o.ac_or_comp_doc = 'A'
                        and e.event_type = 'DOC_EFF'
                        and e.event_status &lt;&gt; 'O'
                        and h.act_end_date &gt; 0
                        and h.ac_registr = '@78_Modific_Stat_airframe_header.a.ac_registr@'
                      order by docno_i
                   ) v
             where rnk = 1
           ) pp on h.docno_i = pp.docno_i
/* Next Due */
 left join (
             select rank() over(partition by event_key_parent order by fd desc) rnk
                  , case when h.type = 'PD' then null
                     else h.event_perfno_i end event_perfno_i
                  , event_key_parent
                  , fh
                  , fc
                  , fd
               from (
                      select event_perfno_i, fh, fc, fd
                        from (
                               select distinct 
                                      h.event_perfno_i
                                    , due_at
                                    , counter_defno_i
                                 from doc_header o
                                 join wo_event_link e on o.docno_i = e.event_key_parent
                                 join wo_header h on e.event_perfno_i = h.event_perfno_i
                                 join (
                                        select event_perfno_i, due_at, counter_defno_i
                                          from wo_transfer wt
                                          join wo_transfer_dimension wd on wt.event_transferno_i = wd.event_transferno_i
                                          join counter u on wd.counterno_i = u.counterno_i
                                          join counter_template ct on u.counter_templateno_i = ct.counter_templateno_i
                                         where ct.counter_defno_i in (1, 2)
                                       union
                                        select event_perfno_i, absolute_due_date due_at, counter_defno_i
                                          from wo_transfer wt
                                          join wo_transfer_dimension wd on wt.event_transferno_i = wd.event_transferno_i
                                          join counter u on wd.counterno_i = u.counterno_i
                                          join counter_template ct on u.counter_templateno_i = ct.counter_templateno_i
                                         where (wt.absolute_due_date is not null and wt.absolute_due_date &lt; '1491308')
                                           and ct.counter_defno_i in (3)
                                      ) wt on h.event_perfno_i = wt.event_perfno_i
                                where o.ac_or_comp_doc = 'A'
                                  and e.event_type = 'DOC_EFF'
                                  and e.pending_status = 0
                                  and h.ac_registr = '@78_Modific_Stat_airframe_header.a.ac_registr@'
                             ) x
                       pivot (avg(due_at) for counter_defno_i in (1 as fh, 2 as fc, 3 as fd)) d
                    ) s 
               join wo_event_link e on s.event_perfno_i = e.event_perfno_i
               join wo_header h on e.event_perfno_i = h.event_perfno_i
           ) z on h.docno_i = z.event_key_parent and z.rnk = 1
 left join (
            select listagg(text, ' ') within group (order by recno) remarks
                 , docno_i
              from doc_remarks
             group by docno_i
           ) dr on h.docno_i = dr.docno_i
 where h.ac_or_comp_doc = 'A'
   and e.ac_registr in ('@78_Modific_Stat_airframe_header.a.ac_registr@')
   and (to_char('@VAR.doc@') is null or h.docno_i = '@VAR.doc@')
 /* ATA-Chapter */
   and ('@VAR.ata@' is null or
      h.ata_chapter in
        (select trim(substr('@VAR.ata@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.ata@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.ata@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.ata@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.ata@') -
              length(replace('@VAR.ata@', ',', '')) + 1)) 
   and '@VAR.ad_status@' = '1'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="78_Modific_Stat_rows_count" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Rows count for page divider</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="cnt_air" id="cnt_air"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@78_Modific_Stat_airframe_header.a.ac_registr@">
          <ds:object>@78_Modific_Stat_airframe_header.a.ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.doc@">
          <ds:object>@VAR.doc@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.airframe@">
          <ds:object>@VAR.airframe@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select cnt_air
  from /* airframe count rows */ 
    (
      select count(docno_i) cnt_air
        from doc_header h 
        left join event_effectivity_mapping e on h.docno_i = e.event_key_parent and e.event_type = 'EFL'
       where h.ac_or_comp_doc = 'A'
         and e.ac_registr in ('@78_Modific_Stat_airframe_header.a.ac_registr@')
         and (to_char('@VAR.doc@') is null or h.docno_i = '%@VAR.doc@%')
         and '@VAR.airframe@' = 'Y'
    ) x</se:textStatement>
