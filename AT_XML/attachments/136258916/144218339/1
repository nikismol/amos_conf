      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select distinct
      a.ac_registr
     , a.docno_i
     , case when a.docno like '%-ITEM%' 
             then substr(a.docno, 0, instr(a.docno,'-ITEM',-1) -1) 
            when a.docno like '% ITEM%' 
             then substr(a.docno, 0, instr(a.docno,' ITEM',-1) -1) 
        else a.docno end docno
     , a.revision
     , a.issued_by
     , a.doc_type
     , case when a.docno like '%ITEM-%'
             then substr(a.docno, instr(a.docno, 'ITEM-')+5)
            when a.docno like '%ITEM %'
             then substr(a.docno, instr(a.docno, 'ITEM ')+5)
        else ' ' end item
     , ref_doc
     , case when title &lt;&gt; ' ' or p.description &lt;&gt; ' '
              then title || ' ' || p.description
            else ''
        end comp_typ
     , a.partno
     , a.serialno
     , case when (
                   select distinct
                          replacement_code
                     from doc_replacement
                    where a.docno_i = doc_replacement.docno_i 
                      and replacement_code = 'SB'
                 ) = 'SB' then 'SUP'
            when n.event_status = 'W' then 'See prev. Docstatus'
            when n.event_status = 'R' then 'REP'
            when n.event_status = 'U' then 'Cancelled'
            when n.event_status = 'M' then 'Taskcard Controlled'
            when n.event_status = ' ' then 'N/A'
            when n.event_status = 'J' then 'Rejected by Operator'
            when n.event_status = '!' then 'Unknown'
            when n.event_status = '-' then 'Not Assigned'
            when n.event_status = 'T' then 'Terminated by third party'
            when n.event_status = 'N' then 'N/A'
            when n.event_status = 'O' then 'Open'
            when n.event_status = 'Z' then 'SUP'
            when n.event_status = 'F' then 'Ex Factory'
            when n.event_status = 'G' then 'Term. Action open'
            when n.event_status = 'C' then 'Closed'
            when (
                   select count(docno_i)
                     from doc_signoff_tree
                    where doc_signoff_tree.docno_i &lt;&gt; doc_signoff_tree.ref_docno_i
                      and doc_signoff_tree.docno_i = a.docno_i
                 ) &gt; 0 then 'CPW'
            else n.event_status end status
    , case when effective_date &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + effective_date, 'yyyy') end eff_year
     , case when effective_date &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + effective_date, 'mm') end eff_month
     , case when effective_date &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + effective_date, 'dd') end eff_day
     , sup_ref_docno
     , sup_ref_revision
     , i.fh int_fh
     , i.fc int_fc
     , i.fd int_fd
     , case when g.fd &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + g.fd, 'yyyy') end last_year
     , case when g.fd &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + g.fd, 'mm') end last_month
     , case when g.fd &lt; 1
             then null
        else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + g.fd, 'dd') end last_day
     , case when g.fh &gt; 0 then trunc(g.fh/60, 0) || ':'  || trunc(( mod(g.fh/60, 1) * (60/100) ) * 100, 0) 
        else null end last_fh
     , case when g.fc &gt; 0 then trunc(g.fc, 0)
        else null end last_fc
     , g.event_perfno_i last_wo
     , wpno
     , hierarchy
     , case when y.event_status = 'C' then null
            when y.event_status &lt;&gt; 'C' and hierarchy = 'N' then y.event_perfno_i 
        else null end next_wo
    , case when hierarchy = 'N' then y.due_h
       else null end due_h
    , case when hierarchy = 'N' then y.due_c
       else null end due_c
    , case when hierarchy = 'N' then y.due_year
       else null end due_year
    , case when hierarchy = 'N' then y.due_month
       else null end due_month
    , case when hierarchy = 'N' then y.due_day
       else null end due_day
    , text ||chr(13)||chr(10)|| text2 ad_title 
    , rem remarks
  from ( 
         select docno_i
              , docno
              , partno
              , serialno
              , psn
              , revision
              , ac_registr
              , doc_type
              , issued_by
              , effective_date
              , text
              , text2
              , ata_chapter
           from (
                 select 'PNCHANGED'
                      , r.psn
                      , partno
                      , r.serialno
                      , ''
                      , r.ac_registr
                      , e.event_key_parent
                   from rotables r
                   join wo_header h on r.psn = h.psn
                   join wo_event_link e on h.event_perfno_i = e.event_perfno_i
                   left join aircraft a on r.ac_registr = a.ac_registr
                  where e.event_key_parent in (
                                               select ref_docno_i
                                                 from doc_signoff_tree
                                                where docno_i = ref_docno_i
                                              )
                    and (a.status &lt;&gt; 9 or a.status is null)
                    and e.event_type = 'DOC_EFF'
                    and e.pending_status = 0
                    and not exists (
                                     select 1
                                       from event_effectivity_mapping map
                                      where map.event_key_parent = e.event_key_parent
                                        and map.event_type = 'EFL'
                                        and map.psn = h.psn
                                   )
                 union
                 select 'ROTNOTINSYSTEM'
                      , h.psn
                      , h.partno
                      , h.serialno
                      , 'Voucher-Mode: ' || vm
                      , h.ac_registr
                      , l.event_key
                   from history h
                   join event_effectivity_parts p on h.partno = p.partno
                   join event_effectivity e on p.effectivityno_i = e.effectivityno_i
                   join event_effectivity_link l on e.effectivityno_i = l.effectivityno_i
                   join (
                          select max(historyno_i) historyno_i
                            from history
                            join wo_header on history.psn = wo_header.psn
                            join wo_event_link on wo_header.event_perfno_i = wo_event_link.event_perfno_i
                            join doc_signoff_tree dt on event_key_parent = ref_docno_i and docno_i = ref_docno_i
                           where wo_header.psn is not null
                             and wo_event_link.event_type = 'DOC_EFF'
                             and pending_status = 0
                             and not exists (
                                             select rotables.psn
                                               from rotables
                                              where rotables.psn = wo_header.psn
                                            )
                           group by history.psn
                        ) z on h.historyno_i = z.historyno_i
                  where l.event_type = 'DO'
                    and vm &lt;&gt; 'AD'
                 union 
                 (
                  select 'PNNOTMODIFIED'
                       , r.psn
                       , partno
                       , r.serialno
                       , ''
                       , r.ac_registr
                       , e.event_key_parent
                    from rotables r
                    left join aircraft a on r.ac_registr = a.ac_registr
                    join wo_header h on r.psn = h.psn
                    join wo_event_link e on h.event_perfno_i = e.event_perfno_i
                   where (a.status &lt;&gt; 9 or a.status is null)
                     and e.event_type = 'DOC_EFF'
                     and e.pending_status = 0
                  union
                  select 'PNNOTMODIFIED'
                       , r.psn
                       , partno
                       , r.serialno
                       , ''
                       , r.ac_registr
                       , m.event_key_parent
                    from rotables r
                    left join aircraft a on r.ac_registr = a.ac_registr
                    join event_effectivity_mapping m on r.psn = m.psn
                   where (a.status &lt;&gt; 9 or a.status is null)
                     and event_type = 'EFL'
                 )
                )x
           join doc_header d on event_key_parent = docno_i
          where ac_or_comp_doc = 'C'
          group by psn
              , partno
              , serialno
              , ac_registr
              , docno_i
              , docno
              , revision
              , doc_type
              , issued_by
              , effective_date
              , text
              , text2
              , ata_chapter
       ) a
/* FOR TITLE ONLY */
  left join (
              select distinct
                     event_key_parent
                   , l.effectivityno_i
                   , title
                   , psn
                from wo_event_link k
                join wo_header h on k.event_perfno_i = h.event_perfno_i
                left join event_effectivity_link l on k.event_key = l.effectivity_linkno_i
                left join event_effectivity f on l.effectivityno_i = f.effectivityno_i
            ) k on a.docno_i = k.event_key_parent and a.psn = k.psn
/* FOR TITLE ONLY */
  join part p on a.partno = p.partno
  left join aircraft air on a.ac_registr = air.ac_registr
/* Reference Doc Search*/
  left join (
              select docno_i
                   , listagg(doc_type  || ' ' || case when docno like '%ITEM%' 
                                                       then substr(docno, 0, instr(docno,'-ITEM',-1) -1)
                                                  else docno end || 
                                                  case when revision &lt;&gt; ' '
                                                        then ' (rev. ' || revision || ')'
                                                  else '' end
                                       || case when docno like '%ITEM%'
                                                then '/ item ' || substr(docno, instr(docno, 'ITEM-')+5)
                                           else '' end, ', ' 
                            ) within group (order by docno) ref_doc
                from (
                       select distinct d.docno_i, b.docno, b.revision, b.doc_type
                         from (
                                select level lev
                                     , id docno_i
                                     , pid
                                     , i.docno
                                     , i.revision
                                     , connect_by_isleaf IsLea
                                     , connect_by_root i.docno_i root
                                     , w_off_logic
                                     , doc_type
                                from ( 
                                      /* иерархия документов */
                                      select a.id
                                           , case when a.id = a.pid 
                                                   then null
                                              else a.pid end pid
                                           , h.docno_i
                                           , h.docno
                                           , revision
                                           , w_off_logic
                                           , h.doc_type
                                        from ( 
                                        /* 1. документа-родителя нет в ref_docno_i, при условии что у него есть дочерние документы, иначе docno_i = ref_docno_i */
                                               select distinct 
                                                      t.docno_i id
                                                    , case when (
                                                                  select count(doc_signoff_tree.ref_docno_i) cnt
                                                                    from doc_signoff_tree
                                                                   where t.docno_i = doc_signoff_tree.ref_docno_i
                                                                ) &gt; 0
                                                            then t.docno_i else null end pid
                                                    , docno
                                                from doc_signoff_tree t
                                                join doc_header d on t.docno_i = d.docno_i
                                             union
                                              select ref_docno_i id
                                                   , t.docno_i pid
                                                   , docno
                                                from doc_signoff_tree t
                                                join doc_header d on t.ref_docno_i = d.docno_i
                                            ) a
                                        join doc_header h on a.id = h.docno_i
                                        /* 2. document write-off logic */
                                        left join (
                                                    select case when count(docno_i) &gt; '0' 
                                                                 then 'Y'
                                                            else 'N' end w_off_logic
                                                         , docno_i
                                                      from doc_signoff_tree
                                                     where docno_i = ref_docno_i
                                                     group by docno_i
                                                  ) o on h.docno_i = o.docno_i
                                     ) i
                               /* start with id = -- 15000 (ex. docno_i) */
                               connect by prior i.id = i.pid
                                 order siblings by i.id, revision
                              ) b
                           join doc_header d on b.root = d.docno_i
                          where pid is not null
                            and islea = 1
                     ) b
               group by docno_i
            ) s on a.docno_i = s.docno_i
 /* part's status */
  left join ( select to_number( rank() over(partition by b.docno_i, r.psn order by w_off_logic desc
                   , b.lev
                   , decode(event_status,'O', 1, ' ', 2, 'U', 3, 'Z', 4, 'J', 5, 'M', 6, 'F', 7, 'T', 8, 'C', 9)) ) num 
                   , b.lev
                   , b.docno_i
                   , r.psn
                   , pid
                   , docno
                   , revision
                   , IsLea
                   , root
                   , w_off_logic
                   , event_status
                   , case when (
                                select count(doc_signoff_tree.ref_docno_i)
                                  from doc_signoff_tree
                                 where doc_signoff_tree.docno_i = b.docno_i
                                   and doc_signoff_tree.docno_i &lt;&gt; doc_signoff_tree.ref_docno_i
                               ) &gt; 1 then 'Y'
                          else 'N' end hierarchy
                from ( 
                      select level lev, id docno_i, pid, docno, revision, connect_by_isleaf IsLea, connect_by_root docno_i root, w_off_logic
                        from ( /* иерархия документов */
                              select a.id
                                   , case when a.id = a.pid then null
                                          else a.pid end pid
                                   , h.docno_i
                                   , h.docno
                                   , revision
                                   , w_off_logic
                                from ( /* 1. документа-родителя нет в ref_docno_i, при условии что у него есть дочерние документы, иначе docno_i = ref_docno_i */
                                       select distinct 
                                              t.docno_i id
                                            , case when (
                                                          select count(doc_signoff_tree.ref_docno_i) cnt
                                                            from doc_signoff_tree
                                                           where t.docno_i = doc_signoff_tree.ref_docno_i
                                                        ) &gt; 0
                                                   then t.docno_i else null end pid
                                            , docno
                                         from doc_signoff_tree t
                                         join doc_header d on t.docno_i = d.docno_i
                                       union
                                       select ref_docno_i id
                                            , t.docno_i pid
                                            , docno
                                         from doc_signoff_tree t
                                         join doc_header d on t.ref_docno_i = d.docno_i
                                     ) a
                                join doc_header h on a.id = h.docno_i
                        /* 2. document write-off logic */
                                left join ( 
                                           select case when count(docno_i) &gt; '0' then 'Y'
                                                       else 'N' end w_off_logic
                                                , docno_i
                                             from doc_signoff_tree
                                            where docno_i = ref_docno_i
                                            group by docno_i
                                          ) o on h.docno_i = o.docno_i
                               where ac_or_comp_doc = 'C'
                             ) i
                     connect by prior i.id = i.pid
                       order siblings by i.id, revision 
                     ) b
                left join (
                           select event_status, psn, docno_i
                             from (
                                   select case when event_status = 'N' and event_status_single = 'N'
                                               then ' '
                                          else event_status end event_status
                                        , psn
                                        , event_key_parent docno_i
                                     from event_effectivity_mapping
                                    where event_type = 'EFL'                   
                                   union
                                   select event_status
                                        , psn
                                        , event_key_parent docno_i
                                     from wo_event_link e
                                     join wo_header h on e.event_perfno_i = h.event_perfno_i
                                    where e.event_type = 'DOC_EFF'
                                      and pending_status = 0
                                  )x 
                            group by event_status, psn, docno_i
                          ) r on b.docno_i = r.docno_i
            ) n on a.docno_i = n.root and a.psn = n.psn and num = 1
/* AD eff date */
  left join (
             select docno_i
                  , listagg(docno || item, ', ') within group (order by docno) sup_ref_docno
                  , listagg(revision, ' / ') within group (order by docno) sup_ref_revision
               from
                    (
                      select r.docno_i
                           , case when docno like '%ITEM%'
                                   then substr(docno, 0, instr(docno,'-ITEM',-1) -1) 
                              else docno end docno
                           , revision
                           , case when docno like '%ITEM%'
                                   then ' (' || substr(docno, instr(docno, 'ITEM-')+5) || ')'
                              else null end item
                        from doc_replacement r
                        join doc_header h on r.ref_docno_i = h.docno_i
                    ) s
              group by docno_i
            ) re on a.docno_i = re.docno_i
/* INTERVALS */
  left join (
             select effectivityno_i, fh, fc, fd
               from (
                     select effectivityno_i
                          , ti.counter_defno_i
                          , case when unit &lt;&gt; ' ' and ti.counter_defno_i = 3
                                  then to_char(amount_interval) || ' ' || unit
                             else to_char(amount_interval) end amount_interval
                       from event_effectivity_link el
                       left join treq_time_requirement ttr on el.effectivity_linkno_i = ttr.event_key
                       left join treq_interval_group tig on ttr.timerequirementno_i = tig.timerequirementno_i
                       left join treq_interval ti on tig.interval_groupno_i = ti.interval_groupno_i
                       left join counter_definition cd on ti.counter_defno_i = cd.counter_defno_i
                      where threshold = 'N'
                        and dimension_type = 'I'
                        and ttr.event_type = 'EFL'
                    ) x
              pivot (max(amount_interval) for counter_defno_i in (1 as fh, 2 as fc, 3 as fd))
            ) i on k.effectivityno_i = i.effectivityno_i
/* Last Done */
  left join (
             select rank() over(partition by event_key_parent, h.psn order by fd ) rnk
                  , case when w_off_logic = 'Y' or h.type = 'PD' 
                          then null
                     else h.event_perfno_i end event_perfno_i
                  , event_key_parent
                  , h.psn
                  , fh
                  , fc
                  , fd
                  , w_off_logic
               from wo_header h
               left join wo_event_link e on h.event_perfno_i = e.event_perfno_i
               join rotables r on h.psn = r.psn
               left join aircraft a on h.ac_registr = a.ac_registr
            /* sign-off tree */
               left join ( 
                           select case when count(docno_i) &gt; 0 then 'Y'
                                   else 'N' end w_off_logic
                                , docno_i
                             from doc_signoff_tree
                            where docno_i &lt;&gt; ref_docno_i
                            group by docno_i
                         ) o on event_key_parent = o.docno_i 
               left join (
                      select event_perfno_i, fh, fc, fd
                        from (
                               select distinct 
                                      h.event_perfno_i
                                    , due_at
                                    , counter_defno_i
                                 from doc_header o
                                 join wo_event_link e on o.docno_i = e.event_key_parent
                                 join wo_header h on e.event_perfno_i = h.event_perfno_i
                                 left join (
                                             select e.event_perfno_i, due_at, counter_defno_i
                                               from wo_event_link e
                                               join wo_transfer wt on e.event_perfno_i = wt.event_perfno_i
                                               join wo_transfer_dimension wd on wt.event_transferno_i = wd.event_transferno_i
                                               join counter u on wd.counterno_i = u.counterno_i
                                               join counter_template ct on u.counter_templateno_i = ct.counter_templateno_i
                                              where wt.is_last_transfer = 'Y'
                                                and wt.transfer_type = 'R'
                                                and ct.counter_defno_i in (1, 2)
                                             union
                                             select event_perfno_i, absolute_due_date due_at, counter_defno_i
                                               from wo_transfer wt
                                               join wo_transfer_dimension wd on wt.event_transferno_i = wd.event_transferno_i
                                               join counter u on wd.counterno_i = u.counterno_i
                                               join counter_template ct on u.counter_templateno_i = ct.counter_templateno_i
                                              where wt.is_last_transfer = 'Y'
                                                and wt.transfer_type = 'R'
                                                and (wt.absolute_due_date is not null and wt.absolute_due_date &lt; '1491308')
                                                and ct.counter_defno_i in (3)
                                           ) wt on h.event_perfno_i = wt.event_perfno_i
                                          where o.ac_or_comp_doc = 'C'
                                            and e.event_type = 'DOC_EFF'
                                            and e.pending_status &lt; 0
                             ) x
                       pivot (avg(due_at) for counter_defno_i in (1 as fh, 2 as fc, 3 as fd)) d
                    ) s on h.event_perfno_i = s.event_perfno_i
           ) g on a.docno_i = g.event_key_parent and a.psn = g.psn and g.rnk = 1
/* Last Done
   PP Item
*/
  left join (
             select docno_i
                  , case when wpno like '%-%' 
                         then substr(wpno, instr(wpno,'-')+5) 
                    else wpno end || ' ' || listagg(seq_no, ', ') within group (order by seq_no) wpno
                  , ac_registr
               from (
                     select distinct 
                            rank() over(partition by docno_i, ac_registr order by h.act_end_date desc) rnk
                          , docno_i
                          , wpno
                          , act_end_date
                          , seqno_i seq_no
                          , ac_registr
                       from doc_header o
                       join wo_event_link e on o.docno_i = e.event_key_parent
                       join wp_assignment wa on e.event_perfno_i = wa.event_perfno_i
                       join wp_header h on wa.wpno_i = h.wpno_i
                       left join wp_sequence q on e.event_perfno_i = q.event_perfno_i
                      where o.ac_or_comp_doc = 'C'
                        and e.event_type = 'DOC_EFF'
                        and e.event_status &lt;&gt; 'O'
                        and h.act_end_date &gt; 0
                        and h.ac_registr = '@78_Modific_Stat_airframe_header.a.ac_registr@'
                      order by docno_i
                   ) v
             where rnk = 1
             group by docno_i, wpno, ac_registr
           ) pp on a.docno_i = pp.docno_i and a.ac_registr = pp.ac_registr
/* due'шники */
  left join (
             select case when h.type &lt;&gt; 'PD' then q.event_perfno_i
                     else null end event_perfno_i
                  , case when fh &gt; 0 then trunc(fh/60, 0) || ':'  || trunc(( mod(fh/60, 1) * (60/100) ) * 100, 0) 
                     else null end due_h
                  , case when fc &gt; 0 then trunc(fc, 0)
                     else null end due_c
                  , case when fd &gt;= '1491308' then 'UNDEFINED'
                         when fd &lt; 1 then null
                     else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + fd, 'yyyy') end due_year
                  , case when fd &gt;= '1491308' then 'UNDEFINED'
                         when fd &lt; 1 then null
                     else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + fd, 'mm') end due_month
                  , case when fd &gt;= '1491308' then 'UNDEFINED'
                         when fd &lt; 1 then null
                     else to_char(to_date('31.12.1971', 'dd.mm.yyyy') + fd, 'dd') end due_day 
                  , event_key_root
                  , psn
                  , event_key
                  , event_status
               from (
                     select event_perfno_i, fh, fc, fd
                       from ( 
                             select event_perfno_i
                                  , counter_defno_i
                                  , due_at
                               from (
                                     select wt.event_perfno_i
                                          , due_at
                                          , counter_defno_i
                                       from wo_event_link e
                                       join wo_header h on e.event_perfno_i = h.event_perfno_i
                                       join wo_transfer wt on h.event_perfno_i = wt.event_perfno_i
                                       join wo_transfer_dimension wd on wt.event_transferno_i = wd.event_transferno_i
                                       join counter u on wd.counterno_i = u.counterno_i
                                       join counter_template ct on u.counter_templateno_i = ct.counter_templateno_i
                                      where is_last_transfer = 'Y'
                                        and pending_status = 0
                                        and counter_defno_i in (1, 2)
                                     union
                                     select wt.event_perfno_i
                                          , absolute_due_date due_at
                                          , counter_defno_i
                                       from wo_event_link e
                                       join wo_header h on e.event_perfno_i = h.event_perfno_i
                                       join wo_transfer wt on h.event_perfno_i = wt.event_perfno_i
                                       join wo_transfer_dimension wd on wt.event_transferno_i = wd.event_transferno_i
                                       join counter u on wd.counterno_i = u.counterno_i
                                       join counter_template ct on u.counter_templateno_i = ct.counter_templateno_i
                                      where is_last_transfer = 'Y'
                                        and pending_status = 0
                                        and counter_defno_i = 3
                                    ) f
                            ) x
                      pivot (avg(due_at) for counter_defno_i in (1 as fh, 2 as fc, 3 as fd)) d
                    ) q 
               join wo_event_link e on q.event_perfno_i = e.event_perfno_i
               join wo_header h on e.event_perfno_i = h.event_perfno_i 
              where fd &gt;= trunc(sysdate - to_date('31.12.1971', 'dd.mm.yyyy'))
            ) y on a.psn = y.psn and y.event_key_root = a.docno_i
  left join (
             select docno_i
                  , listagg (text, ' '||chr(13)||chr(10) ) within group (order by recno) rem
               from doc_remarks 
               group by docno_i
            ) dr on a.docno_i = dr.docno_i          
 where a.ac_registr in ('@78_Modific_Stat_airframe_header.a.ac_registr@')
   and (to_char('@VAR.doc@') is null or a.docno_i = '@VAR.doc@')
    /* ATA-Chapter */
   and ('@VAR.ata@' is null or
      a.ata_chapter in
        (select trim(substr('@VAR.ata@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.ata@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.ata@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.ata@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.ata@') -
              length(replace('@VAR.ata@', ',', '')) + 1)) 
   and '@VAR.ad_status@' = '2'
 order by a.docno_i, a.ac_registr</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
