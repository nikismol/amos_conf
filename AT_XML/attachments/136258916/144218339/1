        <ds:columnDescriptor amosType="ALPHANUM" description=" case when h.docno like '%ITEM%' &#10;             then substr(h.docno 0 instr(h.docno'-ITEM'-1) -1) &#10;        else h.docno end docno" id="docno"/>
