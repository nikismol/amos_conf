      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.QT@">
          <ds:object>@VAR.QT@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.QC@">
          <ds:object>@VAR.QC@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.EXDATE1@">
          <ds:object>@VAR.EXDATE1@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.EXDATE2@">
          <ds:object>@VAR.EXDATE2@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
        	ROW_NUMBER() OVER (ORDER BY staff_pqs_qualification.issue_date) rno,
	staff_pqs_qualification.pqs_qualification_no_i,
	staff_pqs_qualification.pqs_type_no_i,
	staff_pqs_qualification.employee_no_i,
               staff_pqs_class.pqs_class_id,
	staff_pqs_type.type_label,
	to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (staff_pqs_qualification.issue_date+729)) issue_date,
       	to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (staff_pqs_qualification.expiry_date+729)) expire_date,
       	sign.user_sign,
      	sign.firstname,
       	sign.lastname,
	pqs.head
FROM staff_pqs_qualification
		LEFT JOIN staff_pqs_type ON staff_pqs_qualification.pqs_type_no_i = staff_pqs_type.pqs_type_no_i
		LEFT JOIN staff_pqs_class ON staff_pqs_type.pqs_class_no_i = staff_pqs_class.pqs_class_no_i 
		LEFT JOIN sign ON staff_pqs_qualification.employee_no_i = sign.employee_no_i 
		LEFT JOIN
			(
                    			SELECT staff_pqs_type.pqs_class_no_i,
                    			RTRIM(XMLAGG(XMLELEMENT(E, staff_pqs_type.type_label, ', ').EXTRACT('//text()') ORDER BY  staff_pqs_type.pqs_type_no_i).GetClobVal(), CHR(10)) as head
                    			FROM staff_pqs_type
                    			WHERE (REGEXP_LIKE(staff_pqs_type.pqs_type_no_i, REPLACE('@VAR.QT@', ', ', '|')) OR '@VAR.QT@' IS NULL)
                    			GROUP BY  staff_pqs_type.pqs_class_no_i
                		) pqs ON staff_pqs_type.pqs_class_no_i = pqs.pqs_class_no_i 
WHERE 
(REGEXP_LIKE(staff_pqs_type.pqs_type_no_i, REPLACE('@VAR.QT@', ', ', '|')) OR '@VAR.QT@' IS NULL)
AND
(REGEXP_LIKE(staff_pqs_class.pqs_class_id, REPLACE('@VAR.QC@', ', ', '|')) OR '@VAR.QC@' IS NULL)
AND
(
(staff_pqs_qualification.expiry_date &gt;= '@VAR.EXDATE1@' OR '@VAR.EXDATE1@' IS NULL)
AND
(staff_pqs_qualification.expiry_date &lt;= '@VAR.EXDATE2@' OR '@VAR.EXDATE2@' IS NULL)
)
ORDER BY staff_pqs_qualification.issue_date</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
