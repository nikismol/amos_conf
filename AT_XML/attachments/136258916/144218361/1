      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ROW_NUMBER() OVER (ORDER BY tr_course_list.date_from) rno2,
       	tr_course_list.course_listno_i,
       	tr_course_list.course_name,
       	to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (tr_course_list.date_from+729)) start_date,
       	to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (tr_course_list.date_to+729)) date_to,
       	tr_course_list.shift_group_id,
       	tr_course_list.shift_pattern_id,
       	tr_course_list.labor_regulation_no_i,
       	tr_course_list.minimum_duration,
       	tr_course_list.max_course_time,
       	tr_course_list.mutation,
       	tr_course_list.mutator,
       	tr_course_list.status,
       	tr_course_list.mutation_time,
       	tr_course_list.created_by,
       	tr_course_list.created_date,
       	staff_pqs_class.pqs_class_id,
       	staff_pqs_type.type_label,
       	tr_participant_list.sign,
       	sign.firstname,
       	sign.lastname
FROM tr_course_list
LEFT JOIN staff_pqs_type ON tr_course_list.eventtypeno_i  = staff_pqs_type.pqs_type_no_i
LEFT JOIN staff_pqs_class ON staff_pqs_type.pqs_class_no_i = staff_pqs_class.pqs_class_no_i 
LEFT JOIN tr_participant_list ON   tr_course_list.course_listno_i =  tr_participant_list.course_listno_i
LEFT JOIN sign ON tr_participant_list.sign  = sign.user_sign
WHERE
tr_course_list.status &lt;&gt; '9'
AND
(REGEXP_LIKE(staff_pqs_type.pqs_type_no_i, REPLACE('@VAR.QT@', ', ', '|')) OR '@VAR.QT@' IS NULL)
AND
(REGEXP_LIKE(staff_pqs_class.pqs_class_id, REPLACE('@VAR.QC@', ', ', '|')) OR '@VAR.QC@' IS NULL)
