(tr_course_list.date_from &gt;= '@VAR.DATE1@' OR '@VAR.DATE1@' IS NULL)
AND
(tr_course_list.date_from &lt;= '@VAR.DATE2@' OR '@VAR.DATE2@' IS NULL)

ORDER BY tr_course_list.date_from</se:textStatement>
