      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="MIN(history.historyno_i)" id="x1"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.partno" id="rotables.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.serialno" id="rotables.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.station" id="location.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.store" id="location.store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.location" id="location.location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.ac_registr" id="rotables.ac_registr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    MIN(history.historyno_i),
    rotables.partno,
    rotables.serialno,
    location.station,
    location.store,
    location.location,
    rotables.ac_registr
FROM
    rotables left
    JOIN history ON history.psn = rotables.psn
    LEFT JOIN od_header ON history.orderno = od_header.orderno
    LEFT JOIN location ON location.locationno_i = rotables.locationno_i
WHERE
    od_header.vendor = '0021000355'
    AND history.vm = 'B1'
GROUP BY
    history.historyno_i,
    rotables.partno,
    rotables.serialno,
    location.station,
    location.store,
    location.location,
    rotables.ac_registr</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
