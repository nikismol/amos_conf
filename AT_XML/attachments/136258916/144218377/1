    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MP_TC_TREQ" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i" id="msc_taskcard_version.taskcard_verno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;                                LISTAGG (CASE WHEN treq_interval.dimension_type IN ('W' 'B') THEN 'T:'&#10;                                                                      ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)&#10;                                                                                    WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + treq_interval.due_at 'DD.MM.YYYY')&#10;                                                                                    ELSE TO_CHAR(treq_interval.amount_interval)&#10;                                                                           END&#10;                                                                      ||' '&#10;                                                                      ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'&#10;                                                                                    WHEN treq_interval.counter_defno_i=2 THEN 'FC'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'&#10;                                                                                    WHEN treq_interval.counter_defno_i=101 THEN 'AH'&#10;                                                                                    WHEN treq_interval.counter_defno_i=102 THEN 'AC'&#10;                                                                                    WHEN treq_interval.counter_defno_i=103 THEN 'SD'&#10;                                                                                    WHEN treq_interval.counter_defno_i=104 THEN 'ID'&#10;                                                                          ELSE ''&#10;                                                                          END&#10;                                                           WHEN treq_interval.dimension_type IN ('I') THEN 'I:'&#10;                                                                       ||treq_interval.amount_interval&#10;                                                                      ||' '&#10;                                                                      ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'&#10;                                                                                    WHEN treq_interval.counter_defno_i=2 THEN 'FC'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'&#10;                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'&#10;                                                                                    WHEN treq_interval.counter_defno_i=101 THEN 'AH'&#10;                                                                                    WHEN treq_interval.counter_defno_i=102 THEN 'AC'&#10;                                                                                    WHEN treq_interval.counter_defno_i=103 THEN 'SD'&#10;                                                                                    WHEN treq_interval.counter_defno_i=104 THEN 'ID'&#10;                                                                                    ELSE '' &#10;                                                                          ENDCHR(10)&#10;                                                ) WITHIN GROUP (ORDER BY treq_interval.dimension_type) as treq" id="treq"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_MP_TC_MAIN.taskcard_verno_i@">
          <ds:object>@AFL_MP_TC_MAIN.taskcard_verno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_taskcard_version.taskcard_verno_i,
                                LISTAGG (CASE WHEN treq_interval.dimension_type IN ('W', 'B') THEN 'T:'
                                                                      ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)
                                                                                    WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + treq_interval.due_at, 'DD.MM.YYYY')
                                                                                    ELSE TO_CHAR(treq_interval.amount_interval)
                                                                           END
                                                                      ||' '
                                                                      ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                                    WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                                                                    WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                                    WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                                    WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                                    WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                                          ELSE ''
                                                                          END
                                                           WHEN treq_interval.dimension_type IN ('I') THEN 'I:'
                                                                       ||treq_interval.amount_interval
                                                                      ||' '
                                                                      ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                                    WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                                                                    WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                                                                    WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                                    WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                                    WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                                    WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                                                    ELSE '' 
                                                                           END
                                                              ELSE ''     
                                                     END, CHR(10)
                                                ) WITHIN GROUP (ORDER BY treq_interval.dimension_type) as treq
FROM msc_taskcard_version
JOIN treq_time_requirement ON treq_time_requirement.event_key=msc_taskcard_version.taskcard_verno_i AND treq_time_requirement.status='0'
                                                                                                                                                                                         AND treq_time_requirement.event_type = 'TCREV'
                                                                                                                                                                                         AND treq_time_requirement.type = 'OP'
JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i AND treq_interval.dimension_type IN ('W', 'B', 'I')
JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
WHERE msc_taskcard_version.taskcard_verno_i=@AFL_MP_TC_MAIN.taskcard_verno_i@
GROUP BY msc_taskcard_version.taskcard_verno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
