    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MP_TC_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i as taskcard_verno_i" id="taskcard_verno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno as taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.revision_no as revision_no" id="revision_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN (tc_status.TC_T='S' AND tc_status.TC_R&gt;='1' AND (tc_rem.status&lt;&gt;0 OR tc_rem.status IS NULL)) THEN 'R'||' '&#10;                       WHEN (tc_status.TC_T='S' AND tc_status.TC_R='0' AND (tc_rem.status&lt;&gt;0 OR tc_rem.status IS NULL)) THEN 'N'||' '&#10;                       WHEN (tc_rem.status='0' OR tc_rem.status IS NOT NULL) THEN 'D'||' '&#10;                       ELSE ' ' END as status" id="status"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.MP_NO@">
          <ds:object>@VAR.MP_NO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.mp_rev_status@">
          <ds:object>@VAR.mp_rev_status@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_taskcard_version.taskcard_verno_i as taskcard_verno_i,
             msc_taskcard.taskcardno as taskcardno,
             msc_taskcard_version.revision_no as revision_no,
             CASE WHEN tc_status.TC_T='S' AND tc_status.TC_R&gt;='1' THEN 'R'||' '
                       WHEN tc_status.TC_T='S' AND tc_status.TC_R='0' THEN 'N'||' '
                       ELSE ' ' END as status
FROM msc_taskcard_version
JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i=msc_taskcard.taskcardno_i
JOIN msc_maintenance_program ON msc_taskcard.mpno_i=msc_maintenance_program.mpno_i
JOIN msc_mprev_taskcards ON msc_mprev_taskcards.taskcard_verno_i=msc_taskcard_version.taskcard_verno_i
JOIN msc_mp_revision ON msc_mprev_taskcards.revisionno_i=msc_mp_revision.revisionno_i
LEFT JOIN (
                    SELECT tc.taskcardno,
                                  tc_rev.revision_no as rno,
                                  tc_rev.taskcard_verno_i as tcvrn_i,
                                  tc_rev.taskcard_status,
                                  tc_rev.not_applicable,
                                  tc.tc_type,
                                  (
                                   SELECT COUNT (*) 
                                   FROM msc_taskcard_version 
                                   JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i 
                                   WHERE msc_taskcard_version.taskcardno_i = tc.taskcardno_i 
                                                  AND msc_taskcard_version.taskcard_verno_i &lt;&gt; tc_rev.taskcard_verno_i 
                                                  AND msc_taskcard_version.taskcard_status = 'T' 
                                                  AND msc_taskcard_version.status &lt;&gt; 8
                                  ) as TC_A,
                                  CASE WHEN tc_rev.taskcard_verno_i = (
                                                                                                           SELECT MAX (mpr.taskcard_verno_i) 
                                                                                                           FROM msc_mprev_taskcards mpr 
                                                                                                           JOIN msc_taskcard_version ON mpr.taskcard_verno_i = msc_taskcard_version.taskcard_verno_i 
                                                                                                           WHERE mpr.revisionno_i = mp_tc.revisionno_i 
                                                                                                                          AND msc_taskcard_version.taskcardno_i = tc_rev.taskcardno_i 
                                                                                                                          AND mpr.taskcard_verno_i IN (
                                                                                                                                                                                   SELECT v1.taskcard_verno_i 
                                                                                                                                                                                   FROM msc_taskcard_version v1 
                                                                                                                                                                                   WHERE v1.taskcardno_i = (
                                                                                                                                                                                                                                    SELECT v2.taskcardno_i 
                                                                                                                                                                                                                                    FROM msc_taskcard_version v2 
                                                                                                                                                                                                                                    WHERE v2.taskcard_verno_i = v1.taskcard_verno_i
                                                                                                                                                                                                                                   ) 
                                                                                                                                                                                   AND v1.taskcard_status IN ('A', 'B')
                                                                                                                                                                                  )
                                            ) THEN ' ' ELSE 'S' END as TC_T,
                                   (
                                    SELECT COUNT (*) 
                                    FROM msc_taskcard_version 
                                    JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i 
                                    WHERE msc_taskcard_version.taskcardno_i = tc.taskcardno_i 
                                                   AND msc_taskcard_version.taskcard_verno_i &lt;&gt; tc_rev.taskcard_verno_i 
                                                   AND msc_taskcard_version.taskcard_status = 'A' 
                                                   AND msc_taskcard_version.status &lt;&gt; 8
                                   ) as TC_R
                    FROM msc_mprev_taskcards mp_tc 
                    JOIN msc_taskcard_version tc_rev ON mp_tc.taskcard_verno_i = tc_rev.taskcard_verno_i 
                    JOIN msc_taskcard tc ON tc_rev.taskcardno_i = tc.taskcardno_i 
                    ORDER BY tc.taskcardno, tc_rev.taskcard_verno_i
                   ) tc_status ON tc_status.tcvrn_i=msc_taskcard_version.taskcard_verno_i
WHERE 
        msc_maintenance_program.mpno_i = '@VAR.MP_NO@'
        AND msc_mp_revision.revision_type='MP'
        AND msc_mp_revision.revision_status='@VAR.mp_rev_status@'
        AND (
                  msc_taskcard_version.taskcard_status='A' AND tc_status.TC_A='0'
                  OR msc_taskcard_version.taskcard_status='T' AND tc_status.TC_T='S'
                  OR msc_taskcard_version.taskcard_status='A'
                        AND tc_status.TC_A='1' 
                        AND msc_mp_revision.revision_status='b'
                  OR msc_taskcard_version.taskcard_status IN ('B')
                         AND tc_status.TC_A='0' 
                         AND msc_mp_revision.revision_status='b'
                 )
GROUP BY msc_taskcard_version.taskcard_verno_i,
                   msc_taskcard.taskcardno,
                   msc_taskcard_version.revision_no,
                   tc_status.TC_T,
                   tc_status.TC_R
ORDER BY 2</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MP_TC_CHECK_ASSIGNMENTS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT&#10;             tc.taskcard_verno_i" id="tc.taskcard_verno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             DECODE (ch_assignment.internal_check NULL '''Y') as assigned" id="assigned"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tc.pos as position" id="position"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_MP_TC_MAIN.taskcard_verno_i@">
          <ds:object>@AFL_MP_TC_MAIN.taskcard_verno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_MP_CHECK_LIST_COUNT.cnt@">
          <ds:object>@AFL_MP_CHECK_LIST_COUNT.cnt@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_MP_CHECK_LIST_COUNT.check_intno_i@">
          <ds:object>@AFL_MP_CHECK_LIST_COUNT.check_intno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT tc.taskcard_verno_i,
             ch.assigned as assigned,
             tc.pos as position
FROM (
             SELECT t.taskcard_verno_i, rownum as pos
             FROM (SELECT @AFL_MP_TC_MAIN.taskcard_verno_i@ as taskcard_verno_i FROM DUAL) t,
             LATERAL (SELECT NULL FROM DUAL
                              CONNECT BY LEVEL&lt;= @AFL_MP_CHECK_LIST_COUNT.cnt@)
             ) tc
LEFT JOIN (
                   SELECT msc_requirement_tc_link.taskcard_verno_i_mri,
                                DECODE (ch_assignment.internal_check, NULL, '', 'Y') as assigned,
                                ch_assignment.pos
                   FROM msc_requirement_tc_link
                   LEFT JOIN requirement_link ON requirement_link.source = msc_requirement_tc_link.req_linkno_i
                                                       AND requirement_link.source_mimetype = 'TCREQLI'
                                                       AND requirement_link.target_mimetype = 'EFL'
                                                       AND requirement_link.code IN ('PD', 'IN') 
                   LEFT JOIN event_effectivity_link ON requirement_link.target=event_effectivity_link.effectivity_linkno_i
                   LEFT JOIN check_type_int ON event_effectivity_link.event_key=check_type_int.check_intno_i and check_type_int.status&lt;&gt;9
                   LEFT JOIN (
                                      SELECT cr.internal_check,
                                                   cr.check_intno_i,
                                                   cr.checkno_i,
                                                   rownum as pos
                                      FROM ( 
                                                   SELECT DISTINCT
                                                                check_type_int.internal_check,
                                                                check_type_int.checkno_i,
                                                                check_type_int.check_intno_i
                                                   FROM
                                                   check_type_int
                                                   WHERE check_type_int.check_intno_i IN (@AFL_MP_CHECK_LIST_COUNT.check_intno_i@)
                                                   ORDER BY NLSSORT(internal_check, 'NLS_SORT=BINARY')
                                                 ) cr
                                     ) ch_assignment ON ch_assignment.check_intno_i = check_type_int.check_intno_i
                    WHERE msc_requirement_tc_link.taskcard_verno_i_mri=@AFL_MP_TC_MAIN.taskcard_verno_i@
                  ) ch ON ch.taskcard_verno_i_mri = tc.taskcard_verno_i AND ch.pos=tc.pos
ORDER BY position</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MP_CHECK_LIST" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT&#10;        check_type_int.internal_check as internal_check" id="internal_check"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.MP_NO@">
          <ds:object>@VAR.MP_NO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT
                          check_type_int.internal_check internal_check
              FROM
              check_type_int
              JOIN check_type ON check_type.checkno_i=check_type_int.checkno_i
              JOIN event_effectivity_link ON check_type_int.check_intno_i=event_effectivity_link.event_key
                                                                  AND event_effectivity_link.event_type = 'CHTI' 
              JOIN event_effectivity ON event_effectivity.effectivityno_i=event_effectivity_link.effectivityno_i
                                                          AND event_effectivity.parent_effectivityno_i IS NULL 
                                                          AND (event_effectivity.status NOT IN (1, 2) OR event_effectivity.revision_effectivityno_i IS NULL)
              WHERE event_effectivity.aircraft_typ = (SELECT mpno FROM msc_maintenance_program WHERE mpno_i = '@VAR.MP_NO@')
                           AND check_type_int.status&lt;&gt;9
              ORDER BY NLSSORT(internal_check, 'NLS_SORT=BINARY')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MP_CHECK_LIST_COUNT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT (*) as cnt" id="cnt"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG (cr.check_intno_i '') WITHIN GROUP (ORDER BY cr.check_intno_i) as check_intno_i" id="check_intno_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.MP_NO@">
          <ds:object>@VAR.MP_NO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT COUNT (*) as cnt,
             LISTAGG (cr.check_intno_i, ', ') WITHIN GROUP (ORDER BY cr.check_intno_i) as check_intno_i
