    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="IFE_Inop_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as wo" id="wo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_model as ac_model" id="ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN wo_header.type = 'C' THEN 'Cabin'&#10;                   WHEN wo_header.type = 'P' THEN 'Pirep' &#10;                   WHEN wo_header.type = 'M' THEN 'Maintenance'&#10;                   ELSE ''&#10;         END as wo_type" id="wo_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN wo_header.mel_code IS NULL &#10;                     AND wo_header.hil = 'Y'&#10;                     AND wo_opus.free_text IS NOT NULL THEN 'Y' ELSE ''&#10;         END as dd" id="dd"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.issue_sign as issue_sign" id="issue_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + ( wo_header.issue_date+729)'dd.mm.yyyy') as issue_date" id="issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + ( wo_header.closing_date+729)'dd.mm.yyyy') as closing_date" id="closing_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ata_chapter as ata_chapter" id="ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.mel_code as mel_code" id="mel_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.state as state" id="state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_req.pn as req_parts" id="req_parts"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dblink.ref as refs" id="refs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.step_text as step_text" id="step_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.action_text as action_text" id="action_text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_issue_from@">
          <ds:object>@VAR.v05_issue_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v06_issue_to@">
          <ds:object>@VAR.v06_issue_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_ac_typ@">
          <ds:object>@VAR.v02_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_ata@">
          <ds:object>@VAR.v01_ata@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_ac_registr@">
          <ds:object>@VAR.v03_ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_wo_state@">
          <ds:object>@VAR.v04_wo_state@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
         wo_header.event_perfno_i as wo
        ,wo_header.ac_registr as ac_registr
        ,aircraft.ac_model as ac_model 
        ,aircraft.ac_typ as ac_typ
        ,CASE WHEN wo_header.type = 'C' THEN 'Cabin'
                   WHEN wo_header.type = 'P' THEN 'Pirep' 
                   WHEN wo_header.type = 'M' THEN 'Maintenance'
                   ELSE ''
         END as wo_type
        ,CASE WHEN wo_header.mel_code IS NULL 
                     AND wo_header.hil = 'Y'
                     AND wo_opus.free_text IS NOT NULL THEN 'Y' ELSE ''
         END as dd
        ,wo_header.issue_sign as issue_sign
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.issue_date+729),'dd.mm.yyyy') as issue_date 
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.closing_date+729),'dd.mm.yyyy') as closing_date
        ,wo_header.ata_chapter as ata_chapter
        ,wo_header.mel_code as mel_code
        ,wo_header.state as state
        ,part_req.pn as req_parts
        ,dblink.ref as refs
        ,wo.step_text as step_text
        ,wo.action_text as action_text
FROM (
             SELECT  DISTINCT
                    wo_header.event_perfno_i AS event_perfno_i
                    ,LISTAGG (TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_text_description.created_date+729), 'DD.MM.YYYY')||
                                                                                                    CASE WHEN wo_text_description.text IS NOT NULL 
                                                                                                    THEN ': '||TO_CHAR(wo_text_description.text)||'.' ELSE '' END, CHR(10)||CHR(10))
                    WITHIN GROUP (ORDER BY workstep_link.sequenceno) as step_text
                    ,LISTAGG (TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_text_action.action_date+729), 'DD.MM.YYYY')||
                                                                                                    CASE WHEN wo_text_action.text IS NOT NULL 
                                                                                                    THEN ': '||TO_CHAR(wo_text_action.text)||'.' ELSE '' END, CHR(10)||CHR(10))
                    WITHIN GROUP (ORDER BY workstep_link.sequenceno) as action_text
            FROM
                    wo_header
            LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
            LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
            LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
            LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
            LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i=wo_text_action.workstep_linkno_i
            WHERE 1=1
                    AND wo_header.issue_date BETWEEN @VAR.v05_issue_from@ AND @VAR.v06_issue_to@
                    AND wo_header.type IN ('M', 'C', 'P')
                    AND aircraft.ac_typ = '@VAR.v02_ac_typ@'
                    AND aircraft.ac_model not in ('A320N', 'A321NX')
                    AND (wo_header.ata_chapter LIKE ('44%')
                               OR wo_header.ata_chapter LIKE ('23-33%')
                               OR wo_header.ata_chapter LIKE ('23-34%')
                               OR wo_header.ata_chapter LIKE ('23-36%')
                              )
                    AND (
                              REGEXP_LIKE (wo_text_description.text, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
                              OR REGEXP_LIKE (wo_text_description.text_html, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
                              OR REGEXP_LIKE (wo_text_description.header, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
                              OR REGEXP_LIKE (wo_text_action.text, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
                             )
	GROUP BY  wo_header.event_perfno_i
    ) wo 
LEFT JOIN wo_header ON wo.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN wo_opus ON wo_header.event_perfno_i = wo_opus.event_perfno_i    
LEFT JOIN   (                   
                                SELECT wo_header.event_perfno_i as event_perfno_i,
                                LISTAGG (CASE WHEN LENGTH(part.description) + LENGTH(part_request_2.partno) &lt;= 48
                                                           THEN part.description||' '||part_request_2.partno||' - '||TO_NUMBER(part_request_2.qty)||'ea'
                                                           ELSE SUBSTR(part.description, 1, 42)||'...'||' '||part_request_2.partno||' - '||TO_NUMBER(part_request_2.qty)||'ea'
                                                           END, CHR(10)
                                        ) WITHIN GROUP (ORDER BY part_request_2.part_requestno_i) as pn
                   FROM wo_header
                   JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr AND aircraft.ac_typ IN ('A32S', 'A330', 'B737','B777')
                   JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i and wo_header.state='O' AND wo_header.type NOT IN ('S', 'T', 'PD')
                   JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key
                   LEFT JOIN part ON part_request_2.partno=part.partno
                   WHERE part_request_2.event_type = 'WSL'
                   GROUP BY wo_header.event_perfno_i
            ) part_req ON wo_header.event_perfno_i=part_req.event_perfno_i
LEFT JOIN   ( 
                SELECT
                dbl.event_perfno_i
                ,LISTAGG (dbl.ref_type||' '||dbl.description, CHR(10)) WITHIN GROUP (ORDER BY dbl.ref_type) as ref  
                FROM (
                        SELECT
                                workstep_link.event_perfno_i,
                                db_link.description,
                                db_link.ref_type
                        FROM workstep_link
                        JOIN db_link ON TO_CHAR(workstep_link.descno_i) = TO_CHAR(db_link.source_pk) AND db_link.source_type='WS' 
                        
                        UNION

                        SELECT
                                wo_header.event_perfno_i,
                                db_link.description,
                                db_link.ref_type
                        FROM wo_header
                        JOIN db_link ON TO_CHAR(wo_header.event_perfno_i) = TO_CHAR(db_link.source_pk) AND db_link.source_type='WO' 
                    ) dbl
                GROUP BY dbl.event_perfno_i
            ) dblink ON wo_header.event_perfno_i = dblink.event_perfno_i  


