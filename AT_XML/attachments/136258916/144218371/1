    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WO_LIST" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT rownum" id="rownum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT wo_header.event_perfno_i AS event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;                    LISTAGG (TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_text_description.created_date+729) 'DD.MM.YYYY')||CASE WHEN wo_text_description.text IS NOT NULL THEN ': '||TO_CHAR(wo_text_description.text)||'.' ELSE '' ENDCHR(10)||CHR(10))&#10;                                      WITHIN GROUP (ORDER BY workstep_link.sequenceno) as step_text" id="step_text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_REG@">
          <ds:object>@VAR.AC_REG@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_TYPE@">
          <ds:object>@VAR.AC_TYPE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ATA@">
          <ds:object>@VAR.ATA@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_STATE@">
          <ds:object>@VAR.WO_STATE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT     DISTINCT
                    rownum
	     ,wo_header.event_perfno_i AS event_perfno_i
                    ,LISTAGG (TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_text_description.created_date+729), 'DD.MM.YYYY')||CASE WHEN wo_text_description.text IS NOT NULL THEN ': '||TO_CHAR(wo_text_description.text)||'.' ELSE '' END, CHR(10)||CHR(10))
                                      WITHIN GROUP (ORDER BY workstep_link.sequenceno) as step_text
             FROM
                    wo_header
             LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
             LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
             LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
             LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
             LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i=wo_text_action.workstep_linkno_i
             WHERE
		(REGEXP_LIKE( wo_header.ac_registr, REPLACE('@VAR.AC_REG@', ', ', '|')) OR '@VAR.AC_REG@' IS NULL)
		AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE( '@VAR.AC_TYPE@', ', ', '|')) OR '@VAR.AC_TYPE@' IS NULL)
		AND (REGEXP_LIKE( wo_header.ATA_CHAPTER, REPLACE( '@VAR.ATA@', ', ', '|')) OR '@VAR.ATA@' IS NULL)
		AND 
		(
			(wo_header.state = 'O' AND '@VAR.WO_STATE@' = 'O') OR
			(wo_header.state = 'C' AND '@VAR.WO_STATE@' = 'C') OR
			((wo_header.state = 'O' OR wo_header.state = 'C') AND '@VAR.WO_STATE@' = 'ALL')
		)
		AND (wo_header.issue_date &gt;= '@VAR.date_from@' OR '@VAR.date_from@' IS NULL)
		AND (wo_header.issue_date &lt;= '@VAR.date_to@' OR '@VAR.date_to@' IS NULL)
		AND wo_header.type IN ('M', 'C', 'P')
                    AND (
                               wo_header.ata_chapter LIKE ('44%') AND aircraft.ac_typ = 'B737'
          		AND (
					REGEXP_LIKE (wo_text_description.text, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
					OR
					REGEXP_LIKE (wo_text_description.text_html, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
					OR
					REGEXP_LIKE (wo_text_description.header, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
					OR 
					REGEXP_LIKE (wo_text_action.text, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
			       )
		)
	GROUP BY rownum, wo_header.event_perfno_i
	ORDER BY rownum</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WO_LINKS" type="SQL_EDITOR_DATASOURCE" version="2.0">
