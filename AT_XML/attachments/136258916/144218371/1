      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
      LISTAGG ( dbl.ref_type||' '||dbl.description, CHR(10)) WITHIN GROUP (ORDER BY dbl.ref_type) as ref  
FROM (
             SELECT
                    workstep_link.event_perfno_i,
                    db_link.description,
                    db_link.ref_type
             FROM workstep_link
             JOIN db_link ON TO_CHAR(workstep_link.descno_i) = TO_CHAR(db_link.source_pk) AND db_link.source_type='WS' AND workstep_link.event_perfno_i='@WO_LIST.event_perfno_i@'
                  
             UNION

             SELECT
                    wo_header.event_perfno_i,
                    db_link.description,
                    db_link.ref_type
             FROM wo_header
             JOIN db_link ON TO_CHAR(wo_header.event_perfno_i) = TO_CHAR(db_link.source_pk) AND db_link.source_type='WO' AND wo_header.event_perfno_i='@WO_LIST.event_perfno_i@'
             ) dbl
GROUP BY dbl.event_perfno_i</se:textStatement>
        </se:sqlStatement>
