    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="275_ORR" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_ya.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_ya.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_ya.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + h_ya.del_date'dd.mm.yyyy') as removal_date" id="removal_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_ya.event_perfno_i as removal_wo" id="removal_wo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="*/&#10;              wo_header.cannibalized as cannibalized" id="cannibalized"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              DECODE(wo_header.state 'O' 'Open' 'C' 'Closed'wo_header.state) as wo_status" id="wo_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + ac_util.departure_date'dd.mm.yyyy') as last_flight" id="last_flight"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.last_station as last_station" id="last_station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp.wpno as current_wp" id="current_wp"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_removals_date_from@">
          <ds:object>@VAR.v01_removals_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_ac_registr@">
          <ds:object>@VAR.v02_ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT aircraft.ac_typ as ac_typ,
              h_ya.ac_registr as ac_registr,
              CASE WHEN REGEXP_LIKE(h_ya.partno, '^[0-9]+$') THEN chr(39)||h_ya.partno ELSE h_ya.partno END as partno,
              part.description as description,
              CASE WHEN REGEXP_LIKE(h_ya.serialno, '^[0-9]+$') THEN chr(39)||h_ya.serialno ELSE h_ya.serialno END as serialno,
              TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + h_ya.del_date, 'dd.mm.yyyy') as removal_date,
              h_ya.event_perfno_i as removal_wo,
              wo_header.cannibalized as cannibalized,
              DECODE(wo_header.state, 'O', 'Open', 'C', 'Closed', wo_header.state) as wo_status,
              TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + ac_util.departure_date, 'dd.mm.yyyy') as last_flight,
              aircraft.last_station as last_station,
              wp.wpno as current_wp 
FROM (
             SELECT history.historyno_i,
                           MAX(history.historyno_i) OVER (PARTITION BY history.ac_registr, history.location) as max_historyno_i,
                           history.ac_registr,
                           history.location,
                           history.labelno,
                           history.partno,
                           history.serialno,
                           history.del_date,
                           history.event_perfno_i
             FROM history
             WHERE history.vm = 'YA'
                           AND history.del_date &gt;= @VAR.v01_removals_date_from@ /* указать начало периода для выборки демонтажей */
                           AND history.label_start = 'Y'
                           AND (REGEXP_LIKE(history.ac_registr, REPLACE('@VAR.v02_ac_registr@', ', ', '|')) OR '@VAR.v02_ac_registr@' IS NULL)
            ) h_ya
LEFT JOIN part ON h_ya.partno = part.partno
LEFT JOIN history h_ye ON h_ya.labelno = h_ye.labelno AND h_ye.vm = 'YE'
LEFT JOIN wo_header ON h_ya.event_perfno_i = wo_header.event_perfno_i AND wo_header.state &lt;&gt; 'V'
LEFT JOIN rotables ON h_ya.location = rotables.location AND rotables.ac_registr = h_ya.ac_registr
JOIN aircraft ON h_ya.ac_registr = aircraft.ac_registr AND aircraft.status &lt;&gt; 9 AND aircraft.operator = 'AFL'
LEFT JOIN (
                   SELECT ac_utilization.ac_registr,
                                 ac_utilization.departure_date,
                                 MAX(ac_utilization.departure_date) OVER (PARTITION BY ac_utilization.ac_registr) as max_departure_date,
                                 ac_utilization.recno,
                                 MAX(ac_utilization.recno) OVER (PARTITION BY ac_utilization.ac_registr, ac_utilization.departure_date) as max_recno
                   FROM ac_utilization
                   WHERE 1=1
                                  AND ac_utilization.recno &gt; 0
                                  AND ac_utilization.null_leg_commited &lt;&gt; 1
                   ) ac_util ON h_ya.ac_registr = ac_util.ac_registr AND ac_util.departure_date = ac_util.max_departure_date AND ac_util.recno = ac_util.max_recno
LEFT JOIN (
                   SELECT wp_header.ac_registr,
                                 LISTAGG(wp_header.wpno ||' (' || wp_header.description || ')', '; '||CHR(10)) WITHIN GROUP (ORDER BY wp_header.wpno) as wpno
                   FROM wp_header
                   WHERE 1=1
                                  AND wp_status IN (-1, -3) 
		     AND (/* выбираю пакеты, которые "выполняются" на момент выгрузки отчета */ 
                                            NVL(case
                                                     when wp_header.act_start_date&gt;0 and wp_header.act_start_time&gt;0
                                                     then TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.act_start_date, 'day') + NUMTODSINTERVAL(wp_header.act_start_time * 60, 'SECOND')
                                                     else null
                                                     end,
                                                     TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.start_date, 'day') + NUMTODSINTERVAL(wp_header.start_time * 60, 'SECOND')
                                                    ) AT TIME ZONE 'Europe/Moscow'
                                                    BETWEEN from_tz(CAST (TRUNC(systimestamp)+ numtodsinterval(0, 'day') AS TIMESTAMP), 'Europe/Moscow')
                                                                       AND from_tz(CAST (TRUNC(systimestamp)+ numtodsinterval(0, 'day') AS TIMESTAMP), 'Europe/Moscow')
                                               OR
                                            NVL(
                                                     case
                                                     when wp_header.act_start_date&gt;0 and wp_header.act_start_time&gt;0
                                                     then TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.act_start_date, 'day') + NUMTODSINTERVAL(wp_header.act_start_time * 60, 'SECOND')
                                                     else null
                                                     end,
                                                     TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.start_date, 'day') + NUMTODSINTERVAL(wp_header.start_time * 60, 'SECOND')
                                                    ) AT TIME ZONE 'Europe/Moscow' &lt; from_tz(CAST (TRUNC(systimestamp)+ numtodsinterval(0, 'day') AS TIMESTAMP), 'Europe/Moscow')
                                            AND
                                            NVL(case 
                                                     when wp_header.act_end_date&gt;0 and wp_header.act_end_time&gt;0
                                                     then TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.act_end_date, 'day') + NUMTODSINTERVAL(wp_header.act_end_time * 60, 'SECOND')
                                                     else null
                                                     end,
                                                     TO_TIMESTAMP_TZ('31.12.1971 00:00:00 00:00', 'DD.MM.YYYY HH24:MI:SS TZH:TZM') + numtodsinterval(wp_header.end_date, 'day') + NUMTODSINTERVAL(wp_header.end_time * 60, 'SECOND')
                                                    ) AT TIME ZONE 'Europe/Moscow' &gt;= from_tz(CAST (TRUNC(systimestamp)+ numtodsinterval(0, 'day') AS TIMESTAMP), 'Europe/Moscow')
                                          )
                   GROUP BY wp_header.ac_registr
                   ) wp ON h_ya.ac_registr = wp.ac_registr
WHERE 1=1
              AND h_ya.historyno_i = h_ya.max_historyno_i
              AND h_ye.historyno_i IS NULL
              AND rotables.psn IS NULL
              AND h_ya.del_date &gt;= ac_util.departure_date
              AND wo_header.type = 'S'
ORDER BY 1, 2, 3, 5</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
