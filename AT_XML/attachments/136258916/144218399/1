    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_SPA_List_stock_diff" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Spa list stock diff with study</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.partno" id="sd.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.reorder_level" id="sd.reorder_level"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.ideal_qty" id="sd.ideal_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ps.qty_sys" id="ps.qty_sys"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ps2.qty_sys" id="ps2.qty_sys"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.spa_list@">
          <ds:object>@VAR.spa_list@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT sd.partno, sd.reorder_level, sd.ideal_qty, ps.qty_sys, ps2.qty_sys
FROM spa_header sh
LEFT JOIN spa_detail sd ON sd.list = sh.name
LEFT JOIN part_station ps ON ps.partno = sd.partno AND ps.station = sh.station AND ps.store = sh.store
LEFT JOIN part_station_study ps2 ON ps2.partno = sd.partno AND ps2.station = sh.station AND ps2.store = sh.store
WHERE sh.name = '@VAR.spa_list@'
AND (ps.qty_sys != ps2.qty_sys)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
