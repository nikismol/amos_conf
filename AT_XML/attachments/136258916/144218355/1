    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_DISMANTLED_ENG" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.vendor" id="od_header.vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno" id="od_header.orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.partno" id="od_detail.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.serialno" id="od_detail.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (history.del_date+729)'dd.mm.yyyy') as booked_date" id="booked_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.ac_typ" id="history.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="address.name" id="address.name"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AC_TYP.ac_typ@">
          <ds:object>@AC_TYP.ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT   od_header.vendor,
	   od_header.orderno,
       	   od_detail.partno,
 	   od_detail.serialno,
	   TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (history.del_date+729), 'dd.mm.yyyy') as booked_date,
                  history.ac_typ,
                  address.name
FROM od_header
LEFT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
LEFT JOIN history ON od_detail.detailno_i = history.od_detailno_i
LEFT JOIN address ON od_detail.vendor = address.vendor
WHERE od_header.ext_state = 'BO' 
AND od_header.order_type = 'R'
AND history.vm = 'SX'
AND od_detail.partno IN   
                             (
		'3800702-1',
		'3800708-1',
		'3800454-6',
		'3800550-1',
		'WE3800770-3',
		'SAM146-1S17',
		'GE90-115B',
		'CFM56-7B26EG05',
		'CFM56-7B26',
		'FK30858',
		'1887M10G05',
		'1887M10G06',
		'1887M10G07'
		)
AND history.ac_typ = '@AC_TYP.ac_typ@'
ORDER BY od_detail.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AC_TYP" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT aircraft.ac_typ as ac_typ" id="ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT aircraft.ac_typ as ac_typ
FROM aircraft
WHERE aircraft.ac_typ IN ('A32S','A330','B737','B777','RRJ')
ORDER BY aircraft.ac_typ</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
