      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select row_number() over(order by p.created_date, p.partno) num
     , t.partno
     , p.ac_typ
     , case when p.ata_chapter = 'UNKNOWN'
                then 'UNK.'
        else p.ata_chapter
       end ata
     , i.sign
     , m.description
     , req_part
     , way
     , altpartno
     , p2.ac_typ
     , case when p2.ata_chapter = 'UNKNOWN'
                then 'UNK.'
        else p2.ata_chapter
       end ata2
     , i2.sign
     , m2.description
     , req_altpart
     , to_char(to_date('31.12.1971', 'dd.mm.yyyy') + p.created_date,'dd.mm.yyyy') part_created_date
  from (
        /* определяю тип way */
        select distinct 
               a.partno
             , case when aa.req = 'Y' then aa.req
                 else 'N' end req_part
             , '&lt;-&gt;' way
             , a.altpartno
             , case when bb.req = 'Y' then bb.req
                 else 'N' end req_altpart
          from ( /* 2019-11-18
                 убираю дубликаты у двусторонней взаимозаменяемости
                 */
                select a.partno
                     , a.altpartno
                     , b.partno p2
                     , b.altpartno a2
                     , p.partseqno_i seq_a
                     , p2.partseqno_i seq_p
                  from part_alternate a
                  join part_alternate b on a.altpartno = b.partno 
                                       and b.altpartno = a.partno
                  join part p on a.partno = p.partno
                  join part p2 on b.partno = p2.partno
                 where b.partno is not null
                   and ( p2.partno is null or p.partseqno_i &lt; p2.partseqno_i)
               ) a
          left join (
                     select partno
                          , 'Y' req
                       from part_requirement p
                       join event_effectivity_link l on p.part_requirementno_i = l.event_key and l.event_type = 'PARTREQ'
                       join event_effectivity e on e.effectivityno_i = l.effectivityno_i
                    ) aa on a.partno = aa.partno
          left join (
                     select partno
                          , 'Y' req
                       from part_requirement p
                       join event_effectivity_link l on p.part_requirementno_i = l.event_key and l.event_type = 'PARTREQ'
                       join event_effectivity e on e.effectivityno_i = l.effectivityno_i
                    ) bb on a.altpartno = bb.partno
         union
        select a.partno
             , case when aa.req = 'Y' then aa.req
                 else 'N' end req_part
             , '-&gt;' way
             , a.altpartno
             , case when bb.req = 'Y' then bb.req
                 else 'N' end req_altpart
          from part_alternate a
          left join part_alternate b on a.altpartno = b.partno
          left join (
                     select partno
                          , 'Y' req
                       from part_requirement p
                       join event_effectivity_link l on p.part_requirementno_i = l.event_key and l.event_type = 'PARTREQ'
                       join event_effectivity e on e.effectivityno_i = l.effectivityno_i
                    ) aa on a.partno = aa.partno
          left join (
                     select partno
                          , 'Y' req
                       from part_requirement p
                       join event_effectivity_link l on p.part_requirementno_i = l.event_key and l.event_type = 'PARTREQ'
                       join event_effectivity e on e.effectivityno_i = l.effectivityno_i
                    ) bb on a.altpartno = bb.partno
         where b.partno is null
        ) t
  join part p on t.partno = p.partno 
             and t.req_part &lt;&gt; t.req_altpart
  join mat_type m on p.mat_type = m.mat_type
  /* 2019-11-19
     Add sign of installation on aircraft fleet
  */
  left join (
             select p.partno
                  , 'Y' sign
               from part p
               join rotables r on p.partno = r.partno
               join position i on r.location = i.position
              group by p.partno
            ) i on p.partno = i.partno
  /* 2019-11-18
     - Таблица добавлена для поиска ac_typ у альтернативного p/n
  */
  join part p2 on t.altpartno = p2.partno
  join mat_type m2 on p2.mat_type = m2.mat_type
  left join (
             select p.partno
                  , 'Y' sign
               from part p
               join rotables r on p.partno = r.partno
               join position i on r.location = i.position
              group by p.partno
            ) i2 on p2.partno = i2.partno
 where /* Period 
         Date From
       */
     ('@VAR.date_from@' is null or '@VAR.date_from@' &lt;= p.created_date)
       /* Period 
          Date To
       */
 and ('@VAR.date_to@' is null or '@VAR.date_to@' &gt;= p.created_date)
 and /* 2019-11-19
        add check-box for mat_type
     */
     (
     ('@VAR.tool@' = 'Y' and p.mat_type in ('T', 'EQUI'))
  or ('@VAR.part@' = 'Y' and p.mat_type not in ('T', 'EQUI')) 
  or ('@VAR.tool@' = 'N' and '@VAR.part@' = 'N')
     )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
