    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="196_Components_Replaceable_main" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>main sql</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(order by created_datep.partno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.partno" id="t.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.ac_typ" id="p.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when p.ata_chapter = 'UNKNOWN'&#10;                then 'UNK.'&#10;        else p.ata_chapter&#10;       end ata" id="ata"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="i.sign" id="i.sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="m.description" id="m.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="req_part" id="req_part"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="way" id="way"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="altpartno" id="altpartno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p2.ac_typ" id="p2.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when p2.ata_chapter = 'UNKNOWN'&#10;                then 'UNK.'&#10;        else p2.ata_chapter&#10;       end ata2" id="ata2"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="i2.sign" id="i2.sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="m2.description" id="m2.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="req_altpart" id="req_altpart"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" to_char(to_date('31.12.1971' 'dd.mm.yyyy') + p.created_date'dd.mm.yyyy') part_created_date" id="part_created_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tool@">
          <ds:object>@VAR.tool@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.part@">
          <ds:object>@VAR.part@</ds:object>
