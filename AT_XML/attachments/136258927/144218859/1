      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
od_header.vendor AS vendor,
od_rec_detail.orderno,
od_header.ext_state,
TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_header.created_date), 'DD.MM.YYYY') AS order_created_date,
TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_header.orderdate), 'DD.MM.YYYY') AS order_date_APN2015,
od_detail.partno AS ordered_pn,
od_rec_detail.partno AS received_pn,
od_rec_detail.serialno AS received_sn,
TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_rec_header.del_date), 'DD.MM.YYYY') AS receiving_date,

TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(od_rec_header.del_time)/1000/60/60),'FM999999999900'))||':'
||TO_CHAR(TRUNC(MOD(FLOOR(TO_NUMBER(od_rec_header.del_time)/1000/60),60)),'FM00')||':'
||TO_CHAR(TRUNC(MOD(FLOOR(TO_NUMBER(od_rec_header.del_time)/1000),60)),'FM00')  AS receiving_time_APN2121,

TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(od_rec_header.mutation_time)/1000/60/60),'FM999999999900'))||':'
||TO_CHAR(TRUNC(MOD(FLOOR(TO_NUMBER(od_rec_header.mutation_time)/1000/60),60)),'FM00')||':'
||TO_CHAR(TRUNC(MOD(FLOOR(TO_NUMBER(od_rec_header.mutation_time)/1000),60)),'FM00')  AS receiving_last_mutation_time,

TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mutation_time)/1000/60/60),'FM999999999900'))||':'
||TO_CHAR(TRUNC(MOD(FLOOR(TO_NUMBER(history.mutation_time)/1000/60),60)),'FM00')||':'
||TO_CHAR(TRUNC(MOD(FLOOR(TO_NUMBER(history.mutation_time)/1000),60)),'FM00')  AS historyB1_last_mutation_time
FROM od_detail
JOIN od_header ON od_detail.orderno_i = od_header.orderno_i
JOIN od_rec_detail ON od_detail.detailno_i = od_rec_detail.detailno_i
JOIN od_rec_header ON od_rec_detail.receivingno = od_rec_header.receivingno
JOIN part ON part.partno = od_rec_detail.partno
LEFT JOIN history ON od_rec_detail.recdetailno_i = history.recdetailno_i AND history.vm = 'B1'
WHERE 
od_rec_detail.status &lt;&gt; 9
AND od_rec_detail.recno &lt;&gt; -1
AND od_header.entityno_i = 1
AND od_header.ext_state = 'R'
AND (REGEXP_LIKE( od_header.orderno_i, REPLACE('@VAR.ORDER@', ', ', '|')) OR '@VAR.ORDER@' IS NULL)
AND (REGEXP_LIKE( od_header.vendor, REPLACE('@VAR.VENDOR@', ', ', '|')) OR '@VAR.VENDOR@' IS NULL)
ORDER BY od_detail.orderno_i DESC</se:textStatement>
