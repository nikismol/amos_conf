        <ds:columnDescriptor amosType="ALPHANUM" description="address.name_2 as name_2" id="name_2"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_receiver@">
          <ds:object>@VAR.v01_receiver@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT COALESCE (aircraft.ac_registr, costcenter.description, costcenter.costcenter) as receiver,
               aircraft.ac_typ as ac_typ,
               aircraft.operator as operator,
               address.name as name,
               address.name_1 as name_1,
               address.name_2 as name_2
FROM costcenter
LEFT JOIN aircraft ON REGEXP_LIKE(costcenter.costcenter, aircraft.ac_registr) OR REGEXP_LIKE(costcenter.description, aircraft.ac_registr)
LEFT JOIN address ON address.vendor=aircraft.operator
WHERE 1=1
               AND costcenter.costcenter='@VAR.v01_receiver@'
               AND costcenter.status &lt;&gt; 9</se:textStatement>
        </se:sqlStatement>
