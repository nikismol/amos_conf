          <ds:object>@VAR.v04_planned_start_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_planned_start_date_to@">
          <ds:object>@VAR.v05_planned_start_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v06_planned_end_date_from@">
          <ds:object>@VAR.v06_planned_end_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v07_planned_end_date_to@">
          <ds:object>@VAR.v07_planned_end_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
              pickslip_header.remarks ||' ('||pickslip_booked.pickslipno||')' as remarks,
              pickslip_booked.partno as partno,
              CASE WHEN pickslip_booked.batchno IS NULL 
                                      OR ASCII(pickslip_booked.batchno)=49824
                         THEN pickslip_booked.serialno
                         ELSE pickslip_booked.batchno
              END as bn_sn,
              part.description as part_description,
              TO_CHAR(TO_NUMBER(pickslip_booked.qty_booked-pickslip_booked.qty_canceled),'99999999990.99') as qty_booked,
              measure_unit.measure_unit||' ('||measure_unit.description||')' as measure_unit,
              pickslip_booked.pickslipno as pickslipno,
              pickslip_booked.recno as recno,
              part.mat_class as mat_class,
              NVL(part.tool, 'N') as tool,
              TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + pickslip_header.planned_date, 'dd.mm.yyyy') as planned_date,
              pickslip_header.projectno as projectno
FROM pickslip_booked
JOIN pickslip_header ON pickslip_booked.pickslipno=pickslip_header.pickslipno
JOIN part ON pickslip_booked.partno=part.partno
LEFT JOIN measure_unit ON measure_unit.measure_unit=part.measure_unit AND measure_unit.status&lt;&gt;9
WHERE 1=1
/* AND pickslip_booked.pickslipno in (1182247,1182249, 1182250, 1182251) */
               AND pickslip_booked.status IN (
                                                                           6    /* partly booked */
                                                                          ,7   /* partly cancelled */
                                                                          ,9 /* closed  */
                                                                         ) 
               AND pickslip_header.receiver='@VAR.v01_receiver@'
               AND (pickslip_header.projectno='@VAR.v02_projectno@' OR '@VAR.v02_projectno@' IS NULL)
               AND (pickslip_header.remarks='@VAR.v03_remarks@' OR '@VAR.v03_remarks@' IS NULL)
               AND (pickslip_header.planned_date&gt;=@VAR.v04_planned_start_date_from@ OR @VAR.v04_planned_start_date_from@=0)
               AND (pickslip_header.planned_date&lt;=@VAR.v05_planned_start_date_to@ OR @VAR.v05_planned_start_date_to@=0)
               AND (pickslip_header.planned_end_date&gt;=@VAR.v06_planned_end_date_from@ OR @VAR.v06_planned_end_date_from@=0)
               AND (pickslip_header.planned_end_date&lt;=@VAR.v07_planned_end_date_to@ OR @VAR.v07_planned_end_date_to@=0) 
ORDER BY pickslipno, recno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
