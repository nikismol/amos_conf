      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="moc_daily_records.dailyrecno_i as Event" id="Event"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="moc_daily_records.header as header" id="header"/>
