      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
aircraft.ac_typ,
rotables.ac_registr,
rotables.partno,
rotables.serialno,
part.description,
wo_header.event_perfno_i,
desc_text.ws_text||' ; '||act_text.wa_text AS content,
od_header.orderno,
CASE WHEN history.vm IN ('YE', 'ME') OR history.vm IN ('MO', 'SW', 'PN') AND history.qty&lt;0
                        THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (history.del_date+729), 'dd-Mon-yyyy', 'NLS_DATE_LANGUAGE = ENGLISH') ELSE '' END as pn_date_on,
              CASE WHEN history.vm IN ('YA', 'MA') OR history.vm IN ('MO', 'SW', 'PN') AND history.qty&gt;0
                        THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (history.del_date+729), 'dd-Mon-yyyy', 'NLS_DATE_LANGUAGE = ENGLISH') ELSE '' END as pn_date_off,
            history.ac_registr AS history_aircraft
FROM rotables
LEFT JOIN part on rotables.partno = part.partno
LEFT JOIN aircraft on rotables.ac_registr = aircraft.ac_registr
LEFT JOIN position on rotables.locid_pk = position.locid_pk
LEFT JOIN wo_header ON rotables.serialno = wo_header.comp_serialno AND wo_header.type &lt;&gt; 'PD'
LEFT JOIN		(			
				SELECT 
					 od_header.orderno 
					,od_detail.serialno
				FROM od_header
				LEFT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
				WHERE od_header.order_type = 'R'
			) od_header ON rotables.serialno = od_header.serialno
LEFT JOIN 	(
				SELECT workstep_link.event_perfno_i as event_perfno_i,
				RTRIM(XMLAGG(XMLELEMENT(E, wo_text_action.text, ';').EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as wa_text
				FROM workstep_link
				LEFT JOIN wo_text_description ON workstep_link.descno_i = wo_text_description.descno_i
				LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i = wo_text_action.workstep_linkno_i
				GROUP BY workstep_link.event_perfno_i
			) act_text ON wo_header.event_perfno_i = act_text.event_perfno_i
LEFT JOIN 	(
				SELECT workstep_link.event_perfno_i as event_perfno_i,
				RTRIM(XMLAGG(XMLELEMENT(E, wo_text_description.text, ';').EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as ws_text
				FROM workstep_link
				LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
				GROUP BY workstep_link.event_perfno_i
			) desc_text ON wo_header.event_perfno_i = desc_text.event_perfno_i
LEFT JOIN history ON rotables.psn = history.psn AND history.vm IN ('YE', 'YA', 'ME', 'MA')
WHERE 
(
rotables.partno LIKE 'D0%' OR
rotables.partno LIKE 'D52%' OR 
rotables.partno LIKE 'D53%' OR 
rotables.partno LIKE 'D54%' OR 
rotables.partno LIKE 'D55%' OR 
rotables.partno LIKE 'D57%' OR 
rotables.partno LIKE 'E52%' OR 
rotables.partno LIKE 'E53%' OR 
rotables.partno LIKE 'E54%' OR 
rotables.partno LIKE 'E55%' OR 
rotables.partno LIKE 'E57%' OR 
rotables.partno LIKE '642-100%' OR
rotables.partno LIKE '642-300%' OR
rotables.partno LIKE '642-380%' OR
rotables.partno LIKE '642-400%' 
)
AND (REGEXP_LIKE(rotables.ac_registr, REPLACE('@VAR.AC_REGISTR@', ', ', '|')) OR '@VAR.AC_REGISTR@' IS NULL)
AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.AC_TYP@', ', ', '|')) OR '@VAR.AC_TYP@' IS NULL)
AND rotables.ac_registr IS NOT NULL
AND aircraft.status &lt;&gt; 9
Order by aircraft.ac_typ,
rotables.ac_registr</se:textStatement>
        </se:sqlStatement>
