      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT wp_header.wpno,
              wp_header.description, 
              wp_header.ac_typ,
              wp_sequence.seqno_i,
              msc_taskcard.taskcardno,
              msc_taskcard.title,
              wo_header.mech_sign as closing_sign,
              sign.department as closing_department,
              TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.closing_date+729), 'DD.MM.YYYY') as closing_date,
              DECODE (plan_time.plan/60,
                                null, 0,
                                plan_time.plan/60) planned,
              DECODE (plan_time.plan,
                                null, '00:00',
                                TO_CHAR(trunc(sysdate) + (plan_time.plan)/24/60,
                                'hh24:mi')) as planned_time,
              DECODE (time_cap.mhrs/60,
                                null, 0,
                                time_cap.mhrs/60) booked,
              DECODE (time_cap.mhrs,
                                null, '00:00',
              TO_CHAR(trunc(sysdate) + (time_cap.mhrs)/24/60, 'hh24:mi')) as booked_time,
              time_cap.department as perf_department,
              	tc_threshold.threshold as threshold,
	tc_interval.interval as interval,
	aircraft.ac_model
FROM wp_header
LEFT JOIN wp_assignment ON wp_header.wpno_i = wp_assignment.wpno_i     
LEFT JOIN wo_header ON  wo_header.event_perfno_i = wp_assignment.event_perfno_i      
LEFT JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i     
LEFT JOIN wp_sequence ON wp_sequence.event_perfno_i = wo_header.event_perfno_i and wp_sequence.wpno_i = wp_header.wpno_i
LEFT JOIN msc_requirement_tc_link ON msc_requirement_tc_link.req_linkno_i=wo_event_link.event_key_parent 
LEFT JOIN msc_taskcard_version ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri
LEFT JOIN msc_taskcard ON msc_taskcard.taskcardno_i = msc_taskcard_version.taskcardno_i 
LEFT JOIN (
                   SELECT SUM(time_captured.duration*time_captured.prod_factor) as mhrs,
                                time_captured.primkey,
                                sign.department
                   FROM time_captured
                   LEFT JOIN sign ON sign.user_sign=time_captured.user_sign
                   WHERE time_captured.mime_type = 'MET'
                                AND sign.department IN ('50083960')
                                AND time_captured.end_date&gt;='@VAR.from@'
                                AND time_captured.end_date&lt;='@VAR.to@'
                   GROUP BY time_captured.primkey, sign.department
                  ) time_cap ON time_cap.primkey = wo_header.event_perfno_i  
LEFT JOIN (
                   SELECT SUM(rm_resource_requirement.total_hours) as plan,
                                 workstep_link.event_perfno_i as perfno_i  
                   FROM rm_resource_requirement
                   LEFT JOIN rm_resource_request ON rm_resource_request.resource_request_noi = rm_resource_requirement.resource_request_noi
                   LEFT JOIN workstep_link ON workstep_link.descno_i = rm_resource_request.request_owner_amos_key
                   GROUP BY workstep_link.event_perfno_i
                  ) plan_time ON plan_time.perfno_i = wo_header.event_perfno_i
LEFT JOIN sign ON sign.user_sign = wo_header.mech_sign
LEFT JOIN (
                    SELECT msc_taskcard_version.taskcard_verno_i,
                                 LISTAGG ('T:'
                                                   ||CASE WHEN treq_interval.amount_interval='-1' THEN treq_interval.due_at ELSE treq_interval.amount_interval END
                                                   ||' '
                                                   ||CASE WHEN treq_interval.counter_defno_i='1' THEN 'FH'
                                                                  WHEN treq_interval.counter_defno_i='2' THEN 'FC'
                                                                  WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                  WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='D' THEN 'DY'
                                                                  WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='H' THEN 'HRS'
                                                                  WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='MT' THEN 'MO'
                                                                  WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='YR' THEN 'YE'
                                                                  WHEN treq_interval.counter_defno_i='101' THEN 'AH'
                                                                  WHEN treq_interval.counter_defno_i='102' THEN 'AC'
                                                                  ELSE ''
                                                       END, CHR(10)
                                                      ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as threshold
                    FROM msc_taskcard_version
                    JOIN msc_item ON msc_taskcard_version.taskcard_verno_i = msc_item.taskcard_verno_i
                    JOIN requirement_header ON requirement_header.event_key = msc_item.itemno_i AND (requirement_header.event_type = 'TI')
                    JOIN treq_time_requirement  ON requirement_header.requirement_headerno_i=treq_time_requirement.event_key AND treq_time_requirement.event_type = 'REQH'
                                                                                                                                                                                                                        AND treq_time_requirement.type = 'OP'
                                                                                                                                                                                                                        AND treq_time_requirement.status = 0
                    JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
                    JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i=treq_dimension_group.interval_groupno_i
                    JOIN treq_interval ON treq_interval.dimension_groupno_i=treq_dimension_group.dimension_groupno_i AND treq_interval.dimension_type IN ('W', 'B')
                    WHERE 1=1
                    GROUP BY msc_taskcard_version.taskcard_verno_i
                  ) tc_threshold ON msc_taskcard_version.taskcard_verno_i=tc_threshold.taskcard_verno_i
LEFT JOIN (
                    SELECT msc_taskcard_version.taskcard_verno_i,
                                  LISTAGG ('I:'
                                                    ||treq_interval.amount_interval
                                                    ||' '
                                                    ||CASE WHEN treq_interval.counter_defno_i='1' THEN 'FH'
                                                                   WHEN treq_interval.counter_defno_i='2' THEN 'FC'
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='D' THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='H' THEN 'HRS'
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='MT' THEN 'MO'
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='YR' THEN 'YE'
                                                                   WHEN treq_interval.counter_defno_i='101' THEN 'AH'
                                                                   WHEN treq_interval.counter_defno_i='102' THEN 'AC'
                                                                   ELSE '' 
                                                          END, CHR(10)
                                                      ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as interval
                    FROM msc_taskcard_version
                    JOIN msc_item ON msc_taskcard_version.taskcard_verno_i = msc_item.taskcard_verno_i
                    JOIN requirement_header ON requirement_header.event_key = msc_item.itemno_i AND (requirement_header.event_type = 'TI')
                    JOIN treq_time_requirement  ON requirement_header.requirement_headerno_i=treq_time_requirement.event_key AND treq_time_requirement.event_type = 'REQH'
                                                                                                                                                                                                                        AND treq_time_requirement.type = 'OP'
                                                                                                                                                                                                                        AND treq_time_requirement.status = 0
                    JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
                    JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i=treq_dimension_group.interval_groupno_i
