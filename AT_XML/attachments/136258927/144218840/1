      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT      wo_header.ac_registr as ac_registr
            ,wo_header.event_perfno_i as event_perfno_i
            ,part_forecast.display_event_type as event_type
            ,part_forecast.event_display as event_display
            ,part_request_2.partno as partno
            ,part.description as part_description
            , DECODE(part.mat_type, 'CONS', 'CONSUMABLES',
                                    'EQUI', 'EQUIPMENT',
                                    'FLMB', 'FLAMMABLE LIQUIDS',
                                    'GREA', 'SPECIAL GREASE',
                                    'KIT', 'KIT',
                                    'LIQU', 'SPECIAL LIQUIDS',
                                    'N', 'NON AIRCRAFT MATERIAL',
                                    'P', 'AIRCRAFT PART',
                                    'RM', 'RAW MATERIAL',
                                    'S', 'SERVICE',
                                    'SW', 'SOFTWARE',
                                    'T', 'TOOL',
                                    'ZSOD', 'SPECIAL PROTECTIVE EQUIPMENT') as mat_type
            ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (forecast.expected_date + 729), 'DD.MM.YYYY') as expected_date
            ,CASE WHEN forecast.date_planned IS NULL OR forecast.date_planned=0 THEN '' ELSE TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (forecast.date_planned + 729), 'DD.MM.YYYY') END as date_planned
            ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (part_request_2.created_date + 729), 'DD.MM.YYYY') as part_requiest_date
            ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (part_request_2.mutation + 729), 'DD.MM.YYYY') as part_request_mutation_date
            ,part_request_2.qty as part_request_qty
            ,(SELECT SUM(part_forecast.requested_qty)
              FROM part_forecast
              WHERE part_forecast.partno=part_request_2.partno
                           AND (part_forecast.part_request_part_cond &lt;&gt; 'US' OR part_forecast.part_request_part_cond IS NULL)) as total_qty
            ,part_forecast.accessable_system_qty as on_stock_qty
            ,rotables.rot_station||' '||(CASE 
                                                WHEN alt_rot.alt_rot_station IS NULL 
                                                THEN ' ' 
                                                ELSE ' Alternative parts:'||alt_rot.alt_rot_station
                                                END)||consumables.cons_station||(CASE 
                                                                                        WHEN alt_cons.alt_cons_station IS NULL
                                                                                        THEN ' '
                                                                                        ELSE ' Alternative parts:'||alt_cons.alt_cons_station
                                                                                        END) AS itog_con_station
            ,TO_NUMBER(od_detail.backorder) as ordered
            ,part_forecast.total_order_qty as total_ordered
            ,od_header.orderno as linked_orderno
            ,DECODE (od_header.ext_state,   'IC', 'INCOMPLETE',
                                        'O', 'OPEN',
                                        'PR', 'PARTLY RECEIVED',
                                        'PB', 'PARTLY BOOKED',
                                        'B', 'BOOKED',
                                        'R', 'RECEIVED',
                                        'C', 'CLOSED',
                                        'CA', 'CANCELLED',
                                        'BO', 'BOOKED/OPEN',
                                        'T', 'TEMPORARY',
                                        'D', 'DRAFT',
                                        'PC', 'PARTLY CLOSED',
                                        'UK', 'UNKNOWN'
                    ) as order_state
            ,CASE WHEN od_detail.confirmed_date IS NULL OR od_detail.confirmed_date=0 THEN '' ELSE TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_detail.confirmed_date + 729), 'DD.MM.YYYY') END as confirmed_date
            ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_header.orderdate + 729), 'DD.MM.YYYY') as orderdate
            ,CASE WHEN part.reorder IN ('F', 'H') THEN TO_NUMBER(part.reord_level) ELSE TO_NUMBER('') END as reord_level
            ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (part.created_date + 729), 'DD.MM.YYYY') as part_created_date
            ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (part.mutation + 729), 'DD.MM.YYYY') as part_mutation_date 
FROM wo_header
JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key AND part_request_2.status = '0'
LEFT JOIN part ON part_request_2.partno=part.partno
/*Ищем станции для партийников rotable*/
LEFT JOIN   (
                        SELECT  rotables.partno,
                                LISTAGG(location.station||'-'||TO_NUMBER(rotables.fa_qty),', ') WITHIN GROUP (ORDER BY location.station) AS rot_station
                        FROM rotables
                        LEFT JOIN location ON rotables.locationno_i = location.locationno_i
                        WHERE   rotables.fa_qty &gt; 0
                        AND location.location_type &gt;= '0'
                        AND (rotables.condition &lt;&gt; 'US' OR rotables.condition IS NULL)
                        GROUP BY rotables.partno
                        
            ) rotables ON part_request_2.partno = rotables.partno
/*Ищем станции для альтернативных партийников rotable*/            
LEFT JOIN   (
                        SELECT  rotables.partno,
                                LISTAGG(location.station||'-'||TO_NUMBER(rotables.fa_qty),', ') WITHIN GROUP (ORDER BY location.station) AS alt_rot_station,
                                part_alternate.altpartno
                        FROM rotables
                        LEFT JOIN location ON rotables.locationno_i = location.locationno_i
                        LEFT JOIN part_alternate ON rotables.partno = part_alternate.partno
                        WHERE   rotables.fa_qty &gt; 0
                        AND location.location_type &gt;= '0'
                        AND (rotables.condition &lt;&gt; 'US' OR rotables.condition IS NULL)
                        GROUP BY rotables.partno, part_alternate.altpartno
                        
            ) alt_rot ON part_request_2.partno = alt_rot.altpartno

/* OLD - Ищем станции для партийников consumables*/
/*LEFT JOIN   (
                        SELECT  consumables.partno,
                                LISTAGG(location.station||'-'||TO_NUMBER(SUM(consumables.qty)),', ') WITHIN GROUP (ORDER BY location.station) AS cons_station
                        FROM consumables
                        LEFT JOIN location ON consumables.locationno_i = location.locationno_i
                        WHERE   consumables.qty &gt; 0
                        AND location.location_type &gt;= '0'
                        AND (consumables.condition &lt;&gt; 'US' OR consumables.condition IS NULL)
                        GROUP BY consumables.partno
            ) consumables ON part_request_2.partno = consumables.partno */


/* NEW - Ищем станции для партийников consumables*/
LEFT JOIN (
                   SELECT partno,
                                 LISTAGG(station||'-'||TO_NUMBER(qty),', ') WITHIN GROUP (ORDER BY station) AS cons_station
                   FROM (
                                SELECT consumables.partno,
                                              location.station,
                                              TO_NUMBER(SUM(consumables.qty)) as qty
                                FROM consumables
                                JOIN location ON consumables.locationno_i = location.locationno_i 
                                JOIN condition ON consumables.condition = condition.condition
                                WHERE 1=1
                                              AND location.location_type &lt;&gt; -200
                                              AND consumables.qty &gt; 0
                                              AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                                GROUP BY consumables.partno, location.station
                               )    
                   GROUP BY partno            
                   ) consumables ON part_request_2.partno = consumables.partno

/*Ищем станции для альтернативных партийников consumables*/
LEFT JOIN   (
                        SELECT  consumables.partno,
                                LISTAGG(location.station||'-'||TO_NUMBER(consumables.qty),', ') WITHIN GROUP (ORDER BY location.station) AS alt_cons_station,
                                part_alternate.altpartno
                        FROM consumables
                        LEFT JOIN location ON consumables.locationno_i = location.locationno_i
                        LEFT JOIN part_alternate ON consumables.partno = part_alternate.partno
                        WHERE   consumables.qty &gt; 0
                        AND location.location_type &gt;= '0'
                        AND (consumables.condition &lt;&gt; 'US' OR consumables.condition IS NULL)
                        AND part_alternate.type = 'A'
                        GROUP BY consumables.partno,part_alternate.altpartno
                        
            ) alt_cons ON part_request_2.partno = alt_cons.altpartno
LEFT JOIN part_forecast ON part_request_2.part_requestno_i=part_forecast.part_requestno_i
LEFT JOIN allocation_link ON allocation_link.source_key=part_request_2.part_requestno_i AND allocation_link.source_type = 'PARTRQST'
LEFT JOIN od_detail ON allocation_link.ref_key=od_detail.detailno_i AND allocation_link.ref_type = 'ORDER_DE'
LEFT JOIN od_header ON od_detail.orderno_i=od_header.orderno_i
LEFT JOIN forecast ON wo_header.event_perfno_i=forecast.event_perfno_i
WHERE part_request_2.event_type = 'WSL'
               AND (REGEXP_LIKE(wo_header.ac_registr, REPLACE('@VAR.ac_registr@', ', ', '|')) OR '@VAR.ac_registr@' IS NULL)
               AND (aircraft.ac_typ = '@VAR.v02_ac_typ@' OR '@VAR.v02_ac_typ@' = 'ALL')
               AND (wo_header.type IN ('P', 'C', 'M') AND '@VAR.excl_sched@'='Y' OR '@VAR.excl_sched@'='N')
ORDER BY forecast.expected_date</se:textStatement>
