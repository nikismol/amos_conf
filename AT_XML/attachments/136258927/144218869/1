      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT aircraft.ac_typ as ac_typ,
              aircraft.ac_registr as ac_registr,
              wp_header.wpno as wpno,
              wo_header.ata_chapter as ata_chapter,
              DECODE(wo_header.type,
                               'M', 'Maint. WO',
                               'C', 'Cabin WO',
                               'P', 'Pirep WO',
                               'S', DECODE (wo_header.event_type,
                                                      'D', 'Document',
                                                      'R', 'Rotable Requirement',
                                                      'C', 'Check',
                                                      'T', 'Block Taskcard',
                                                      'Q', 'Single Running / On Demand Taskcard',
                                                      'V', 'Replacement Event',
                                                      'E', 'Change Order',
                                                      'O', 'Event Tracking WO', 
                                                      'SV', 'Shop Visit WO',
                                                      'SC', 'Sim. Complaint WO', 
                                                      'W', 'Finding WO',
                                                      'I', 'Import WO',
                                                      'P', 'Panel Workorder',
                                                      'J', 'JIC Workorder',
                                                      'TW', 'Unlinked Work Template',
                                                      'JC', 'Jobcard',
                                                      'CD', 'Customer Requirement - Document',
                                                      'CC', 'Customer Requirement - Check',
                                                      'CT', 'Customer Requirement - Task',
                                                      'CP', 'Customer Requirement - Part',
                                                      'Sched. WO'
                                                      ),
                               DECODE (wo_header.event_type,
                                                      'D', 'Document',
                                                      'R', 'Rotable Requirement',
                                                      'C', 'Check',
                                                      'T', 'Block Taskcard',
                                                      'Q', 'Single Running / On Demand Taskcard',
                                                      'V', 'Replacement Event',
                                                      'E', 'Change Order',
                                                      'O', 'Event Tracking WO', 
                                                      'SV', 'Shop Visit WO',
                                                      'SC', 'Sim. Complaint WO', 
                                                      'W', 'Finding WO',
                                                      'I', 'Import WO',
                                                      'P', 'Panel Workorder',
                                                      'J', 'JIC Workorder',
                                                      'TW', 'Unlinked Work Template',
                                                      'JC', 'Jobcard',
                                                      'CD', 'Customer Requirement - Document',
                                                      'CC', 'Customer Requirement - Check',
                                                      'CT', 'Customer Requirement - Task',
                                                      'CP', 'Customer Requirement - Part',
                                                      ''
                                                      )
                               ) as event_type,
	NVL(wo_event_link.event_name, wo_header.event_perfno_i) as event_name,
              wo_event_link.event_display as event_display,
              CASE WHEN wo_event_link.event_type = 'TCEFFLI' THEN event_template.mutator||' ('||(SELECT firstname||' '||lastname FROM sign WHERE user_sign = event_template.mutator)||')'
                        ELSE ''
              END as wt_mutator,
              wo_header.created_by||' ('||(SELECT firstname||' '||lastname FROM sign WHERE user_sign = wo_header.created_by)||')' as event_created_by,
              wo_header.event_perfno_i as event_perfno_i,
              TO_CHAR(TRUNC(TO_DATE('31.12.1971', 'DD.MM.YYYY') + wp_history.action_date) + (action_time/24/60), 'DD.MM.YYYY HH24:MI') as deassigning_time
FROM (/*выбираю пакеты, закрытые за прошедшие 24 часа */
             SELECT DISTINCT bohi_version.primkey
             FROM bohi_changes
             JOIN bohi_version ON bohi_changes.versionno_i =  bohi_version.versionno_i AND bohi_version.mime_type = 'WP'
             WHERE 1=1
                           AND bohi_changes.changes_date * 24 * 60 + bohi_changes.changes_time &gt;= (FLOOR(sysdate-to_date('19711231','yyyymmdd'))*24*60 + TO_CHAR(SYSTIMESTAMP, 'SSSSS')/60) - 1440
                           AND bohi_changes.changes LIKE '%&lt;newValue&gt;-2&lt;/newValue&gt;%'
                           AND bohi_changes.action = 'Modified Workpackage'
           ) wp
JOIN wp_header ON wp_header.wpno_i = wp.primkey AND wp_header.wp_status = -2

/* получаю работы, которые исключили из пакета */
JOIN wp_history ON wp_history.wpno_i = wp_header.wpno_i 
JOIN aircraft ON wp_header.ac_registr = aircraft.ac_registr
LEFT JOIN wo_header ON wp_history.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i

/*проверияю, что работу не включили в пакет обработно */
LEFT JOIN wp_assignment ON wp_assignment.wpno_i = wp_header.wpno_i AND wo_header.event_perfno_i = wp_assignment.event_perfno_i

/* выгружаю данные по worktemplate для taskcard */
LEFT JOIN msc_requirement_tc_link ON wo_event_link.event_key_parent = msc_requirement_tc_link.req_linkno_i AND wo_event_link.event_type = 'TCEFFLI'
LEFT JOIN msc_requirement_tc_link ON wo_event_link.event_key_parent = msc_requirement_tc_link.req_linkno_i AND wo_event_link.event_type = 'TCEFFLI'
LEFT JOIN requirement_header ON msc_requirement_tc_link.itemno_i_mri=requirement_header.event_key AND requirement_header.event_type = 'TI'
LEFT JOIN worktemplate_link ON worktemplate_link.event_key = requirement_header.requirement_headerno_i AND worktemplate_link.event_type = 'REQH'
LEFT JOIN work_template ON worktemplate_link.wtno_i=work_template.wtno_i
LEFT JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i AND event_template.revision_status=1

WHERE 1=1
               AND aircraft.ac_typ  = '@VAR.v01_ac_typ@'                 
               AND (
                              (NOT REGEXP_LIKE(wo_header.ata_chapter, '^(53|54|55|57|7[0-9]|80)') AND  '@VAR.v02_not_ata@'='Y')  
                              OR 
                              (REGEXP_LIKE(wo_header.ata_chapter, '^(7[0-9]|80)')  and '@VAR.v03_ata1@'='Y')
                              OR
                              (REGEXP_LIKE(wo_header.ata_chapter, '^(52|53|54|55|57|78)')  and '@VAR.v04_ata2@'='Y')
                              OR
                              (REGEXP_LIKE(wo_header.ata_chapter, '^(23|25|44)')  and '@VAR.v05_ata3@'='Y')
                         )
               AND wo_header.event_type = 'D'
               AND wo_header.event_perfno_i IS NOT NULL
               AND wp_history.action_type = 'D'
               AND wp_assignment.event_perfno_i IS NULL
ORDER BY 1, 2, 3, 4, 5, 6, 7</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
