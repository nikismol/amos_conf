      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select mpno,
       mp_revision,
       taskcardno,
       task_revision,
       DECODE(tc_type,
              'O', 'On-demand',
              'B', 'Block',
              'S', 'SRT',
              'T', 'Taskcard Controlled',
              'C', 'Check Controlled',
              'R', 'Rotable Controlled',
              'D', 'Document Controlled',
              tc_type) as tc_type,
       SUM(is_performed) as performed_times,
       SUM(release_station_svo) as performed_times_in_svo,
       LISTAGG(DISTINCT release_station, ', ') WITHIN GROUP (ORDER BY release_station) as release_stations,
       SUM(release_by_afl) as release_by_afl,
       SUM(release_by_vendor) as release_by_vendor,
       CASE WHEN tc_type = 'O' THEN NULL
            ELSE to_char(to_date('31.12.1971', 'dd.mm.yyyy') + MIN(next_perf_date),'dd.mm.yyyy')
       END as next_perf_date
 from (
        select msc_maintenance_program.mpno,
               msc_mp_revision.revision_no as mp_revision,
               msc_taskcard.taskcardno,
               msc_taskcard_version.revision_no as task_revision,
               aircraft.ac_typ as ac_typ,
               aircraft.ac_registr,
               msc_taskcard_version.single_running as tc_type,
               wo_header.state as wo_state,
               CASE WHEN wo_event_link.pending_status &lt; 0 OR wo_header.state = 'C' THEN 1 ELSE 0 END as is_performed,
               CASE WHEN wo_header.release_station = 'SVO' THEN 1 ELSE 0 END as release_station_svo,
               wo_header.release_station as release_station,
               CASE WHEN wo_event_link.pending_status = 0 THEN (LEAST(DECODE(forecast.date_planned, 0, 999999, forecast.date_planned), forecast.expected_date))  ELSE 999999999 END as next_perf_date,
               CASE WHEN wp_header.maintprov_address = 'AFL' THEN 1 ELSE 0 END as release_by_afl,
               CASE WHEN wp_header.maintprov_address = '@VAR.v02_vendor@' THEN 1 ELSE 0 END as release_by_vendor /* TODO: вендора задавать через перменную */
         
        FROM msc_taskcard
        JOIN msc_taskcard_version ON msc_taskcard.taskcardno_i = msc_taskcard_version.taskcardno_i
        JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i
        JOIN msc_mp_revision ON msc_mprev_taskcards.revisionno_i = msc_mp_revision.revisionno_i
        JOIN msc_mp_issue ON msc_mp_revision.issueno_i = msc_mp_issue.issueno_i
        JOIN msc_maintenance_program ON msc_mp_issue.mpno_i = msc_maintenance_program.mpno_i
                                        and msc_taskcard.mpno_i=msc_maintenance_program.mpno_i
                                        --and msc_maintenance_program.mpno IN (:ac_typ)
                                        and msc_maintenance_program.program_type='MP'
        join msc_requirement_tc_link on msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
                                                                        AND (msc_requirement_tc_link.mpno_i_operator=6 AND msc_maintenance_program.mpno='B737' 
                                                                        OR msc_requirement_tc_link.mpno_i_operator=7 AND msc_maintenance_program.mpno='B777'
                                                                        OR msc_requirement_tc_link.mpno_i_operator=8 AND msc_maintenance_program.mpno='RRJ'
                                                                        OR msc_requirement_tc_link.mpno_i_operator=9 AND msc_maintenance_program.mpno='A32S'
                                                                        OR msc_requirement_tc_link.mpno_i_operator=10 AND msc_maintenance_program.mpno='A330'
                                                                        OR msc_requirement_tc_link.mpno_i_operator=407 AND msc_maintenance_program.mpno='A350')
        join wo_event_link on wo_event_link.event_key_root = msc_requirement_tc_link.req_link_headerno_i
                              and wo_event_link.event_type = 'TCEFFLI'
                              and wo_event_link.pending_status &lt;= 0
        join wo_header on wo_event_link.event_perfno_i = wo_header.event_perfno_i
        join aircraft on wo_header.ac_registr=aircraft.ac_registr and aircraft.status &lt;&gt; 9
        left join wo_transfer on wo_transfer.event_perfno_i=wo_event_link.event_perfno_i and wo_transfer.is_last_transfer='Y' 
        left join forecast on forecast.event_perfno_i=wo_event_link.event_perfno_i
        LEFT JOIN wp_assignment ON wo_event_link.event_perfno_i = wp_assignment.event_perfno_i AND wo_event_link.pending_status &lt; 0
        LEFT JOIN wp_header ON wp_assignment.wpno_i = wp_header.wpno_i
        where 1=1
              and msc_mp_revision.revision_status IN ('a', 'b')
              and msc_maintenance_program.mpno_i='@VAR.v01_mpno@'
              
        ) 
 where 1=1
 GROUP BY mpno,
          mp_revision,
          taskcardno,
          task_revision,
          tc_type
 order by mpno, tc_type, taskcardno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
