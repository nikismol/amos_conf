        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_ac_registr@">
          <ds:object>@VAR.v01_ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_ac_model@">
          <ds:object>@VAR.v02_ac_model@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_ac_typ@">
          <ds:object>@VAR.v03_ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  
	CASE WHEN REGEXP_LIKE(pat.partno, '^[0-9]+$') THEN chr(39)||pat.partno ELSE pat.partno END as partno,
	TO_NUMBER(SUM(pat.qty) * -1)  AS qty,
	pat.measure_unit as measure_unit,
	pat.mat_class as mat_class,
	pat.description as description
FROM
	(
	SELECT        
		part.partno AS partno,
		history.qty AS qty,
		part.measure_unit AS measure_unit,
		part.mat_class AS mat_class,
		part.specification AS specification,
		part.description AS description,
		history.ac_registr AS ac_registr,
		history.del_date AS del_date,
		part.ac_typ AS ac_typ
	FROM history
		JOIN part ON history.partno = part.partno
	WHERE 1=1
                            AND history.created_by != 'MIGRUSR'
		AND history.vm in ('YE')
		AND history.label_start = 'Y'
		AND part.mat_class = 'R'

	UNION ALL

	SELECT        
		part.partno AS partno,
		history.qty,
		part.measure_unit AS measure_unit,
		part.mat_class AS mat_class,
		part.specification AS specification,
		part.description AS description,
		CASE WHEN history.vm in ('AA', 'EA') THEN history.ac_registr ELSE REPLACE(costcenter.fa_costcenter, 'RA-', '') END AS ac_registr,
		history.del_date AS del_date,
 		part.ac_typ AS ac_typ
	FROM history
		JOIN part ON history.partno = part.partno
              LEFT JOIN costcenter ON history.receiver = costcenter.costcenter
	WHERE 1=1
		AND (history.vm in ('AA', 'EA')
                                       OR history.vm IN ('AS', 'ES')
                                             AND (costcenter.fa_costcenter LIKE ('VQ%')
                                                       OR costcenter.fa_costcenter LIKE ('VP%')
                                                       OR costcenter.fa_costcenter LIKE ('RA-%')
                                                      )
                                     )
		AND part.mat_class IN ('C', 'E')
	) pat
	JOIN aircraft ON pat.ac_registr=aircraft.ac_registr
WHERE 1=1
	AND pat.del_date &gt;= @VAR.v04_date_from@ /*OR '@VAR.v04_date_from@' IS NULL)*/
	AND pat.del_date &lt;= @VAR.v05_date_to@ /*OR '@VAR.v05_date_to@' IS NULL)*/
	AND (aircraft.ac_registr = '@VAR.v01_ac_registr@' OR '@VAR.v01_ac_registr@' IS NULL)
	AND (aircraft.ac_model= '@VAR.v02_ac_model@' OR '@VAR.v02_ac_model@'= 'ALL')
	AND (aircraft.ac_typ = '@VAR.v03_ac_typ@' OR '@VAR.v03_ac_typ@' = 'ALL')
GROUP BY 
	pat.partno,
	pat.measure_unit,
	pat.mat_class,
	pat.description</se:textStatement>
        </se:sqlStatement>
