    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="282_ATI_Part" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN REGEXP_LIKE(pat.partno'^[0-9]+$') THEN chr(39)||pat.partno ELSE pat.partno END as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(pat.qty) as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pat.measure_unit as measure_unit" id="measure_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pat.mat_class as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pat.description as description" id="description"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_date_from@">
          <ds:object>@VAR.v04_date_from@</ds:object>
        </ds:value>
