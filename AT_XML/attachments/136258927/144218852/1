    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="ORDERS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno AS T_OrderNumber" id="T_OrderNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.ext_state AS T_OrderStatus" id="T_OrderStatus"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.posno AS T_PositionNumber" id="T_PositionNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.ext_state AS T_Det_St" id="T_Det_St"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.partno AS T_Partno" id="T_Partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.serialno AS T_Serialno" id="T_Serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.psn AS T_psn" id="T_psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.labelno AS LabelNumber" id="LabelNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description AS PartDescription" id="PartDescription"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det2.R_OrderNumber AS R_OrderNumber" id="R_OrderNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det2.R_OrderStatus AS R_OrderStatus" id="R_OrderStatus"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det2.R_PositionNumber AS R_PositionNumber" id="R_PositionNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det2.R_Det_St AS R_Det_St" id="R_Det_St"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.TORDER@">
          <ds:object>@VAR.TORDER@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  
		 od_header.orderno AS T_OrderNumber
		,od_header.ext_state AS T_OrderStatus
		,od_detail.posno AS T_PositionNumber
		,od_detail.ext_state AS T_Det_St
		,od_detail.partno AS T_Partno
		,od_detail.serialno AS T_Serialno
		,od_detail.psn AS T_psn
		,od_detail.labelno AS LabelNumber
		,part.description AS PartDescription
		,det2.R_OrderNumber AS R_OrderNumber
		,det2.R_OrderStatus AS R_OrderStatus
		,det2.R_PositionNumber AS R_PositionNumber
		,det2.R_Det_St AS R_Det_St
FROM od_header
LEFT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
LEFT JOIN		(			
				SELECT 
					od_header.orderno AS R_OrderNumber
					,od_header.ext_state AS R_OrderStatus
					,od_detail.posno AS R_PositionNumber
					,od_detail.ext_state AS R_Det_St
					,od_detail.partno AS R_Partno
					,od_detail.serialno AS R_Serialno
					,od_detail.psn AS R_psn
				FROM od_header
				LEFT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
				WHERE   od_header.order_type != 'T'
				AND od_header.ext_state IN ('D', 'O') 
				ORDER BY od_header.orderno, od_detail.posno 
			) det2 ON od_detail.partno = det2.R_partno AND det2.R_Serialno = od_detail.serialno
LEFT JOIN part ON od_detail.partno = part.partno
LEFT JOIN address ON od_header.vendor = address.vendor
LEFT JOIN sh_detail ON od_detail.detailno_i = sh_detail.od_detailno_i
LEFT JOIN sh_header ON sh_detail.shipmentno_i = sh_header.shipmentno_i
LEFT JOIN sign ON od_header.created_by = sign.user_sign
WHERE   
od_header.orderno = '@VAR.TORDER@'
AND det2.R_OrderNumber IS NULL
ORDER BY od_header.orderno, od_detail.posno</se:textStatement>
