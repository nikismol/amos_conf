    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="198_AlternativePNWithDiffUnits" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>main DS</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(order by p.partno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="x.partno" id="x.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when p2.mat_class = 'R'&#10;                then 'Rotable' &#10;            when p2.mat_class = 'C'&#10;                then 'Consumable' &#10;            when p2.mat_class = 'E'&#10;                then 'Expendable'&#10;            when p2.mat_class ='S'&#10;                then 'Service'&#10;      else p2.mat_class&#10;      end mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mu.description" id="mu.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="altpartno" id="altpartno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when p2.mat_class = 'R'&#10;                then 'Rotable' &#10;            when p2.mat_class = 'C'&#10;                then 'Consumable' &#10;            when p2.mat_class = 'E'&#10;                then 'Expendable'&#10;            when p2.mat_class ='S'&#10;                then 'Service'&#10;      else p2.mat_class &#10;      end mat_class_2" id="mat_class_2"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mu2.description" id="mu2.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="way" id="way"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select row_number() over(order by p.partno) num
     , x.partno
     , case when p.mat_class = 'R'
                then 'Rotable' 
            when p.mat_class = 'C'
                then 'Consumable' 
            when p.mat_class = 'E'
                then 'Expendable'
            when p.mat_class ='S'
                then 'Service'
      else p.mat_class
      end mat_class
     , mu.description
     , altpartno
     , case when p2.mat_class = 'R'
                then 'Rotable' 
            when p2.mat_class = 'C'
                then 'Consumable' 
            when p2.mat_class = 'E'
                then 'Expendable'
            when p2.mat_class ='S'
                then 'Service'
      else p2.mat_class 
      end mat_class_2
     , mu2.description
     , way
  from (
        select partno
             , altpartno
             , ' &lt;-&gt; ' way
          from ( 
                select a.partno
                     , a.altpartno
                     , b.partno p2
                     , b.altpartno a2
                     , p.partseqno_i seq_a
                     , p2.partseqno_i seq_p
                  from part_alternate a
                  join part_alternate b on a.altpartno = b.partno 
                                       and b.altpartno = a.partno
                  join part p on a.partno = p.partno
                  join part p2 on b.partno = p2.partno
                 where b.partno is not null
                   and ( p2.partno is null or p.partseqno_i &lt; p2.partseqno_i)
                ) a
         union
        select a.partno
             , a.altpartno
             , ' -&gt; ' way
          from part_alternate a
          left join part_alternate b on a.altpartno = b.partno
         where b.partno is null
       ) x
  join part p on x.partno = p.partno
  join measure_unit mu on p.measure_unit = mu.measure_unit
  join part p2 on x.altpartno = p2.partno
  join measure_unit mu2 on p2.measure_unit = mu2.measure_unit
 where p.measure_unit &lt;&gt; p2.measure_unit</se:textStatement>
        </se:sqlStatement>
