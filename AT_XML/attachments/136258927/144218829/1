      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT (aircraft.ac_typ) as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.serialno as msn" id="msn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_l.partno as partno_l" id="partno_l"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_l.serialno as serialno_l" id="serialno_l"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_l.tah as tah_l" id="tah_l"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_l.tac as tac_l" id="tac_l"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_l.mfg_date as mfg_date_l" id="mfg_date_l"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (left_eng.date_inst+729)'DD.MM.YYYY') as date_inst_l" id="date_inst_l"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_r.partno as partno_r" id="partno_r"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_r.serialno as serialno_r" id="serialno_r"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_r.tah as tah_r" id="tah_r"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_r.tac as tac_r" id="tac_r"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_r.mfg_date as mfg_date_r" id="mfg_date_r"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (right_eng.date_inst+729)'DD.MM.YYYY') as date_inst_r" id="date_inst_r"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;row_number() over (ORDER BY aircraft.ac_typaircraft.serialno) as num" id="num"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT aircraft.ac_typ as ac_typ,
              aircraft.serialno as msn,
              aircraft.ac_registr as ac_registr,
              left_eng.partno as partno_l,
              left_eng.serialno as serialno_l,

              (select
                            case when amosserver_prod.calculate_installed_rotables_tam(left_eng.psn)='Unknown'
                                      then 'Unknown'
                                      else TO_CHAR(CEIL(TO_NUMBER(amosserver_prod.calculate_installed_rotables_tam(left_eng.psn))/60))
                            end
                from dual) as tah_l,

              (select
                           case when amosserver_prod.calculate_installed_rotables_tac(left_eng.psn)='Unknown'
                                     then 'Unknown'
                                     else amosserver_prod.calculate_installed_rotables_tac(left_eng.psn)
                           end
               from dual) as tac_l,

              CASE WHEN left_eng.mfg_unknown!='Y' AND left_eng.mfg_date IS NOT NULL AND left_eng.mfg_date&gt;0
                        THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (left_eng.mfg_date+729), 'DD.MM.YYYY')
                        WHEN left_eng.mfg_unknown='Y' THEN 'UNKNOWN'
                        ELSE '---'
              END as mfg_date_l,
              TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (left_eng.date_inst+729), 'DD.MM.YYYY') as date_inst_l,
              right_eng.partno as partno_r,
              right_eng.serialno as serialno_r,

              (select
                            case when amosserver_prod.calculate_installed_rotables_tam(right_eng.psn)='Unknown'
                                      then 'Unknown'
                                      else TO_CHAR(CEIL(TO_NUMBER(amosserver_prod.calculate_installed_rotables_tam(right_eng.psn))/60))
                            end
                from dual) as tah_r,

              (select
                           case when amosserver_prod.calculate_installed_rotables_tac(right_eng.psn)='Unknown'
                                     then 'Unknown'
                                     else amosserver_prod.calculate_installed_rotables_tac(right_eng.psn)
                           end
               from dual) as tac_r,
 
              CASE WHEN right_eng.mfg_unknown!='Y' AND right_eng.mfg_date IS NOT NULL AND right_eng.mfg_date&gt;0
                        THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (right_eng.mfg_date+729), 'DD.MM.YYYY')
                        WHEN right_eng.mfg_unknown='Y' THEN 'UNKNOWN'
                        ELSE '---'
              END as mfg_date_r,
              TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (right_eng.date_inst+729), 'DD.MM.YYYY') as date_inst_r,
              row_number() over (ORDER BY aircraft.ac_typ, aircraft.serialno) as num
FROM aircraft
LEFT JOIN rotables left_eng ON aircraft.ac_registr=left_eng.ac_registr AND left_eng.partno IN (SELECT partno FROM part_special WHERE special='ENGINE')
                                                                                                                                 AND (
                                                                                                                                            regexp_like(left_eng.location, 'ENG1')
                                                                                                                                            OR regexp_like(left_eng.location, '^[[:digit:]]+L')
                                                                                                                                            OR left_eng.location LIKE '%ZA0001-411%'
                                                                                                                                            OR left_eng.location LIKE '%7200-1EM720%'
                                                                                                                                            OR left_eng.location LIKE '4000EM1'
                                                                                                                                           )
LEFT JOIN rotables right_eng ON aircraft.ac_registr=right_eng.ac_registr AND right_eng.partno IN (SELECT partno FROM part_special WHERE special='ENGINE')
                                                                                                                                       AND (
                                                                                                                                                  regexp_like(right_eng.location, 'ENG2')
                                                                                                                                                  OR regexp_like(right_eng.location, '^[[:digit:]]+R')
                                                                                                                                                  OR right_eng.location LIKE '%ZB0001-421%'
                                                                                                                                                  OR right_eng.location LIKE '%7200-2EM720%'
                                                                                                                                                  OR right_eng.location LIKE '4000EM2'
                                                                                                                                                  OR right_eng.locid_pk='-15453' AND right_eng.partno='SAM146-1S17' AND right_eng.serialno='146240' 
                                                                                                                                                 )
WHERE 1=1
               AND aircraft.ac_typ IN ('A32S', 'A330', 'B737', 'B777', 'RRJ', 'A350')
               AND aircraft.status &lt;&gt; 9
ORDER BY aircraft.ac_typ, aircraft.serialno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
