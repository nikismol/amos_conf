        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (od_detail.confirmed_date+729)'dd.mm.yyyy') AS Confirmed_Date" id="Confirmed_Date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (od_detail.target_date+729)'dd.mm.yyyy') AS Target_Date" id="Target_Date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sh_header.awbno AS AWBNO" id="AWBNO"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  wo_header.event_perfno_i AS WO
        ,aircraft.ac_typ AS AC_Type
        ,wo_header.ac_registr AS AC_Registr
        ,wo_text_description.text AS First_Step
        ,wo_header.issue_station AS Station
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.issue_date+729),'dd.mm.yyyy') as Issue_Date   
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (forecast.expected_date+729),'dd.mm.yyyy') AS Due_Date
        ,part_forecast.partno AS Partno
        ,part.description AS Part
        ,part.mat_class AS Mat_Class
        ,part_special.special AS Special
        ,stockcons.consumables AS ConsStokInfo
        ,stockrota.rotables AS RotaStockInfo
        ,part2.max_purch AS Max_Purch
        ,CASE WHEN forecast.date_planned = 0 THEN ' '
            ELSE to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (forecast.date_planned+729),'dd.mm.yyyy') 
         END AS Planned_Date
        ,part_request_2.qty AS QTY
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (part_request_2.created_date+729),'dd.mm.yyyy') AS Request_Date
        ,od_header.orderno AS Order_No
        ,od_header.ext_orderno AS Ext_OrderNo
        ,address.vendor AS Vendor
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (od_detail.confirmed_date+729),'dd.mm.yyyy') AS Confirmed_Date
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (od_detail.target_date+729),'dd.mm.yyyy') AS Target_Date
        ,sh_header.awbno AS AWBNO
FROM forecast
JOIN wo_header ON forecast.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN workstep_link ON wo_header.event_perfno_i = workstep_link.event_perfno_i AND workstep_link.sequenceno ='1'
LEFT JOIN wo_text_description ON workstep_link.descno_i =  wo_text_description.descno_i
LEFT JOIN part_forecast ON wo_header.event_perfno_i = part_forecast.event_perfno_i
/*LEFT JOIN wo_transfer ON wo_header.event_perfno_i = wo_transfer.event_perfno_i AND wo_transfer.is_last_transfer = 'Y' AND wo_transfer.transfer_type IN ('T', 'E')*/
LEFT JOIN part_request_2 ON part_forecast.part_requestno_i = part_request_2.part_requestno_i
LEFT JOIN part ON part_request_2.partno = part.partno
LEFT JOIN (
    select 
        partno
        ,listagg(special, ', ') within group (order by special) as special
    from part_special
    group by partno
)part_special on part_special.partno = part.partno 
LEFT JOIN (
    select 
        partno
        ,consumables
    from(
        select
            partno
            , LISTAGG(station ||': '|| TO_CHAR(TO_NUMBER(qty),'99999999990.99'), ', ') WITHIN GROUP (ORDER BY partno) as consumables
        from(
            select 
                consumables.partno
                ,sum(consumables.qty) AS qty
                ,location.station
            from consumables
            join location on consumables.locationno_i = location.locationno_i 
            group by consumables.partno, location.station
            )
        group by partno
        )
    ) stockcons on part.partno = stockcons.partno
LEFT JOIN (
    select 
        partno
        ,rotables
    from (
        select
            partno
            ,LISTAGG(station ||': '|| TO_CHAR(TO_NUMBER(qty),'99999999990.99'), ', ') WITHIN GROUP (ORDER BY partno) as rotables
        from (
            select 
                rotables.partno
                ,location.station
                ,count(rotables.psn) as qty
            from rotables
            left join location on rotables.locationno_i = location.locationno_i
            where rotables.condition &lt;&gt; 'U/S'
                and location.locationno_i not in (-1, -4, -200)
            group by rotables.partno, location.station
            order by rotables.partno
        )
        group by partno
    )
) stockrota on part.partno = stockrota.partno
LEFT JOIN (
    select max(part.max_purch) as max_purch
    ,part_alternate.partno
    from part_alternate
    join part on part_alternate.altpartno = part.partno OR part_alternate.partno = part.partno
    group by part_alternate.partno
    )part2 on part.partno = part2.partno
LEFT JOIN od_detail ON part_request_2.partno = od_detail.partno AND od_detail.ext_state = 'O' AND od_detail.order_type in ('P', 'PR', 'Y',  'R')
LEFT JOIN od_header ON od_detail.orderno_i = od_header.orderno_i
LEFT JOIN (
    select 
        od_header.orderno_i
        , listagg(distinct address.name, ', ') within group (order by address.name) as vendor
    from od_header
    join address on od_header.vendor = address.vendor
    group by od_header.orderno_i
) address on od_header.orderno_i = address.orderno_i
LEFT JOIN sh_detail on od_detail.detailno_i = sh_detail.od_detailno_i
LEFT JOIN sh_header on sh_detail.shipmentno_i = sh_header.shipmentno_i and sh_header.type = 'EI'
WHERE
wo_header.state = 'O'
AND wo_header.type IN ('C', 'P', 'M')
AND part_forecast.status IN (1,2,3) 
AND 
(forecast.expected_date &lt;= FLOOR((SYSDATE+9) - CAST(TIMESTAMP '1971-12-31 00:00:00 UTC' AS DATE))
AND forecast.expected_date &gt;= FLOOR((SYSDATE) - CAST(TIMESTAMP '1971-12-31 00:00:00 UTC' AS DATE))
)
ORDER BY aircraft.ac_typ</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
