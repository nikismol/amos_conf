      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    wo_header.event_perfno_i AS WO
    ,wo_header_more.mel_chapter
    ,aircraft.ac_typ AS AC_Type
        ,wo_header.ac_registr AS AC_Registr
        ,wo_text_description.text AS First_Step
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.issue_date+729),'dd.mm.yyyy') as Issue_Date
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (forecast.expected_date+729),'dd.mm.yyyy') AS Due_Date
        ,part_forecast.partno AS Partno
        ,part.description AS Part
        ,part_request_2.qty AS QTY
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (part_request_2.created_date+729),'dd.mm.yyyy') AS Request_Date
        ,DECODE(part.mat_class, 'R', 'Rotable',
            'C', 'Consumable',
            'E', 'Expendable',
            'S', 'Service') as mat_class
FROM forecast
JOIN wo_header ON forecast.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wo_header_more ON wo_header.event_perfno_i=wo_header_more.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN workstep_link ON wo_header.event_perfno_i = workstep_link.event_perfno_i AND workstep_link.sequenceno ='1'
LEFT JOIN wo_text_description ON workstep_link.descno_i =  wo_text_description.descno_i
LEFT JOIN part_forecast ON wo_header.event_perfno_i = part_forecast.event_perfno_i
LEFT JOIN part_request_2 ON part_forecast.part_requestno_i = part_request_2.part_requestno_i
LEFT JOIN part ON part_request_2.partno = part.partno
WHERE wo_header.state = 'O'
AND (wo_header.type = '@VAR.v5_wo_type@' OR ('@VAR.v5_wo_type@'='ALL' and wo_header.type in ('P','M', 'C')))
AND part_forecast.status IN (1,2,3)
AND
(forecast.expected_date &gt;= '@VAR.v1_start_date@'
AND forecast.expected_date &lt;= '@VAR.v2_end_date@'
)
  AND (wo_header.mel_code = '@VAR.v6_mel_code@' OR ('@VAR.v6_mel_code@'='DD' and wo_header.hil='Y') OR ('@VAR.v6_mel_code@'='ALL'
                                                        and (wo_header.mel_code in ('A','B', 'C','D','L') or wo_header.hil='Y'))
        or ('@VAR.v6_mel_code@'='MEL' and wo_header.mel_code in ('A','B', 'C','D')) or ('@VAR.v6_mel_code@'='No Transfer' 
                                                                                            and wo_header.mel_code is null and wo_header.hil is null))
  and ((aircraft.ac_typ = 'A32S' AND (REGEXP_LIKE('A32S', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'A330' AND (REGEXP_LIKE('A330', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
       (aircraft.ac_typ = 'A350' AND (REGEXP_LIKE('A350', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'B737' AND (REGEXP_LIKE('B737', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'B777' AND (REGEXP_LIKE('B777', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
 	   (aircraft.ac_typ = 'RRJ' AND (REGEXP_LIKE('RRJ', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
       )
  AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.v4_ac_registr@', ', ', '|')) OR '@VAR.v4_ac_registr@' IS NULL)
AND part_forecast.accessable_system_qty = 0
ORDER BY aircraft.ac_typ</se:textStatement>
        </se:sqlStatement>
