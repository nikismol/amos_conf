      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT f.title,
             'Q'||TO_CHAR(p.q,'Q')||' '||EXTRACT(YEAR FROM p.q) as qrt,
             f.n,
             'Q'||TO_CHAR(p.q,'Q')||' '||EXTRACT(YEAR FROM p.q)||' '||CHR(10)||f.title as field_title,
             EXTRACT(YEAR FROM p.q) as y
FROM (
             SELECT 'unit_hours' as title, 1 as n FROM DUAL
             UNION SELECT 'us_rem' as title, 2 as n FROM DUAL
             UNION SELECT 'rate_us_rem' as title,3 as n FROM DUAL
             UNION SELECT 'failures' as title, 4 as n FROM DUAL
             UNION SELECT 'rate_fail' as title, 5 as n FROM DUAL
             UNION SELECT 'no_fault' as title, 6 as n FROM DUAL
             UNION SELECT 'mtbur' as title, 7 as n FROM DUAL
             UNION SELECT 'mttur' as title, 8 as n FROM DUAL
             UNION SELECT 'mtbf' as title, 9 as n FROM DUAL
             UNION SELECT 'nff_rate' as title, 10 as n FROM DUAL
             ORDER by n
            ) f
JOIN (
          SELECT t.p as q
          FROM (
                       SELECT beg_date + LEVEL - 1 as p
                       FROM (
                                    SELECT TO_DATE('@VAR.v01_quarter_start@', 'dd.mm.yyyy') beg_date,
                                                 TO_DATE('@VAR.v02_quarter_end@', 'dd.mm.yyyy') end_date
                                    FROM dual
                                   )
                       CONNECT BY LEVEL &lt;= end_date - beg_date + 1
                      ) t
          WHERE EXTRACT (MONTH FROM t.p) IN (1, 4, 7, 10)
                       AND t.p=TRUNC(t.p, 'MONTH')
         ) p ON 1=1
ORDER BY n, 1, y, qrt</se:textStatement>
