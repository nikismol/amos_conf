                   UNION SELECT  rel.period_start as quarter_start_date, rel.mttur as value,             8 as title_no FROM ramax_read_only.rmx_tmp_data_upload rel WHERE rel.partno = '@AFL_REL_MAIN.partno@'
                                                                                                                                                                                                                                                                                        AND rel.ac_group = '@AFL_REL_MAIN.ac_group@'
