                          p.q as quarter_start_date,
                          f.n as title_no,
                          EXTRACT(YEAR FROM p.q) as yr
             FROM (
                          SELECT 'unit_hours' as title, 1 as n FROM DUAL
                          UNION SELECT 'us_rem' as title, 2 as n FROM DUAL
                          UNION SELECT 'rate_us_rem' as title,3 as n FROM DUAL
                          UNION SELECT 'failures' as title, 4 as n FROM DUAL
                          UNION SELECT 'rate_fail' as title, 5 as n FROM DUAL
                          UNION SELECT 'no_fault' as title, 6 as n FROM DUAL
                          UNION SELECT 'mtbur' as title, 7 as n FROM DUAL
