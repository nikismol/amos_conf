    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_REL_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_group" id="ac_group"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ata" id="ata"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_partno@">
          <ds:object>@VAR.v03_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_ac_group@">
          <ds:object>@VAR.v04_ac_group@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT
          ac_group
         ,partno
         ,description
         ,ata
FROM RAMAX_READ_ONLY.RMX_TMP_DATA_UPLOAD rel
WHERE EXTRACT (MONTH FROM TO_DATE(TO_CHAR(TO_DATE(period_start,'MM.DD.YY'), 'MM.DD.YYYY'))) IN (1, 4, 7, 10)
             AND (REGEXP_LIKE(rel.partno, REPLACE('@VAR.v03_partno@', ', ', '|')) OR '@VAR.v03_partno@' IS NULL)
             AND rel.ac_group='@VAR.v04_ac_group@'
ORDER BY partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
