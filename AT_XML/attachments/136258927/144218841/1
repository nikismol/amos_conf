      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.partno" id="rotables.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.serialno" id="rotables.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.PARTNO@">
          <ds:object>@VAR.PARTNO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 	rotables.partno,
		rotables.serialno,
		part.description
FROM 		rotables
LEFT JOIN part ON rotables.partno = part.partno
WHERE rotables.pma = 'Y'
AND (REGEXP_LIKE(rotables.partno, REPLACE('@VAR.PARTNO@', ', ', '|')) OR '@VAR.PARTNO@' IS NULL)
ORDER BY rotables.partno, rotables.serialno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
