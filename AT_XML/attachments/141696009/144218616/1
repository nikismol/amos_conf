    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_PPCDSP_WPS" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.wpno" id="wph.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.wpno_i" id="wph.wpno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.hidden" id="wph.hidden"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.description" id="wph.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" &#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wph.start_date+729)'DD.MM.YYYY') as start_date" id="start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.start_date as ams_start_date" id="ams_start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;o_char(trunc(sysdate) + wph.start_time/24/60'hh24:mi') as start_time" id="start_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.start_time as ams_start_time" id="ams_start_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wph.end_date+729)'DD.MM.YYYY') as end_date" id="end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.end_date as ams_end_date" id="ams_end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;o_char(trunc(sysdate) + wph.end_time/24/60'hh24:mi') as end_time" id="end_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.end_time as ams_end_time" id="ams_end_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_registr" id="a.ac_registr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_PPCDSP_ACTYPES.act.ac_typ@">
          <ds:object>@AFL_PPCDSP_ACTYPES.act.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.start_d@">
          <ds:object>@VAR.start_d@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end_t@">
          <ds:object>@VAR.end_t@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.start_t@">
          <ds:object>@VAR.start_t@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
wph.wpno, 
wph.wpno_i,
wph.hidden,
wph.description, 
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wph.start_date+729), 'DD.MM.YYYY') as start_date,
wph.start_date as ams_start_date,
TO_CHAR(trunc(sysdate) + wph.start_time/24/60, 'hh24:mi') as start_time,
wph.start_time as ams_start_time,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wph.end_date+729), 'DD.MM.YYYY') as end_date,
wph.end_date as ams_end_date,
TO_CHAR(trunc(sysdate) + wph.end_time/24/60, 'hh24:mi') as end_time,
wph.end_time as ams_end_time,
a.ac_registr
FROM 
wp_header wph
JOIN aircraft a ON wph.ac_registr = a.ac_registr
JOIN wp_status wpst ON wpst.wp_status_id = wph.wp_status
WHERE 
wpst.name NOT IN ('Closed', 'Deleted')
AND (a.ac_typ = '@AFL_PPCDSP_ACTYPES.act.ac_typ@' OR a.ac_model = '@AFL_PPCDSP_ACTYPES.act.ac_typ@')
AND (((wph.start_date = @VAR.start_d@) AND (wph.start_time &lt;=@VAR.end_t@)) OR (wph.start_date &lt; @VAR.start_d@))
AND (((wph.end_date = @VAR.start_d@) AND (wph.end_time &gt;=@VAR.start_t@)) OR (wph.end_date &gt; @VAR.start_d@))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
