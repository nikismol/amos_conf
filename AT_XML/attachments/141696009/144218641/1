      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY partno) num,
       partno,
       description,
       ata_chapter,
       ac_typ,
       sys_qty,
       op_ord,
       pma,
       special,
       remarks,
       referenceno,
       mat_class,
       average_price,
       fa_qty,
       reorder,
       avg_ta_time,
       measure_unit,
       repairable,
       max_purch,
       reord_level,
       alert_qty,
	   qty_ac
  from (select distinct p.partno,
                        p.description,
                        case
                          when p.ata_chapter = 'UNKNOWN' then
                           'UNK.'
                          else
                           p.ata_chapter
                        end ata_chapter,
                        case
                          when p.ac_typ = 'UNKNWN' then
                           'UNK.'
                          else
                           p.ac_typ
                        end ac_typ,
                        p.pma,
                        ps.special,
                        ps.remarks,
                        ps.referenceno,
                        p.mat_class,
                        pf.average_price,
                        pf.fa_qty,
                        p.reorder,
                        p.avg_ta_time,
                        p.measure_unit,
                        p.repairable,
                        p.max_purch,
                        p.reord_level,
                        p.alert_qty,
                        case
                          when sys_qty is null then
                           0
                          else
                           sys_qty
                        end sys_qty,
                        op_ord,
						pat.qty_per_ac qty_ac
          from part p
          join part_special ps on p.partno = ps.partno
          join part_fa_entity pf ON pf.partno = p.partno
                                and pf.entityno_i = 1
        /* Физический запас мат-ла */
          left join (select sum(c.qty) sys_qty, c.partno
                      from consumables c
                      join location l on c.locationno_i = l.locationno_i
                     where l.station &lt;&gt; 'В '
                       and l.location_type &lt;&gt; -107
                     group by c.partno
                    union all
                    select count(*) sys_qty, r.partno
                      from rotables r
                      join location l on r.locationno_i = l.locationno_i
                     where r.condition &lt;&gt; 'US'
                       and l.station &lt;&gt; 'В '
                       and l.location_type &lt;&gt; -107
					   and orderno = ' '
                     group by partno) t on p.partno = t.partno
		/* searching Open Orders */
          left join (select sum(od.backorder) op_ord, od.partno
                      from od_detail od
                     where od.backorder &gt; 0
                       and od.order_type IN ('P', 'R', 'W', 'L')
                     group by od.partno) od on p.partno = od.partno
        /* searching Rotables Cnt */
          left join (select count(*) rot_cnt, partno
                      from rotables r
                     where fa_case &gt;= 0
                     group by partno) rot on p.partno = rot.partno
          left join part_ac_type pat on p.partno = pat.partno
         where p.status &lt;&gt; 99
              /* FA Type */
           and ('@VAR.fa_type@' is null or
               p.ac_typ in
               (select trim(substr('@VAR.fa_type@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.fa_type@' || ',',
                                                 ',',
                                                 1,
                                                 level - 1) + 2),
                                    instr('@VAR.fa_type@' || ',',
                                          ',',
                                          1,
                                          level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.fa_type@' || ',',
                                                 ',',
                                                 1,
                                                 level - 1) + 2)))
                   from dual
                 connect by level &lt;=
                            length('@VAR.fa_type@') -
                            length(replace('@VAR.fa_type@', ',', '')) + 1))
              /* Material Class */
           and ('@VAR.mat_cl@' is null or
               p.mat_class in
               (select trim(substr('@VAR.mat_cl@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.mat_cl@' || ',',
                                                 ',',
                                                 1,
                                                 level - 1) + 2),
                                    instr('@VAR.mat_cl@' || ',',
                                          ',',
                                          1,
                                          level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.mat_cl@' || ',',
                                                 ',',
                                                 1,
                                                 level - 1) + 2)))
                   from dual
                 connect by level &lt;=
                            length('@VAR.mat_cl@') -
                            length(replace('@VAR.mat_cl@', ',', '')) + 1))
              /* PMA */
           and (
			nvl('@VAR.pma@', 'N') = 'N' or ('@VAR.pma@' = 'Y' and p.pma = 'Y')
           )
              /* Part Special */
           and ('@VAR.part_spec@' is null or
               ps.special in
               (select trim(substr('@VAR.part_spec@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.part_spec@' || ',',
                                                 ',',
                                                 1,
                                                 level - 1) + 2),
                                    instr('@VAR.part_spec@' || ',',
                                          ',',
                                          1,
                                          level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.part_spec@' || ',',
                                                 ',',
                                                 1,
                                                 level - 1) + 2)))
                   from dual
                 connect by level &lt;=
                            length('@VAR.part_spec@') -
                            length(replace('@VAR.part_spec@', ',', '')) + 1))
							) d</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
