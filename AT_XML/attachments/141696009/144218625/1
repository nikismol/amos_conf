    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Integration_Check_SERV_TYP" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>group by Service Type</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.service" id="a.service"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.service@">
          <ds:object>@VAR.service@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_end@">
          <ds:object>@VAR.date_end@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT a.service
FROM aim_transfer_history a
WHERE (a.service in ('EXPORT_COMPONENT_HISTORY')
	or a.service in ('EXPORT_PICKSLIP') 
	or a.service in ('TRANSFER_ORDER')
	or a.service in ('TRANSFER_PART_DEFINITION')
	or a.service in ('TRANSFER_RECEIVING')
	or a.service in ('TRANSFER_SHIPMENT'))
   and a.success = 'Y'
   and ((@VAR.service@ = 1 and a.service in ('EXPORT_COMPONENT_HISTORY', 'EXPORT_PICKSLIP', 'TRANSFER_ORDER', 'TRANSFER_PART_DEFINITION'
, 'TRANSFER_RECEIVING', 'TRANSFER_SHIPMENT')) or
               (@VAR.service@ = 2 and a.service in ('EXPORT_COMPONENT_HISTORY')) or
               (@VAR.service@ = 3 and a.service in ('EXPORT_PICKSLIP')) or
               (@VAR.service@ = 4 and a.service in ('TRANSFER_ORDER')) or
               (@VAR.service@ = 5 and a.service in ('TRANSFER_PART_DEFINITION')) or
               (@VAR.service@ = 6 and a.service in ('TRANSFER_RECEIVING')) or
               (@VAR.service@ = 7 and a.service in ('TRANSFER_SHIPMENT')))
     /* Date of Transfer */  
    and ('@VAR.date_from@' is null or a.mutation &gt;= '@VAR.date_from@')
    and ('@VAR.date_end@' is null or a.mutation &lt;= '@VAR.date_end@')
   group by a.service
   order by a.service</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Integration_Check" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Сверка выгружаемых данных в SAP</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY a.histno_i) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.histno_i booking_id" id="booking_id"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="shd.shipmentno_i" id="shd.shipmentno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.partno" id="h.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.serialno" id="h.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.rec_detail" id="t.rec_detail"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.service" id="a.service"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pd.pickslipno" id="pd.pickslipno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="odh.orderno" id="odh.orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" decode(a.mutation 0 null to_char(to_date('31.12.1971' 'dd.mm.yyyy') + a.mutation'dd.mm.yyyy')) mut_date" id="mut_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" decode(a.mutation_time &#10;&#9;&#9;&#9;&#9;&#9;  0&#10;&#9;&#9;&#9;&#9;&#9;  null&#10;&#9;&#9;&#9;&#9;&#9;  to_char(to_timestamp('00:00:00' 'HH24:MI:SS') + ((a.mutation_time)/1000/60/60/24)'HH24:MI:SS')) mut_time" id="mut_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.service@">
          <ds:object>@VAR.service@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_end@">
          <ds:object>@VAR.date_end@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY a.histno_i) num
, a.histno_i booking_id, shd.shipmentno_i, h.partno, h.serialno
, t.rec_detail, a.service, pd.pickslipno, odh.orderno
, decode(a.mutation, 0, null, to_char(to_date('31.12.1971', 'dd.mm.yyyy') + a.mutation, 'dd.mm.yyyy')) mut_date
, decode(a.mutation_time, 
					  0,
					  null,
					  to_char(to_timestamp('00:00:00', 'HH24:MI:SS') + ((a.mutation_time)/1000/60/60/24),
							  'HH24:MI:SS')) mut_time
  from aim_transfer_history a
  left join history h on a.source_key = to_char(h.historyno_i)
  left join (select shipmentno_i
  from sh_detail group by shipmentno_i) shd on a.source_key = to_char(shd.shipmentno_i)
  left join ( select partno, rec_detail, serialno_batchno
              from (select c.partno partno, c.recdetailno_i rec_detail, c.batchno  serialno_batchno
                    from consumables c
                    union
                    select r.partno partno, r.rec_detailno_i rec_detail, r.serialno serialno_batchno
                    from rotables r
                    )t
         )t on h.partno = t.partno and h.serialno = t.serialno_batchno
   left join (select pickslipno 
              from pickslip_detail group by pickslipno
             ) pd on a.source_key = pd.pickslipno
   left join od_header odh on a.source_key = odh.orderno
 where a.success = 'Y'
   and ((@VAR.service@ = 1 and a.service in ('EXPORT_COMPONENT_HISTORY', 'EXPORT_PICKSLIP', 'TRANSFER_ORDER', 'TRANSFER_PART_DEFINITION'
, 'TRANSFER_RECEIVING', 'TRANSFER_SHIPMENT')) or
               (@VAR.service@ = 2 and a.service in ('EXPORT_COMPONENT_HISTORY')) or
               (@VAR.service@ = 3 and a.service in ('EXPORT_PICKSLIP')) or
               (@VAR.service@ = 4 and a.service in ('TRANSFER_ORDER')) or
               (@VAR.service@ = 5 and a.service in ('TRANSFER_PART_DEFINITION')) or
               (@VAR.service@ = 6 and a.service in ('TRANSFER_RECEIVING')) or
               (@VAR.service@ = 7 and a.service in ('TRANSFER_SHIPMENT')))
	/* Date of Transfer */  
    and ('@VAR.date_from@' is null or a.mutation &gt;= '@VAR.date_from@')
    and ('@VAR.date_end@' is null or a.mutation &lt;= '@VAR.date_end@')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
