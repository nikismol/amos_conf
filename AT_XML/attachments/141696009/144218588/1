    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_life_lime_header" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Статус запчастей header</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY r.partnor.serialno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.partno" id="r.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.serialno esn" id="esn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.psn" id="r.psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(h_ye.del_date&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + h_ye.del_date&#10;                      'dd.mm.yyyy')) || ' / ' ||&#10;       decode(h_ya.del_date&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + h_ya.del_date'dd.mm.yyyy')) inst_removal" id="inst_removal"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case&#10;         when to_char(t.life_value) &lt;&gt; ' ' then&#10;          to_char(trunc(t.life_value 0)) || ':' ||&#10;          substr((t.life_value - trunc(t.life_value 0)) 22)&#10;         else&#10;          'N/A'&#10;       end eng_tsn" id="eng_tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case&#10;         when to_char(c.life_value) &lt;&gt; ' ' then&#10;          to_char(trunc(c.life_value0))&#10;         else&#10;          'N/A'&#10;       end eng_csn" id="eng_csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case&#10;         when to_char(oh_at_tsn) = '0' then&#10;          'N/A'&#10;         else&#10;          to_char(oh_at_tsn)&#10;       end hours_sv" id="hours_sv"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case&#10;         when to_char(oh_at_csn) = '0' then&#10;          'N/A'&#10;         else&#10;          to_char(oh_at_csn)&#10;       end cycles_sv" id="cycles_sv"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.description" id="p.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.description" id="s.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_registr || ' / ' || trim(leading '0' from a.serialno) ac_msn" id="ac_msn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case when to_char((tah.tah/60) - trunc(tah.tah / 60)) &gt; 0.6 then round(tah.tah / 60 0) + 1 || ':' || substr(to_char((tah.tah/60) &#10;            - trunc(tah.tah / 60)) - 0.6 2 2)&#10;            else round(tah.tah / 60 0) || ':' || substr(to_char((tah.tah/60) - trunc(tah.tah / 60)) 22)&#10;            end tsn" id="tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tac.tac csn" id="csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case &#10;&#9;&#9;when s.description like '%RH%' then &#10;&#9;&#9;&#9;'R/H'&#10;        when s.description like '%LH%' then &#10;&#9;&#9;&#9;'L/H'&#10;        else r.location&#10;       end pos" id="pos"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select row_number() over(ORDER BY r.partno, r.serialno) num,
	   r.partno,
	   r.serialno esn,
       r.psn,
       decode(h_ye.del_date,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + h_ye.del_date,
                      'dd.mm.yyyy')) || ' / ' ||
       decode(h_ya.del_date,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + h_ya.del_date,
                      'dd.mm.yyyy')) inst_removal,
       case
         when t.life_value &gt; 0 then
          to_char(trunc(t.life_value, 0)) || ':' ||
          substr((t.life_value - trunc(t.life_value, 0)), 2, 2) 
		 when t.life_value = 0 then 
		  case when to_char((tah.tah/60) - trunc(tah.tah / 60)) &gt; 0.6 then round(tah.tah / 60, 0) + 1 || ':' || substr(to_char((tah.tah/60) 
            - trunc(tah.tah / 60)) - 0.6, 2, 2)
            else round(tah.tah / 60, 0) || ':' || substr(to_char((tah.tah/60) - trunc(tah.tah / 60)), 2, 2)
            end
         else
          'N/A'
       end eng_tsn,
       case
         when to_char(c.life_value) &gt; 0 then
          to_char(trunc(c.life_value, 0))
		 when to_char(c.life_value) = 0 then to_char(tac.tac)
         else
          'N/A'
       end eng_csn,
       case
         when to_char(oh_at_tsn) = '0' then
          'N/A'
         else
          to_char(oh_at_tsn)
       end hours_sv,
       case
         when to_char(oh_at_csn) = '0' then
          'N/A'
         else
          to_char(oh_at_csn)
       end cycles_sv,
       p.description,
       s.description,
       a.ac_registr || ' / ' || trim(leading '0' from a.serialno) ac_msn,
       case when to_char((tah.tah/60) - trunc(tah.tah / 60)) &gt; 0.6 then round(tah.tah / 60, 0) + 1 || ':' || substr(to_char((tah.tah/60) 
            - trunc(tah.tah / 60)) - 0.6, 2, 2)
            else round(tah.tah / 60, 0) || ':' || substr(to_char((tah.tah/60) - trunc(tah.tah / 60)), 2, 2)
            end tsn,
       tac.tac csn,
	   case 
		when s.description like '%RH%' then 
			'R/H'
        when s.description like '%LH%' then 
			'L/H'
        else r.location
       end pos
    from rotables r
  join part p on r.partno = p.partno
join ( /* Когда было и снятие, и установка */
		select a_vm,
               a_psn,
               a_historyno_i,
               b_vm,
               b_psn,
               max(b_historyno_i) b_historyno_i
          from (select a.vm          a_vm,
                       a.psn         a_psn,
                       a.historyno_i a_historyno_i,
                       b.vm          b_vm,
                       b.psn         b_psn,
                       b.historyno_i b_historyno_i
                /* 1. Ищу последнее снятие компонента */
                  from (select case
                                 when vm = 'YA' then
                                  'removal'
                                 when vm = 'YE' then
                                  'install'
                                 else
                                  'unk.'
                               end vm,
                               psn,
                               max(historyno_i) historyno_i
                          from history h
                         where vm = 'YA'
                         group by vm, psn) a
                /* 2. А здесь установку, предшествующую снятию */
                  join (select case
                                when vm = 'YA' then
                                 'removal'
                                when vm = 'YE' then
                                 'install'
                                else
                                 'unk.'
                              end vm,
                              psn,
                              historyno_i
                         from history h
                        where vm = 'YE') b on a.psn = b.psn
                                          and b.historyno_i &lt; a.historyno_i) c
         group by a_vm, a_psn, a_historyno_i, b_vm, b_psn
UNION
	/* Если у компонента было только снятие */
		select h.vm a_vm,
			   h.psn a_psn,
			   h.historyno_i a_historyno_i,
			   null b_vm,
			   null b_psn,
			   null b_historyno_i
		from (select count(h.psn) cnt, h.psn 
				from history h 
				where vm in ('YA') 
				group by h.psn 
				having count(h.psn) = 1) x
		join history h on x.psn = h.psn and h.vm = 'YA'
UNION
	/* Если была только установка */
		select null a_vm,
			   h.psn a_psn,
			   null a_historyno_i,
			   h.vm b_vm,
			   h.psn b_psn,
			   h.historyno_i b_historyno_i
		from (select count(h.psn) cnt, h.psn 
				from history h 
				where vm in ('YE') 
				group by h.psn 
				having count(h.psn) = 1) x
		join history h on x.psn = h.psn and h.vm = 'YE') y on r.psn = y.a_psn
  left join history h_ye on y.b_historyno_i = h_ye.historyno_i
  left join history h_ya on y.a_historyno_i = h_ya.historyno_i
  left join (select round(counter.life_value / 60, 2) life_value,
                    counter.ref_key
               from counter
               join counter_template on counter.counter_templateno_i =
                                        counter_template.counter_templateno_i
               join counter_definition on counter_template.counter_defno_i =
                                          counter_definition.counter_defno_i
                                      and counter_definition.code = 'H'
              where counter.ref_type = 'RO') t on r.psn = t.ref_key
  left join (select counter.life_value, counter.ref_key
               from counter
               join counter_template on counter.counter_templateno_i =
                                        counter_template.counter_templateno_i
               join counter_definition on counter_template.counter_defno_i =
                                          counter_definition.counter_defno_i
                                      and counter_definition.code = 'C'
              where counter.ref_type = 'RO') c on r.psn = c.ref_key
  left join position s on r.locid_pk = s.locid_pk
  join aircraft a on r.ac_registr = a.ac_registr
  left join (select max(tah) tah, ac_registr from ac_utilization group by ac_registr) tah on r.ac_registr = tah.ac_registr
  left join (select max(tac) tac, ac_registr from ac_utilization group by ac_registr) tac on r.ac_registr = tac.ac_registr
 where ('@VAR.partno@' is null or
  r.partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
 and ('@VAR.serialno@' is null or
  r.serialno in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))
 group by r.partno, r.serialno, r.psn, h_ye.del_date, h_ya.del_date, t.life_value, c.life_value,
          oh_at_tsn, oh_at_csn, p.description, s.description, a.ac_registr, a.serialno, tah.tah, tac.tac, r.location</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
