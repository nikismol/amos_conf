          <ds:object>@RMX_life_lime_header.r.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_life_lime_header.esn@">
          <ds:object>@RMX_life_lime_header.esn@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select row_number() over(ORDER BY tr.tree_position, p.description, partnonew, serialnonew) num
  , p.description sub_assem, r.partno, serialno, r.partnonew, amount_interval, round(cycles, 0) cycles, round(amount_interval - cycles, 0) remain_life
  , tr.tree_position
  from rotables r
  join part p on r.partno = p.partno 
  /* 2018-10-25 узнаём tree_position в шаблоне */
  left join (select distinct tt.tree_type
            , tree_chapter
            , prev_chapter
            , tree_position
         from tree_type tt
         join tree_reference tr on tt.tree_type = tr.tree_type
        where tt.status &lt;&gt; 9
          and prev_chapter = 'GE90-115B'
          and type = 'C' /* Component Tree */) tr on r.partno = tr.tree_chapter
  join part_req pr on p.partseqno_i = pr.partseqno_i
                  and pr.requirement_status &lt;&gt; 9
  join part_add_req par on pr.reqseqno_i = par.reqseqno_i
  join treq_time_requirement ttr on ttr.event_key = par.add_reqseqno_i
                                and ttr.event_type = 'RORE' and ttr.status = 0
  join wo_event_link wel on ttr.event_key = wel.event_key and wel.pending_status = 0 and planable_status = 0
  join wo_header woh on wel.event_perfno_i = woh.event_perfno_i and woh.psn = r.psn
  join treq_interval_group tig on ttr.timerequirementno_i = tig.timerequirementno_i
  join (select max(amount_interval) amount_interval, interval_groupno_i 
			from treq_interval 
			group by interval_groupno_i) ti on tig.interval_groupno_i = ti.interval_groupno_i
  join (select c.life_value comp_at_inst,
               b.life_value ac_at_inst,
               d.life_value ac_before_inst,
               c.life_value + (d.life_value - b.life_value) cycles,
               r.psn
          from rotables r
        -- Нахожу циклы компонента на момент установки
          join counter c on r.psn = c.ref_key
                        and c.ref_type = 'RO'
          join counter_template ct on c.counter_templateno_i =
                                      ct.counter_templateno_i
          join counter_definition cd on ct.counter_defno_i =
                                        cd.counter_defno_i
                                    and code = 'C'
          join counter_value cv on c.counterno_i = cv.counterno_i
        -- К-во самолётных циклов на момент установки компонента
          join counter_value b on cv.on_counter_valueno_i =
                                  b.counter_valueno_i
                              and c.master_counterno_i = b.counterno_i
          join (select max(counter_valueno_i) counter_valueno_i,
                      counterno_i,
                      max(life_value) life_value
                 from counter_value
                group by counterno_i) d on c.master_counterno_i =
                                           d.counterno_i) cyc on r.psn = cyc.psn
 where partnonew in ('@RMX_life_lime_header.r.partno@')
   and serialnonew in ('@RMX_life_lime_header.esn@')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_Get_sign" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.lastname  lastname_prep" id="lastname_prep"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.firstname firstname_prep" id="firstname_prep"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rp.label    label_prep" id="label_prep"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="c.lastname  lastname_check" id="lastname_check"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="c.firstname firstname_check" id="firstname_check"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rc.label    label_check" id="label_check"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@SYSTEM.LOGIN_SIGN@">
          <ds:object>@SYSTEM.LOGIN_SIGN@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.employee@">
          <ds:object>@VAR.employee@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT p.lastname  lastname_prep,
       p.firstname firstname_prep,
       rp.label    label_prep,
       c.lastname  lastname_check,
       c.firstname firstname_check,
       rc.label    label_check
  FROM sign s
  JOIN (select row_number() over(ORDER BY user_sign) num,
               user_sign,
               lastname,
               firstname,
               jobcode
          from sign
         WHERE user_sign = '@SYSTEM.LOGIN_SIGN@') p on s.user_sign = p.user_sign
  LEFT JOIN rm_resource_type rp on p.jobcode = rp.resource_type_id
  LEFT JOIN (select row_number() over(ORDER BY user_sign) num,
               user_sign,
               lastname,
               firstname,
               jobcode
          from sign
         where ('@VAR.employee@' = ' ' or
               user_sign in
               (select trim(substr('@VAR.employee@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.employee@' || ',',
                                                 ',',
                                                 1,
                                                 level - 1) + 2),
                                    instr('@VAR.employee@' || ',', ',', 1, level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.employee@' || ',',
                                                 ',',
                                                 1,
                                                 level - 1) + 2)))
                   from dual
                 connect by level &lt;= length('@VAR.employee@') -
                            length(replace('@VAR.employee@', ',', '')) + 1))) c on p.num =
                                                                          c.num
  LEFT JOIN rm_resource_type rc on c.jobcode = rc.resource_type_id</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
