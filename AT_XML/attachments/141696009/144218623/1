    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Fail_WO_Transfer" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Отчёт по сбойным ситуациям передачи Workorder`ов.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY t.last_trf_date_timewo.workorderno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.workorderno" id="wo.workorderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.ata_chapter" id="wo.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when wo.state = 'O' then 'Open'&#10;&#9;   when wo.state = 'C' then 'Closed'&#10;&#9;   else 'Unk.'&#10;&#9;   end state" id="state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.ac_registr" id="wo.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.issue_date" id="wo.issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.closing_date" id="wo.closing_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.issue_station" id="wo.issue_station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when wo.type = 'P' then 'Pirep'&#10;&#9;&#9;&#9;when wo.type = 'C' then 'Cabin'&#10;&#9;&#9;&#9;when wo.type = 'M' then 'Maintenance'&#10;&#9;&#9;&#9;when wo.type = 'S' then 'Scheduled'&#10;&#9;&#9;&#9;else 'Unk.'&#10;&#9;   end type" id="type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.mel_code" id="wo.mel_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.last_mutation" id="wo.last_mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.last_transfer_success" id="t.last_transfer_success"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.error_message" id="t.error_message"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.last_trf_date_time" id="t.last_trf_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.cnt_per_source_key" id="t.cnt_per_source_key"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       (trunc(last_mutation 'mi') -&#10;       nvl(last_trf_date_time to_date('31.12.1971''dd.mm.yyyy'))) * 24 * 60 delta" id="delta"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.mut_date@">
          <ds:object>@VAR.mut_date@</ds:object>
