      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY t.last_trf_date_time, wo.workorderno) num,
       wo.workorderno,
       wo.ata_chapter,
       case when wo.state = 'O' then 'Open'
	   when wo.state = 'C' then 'Closed'
	   else 'Unk.'
	   end state,
       wo.ac_registr,
       wo.issue_date,
       wo.closing_date,
       wo.issue_station,
       case when wo.type = 'P' then 'Pirep'
			when wo.type = 'C' then 'Cabin'
			when wo.type = 'M' then 'Maintenance'
			when wo.type = 'S' then 'Scheduled'
			else 'Unk.'
	   end type,
       wo.mel_code,
       wo.last_mutation,
       t.last_transfer_success,
       t.error_message,
       t.last_trf_date_time,
       t.cnt_per_source_key,
       round((trunc(last_mutation, 'mi') -
       nvl(last_trf_date_time, to_date('31.12.1971', 'dd.mm.yyyy'))) * 24 * 60, 3) delta
  from (select wono_i
from    
(
select source_key_i wono_i 
  from (select h.*, max(histno_i) over(partition by source_key_i) max_histno_i,
count(1) over(partition by source_key_i) cnt_per_source_key
from aim_transfer_history h
where service = 'TRANSFER_WORKORDER'
                        and source_type = 'WO') t
where t.histno_i = max_histno_i
minus
select woh.event_perfno_i wono_i
from wo_header woh
where woh.type in ('P', 'C', 'M', 'S')
           and woh.mel_code is not null
           and mutator not in ('MIGRUSR', 'RAMAX_AC')
           and mutation &gt;= @VAR.mut_date@
           and ac_registr != 'COMP'
) wp_difference) wp_diff
join (select woh.event_perfno_i workorderno,
               woh.ata_chapter,
               woh.state,
               woh.ac_registr,
               to_date('31.12.1971', 'dd.mm.yyyy') + woh.issue_date issue_date,
               to_date('31.12.1971', 'dd.mm.yyyy') + woh.closing_date closing_date,
               woh.issue_station,
               woh.type,
               woh.mel_code,
               to_date('31.12.1971', 'dd.mm.yyyy') + woh.mutation +
               woh.mutation_time / 24 / 60 / 60 / 1000 last_mutation
          from wo_header woh
         where woh.type in ('P', 'C', 'M', 'S')
           and woh.mel_code is not null
           and mutator not in ('MIGRUSR', 'RAMAX_AC')
           and mutation &gt;= @VAR.mut_date@
           and ac_registr != 'COMP') wo on wp_diff.wono_i = wo.workorderno
  left join (select success last_transfer_success,
                    error_message,
                    source_key_i,
                    to_date('31.12.1971', 'dd.mm.yyyy') + trf_date +
                    trf_time / 24 / 60 last_trf_date_time,
                    cnt_per_source_key
               from (select h.*,
                            max(histno_i) over(partition by source_key_i) max_histno_i,
                            count(1) over(partition by source_key_i) cnt_per_source_key
                       from aim_transfer_history h
                      where service = 'TRANSFER_WORKORDER'
                        and source_type = 'WO') t
              where t.histno_i = max_histno_i) t
    on wo.workorderno = t.source_key_i
 where ((trunc(last_mutation, 'mi') -
       nvl(last_trf_date_time, to_date('31.12.1971', 'dd.mm.yyyy'))) * 24 * 60 &gt; 1
    or nvl(last_transfer_success, 'N') != 'Y')
and wo.workorderno = '@VAR.wo_no@'</se:textStatement>
