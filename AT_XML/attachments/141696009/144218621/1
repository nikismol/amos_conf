      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT p.item,
       p.requirement,
       (
          SELECT qa_finding_type.name 
          FROM qa_finding_type 
          WHERE fh.qa_findno_i = qa_finding_type.qa_findno_i
       ) as result,
       pr.priority,
       fp.problem
FROM qa_item_pool p
LEFT JOIN qa_audit_section_item si ON p.qa_itemno_i = si.qa_itemno_i 
LEFT JOIN qa_item_findings_history fh ON si.recno = fh.recno AND si.qa_sectionno_i = fh.qa_sectionno_i 
LEFT JOIN qa_item_find_problems fp ON fh.qa_find_historyno_i = fp.qa_find_historyno_i 
LEFT JOIN qa_priority pr ON fp.qa_priorityno_i = pr.qa_priorityno_i 
WHERE si.qa_sectionno_i = @AUDIT_ITEMS.s.qa_sectionno_i@
ORDER BY si.item_order ASC </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
