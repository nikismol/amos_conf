      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
air.ac_registr, int_less.count_less, int_more.count_more, int_less.count_less+int_more.count_more as total
FROM aircraft air
JOIN
(SELECT ut.ac_registr as ac_reg, COUNT(ut.legno_i) as count_less 
FROM 
(SELECT 
	au.legno_i, 
	(au.departure_date - LAG(au.validity, 1, 0) over (ORDER BY au.legno_i))*24*60 + (au.departure_time - LAG(au.arrival_time, 1, 0) over (ORDER BY au.legno_i)) as int_min, 
	(LAG(au.arrival, 1, 0) over (ORDER BY au.legno_i)) as prev_arrival,
    (LAG(au.ac_registr, 1, 0) over (ORDER BY au.legno_i)) as prev_reg, 
	au.departure, 
	au.ac_registr 
FROM ac_utilization au  WHERE au.departure_date &gt;0 
                             AND au.validity &lt;= '@VAR.Date_end@'
                              AND au.departure_date &gt;= '@VAR.Date_beg@') ut
WHERE ut.int_min &lt;=130  
AND ut.departure = 'SVO'
AND ut.prev_arrival = 'SVO'
AND ut.ac_registr = ut.prev_reg
GROUP BY (ut.ac_registr)) int_less 
ON int_less.ac_reg = air.ac_registr
JOIN
(SELECT ut.ac_registr as ac_reg, COUNT(ut.legno_i) as count_more 
FROM 
(SELECT 
	au.legno_i, 
	(au.departure_date - LAG(au.validity, 1, 0) over (ORDER BY au.legno_i))*24*60 + (au.departure_time - LAG(au.arrival_time, 1, 0) over (ORDER BY au.legno_i)) as int_min, 
	(LAG(au.arrival, 1, 0) over (ORDER BY au.legno_i)) as prev_arrival,
    (LAG(au.ac_registr, 1, 0) over (ORDER BY au.legno_i)) as prev_reg, 
	au.departure, 
	au.ac_registr 
FROM ac_utilization au  WHERE au.departure_date &gt;0 
                              AND au.validity &lt;= '@VAR.Date_end@'
                              AND au.departure_date &gt;= '@VAR.Date_beg@') ut
WHERE ut.int_min &gt;130  
AND ut.departure = 'SVO'
AND ut.prev_arrival = 'SVO'
AND ut.ac_registr = ut.prev_reg
GROUP BY (ut.ac_registr)) int_more 
ON int_more.ac_reg = air.ac_registr

WHERE ac_model like '@VAR.air_tp@%'

ORDER BY air.ac_registr asc</se:textStatement>
