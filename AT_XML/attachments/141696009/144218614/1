        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       CASE WHEN forecast.dimension='D' THEN TO_CHAR(forecast_dimension.since_req/60/24 '99999999999999.99')||'h'&#10;               ELSE CASE WHEN forecast.dimension='H' THEN TO_CHAR(forecast_dimension.since_req/60'99999999999999.99')||'h'  END  END as  TSR" id="TSR"/>
