      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT distinct aircraft.ac_registr,
       aircraft.serialno,
       ata_chapter.ata_chapter,
       ata_chapter.description, 
       part.partseqno_i,
       part.partno,
       rotables.serialno,
       rotables.location,
       part.description,
       requirement.description REQUIR,
       CASE WHEN rotables.releaseno not like (' ') THEN rotables.releaseno||'/ '||rotables.labelno ELSE '- / '||rotables.labelno END  Release , 
       TO_CHAR(TO_DATE('31.12.1971','DD.MM.YYYY')+ rotables.date_inst) as dat,
       wo_header.position,
       CASE WHEN forecast.interval_dimension in ('H','YR') THEN TO_CHAR(TO_NUMBER(forecast.interval_value))||forecast.interval_dimension  END as interval,
       msc_requirement_tc_link.taskcardno,
       CASE WHEN forecast.interval_dimension='H' THEN TO_CHAR(forecast.togo/60, '99999999999999.99')||'h' 
               ELSE CASE WHEN forecast.interval_dimension='YR' THEN TO_CHAR(forecast.togo/365/60/24, '99999999999999.99')||'y' END END as  To_go,
       CASE WHEN forecast.dimension='D' THEN TO_CHAR(forecast_dimension.since_req/60/24, '99999999999999.99')||'d'
               ELSE CASE WHEN forecast.dimension='H' THEN TO_CHAR(forecast_dimension.since_req/60, '99999999999999.99')||'h'  END  END as  TSR,
       TO_CHAR(FLOOR (TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value)/60))||':'||CASE WHEN      (TO_CHAR(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value), 60)))&lt;10
																	   THEN '0'||(TO_CHAR(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value), 60)))||'h'
																	   ELSE (TO_CHAR(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value), 60)))||'h'
																  END as TSN,
TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on+counter_c.life_value) as CSN
   
FROM part
       LEFT JOIN rotables ON rotables.partno = part.partno 
       LEFT JOIN part_req ON part.partseqno_i = part_req.partseqno_i 
       LEFT JOIN ata_chapter on ata_chapter.ata_chapter=part.ata_chapter
       LEFT JOIN aircraft on aircraft.ac_registr= rotables.ac_registr
       LEFT JOIN requirement_link ON requirement_link.source = part_req.reqseqno_i 
       LEFT JOIN msc_requirement_tc_link ON msc_requirement_tc_link.req_link_headerno_i=requirement_link.target and msc_requirement_tc_link.taskcardno not like 'ALL'
       LEFT JOIN requirement  on requirement.requirement=part_req.requirement 
       LEFT JOIN wo_header ON wo_header.psn = rotables.psn and wo_header.event_type='R'
      
 LEFT JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i
       LEFT JOIN wo_transfer ON wo_event_link.event_perfno_i = wo_transfer.event_perfno_i AND wo_transfer.transfer_type = 'T' AND wo_transfer.is_last_transfer = 'Y'
       LEFT JOIN treq_interval ON wo_transfer.treq_interval_groupno_i = treq_interval.interval_groupno_i
      
       LEFT JOIN forecast on forecast.psn=rotables.psn and forecast.event_type='R'
       LEFT JOIN forecast_dimension ON forecast.event_perfno_i=forecast_dimension.event_perfno_i
       LEFT JOIN  counter ON counter.ref_key=rotables.psn AND counter.ref_type='RO'

/* Наработка по компонентам в часах */
LEFT JOIN (SELECT
				DISTINCT (counter.ref_key),
				counter.counterno_i,
				counter.master_counterno_i,
				max_counter_value.on_counter_valueno_i,
				counter_definition.code,
				max_counter_value.life_value,
				counter_value_on.life_value as life_value_on
		   FROM 
				counter
		   		LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
		   		LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
		   		LEFT JOIN (SELECT DISTINCT
					  			counter_value.counter_valueno_i as counter_valueno_i,
					  			counter_value.counterno_i as counterno_i,
								counter_value.on_counter_valueno_i,
					  			MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
					  			counter_value.life_value as life_value,
					  			counter_definition.counter_defno_i
				 		   FROM
					  			counter_value
				 		   LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 		   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 		   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 		   WHERE
								counter_definition.counter_defno_i='1'
				 		   ORDER BY
					            counter_value.counterno_i
						  ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
				LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
		   		WHERE
					 counter.ref_type='RO'
			   		 AND counter_definition.counter_defno_i='1'
					 AND max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
		  ) counter_h ON rotables.psn=counter_h.ref_key 
LEFT JOIN counter counter_m_h ON counter_h.master_counterno_i=counter_m_h.counterno_i
LEFT JOIN (SELECT 
				max_counter_value.counterno_i as counterno_i,
				max_counter_value.counter_valueno_i as counter_valueno_i,
			    max_counter_value.life_value as life_value
		   FROM (SELECT distinct
					  counter_value.counter_valueno_i as counter_valueno_i,
					  counter_value.counterno_i as counterno_i,
					  MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
					  counter_value.life_value as life_value,
					  counter_definition.counter_defno_i
				 FROM
				 	  counter_value
				 LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 WHERE counter_definition.counter_defno_i='1'
				 ORDER BY
					  counter_value.counterno_i
				) max_counter_value
		   WHERE
				max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
		  ) counter_value_m_h ON counter_m_h.counterno_i=counter_value_m_h.counterno_i

/* Наработка по компонентам в циклах */
LEFT JOIN (SELECT
				DISTINCT (counter.ref_key),
				counter.counterno_i,
				counter.master_counterno_i,
				max_counter_value.on_counter_valueno_i,
				counter_definition.code,
				max_counter_value.life_value,
				counter_value_on.life_value as life_value_on
		   FROM 
				counter
		   		LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
		   		LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
		   		LEFT JOIN (SELECT distinct
					  			counter_value.counter_valueno_i as counter_valueno_i,
					  			counter_value.counterno_i as counterno_i,
								counter_value.on_counter_valueno_i,
					  			MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
					  			counter_value.life_value as life_value,
					  			counter_definition.counter_defno_i
				 		   FROM
					  			counter_value
				 		   LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 		   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 		   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 		   WHERE
								counter_definition.counter_defno_i='2'
				 		   ORDER BY
					            counter_value.counterno_i
						  ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
				LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
		   		WHERE
					 counter.ref_type='RO'
			   		 AND counter_definition.counter_defno_i='2'
					 AND max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
		  ) counter_c ON rotables.psn=counter_c.ref_key 
LEFT JOIN counter counter_m_c ON counter_c.master_counterno_i=counter_m_c.counterno_i
LEFT JOIN (SELECT 
				max_counter_value.counterno_i as counterno_i,
				max_counter_value.counter_valueno_i as counter_valueno_i,
			    max_counter_value.life_value as life_value
		   FROM (SELECT distinct
					  counter_value.counter_valueno_i as counter_valueno_i,
					  counter_value.counterno_i as counterno_i,
					  MAX (counter_value.counter_valueno_i) OVER (PARTITION BY counter_value.counterno_i) as max_counter_valueno_i,
					  counter_value.life_value as life_value,
					  counter_definition.counter_defno_i
				 FROM
				 	  counter_value
				 LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 WHERE counter_definition.counter_defno_i='2'
				 ORDER BY
					  counter_value.counterno_i
				) max_counter_value
		   WHERE
				max_counter_value.counter_valueno_i=max_counter_value.max_counter_valueno_i
		  ) counter_value_m_c ON counter_m_c.counterno_i=counter_value_m_c.counterno_i

