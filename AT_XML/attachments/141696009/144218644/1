      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno AS OrderNumber" id="OrderNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.ext_state AS OrderStatus" id="OrderStatus"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.ext_orderno AS ExternalOrderNumber" id="ExternalOrderNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.posno AS PositionNumber" id="PositionNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.ext_state AS DetailState" id="DetailState"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderdate AS OrderDate" id="OrderDate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.vendor AS VendorAddress" id="VendorAddress"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="address.name AS VendorName" id="VendorName"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.partno AS PartNumber" id="PartNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.serialno AS SerialNumber" id="SerialNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.labelno AS LabelNumber" id="LabelNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description AS PartDescription" id="PartDescription"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(od_detail.qty) AS QTY" id="QTY"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.backorder AS BACKORDER" id="BACKORDER"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sh_header.shipmentno_i AS Shipment" id="Shipment"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (od_detail.target_date)'DD.MM.YYYY') AS TargetDate" id="TargetDate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (od_detail.confirmed_date)'DD.MM.YYYY') AS ConfirmedDate" id="ConfirmedDate"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ORD@">
          <ds:object>@VAR.ORD@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
		od_header.orderno AS OrderNumber
		,od_header.ext_state AS OrderStatus
		,od_header.ext_orderno AS ExternalOrderNumber
		,od_detail.posno AS PositionNumber
		,od_detail.ext_state AS DetailState
		,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_header.orderdate), 'DD.MM.YYYY')  AS OrderDate
		,od_header.vendor AS VendorAddress
		,address.name AS VendorName
		,od_detail.partno AS PartNumber
		,od_detail.serialno AS SerialNumber
		,od_detail.labelno AS LabelNumber
		,part.description AS PartDescription
		,TO_NUMBER(od_detail.qty) AS QTY
		,od_detail.backorder AS BACKORDER
		,sh_header.shipmentno_i AS Shipment
		,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_detail.target_date), 'DD.MM.YYYY') AS TargetDate
		,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_detail.confirmed_date), 'DD.MM.YYYY') AS ConfirmedDate
FROM od_header
LEFT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
LEFT JOIN part ON od_detail.partno = part.partno
LEFT JOIN address ON od_header.vendor = address.vendor
LEFT JOIN sh_detail ON od_detail.detailno_i = sh_detail.od_detailno_i
LEFT JOIN sh_header ON sh_detail.shipmentno_i = sh_header.shipmentno_i
LEFT JOIN part_special ON part.partno =  part_special.partno
WHERE TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_detail.confirmed_date), 'DD.MM.YYYY') &lt; TO_DATE(sysdate)
AND od_detail.ext_state = 'O'
AND od_header.order_type = 'P'
AND od_header.orderno = '@VAR.ORD@'
AND od_detail.confirmed_date IS NOT NULL 
AND od_detail.confirmed_date &lt;&gt; '0'
AND part_special.special IN ('PR009', 'PR045', 'PR061', 'PR066')
ORDER BY od_header.orderno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
