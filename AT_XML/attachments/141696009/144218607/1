    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="265_Check_AC_Reg" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.serialno as serialno" id="serialno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_ac_registr@">
          <ds:object>@VAR.v01_ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	aircraft.ac_registr as ac_registr,
	aircraft.description as description,
	aircraft.serialno as serialno
FROM (
             SELECT t.v
             FROM (
                          SELECT column_value as v
                          FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_ac_registr@','line_feed'))
                         ) t
             WHERE t.v is not null
            ) ac
JOIN aircraft ON aircraft.ac_registr = ac.v
ORDER BY ac_registr</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
