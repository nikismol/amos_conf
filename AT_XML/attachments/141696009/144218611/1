    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_TQ_GetQueryInfo" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Get TQ Info</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.queryno_i as qno" id="qno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" &#10;&#9;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (tech_query.issued_date+729)'DD.MM.YYYY') as iss_date" id="iss_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (tech_query.issued_date+729)'DDMMYY') as iss_date_ref" id="iss_date_ref"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.issued_by as issby" id="issby"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.issued_by_group as issbyg" id="issbyg"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.headline as headline" id="headline"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.description as descr" id="descr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.assigned_to as assto" id="assto"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.assigned_to_group as asstog" id="asstog"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.priority as prio" id="prio"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query_ac.ata_chapter as ata" id="ata"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query_part.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query_part.batchno as batchno" id="batchno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.tah as tah" id="tah"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.tac as tac" id="tac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname as issuerfn" id="issuerfn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.lastname as issuerln" id="issuerln"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_registr as tailno" id="tailno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.serialno as msn" id="msn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno as partno" id="partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.queryno_i@">
          <ds:object>@VAR.queryno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
	tech_query.queryno_i as qno, 
	TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (tech_query.issued_date+729), 'DD.MM.YYYY') as iss_date,
	TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (tech_query.issued_date+729), 'DDMMYY') as iss_date_ref,
	tech_query.issued_by as issby, 
	tech_query.issued_by_group as issbyg,
	tech_query.headline as headline,
	tech_query.description as descr,
	tech_query.assigned_to as assto, 
	tech_query.assigned_to_group as asstog,
	tech_query.priority as prio,
	tech_query_ac.ata_chapter as ata,
	tech_query_part.serialno as serialno,
	tech_query_part.batchno as batchno,
	ac_utilization.tah as tah,
	ac_utilization.tac as tac,
	sign.firstname as issuerfn,
	sign.lastname as issuerln,
	aircraft.ac_registr as tailno,
	aircraft.serialno as msn,
	part.partno as partno
FROM tech_query
LEFT JOIN tech_query_ac ON tech_query_ac.queryno_i = tech_query.queryno_i
LEFT JOIN tech_query_part ON tech_query_part.queryno_i = tech_query.queryno_i
LEFT JOIN aircraft ON aircraft.aircraftno_i = tech_query_ac.ac_registr
LEFT JOIN (
	SELECT MAX(legno_i) as legno, ac_registr FROM ac_utilization WHERE tac IS NOT NULL AND tah IS NOT NULL GROUP BY ac_registr
) max_leg ON max_leg.ac_registr = aircraft.ac_registr
LEFT JOIN ac_utilization ON max_leg.legno = ac_utilization.legno_i
LEFT JOIN part ON part.partseqno_i = tech_query.ref_key AND tech_query.ref_type = 'PA_INT'
LEFT JOIN sign ON tech_query.created_by = sign.user_sign
WHERE tech_query.queryno_i = @VAR.queryno_i@

/*TQ9*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
