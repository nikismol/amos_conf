      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT tqn.noteno_i,
       tqn.created_by,
       tq.queryno_i,
       case
         when tq.status = '1' then
          'New'
         when tq.status = '2' then
          'Reassign to ' || s_as.firstname || ' ' || s_as.lastname
         when tq.status = '4' then
          'Reopen'
         when tq.status = '3' then
          'Closed'
         when tq.status = '9' then
          'Delete'
         else
          'empty'
       end status,
       headline,
       issued_by_group,
       assigned_to_group,
       s_as.firstname || ' ' || s_as.lastname Assigned_to,
       decode(issued_date,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + issued_date,
                      'dd.mm.yyyy')) issued_date,
       to_char(to_date('01.01.1970 00:00:00', 'dd.mm.yyyy hh24:mi:ss') +
               1 / 24 / 60 / 60 * issued_time,
               'mi:ss') At,
       s.firstname || ' ' || s.lastname Issuer,
       tq.priority,
       decode(due_date,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + due_date,
                      'dd.mm.yyyy')) due_date,
       station,
       to_char(SUBSTR(note, 1, 150)) || '..' note,
	   tqn.created_by || ' ' || '/' || ' ' || sd.firstname || ' ' || sd.lastname participant
   FROM tech_query tq
   /* Ищу последнюю ноту в тикете */
  left join (select max(noteno_i) noteno_i, queryno_i from tech_query_note group by queryno_i) sq on tq.queryno_i = sq.queryno_i
  /* ..а тут беру дескрипшен и всё остальное */
  left join tech_query_note tqn on sq.noteno_i = tqn.noteno_i
  /* меня интересуют участники обсуждения квери входящие в какую-либо группу %ED% */
  left join (select queryno_i, max(noteno_i) noteno_i
               from tech_query_note a
               join (select max(user_group) user_group, login_sign
                      from user_access ua
                     where user_group like '%ED%'
                     group by login_sign) b on a.created_by = b.login_sign
              group by queryno_i) c on tqn.noteno_i = c.noteno_i
  left join sign s on issued_by = s.user_sign
  left join sign s_as on assigned_to = s_as.user_sign
  left join sign sd on tqn.created_by = sd.user_sign
 WHERE /* Status */
   (nvl(@VAR.status@, 1) = 1 or (@VAR.status@ = 2 and tq.status &lt;&gt; '3') or
       (@VAR.status@ = 3 and tq.status in ('9', '3')))
      /* Query No */
   and ('@VAR.query@' is null or
       tq.queryno_i in
       (select trim(substr('@VAR.query@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.query@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@VAR.query@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.query@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;= length('@VAR.query@') -
                    length(replace('@VAR.query@', ',', '')) + 1))
      /* Assign to Group */
   and ('@VAR.assign_group@' is null or
       assigned_to_group in
       (select trim(substr('@VAR.assign_group@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.assign_group@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@VAR.assign_group@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.assign_group@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;=
                    length('@VAR.assign_group@') -
                    length(replace('@VAR.assign_group@', ',', '')) + 1))
      /* Assign to */
   and ('@VAR.assign_to@' is null or
       assigned_to in
       (select trim(substr('@VAR.assign_to@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.assign_to@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@VAR.assign_to@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.assign_to@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;= length('@VAR.assign_to@') -
                    length(replace('@VAR.assign_to@', ',', '')) + 1))
      /* Issue Date from */
   and ('@VAR.issue_date_from@' is null or
       issued_date &gt;= '@VAR.issue_date_from@')
      /* Issue Date to */
   and ('@VAR.issue_date_to@' is null or
       issued_date &lt;= '@VAR.issue_date_to@')
      /* Issued Group */
   and ('@VAR.issued_group@' is null or
       issued_by_group in
       (select trim(substr('@VAR.issued_group@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.issued_group@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@VAR.issued_group@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.issued_group@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;=
                    length('@VAR.issued_group@') -
                    length(replace('@VAR.issued_group@', ',', '')) + 1))
      /* Issuer */
   and ('@VAR.issuer@' is null or
       issued_by in
       (select trim(substr('@VAR.issuer@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.issuer@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@VAR.issuer@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.issuer@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;= length('@VAR.issuer@') -
                    length(replace('@VAR.issuer@', ',', '')) + 1))
      /* Due Date from */
   and ('@VAR.due_date_from@' is null or
       (due_date &gt; '0' and due_date &gt;= '@VAR.due_date_from@'))
      /* Due Date to */
   and ('@VAR.due_date_to@' is null or
       (due_date &gt; '0' and due_date &lt;= '@VAR.due_date_to@'))
      /* Station */
   and ('@VAR.station@' is null or
       station in
       (select trim(substr('@VAR.station@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.station@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@VAR.station@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.station@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;= length('@VAR.station@') -
                    length(replace('@VAR.station@', ',', '')) + 1))
      /* Description */
   and ('@VAR.desc@' is null or lower(note) like lower('%@VAR.desc@%'))
      /* Headline */
   and ('@VAR.headline@' is null or
       lower(headline) like lower('%@VAR.headline@%'))
      /* Priority */
   and (nvl(@VAR.prior@, 1) = 1 or
       (@VAR.prior@ = 2 and tq.priority = 'LOW') or
       (@VAR.prior@ = 3 and tq.priority = 'MED') or
       (@VAR.prior@ = 4 and tq.priority = 'HIGH'))
	  /* Участник обсуждения */
   and ('@VAR.partic@' is null or
       tqn.created_by in
       (select trim(substr('@VAR.partic@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.partic@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@VAR.partic@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.partic@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;= length('@VAR.partic@') -
                    length(replace('@VAR.partic@', ',', '')) + 1))
	  /* Reassign */
   and ('@VAR.reassign@' is null or
       (tqn.created_by in
       (select trim(substr('@VAR.reassign@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.reassign@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@VAR.reassign@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.reassign@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;= length('@VAR.reassign@') -
                    length(replace('@VAR.reassign@', ',', '')) + 1) and tqn.note_type = 'R'))
 order by tq.queryno_i, tqn.noteno_i desc</se:textStatement>
        </se:sqlStatement>
