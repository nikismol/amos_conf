      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT rotables.partno,
       rotables.serialno,
       rotables.labelno,
       rotables.owner,
       rotables.condition,
       CASE
         WHEN (SELECT inspection_detail.status
                 FROM inspection_detail
                WHERE inspection_detail.inspection_detailno_i =
                      (SELECT MAX(inspection_detail.inspection_detailno_i)
                         FROM inspection_detail
                        WHERE inspection_detail.ref_type = 'RO'
                          AND inspection_detail.ref_key = rotables.psn)) = 1 OR
              (SELECT od_rec_detail.status
                 FROM od_rec_detail
                WHERE od_rec_detail.recdetailno_i =
                      (SELECT MAX(od_rec_detail.recdetailno_i)
                         FROM od_rec_detail
                        WHERE od_rec_detail.psn = rotables.psn)) = 2 THEN
          'Y'
         ELSE
          'N'
       END COL_PARTLY_RECEIVED,
       rotables.psn,
       rotables.orderno,
       rotables.projectno_i,
       rotables.entityno_i,
       project.projectno,
       location.location_restriction,
       location.location_type,
       location.owner,
       location.locationno_i,
       location.location,
       location.station,
       location.store,
       part.partno,
       part.mat_class,
       part.ac_typ,
       part.description,
       part_fa_entity.average_price,
       part.measure_unit,
       part.repairable,
       MAX(od_rec_detail.recdetailno_i) REC_DETAILNO_I
  FROM rotables
  JOIN location
    ON rotables.locationno_i = location.locationno_i
  JOIN part
    ON rotables.partno = part.partno
  JOIN part_fa_entity
    ON rotables.partno = part_fa_entity.partno
   AND part_fa_entity.entityno_i = rotables.entityno_i
  LEFT JOIN project
    ON rotables.projectno_i = project.projectno_i
  LEFT JOIN od_rec_detail
    ON od_rec_detail.partno = rotables.partno
   AND od_rec_detail.serialno = rotables.serialno
 WHERE rotables.ac_registr IN (' ', 'TRANSF')
   AND rotables.partnonew = ' '
   AND (rotables.outgoing_detailno_i IS NULL OR
       rotables.locationno_i &lt;&gt; -200)   
   AND location.location_storage_type = 'ST'
   AND rotables.partno = '@VAR.Partno@'
   AND location.station = '@VAR.Station@' 
   AND location.location_type IN (0, 2, 1, -104, -6, -4)
 GROUP BY rotables.partno,
          rotables.serialno,
          rotables.labelno,
          rotables.owner,
          rotables.condition,
          rotables.psn,
          rotables.orderno,
          rotables.projectno_i,
          rotables.entityno_i,
          project.projectno,
          location.location_restriction,
          location.location_type,
          location.owner,
          location.locationno_i,
          location.location,
          location.station,
          location.store,
          part.partno,
          part.mat_class,
          part.ac_typ,
          part.description,
          part_fa_entity.average_price,
          part.measure_unit,
          part.repairable</se:textStatement>
        </se:sqlStatement>
