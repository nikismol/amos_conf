        <ds:columnDescriptor amosType="ALPHANUM" description="r_serialno" id="r_serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case&#10;         when dimension = 'C' then&#10;          to_char(to_number(absolute_due_at_ac))&#10;         else&#10;          ' - '&#10;       end limit_cyc" id="limit_cyc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="'MSN: ' || a.serialno || ' ' || ad.name origin" id="origin"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(r.mfg_date&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + r.mfg_date'dd.mm.yyyy')) mfg_date" id="mfg_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case&#10;         when oh_at_date &gt; 1 then&#10;          decode(oh_at_date&#10;                 0&#10;                 null&#10;                 to_char(to_date('31.12.1971' 'dd.mm.yyyy') + oh_at_date'dd.mm.yyyy'))&#10;         else&#10;          'Not PFMD'&#10;       end overhaul_date" id="overhaul_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(r.date_inst&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + r.date_inst'dd.mm.yyyy')) on_ac_date" id="on_ac_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       round(sysdate - to_date('01.01.1972' 'dd.mm.yyyy')0) - r.mfg_date tsn_day" id="tsn_day"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       round(c.life_value_max2) tsn_fhr" id="tsn_fhr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       round(c.life_value_min0) tsn_cyc" id="tsn_cyc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       round(sysdate - to_date('01.01.1972' 'dd.mm.yyyy')0) - a.mfg_date tso_day" id="tso_day"/>
