        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RAM_LLP_STATUS_grouping.r_serialno@">
          <ds:object>@RAM_LLP_STATUS_grouping.r_serialno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY p.partno, r.serialno) num,
       sub.tree_type,
	   sub.description,
       r.psn,
       p.description,
       p.partno,
       r_partno,
       r.serialno,
       r_serialno,
       case
         when dimension = 'C' then
          to_char(to_number(absolute_due_at_ac))
         else
          ' - '
       end limit_cyc,
       'MSN: ' || a.serialno || ' ' || ad.name origin,
       decode(r.mfg_date,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + r.mfg_date,
                      'dd.mm.yyyy')) mfg_date,
       case
         when oh_at_date &gt; 1 then
          decode(oh_at_date,
                 0,
                 null,
                 to_char(to_date('31.12.1971', 'dd.mm.yyyy') + oh_at_date,
                         'dd.mm.yyyy'))
         else
          'Not PFMD'
       end overhaul_date,
       decode(r.date_inst,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + r.date_inst,
                      'dd.mm.yyyy')) on_ac_date,
       round(sysdate - to_date('01.01.1972', 'dd.mm.yyyy'), 0) - r.mfg_date tsn_day,
       round(c.life_value_max, 2) tsn_fhr,
       round(c.life_value_min, 0) tsn_cyc,
       round(sysdate - to_date('01.01.1972', 'dd.mm.yyyy'), 0) - a.mfg_date tso_day,
       round(d.life_value_max + c.life_value_max, 2) tso_fhr,
       round(d.life_value_min + c.life_value_min, 0) tso_cyc,
       to_char(to_number(absolute_due_at_ac)) - c.life_value_min remain_cyc,
       rr.text,
       case
         when r.location = ' ' then
          l.location
         else
          r.location
       end position,
       r.ac_registr,
       round(r.oh_at_tsn, 2) oh_at_tsn,
       round(r.oh_at_csn, 0) oh_at_csn
  from rotables r
  /* Нахожу дерево по партийнику/серийнику */
  join (select partno, serialno, tree_chapter, tree_type, description, r_partno, r_serialno
          from (select tr.tree_chapter,
                       tree_number,
                       tr.tree_type,
                       tree_number,
                       prev_number,
                       case
                         when tree_chapter = r.partno then
                          r.partno
                         else
                          sub.partno
                       end partno,
                       case
                         when tree_chapter = r.partno then
                          r.serialno
                         else
                          sub.serialno
                       end serialno,
                       r.partno r_partno,
                       r.serialno r_serialno,
                       sub.partno sub_part,
                       sub.serialno sub_ser,
                       sub.partnonew sub_part_new,
                       sub.serialnonew sub_ser_new,
					   tt.description
                  from rotables r
                  join rotables sub on r.partno = sub.partnonew
                                   and r.serialno = sub.serialnonew
                  join tree_reference tr on r.tree_type = tr.tree_type
				  join tree_type tt on tr.tree_type = tt.tree_type
                 where (/* Partnumber */
 ('@VAR.partno@' is null or
 sub.partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
                       and /* Serial No */
 ('@VAR.serialno@' is null or
 sub.serialno in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))
                       )
                    or (/* Partnumber */
 ('@VAR.partno@' is null or
 r.partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
                       and /* Serial No */
 ('@VAR.serialno@' is null or
 r.serialno in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))
                       )
and r.serialno in ('@RAM_LLP_STATUS_grouping.r_serialno@')) c) sub on r.partno = sub.partno and r.serialno = sub.serialno
  join part p on r.partno = p.partno
  left join rotables_remarks rr on r.psn = rr.psn
                               and rr.recno = 1
  left join location l on r.locationno_i = l.locationno_i
  left join forecast f on r.psn = f.psn
                      and event_type = 'R'
                      and dimension = 'C'
  join aircraft a on r.ac_registr = a.ac_registr
  join address ad on a.owner = ad.vendor
  join (select c.ref_key,
               max(c.life_value) / 60 life_value_max,
               min(c_min.life_value) life_value_min
          from counter c
          join counter c_min on c.counterno_i = c_min.counterno_i
         where c.readout_ref_type = 'LEG'
           and c_min.readout_ref_type = 'LEG'
         group by c.ref_key, c_min.ref_key) c on a.aircraftno_i = c.ref_key
  join (select c.ref_key,
               max(c.life_value) / 60 life_value_max,
               min(c_min.life_value) life_value_min
          from counter c
          join counter c_min on c.counterno_i = c_min.counterno_i
         where c.ref_type = 'RO'
           and c_min.ref_type = 'RO'
           and c.master_counterno_i is not null
           and c_min.master_counterno_i is not null
         group by c.ref_key, c_min.ref_key) d on r.psn = d.ref_key</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
