        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       round(d.life_value_min + c.life_value_min0) tso_cyc" id="tso_cyc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_number(absolute_due_at_ac)) - c.life_value_min remain_cyc" id="remain_cyc"/>
