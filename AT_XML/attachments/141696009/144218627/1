    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Open_Dismantling" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Поиск открытых демонтажей</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="t1.labelno" id="t1.labelno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t1.vm" id="t1.vm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when  hist.vm = 'YE' then 'Монтажи без демонтажей'&#10;&#9; when  hist.vm = 'YA' then 'Открытые демонтажи'&#10;&#9; else 'NO VALUES'&#10;&#9; end   vm_desc" id="vm_desc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist.serialno" id="hist.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist.partno" id="hist.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist.labelno" id="hist.labelno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist.ac_registr" id="hist.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist.location" id="hist.location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist.station" id="hist.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" decode(t1_created_date&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + t1_created_date'dd.mm.yyyy')) created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;decode(t1_mutation_time&#10;              0&#10;              null&#10;              to_char(to_timestamp('00:00:00' 'HH24:MI:SS') + ((t1_mutation_time)/1000/60/60/24)'HH24:MI:SS')) mutation_time" id="mutation_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist.mutator" id="hist.mutator"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RAM_Open_Dismanting_vm_group.hist.vm@">
          <ds:object>@RAM_Open_Dismanting_vm_group.hist.vm@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.d_create@">
          <ds:object>@VAR.d_create@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.station@">
          <ds:object>@VAR.station@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.mutator@">
          <ds:object>@VAR.mutator@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.registr@">
          <ds:object>@VAR.registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select t1.labelno, 
       t1.vm,
       case when  hist.vm = 'YE' then 'Монтажи без демонтажей'
	 when  hist.vm = 'YA' then 'Открытые демонтажи'
	 else 'NO VALUES'
	 end   vm_desc,
	   row_number() over(ORDER BY hist.labelno) num, 
	   hist.serialno, 
	   hist.partno,
	   hist.labelno, 
	   hist.ac_registr, 
	   hist.location, 
	   hist.station, 
		decode(hist.created_date,
							   0,
							   null,
							   to_char(to_date('31.12.1971', 'dd.mm.yyyy') + hist.created_date,
									   'dd.mm.yyyy')) created_date,
		decode(hist.mutation_time,
					  0,
					  null,
					  to_char(to_timestamp('00:00:00', 'HH24:MI:SS') + ((hist.mutation_time)/1000/60/60/24),
							  'HH24:MI:SS')) mutation_time,
		hist.mutator 
  from (select t_ya.labelno labelno, t_ya.vm vm
          from (select labelno, vm
                  from history
                 where history.vm in ('YA')
                   and history.labelno &lt;&gt; 0
                 group by labelno, vm
                 order by labelno) t_ya
          left join (select labelno, vm
                      from history
                     where history.vm in ('YE')
                       and history.labelno &lt;&gt; 0
                     group by labelno, vm
                     order by labelno) t_ye on t_ya.labelno = t_ye.labelno
         where t_ye.labelno is null
        union
        select t_ye2.labelno labelno, t_ye2.vm vm
          from (select labelno, vm
                  from history
                 where history.vm in ('YE')
                   and history.labelno &lt;&gt; 0
                 group by labelno, vm
                 order by labelno) t_ye2
          left join (select labelno, vm
                       from history
                      where history.vm in ('YA')
                        and history.labelno &lt;&gt; 0
                      group by labelno, vm
                      order by labelno) t_ya2 on t_ye2.labelno =
                                                 t_ya2.labelno
         where t_ya2.labelno is null) t1
         join history hist on t1.labelno = hist.labelno
         where hist.vm = '@RAM_Open_Dismanting_vm_group.hist.vm@'
         and LENGTH(hist.location) &gt;1
/* Created Date */
and hist.created_date &gt;= '@VAR.d_create@'
/* Station */
and ('@VAR.station@' is null or
hist.station = '@VAR.station@')
/* Mutator */
 and ('@VAR.mutator@' is null or
hist.mutator in
 (select trim(substr('@VAR.mutator@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.mutator@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.mutator@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.mutator@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.mutator@') -
              length(replace('@VAR.mutator@', ',', '')) + 1))
/* A/C Registration */
 and ('@VAR.registr@' is null or
hist.ac_registr in
 (select trim(substr('@VAR.registr@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.registr@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.registr@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.registr@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.registr@') -
              length(replace('@VAR.registr@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
