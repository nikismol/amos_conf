               -- 1. Нашла дерево парта
                 join (select tr.tree_type, description, partno
                                from (select altpartno partno
                                        from part_alternate pa
                                       where /* Partnumber */
 ('@VAR.partno@' is null or
partno in
 (select trim(substr('@VAR.partno@' || ',',
