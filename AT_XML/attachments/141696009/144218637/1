    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Availability_of_parts" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Наличие зпч и компонентов</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY partno_high) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno_high" id="partno_high"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qty_parts" id="qty_parts"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="us_qty" id="us_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="outgoing_qty" id="outgoing_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="orders_qty" id="orders_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qty_parts + us_qty + outgoing_qty + orders_qty total" id="total"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.altpart@">
          <ds:object>@VAR.altpart@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY partno_high) num
, partno_high
, case when mat_class = 'C' then 'Consumable'
	   when mat_class = 'R' then 'Rotable'
	   when mat_class = 'E' then 'Expendable'
	  else 'Other mat. class'
   end mat_class
, qty_parts
, us_qty
, outgoing_qty
, orders_qty
, qty_parts + us_qty + outgoing_qty + orders_qty total
  from (select x.partno partno_high, x.partno, mat_class, qty_parts, us_qty, outgoing_qty, orders_qty
	from (select c.partno
  , case when qty_parts is null then 0 else qty_parts end qty_parts
  , case when us_qty is null then 0 else us_qty end us_qty
  , case when outgoing_qty is null then 0 else outgoing_qty end outgoing_qty
  , case when orders_qty is null then 0 else orders_qty end orders_qty
			from consumables c
	   left join (select sum(round(qty, 0)) qty_parts, partno
					from consumables c
					join location l on c.locationno_i = l.locationno_i 
				   where location_restriction in (0, 1)
		        group by partno) stand on c.partno = stand.partno
	   left join (select sum(round(qty,0)) us_qty, partno
					from consumables c
				   where condition = 'US'
				 group by partno) us on c.partno = us.partno
	   left join (select sum(round(qty, 0)) outgoing_qty, partno
					from consumables c
					join location l on c.locationno_i = l.locationno_i 
				   where l.location = 'OUTGOING' 
				     and l.station = ' '
					 and l.store = ' '
		        group by partno) out on c.partno = out.partno
	   left join (select sum(d.qty) orders_qty, d.partno
					from od_detail d 
					join part p on d.partno = p.partno and p.mat_class = 'C'
				   where order_type in ('P', 'PR', 'L', 'Y')
				   and ext_state = 'O'
		        group by d.partno) ord on c.partno = ord.partno
    union 
		  select r.partno
  , case when qty_parts is null then 0 else qty_parts end qty_parts
  , case when us_qty is null then 0 else us_qty end us_qty
  , case when outgoing_qty is null then 0 else outgoing_qty end outgoing_qty
  , case when orders_qty is null then 0 else orders_qty end orders_qty
			from rotables r
	   left join (select count(partno) qty_parts, partno
					from rotables r
					join location l on r.locationno_i = l.locationno_i 
				   where location_restriction in (0, 1)
				group by partno) stand on r.partno = stand.partno
	   left join (select count(partno) us_qty, partno
					from rotables r
				   where condition = 'US'
				group by partno) us on r.partno = us.partno
	   left join (select count(partno) outgoing_qty, partno
					from rotables r
					join location l on r.locationno_i = l.locationno_i 
				   where l.location = 'OUTGOING' 
				     and l.station = ' '
					 and l.store = ' '
		        group by partno) out on r.partno = out.partno
	   left join (select sum(round(qty, 0)) orders_qty, d.partno, d.orderno_i
					from od_detail d
					join od_header h on d.orderno_i = h.orderno_i
					join rotables r on d.partno = r.partno and h.orderno = r.orderno 
				   where d.order_type in ('P', 'PR', 'L', 'Y')
				   and d.ext_state = 'O'
		        group by d.partno, d.orderno_i) ord on r.partno = ord.partno) x
	join part p on x.partno = p.partno
 UNION
select p.partno partno_high, x.partno, mat_class, qty_parts, us_qty, outgoing_qty, orders_qty
	from (select pa.altpartno, pa.partno
  , case when qty_parts is null then 0 else qty_parts end qty_parts
  , case when us_qty is null then 0 else us_qty end us_qty
  , case when outgoing_qty is null then 0 else outgoing_qty end outgoing_qty
  , case when orders_qty is null then 0 else orders_qty end orders_qty
			from part_alternate pa
	   left join (select sum(round(qty, 0)) qty_parts, partno
					from consumables c
					join location l on c.locationno_i = l.locationno_i 
				   where location_restriction in (0, 1)
		        group by partno) stand on pa.altpartno = stand.partno
	   left join (select sum(round(qty,0)) us_qty, partno
					from consumables c
				   where condition = 'US'
				 group by partno) us on pa.altpartno = us.partno
	   left join (select sum(round(qty, 0)) outgoing_qty, partno
					from consumables c
					join location l on c.locationno_i = l.locationno_i 
				   where l.location = 'OUTGOING' 
				     and l.station = ' '
					 and l.store = ' '
		        group by partno) out on pa.altpartno = out.partno
	   left join (select sum(d.qty) orders_qty, d.partno
					from od_detail d 
					join part p on d.partno = p.partno and p.mat_class = 'C'
				   where order_type in ('P', 'PR', 'L', 'Y')
				   and ext_state = 'O'
		        group by d.partno) ord on pa.altpartno = ord.partno
	   join part p on pa.altpartno = p.partno and mat_class = 'C'
    union 
		  select pa.altpartno, pa.partno
  , case when qty_parts is null then 0 else qty_parts end qty_parts
  , case when us_qty is null then 0 else us_qty end us_qty
  , case when outgoing_qty is null then 0 else outgoing_qty end outgoing_qty
  , case when orders_qty is null then 0 else orders_qty end orders_qty
			from part_alternate pa
	   left join (select count(partno) qty_parts, partno
					from rotables r
					join location l on r.locationno_i = l.locationno_i 
				   where location_restriction in (0, 1)
				group by partno) stand on pa.altpartno = stand.partno
	   left join (select count(partno) us_qty, partno
					from rotables r
				   where condition = 'US'
				group by partno) us on pa.altpartno = us.partno
	   left join (select count(partno) outgoing_qty, partno
					from rotables r
					join location l on r.locationno_i = l.locationno_i 
				   where l.location = 'OUTGOING' 
				     and l.station = ' '
					 and l.store = ' '
		        group by partno) out on pa.altpartno = out.partno
	   left join (select sum(round(qty, 0)) orders_qty, d.partno, d.orderno_i
					from od_detail d
					join od_header h on d.orderno_i = h.orderno_i
					join rotables r on d.partno = r.partno and h.orderno = r.orderno 
				   where d.order_type in ('P', 'PR', 'L', 'Y')
				   and d.ext_state = 'O'
		        group by d.partno, d.orderno_i) ord on pa.altpartno = ord.partno) x
	join part p on x.altpartno = p.partno
	where '@VAR.altpart@' = 'Y') t
where /* Партийный номер */
	('@VAR.partno@' is null or
	  partno in
	 (select trim(substr('@VAR.partno@' || ',',
						  decode(level,
								 1,
								 0,
								 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
						  instr('@VAR.partno@' || ',', ',', 1, level) -
						  decode(level,
								 1,
								 1,
								 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
		 from dual
	   connect by level &lt;= length('@VAR.partno@') -
				  length(replace('@VAR.partno@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
