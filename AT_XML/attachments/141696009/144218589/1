CASE when regexp_like(a.ac_typ, 'RRJ*') THEN 'Номер работы' ELSE 'Event Number' END as lb_ad_works_eventno,
CASE when regexp_like(a.ac_typ, 'RRJ*') THEN 'Описание работы' ELSE 'Title' END as lb_ad_works_title
