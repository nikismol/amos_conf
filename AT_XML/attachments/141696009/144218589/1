    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="HIGH" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.ac_typ" id="wph.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.ac_registr" id="wph.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.wpno" id="wph.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.description" id="wph.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="at.serialno" id="at.serialno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT wph.ac_typ,
       wph.ac_registr,
       wph.wpno,
       wph.description,
       at.serialno
FROM wp_header wph
JOIN aircraft at ON at.ac_registr = wph.ac_registr
WHERE wph.wpno_i = '@VAR.WP@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="JCOP" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ws.seqno_i as seqno" id="seqno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wel.event_name as name" id="name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mt.title as title" id="title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tb_part.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="zn.tzone" id="zn.tzone"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  wp_sequence.seqno_i as seqno,
                wo_event_link.event_name as name,
                msc_taskcard.title as title,
                wo_header.event_perfno_i,
                REGEXP_REPLACE (
                                RTRIM(XMLAGG(XMLELEMENT(E, part_request_template.partno, decode(part_request_template.partno, null, null, ', ')).EXTRACT('//text()') ORDER BY part_request_template.partno).GetClobVal(), CHR(10))
                                , '(, )$'
                                , '') as partno,
                zn.tzone
FROM wp_header 
LEFT JOIN wp_assignment ON wp_header.wpno_i = wp_assignment.wpno_i 
LEFT JOIN wo_header ON  wo_header.event_perfno_i = wp_assignment.event_perfno_i 
LEFT JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i 
LEFT JOIN wp_sequence ON wp_sequence.event_perfno_i = wo_header.event_perfno_i and wp_sequence.wpno_i = wp_header.wpno_i
LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wp_assignment.event_perfno_i 
LEFT JOIN (
                    SELECT workstep_link.event_perfno_i,
                                  LISTAGG(zone_code_link.zone, ', ') WITHIN GROUP (ORDER BY zone_code_link.zone) as tzone
                    FROM zone_code_link 
                    JOIN workstep_link ON zone_code_link.source_pk = workstep_link.descno_i
                    WHERE 1=1
                                   AND  zone_code_link.source_type = 'WS'
                    GROUP BY workstep_link.event_perfno_i
                   ) zn ON zn.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN msc_requirement_tc_link ON  msc_requirement_tc_link.req_linkno_i=wo_event_link.event_key_parent AND (wo_event_link.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MET' AND '@AMOS_VERSION@' NOT LIKE '19.12%')
LEFT JOIN msc_taskcard_version ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri
LEFT JOIN msc_taskcard ON msc_taskcard.taskcardno_i = msc_taskcard_version.taskcardno_i 
LEFT JOIN part_request_template ON workstep_link.descno_i = part_request_template.event_key AND part_request_template.event_type = 'WS' AND part_request_template.partno IS NOT NULL
WHERE wp_header.wpno_i = @VAR.WP@ 
               AND (wo_event_link.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MET' AND '@AMOS_VERSION@' NOT LIKE '19.12%')
               AND wp_assignment.event_perfno_i NOT IN (
                                                                                                   SELECT wo_event_chain.source_event_perfno_i     
                                                                                                   FROM wo_event_chain 
                                                                                                   WHERE wo_event_chain.source_event_perfno_i IN (
                                                                                                                                                                                                  SELECT wp_assignment.event_perfno_i 
                                                                                                                                                                                                  FROM wp_assignment 
                                                                                                                                                                                                  WHERE wp_assignment.wpno_i = @VAR.WP@
                                                                                                                                                                                                 ) 
                                                                                                                  OR
                                                                                                                  wo_event_chain.target_event_perfno_i IN (
                                                                                                                                                                                                 SELECT wp_assignment.event_perfno_i 
                                                                                                                                                                                                 FROM wp_assignment
                                                                                                                                                                                                 WHERE wp_assignment.wpno_i = @VAR.WP@ 
                                                                                                                                                                                                ) 
                                                                                                  )
GROUP BY wp_sequence.seqno_i, wo_event_link.event_name, msc_taskcard.title, wo_header.event_perfno_i, zn.tzone
ORDER BY wp_sequence.seqno_i asc</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WPCHECK" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.seqno_i as seq" id="seq"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event_name as event_name" id="event_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cti.description as description" id="description"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT wps.seqno_i as seq,
       wel.event_name as event_name,
       (
          SELECT distinct cti.description            
          FROM check_type_int cti            
          WHERE cti.check_intno_i = wel.event_key_parent        
       ) as description      
FROM wp_header wph  
JOIN wp_assignment ass ON wph.wpno_i = ass.wpno_i    
JOIN wo_header wo ON wo.event_perfno_i = ass.event_perfno_i    
JOIN wo_event_link wel ON wel.event_perfno_i = wo.event_perfno_i  
LEFT JOIN wp_sequence wps ON wps.event_perfno_i = wo.event_perfno_i
JOIN aircraft air ON air.ac_registr = wph.ac_registr  
WHERE wph.wpno_i = '@VAR.WP@'                     
      and wo.event_type = 'C' 
ORDER BY 
             CASE        
