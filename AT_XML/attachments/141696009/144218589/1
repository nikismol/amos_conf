        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT a.ac_typ,
CASE when regexp_like(a.ac_typ, 'RRJ*') THEN 'ПЕРЕЧЕНЬ ЗАДАЧ ТО, ДОПОЛНИТЕЛЬНЫХ ' ELSE 'WORK PACKAGE HIGHLIGHT (WORK ORDER)' END as lb_WPH,
