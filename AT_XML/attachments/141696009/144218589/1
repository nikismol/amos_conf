      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT rev.revision_no as rev_no, iss.issue_no as issue, rev.revision_date as rev_date, iss.issue_date as issue_date
