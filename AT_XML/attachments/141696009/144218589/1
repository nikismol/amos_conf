    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WOHIGH" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.seqno_i as seq" id="seq"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.ext_workorderno as wo_nom" id="wo_nom"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="des.text as text" id="text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tb_part.partno as partno" id="partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT s.seqno_i as seq,
       wo.workorderno_display as wo_nom,
       des.text as text,
       tb_part.partno as partno
FROM wp_header wph
JOIN wp_assignment wpa ON wph.wpno_i = wpa.wpno_i
JOIN wo_header wo ON wo.event_perfno_i = wpa.event_perfno_i 
JOIN wp_sequence s ON s.event_perfno_i = wo.event_perfno_i and s.wpno_i = wph.wpno_i 
JOIN workstep_link ws ON ws.event_perfno_i = wo.event_perfno_i
JOIN wo_text_description des ON des.descno_i = ws.descno_i
LEFT JOIN 
(SELECT wpas.event_perfno_i, LISTAGG (pr.partno, ', ') WITHIN GROUP (ORDER BY pr.partno) as partno
FROM part_request_2 pr
JOIN workstep_link wl ON wl.workstep_linkno_i = pr.event_key
JOIN  wp_assignment wpas ON wpas.event_perfno_i = wl.event_perfno_i
JOIN wp_header wh ON wh.wpno_i = wpas.wpno_i
JOIN wo_header woh ON woh.event_perfno_i = wpas.event_perfno_i 
WHERE wh.wpno_i = '@VAR.WP@'
GROUP BY wpas.event_perfno_i) tb_part
ON tb_part.event_perfno_i = wpa.event_perfno_i
WHERE wph.wpno_i = '@VAR.WP@'
AND wo.type in ('S','M','C','P')
AND wo.workorderno_display is not null
AND wo.event_type not in ('C','T','Q')
AND ws.sequenceno  = 1
order by seq asc</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
