      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT wp_sequence.seqno_i as seqno_i
              ,wo_header.event_perfno_i as event_perfno_i
              ,wo_event_link.event_display as event_display
              ,wo_text_description.header||' '||TO_CHAR(DBMS_LOB.SUBSTR(NVL(wo_text_description.text, wo_text_description.text_html), 2000, 1)) as wo_text
FROM wp_header
JOIN wp_assignment ON wp_header.wpno_i = wp_assignment.wpno_i
JOIN wo_header ON wo_header.event_perfno_i = wp_assignment.event_perfno_i 
JOIN wp_sequence ON wp_sequence.event_perfno_i = wo_header.event_perfno_i AND wp_sequence.wpno_i = wp_header.wpno_i 
JOIN workstep_link ws_text ON ws_text.event_perfno_i = wo_header.event_perfno_i AND ws_text.sequenceno = 1
