CASE when regexp_like(a.ac_typ, 'RRJ*') THEN 'Согласно программе ТО:' ELSE 'According to Maintenance Programme:' END as lb_amp,
CASE when regexp_like(a.ac_typ, 'RRJ*') THEN 'АЭРОФЛОТ - РОССИЙСКИЕ АВИАЛИНИИ' ELSE 'AEROFLOT-RUSSIAN AIRLINES' END as lb_mp,
