CASE when regexp_like(a.ac_typ, 'RRJ*') THEN '' ELSE 'WORK ORDERS' END as lb_WO2,
CASE when regexp_like(a.ac_typ, 'RRJ*') THEN 'РЕГЛАМЕНТНЫЕ РАБОТЫ, НЕ ВКЛЮЧЕННЫЕ В ОБЪЁМ  ФОРМЫ ТО' ELSE '' END as lb_jcop,
