    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="34_Components_install" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>main rep</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_number(row_number() over(ORDER BY r.partnor.serialno)) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.ac_typ" id="h.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.ac_registr" id="r.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + r.date_inst'dd.mm.yyyy') date_inst" id="date_inst"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.partno" id="r.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.serialno" id="r.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="woh.event_perfno_i wo_num" id="wo_num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when ph.booking_time &gt; 0 then 'Booked' else 'Not Booked' end book" id="book"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ph.pickslipno" id="ph.pickslipno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   to_char(to_date('31.12.1971' 'dd.mm.yyyy') + ph.pickslip_date'dd.mm.yyyy') confirm_date" id="confirm_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       (select listagg(requirement.description '') within group(order by requirement.description) as wow&#10;    &#9;&#9;from part_req&#10;            join requirement on part_req.requirement = requirement.requirement&#10;&#9;&#9;&#9;where p.partseqno_i = part_req.partseqno_i&#10;&#9;&#9;&#9;and part_req.requirement_status &lt;&gt; 9&#10;&#9;&#9;&#9;group by partseqno_i) require" id="require"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when certificate_i is not null then 'Y'&#10;&#9;&#9;else 'N'&#10;&#9;&#9;end certificate" id="certificate"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@34_Components_inst_AC_GROUPED.ac_typ@">
          <ds:object>@34_Components_inst_AC_GROUPED.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@34_Components_inst_AC_GROUPED.ac_registr@">
          <ds:object>@34_Components_inst_AC_GROUPED.ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.d_from@">
          <ds:object>@VAR.d_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.t_date@">
          <ds:object>@VAR.t_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.book@">
          <ds:object>@VAR.book@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select to_number(row_number() over(ORDER BY r.date_inst, r.partno, r.serialno desc)) num,
       h.ac_typ,
       r.ac_registr,
       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + r.date_inst, 'dd.mm.yyyy') date_inst,
       r.partno,
       r.serialno,
       woh.event_perfno_i wo_num,
       case when ph.booking_time &gt; 0 then 'Booked' else 'Not Booked' end book,
	   ph.pickslipno,
	   to_char(to_date('31.12.1971', 'dd.mm.yyyy') + ph.pickslip_date, 'dd.mm.yyyy') confirm_date,
       (select listagg(requirement.description, ', ') within group(order by requirement.description) as wow
    		from part_req
            join requirement on part_req.requirement = requirement.requirement
			where p.partseqno_i = part_req.partseqno_i
			and part_req.requirement_status &lt;&gt; 9
			group by partseqno_i) require,
	   case when certificate_i is not null then 'Y'
		else 'N'
		end certificate
from rotables r
join part p on r.partno = p.partno
join history h on r.psn = h.psn and vm = 'YE' and r.ac_registr = h.ac_registr    
join wo_header woh on h.event_perfno_i = woh.event_perfno_i   
join (select event_perfno_i, partno, pickslipno 
        from pickslip_detail 
       group by event_perfno_i, partno, pickslipno)pd on h.event_perfno_i = pd.event_perfno_i and r.partno = pd.partno   
join pickslip_header ph on pd.pickslipno = ph.pickslipno and r.ac_registr = ph.receiver
left join certificate c on r.psn = c.source_key and c.source_type = 'RO'
where h.ac_typ in ('@34_Components_inst_AC_GROUPED.ac_typ@')
  and r.ac_registr in ('@34_Components_inst_AC_GROUPED.ac_registr@')
  /* дата установки с.. по.. */
  and ('@VAR.d_from@' is null or r.date_inst &gt;= '@VAR.d_from@') 
  and ('@VAR.t_date@' is null or r.date_inst &lt;= '@VAR.t_date@')
  /* Special Location */
  and (
   nvl('@VAR.book@', 1) = 1 or ('@VAR.book@' = 2 and ph.booking_time &gt; 0) or ('@VAR.book@' = 3 and ph.booking_time is null)
      )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
