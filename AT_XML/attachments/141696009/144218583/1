      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select ac_typ, ac_registr
     , (select count(*) cnt
          from rotables r
          join history h on r.psn = h.psn and vm = 'YE' and r.ac_registr = h.ac_registr    
          join wo_header woh on h.event_perfno_i = woh.event_perfno_i   
          join pickslip_detail pd on h.event_perfno_i = pd.event_perfno_i and r.partno = pd.partno   
          join pickslip_header ph on pd.pickslipno = ph.pickslipno and r.ac_registr = ph.receiver
          left join certificate c on r.psn = c.source_key and c.source_type = 'RO'
          where /* ac type  */
	  ('@VAR.ac_typ@' is null or
		 h.ac_typ in
		 (select trim(substr('@VAR.ac_typ@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.ac_typ@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.ac_typ@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.ac_typ@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.ac_typ@') -
					  length(replace('@VAR.ac_typ@', ',', '')) + 1)) 
/* ac registr */
	  and ('@VAR.ac_reg@' is null or
		 h.ac_registr in
		 (select trim(substr('@VAR.ac_reg@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.ac_reg@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.ac_reg@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.ac_reg@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.ac_reg@') -
					  length(replace('@VAR.ac_reg@', ',', '')) + 1))
        /* дата установки с.. по.. */
            and ('@VAR.d_from@' is null or r.date_inst &gt;= '@VAR.d_from@') 
            and ('@VAR.t_date@' is null or r.date_inst &lt;= '@VAR.t_date@')
        /* Special Location */
            and (nvl('@VAR.book@', 1) = 1 or ('@VAR.book@' = 2 and ph.booking_time &gt; 0) or ('@VAR.book@' = 3 and ph.booking_time is null)) ) cnt
  from aircraft
where /* ac type  */
	  ('@VAR.ac_typ@' is null or
		 ac_typ in
		 (select trim(substr('@VAR.ac_typ@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.ac_typ@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.ac_typ@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.ac_typ@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.ac_typ@') -
					  length(replace('@VAR.ac_typ@', ',', '')) + 1)) 
/* ac registr */
	  and ('@VAR.ac_reg@' is null or
		 ac_registr in
		 (select trim(substr('@VAR.ac_reg@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.ac_reg@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.ac_reg@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.ac_reg@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.ac_reg@') -
					  length(replace('@VAR.ac_reg@', ',', '')) + 1))
  group by ac_typ, ac_registr</se:textStatement>
