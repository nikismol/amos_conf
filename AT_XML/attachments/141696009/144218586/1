      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select order_type
from od_header
where /* Order Type */
('@VAR.type_PU@' = 'Y' and order_type = 'PU') or ('@VAR.type_YU@' = 'Y' and order_type = 'YU') or ('@VAR.type_R@' = 'Y' and order_type = 'R') or ('@VAR.type_PX@' = 'Y' and order_type = 'PX') or ('@VAR.type_LU@' = 'Y' and order_type = 'LU') or ('@VAR.type_X@' = 'Y' and order_type = 'X') 
or (('@VAR.type_PU@' = 'N' and '@VAR.type_YU@' = 'N' and '@VAR.type_R@' = 'N' and '@VAR.type_PX@' = 'N' and '@VAR.type_LU@' = 'N' and '@VAR.type_X@' = 'N') and order_type in ('PU', 'YU', 'X', 'PX', 'R', 'LU') )
group by order_type</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
