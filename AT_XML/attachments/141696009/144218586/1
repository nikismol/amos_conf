      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select row_number() over(ORDER BY orderdate, orderno) num,
       orderno,
	   orderno_i,
       decode(orderdate, 0, null, to_char(to_date('31.12.1971', 'dd.mm.yyyy') + orderdate, 'dd.mm.yyyy')) orderdate,
       order_type,
        case when state = 'O' then 'Open'
	        when state = 'C' then 'Closed'
			when state = 'T' then 'Temporary'
			when state = 'N' then 'Not correctly filled'
			else 'UNKNOWN'
	   end state,
       ext_orderno,
       posno,
       ext_state,
       vendor,
       addressname,
       partno,
       serialno,
       labelno,
       description,
       qty,
       backorder,
       shipmentno,
       targatedate,
       shipmentno_i,
       locationno_i,
       station,
       store,
	   location
from
(select h.orderno,
       h.orderno_i,
       h.orderdate,
       h.order_type,
       h.state,
       h.ext_state,
       h.ext_orderno,
       d.posno,
       to_date('31.12.1971', 'dd.mm.yyyy') + d.entry_date order_pos_entry_date,
       s.vendor,
       s.name addressname,
       d.partno,
       d.serialno,
       decode(d.labelno, 0, null, d.labelno) labelno,
       p.description,
       d.qty,
       d.backorder,
       null shipmentno,
       null targatedate,
       oesh.shipmentno_i,
       case
         when d.target_date = 0 then
          null
         else
          to_date('31.12.1971', 'dd.mm.yyyy') + d.target_date
       end target_date,
       l.locationno_i,
       l.station,
       l.store,
       ss.station_storeno_i,
       l.location,
	   ss.address_i
  from od_header h
  JOIN od_detail d ON h.orderno_i = d.orderno_i
  left join consumables c on d.partno = c.partno
  join location l on c.locationno_i = l.locationno_i
  left join station_store ss on ss.station = l.station and ss.store = l.store
  left join address s on h.vendor = s.vendor
  left join part p on p.partno = d.partno
  left join (select sd.od_detailno_i, sd.shipmentno_i
               from sh_detail sd,
                    sh_header sh
              where sd.shipmentno_i = sh.shipmentno_i
                and sh.type = 'EO') oesh on d.detailno_i =
                                            oesh.od_detailno_i
 union
 select h.orderno,
       h.orderno_i,
       h.orderdate,
       h.order_type,
       h.state,
       h.ext_state,
       h.ext_orderno,
       d.posno,
       to_date('31.12.1971', 'dd.mm.yyyy') + d.entry_date order_pos_entry_date,
       s.vendor,
       s.name addressname,
       d.partno,
       d.serialno,
       decode(d.labelno, 0, null, d.labelno) labelno,
       p.description,
       d.qty,
       d.backorder,
       null shipmentno,
       null targatedate,
       oesh.shipmentno_i,
       case
         when d.target_date = 0 then
          null
         else
          to_date('31.12.1971', 'dd.mm.yyyy') + d.target_date
       end target_date,
       l.locationno_i,
       l.station,
       l.store,
       ss.station_storeno_i,
       l.location,
	   ss.address_i
  from od_header h
  JOIN od_detail d ON h.orderno_i = d.orderno_i
  left join rotables r on d.serialno = r.serialno and d.partno = r.partno
  left join location l on r.locationno_i = l.locationno_i
  left join station_store ss on ss.station = l.station and ss.store = l.store
  left join address s on h.vendor = s.vendor
  left join part p on p.partno = d.partno
  left join (select sd.od_detailno_i, sd.shipmentno_i
               from sh_detail sd,
                    sh_header sh
              where sd.shipmentno_i = sh.shipmentno_i
                and sh.type = 'EO') oesh on d.detailno_i =
                                            oesh.od_detailno_i) t1
WHERE 
order_type in ('@RAM_Order_Tracking_types.order_type@')
/* Order No */
and ('@VAR.Odno@' is null or
orderno_i in
 (select trim(substr('@VAR.Odno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.Odno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.Odno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.Odno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.Odno@') -
              length(replace('@VAR.Odno@', ',', '')) + 1))
/* Order State  */    
and ('@VAR.Odst@' is null or
ext_state in
 (select trim(substr('@VAR.Odst@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.Odst@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.Odst@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.Odst@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.Odst@') -
              length(replace('@VAR.Odst@', ',', '')) + 1))
/* Order Date */
and (orderdate &gt;= '@VAR.Oddate@')
and ('@VAR.Oddate2@' is null or orderdate &lt;= '@VAR.Oddate2@')
/* Vendor */
and ('@VAR.Venad@' is null or
vendor in
 (select trim(substr('@VAR.Venad@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.Venad@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.Venad@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.Venad@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.Venad@') -
              length(replace('@VAR.Venad@', ',', '')) + 1))
/* Part No */
and ('@VAR.Partno@' is null or
partno in
 (select trim(substr('@VAR.Partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.Partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.Partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.Partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.Partno@') -
              length(replace('@VAR.Partno@', ',', '')) + 1))
/* Serial No */ 
and ('@VAR.Serno@' is null or
serialno in
 (select trim(substr('@VAR.Serno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.Serno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.Serno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.Serno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.Serno@') -
              length(replace('@VAR.Serno@', ',', '')) + 1))
/* Location */
 and ('@VAR.Location@' is null or
locationno_i in
 (select trim(substr('@VAR.Location@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.Location@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.Location@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.Location@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.Location@') -
              length(replace('@VAR.Location@', ',', '')) + 1))
/* Station store */
and ('@VAR.store@' is null or
address_i in
 (select trim(substr('@VAR.store@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.store@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.store@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.store@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.store@') -
              length(replace('@VAR.store@', ',', '')) + 1))
/* TRAN location */
and (
nvl('@VAR.tran_loc@', 'Y') = 'Y' or ('@VAR.tran_loc@' = 'N' and location &lt;&gt; 'TRANSFER' or location is null)
)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RAM_Order_Tracking_types" type="SQL_EDITOR_DATASOURCE" version="2.0">
