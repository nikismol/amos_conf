        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(orderdate 0 null to_char(to_date('31.12.1971' 'dd.mm.yyyy') + orderdate'dd.mm.yyyy')) orderdate" id="orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="order_type" id="order_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when state = 'O' then 'Open'&#10;&#9;        when state = 'C' then 'Closed'&#10;&#9;&#9;&#9;when state = 'T' then 'Temporary'&#10;&#9;&#9;&#9;when state = 'N' then 'Not correctly filled'&#10;&#9;&#9;&#9;else 'UNKNOWN'&#10;&#9;   end state" id="state"/>
