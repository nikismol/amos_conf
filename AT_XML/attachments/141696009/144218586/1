      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RAM_Order_Tracking_types.order_type@">
          <ds:object>@RAM_Order_Tracking_types.order_type@</ds:object>
        </ds:value>
