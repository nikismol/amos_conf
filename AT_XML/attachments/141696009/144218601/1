    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Leg_Removal_330" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno" id="history.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno" id="history.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.location" id="history.location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.ac_registr" id="history.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;&#9;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date+729)'DD.MM.YYYY')  date_rem" id="date_rem"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.event_perfno_i" id="history.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.labelno" id="history.labelno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 	part.description, 
		history.partno, 
		history.serialno, 
		history.location, 
		history.ac_registr,
		TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date+729), 'DD.MM.YYYY')  date_rem,
		history.event_perfno_i,
		history.labelno
FROM history
LEFT JOIN part ON  history.partno = part.partno
WHERE (history.location = '32L-A330' OR history.location = '32R-A330' OR history.location = '32N-A330-A' 
OR history.location = '32N-A330-B' OR history.location = '32L063-A330' OR history.location = '32R063-A330'
OR history.location = '32R063-A330' OR history.location = '32R064-A330' OR history.location = '32R064-A330') AND history.vm = 'YA' 
and history.del_date  &gt;= TRUNC (SYSDATE) - TO_DATE ('31.12.1971', 'dd.mm.yyyy') - 90 and history.del_date &lt;= TRUNC (SYSDATE) - TO_DATE ('31.12.1971', 'dd.mm.yyyy')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
