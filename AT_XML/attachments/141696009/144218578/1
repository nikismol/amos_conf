        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(FLOOR(fd_ah.togo/60)'99999999999999') as togo_apu_hours" id="togo_apu_hours"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(fd_ac.togo'99999999999999') as togo_apu_cycles" id="togo_apu_cycles"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(fd_ac.togo'99999999999999') as togo_apu_cycles&#10;tcs.descr as tcsource" id="tcsource"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(f.intereval_dimendion||''||f.interval_value) as interval" id="interval"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.Aircraft@">
          <ds:object>@VAR.Aircraft@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.Workpackage@">
          <ds:object>@VAR.Workpackage@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
f.ac_registr, 
f.ac_typ, 
TO_CHAR(TRUNC(sysdate) + f.est_mh/24/60, 'hh24:mi') as mh, 
TO_CHAR(TRUNC(sysdate) + f.est_groundtime/24/60, 'hh24:mi') as gt, 
REGEXP_SUBSTR(f.event_display, '[^/]+') as event,
REGEXP_REPLACE(f.event_display, '([^/]+)(/)(.*)', '\3') as event_desc,
wph.wpno,
CASE WHEN (f.date_planned &gt; 0 ) THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (f.date_planned+729), 'DD.MM.YYYY') ELSE '' END as planned_date,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (f.expected_date+729), 'DD.MM.YYYY') as expected_date,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (fd_d.expected_date+729), 'DD.MM.YYYY') as due_at_date,
TO_CHAR(FLOOR(fd_h.absolute_due_at_ac/60), '99999999999999') as due_at_hours,
TO_CHAR(fd_c.absolute_due_at_ac, '99999999999999') as due_at_cycles,
TO_CHAR(FLOOR(fd_d.togo/60/24), '99999999999999') as togo_days,
TO_CHAR(FLOOR(fd_h.togo/60), '99999999999999') as togo_hours,
TO_CHAR(fd_c.togo, '99999999999999') as togo_cycles,
TO_CHAR(FLOOR(fd_ah.absolute_due_at_ac/60), '99999999999999') as due_at_apu_hours,
TO_CHAR(fd_ac.absolute_due_at_ac, '99999999999999') as due_at_apu_cycles,
TO_CHAR(FLOOR(fd_ah.togo/60), '99999999999999') as togo_apu_hours,
TO_CHAR(fd_ac.togo, '99999999999999') as togo_apu_cycles,
tcs.descr as tcsource,
trs.interval as interval
FROM forecast f 
LEFT JOIN forecast_dimension fd_d ON (f.event_perfno_i = fd_d.event_perfno_i AND fd_d.dimension = 'D')
LEFT JOIN forecast_dimension fd_h ON (f.event_perfno_i = fd_h.event_perfno_i AND fd_h.dimension = 'H')
LEFT JOIN forecast_dimension fd_c ON (f.event_perfno_i = fd_c.event_perfno_i AND fd_c.dimension = 'C')
LEFT JOIN forecast_dimension fd_ah ON (f.event_perfno_i = fd_ah.event_perfno_i AND fd_ah.dimension = 'AH')
LEFT JOIN forecast_dimension fd_ac ON (f.event_perfno_i = fd_ac.event_perfno_i AND fd_ac.dimension = 'AC')
LEFT JOIN wp_header wph ON wph.wpno_i = f.wpno_i
LEFT JOIN (
			SELECT  
					LISTAGG (db_link.description, ';') WITHIN GROUP (ORDER BY db_link.description) as descr
					,wo_header.event_perfno_i as wonum 
			FROM wo_header 
			JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i
			JOIN requirement_header ON wo_event_link.event_key_parent = requirement_header.event_key AND requirement_header.event_type = 'TCREQLI'
			JOIN msc_requirement_tc_link ON requirement_header.event_key = msc_requirement_tc_link.req_linkno_i
			JOIN msc_item ON msc_requirement_tc_link.itemno_i_mri = msc_item.itemno_i
			JOIN msc_taskcard_version ON msc_item.taskcard_verno_i = msc_taskcard_version.taskcard_verno_i
			JOIN db_link ON db_link.source_pk=msc_taskcard_version.taskcard_verno_i  
			WHERE 
			db_link.source_type='TCLS' 
			AND 
			(db_link.ref_type='TCSOURCE' OR db_link.link_remarks  LIKE  '%TCSOURCE%')
			GROUP BY wo_header.event_perfno_i
			) tcs ON tcs.wonum = f.event_perfno_i
LEFT JOIN (
	SELECT woh.event_perfno_i as wonum, tr.event_type tp,
	(
			CASE WHEN int_d.vl IS NOT NULL THEN TO_CHAR(int_d.vl)|| CASE WHEN ((int_d.unit IS NULL) AND (int_d.vl IS NOT NULL)) THEN 'D' ELSE TO_CHAR(int_d.unit) END ELSE '-' END
			||'/'||
			CASE WHEN int_h.vl IS NOT NULL THEN TO_CHAR(int_h.vl) ELSE '-' END
			||'/'||
			CASE WHEN int_c.vl IS NOT NULL THEN TO_CHAR(int_c.vl) ELSE '-' END
			||'/'||
			CASE WHEN int_ah.vl IS NOT NULL THEN TO_CHAR(int_ah.vl) ELSE '-' END
			||'/'||
			CASE WHEN int_ac.vl IS NOT NULL THEN TO_CHAR(int_ac.vl) ELSE '-' END
	) 
	as interval 	 
	FROM 
		wo_header woh
  LEFT JOIN worktemplate_link wtl ON wtl.template_revisionno_i = woh.template_revisionno_i
  LEFT JOIN msc_item mi ON (wtl.event_key = mi.itemno_i AND wtl.event_type != 'CHTI')
  LEFT JOIN treq_time_requirement tr ON ((mi.taskcard_verno_i = tr.event_key AND wtl.event_type != 'CHTI') OR (wtl.event_type = 'CHTI' AND tr.event_key = wtl.event_key))
  LEFT JOIN treq_interval_group ig ON tr.timerequirementno_i = ig.timerequirementno_i
	LEFT JOIN (
		SELECT cdef.code as code, iv.interval_groupno_i gno, iv.amount_interval vl, iv.unit unit, iv.accuracy accuracy
		FROM treq_interval iv 
		LEFT JOIN counter_definition cdef ON cdef.counter_defno_i = iv.counter_defno_i
		WHERE cdef.code = 'D'
	) int_d ON int_d.gno = ig.interval_groupno_i
	LEFT JOIN (
		SELECT cdef.code as code, iv.interval_groupno_i gno, iv.amount_interval vl, iv.unit unit, iv.accuracy accuracy
		FROM treq_interval iv 
		LEFT JOIN counter_definition cdef ON cdef.counter_defno_i = iv.counter_defno_i
		WHERE cdef.code = 'C'
	) int_c ON int_c.gno = ig.interval_groupno_i
	LEFT JOIN (
		SELECT cdef.code as code, iv.interval_groupno_i gno, iv.amount_interval vl, iv.unit unit, iv.accuracy accuracy
		FROM treq_interval iv 
		LEFT JOIN counter_definition cdef ON cdef.counter_defno_i = iv.counter_defno_i
		WHERE cdef.code = 'H'
	) int_h ON int_h.gno = ig.interval_groupno_i
	LEFT JOIN (
		SELECT cdef.code as code, iv.interval_groupno_i gno, iv.amount_interval vl, iv.unit unit, iv.accuracy accuracy
		FROM treq_interval iv 
		LEFT JOIN counter_definition cdef ON cdef.counter_defno_i = iv.counter_defno_i
		WHERE cdef.code = 'AC'
	) int_ac ON int_ac.gno = ig.interval_groupno_i
	LEFT JOIN (
		SELECT cdef.code as code, iv.interval_groupno_i gno, iv.amount_interval vl, iv.unit unit, iv.accuracy accuracy
		FROM treq_interval iv 
		LEFT JOIN counter_definition cdef ON cdef.counter_defno_i = iv.counter_defno_i
		WHERE cdef.code = 'AH'
	) int_ah ON int_ah.gno = ig.interval_groupno_i
	
	WHERE (tr.event_type = 'TCREV' OR tr.event_type = 'CHTI')
	AND tr.status = 0
	AND ig.threshold = 'N'
) trs ON trs.wonum = f.event_perfno_i 
			AND (((f.event_type = 'C' OR f.event_type = 'CR') AND trs.tp = 'CHTI') OR (f.event_type != 'C' AND f.event_type != 'CR' AND trs.tp = 'TCREV')) 
WHERE 
	(f.ac_registr = '@VAR.Aircraft@' OR '@VAR.Aircraft@' IS NULL)
		AND 
	(wph.wpno_i = '@VAR.Workpackage@' OR '@VAR.Workpackage@' IS NULL)
/*q96*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="ggwp" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="end_date" id="end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="end_time" id="end_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT end_date, end_time FROM
(SELECT scheduler_log.end_date as end_date, end_time
FROM scheduler_log 
WHERE scheduler_log.scheduler_confno_i IN (SELECT scheduler_conf.scheduler_confno_i FROM scheduler_conf WHERE scheduler_conf.classname = 'amos.server.admin.scheduler.tasks.scheduled.forecast.AircraftMaintenanceForecastService')
ORDER BY end_date DESC, end_time DESC)
WHERE end_date IS NOT null AND end_time IS NOT null AND rownum=1</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
