      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT wp_sequence.seqno_i,
       wp_sequence.event_perfno_i,
       wo_event_link.event_display,
       desc_text.ws_text,
       fi.num,
       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + wo_header.closing_date, 'dd.mm.yyyy') closing_date,
       case when s.employee_no is null
            then issue_sign 
        else s.description 
        end issue_sign,
       case when cs.employee_no is null
            then mech_sign  
        else cs.description 
        end closing_sign,
      wpno
FROM wp_header
LEFT JOIN wp_assignment on wp_header.wpno_i=wp_assignment.wpno_i
LEFT JOIN wo_header on wp_assignment.event_perfno_i=wo_header.event_perfno_i
LEFT jOIN wo_event_link on wo_header.event_perfno_i = wo_event_link.event_perfno_i
LEFT JOIN wp_sequence on wp_sequence.event_perfno_i = wo_header.event_perfno_i
/*06.09.2019 Иваненко В.А., доработка по tq43055*/          
         LEFT JOIN 	(
				SELECT workstep_link.event_perfno_i as event_perfno_i,
				RTRIM(XMLCAST(XMLAGG(xmlelement(E, wo_text_description.text, ' ') order by workstep_link.sequenceno) AS CLOB), CHR(10)) as ws_text
				FROM workstep_link
				LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
				GROUP BY workstep_link.event_perfno_i
			) desc_text ON wo_header.event_perfno_i = desc_text.event_perfno_i 
          
          
LEFT JOIN (SELECT max_ws.max_seqno_i as seqno_i,
                                  max_ws.wpno_i as wpno_i,
                                  max_ws.event_perfno_i as event_perfno_i
                    FROM (
                                 SELECT wp_sequence.event_perfno_i as event_perfno_i ,
                                                wp_sequence.wpno_i as wpno_i,
                                                wp_sequence.seqno_i as seqno_i,
                                                MAX (wp_sequence.seqno_i) OVER (PARTITION BY wp_sequence.event_perfno_i) as max_seqno_i
                                 FROM wp_sequence
                                 WHERE wp_sequence.status&lt;&gt;9
                                 ORDER BY wp_sequence.event_perfno_i
                               ) max_ws
                    WHERE max_ws.max_seqno_i=max_ws.seqno_i
                  ) ws ON ws.event_perfno_i = wo_header.event_perfno_i and  wp_header.wpno_i = ws.wpno_i

/*26.12.2019 Цымбал В.В., доработка по tq47107*/ 
LEFT JOIN ( 
           SELECT event_perfno_i
                , 1 num
             FROM event_finding
          ) fi ON wp_sequence.event_perfno_i = fi.event_perfno_i
LEFT JOIN (
           SELECT employee_no
                , description
             FROM sign
          ) s on wo_header.issue_sign = s.employee_no
LEFT JOIN (
           SELECT employee_no
                , description
             FROM sign
          ) cs on wo_header.mech_sign = cs.employee_no

WHERE wp_header.wpno_i = '@VAR.WP@'
               AND wp_sequence.status = 0
               AND ('@VAR.State@'='O' AND wo_header.state IN ('O')  
                          OR '@VAR.State@'='C' AND wo_header.state IN ('C','V')  
                          OR '@VAR.State@'='ALL'
                         )
  AND (
