    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_ENG_UnknownPartsInTemplates_PNNR" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(*) as cnt" id="cnt"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="prt.partno as pn" id="pn"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT count(*) as cnt, prt.partno as pn  
	FROM part_request_template prt
		LEFT JOIN part p on prt.partno = p.partno
LEFT JOIN workstep_link wsl on wsl.descno_i = prt.event_key
LEFT JOIN wo_header woh ON woh.event_perfno_i = wsl.event_perfno_i
	WHERE p.partno IS NULL AND woh.event_perfno_i &lt; 0
	GROUP BY prt.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_ENG_UnknownPartsInTemplates_PNTL" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(*) as cnt" id="cnt"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT count(*) as cnt  
	FROM part_request_template prt
		LEFT JOIN part p on prt.partno = p.partno
LEFT JOIN workstep_link wsl on wsl.descno_i = prt.event_key
LEFT JOIN wo_header woh ON woh.event_perfno_i = wsl.event_perfno_i
	WHERE p.partno IS NULL AND woh.event_perfno_i &lt; 0</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_ENG_UnknownPartsInTemplates_PNTS" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT(*) as cnt" id="cnt"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT COUNT(*) as cnt FROM (
SELECT DISTINCT prt.partno as cnt  
	FROM part_request_template prt
		LEFT JOIN part p on prt.partno = p.partno
        LEFT JOIN workstep_link wsl on wsl.descno_i = prt.event_key
        LEFT JOIN wo_header woh ON woh.event_perfno_i = wsl.event_perfno_i
	WHERE p.partno IS NULL AND woh.event_perfno_i &lt; 0
)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_ENG_UnknownPartsInTemplates_PRTS" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="etl.template_revisionno_i as trni" id="trni"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(mt.taskcardno||wsr.workstep_revisionno_i||' / STEP # '||wsl.sequenceno||'('||mt.title||')') as path" id="path"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="prt.partno" id="prt.partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT etl.template_revisionno_i as trni, (mt.taskcardno||wsr.workstep_revisionno_i||' / STEP # '||wsl.sequenceno||'('||mt.title||')') as path, prt.partno 
FROM part_request_template prt
LEFT JOIN part p on prt.partno = p.partno
LEFT JOIN workstep_link wsl on wsl.descno_i = prt.event_key
LEFT JOIN wo_header woh ON woh.event_perfno_i = wsl.event_perfno_i
/*if this is a TC step*/
LEFT JOIN event_template etl ON woh.event_perfno_i = etl.event_perfno_i
LEFT JOIN worktemplate_link wtl ON (wtl.template_revisionno_i = etl.templateno AND (wtl.event_type = 'TI' OR wtl.event_type='EFL'))
LEFT JOIN msc_taskcard mt ON mt.taskcardno_i = wtl.event_key
/*if this is a repository workstep*/
LEFT JOIN workstep_revision wsr ON wsr.descno_i = wsl.descno_i
WHERE p.partno IS NULL AND woh.event_perfno_i&lt;0</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
