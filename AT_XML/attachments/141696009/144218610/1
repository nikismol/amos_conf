    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="User_part_request" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_forecast.partno" id="part_forecast.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_forecast.event_display" id="part_forecast.event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_detail.pickslipno" id="pickslip_detail.pickslipno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.created_by" id="part_request_2.created_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname||' '||sign.lastname AS created_by_name" id="created_by_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.DEPARTMENT||' '||department.description AS created_by_Dep" id="created_by_Dep"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(TO_DATE('01.01.1970' 'dd.mm.yyyy') + (  part_request_2.created_date+729)'dd.mm.yyyy') as created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;LISTAGG (user_group.user_group'') WITHIN GROUP (ORDER BY  user_group.user_group) as user_group" id="user_group"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
	part_forecast.partno,
	part_forecast.event_display,
	pickslip_detail.pickslipno,
	part_request_2.created_by,
	sign.firstname||' '||sign.lastname AS created_by_name,
	sign.DEPARTMENT||' '||department.description AS created_by_Dep,
	TO_CHAR(TO_DATE('01.01.1970', 'dd.mm.yyyy') + (  part_request_2.created_date+729),'dd.mm.yyyy') as created_date,
	LISTAGG (user_group.user_group,', ') WITHIN GROUP (ORDER BY  user_group.user_group) as user_group    
FROM part_forecast 
	JOIN part_request_2 on part_forecast.part_requestno_i=part_request_2.part_requestno_i
	JOIN pickslip_detail on part_request_2.part_requestno_i=pickslip_detail.part_requestno_i
	JOIN sign ON part_request_2.created_by = sign.user_sign
	JOIN department ON sign.department = department.department
	JOIN user_access ON sign.user_sign=user_access.login_sign
	JOIN user_group ON user_access.user_group=user_group.user_group 
WHERE part_forecast.event_type='GENEVENT'
GROUP BY
	part_forecast.partno,
	part_forecast.event_display,
	pickslip_detail.pickslipno,
	part_request_2.created_by,
	sign.firstname,
	sign.lastname, 
	sign.DEPARTMENT,
	department.description,
	part_request_2.created_date  </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
