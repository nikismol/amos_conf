                   null,
                   '',
                   '(' || sign5.lastname || ' ' || sign5.firstname || ')')) wo_closing_sign,
       trim(wo_header.release_sign || ' ' ||
            decode(sign3.lastname || sign3.firstname,
                   null,
                   '',
                   '(' || sign3.lastname || ' ' || sign3.firstname || ')')) wo_release_sign,
       trim(wo_header.release_sign2 || ' ' ||
            decode(sign4.lastname || sign4.firstname,
                   null,
                   '',
                   '(' || sign4.lastname || ' ' || sign4.firstname || ')')) wo_release_sign2,
       to_date('31.12.1971', 'dd.mm.yyyy') + wo_header.issue_date +
       decode(wo_header.issue_time, 0, 0, wo_header.issue_time / 24 / 60) wo_issue_date_time,
       to_date('31.12.1971', 'dd.mm.yyyy') + wo_header.closing_date +
       decode(wo_header.release_time,
              '0000',
              0,
              ((cast(substr(wo_header.release_time, 0, 2) as int) * 60 +
              cast(substr(wo_header.release_time, 3) as int)) / 24 / 60)) wo_closing_date,
       wo_header.release_time,
       wo_header.ac_registr,
       wo_header.comp_partno partno,
       wo_header.comp_serialno serialno,
       decode(doc_header.ac_or_comp_doc,
              'C',
              'Comp',
              'A/C') ac_or_comp_doc,
       doc_header.doc_type,
       doc_header.docno doc_no,
       doc_header.revision doc_rev,
       doc_header.issued_by doc_issued_by
  from wo_event_link /* Link the wo with the maintenance event (Document) */,
       wo_header /* Workorder */,
       event_effectivity_link /* Link event and original template (Document) */,
       doc_header /* Document */,
       sign /* User Info */,
       sign                   sign2 /* User Info */,
       sign                   sign3 /* User Info */,
       sign                   sign4 /* User Info */,
       sign                   sign5 /* User Info */
where 1=1
             and ('@AMOS_VERSION@' LIKE '19.12%' AND wo_event_link.event_type = 'DOC_EFF' OR '@AMOS_VERSION@' NOT LIKE '19.12%' AND wo_event_link.event_type = 'MED')

   and wo_event_link.planable_status = 0
   and wo_header.event_perfno_i = wo_event_link.event_perfno_i
   and event_effectivity_link.event_type = 'DO'
   and event_effectivity_link.effectivity_linkno_i =
       wo_event_link.event_key
   and doc_header.docno_i = event_effectivity_link.event_key
      /* Event without auto_report_back, wo is closed, but event is still in pending status */
   and nvl(wo_event_link.auto_report_back, 'N') != 'Y' /* Events without auto_report_back */
   and wo_event_link.pending_status &gt;= 0 /*  */
   and wo_header.state = 'C' /* Only closed WO */
   and wo_header.created_by = sign.user_sign(+)
   and wo_header.issue_sign = sign2.user_sign(+)
   and wo_header.release_sign = sign3.user_sign(+)
   and wo_header.release_sign2 = sign4.user_sign(+)
   and wo_header.mech_sign = sign5.user_sign(+)
   /* employee created wt */
   and  ('@VAR.employee@' is null or
		 wo_header.created_by in
		 (select trim(substr('@VAR.employee@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.employee@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.employee@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.employee@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.employee@') -
					  length(replace('@VAR.employee@', ',', '')) + 1)) 
order by 1</se:textStatement>
