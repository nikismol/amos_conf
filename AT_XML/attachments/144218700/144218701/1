          <se:textStatement>SELECT rownum,
rotables.location,
rotables.partno,
rotables.mfg_unknown,
rotables.serialno,
rotables.ac_registr,
CASE WHEN mfg_unknown = 'Y' THEN 'N/D' 
ELSE
TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + ( rotables.mfg_date), 'DD.MM.YYYY') 
END  mfg_date,
part.description,
aircraft.ac_typ
FROM rotables
LEFT JOIN part on rotables.partno = part.partno
LEFT JOIN aircraft on rotables.ac_registr = aircraft.ac_registr
LEFT JOIN position on rotables.locid_pk = position.locid_pk
WHERE (REGEXP_LIKE(rotables.location, REPLACE('@VAR.position@', ', ', '|')) OR '@VAR.position@' IS NULL)
AND (REGEXP_LIKE(rotables.partno, REPLACE('@VAR.partno@', ', ', '|')) OR '@VAR.partno@' IS NULL)
AND (REGEXP_LIKE(rotables.serialno, REPLACE('@VAR.serialno@', ', ', '|')) OR '@VAR.serialno@' IS NULL)
AND (REGEXP_LIKE(rotables.ac_registr, REPLACE('@VAR.acreg@', ', ', '|')) OR '@VAR.acreg@' IS NULL)
AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.actype@', ', ', '|')) OR '@VAR.actype@' IS NULL)
AND rotables.ac_registr IS NOT NULL
AND aircraft.status &lt;&gt; 9
Order by rownum, rotables.location</se:textStatement>
