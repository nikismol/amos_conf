      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT pickslip_header.pickslipno as pickslipno, 
pickslip_header.receiver,
pickslip_booked.partno as partno, 
pickslip_booked.batchno as batchno,
pickslip_booked.serialno as serialno,
pickslip_booked.qty_booked as qty,
part.description as pdesc,
 (
          SELECT COALESCE (
                    (
                       SELECT DISTINCT workstep_link.event_perfno_i 
                       FROM part_request_2 
                       JOIN workstep_link ON part_request_2.event_key = workstep_link.workstep_linkno_i AND part_request_2.event_type = 'WSL' 
                       LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i AND wo_header.workorderno_display IS NOT NULL 
                       WHERE pickslip_detail.part_requestno_i = part_request_2.part_requestno_i
                    ),
                    (
                       SELECT event_pending.workorderno 
                       FROM part_request_2 pr 
                       JOIN event_pending ON pr.event_key = event_pending.pendingno_i AND pr.event_type = 'GENEVENT' 
                       WHERE pickslip_detail.part_requestno_i = pr.part_requestno_i
                    )
                 ) 
          FROM amos_dummy
       ) AS WO_Number,
(SELECT DISTINCT wo_header.ata_chapter
                       FROM part_request_2 
                       JOIN workstep_link ON part_request_2.event_key = workstep_link.workstep_linkno_i AND part_request_2.event_type = 'WSL' 
                       LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i AND wo_header.workorderno_display IS NOT NULL 
                       WHERE pickslip_detail.part_requestno_i = part_request_2.part_requestno_i)  AS ATA,
(SELECT DISTINCT wo_header.ext_workorderno
                       FROM part_request_2 
                       JOIN workstep_link ON part_request_2.event_key = workstep_link.workstep_linkno_i AND part_request_2.event_type = 'WSL' 
                       LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i AND wo_header.workorderno_display IS NOT NULL 
                       WHERE pickslip_detail.part_requestno_i = part_request_2.part_requestno_i)  AS ext_workorderno,
                    
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (pickslip_header.pickslip_date + 729), 'DD.MM.YYYY') as pickslip_date
FROM pickslip_header
LEFT JOIN pickslip_detail ON pickslip_header.pickslipno = pickslip_detail.pickslipno
LEFT JOIN pickslip_booked ON pickslip_booked.pickslipno = pickslip_header.pickslipno AND pickslip_booked.recno = pickslip_detail.recno
LEFT JOIN part ON pickslip_booked.partno = part.partno
WHERE pickslip_header.receiver = '@VAR.ac_registr@'
AND pickslip_header.pickslip_date &gt;= '@VAR.st_date@'
AND pickslip_header.pickslip_date &lt;= '@VAR.end_date@'
ORDER BY pickslip_detail.event_perfno_i, pickslip_detail.pickslipno, pickslip_detail.recno</se:textStatement>
