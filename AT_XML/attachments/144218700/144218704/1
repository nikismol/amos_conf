    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_WO_LINE_INFORMATION" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_model" id="aircraft.ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_timestamp('00:00' 'HH24:MI') + ((time_captured.duration)/60/24)'HH24:MI') as mhrs" id="mhrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;DECODE(wo_header.type 'C' 'unscheduled''M''unscheduled''P''unscheduled''S''scheduled') result" id="result"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;to_char(to_timestamp('00:00' 'HH24:MI') + ((@VAR.time_from@)/60/24)'HH24:MI') as time_from" id="time_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_timestamp('00:00' 'HH24:MI') + ((@VAR.time_to@)/60/24)'HH24:MI') as time_to" id="time_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (@VAR.date_from@+729)'dd.mm.yyyy') as date_from" id="date_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (@VAR.date_to@+729)'dd.mm.yyyy') as date_to" id="date_to"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.time_from@">
          <ds:object>@VAR.time_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.time_to@">
          <ds:object>@VAR.time_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_MODEL@">
          <ds:object>@VAR.AC_MODEL@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
wo_header.event_perfno_i,
aircraft.ac_model,
to_char(to_timestamp('00:00', 'HH24:MI') + ((time_captured.duration)/60/24), 'HH24:MI') as mhrs,

DECODE(wo_header.type, 'C', 'unscheduled','M','unscheduled','P','unscheduled','S','scheduled') as result,

to_char(to_timestamp('00:00', 'HH24:MI') + ((@VAR.time_from@)/60/24), 'HH24:MI') as time_from,
to_char(to_timestamp('00:00', 'HH24:MI') + ((@VAR.time_to@)/60/24), 'HH24:MI') as time_to,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (@VAR.date_from@+729),'dd.mm.yyyy') as date_from,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (@VAR.date_to@+729),'dd.mm.yyyy') as date_to


FROM wo_header
LEFT JOIN time_captured ON time_captured.primkey = wo_header.event_perfno_i
LEFT JOIN aircraft ON aircraft.ac_registr = wo_header.ac_registr
LEFT JOIN wo_header_4 ON wo_header_4.event_perfno_i = wo_header.event_perfno_i

WHERE (REGEXP_LIKE(aircraft.ac_model, REPLACE('@VAR.AC_MODEL@', ', ', '|')) OR '@VAR.AC_MODEL@' IS NULL)
and (('@VAR.date_from@'*60*24+'@VAR.time_from@')&lt;=(time_captured.start_date*60*24+time_captured.start_time))
and (('@VAR.date_to@'*60*24+'@VAR.time_to@')&gt;=(time_captured.end_date*60*24+time_captured.end_time))
and wo_header_4.event_classification = 'L'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
