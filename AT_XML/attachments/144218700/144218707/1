          <ds:object>@VAR.AC_REGISTR@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.PARTNO@">
          <ds:object>@VAR.PARTNO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>Select DISTINCT
doc_header.docno,
part.partno,
part_request_template.partno,
part.description,
part.mat_class || ',' || part.mat_type,
event_effectivity_mapping.ac_registr,
Trunc(r_stock_svo.qty_svo, 2),
TRUNC(c_stock_svo.qty_svo, 2),
TRUNC(alt_r_qty, 2 ),
TRUNC(alt_c_qty, 2),
DECODE (part.mat_class, 'C', 'Consumable',
                        'E', 'Expendable',
                        'R', 'Rotable',
                        'S', 'Service') as mat_class,
DECODE (part.mat_type, 'CONS', 'CONSUMABLES',
                       'EQUI', 'EQUIPMENT',
                       'FLMB', 'FLAMMABLE LIQUIDS',
                       'GREA', 'SPECIAL GREASE',
                       'KIT', 'KIT',
                       'LIQU', 'SPECIAL LIQUIDS',                    
                       'N', 'NON AIRCRAFT MATERIAL',
                       'P', 'AIRCRAFT PART',
                       'RM', 'RAW MATERIAL',
                       'S', 'SERVICE',
                       'SW', 'SOFTWARE',
                       'T', 'TOOL',
                       'ZSOD', 'SPECIAL PROTECTIVE EQUIPMENT') as mat_type,
part_request_template.qty,
part.measure_unit,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (forecast.expected_date+729), 'dd.mm.yyyy') as expected_date

FROM doc_header
LEFT JOIN event_effectivity_mapping ON doc_header.docno_i=event_effectivity_mapping.event_key_parent


LEFT JOIN workstep_link ON workstep_link.event_perfno_i = event_effectivity_mapping.event_perfno_i
LEFT JOIN part_request_template ON part_request_template.event_key = workstep_link.descno_i
LEFT JOIN part ON part.partno = part_request_template.partno

LEFT JOIN (SELECT
		   COUNT (1) as qty_svo,
		   location.station as station,
		   rotables.partno as partno
		   FROM
		   rotables 
		   JOIN location ON rotables.locationno_i = location.locationno_i 
		   WHERE
		   rotables.ac_registr IN (' ', 'TRANSF')
		   AND rotables.partnonew=' '
		   AND rotables.condition&lt;&gt;'US'
		   AND (rotables.outgoing_detailno_i IS NULL OR rotables.locationno_i &lt;&gt; -200)
		   AND location.locationno_i &lt;&gt; -1 
		   AND location.location_restriction = 0 
		   AND location.station in ('SVO', 'SHRM')
		   GROUP BY
		   location.station,
           rotables.partno
		  ) r_stock_svo ON part.partno=r_stock_svo.partno
LEFT JOIN (SELECT
		   location.station as station,
		   TO_NUMBER(sum(consumables.qty)) as qty_svo,
		   consumables.partno as partno
		   FROM consumables 
		   LEFT JOIN location ON consumables.locationno_i = location.locationno_i 
		   WHERE
		   location.station&lt;&gt;' '
	  	   AND location.station in ('SVO', 'SHRM')
  		   AND location.location_type &lt;&gt; -107
   		   AND location.location_type &lt;&gt; -4
    	   AND location.location_type &lt;&gt; -8
		   GROUP BY
		   location.station,
		   consumables.partno
		  ) c_stock_svo ON part.partno=c_stock_svo.partno

LEFT JOIN (
		   SELECT
		   part_alternate.partno as partno,
		   SUM(alt_r_stock_svo.qty_svo) as alt_r_qty,
		   SUM(alt_c_stock_svo.qty_svo) as alt_c_qty
		   FROM
		   part_alternate
		   LEFT JOIN (SELECT
		   		   	  COUNT (1) as qty_svo,
		   		   	  location.station as station,
		   		   	  rotables.partno as partno
		   		   	  FROM
		   		   	  rotables 
		   		   	  JOIN location ON rotables.locationno_i = location.locationno_i 
		   		   	  WHERE
		   		   	  rotables.ac_registr IN (' ', 'TRANSF')
		   		   	  AND rotables.partnonew=' '
		   		   	  AND rotables.condition&lt;&gt;'US'
		   		   	  AND (rotables.outgoing_detailno_i IS NULL OR rotables.locationno_i &lt;&gt; -200)
		   		   	  AND location.locationno_i &lt;&gt; -1 
		   		   	  AND location.location_restriction = 0 
		   		   	  AND location.station in ('SVO', 'SHRM')
		   		   	  GROUP BY
		   		   	  location.station,
		              rotables.partno
		   			 ) alt_r_stock_svo ON part_alternate.altpartno=alt_r_stock_svo.partno
		   LEFT JOIN (SELECT
		   		   	  location.station as station,
		   		   	  TO_NUMBER(sum(consumables.qty)) as qty_svo,
		   		   	  consumables.partno as partno
		   		   	  FROM consumables 
		   		   	  LEFT JOIN location ON consumables.locationno_i = location.locationno_i 
		   		   	  WHERE
		   		   	  location.station&lt;&gt;' '
		   		   	  AND location.station in ('SVO', 'SHRM')
		   		   	  AND location.location_type &lt;&gt; -107
		   		   	  AND location.location_type &lt;&gt; -4
		   		   	  AND location.location_type &lt;&gt; -8
		   		   	  GROUP BY
		   		   	  location.station,
		   		   	  consumables.partno
					 ) alt_c_stock_svo ON part_alternate.altpartno=alt_c_stock_svo.partno
		   WHERE
		   part_alternate.type IN ('A', 'R', 'S')
		   GROUP BY 
		   part_alternate.partno
		  ) alt_stock_svo ON part.partno=alt_stock_svo.partno

LEFT JOIN forecast ON forecast.unique_key2 = doc_header.docno_i and forecast.event_type = 'D'
LEFT JOIN aircraft ac ON event_effectivity_mapping.ac_registr = ac.ac_registr

Where event_effectivity_mapping.affected = 'Y'
and event_effectivity_mapping.event_status = 'O'
and (REGEXP_LIKE(event_effectivity_mapping.ac_registr, REPLACE( '@VAR.AC_REGISTR@', ', ', '|')) OR '@VAR.AC_REGISTR@' IS NULL)
and doc_header.doc_type in ('OWO', 'SB', 'SIL', 'SL', 'АД', 'ЛИБ', 'ЛИД', 'СП', 'ТР')
and ac.ac_registr = forecast.ac_registr
and (REGEXP_LIKE(part_request_template.partno, REPLACE( '@VAR.PARTNO@', ', ', '|')) OR '@VAR.PARTNO@' IS NULL)
Order by doc_header.docno ASC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
