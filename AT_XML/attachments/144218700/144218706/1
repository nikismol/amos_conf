        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + pickslip_header.pickslip_date'dd.mm.yyyy') as pickslip_confirmed_date" id="pickslip_confirmed_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + pickslip_header.issue_date'dd.mm.yyyy') as pickslip_issue_date" id="pickslip_issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + part_request_2.created_date'dd.mm.yyyy') as part_request_date" id="part_request_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_STATE@">
          <ds:object>@VAR.WO_STATE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.PN@">
          <ds:object>@VAR.PN@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_REGISTR@">
          <ds:object>@VAR.AC_REGISTR@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_TYPE@">
          <ds:object>@VAR.AC_TYPE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_1_period_type@">
          <ds:object>@VAR.v05_1_period_type@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_FROM@">
          <ds:object>@VAR.DATE_FROM@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_TO@">
          <ds:object>@VAR.DATE_TO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ATA@">
          <ds:object>@VAR.ATA@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v08_mat_class@">
          <ds:object>@VAR.v08_mat_class@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v09_event_type@">
          <ds:object>@VAR.v09_event_type@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v10_event_perfno_i@">
          <ds:object>@VAR.v10_event_perfno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v11_wpno@">
          <ds:object>@VAR.v11_wpno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v12_excl_tool@">
          <ds:object>@VAR.v12_excl_tool@</ds:object>
