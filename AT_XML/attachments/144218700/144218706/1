      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
wp_header.station,
wo_header.release_station,
wp_header.wpno,
wo_header.ata_chapter,
wp_sequence.seqno_i,
part_request_2.partno,
part_request_2.initial_qty,
wo_header.event_perfno_i,
              DECODE (
                                 DECODE (wo_event_link.taskcard_type,
                                                   null, wo_header.event_type,
                                                   'O', 'ODT',
                                                   wo_event_link.taskcard_type),
                                'C','Check',
                                'B','BTC',
                                'S', DECODE (wo_event_link.taskcard_type, 'S', 'SRT', 'Workorder'),
                                'D','Document',
                                'R','Rot. Req.',
                                'V','Replacement Event',
                                'O','ET WO',
                                'W','Find. WO',
                                'XX','RRO',
                                'E','Change Order',
                                'SV','Shop Visit WO',
                                'SC','Sim. Complaint WO',
                                'I','Import WO',
                                'P','Panel Workorder',
                                'J','JIC Workorder',
                                'ODT','ODT',
                                'Workorder') as event_type,
wo_event_link.event_name as event_name,
DECODE(wo_header.type,
                 'P', 'Pirep',
                 'C', 'Cabin',
                 'M', 'Maintenance',
                 'S', 'Scheduled',
                 'is not WO ') as wo_type,
Decode(wo_header.state, 'O', 'Open', 'C', 'Close') as status,
aircraft.ac_registr,
pickslip_booked.qty_booked - NVL(pickslip_booked.qty_canceled, 0) as qty_booked,
DECODE (pickslip_detail.status,
                  '0', 'new',
                  '1', 'issued',
                  '2', 'transfer',
                  '3', 'externally controlled',
                  '4', '-',
                  '5', 'backorder',
                  '6', 'partly booked',
                  '7', 'partly cancelled',
                  '8', 'cancelled',
                  '9', 'closed',
                  '10', 'deleted',
                  '11', 'reversed',
                  '') as Pickslip,
wo_text_description.header,
wo_text_description.text,
DECODE (part.mat_class, 'C', 'Consumable',
                        'E', 'Expendable',
                        'R', 'Rotable',
                        'S', 'Service') as mat_class,
DECODE (part.mat_type, 'CONS', 'CONSUMABLES',
                       'EQUI', 'EQUIPMENT',
                       'FLMB', 'FLAMMABLE LIQUIDS',
                       'GREA', 'SPECIAL GREASE',
                       'KIT', 'KIT',
                       'LIQU', 'SPECIAL LIQUIDS',                    
                       'N', 'NON AIRCRAFT MATERIAL',
                       'P', 'AIRCRAFT PART',
                       'RM', 'RAW MATERIAL',
                       'S', 'SERVICE',
                       'SW', 'SOFTWARE',
                       'T', 'TOOL',
                       'ZSOD', 'SPECIAL PROTECTIVE EQUIPMENT') as mat_type,
doc_header.docno,
part.description,
part.measure_unit,
pickslip_detail.pickslipno,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (wo_header.created_date+729), 'dd.mm.yyyy') as created_date,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (wo_header.closing_date+729), 'dd.mm.yyyy') as closing_date,
CASE WHEN pickslip_booked.status IN (6,7,9) THEN TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + pickslip_header.pickslip_date, 'dd.mm.yyyy') ELSE '' END as pickslip_confirmed_date,
TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + pickslip_header.issue_date, 'dd.mm.yyyy') as pickslip_issue_date,
TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + part_request_2.created_date, 'dd.mm.yyyy') as part_request_date

FROM part_request_2
LEFT JOIN workstep_link ON part_request_2.event_key = workstep_link.workstep_linkno_i AND part_request_2.event_type = 'WSL' 
LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN pickslip_detail ON pickslip_detail.part_requestno_i = part_request_2.part_requestno_i
LEFT JOIN pickslip_booked ON pickslip_booked.pickslipno = pickslip_detail.pickslipno and pickslip_booked.recno = pickslip_detail.recno AND pickslip_booked.status IN (6,7,9)
LEFT JOIN pickslip_header ON pickslip_detail.pickslipno = pickslip_header.pickslipno
LEFT JOIN wo_text_description ON wo_text_description.descno_i = workstep_link.descno_i
LEFT JOIN part ON part.partno = part_request_2.partno
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN wp_assignment ON  wo_header.event_perfno_i = wp_assignment.event_perfno_i      
LEFT JOIN wp_header ON wp_header.wpno_i = wp_assignment.wpno_i     
LEFT JOIN wp_sequence ON wp_sequence.event_perfno_i = wo_header.event_perfno_i and wp_sequence.wpno_i = wp_header.wpno_i
LEFT JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i
LEFT JOIN doc_header ON doc_header.docno_i = wo_event_link.event_key_parent AND wo_event_link.event_type IN ('DOC_EFF', 'MED') 

WHERE 1=1
and (wo_header.state IN ('C', 'O') AND '@VAR.WO_STATE@' = 'ALL'
         OR wo_header.state = 'C' AND '@VAR.WO_STATE@' = 'C'
         OR wo_header.state = 'O' AND '@VAR.WO_STATE@' = 'O'
        )
and (REGEXP_LIKE(part_request_2.partno, REPLACE( '@VAR.PN@', ', ', '|')) OR '@VAR.PN@' IS NULL)
and (REGEXP_LIKE(aircraft.ac_registr, REPLACE( '@VAR.AC_REGISTR@', ', ', '|')) OR '@VAR.AC_REGISTR@' IS NULL)
and (REGEXP_LIKE(aircraft.ac_typ, REPLACE( '@VAR.AC_TYPE@', ', ', '|')) OR '@VAR.AC_TYPE@' IS NULL)
and (
         '@VAR.v05_1_period_type@' = 'event_created_date'
         AND (wo_header.created_date &gt;= '@VAR.DATE_FROM@' OR '@VAR.DATE_FROM@' IS NULL)
         AND (wo_header.created_date &lt;= '@VAR.DATE_TO@' OR '@VAR.DATE_TO@' IS NULL)
         OR 
         '@VAR.v05_1_period_type@' = 'event_closing_date'
         AND (wo_header.closing_date &gt;= '@VAR.DATE_FROM@' OR '@VAR.DATE_FROM@' IS NULL)
         AND (wo_header.closing_date &lt;= '@VAR.DATE_TO@' OR '@VAR.DATE_TO@' IS NULL)
         OR 
         '@VAR.v05_1_period_type@' = 'part_request_date'
         AND (part_request_2.created_date &gt;= '@VAR.DATE_FROM@' OR '@VAR.DATE_FROM@' IS NULL)
         AND (part_request_2.created_date &lt;= '@VAR.DATE_TO@' OR '@VAR.DATE_TO@' IS NULL)
         OR 
         '@VAR.v05_1_period_type@' = 'pickslip_issue_date'
         AND (pickslip_header.issue_date &gt;= '@VAR.DATE_FROM@' OR '@VAR.DATE_FROM@' IS NULL)
         AND (pickslip_header.issue_date &lt;= '@VAR.DATE_TO@' OR '@VAR.DATE_TO@' IS NULL)
         OR 
         '@VAR.v05_1_period_type@' = 'pickslip_confirmation_date'
         AND (pickslip_header.pickslip_date &gt;= '@VAR.DATE_FROM@' OR '@VAR.DATE_FROM@' IS NULL)
         AND (pickslip_header.pickslip_date &lt;= '@VAR.DATE_TO@' OR '@VAR.DATE_TO@' IS NULL)
         OR 
         '@VAR.v05_1_period_type@' = 'NA'
        )
AND  (REGEXP_LIKE(wo_header.ata_chapter, REPLACE( '@VAR.ATA@', ', ', '|')) OR '@VAR.ATA@' IS NULL)
AND (part.mat_class = 'R' AND '@VAR.v08_mat_class@' = 'R'
          OR part.mat_class IN ('C', 'E') AND '@VAR.v08_mat_class@' = 'CE'   
          OR '@VAR.v08_mat_class@' = 'ALL'
         ) 
AND (
          '@VAR.v09_event_type@' = 'TC' AND (wo_event_link.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%' or wo_event_link.event_type = 'MET' and '@AMOS_VERSION@' not like '19.12%')
          OR '@VAR.v09_event_type@' = 'TC_EXCL' AND NVL(wo_event_link.event_type, 'NA') NOT IN ('TCEFFLI', 'MET')
          OR '@VAR.v09_event_type@' = 'ALL'
         )
AND (REGEXP_LIKE(wo_header.event_perfno_i, REPLACE( '@VAR.v10_event_perfno_i@', ', ', '|')) OR '@VAR.v10_event_perfno_i@' IS NULL)
AND (wp_header.wpno_i = '@VAR.v11_wpno@' OR '@VAR.v11_wpno@' IS NULL) 
AND ('@VAR.v12_excl_tool@'='Y' AND NVL(part.tool, 'N') &lt;&gt; 'Y' OR '@VAR.v12_excl_tool@'='N')
Order by wo_header.event_perfno_i ASC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
