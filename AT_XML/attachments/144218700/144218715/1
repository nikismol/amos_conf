      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
        doc_header.doc_type AS Doc_Type
        ,doc_header.docno AS Document
        ,event_effectivity.title AS eff
        ,DECODE(event_effectivity_mapping.event_status, 'C', 'Closed',
                                                        			 'R', 'Repetitive') AS State
        ,aircraft.ac_typ AS AC_Type
        ,event_effectivity_mapping.ac_registr AS AC
        ,part_request_template.partno AS PN
        ,SUM(part_request_template.qty) AS QTY
        ,event_effectivity_mapping.last_event_perfno_i AS PFMD_WO
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.closing_date+729),'dd.mm.yyyy') as closing_date              
        ,psl.QTY AS conf_QTY
        ,wp_header.wpno AS WP
        ,rotables_SHRM1010.rot_qty||consumables_SHRM1010.cons_qty AS SHRM_1010
        ,rotables_SVO_SSJ_GSS.rot_qty||consumables_SVO_SSJ_GSS.cons_qty AS SVO_SSJ_GSS
        ,rotables_SVO_ACC.rot_qty||consumables_SVO_ACC.cons_qty AS SVO_ACC
        ,rotables_SVO_WHEELS.rot_qty||consumables_SVO_WHEELS.cons_qty AS SVO_WHEELS
        ,rotables_SVO_BASE.rot_qty||consumables_SVO_BASE.cons_qty AS SVO_BASE
        ,rotables_SVO_CABIN.rot_qty||consumables_SVO_CABIN.cons_qty AS SVO_CABIN
        ,rotables_SVO_FLUIDS.rot_qty||consumables_SVO_FLUIDS.cons_qty AS SVO_FLUIDS
        ,rotables_SVO_LINE.rot_qty||consumables_SVO_LINE.cons_qty AS SVO_LINE  
        ,rotables_SVO_SSJ.rot_qty||consumables_SVO_SSJ.cons_qty AS SVO_SSJ
        ,rotables_SVO_TOOLS.rot_qty||consumables_SVO_TOOLS.cons_qty AS SVO_TOOLS     
        ,event_template.created_by AS WT_created_by_sign
        ,sign.firstname||' '||sign.lastname AS WT_created_by_name
        ,sign.DEPARTMENT||' '||department.description AS WT_created_by_Dep
        ,event_template.mutator AS WT_mutation_by_sign
        ,sign2.firstname||' '||sign2.lastname AS WT_mutation_by_name
        ,sign2.DEPARTMENT||' '||department2.description AS WT_mutation_by_Dep
FROM
(
    SELECT 
            doc_header.docno AS docno
            ,doc_header.docno_i AS docno_i
            ,doc_header.revision AS revision
            ,doc_header.doc_type AS doc_Type
            ,doc_header.repetitive_insp AS repetitive_insp 
            ,max_rev.max_rev AS max_rev
    FROM doc_header
    LEFT JOIN 
                (
                    SELECT 
                            doc_header.docno_i AS docno_i
                            ,MAX(doc_header.revision) OVER (PARTITION BY doc_header.docno) AS max_rev
                    FROM doc_header
                ) max_rev ON doc_header.docno_i = max_rev.docno_i
    WHERE 
    doc_header.revision = max_rev.max_rev
) doc_header
JOIN event_effectivity_link ON doc_header.docno_i = event_effectivity_link.event_key AND event_effectivity_link.event_type = 'DO' 
JOIN event_effectivity ON event_effectivity_link.effectivityno_i = event_effectivity.effectivityno_i
JOIN event_effectivity_mapping ON event_effectivity_link.effectivity_linkno_i = event_effectivity_mapping.effectivity_linkno_i AND event_effectivity_mapping.event_status IN ('C', 'R')
LEFT JOIN wo_header ON event_effectivity_mapping.last_event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i = wp_header.wpno_i
LEFT JOIN worktemplate_link ON event_effectivity_link.effectivity_linkno_i = worktemplate_link.event_key AND worktemplate_link.event_type = 'EFL'
LEFT JOIN event_template ON worktemplate_link.wtno_i = event_template.wtno_i AND event_template.revision_status = '1'
LEFT JOIN workstep_link ON event_template.event_perfno_i = workstep_link.event_perfno_i
JOIN part_request_template ON workstep_link.descno_i = part_request_template.event_key AND part_request_template.event_type = 'WS'
LEFT JOIN aircraft ON event_effectivity_mapping.ac_registr = aircraft.ac_registr
LEFT JOIN sign ON event_template.created_by = sign.user_sign
LEFT JOIN sign sign2 ON event_template.mutator = sign2.user_sign
LEFT JOIN department ON sign.department = department.department
LEFT JOIN department department2 ON sign2.department = department2.department
LEFT JOIN 
            (
                SELECT 
                        wo_header.event_perfno_i AS event_perfno_i
                        ,part_request_2.partno AS Partno
                        ,SUM(part_request_2.confirmed_qty) AS QTY
                FROM wo_header
                JOIN workstep_link ON wo_header.event_perfno_i = workstep_link.event_perfno_i
                JOIN part_request_2 ON workstep_link.workstep_linkno_i = part_request_2.event_key AND  part_request_2.event_type = 'WSL'
                GROUP BY 
                        wo_header.event_perfno_i 
                        ,part_request_2.partno 
            ) psl ON event_effectivity_mapping.last_event_perfno_i = psl.event_perfno_i AND part_request_template.partno = psl.Partno
/*SHRM 1010*/
LEFT JOIN   (
                        SELECT  rotables.partno,
                                COUNT(rotables.fa_qty) AS rot_qty
                        FROM rotables
                        LEFT JOIN location ON rotables.locationno_i = location.locationno_i
                        WHERE   rotables.fa_qty &gt; 0
                        AND location.station = 'SHRM' AND location.store = '1010'
                        AND location.location_type &gt;= '0'
                        AND (rotables.condition &lt;&gt; 'US' OR rotables.condition IS NULL)
                        GROUP BY rotables.partno, location.station, location.store         
            ) rotables_SHRM1010 ON part_request_template.partno = rotables_SHRM1010.partno
LEFT JOIN   (
                        SELECT  consumables.partno,
                                COUNT(consumables.qty) AS cons_qty
                        FROM consumables
                        LEFT JOIN location ON consumables.locationno_i = location.locationno_i
                        WHERE   consumables.qty &gt; 0
                        AND location.station = 'SHRM' AND location.store = '1010'
                        AND location.location_type &gt;= '0'
                        AND (consumables.condition &lt;&gt; 'US' OR consumables.condition IS NULL)
                        GROUP BY consumables.partno, location.station, location.store                        
            ) consumables_SHRM1010 ON part_request_template.partno = consumables_SHRM1010.partno 
/*SVO SSJ-GSS*/
LEFT JOIN   (
                        SELECT  rotables.partno,
                                COUNT(rotables.fa_qty) AS rot_qty
                        FROM rotables
                        LEFT JOIN location ON rotables.locationno_i = location.locationno_i
                        WHERE   rotables.fa_qty &gt; 0
                        AND location.station = 'SVO' AND location.store = 'SSJ-GSS'
                        AND location.location_type &gt;= '0'
                        AND (rotables.condition &lt;&gt; 'US' OR rotables.condition IS NULL)
                        GROUP BY rotables.partno, location.station, location.store         
            ) rotables_SVO_SSJ_GSS ON part_request_template.partno = rotables_SVO_SSJ_GSS.partno
LEFT JOIN   (
                        SELECT  consumables.partno,
                                COUNT(consumables.qty) AS cons_qty
                        FROM consumables
                        LEFT JOIN location ON consumables.locationno_i = location.locationno_i
                        WHERE   consumables.qty &gt; 0
                        AND location.station = 'SVO' AND location.store = 'SSJ-GSS'
                        AND location.location_type &gt;= '0'
                        AND (consumables.condition &lt;&gt; 'US' OR consumables.condition IS NULL)
                        GROUP BY consumables.partno, location.station, location.store                        
            ) consumables_SVO_SSJ_GSS ON part_request_template.partno = consumables_SVO_SSJ_GSS.partno 
/*SVO ACC*/
