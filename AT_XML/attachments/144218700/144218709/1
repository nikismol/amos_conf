    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_POSITION_ON_AC" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="labelno" id="labelno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location" id="location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="voucherno" id="voucherno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('31.12.1971' 'dd.mm.yyyy') + history.mutation + history.mutation_time / 1000 / 60 / 60 / 24'dd.mm.yyyy hh24:mi:ss') last_mutation" id="last_mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;&#10;DECODE (history.vm 'YA' 'REMOVAL' 'YE''INSTALLATION') result" id="result"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@Position@">
          <ds:object>@Position@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@ac_registr@">
          <ds:object>@ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select 
partno,
serialno,
labelno,
location,
event_perfno_i,
voucherno,
to_char(to_date('31.12.1971', 'dd.mm.yyyy') + mutation + mutation_time / 1000 / 60 / 60 / 24, 'dd.mm.yyyy hh24:mi:ss') last_mutation,
ac_registr,

DECODE (vm, 'YA', 'REMOVAL', 'YE', 'INSTALLATION') result

from history

where (REGEXP_LIKE(location, REPLACE( '@Position@', ', ', '|')) OR '@Position@' IS NULL)
and vm in ('YA','YE')
/* and (REGEXP_LIKE(ac_registr, REPLACE( '@ac_registr@', ', ', '|')) OR '@ac_registr@' IS NULL) */
   and ('@ac_registr@' is null or
       ac_registr in
       (select trim(substr('@ac_registr@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@ac_registr@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@ac_registr@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@ac_registr@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;= length('@ac_registr@') -
                    length(replace('@ac_registr@', ',', '')) + 1))
</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
