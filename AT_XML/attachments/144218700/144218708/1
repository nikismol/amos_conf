      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT rownum,
rotables.location,
rotables.tree_position,
rotables.partno,
rotables.serialno,
rotables.partnonew,
rotables.serialnonew,
rotables.ac_registr,
rotables.condition,
part.description,
aircraft.ac_typ,
tac.TAH,
tac.TAC,
tac.TSI,
tac.CSI,
bi.TBI,
bi.CBI,
inst.inst_date
FROM rotables
LEFT JOIN part on rotables.partno = part.partno
LEFT JOIN aircraft on rotables.ac_registr = aircraft.ac_registr
LEFT JOIN position on rotables.locid_pk = position.locid_pk
LEFT JOIN (
                   SELECT history.psn,
                                TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi),60)),'FM00') as TBI,
                                history.cbi as CBI,
                                history.historyno_i,
                                MAX(history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i
                   FROM history
                   WHERE 1=1
                                 AND history.vm='YA'
                                 AND history.del_date&gt;=16588
                  ) bi ON rotables.psn=bi.psn AND bi.historyno_i=bi.max_historyno_i
LEFT JOIN (
                   SELECT history.psn,
		history.historyno_i,
                                MAX(history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i,
		  to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( history.del_date+729),'dd.mm.yyyy') as inst_date       
                   FROM history
                   WHERE 1=1
                                 AND history.vm='YE'
                  ) inst ON rotables.psn=inst.psn AND inst.historyno_i=inst.max_historyno_i
LEFT JOIN (
SELECT rotables.psn,
(TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value)/60),'FM999999999900')) || ':' ||
TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value),60)),'FM00') ||' H') as TAH,
(TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on+counter_c.life_value)||' C') as TAC,
                                (TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on)/60),'FM999999999900')) || ':' ||
                                TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on),60)),'FM00') ||' H') as TSI,
                                (TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on)||' C') as CSI
FROM
rotables
LEFT JOIN (SELECT
				DISTINCT (counter.ref_key),
				counter.counterno_i,
				counter.is_unknown AS is_unknown,
				counter.master_counterno_i,
				max_counter_value.on_counter_valueno_i,
				counter_definition.code,
				NVL(max_counter_value.life_value, 0) as life_value,
				NVL(counter_value_on.life_value, 0) as life_value_on
		   FROM 
				counter
		   		LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
		   		LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
		   		LEFT JOIN (SELECT
					  			counter_value.counter_valueno_i as counter_valueno_i,
					  			counter_value.counterno_i as counterno_i,
					  			counter_value.on_counter_valueno_i,
                                                                                                                  MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                                                                                                  counter_value.readout_date*86400000+counter_value.readout_time as readout,
					  			counter_value.life_value as life_value,
					  			counter_definition.counter_defno_i
				 		   FROM
					  			counter_value
				 		   LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 		   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 		   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 		   WHERE
								counter_definition.counter_defno_i='1'
                                                                                                                AND counter_value.on_counter_valueno_i IS NOT NULL
				 		   ORDER BY
					            counter_value.counterno_i
						  ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
				LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
		   		WHERE
					 counter.ref_type='RO'
			   		 AND counter_definition.counter_defno_i='1'
					 AND max_counter_value.readout=max_counter_value.max_readout
		  ) counter_h ON rotables.psn=counter_h.ref_key 
		  
LEFT JOIN counter counter_m_h ON counter_h.master_counterno_i=counter_m_h.counterno_i

LEFT JOIN (SELECT 
				max_counter_value.counterno_i as counterno_i,
				max_counter_value.counter_valueno_i as counter_valueno_i,
			    NVL(max_counter_value.life_value, 0) as life_value
		   FROM (SELECT
					  counter_value.counter_valueno_i as counter_valueno_i,
					  counter_value.counterno_i as counterno_i,
                                                                        MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                                                        counter_value.readout_date*86400000+counter_value.readout_time as readout,
					  counter_value.life_value as life_value,
					  counter_definition.counter_defno_i
				 FROM
				 	  counter_value
				 LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 WHERE counter_definition.counter_defno_i='1'
					   AND counter_value.readout_ref_type!='LB'
				 ORDER BY
					  counter_value.counterno_i
				) max_counter_value
		   WHERE
				max_counter_value.readout=max_counter_value.max_readout
		  ) counter_value_m_h ON counter_m_h.counterno_i=counter_value_m_h.counterno_i

LEFT JOIN (SELECT
				DISTINCT (counter.ref_key),
				counter.counterno_i,
				counter.is_unknown AS is_unknown,
				counter.master_counterno_i,
				max_counter_value.on_counter_valueno_i,
				counter_definition.code,
				NVL(max_counter_value.life_value, 0) as life_value,
				NVL(counter_value_on.life_value, 0) as life_value_on
		   FROM 
				counter
		   		LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
		   		LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
		   		LEFT JOIN (SELECT
					  			counter_value.counter_valueno_i as counter_valueno_i,
					  			counter_value.counterno_i as counterno_i,
								counter_value.on_counter_valueno_i,
                                                                                                                  MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                                                                                                  counter_value.readout_date*86400000+counter_value.readout_time as readout,
					  			counter_value.life_value as life_value,
					  			counter_definition.counter_defno_i
				 		   FROM
					  			counter_value
				 		   LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 		   LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 		   LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 		   WHERE
								counter_definition.counter_defno_i='2'
                                                                                                                AND counter_value.on_counter_valueno_i IS NOT NULL
				 		   ORDER BY
					            counter_value.counterno_i
						  ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i

LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
		   		WHERE
					 counter.ref_type='RO'
			   	            AND counter_definition.counter_defno_i='2'
					 AND max_counter_value.readout=max_counter_value.max_readout
		  ) counter_c ON rotables.psn=counter_c.ref_key 
		  
LEFT JOIN counter counter_m_c ON counter_c.master_counterno_i=counter_m_c.counterno_i
		  
LEFT JOIN (SELECT 
				max_counter_value.counterno_i as counterno_i,
				max_counter_value.counter_valueno_i as counter_valueno_i,
			    NVL(max_counter_value.life_value, 0) as life_value
		   FROM (SELECT
					  counter_value.counter_valueno_i as counter_valueno_i,
					  counter_value.counterno_i as counterno_i,
                                                                        MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                                                        counter_value.readout_date*86400000+counter_value.readout_time as readout,
					  counter_value.life_value as life_value,
					  counter_definition.counter_defno_i
				 FROM
				 	  counter_value
				 LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
				 LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
				 LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
				 WHERE counter_definition.counter_defno_i='2'
					   AND counter_value.readout_ref_type!='LB'
				 ORDER BY
					  counter_value.counterno_i
				) max_counter_value
		   WHERE
				max_counter_value.readout=max_counter_value.max_readout
		  ) counter_value_m_c ON counter_m_c.counterno_i=counter_value_m_c.counterno_i
) tac ON tac.psn=rotables.psn
WHERE (REGEXP_LIKE(rotables.location, REPLACE('@VAR.position@', ', ', '|')) OR '@VAR.position@' IS NULL)
AND (REGEXP_LIKE(rotables.tree_position, REPLACE('@VAR.TREE_POS@', ', ', '|')) OR '@VAR.TREE_POS@' IS NULL)
AND (REGEXP_LIKE(rotables.partno, REPLACE('@VAR.partno@', ', ', '|')) OR '@VAR.partno@' IS NULL)
AND (REGEXP_LIKE(rotables.serialno, REPLACE('@VAR.serialno@', ', ', '|')) OR '@VAR.serialno@' IS NULL)
AND (REGEXP_LIKE(rotables.ac_registr, REPLACE('@VAR.acreg@', ', ', '|')) OR '@VAR.acreg@' IS NULL)
AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.actype@', ', ', '|')) OR '@VAR.actype@' IS NULL)
AND rotables.ac_registr IS NOT NULL
AND aircraft.status &lt;&gt; 9
Order by rownum, rotables.location</se:textStatement>
