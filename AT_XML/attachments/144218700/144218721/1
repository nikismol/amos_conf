        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE (part.mat_class 'C' 'Consumable'&#10;                        'E' 'Expendable'&#10;                        'R' 'Rotable'&#10;                        'S''Service') as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE (part.mat_type 'CONS' 'CONSUMABLES'&#10;                       'EQUI' 'EQUIPMENT'&#10;                       'FLMB' 'FLAMMABLE LIQUIDS'&#10;                       'GREA' 'SPECIAL GREASE'&#10;                       'KIT' 'KIT'&#10;                       'LIQU' 'SPECIAL LIQUIDS'                    &#10;                       'N' 'NON AIRCRAFT MATERIAL'&#10;                       'P' 'AIRCRAFT PART'&#10;                       'RM' 'RAW MATERIAL'&#10;                       'S' 'SERVICE'&#10;                       'SW' 'SOFTWARE'&#10;                       'T' 'TOOL'&#10;                       'ZSOD''SPECIAL PROTECTIVE EQUIPMENT') as mat_type" id="mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.measure_unit AS measure" id="measure"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN part.mat_class = 'R' THEN (NVL(QTY.rot_qty0)+NVL(QTY.alt_rot_qty0))&#10;         ELSE (NVL(QTY.cons_QTY0)+NVL(QTY.alt_cons_qty0)) &#10;         END AS STOCK_INFO" id="STOCK_INFO"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.wpno@">
          <ds:object>@VAR.wpno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
		wp_sequence.seqno_i as seqno
		,wo_header.event_perfno_i as wono
		,CASE WHEN wo_event_link.event_display IS NULL THEN TO_CHAR(wo_header.event_perfno_i) 
		 ELSE  wo_event_link.event_display END as ename
		,part_request_2.partno as partno
		,part_request_2.qty as qty
		,DECODE (wo_header.event_type,
			'D', 'Document          ',
			'R', 'Rotable Requirement', 
			'C', 'Check             ',
			'T', 'Block Taskcard    ',
			'Q', 'Single Running    ',
			'V', 'Replacement Event ',
			'E', 'Change Order      ',
			'O', 'Event Tracking WO ',
			'SV',' Shop Visit WO    ',
			'SC',' Sim. Complaint WO',
			'W', 'Finding WO        ',
			'I', 'Import WO         ',
			'P', 'Panel Workorder   ',
			'J', 'JIC Workorder     ',
			'Workorder'
		) as etype
		,part_request_2.part_requestno_i as preq
		,DECODE (part.mat_class, 'C', 'Consumable',
								'E', 'Expendable',
								'R', 'Rotable',
								'S', 'Service') as mat_class
		,DECODE (part.mat_type, 'CONS', 'CONSUMABLES',
							'EQUI', 'EQUIPMENT',
							'FLMB', 'FLAMMABLE LIQUIDS',
							'GREA', 'SPECIAL GREASE',
							'KIT', 'KIT',
							'LIQU', 'SPECIAL LIQUIDS',                    
							'N', 'NON AIRCRAFT MATERIAL',
							'P', 'AIRCRAFT PART',
							'RM', 'RAW MATERIAL',
							'S', 'SERVICE',
							'SW', 'SOFTWARE',
							'T', 'TOOL',
							'ZSOD', 'SPECIAL PROTECTIVE EQUIPMENT') as mat_type
		,part.measure_unit AS measure
        ,CASE WHEN part.mat_class = 'R' THEN (NVL(QTY.rot_qty,0)+NVL(QTY.alt_rot_qty,0))
         ELSE (NVL(QTY.cons_QTY,0)+NVL(QTY.alt_cons_qty,0)) 
         END AS STOCK_INFO
FROM
wp_assignment
LEFT JOIN wp_sequence ON wp_assignment.event_perfno_i = wp_sequence.event_perfno_i AND wp_sequence.status = 0
LEFT JOIN wo_header ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i
LEFT JOIN workstep_link ON wo_header.event_perfno_i = workstep_link.event_perfno_i
LEFT JOIN part_request_2 ON part_request_2.event_type = 'WSL' AND part_request_2.event_key = workstep_link.workstep_linkno_i
JOIN part ON part_request_2.partno = part.partno
LEFT JOIN 
			(
				SELECT
					part.partno AS partno
					,part_alternate.alt_cons_qty AS alt_cons_qty 
					,part_alternate.alt_rot_qty AS alt_rot_qty
					,COUNT(rotables.serialno) AS rot_qty
					,SUM(consumables.qty) AS cons_qty 
				FROM part
				LEFT JOIN 
							(
								SELECT 
										part_alternate.partno AS partno
										,LISTAGG(part_alternate.altpartno,', ') WITHIN GROUP (ORDER BY part_alternate.partno) AS altpartno
										,COUNT(rotables.serialno) AS alt_rot_qty
										,SUM(consumables.qty) AS alt_cons_qty
								FROM part
								LEFT JOIN part_alternate ON part.partno = part_alternate.partno
								LEFT JOIN rotables ON part_alternate.altpartno = rotables.partno
								LEFT JOIN consumables ON part_alternate.altpartno = consumables.partno
								GROUP BY part_alternate.partno
							) part_alternate ON part.partno = part_alternate.partno
				LEFT JOIN rotables ON part.partno = rotables.partno
				LEFT JOIN consumables ON part.partno = consumables.partno
				GROUP BY 
				part.partno
				,part_alternate.alt_cons_qty
				,part_alternate.alt_rot_qty
				,part.mat_class
			) QTY ON part.partno = QTY.partno
WHERE
wp_assignment.wpno_i = '@VAR.wpno@'
AND part_request_2.partno IS NOT NULL
ORDER BY wp_sequence.seqno_i
/*wp_assignment.wpno_i = '41172'
AND part_request_2.partno IS NOT NULL
ORDER BY wp_sequence.seqno_i*/</se:textStatement>
        </se:sqlStatement>
