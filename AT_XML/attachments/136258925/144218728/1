    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="224_USERS_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.user_sign as user_sign" id="user_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.lastname as lastname" id="lastname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname as firstname" id="firstname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.workgroup as workgroup" id="workgroup"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.jobcode as jobcode" id="jobcode"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT (user_group.user_group) as group_count" id="group_count"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_department@">
          <ds:object>@VAR.v01_department@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_user_status@">
          <ds:object>@VAR.v02_user_status@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT sign.user_sign as user_sign,
             sign.lastname as lastname,
             sign.firstname as firstname,
             sign.workgroup as workgroup,
             sign.jobcode as jobcode,
             COUNT (user_group.user_group) as group_count
FROM sign
JOIN menu_user ON menu_user.login_sign = sign.user_sign
LEFT JOIN user_access ON menu_user.login_sign=user_access.login_sign
LEFT JOIN user_group ON user_access.user_group=user_group.user_group AND user_group.status&lt;&gt;9
WHERE 1=1
              AND sign.department='@VAR.v01_department@'
              AND (menu_user.status&lt;&gt;9 AND '@VAR.v02_user_status@'='ACTIVE'
                        OR menu_user.status=9 AND '@VAR.v02_user_status@'='INACTIVE'
                        OR '@VAR.v02_user_status@'='ALL')
GROUP BY sign.user_sign,
                    sign.lastname,
                    sign.firstname,
                    sign.workgroup,
                    sign.jobcode
ORDER BY group_count, 1, 4, 5</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
