    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_TQ_COUNT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="(SELECT COUNT (tech_query.queryno_i)&#10;           FROM tech_query&#10;           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ')&#10;                          AND tech_query.status NOT IN (39)) as all_tq" id="all_tq"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;          (SELECT COUNT (tech_query.queryno_i)&#10;           FROM tech_query&#10;           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ')&#10;                          AND tech_query.status NOT IN (3 9)&#10;                          AND tech_query.due_date&lt;FLOOR(sysdate-to_date('19711231''yyyymmdd'))) as exp_tq" id="exp_tq"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;          (SELECT COUNT (tech_query.queryno_i)&#10;           FROM tech_query&#10;           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ')&#10;                          AND tech_query.status NOT IN (3 9)&#10;                          AND tech_query.due_date&gt;=FLOOR(sysdate-to_date('19711231''yyyymmdd'))&#10;                          AND tech_query.due_date&lt;=FLOOR(sysdate-to_date('19711231''yyyymmdd'))+'@VAR.to_go@'&#10;                          AND '@VAR.to_go@' IS NOT NULL) as soon_exp_tq" id="soon_exp_tq"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;/* Due Date изменен за последние Х дней */&#10;          (&#10;           SELECT COUNT (tech_query.queryno_i)&#10;           FROM tech_query&#10;           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ')&#10;                          AND tech_query.status NOT IN (3 9)&#10;                          AND tech_query.due_date&gt;=FLOOR(sysdate-to_date('19711231''yyyymmdd'))&#10;                          AND tech_query.due_date&lt;=FLOOR(sysdate-to_date('19711231''yyyymmdd'))+'@VAR.to_go@'&#10;                          AND '@VAR.to_go@' IS NOT NULL&#10;          ) as due_chng_tq" id="due_chng_tq"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;          (SELECT COUNT (tech_query.queryno_i)&#10;           FROM tech_query&#10;           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ')&#10;                          AND tech_query.status NOT IN (39)&#10;                          AND tech_query.priority='HIGH') as high_all_tq" id="high_all_tq"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;          (SELECT COUNT (tech_query.queryno_i)&#10;           FROM tech_query&#10;           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ')&#10;                          AND tech_query.status NOT IN (3 9)&#10;                          AND tech_query.due_date&lt;FLOOR(sysdate-to_date('19711231''yyyymmdd'))&#10;                          AND tech_query.priority='HIGH') as high_exp_tq" id="high_exp_tq"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;          (SELECT COUNT (tech_query.queryno_i)&#10;           FROM tech_query&#10;           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ')&#10;                          AND tech_query.status NOT IN (3 9)&#10;                          AND tech_query.priority='HIGH'&#10;                          AND tech_query.due_date&gt;=FLOOR(sysdate-to_date('19711231''yyyymmdd'))&#10;                          AND tech_query.due_date&lt;=FLOOR(sysdate-to_date('19711231''yyyymmdd'))+'@VAR.to_go@'&#10;                          AND '@VAR.to_go@' IS NOT NULL) as high_soon_exp_tq" id="high_soon_exp_tq"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;/* Due Date изменен за последние Х дней (с приоритетом high) */&#10;          (&#10;           SELECT COUNT (tech_query.queryno_i)&#10;           FROM tech_query&#10;           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ')&#10;                          AND tech_query.status NOT IN (3 9)&#10;                          AND tq_note.note LIKE ('Changed%')&#10;                          AND tq_note.mutation&gt;=FLOOR(sysdate-to_date('19711231''yyyymmdd'))-'@VAR.days_before@' AND '@VAR.days_before@' IS NOT NULL&#10;                          AND tech_query.priority='HIGH'&#10;          ) as high_due_chng_tq" id="high_due_chng_tq"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.to_go@">
          <ds:object>@VAR.to_go@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.days_before@">
          <ds:object>@VAR.days_before@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
/* всего заявок */
          (
           SELECT COUNT (tech_query.queryno_i)
           FROM tech_query
           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                          AND tech_query.status NOT IN (3, 9)
          ) as all_tq,

/* просроченных заявок */
          (
           SELECT COUNT (tech_query.queryno_i)
           FROM tech_query
           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                          AND tech_query.status NOT IN (3, 9)
                          AND tech_query.due_date&lt;FLOOR(sysdate-to_date('19711231','yyyymmdd'))
          ) as exp_tq,

/* Due Date истекает через заданное количество дней */
          (
           SELECT COUNT (tech_query.queryno_i)
           FROM tech_query
           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                          AND tech_query.status NOT IN (3, 9)
                          AND tech_query.due_date&gt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))
                          AND tech_query.due_date&lt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))+'@VAR.to_go@'
                          AND '@VAR.to_go@' IS NOT NULL
          ) as soon_exp_tq,

/* Due Date изменен за последние Х дней */
          (
           SELECT COUNT (tech_query.queryno_i)
           FROM tech_query
           LEFT JOIN (
                               SELECT max_note.queryno_i,
                                              max_note.mutation,
                                              max_note.note
                               FROM (
                                            SELECT tech_query_note.queryno_i,
                                                           tech_query_note.noteno_i,
                                                           MAX(tech_query_note.noteno_i) OVER (PARTITION BY tech_query_note.queryno_i) as max_noteno_i,
                                                           tech_query_note.mutation,
                                                           DBMS_lob.substr(tech_query_note.note,4000,1) as note
                                            FROM tech_query_note
                                            WHERE tech_query_note.note_type='T'
                                           ) max_note
                              WHERE max_note.noteno_i=max_note.max_noteno_i
                             ) tq_note ON tech_query.queryno_i=tq_note.queryno_i
           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                          AND tech_query.status NOT IN (3, 9)
                          AND tq_note.note LIKE ('Changed%')
                          AND tq_note.mutation&gt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))-'@VAR.days_before@' AND '@VAR.days_before@' IS NOT NULL
          ) as due_chng_tq,

/* всего заявок с приоритетом high */
          (
           SELECT COUNT (tech_query.queryno_i)
           FROM tech_query
           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                          AND tech_query.status NOT IN (3, 9)
                          AND tech_query.priority='HIGH'
          ) as high_all_tq,

/* просроченных заявок с приоритетом high */
          (
           SELECT COUNT (tech_query.queryno_i)
           FROM tech_query
           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                          AND tech_query.status NOT IN (3, 9)
                          AND tech_query.due_date&lt;FLOOR(sysdate-to_date('19711231','yyyymmdd'))
                          AND tech_query.priority='HIGH'
          ) as high_exp_tq,

/* Due Date истекает через заданное количество дней (с приоритетом high) */
          (
           SELECT COUNT (tech_query.queryno_i)
           FROM tech_query
           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                          AND tech_query.status NOT IN (3, 9)
                          AND tech_query.priority='HIGH'
                          AND tech_query.due_date&gt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))
                          AND tech_query.due_date&lt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))+'@VAR.to_go@'
                          AND '@VAR.to_go@' IS NOT NULL
          ) as high_soon_exp_tq,

/* Due Date изменен за последние Х дней (с приоритетом high) */
          (
           SELECT COUNT (tech_query.queryno_i)
           FROM tech_query
           LEFT JOIN (
                               SELECT max_note.queryno_i,
                                              max_note.mutation,
                                              max_note.note
                               FROM (
                                            SELECT tech_query_note.queryno_i,
                                                           tech_query_note.noteno_i,
                                                           MAX(tech_query_note.noteno_i) OVER (PARTITION BY tech_query_note.queryno_i) as max_noteno_i,
                                                           tech_query_note.mutation,
                                                           DBMS_lob.substr(tech_query_note.note,4000,1) as note
                                            FROM tech_query_note
                                            WHERE tech_query_note.note_type='T'
                                           ) max_note
                              WHERE max_note.noteno_i=max_note.max_noteno_i
                             ) tq_note ON tech_query.queryno_i=tq_note.queryno_i
           WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                          AND tech_query.status NOT IN (3, 9)
                          AND tq_note.note LIKE ('Changed%')
                          AND tq_note.mutation&gt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))-'@VAR.days_before@' AND '@VAR.days_before@' IS NOT NULL
                          AND tech_query.priority='HIGH'
          ) as high_due_chng_tq
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_TQ_REASON_COUNT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="tq.qty||' ('||high_tq.qty||'-high)' as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tq.reason as reason" id="reason"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT tq.qty||' ('||high_tq.qty||'-high)' as qty,
               tq.reason as reason
FROM (
             SELECT COUNT (tech_query.queryno_i) as qty,
                            NVL(tech_query_ir_reason.reason, 'UNSPECIFIED') as reason 
             FROM tech_query
             LEFT JOIN tech_query_ir_reason ON tech_query.interruption_reason=tech_query_ir_reason.code
             WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                            AND tech_query.status NOT IN (3, 9)
             GROUP BY tech_query_ir_reason.reason
            ) tq
            LEFT JOIN (
                                SELECT COUNT (tech_query.queryno_i) as qty,
                                               NVL(tech_query_ir_reason.reason, 'UNSPECIFIED') as reason 
                                FROM tech_query
                                LEFT JOIN tech_query_ir_reason ON tech_query.interruption_reason=tech_query_ir_reason.code
                                WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                                               AND tech_query.status NOT IN (3, 9)
                                              AND tech_query.priority='HIGH'
                                GROUP BY tech_query_ir_reason.reason
                               ) high_tq ON tq.reason=high_tq.reason
ORDER BY 2</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
