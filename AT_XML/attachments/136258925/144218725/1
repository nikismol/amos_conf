    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_TQ" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT tech_query.queryno_i as id" id="id"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.priority as prio" id="prio"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="headline" id="headline"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.lastname||' '||sign.firstname as issued_by" id="issued_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.assigned_to||CASE WHEN tech_query.issued_by_group IS NULL THEN '' ELSE ' ('||tech_query.assigned_to_group||')' END as assigned_to" id="assigned_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (tech_query.created_date)'DD.MM.YYYY') as created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.due_date as due_date" id="due_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query_ir_reason.reason as ir" id="ir"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              CASE WHEN tech_query.due_date&lt;FLOOR(sysdate-to_date('19711231''yyyymmdd'))&#10;                        THEN 'delay'&#10;                        WHEN tech_query.due_date&gt;=FLOOR(sysdate-to_date('19711231''yyyymmdd')) AND tech_query.due_date&lt;=FLOOR(sysdate-to_date('19711231''yyyymmdd'))+'@VAR.days@'&#10;                        THEN ('@VAR.days@'-FLOOR(sysdate-to_date('19711231''yyyymmdd')))||'d_to_go'&#10;                        WHEN tq_note.note LIKE ('Changed%')&#10;                        THEN REPLACE(SUBSTR(tq_note.note 22 27) 'to''-&gt;')&#10;                        ELSE ''&#10;              END as status" id="status"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.to_go@">
          <ds:object>@VAR.to_go@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.days_before@">
          <ds:object>@VAR.days_before@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.high_prio@">
          <ds:object>@VAR.high_prio@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT tech_query.queryno_i as id,
              tech_query.priority as prio,
              tech_query.headline as headline,
              sign.lastname||' '||sign.firstname||CASE WHEN tech_query.issued_by_group IS NULL THEN '' ELSE CHR(10)||'('||tech_query.issued_by_group||')' END as issued_by,
              tech_query.assigned_to||CASE WHEN tech_query.issued_by_group IS NULL THEN '' ELSE CHR(10)||'('||tech_query.assigned_to_group||')' END as assigned_to,
              TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (tech_query.created_date), 'DD.MM.YYYY') as created_date,
              TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (tech_query.due_date), 'DD.MM.YYYY') as due_date,
              tech_query_ir_reason.reason as ir,
              CASE WHEN tech_query.due_date&lt;FLOOR(sysdate-to_date('19711231','yyyymmdd'))
                        THEN 'Due Date: expired'
                        WHEN tech_query.due_date&gt;=FLOOR(sysdate-to_date('19711231','yyyymmdd')) AND tech_query.due_date&lt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))+'@VAR.to_go@'
                        THEN 'Due Date: '||(tech_query.due_date-FLOOR(sysdate-to_date('19711231','yyyymmdd')))||'d To Go'
                        WHEN tq_note.note LIKE ('Changed%') AND tq_note.mutation&gt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))-'@VAR.days_before@' AND '@VAR.days_before@' IS NOT NULL
                        THEN 'Due Date: changed'||CHR(10)||REPLACE(SUBSTR(tq_note.note, 22, 27), 'to', '-&gt;')
                        ELSE ''
              END as status
FROM tech_query
LEFT JOIN sign ON tech_query.issued_by=sign.user_sign
LEFT JOIN tech_query_ir_reason ON tech_query.interruption_reason=tech_query_ir_reason.code
LEFT JOIN (
                    SELECT max_note.queryno_i,
                                   max_note.mutation,
                                   max_note.note
                    FROM (
                                 SELECT tech_query_note.queryno_i,
                                                tech_query_note.noteno_i,
                                                MAX(tech_query_note.noteno_i) OVER (PARTITION BY tech_query_note.queryno_i) as max_noteno_i,
                                                tech_query_note.mutation,
                                                DBMS_lob.substr(tech_query_note.note,4000,1) as note
                                 FROM tech_query_note
                                 WHERE tech_query_note.note_type='T'
                                ) max_note
                   WHERE max_note.noteno_i=max_note.max_noteno_i
                  ) tq_note ON tech_query.queryno_i=tq_note.queryno_i
WHERE tech_query.assigned_to_group IN ('2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
               AND tech_query.status NOT IN (3, 9)
               AND (
                          tech_query.due_date&lt;FLOOR(sysdate-to_date('19711231','yyyymmdd'))
                          OR
                          tech_query.due_date&gt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))
                          AND tech_query.due_date&lt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))+'@VAR.to_go@'
                          AND '@VAR.to_go@' IS NOT NULL
                          OR
                          tech_query.priority='HIGH' AND '@VAR.high_prio@'='Y'
                          OR
                          tq_note.note LIKE ('Changed%') AND tq_note.mutation&gt;=FLOOR(sysdate-to_date('19711231','yyyymmdd'))-'@VAR.days_before@' AND '@VAR.days_before@' IS NOT NULL
                         )
ORDER BY assigned_to</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
