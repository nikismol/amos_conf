      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as ac_type" id="ac_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.tsn as tsn" id="tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.csn as csn" id="csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="at.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;        TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (h.dsn+729)'DD.MM.YYYY') as mandate" id="mandate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.serialno as ac_serialno" id="ac_serialno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@certif.form_tracking_number@">
          <ds:object>@certif.form_tracking_number@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT aircraft.ac_typ as ac_type,
               history.ac_registr as ac_registr,
               CASE WHEN history.tsn_unknown='Y'
                         THEN 'UNK'
                          ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn),60)),'FM00')
               END as tsn,
               CASE WHEN history.csn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(history.csn) END as csn,
	history.partno as partno,
	history.serialno as serialno,
	part.description as description,
               TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.dsn+729), 'DD.MM.YYYY') as mandate,
	aircraft.serialno as ac_serialno
FROM history
LEFT JOIN aircraft ON aircraft.ac_registr = history.ac_registr
LEFT JOIN part on part.partno = history.partno
WHERE history.historyno_i = (
	                                        SELECT max(history.historyno_i)
                                                       FROM history
                                                       WHERE history.historyno_i &lt; (
                                                                                                             SELECT DISTINCT history.historyno_i as historyno_i
                                                                                                             FROM certificate
                                                                                                             LEFT JOIN certificate_link ON certificate.certificate_i=certificate_link.certificate_i
			                                                                 LEFT JOIN od_rec_detail ON od_rec_detail.recdetailno_i = certificate_link.source_key
			                                                                 LEFT JOIN history ON (history.recdetailno_i = od_rec_detail.recdetailno_i AND history.vm='B1')
			                                                                 WHERE certificate_link.source_type = 'RD' 
                                                                                                                            AND certificate.form_tracking_no = '@certif.form_tracking_number@'
                                                                                                                            AND certificate.certificate_type_i = 112
                                                                                                           ) 
                                                                      AND history.vm = 'YA'
                                                                      AND history.partno = (
                                                                                                               SELECT DISTINCT history.partno as partno
                                                                                                               FROM certificate
                                                                                                               LEFT JOIN certificate_link ON certificate.certificate_i=certificate_link.certificate_i
			                                                                   LEFT JOIN od_rec_detail ON od_rec_detail.recdetailno_i = certificate_link.source_key
			                                                                   LEFT JOIN history ON (history.recdetailno_i = od_rec_detail.recdetailno_i AND history.vm='B1')
			                                                                   WHERE certificate_link.source_type = 'RD' 
                                                                                                                              AND certificate.form_tracking_no = '@certif.form_tracking_number@'
                                                                                                                              AND certificate.certificate_type_i = 112
                                                                                                             ) 
                                                                      AND history.serialno = (
                                                                                                                  SELECT DISTINCT history.serialno as serialno
                                                                                                                  FROM certificate
                                                                                                                  LEFT JOIN certificate_link ON certificate.certificate_i=certificate_link.certificate_i
			                                                                      LEFT JOIN od_rec_detail ON od_rec_detail.recdetailno_i = certificate_link.source_key
			                                                                      LEFT JOIN history ON (history.recdetailno_i = od_rec_detail.recdetailno_i AND history.vm='B1')
			                                                                      WHERE certificate_link.source_type = 'RD' 
                                                                                                                                 AND certificate.form_tracking_no = '@certif.form_tracking_number@'
                                                                                                                                 AND certificate.certificate_type_i = 112
                                                                                                               )
                                                      )</se:textStatement>
        </se:sqlStatement>
