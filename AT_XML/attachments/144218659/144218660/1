    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="acbdca" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="at.ac_typ as type" id="type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.ac_registr as registr" id="registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.tsn as tsn" id="tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.csn as csn" id="csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.dsn as mandate" id="mandate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="at.serialno as serialno" id="serialno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@certif.form_tracking_number@">
          <ds:object>@certif.form_tracking_number@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  h.ac_typ as type,
        h.ac_registr as registr,
        h.tsn as tsn,
        h.csn as csn,
        TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (h.dsn+729), 'DD.MM.YYYY') as mandate,
        at.serialno as serialno
FROM history h
JOIN aircraft at ON h.ac_registr = at.ac_registr
WHERE historyno_i = (
         SELECT MAX(historyno_i) as max_ya 
         FROM history 
         WHERE historyno_i &lt; (
                  SELECT min(historyno_i)
                  FROM history 
                  WHERE voucherno = '@certif.form_tracking_number@'
               ) 
               AND vm = 'YA'
      )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_ENG_BCAA_LAST_YA" type="SQL_EDITOR_DATASOURCE" version="2.0">
