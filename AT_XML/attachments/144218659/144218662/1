    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_EASA_part_desc" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="pd.text" id="pd.text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@certif.part_no@">
          <ds:object>@certif.part_no@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT pd.text 
FROM part_description pd
JOIN part p ON p.partseqno_i = pd.partseqno_i
WHERE p.partno = '@certif.part_no@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CM_EASA_Receiving" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.partno as pn" id="pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cc.is_unknown as ccunk" id="ccunk"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ch.ch.is_unknown as chunk" id="chunk"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cert.organisation_address as field_12" id="field_12"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cert.organisation_comm as field_13" id="field_13"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@certif.form_tracking_number@">
          <ds:object>@certif.form_tracking_number@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@certif.serial_no@">
          <ds:object>@certif.serial_no@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT certd.partno as pn,
               cc.is_unknown as ccunk,
               ch.is_unknown as chunk,
               cert.organisation_address as field_12,
               cert.organisation_comm as field_13
FROM certificate cert

LEFT JOIN certificate_link ON certificate_link.certificate_i = cert.certificate_i AND certificate_link.source_type = 'RD'

LEFT JOIN certificate_data certd ON cert.certificate_i = certd.certificate_i

LEFT JOIN od_rec_detail ord ON ord.recdetailno_i = certificate_link.source_key
LEFT JOIN history h ON (h.recdetailno_i = ord.recdetailno_i AND h.vm='B1')

LEFT JOIN counter ch ON ch.ref_type = 'RO' AND ch.ref_key = h.psn
LEFT JOIN counter_template cth ON cth.counter_templateno_i = ch.counter_templateno_i
LEFT JOIN counter_definition cdh ON cdh.counter_defno_i = cth.counter_defno_i

LEFT JOIN counter cc ON cc.ref_type = 'RO' AND cc.ref_key = h.psn
LEFT JOIN counter_template ctc on ctc.counter_templateno_i = cc.counter_templateno_i
LEFT JOIN counter_definition cdc ON cdc.counter_defno_i = ctc.counter_defno_i

WHERE cert.form_tracking_no = '@certif.form_tracking_number@' AND h.serialno = '@certif.serial_no@'
AND cdc.code='C' AND cdh.code='H'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CM_EASA_RemToUnk" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>AFL_CM_EASA_RemToUnk</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN '@AFL_CM_EASA_Receiving.ccunk@' = 'Y' THEN&#10;&#9;CASE WHEN '@AFL_CM_EASA_Receiving.chunk@' = 'Y' THEN&#10;&#9;&#9;REGEXP_REPLACE('@certif.remarks1@' '(TSN|CSN)\ *=\ *[0-9]+\ *(hours|cycles)' '\1=UNK')&#10;&#9;ELSE&#10;&#9;&#9;REGEXP_REPLACE('@certif.remarks1@' '(CSN)\ *=\ *[0-9]+\ *(cycles)' '\1=UNK')&#10;&#9;END&#10;ELSE&#10;&#9;CASE WHEN '@AFL_CM_EASA_Receiving.chunk@' = 'Y' THEN&#10;&#9;&#9;REGEXP_REPLACE('@certif.remarks1@' '(TSN)\ *=\ *[0-9]+\ *(hours)''\1=UNK')&#10;&#9;ELSE&#10;&#9;&#9;'@certif.remarks1@'&#10;&#9;END&#10;END as f_rem" id="f_rem"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_CM_EASA_Receiving.ccunk@">
          <ds:object>@AFL_CM_EASA_Receiving.ccunk@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_CM_EASA_Receiving.chunk@">
          <ds:object>@AFL_CM_EASA_Receiving.chunk@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@certif.remarks1@">
          <ds:object>@certif.remarks1@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
CASE WHEN '@AFL_CM_EASA_Receiving.ccunk@' = 'Y' THEN
	CASE WHEN '@AFL_CM_EASA_Receiving.chunk@' = 'Y' THEN
		REGEXP_REPLACE('@certif.remarks1@', '(TSN|CSN)\ *=\ *[0-9]+\ *(hours|cycles)', '\1=UNK')
	ELSE
