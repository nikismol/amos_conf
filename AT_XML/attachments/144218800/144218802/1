      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT DISTINCT location.station as station,
       location.store as store,
       location.location as location,
       part.partno as partno,
       pn_loc.sn_bn as sn_bn,
       part.description as description,
       DECODE (part.mat_class, 'C', 'CR', part.mat_class) as mat_class,
       TO_NUMBER(pn_loc.qty) as qty,
       pn_loc.condition as condition,
       pn_loc.recdetailno_i as recdetailno_i,
       pn_loc.owner as owner,
       od_inf.orderno as orderno,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od_inf.orderdate+729), 'DD.MM.YYYY') as orderdate,
       od_inf.order_type as order_type,
       od_inf.order_state as order_state
FROM part 
LEFT JOIN (SELECT part.partno as partno,
                  CASE WHEN part.mat_class='R' THEN TO_CHAR(rotables.locationno_i)
                       WHEN part.mat_class='C' THEN TO_CHAR(consumables.locationno_i)
                       ELSE ''
                  END as locationno_i,
                  CASE WHEN part.mat_class='R' THEN rotables.serialno
                       WHEN part.mat_class='C' THEN TO_CHAR(consumables.batchno)
                       ELSE ''
                  END as sn_bn,
                  CASE WHEN part.mat_class='C' THEN TO_CHAR(consumables.qty) ELSE '' END as qty,
                  CASE WHEN part.mat_class='R' THEN rotables.condition
                       WHEN part.mat_class='C' THEN consumables.condition
                       ELSE ''
                  END as condition,
                  CASE WHEN part.mat_class='R' THEN TO_CHAR(rotables.rec_detailno_i)
                       WHEN part.mat_class='C' THEN TO_CHAR(consumables.recdetailno_i)
                       ELSE ''
                  END as recdetailno_i,
                  CASE WHEN part.mat_class='R' THEN rotables.owner
                       WHEN part.mat_class='C' THEN consumables.owner
                       ELSE ''
                  END as owner,
                  CASE WHEN part.mat_class='R' THEN rotables.partno||' '||rotables.serialno
                       WHEN part.mat_class='C' THEN consumables.partno||' '||consumables.batchno
                       ELSE ''
                  END as pn_key
           FROM part
           LEFT JOIN rotables ON part.partno=rotables.partno
           LEFT JOIN consumables ON part.partno=consumables.partno
          ) pn_loc ON part.partno=pn_loc.partno
LEFT JOIN location ON pn_loc.locationno_i=location.locationno_i
LEFT JOIN (SELECT DISTINCT od_header.orderno as orderno,
                  od_header.order_type as order_type,
                  od_header.orderdate as orderdate,
                  od_header.ext_state as order_state,
                  od_detail.partno as partno,
                  od_detail.serialno as serialno, 
                  od_detail.partno||' '||od_detail.serialno as pn_key
           FROM od_header
           LEFT JOIN od_detail ON od_detail.orderno_i = od_header.orderno_i
           WHERE (REGEXP_LIKE(od_header.ext_state, REPLACE('@VAR.od_state@', ', ', '|')) OR '@VAR.od_state@' IS NULL)
                 AND (
                      od_header.order_type='LU' AND '@VAR.TYPE_LU@'='Y'
                      OR od_header.order_type='PU' AND '@VAR.TYPE_PU@'='Y'
                      OR od_header.order_type='PX' AND '@VAR.TYPE_PX@'='Y'
                      OR od_header.order_type='R' AND '@VAR.TYPE_R@'='Y'
                      OR od_header.order_type='X' AND '@VAR.TYPE_X@'='Y'
                      OR od_header.order_type='YU' AND '@VAR.TYPE_YU@'='Y'
                      OR '@VAR.TYPE_LU@'='N'
                         AND '@VAR.TYPE_LU@'='N'
                         AND '@VAR.TYPE_PU@'='N'
                         AND '@VAR.TYPE_PX@'='N'
                         AND '@VAR.TYPE_R@'='N'
                         AND '@VAR.TYPE_X@'='N'
                         AND '@VAR.TYPE_YU@'='N'
                         AND (od_header.order_type LIKE ('%') OR od_header.order_type IS NULL)
                     )
          ) od_inf ON pn_loc.pn_key=od_inf.pn_key
LEFT JOIN station_store ON station_store.station=location.station AND station_store.store=location.store
WHERE (part.mat_class='R' OR part.mat_class='C' AND part.repairable='Y')
      AND station_store.address_i='@VAR.address_i@'
      AND ('@VAR.od_null@'='Y' AND od_inf.orderno IS NULL OR '@VAR.od_null@'='N')</se:textStatement>
        </se:sqlStatement>
