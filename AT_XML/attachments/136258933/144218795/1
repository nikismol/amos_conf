        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_header.issue_date+729)'DD.MM.YYYY') as wo_issue_date" id="wo_issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header_more.mel_chapter" id="wo_header_more.mel_chapter"/>
