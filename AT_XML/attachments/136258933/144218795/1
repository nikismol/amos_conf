        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_transfer.absolute_due_date+729)'DD.MM.YYYY') as wo_due_date" id="wo_due_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" CASE WHEN mel_detail.mel_detailno_i IS NULL THEN '' ELSE '&lt;b&gt;MEL:&lt;/b&gt;&lt;br /&gt;'||TO_CHAR(mel_tree.mel_text)||' &lt;b&gt;'||DECODE(mel_detail.ops_proc_req||mel_detail.maint_proc_req 'YY' '(O)(M)' 'YN' '(O)' 'NY' '(M)''')||'&lt;/b&gt;' END as c_mel_text" id="c_mel_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN ac_lim.event_perfno_i IS NULL THEN '' ELSE ac_lim.limitations_agg END as limitations_agg_na" id="limitations_agg_na"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" CASE WHEN wo_opus.free_text IS NOT NULL THEN TO_CLOB(CONCAT(TO_CLOB('&lt;br /&gt;&lt;b&gt;MCC Comments:&lt;/b&gt;&lt;br /&gt;')TO_CLOB(wo_opus.free_text))) ELSE TO_CLOB('') END as mcc_remarks" id="mcc_remarks"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" CASE WHEN mel_detail.mel_detailno_i IS NOT NULL THEN &#10;CASE WHEN aircraft.ac_typ IN ('A32S' 'A330' 'RRJ') THEN &#10;&#9;&#9;TO_CLOB(CONCAT(TO_CLOB('&lt;b&gt;MEL Remarks:&lt;/b&gt;&lt;br /&gt;') mel_detail.mel_remarks))&#10;&#9;ELSE&#10;&#9;&#9;CASE WHEN mel_procedure.maint_proc_text IS NOT NULL OR mel_procedure.ops_proc_text IS NOT NULL THEN&#10;&#9;&#9;&#9;&#9;TO_CLOB(CONCAT(TO_CLOB('&lt;br /&gt;&lt;b&gt;Procedures:&lt;/b&gt;&lt;br /&gt;') &#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;TO_CLOB('')&#10;&#9;&#9;&#9;&#9;))&#10;&#9;&#9;&#9;ELSE&#10;&#9;&#9;&#9;    TO_CLOB(CONCAT(TO_CLOB('&lt;b&gt;MEL Remarks:&lt;/b&gt;&lt;br /&gt;')mel_detail.mel_remarks))&#10;&#9;&#9;END&#10;&#9;END &#10;ELSE TO_CLOB('')&#10;END&#10;as c_mel_procedures" id="c_mel_procedures"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN aircraft.ac_typ IN ('B737' 'B777') THEN &#10;&#9;&#9;&#9;&#9;TO_CLOB(CONCAT(TO_CLOB('&lt;b&gt;MEL Remarks:&lt;/b&gt;&lt;br /&gt;')mel_detail.mel_remarks))&#10;&#9;ELSE TO_CLOB('')&#10;END as remarks" id="remarks"/>
