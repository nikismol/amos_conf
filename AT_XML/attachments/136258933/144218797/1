    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MEL_Main" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.text as c_wo_step_text" id="c_wo_step_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.mel_code" id="wo_header.mel_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_header.issue_date+729)'DD.MM.YYYY') as wo_issue_date" id="wo_issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header_more.mel_chapter" id="wo_header_more.mel_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" DECODE(wo_header.type 'M' 'Maint.' 'P' 'PiRep' 'C' 'Cabin''Unknown') as wo_type" id="wo_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_transfer.absolute_due_date+729)'DD.MM.YYYY') as wo_due_date" id="wo_due_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno as partno" id="partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_MEL_MainACTyp.ac_typ.ac_typ@">
          <ds:object>@AFL_MEL_MainACTyp.ac_typ.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.sort_order@">
          <ds:object>@VAR.sort_order@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    wo_header.ac_registr,
    aircraft.ac_typ,
    wo_header.event_perfno_i,
    wo_text_description.text as c_wo_step_text,
    wo_header.mel_code,
    TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.issue_date+729), 'DD.MM.YYYY') as wo_issue_date,
    wo_header_more.mel_chapter,
    DECODE(wo_header.type, 'M', 'Maint.', 'P', 'PiRep', 'C', 'Cabin', 'Unknown') as wo_type,
    TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_transfer.absolute_due_date+729), 'DD.MM.YYYY') as wo_due_date,
    part.partno as partno
FROM wo_header
LEFT JOIN aircraft ON aircraft.ac_registr = wo_header.ac_registr
LEFT JOIN workstep_link ON (workstep_link.event_perfno_i = wo_header.event_perfno_i AND workstep_link.sequenceno = 1)
LEFT JOIN wo_text_description ON wo_text_description.descno_i = workstep_link.descno_i
LEFT JOIN wo_transfer ON (wo_header.event_perfno_i = wo_transfer.event_perfno_i AND wo_transfer.is_last_transfer = 'Y')
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN wo_opus ON wo_header.event_perfno_i = wo_opus.event_perfno_i
LEFT JOIN wo_header_4 on wo_header_4.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN (
    SELECT
        wh.event_perfno_i,
        to_char(listagg(case when stock.alt_qty is null and stock.part_qty is null THEN pr2.partno
            end, ', ')) as partno
    FROM wo_header wh
        left join workstep_link wl on wh.event_perfno_i=wl.event_perfno_i
        left join part_request_2 pr2 on wl.workstep_linkno_i=pr2.event_key and pr2.event_type='WSL'
        left join 	(
            SELECT
                stock.partno as partno,
                stock.description as description,
                stock.mat_class as mat_class,
                stock.altpartno as altpartno,
                stock.part_qty,
                stock.alt_qty
            FROM (
                SELECT distinct
                    CASE WHEN REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
                    part.description as description,
                    DECODE (part.mat_class, 'C', 'Consumable',
                                				'E', 'Expendable',
                                				'R', 'Rotable',
                                				'S', 'Service'
               		          ) as mat_class,
                    CASE WHEN REGEXP_LIKE(alt_parts_cons.altpartno, '^[0-9]+$') THEN chr(39)||alt_parts_cons.altpartno ELSE alt_parts_cons.altpartno END as  altpartno,
                    cons_stock_qty.part_qty as part_qty,
                    alt_parts_cons.alt_qty as  alt_qty
                FROM part
                LEFT JOIN (
    			     SELECT
			         	part.partno,
			         	part_alternate.altpartno,
			         	SUM(consumables.qty) AS alt_qty
			         FROM part
			         	JOIN part_alternate ON part_alternate.partno = part.partno
			         	LEFT JOIN consumables ON part_alternate.altpartno = consumables.partno
			         	LEFT JOIN location ON consumables.locationno_i = location.locationno_i
			         WHERE 1=1
			         	AND consumables.owner = 'AFL'
			         	AND consumables.condition &lt;&gt; 'US'
			         GROUP BY part.partno, part_alternate.altpartno
			         ) alt_parts_cons ON part.partno = alt_parts_cons.partno
                LEFT JOIN (
			         SELECT
			        	 part.partno,
			         	SUM(consumables.qty) AS part_qty
			         FROM part
			         	JOIN consumables on part.partno = consumables.partno
			         	JOIN location ON consumables.locationno_i = location.locationno_i
			         WHERE 1=1
			         	AND consumables.owner = 'AFL'
			         	AND consumables.condition &lt;&gt; 'US'
			         GROUP BY part.partno
			     ) cons_stock_qty ON part.partno = cons_stock_qty.partno
                WHERE part.mat_class &lt;&gt;  'R'
            UNION
            SELECT distinct
                CASE WHEN REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
                part.description as description,
                DECODE (part.mat_class, 'C', 'Consumable',
                            			'E', 'Expendable',
                            			'R', 'Rotable',
                                        'S', 'Service'
                		) as mat_class,
                alt_parts_rot.altpartno as altpartno,
                rot_stock_qty.part_qty,
                alt_parts_rot.alt_qty
            FROM part
            LEFT JOIN (
		        SELECT
		        	part.partno,
		        	part_alternate.altpartno,
		        	count(rotables.psn) AS alt_qty
		        FROM part
		        	LEFT JOIN part_alternate ON part.partno = part_alternate.partno
			        LEFT JOIN rotables on part_alternate.altpartno = rotables.partno
			        LEFT JOIN location ON rotables.locationno_i = location.locationno_i
		        WHERE 1=1
			        AND rotables.owner = 'AFL'
			        AND rotables.condition &lt;&gt; 'US'
			        GROUP BY part.partno, part_alternate.altpartno
		        ) alt_parts_rot ON part.partno = alt_parts_rot.partno
                LEFT JOIN (
                    SELECT
                        part.partno,
                        count(rotables.psn) AS part_qty
		            FROM part
		        	LEFT JOIN rotables on part.partno = rotables.partno
			        LEFT JOIN location ON rotables.locationno_i = location.locationno_i
		            WHERE 1=1
		        	    AND rotables.condition &lt;&gt; 'US'
		        	    AND rotables.owner = 'AFL'
		            GROUP BY part.partno
		        ) rot_stock_qty ON part.partno = rot_stock_qty.partno
                WHERE part.mat_class not in ( 'C', 'E', 'S')
                ) stock
            ) stock on pr2.partno = stock.partno
    where wl.workstep_state is null
    group by wh.event_perfno_i
    ) part on wo_header.event_perfno_i=part.event_perfno_i
WHERE (
        wo_header.mel_code IS NOT NULL
        AND
        (
                (/*A32S*/
                        ('@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'A32S' OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'ALL')
                        AND
                        (
                                    wo_header_more.mel_chapter IN (
                                                                   '23-73-02-01-B',
                                                                   '23-73-05-01-A',
                                                                   '25-20-01-A',
                                                                   '25-20-03-A',
                                                                   '25-20-04-A',
                                                                   '25-20-09-C',
                                                                   '25-66-01-A',
                                                                   '33-20-02-B',
                                                                   '35-20-01-A'
                                    )
                                OR
                                    (
                                            regexp_like(wo_header_more.mel_chapter, '25-20-02(-?B|C|D|E|F)', 'i')
                                            OR
                                            regexp_like(wo_header_more.mel_chapter, '25-20-05-B(-?B|C|D)', 'i')
                                            OR
                                            regexp_like(wo_header_more.mel_chapter, '25-20-07-(-?B|C)', 'i')
                                        )
                            )
                    )
                OR
                (
                        ('@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'A330' OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'ALL')
                        AND
                        (
                                regexp_like(wo_header_more.mel_chapter, '23-73-02-01(-?B)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '23-73-05-01(-?A)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-20-01(-?A)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-20-02(-?(B|E|F))', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-20-03(-?A)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-20-05(-?D)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-20-07(-?(B|C))', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-20-08(-?С)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-66-01(-?A)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '33-20-01(-?B)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '35-20-01(-?A)', 'i')
                            )
                    )
                OR
                (
                        ('@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'A350' OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'ALL')
                        AND
                        (
                                regexp_like(wo_header_more.mel_chapter, '25-21-01(-?A)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-21-02(-?B)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-21-03(-?A)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-21-04(-?A)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-21-05(-?B)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-21-07(-?B)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-21-08(-?(B|C))', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-22-01(-?C)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '25-66-01(-?A)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '33-26-01(-?B)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '35-20-02(-?A)', 'i')
                                OR
                                regexp_like(wo_header_more.mel_chapter, '44-14-03(-?B)', 'i')
                            )
                    )
                OR
                (
                    ('@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'B737' OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'ALL')
                        AND
                    (
                        wo_header_more.mel_chapter IN (
                                                       '25-03-01',
                                                       '25-06',
                                                       '33-03-01A',
                                                       '35-02'
                                                      )
                        )
                    )
                OR
                (
                    ('@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'B777' OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'ALL')
                        AND
                    (
                        wo_header_more.mel_chapter IN (
                                                       '25-25-01-01',
                                                       '25-25-02'
                                                      )
                            OR
                        (
                            regexp_like(wo_header_more.mel_chapter, '23-31-01-03(-?B)', 'i')
                                OR
                            regexp_like(wo_header_more.mel_chapter, '25-18-01(-?(A|B))', 'i')
                                OR
                            regexp_like(wo_header_more.mel_chapter, '33-24-01(-?A)', 'i')
                                OR
                            regexp_like(wo_header_more.mel_chapter, '35-21-02(-?A)', 'i')
                            )
                        )
                    )
            )
    )
    AND wo_header.state = 'O'
    AND aircraft.status&lt;&gt;9
    AND aircraft.ac_typ IN '@AFL_MEL_MainACTyp.ac_typ.ac_typ@'
    AND wo_header.type != 'S'
    AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.ac_registr@', ', ', '|')) OR '@VAR.ac_registr@' IS NULL)
ORDER BY
    CASE WHEN '@VAR.sort_order@' = 'wonum' THEN wo_header.ac_registr END ASC,
    CASE WHEN '@VAR.sort_order@' = 'wonum' THEN wo_header.event_perfno_i END DESC,
    CASE WHEN '@VAR.sort_order@' = 'melnum' THEN wo_header_more.mel_chapter END DESC,
    CASE WHEN '@VAR.sort_order@' = 'melnum' THEN wo_header.event_perfno_i END DESC,
    CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_transfer.date_transfer END DESC,
    CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_transfer.transfer_time END DESC,
    CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_header.ac_registr END DESC,
