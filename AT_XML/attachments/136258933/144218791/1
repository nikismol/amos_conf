    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MEL_MainACTyp" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ.ac_typ" id="ac_typ.ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.mult_ac_typ@">
          <ds:object>@VAR.mult_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ac_typ.ac_typ
FROM ac_typ
LEFT JOIN aircraft ON aircraft.ac_typ = ac_typ.ac_typ
WHERE 
	((ac_typ.ac_typ = 'A32S' AND (REGEXP_LIKE('A32S', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR REGEXP_LIKE('A321', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL'))
OR 
	(ac_typ.ac_typ = 'A330' AND (REGEXP_LIKE('A330', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR REGEXP_LIKE('A333', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL'))
OR 
	ac_typ.ac_typ = 'B737' AND (REGEXP_LIKE('B737', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL')
OR 
	ac_typ.ac_typ = 'A350' AND (REGEXP_LIKE('A350', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL')
OR 
	ac_typ.ac_typ = 'B777' AND (REGEXP_LIKE('B777', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL')
OR 
	ac_typ.ac_typ = 'RRJ' AND (REGEXP_LIKE('RRJ', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL'))
AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.ac_registr@', ', ', '|')) OR '@VAR.ac_registr@' IS NULL)
GROUP BY ac_typ.ac_typ
ORDER BY ac_typ.ac_typ
/*AFL_MEL2*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
