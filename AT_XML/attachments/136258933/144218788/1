        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.sort_order@">
          <ds:object>@VAR.sort_order@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
wo_header.ac_registr
, wo_header.event_perfno_i
, wo_header.hil
, wo_text_description.text as c_wo_step_text
, wo_header.mel_code
, TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.issue_date+729), 'DD.MM.YYYY') as wo_issue_date
, wo_header_more.mel_chapter
, DECODE(wo_header.type, 'M', 'Maint.', 'P', 'PiRep', 'C', 'Cabin', 'Unknown') as wo_type
, TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_transfer.absolute_due_date+729), 'DD.MM.YYYY') as wo_due_date
, CASE WHEN mel_detail.mel_detailno_i IS NULL THEN '' ELSE '&lt;b&gt;MEL:&lt;/b&gt;&lt;br /&gt;'||' &lt;b&gt;'||DECODE(mel_detail.ops_proc_req||mel_detail.maint_proc_req, 'YY', '(O)(M)', 'YN', '(O)', 'NY', '(M)', '')||'&lt;/b&gt; '||TO_CHAR(mel_tree.mel_text) END as c_mel_text
, CASE WHEN ac_lim.event_perfno_i IS NULL THEN '' ELSE ac_lim.limitations_agg END as limitations_agg_na
, CASE WHEN wo_opus.free_text IS NOT NULL THEN TO_CLOB(CONCAT(TO_CLOB('&lt;br /&gt;&lt;b&gt;Comments:&lt;/b&gt;&lt;br /&gt;'), TO_CLOB(wo_opus.free_text))) ELSE TO_CLOB('') END as mcc_remarks
, CASE WHEN mel_detail.mel_detailno_i IS NOT NULL THEN 
CASE WHEN aircraft.ac_typ IN ('A32S', 'A330', 'RRJ') THEN 
		TO_CLOB(CONCAT(TO_CLOB('&lt;b&gt;MEL Remarks:&lt;/b&gt;&lt;br /&gt;'), mel_detail.mel_remarks))
	ELSE
		CASE WHEN LENGTH(mel_procedure.maint_proc_text) &gt; 1 OR LENGTH(mel_procedure.ops_proc_text) &gt; 1 THEN
				TO_CLOB(CONCAT(TO_CLOB('&lt;br /&gt;&lt;b&gt;Procedures:&lt;/b&gt;&lt;br /&gt;'), 								
					TO_CLOB(
						CONCAT(
							CASE WHEN LENGTH(mel_procedure.ops_proc_text) &gt; 1 THEN TO_CLOB(CONCAT(TO_CLOB('&lt;br /&gt;&lt;b&gt;(O)&lt;/b&gt;&lt;br /&gt;'), mel_procedure.ops_proc_text)) ELSE TO_CLOB('') END,
							CASE WHEN LENGTH(mel_procedure.maint_proc_text) &gt; 1 THEN TO_CLOB(CONCAT(TO_CLOB('&lt;br /&gt;&lt;b&gt;(M)&lt;/b&gt;&lt;br /&gt;'), mel_procedure.maint_proc_text)) ELSE TO_CLOB('') END
						)
					)
				))
			ELSE
			    TO_CLOB('')
		END
	END 
ELSE TO_CLOB('')
END
as c_mel_procedures,
CASE WHEN aircraft.ac_typ IN ('B737', 'B777') THEN 
				TO_CLOB(CONCAT(TO_CLOB('&lt;b&gt;MEL Remarks:&lt;/b&gt;&lt;br /&gt;'), mel_detail.mel_remarks))
	ELSE TO_CLOB('')
END as remarks
FROM 
wo_header
LEFT JOIN aircraft ON aircraft.ac_registr = wo_header.ac_registr
LEFT JOIN workstep_link ON (workstep_link.event_perfno_i = wo_header.event_perfno_i AND workstep_link.sequenceno = 1)
LEFT JOIN wo_text_description ON wo_text_description.descno_i = workstep_link.descno_i
LEFT JOIN wo_transfer ON (wo_header.event_perfno_i = wo_transfer.event_perfno_i AND wo_transfer.is_last_transfer = 'Y')
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN wo_opus ON wo_header.event_perfno_i = wo_opus.event_perfno_i
LEFT JOIN wo_header_4 on wo_header_4.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN mel_detail ON mel_detail.mel_detailno_i = wo_header_4.mel_detailno_i
LEFT JOIN mel_tree ON mel_detail.mel_treeno_i = mel_tree.mel_treeno_i
LEFT JOIN mel_procedure ON mel_procedure.mel_treeno_i = mel_tree.mel_treeno_i
LEFT JOIN mel_revision mrm ON mel_tree.melno_i = mrm.melno_i AND (mrm.active='Y' OR NVL(aircraft.ac_typ, 1) != 'RRJ') AND mrm.type='M'
LEFT JOIN (
	SELECT
		limitation_config.configuration_key as event_perfno_i,
		'&lt;b&gt;WO Downgrades (limitations):&lt;/b&gt;&lt;br /&gt;'||LISTAGG(TO_CHAR(limitation_type.limitation_type)||': '||TO_CHAR(limitation_type.description), '; ') WITHIN GROUP (ORDER BY limitation_type.limitation_type, limitation_type.description)  as limitations_agg
		FROM
			limitation_config
			LEFT JOIN limitation_type ON limitation_type.limitation_typeno_i = limitation_config.limitation_typeno_i
		WHERE limitation_config.mime_type = 'WO'
		GROUP BY
		limitation_type.limitation_type, limitation_type.description, limitation_config.configuration_key
) ac_lim ON ac_lim.event_perfno_i = wo_header.event_perfno_i

WHERE
(
 aircraft.ac_typ='A330' AND REGEXP_LIKE (wo_header_more.mel_chapter,'^(23-33-51-A|23-33-51-a|23-33-51-А|23-33-51-а|23-33-51).*')
 OR
 aircraft.ac_typ='B737' AND REGEXP_LIKE (wo_header_more.mel_chapter,'^(25-10-03-01|25-10-03-02).*')
 OR
 aircraft.ac_typ='B777' AND REGEXP_LIKE (wo_header_more.mel_chapter,'^(25-20-01-07-01|25-20-01-07-02).*')
 OR
 aircraft.ac_typ='A32S' AND aircraft.ac_model IN ('A320', 'A321') AND REGEXP_LIKE (wo_header_more.mel_chapter,'^(23-33-01-A|23-33-02-A|23-33-03-A|23-33-04-A|23-33-05-A|23-33-06-A|23-33-06-B|23-33-06-C).*')
OR
aircraft.ac_typ='A350' AND REGEXP_LIKE (wo_header_more.mel_chapter,'^(21-29-02B|21-29-02-B|21-29-02b|21-29-02-b|21-29-07B|21-29-07b|21-29-07-B|21-29-07-b).*')
)
AND wo_header.state = 'O'
AND aircraft.status&lt;&gt;9
AND (aircraft.ac_typ = '@AFL_MEL_SubACTyp.ac_typ.ac_typ@' OR aircraft.ac_model = '@AFL_MEL_SubACTyp.ac_typ.ac_typ@')
AND wo_header.type != 'S'
AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.ac_registr@', ', ', '|')) OR '@VAR.ac_registr@' IS NULL)
AND (
          mel_tree.version = (
                                            SELECT MAX (mt.version) 
                                            FROM mel_tree mt                       
                                            WHERE mel_tree.mel_treeno_i = mt.mel_treeno_i                             
                                            	AND mel_tree.revision = mt.revision
                                           )
          OR mel_tree.version IS NULL
         )
AND (
          mel_tree.revision = (
                                             SELECT MAX (mt.revision) 
                                             FROM mel_tree mt 
                                             WHERE mel_tree.mel_treeno_i = mt.mel_treeno_i 
                                                           AND mt.revision &lt;= mrm.revision
                                            ) 
          OR mel_tree.revision IS NULL
         )
AND (
          mel_detail.version = (
                                               SELECT MAX (md.version)
                                               FROM mel_detail md                         
                                               WHERE mel_detail.mel_detailno_i = md.mel_detailno_i                               
                                                            AND mel_detail.revision = md.revision
                                              )
          OR mel_detail.version IS NULL
         )
AND (
          mel_detail.revision = (
                                                SELECT MAX (md.revision)                         
                                                FROM mel_detail md
                                                WHERE mel_detail.mel_detailno_i = md.mel_detailno_i                               
                                                             AND md.revision &lt;= mrm.revision
                                               )
          OR mel_detail.revision IS NULL
         )
AND (
          mel_procedure.version = (
                                                       SELECT MAX (mp.version)
                                                       FROM mel_procedure mp                           	
                                                       WHERE mel_procedure.mel_treeno_i = mp.mel_treeno_i  
                                                                     AND mel_procedure.revision = mp.revision
                                                      )
          OR mel_procedure.version IS NULL
         )
ORDER BY
CASE WHEN '@VAR.sort_order@' = 'wonum' THEN wo_header.ac_registr END ASC, 
CASE WHEN '@VAR.sort_order@' = 'wonum' THEN wo_header.event_perfno_i END DESC,
CASE WHEN '@VAR.sort_order@' = 'melnum' THEN wo_header_more.mel_chapter END DESC,
CASE WHEN '@VAR.sort_order@' = 'melnum' THEN wo_header.event_perfno_i END DESC,
CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_transfer.date_transfer END DESC,
CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_transfer.transfer_time END DESC,
CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_header.ac_registr END DESC,
CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_header.event_perfno_i END DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
