      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ac_typ.ac_typ
FROM ac_typ 
WHERE 
ac_typ.main_typ = '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' 
AND ac_typ.ac_typ IN ('A320', 'A320N', 'A321', 'A321NX', 'A332', 'A333', 'B737', 'B777', 'RRJ', 'A350')
AND ('@VAR.ac_registr@' IS NULL OR ac_typ.ac_typ IN  (
	SELECT ac_model FROM aircraft WHERE ac_registr = '@VAR.ac_registr@'
	UNION 
	SELECT ac_typ FROM aircraft WHERE ac_registr = '@VAR.ac_registr@'
