      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT wo_header.ac_registr,
wo_header.event_perfno_i,
wo_header_more.mel_chapter,
wo_text_description.text,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (wo_transfer.absolute_due_date+729),
'dd.mm.yyyy') as absolute_due_date,

to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (wo_header.created_date+729),
'dd.mm.yyyy') as created_date,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (wo_header.closing_date+729),
'dd.mm.yyyy') as closing_date

FROM wo_header
LEFT JOIN wo_transfer ON wo_transfer.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wo_header_more ON wo_header_more.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wo_text_action ON wo_text_action.actionno_i = wo_transfer.actionno_i
LEFT JOIN workstep_link ON workstep_link.workstep_linkno_i = wo_text_action.workstep_linkno_i
LEFT JOIN wo_text_description  ON wo_text_description.descno_i = workstep_link.descno_i
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr

Where wo_header.state in (@VAR.STATE_WO@)
and (REGEXP_LIKE(aircraft.ac_typ, REPLACE( '@VAR.AC_TYPE@', ', ', '|')) OR '@VAR.AC_TYPE@' IS NULL)
and (REGEXP_LIKE(aircraft.ac_model, REPLACE( '@VAR.AC_MODEL@', ', ', '|')) OR '@VAR.AC_MODEL@' IS NULL)
and (REGEXP_LIKE(aircraft.ac_registr, REPLACE( '@VAR.AC_REGISTR@', ', ', '|')) OR '@VAR.AC_REGISTR@' IS NULL)
and wo_transfer.is_last_transfer = 'Y'
and (wo_header.created_date &gt;= '@VAR.DATE_FROM@' OR '@VAR.DATE_FROM@' IS NULL)
and (wo_header.created_date &lt;= '@VAR.DATE_TO@' OR '@VAR.DATE_TO@' IS NULL)
and wo_header_more.mel_chapter IS NOT NULL

order by aircraft.ac_registr,created_date
</se:textStatement>
        </se:sqlStatement>
