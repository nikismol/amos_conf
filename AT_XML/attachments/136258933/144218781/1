      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_MEL_MainACTyp.ac_typ.ac_typ@">
          <ds:object>@AFL_MEL_MainACTyp.ac_typ.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
        ac_typ.ac_typ
FROM
        ac_typ 
WHERE 
        ac_typ.main_typ = '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' 
