    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MEL_SubACTyp" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ.ac_typ" id="ac_typ.ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_MEL_MainACTyp.ac_typ.ac_typ@">
          <ds:object>@AFL_MEL_MainACTyp.ac_typ.ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ac_typ.ac_typ
FROM ac_typ 
WHERE
'@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'A32S' AND ac_typ.ac_typ IN ('A320', 'A321', 'A320N', 'A321NX')
OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'A330' AND ac_typ.ac_typ IN ('A332', 'A333')
OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'A350' AND ac_typ.ac_typ = 'A350'
OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'B737' AND ac_typ.ac_typ = 'B737'
OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'B777' AND ac_typ.ac_typ = 'B777'
OR '@AFL_MEL_MainACTyp.ac_typ.ac_typ@' = 'RRJ' AND ac_typ.ac_typ = 'RRJ'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
