        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (min_ya.receiveng_date+729)'DD.MM.YYYY')  as receiveng_date" id="receiveng_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="min_ya.vendor as vendor" id="vendor"/>
