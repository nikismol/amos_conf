      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="min_ya.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="min_ya.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="min_ya.owner as owner" id="owner"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (min_ya.first_install_date+729)'DD.MM.YYYY')  as first_install_date" id="first_install_date"/>
