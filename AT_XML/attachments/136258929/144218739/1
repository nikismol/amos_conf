      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT CASE WHEN REGEXP_LIKE(min_ya.partno, '^[0-9]+$') THEN chr(39)||min_ya.partno ELSE min_ya.partno END as partno,
              CASE WHEN REGEXP_LIKE(min_ya.serialno, '^[0-9]+$') THEN chr(39)||min_ya.serialno ELSE min_ya.serialno END as serialno, 
              min_ya.owner as owner,
              TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (min_ya.first_install_date+729), 'DD.MM.YYYY')  as first_install_date,
              min_ya.orderno as orderno,
              TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (min_ya.orderdate+729), 'DD.MM.YYYY') as order_issue_date,
              TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (min_ya.receiveng_date+729), 'DD.MM.YYYY')  as receiveng_date,
              min_ya.vendor as vendor,
              min_ya.purch_price as purch_price,
              min_ya.currency as currency,
              min_ya.description as description,
              min_ya.ac_typ as ac_typ,
              min_ya.ac_registr as ac_registr,
              min_ya.fa_type,
              min_ya.ata_chapter
FROM (
             SELECT history.partno,
                           history.serialno,
                           history.owner,
                           history.del_date as first_install_date,
                           od_header.orderno,
                           od_header.orderdate,
                           od_rec_header.del_date as receiveng_date,
                           od_header.vendor,
                           TRUNC(TO_NUMBER(od_rec_detail.purch_price), 2) as purch_price,
                           od_rec_detail.currency,
                           history.historyno_i,
                           MAX (history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i,
                           part.description,
                           history.ac_typ,
                           history.ac_registr,
                           part.ac_typ as fa_type,
                           part.ata_chapter
             FROM history
             LEFT JOIN od_rec_detail ON od_rec_detail.psn=history.psn
             LEFT JOIN od_header ON od_header.orderno = od_rec_detail.orderno
             LEFT JOIN od_rec_header ON od_rec_detail.receivingno = od_rec_header.receivingno
             LEFT JOIN part ON history.partno=part.partno
             WHERE history.vm='YE'
                           AND history.owner='AFL'
                           AND od_rec_detail.status &lt;&gt; 9
                           AND od_header.order_type = 'P'
                           AND (REGEXP_LIKE(part.ata_chapter, '^@VAR.ata@(*)') OR '@VAR.ata@' IS NULL) 
                           AND (REGEXP_LIKE(od_header.vendor, REPLACE('@VAR.vendor@', ', ', '|')) OR '@VAR.vendor@' IS NULL)
                           AND (
                                      '@VAR.interval_type@'='ya_date'
                                      AND history.del_date&gt;=@VAR.from@
                                      AND history.del_date&lt;=@VAR.to@
                                      OR
                                      '@VAR.interval_type@'='rec_date'
                                      AND od_rec_header.del_date &gt;=@VAR.from@
                                      AND od_rec_header.del_date &lt;=@VAR.to@
                                      OR
                                      '@VAR.interval_type@'='od_issue'
                                      AND od_header.orderdate &gt;=@VAR.from@
                                      AND od_header.orderdate &lt;=@VAR.to@
                                    )
            ) min_ya
WHERE min_ya.historyno_i=min_ya.max_historyno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
