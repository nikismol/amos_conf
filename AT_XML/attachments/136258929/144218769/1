    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="detail_info" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.partno AS partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.serialno AS serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.batchno AS batchno" id="batchno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description AS description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ AS ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(&#10;        TO_DATE('31.12.1971' 'DD.MM.YYYY') + (od_rec_detail.expire_date)'DD.MM.YYYY'&#10;    ) AS expire_date" id="expire_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.location AS location" id="location"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.rec_detail@">
          <ds:object>@VAR.rec_detail@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    od_rec_detail.partno AS partno,
    od_rec_detail.serialno AS serialno,
    od_rec_detail.batchno AS batchno,
    part.description AS description,
    part.ac_typ AS ac_typ,
    TO_CHAR(
        TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_rec_detail.expire_date),
        'DD.MM.YYYY'
    ) AS expire_date,
    history.location AS location
FROM
    od_rec_detail
    LEFT JOIN part ON od_rec_detail.partno = part.partno
    LEFT JOIN history ON od_rec_detail.labelno = history.labelno
WHERE
    od_rec_detail.recdetailno_i = '@VAR.rec_detail@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
