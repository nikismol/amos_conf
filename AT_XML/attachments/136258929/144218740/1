    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_OMTO_INFORMATION_RECEIVING" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rownum" id="rownum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN od_rec_detail.serialno IS NULL THEN od_rec_detail.batchno ELSE od_rec_detail.serialno END as sn_bn" id="sn_bn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.measure_unit ||' ('||measure_unit.description||')' as measure_unit" id="measure_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.qty as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (od_rec_header.del_date+729)'dd.mm.yyyy') as receiving_date" id="receiving_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             to_char(to_date('31.12.1971' 'dd.mm.yyyy') + od_rec_header.mutation + od_rec_header.mutation_time  / 1000 / 60 / 60 / 24'dd.mm.yyyy hh24:mi:ss') receiving_mutation" id="receiving_mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_header.awbno as awbno" id="awbno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno as orderno" id="orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.pool_reason as prio" id="prio"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.priority" id="od_header.priority"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.station||'/'||history.store as store" id="store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="station_store.description as stor_desc" id="stor_desc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sh_inf_eo.awbno as eo_awbno" id="eo_awbno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (@VAR.date_from@+729)'dd.mm.yyyy') as date_from" id="date_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (@VAR.date_to@+729)'dd.mm.yyyy') as date_to" id="date_to"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.store@">
          <ds:object>@VAR.store@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.station@">
          <ds:object>@VAR.station@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT rownum,
              CASE WHEN REGEXP_LIKE(od_rec_detail.partno, '^[0-9]+$') AND REGEXP_LIKE(od_rec_detail.partno, '^0') THEN chr(39)||od_rec_detail.partno ELSE od_rec_detail.partno END as partno,
              CASE WHEN od_rec_detail.serialno IS NULL
                         THEN CASE WHEN REGEXP_LIKE(od_rec_detail.batchno, '^[0-9]+$') AND REGEXP_LIKE(od_rec_detail.batchno, '^0') THEN chr(39)||od_rec_detail.batchno ELSE od_rec_detail.batchno END
                         ELSE CASE WHEN REGEXP_LIKE(od_rec_detail.serialno, '^[0-9]+$') AND REGEXP_LIKE(od_rec_detail.serialno, '^0') THEN chr(39)||od_rec_detail.serialno ELSE od_rec_detail.serialno END
              END as sn_bn,
             part.description as description,
             part.measure_unit ||chr(10)||'('||measure_unit.description||')' as measure_unit,
             od_rec_detail.qty as qty,
             to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (od_rec_header.del_date+729),'dd.mm.yyyy') as receiving_date,
             to_char(to_date('31.12.1971', 'dd.mm.yyyy') + od_rec_header.mutation + od_rec_header.mutation_time  / 1000 / 60 / 60 / 24, 'dd.mm.yyyy hh24:mi:ss') as receiving_mutation,
             od_rec_header.awbno as awbno,
             od_detail.ac_registr as ac_registr,
             od_header.orderno as orderno,
             od_header.pool_reason as prio,
             wo_header.event_perfno_i as event_perfno_i,
             od_header.priority,
             history.station||'/'||history.store as store,
             station_store.description as stor_desc,
             sh_inf_eo.awbno as eo_awbno,
             to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (@VAR.date_from@+729),'dd.mm.yyyy') as date_from,
             to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (@VAR.date_to@+729),'dd.mm.yyyy') as date_to
FROM od_rec_detail
LEFT JOIN od_rec_header ON od_rec_header.receivingno = od_rec_detail.receivingno
LEFT JOIN part ON part.partno = od_rec_detail.partno
LEFT JOIN measure_unit ON measure_unit.measure_unit = part.measure_unit
LEFT JOIN od_header ON od_header.orderno = od_rec_detail.orderno
LEFT JOIN od_detail ON od_detail.orderno_i = od_header.orderno_i
LEFT JOIN (
                    SELECT allocation_link.ref_key,
                                  allocation_link.source_key
                    FROM allocation_link
                    WHERE allocation_link.source_type = 'PARTRQST'
                                   AND allocation_link.ref_type = 'ORDER_DE'
                  ) al_link ON al_link.ref_key = od_detail.detailno_i
LEFT JOIN part_request_2 ON al_link.source_key = part_request_2.part_requestno_i
LEFT JOIN workstep_link ON workstep_link.workstep_linkno_i = part_request_2.event_key
LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN history ON history.recdetailno_i = od_rec_detail.recdetailno_i
LEFT JOIN station_store ON station_store.station = history.station and station_store.store = history.store
LEFT JOIN (
                   SELECT sh_header.awbno,
                                sh_detail.od_detailno_i                                   
                   FROM sh_header
                   LEFT JOIN sh_detail ON sh_header.shipmentno_i = sh_detail.shipmentno_i
                   WHERE sh_header.status &lt;&gt; -5
                                AND sh_header.type='EO'
                  ) sh_inf_eo ON sh_inf_eo.od_detailno_i = od_rec_detail.detailno_i
WHERE od_rec_detail.status &lt;&gt; 9
              AND od_rec_detail.vendor LIKE 'ZPL%'
              AND od_header.order_type = 'PR'
              AND history.vm = 'B1'
              AND (
                        @VAR.date_from@&gt;0
                        AND @VAR.date_to@&gt;0
                        AND od_rec_header.del_date&gt;=@VAR.date_from@
                        AND od_rec_header.del_date&lt;=@VAR.date_to@
                        OR 
                        @VAR.date_from@=0
                        AND @VAR.date_to@=0
                        AND od_rec_header.del_date=od_rec_header.mutation
                        AND od_rec_header.mutation*(24*60*60*1000)+od_rec_header.mutation_time&gt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))*(24*60*60*1000) + TO_CHAR(SYSTIMESTAMP, 'SSSSS')*1000 - 12*60*60*1000
                      )
              AND (REGEXP_LIKE(station_store.station_storeno_i, REPLACE( '@VAR.store@', ', ', '|')) OR '@VAR.store@' IS NULL)
              AND (REGEXP_LIKE(history.station, REPLACE( '@VAR.station@', ', ', '|')) OR '@VAR.station@' IS NULL)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
