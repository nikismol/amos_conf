        <ds:columnDescriptor amosType="ALPHANUM" description="consumables.batchno AS serialno_batchno" id="serialno_batchno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.station AS station" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.store AS store" id="store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.location AS location" id="location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="consumables.qty AS qty" id="qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
