    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="part_qty_with_alt" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ AS ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno AS partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description AS description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ata_chapter AS ata" id="ata"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.mat_class AS mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.mat_type AS mat_type" id="mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.remarks AS remarks" id="remarks"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.reord_level AS reord_level" id="reord_level"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.max_purch AS max_purch" id="max_purch"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;LISTAGG(part_special.special '') WITHIN GROUP (ORDER BY part_special.partno) AS special" id="special"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;(NVL(QTY.cons_QTY0) + NVL(QTY.alt_cons_qty0)) AS STOCK_INFO" id="STOCK_INFO"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
    part.ac_typ AS ac_typ,
    part.partno AS partno,
    part.description AS description,
    part.ata_chapter AS ata,
    part.mat_class AS mat_class,
    part.mat_type AS mat_type,
    part.remarks AS remarks,
    part.reord_level AS reord_level,
    part.max_purch AS max_purch,
    RTRIM(XMLAGG(XMLELEMENT(E, part_special.special, ', ').EXTRACT('//text()')  ORDER BY part_special.special).GetClobVal(), CHR(10)) AS special,
    (NVL(QTY.cons_QTY,0) + NVL(QTY.alt_cons_qty,0)) AS STOCK_INFO 
FROM part 
LEFT JOIN part_special ON part.partno = part_special.partno
LEFT JOIN 
			(
				SELECT
					part.partno AS partno
					,part_alternate.alt_cons_qty AS alt_cons_qty 
					,part_alternate.alt_rot_qty AS alt_rot_qty
					,COUNT(rotables.serialno) AS rot_qty
					,SUM(consumables.qty) AS cons_qty 
				FROM part
				LEFT JOIN 
							(
								SELECT 
										part_alternate.partno AS partno
                                        ,RTRIM(XMLAGG(XMLELEMENT(E, part_alternate.altpartno, ',').EXTRACT('//text()')  ORDER BY part_alternate.partno).GetClobVal(), CHR(10)) as altpartno
										,COUNT(rotables.serialno) AS alt_rot_qty
										,SUM(consumables.qty) AS alt_cons_qty
								FROM part
								LEFT JOIN part_alternate ON part.partno = part_alternate.partno
								LEFT JOIN rotables ON part_alternate.altpartno = rotables.partno
								LEFT JOIN consumables ON part_alternate.altpartno = consumables.partno
								GROUP BY part_alternate.partno
							) part_alternate ON part.partno = part_alternate.partno
				LEFT JOIN rotables ON part.partno = rotables.partno
				LEFT JOIN consumables ON part.partno = consumables.partno
				GROUP BY 
				part.partno
				,part_alternate.alt_cons_qty
				,part_alternate.alt_rot_qty
				,part.mat_class
			) QTY ON part.partno = QTY.partno
WHERE 
      part.reord_level != 0
      AND part.mat_class != 'R'
      AND (REGEXP_LIKE(part.ac_typ, REPLACE( '@VAR.ac_typ@', ', ', '|')) OR '@VAR.ac_typ@' IS NULL)
GROUP BY
    part.ac_typ,
    part.partno,
    part.description,
    part.ata_chapter,
    part.mat_class,
    part.mat_type,
    part.remarks,
    part.reord_level,
    part.max_purch,
    QTY.cons_QTY,
    QTY.alt_cons_qty</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
