      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
    part.ac_typ AS ac_typ,
    part.partno AS partno,
    part.description AS description,
    part.ata_chapter AS ata,
    part.mat_class AS mat_class,
    part.mat_type AS mat_type,
    part.remarks AS remarks,
    part.reord_level AS reord_level,
    part.max_purch AS max_purch,
    RTRIM(XMLAGG(XMLELEMENT(E, part_special.special, ', ').EXTRACT('//text()')  ORDER BY part_special.special).GetClobVal(), CHR(10)) AS special,
    consumables.batchno AS serialno_batchno,
    location.station AS station,
    location.store AS store,
    location.location AS location,
    consumables.qty AS qty
FROM part 
JOIN consumables ON part.partno = consumables.partno
JOIN location ON consumables.locationno_i = location.locationno_i AND location.location_type = '0'
LEFT JOIN part_special ON part.partno = part_special.partno
WHERE 
      part.reord_level != 0
      AND part.mat_class != 'R'
      AND (REGEXP_LIKE(part.ac_typ, REPLACE( '@VAR.ac_typ@', ', ', '|')) OR '@VAR.ac_typ@' IS NULL)
GROUP BY
    part.ac_typ,
    part.partno,
    part.description,
    part.ata_chapter,
    part.mat_class,
    part.mat_type,
    part.remarks,
    part.reord_level,
    part.max_purch,
    consumables.batchno,
    location.station,
    location.store,
    location.location,
    consumables.qty</se:textStatement>
