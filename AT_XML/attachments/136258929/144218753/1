    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="254_ATI_planing_main" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rownum" id="rownum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ as ac_typ" id="ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_partno@">
          <ds:object>@VAR.v01_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_partno_list@">
          <ds:object>@VAR.v04_partno_list@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT rownum,
       part.partno as partno,
       part.description as description,
       pat.ac_typ as ac_typ
FROM part
JOIN part_fa_entity ON part.partno = part_fa_entity.partno AND part_fa_entity.entityno_i = 1
JOIN (
        select part_ac_type.partno,
               listagg(part_ac_type.ac_typ, ', ') within group (order by part_ac_type.ac_typ) as ac_typ
        from part_ac_type
        group by part_ac_type.partno
) pat on pat.partno = part_fa_entity.partno
WHERE 1=1
      AND (
                 part.partno IN (
                                              SELECT t.v
                                              FROM (
                                                           SELECT column_value as v
                                                           FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_partno@','comma'))
                                                          ) t
                                              WHERE t.v is not null
                                             )
                 OR '@VAR.v01_partno@' IS NULL
                )
      AND part.mat_class&lt;&gt;'R'
      AND (
                 part.partno IN (
                                              SELECT t.v
                                              FROM (
                                                           SELECT column_value as v
                                                           FROM TABLE(amosserver_prod.string_splitter('@VAR.v04_partno_list@','line_feed'))
                                                          ) t
                                              WHERE t.v is not null
                                             )
                 OR '@VAR.v04_partno_list@' IS NULL
                )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="254_ATI_planing_consumption" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="NVL((SUM(qty)) * (-1)0) as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(ac_registr) as count_ac" id="count_ac"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@254_ATI_planing_main.partno@">
          <ds:object>@254_ATI_planing_main.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@254_ATI_Planing_period.yr@">
          <ds:object>@254_ATI_Planing_period.yr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT NVL((SUM(qty)) * (-1), 0) as qty,
	count(distinct(ac_registr)) as count_ac
FROM (
              SELECT history.qty,
		history.ac_registr
              FROM history
              WHERE 1=1
                             AND history.vm in ('AA', 'AS', 'EA', 'ES')
                             AND history.partno='@254_ATI_planing_main.partno@'
                             AND TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + history.created_date, 'YYYY') = '@254_ATI_Planing_period.yr@'
            )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="254_ATI_Planing_period" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="@VAR.v03_year_start@ - 1 + LEVEL as yr" id="yr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_year_start@">
          <ds:object>@VAR.v02_year_start@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT @VAR.v02_year_start@ - 1 + LEVEL as yr
FROM DUAL
CONNECT BY LEVEL - 1 &lt;= to_char(sysdate, 'YYYY') - @VAR.v02_year_start@</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="254_ATI_Planing_StockInfo" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(qty) as qty" id="qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@254_ATI_planing_main.partno@">
          <ds:object>@254_ATI_planing_main.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT SUM(qty) as qty
FROM (
              SELECT consumables.qty
              FROM consumables
              JOIN location ON consumables.locationno_i = location.locationno_i 
             LEFT  JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             AND consumables.partno = '@254_ATI_planing_main.partno@'
             )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="254_ATI_planing_bacoder" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(backorder) as balance" id="balance"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@254_ATI_planing_main.partno@">
          <ds:object>@254_ATI_planing_main.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT SUM(backorder) as balance
FROM (
              SELECT od_detail.backorder
              FROM od_header
              JOIN od_detail ON od_detail.orderno_i = od_header.orderno_i
              WHERE 1=1
                              AND od_header.order_type = 'P'
                              AND od_detail.ext_state IN ('O', 'PR')
	              AND od_detail.backorder &gt;  0
                              AND od_detail.partno = '@254_ATI_planing_main.partno@'  
)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="254_ATI_planing_vendor" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="listagg(distinct address.vendor '') within group (order by address.vendor) as vendor" id="vendor"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@254_ATI_planing_main.partno@">
          <ds:object>@254_ATI_planing_main.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select listagg(distinct address.name, ', ') within group (order by address.name) as vendor
from od_header 
join od_detail on od_header.orderno_i = od_detail.orderno_i 
join address on od_header.vendor = address.vendor
where od_detail.partno = '@254_ATI_planing_main.partno@' 
    AND od_header.order_type = 'P'
    AND od_header.vendor not in ('TECH_V', 'DUZD_TECH')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="254_ATI_planing_max_purchprice" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="max(od_detail.purch_price) as price" id="price"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@254_ATI_planing_main.partno@">
          <ds:object>@254_ATI_planing_main.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
    LISTAGG(TO_CHAR(TO_NUMBER(price.purch_price), '99999999990.99') ||' '|| price.currency, ',') WITHIN GROUP (ORDER BY price.currency) as price 
FROM (
    SELECT 
        MAX(od_rec_detail.purch_price) as purch_price,
        od_rec_detail.currency
    FROM od_rec_detail
    JOIN od_rec_header ON od_rec_detail.receivingno = od_rec_header.receivingno
    JOIN od_header ON od_rec_detail.orderno = od_header.orderno
    WHERE 1=1
        AND od_rec_detail.partno = '@254_ATI_planing_main.partno@'
        AND od_header.order_type = 'P'
        AND od_rec_detail.status &lt;&gt; 9
        AND od_rec_detail.recno &lt;&gt; -1
        AND od_header.vendor not in ('TECH_V', 'DUZD_TECH')
    GROUP BY od_rec_detail.currency 
) price</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
