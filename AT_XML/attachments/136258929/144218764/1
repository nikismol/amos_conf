      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT LISTAGG(part_capability.shop || CHR(39) || address.name || CHR(39), ', ') WITHIN GROUP (ORDER BY part_capability.shop) as capability_list
FROM part
