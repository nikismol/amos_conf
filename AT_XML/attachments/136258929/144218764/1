      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT rownum,
              partno,
              description,
              ac_typ,
              ata_chapter,
              mat_class,
              max_purch,
              reord_level,
              alert_qty,
              orderno,
              posno,
              ordered_partno,
              qty,
              backorder,
              od_ext_state,
              od_detail_ext_state,
              confirmed_date,
              target_date,
              order_priority,
              order_detail_priority,
              reminder_count,
              last_reminder_date,
              ac_registr,
              orderdate,
              od_created_by,
              od_created_date,
              od_detail_created_by,
              od_detail_created_date,
              vendor,
              vendor_name,
              Incom_AWB
FROM (
             SELECT rownum,
                           part.partno as partno,
                           part.description as description,
                           part.ac_typ as ac_typ,
                           part.ata_chapter as ata_chapter,
                           part.mat_class as mat_class,
             CASE WHEN part.reorder IN ('F', 'H') THEN TO_NUMBER(part.max_purch) ELSE NULL END as max_purch,
             CASE WHEN part.reorder IN ('F', 'H') THEN TO_NUMBER(part.reord_level) ELSE NULL END as reord_level,
             CASE WHEN part.reorder IN ('F', 'H') THEN TO_NUMBER(part.alert_qty) ELSE NULL END as alert_qty,
             od_header.orderno as orderno,
             od_detail.posno as posno,
             od_detail.qty as qty,
             od_detail.backorder as backorder,
             od_header.ext_state as od_ext_state,
             od_detail.ext_state as od_detail_ext_state,
             CASE WHEN od_detail.confirmed_date &gt; 0 THEN TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_detail.confirmed_date, 'dd.mm.yyyy') ELSE '' END as confirmed_date,
             CASE WHEN od_detail.confirmed_date &gt; 0 THEN TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_detail.target_date, 'dd.mm.yyyy') ELSE '' END as target_date,
             od_header.priority as order_priority,
             od_detail.priority as order_detail_priority,
                    (
                       SELECT MAX (od_reminder.reminder_count) 
                       FROM od_reminder 
                       WHERE od_reminder.detailno_i = od_detail.detailno_i
                    ) AS reminder_count,
                    (
                       SELECT TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + MAX (od_reminder.reminder_date), 'dd.mm.yyyy')
                       FROM od_reminder 
                       WHERE od_reminder.detailno_i = od_detail.detailno_i
                    ) AS last_reminder_date,
             od_detail.ac_registr as ac_registr,
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_header.orderdate, 'dd.mm.yyyy') as orderdate,
             od_header.created_by as od_created_by,
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_header.created_date, 'dd.mm.yyyy') as od_created_date,
             od_detail.created_by as od_detail_created_by,
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_detail.created_date, 'dd.mm.yyyy') as od_detail_created_date,
             od_detail.partno as ordered_partno,
             address.vendor as vendor,
             address.name||' '||address.name_1||' '||address.name_2 as vendor_name,
             sh_header.awbno as Incom_AWB
             FROM part
             LEFT JOIN od_detail ON part.partno = od_detail.partno AND REGEXP_LIKE(od_detail.ext_state, REPLACE('@VAR.v07_ext_state@', ', ', '|')) 
             LEFT JOIN od_header ON od_detail.orderno_i = od_header.orderno_i AND REGEXP_LIKE(od_header.ext_state, REPLACE('@VAR.v07_ext_state@', ', ', '|'))
             LEFT JOIN address ON address.vendor = od_header.vendor 
             LEFT JOIN sh_detail ON od_detail.detailno_i = sh_detail.od_detailno_i 
             LEFT JOIN sh_header ON sh_detail.shipmentno_i = sh_header.shipmentno_i 
             WHERE 1=1
                   AND (
                              part.partno IN (
                                                           SELECT t.v
                                                           FROM (
                                                                        SELECT column_value as v
                                                                        FROM TABLE(amosserver_prod.string_splitter('@VAR.v06_partno_list@','line_feed'))
                                                                       ) t
                                                           WHERE t.v is not null
                                                          )
                              OR '@VAR.v06_partno_list@' IS NULL
                             )

             UNION ALL

             SELECT rownum,
                           part.partno as partno,
                           part.description as description,
                           part.ac_typ as ac_typ,
                           part.ata_chapter as ata_chapter,
                           part.mat_class as mat_class,
             CASE WHEN part.reorder IN ('F', 'H') THEN TO_NUMBER(part.max_purch) ELSE NULL END as max_purch,
             CASE WHEN part.reorder IN ('F', 'H') THEN TO_NUMBER(part.reord_level) ELSE NULL END as reord_level,
             CASE WHEN part.reorder IN ('F', 'H') THEN TO_NUMBER(part.alert_qty) ELSE NULL END as alert_qty,
             od_header.orderno as orderno,
             od_detail.posno as posno,
             od_detail.qty as qty,
             od_detail.backorder as backorder,
             od_header.ext_state as od_ext_state,
             od_detail.ext_state as od_detail_ext_state,
             CASE WHEN od_detail.confirmed_date &gt; 0 THEN TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_detail.confirmed_date, 'dd.mm.yyyy') ELSE '' END as confirmed_date,
             CASE WHEN od_detail.confirmed_date &gt; 0 THEN TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_detail.target_date, 'dd.mm.yyyy') ELSE '' END as target_date,
             od_header.priority as order_priority,
             od_detail.priority as order_detail_priority,
                    (
                       SELECT MAX (od_reminder.reminder_count) 
                       FROM od_reminder 
                       WHERE od_reminder.detailno_i = od_detail.detailno_i
                    ) AS reminder_count,
                    (
                       SELECT TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + MAX (od_reminder.reminder_date), 'dd.mm.yyyy')
                       FROM od_reminder 
                       WHERE od_reminder.detailno_i = od_detail.detailno_i
                    ) AS last_reminder_date,
             od_detail.ac_registr as ac_registr,
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_header.orderdate, 'dd.mm.yyyy') as orderdate,
             od_header.created_by as od_created_by,
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_header.created_date, 'dd.mm.yyyy') as od_created_date,
             od_detail.created_by as od_detail_created_by,
             TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od_detail.created_date, 'dd.mm.yyyy') as od_detail_created_date,
             od_detail.partno as ordered_partno,
             address.vendor as vendor,
             address.name||' '||address.name_1||' '||address.name_2 as vendor_name,
             sh_header.awbno as Incom_AWB
             FROM part
             JOIN part_alternate ON part.partno = part_alternate.partno 
             JOIN od_detail ON part_alternate.altpartno = od_detail.partno AND REGEXP_LIKE(od_detail.ext_state, REPLACE('@VAR.v07_ext_state@', ', ', '|'))  AND part_alternate.type = 'A'
             LEFT JOIN od_header ON od_detail.orderno_i = od_header.orderno_i AND REGEXP_LIKE(od_header.ext_state, REPLACE('@VAR.v07_ext_state@', ', ', '|'))
             LEFT JOIN address ON address.vendor = od_header.vendor 
             LEFT JOIN sh_detail ON od_detail.detailno_i = sh_detail.od_detailno_i 
             LEFT JOIN sh_header ON sh_detail.shipmentno_i = sh_header.shipmentno_i 
             WHERE 1=1
                   AND '@v05_include_alternates@'= 'Y'
                   AND (
                              part.partno IN (
                                                           SELECT t.v
                                                           FROM (
                                                                        SELECT column_value as v
                                                                        FROM TABLE(amosserver_prod.string_splitter('@VAR.v06_partno_list@','line_feed'))
                                                                       ) t
                                                           WHERE t.v is not null
                                                          )
                              OR '@VAR.v06_partno_list@' IS NULL
                             )
            )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="295_PSA_Stock" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(qty) as qty" id="qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_station@">
          <ds:object>@VAR.v01_station@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_owner@">
          <ds:object>@VAR.v02_owner@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@295_PSA_Main.partno@">
          <ds:object>@295_PSA_Main.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_include_alternates@">
          <ds:object>@v05_include_alternates@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT SUM(qty) as qty
FROM (
              SELECT consumables.qty
              FROM consumables
              JOIN location ON consumables.locationno_i = location.locationno_i 
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v01_station@', ', ', '|')) OR '@VAR.v01_station@' IS NULL)
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             AND (ASCII(consumables.owner) = 49824 OR consumables.owner IN (' ') OR consumables.owner IS NULL OR REGEXP_LIKE(consumables.owner, REPLACE('@VAR.v02_owner@', ', ', '|')) OR '@VAR.v02_owner@' IS NULL)
                             AND consumables.partno = '@295_PSA_Main.partno@'
              
              UNION ALL
              
              SELECT consumables.qty
              FROM part_alternate
              JOIN consumables ON consumables.partno = part_alternate.altpartno AND part_alternate.type = 'A'
              JOIN location ON consumables.locationno_i = location.locationno_i 
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v01_station@', ', ', '|')) OR '@VAR.v01_station@' IS NULL)
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             AND (ASCII(consumables.owner) = 49824 OR consumables.owner IN (' ') OR consumables.owner IS NULL OR REGEXP_LIKE(consumables.owner, REPLACE('@VAR.v02_owner@', ', ', '|')) OR '@VAR.v02_owner@' IS NULL)
                             AND part_alternate.type IN ('A', 'R', 'S')  
                             AND part_alternate.partno = '@295_PSA_Main.partno@'
                             AND '@v05_include_alternates@'= 'Y'


              UNION ALL

              SELECT COUNT(rotables.psn) as qty
              FROM part
              JOIN rotables on part.partno = rotables.partno
              JOIN part_fa_entity ON part.partno = part_fa_entity.partno AND (part_fa_entity.entityno_i = 1)
              JOIN location ON rotables.locationno_i = location.locationno_i
              WHERE 1=1
                            AND part.mat_class = 'R'
                            AND location.location_type &lt;&gt; -200
                            AND rotables.condition &lt;&gt; 'US'
                            AND (rotables.partnonew = ' ' OR  ASCII(rotables.partnonew) = 49824 OR rotables.partnonew IS NULL)
                            AND (rotables.ac_registr = ' ' OR rotables.ac_registr = 'TRANSF' OR ASCII(rotables.ac_registr) = 49824)
                            AND (ASCII(rotables.owner) = 49824 OR rotables.owner IN (' ') OR rotables.owner IS NULL OR REGEXP_LIKE(rotables.owner, REPLACE('@VAR.v02_owner@', ', ', '|')) OR '@VAR.v02_owner@' IS NULL)
                            AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v01_station@', ', ', '|')) OR '@VAR.v01_station@' IS NULL)
                            AND part.partno = '@295_PSA_Main.partno@'

              UNION ALL

              SELECT COUNT(rotables.psn) as qty
              FROM part
              JOIN part_alternate ON part.partno = part_alternate.partno AND part_alternate.type = 'A'
              JOIN rotables on part_alternate.altpartno = rotables.partno
              JOIN part_fa_entity ON part.partno = part_fa_entity.partno AND (part_fa_entity.entityno_i = 1)
              JOIN location ON rotables.locationno_i = location.locationno_i
              WHERE 1=1
                            AND part.mat_class = 'R'
                            AND location.location_type &lt;&gt; -200
                            AND rotables.condition &lt;&gt; 'US'
                            AND (rotables.partnonew = ' ' OR  ASCII(rotables.partnonew) = 49824 OR rotables.partnonew IS NULL)
                            AND (rotables.ac_registr = ' ' OR rotables.ac_registr = 'TRANSF' OR ASCII(rotables.ac_registr) = 49824)
                            AND (ASCII(rotables.owner) = 49824 OR rotables.owner IN (' ') OR rotables.owner IS NULL OR REGEXP_LIKE(rotables.owner, REPLACE('@VAR.v02_owner@', ', ', '|')) OR '@VAR.v02_owner@' IS NULL)
                            AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v01_station@', ', ', '|')) OR '@VAR.v01_station@' IS NULL)
                            AND part.partno = '@295_PSA_Main.partno@'
                            AND '@v05_include_alternates@'= 'Y'
             )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="295_PSA_Capability_list" type="SQL_EDITOR_DATASOURCE" version="2.0">
