    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="295_PSA_Part_forecast" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(part_forecast.requested_qty) as requested_qty" id="requested_qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_pf_date_from@">
          <ds:object>@VAR.v03_pf_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_pf_date_to@">
          <ds:object>@VAR.v04_pf_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@295_PSA_Main.partno@">
          <ds:object>@295_PSA_Main.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_include_alternates@">
          <ds:object>@v05_include_alternates@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT SUM(requested_qty) as requested_qty
FROM (
             SELECT part_forecast.requested_qty
             FROM part_forecast
             WHERE 1=1
                            AND part_forecast.valid_due_date &gt;= @VAR.v03_pf_date_from@
                            AND part_forecast.valid_due_date &lt;= @VAR.v04_pf_date_to@
                            AND part_forecast.receiver_type = 'AC'
                            AND part_forecast.partno = '@295_PSA_Main.partno@'
             
             UNION ALL
             
             SELECT part_forecast.requested_qty
             FROM part
             JOIN (
                       SELECT part_alternate.altpartno 
                       FROM part_alternate 
                       WHERE part_alternate.partno = '@295_PSA_Main.partno@'
                                     AND part_alternate.type = 'A'

                       UNION

                       SELECT part_alternate.partno as altpartno 
                       FROM part_alternate 
                       WHERE part_alternate.altpartno = '@295_PSA_Main.partno@'
                                     AND part_alternate.type = 'A'
                      ) p_alt ON p_alt.altpartno = part.partno
             JOIN part_forecast ON p_alt.altpartno = part_forecast.partno
             WHERE 1=1
                            AND part_forecast.valid_due_date &gt;= @VAR.v03_pf_date_from@
                            AND part_forecast.valid_due_date &lt;= @VAR.v04_pf_date_to@
                            AND part_forecast.receiver_type = 'AC'
                            AND '@v05_include_alternates@'= 'Y'
                            AND (part_forecast.part_request_part_cond &lt;&gt;'US' OR part_forecast.part_request_part_cond IS NULL)
            )</se:textStatement>
        </se:sqlStatement>
