      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT CASE WHEN REGEXP_LIKE(od_rec_detail.partno, '^[0-9]+$') THEN chr(39)||od_rec_detail.partno ELSE od_rec_detail.partno END as partno,
              od_rec_detail.batchno,
              part.description as description,
              part.mat_class,
              part.tool as is_tool,
              part.repairable as is_repairable,
              part.ac_typ as fa_type,
              part.ata_chapter as ata_chapter,
              od_header.orderno,
              TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od_header.orderdate+729), 'DD.MM.YYYY') as order_date,  
              od_header.vendor as vendor,
              TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od_rec_header.del_date+729), 'DD.MM.YYYY')  as receiving_date,
              TRUNC(TO_NUMBER(od_rec_detail.purch_price), 2) as purch_price,
              od_rec_detail.currency as currency,
              od_rec_detail.qty as received_qty,              
              max_h.sum_off_qty as off_qty,
              max_h_rn.sum_rn_qty as rn_qty,
              max_h.write_of_info
FROM od_header
LEFT JOIN od_rec_detail ON od_header.orderno = od_rec_detail.orderno
LEFT JOIN od_rec_header ON od_rec_detail.receivingno = od_rec_header.receivingno
LEFT JOIN part ON od_rec_detail.partno=part.partno
LEFT JOIN (
                    SELECT h.recdetailno_i,
                                  SUM (TO_NUMBER(h.qty)) as sum_off_qty,
                                  RTRIM(
                                               XMLAGG(
                                                                 XMLELEMENT(E,
                                                                                               'qty:'||TO_CHAR(TO_NUMBER(h.qty))
                                                                                              ||'; date:'||TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (h.del_date+729), 'DD.MM.YYYY')
                                                                                              ||'; costcenter:'||NVL(h.ac_registr, h.costcenter)
                                                                                           /*   ||' ('||h.ac_typ||')' */
                                                                                              ||'; owner:'||h.owner
                                                                                              ||'; vm:'||h.vm
                                                                                               , CHR(10)
                                                                                            ).EXTRACT('//text()'
                                                               ) ORDER BY h.del_date
                                              ).GetClobVal(), CHR(10)
                                              ) as write_of_info
                    FROM (
                                 SELECT history.historyno_i,
                                               MAX (history.historyno_i) OVER (PARTITION BY history.pickslipseqno_i, history.batchno, history.partno) as max_historyno_i,
                                               history.partno,
                                               history.batchno,
                                               history.del_date,
                                               history.owner,
                                               history.ac_typ,
                                               history.ac_registr,
                                               history.vm,
                                               history.recdetailno_i,
                                               history.qty,
                                               history.mat_class,
                                               history.pickslipseqno_i,
                                               history.costcenter
                                 FROM history
                                 WHERE (history.vm='BN' AND history.qty&lt;0
                                                 OR 
                                                 history.vm IN (
                                                                            'AA', /* списание на вс (book PS)  */
                                                                            'AS', /* списание не на вс (book PS)  */
                                                                            'EA', /* отмена списания на ВС (отмена PS)  */
                                                                            'ES', /* отмена списания в shop (отмена PS)  */
                                                                            'I' /* inventory  */
                                                                           )
                                                  )
                                               /* AND history.owner='AFL' уточнить  */
                                                AND history.del_date &gt;=16803
                                                AND history.del_date &lt;=17167
                                ) h
                    WHERE (h.historyno_i=h.max_historyno_i OR h.vm='BN')
                                   AND h.vm NOT IN ('EA','ES')
                                   AND h.mat_class IN ('E','C')
                     GROUP BY h.recdetailno_i
                   ) max_h ON max_h.recdetailno_i = od_rec_detail.recdetailno_i

LEFT JOIN (
                    SELECT h.recdetailno_i,
                                  SUM (TO_NUMBER(h.qty)) as sum_rn_qty
                    FROM (
                                 SELECT history.historyno_i,
                                               MAX (history.historyno_i) OVER (PARTITION BY history.pickslipseqno_i, history.batchno, history.partno) as max_historyno_i,
                                               history.partno,
                                               history.batchno,
                                               history.del_date,
                                               history.owner,
                                               history.ac_typ,
                                               history.ac_registr,
                                               history.vm,
                                               history.recdetailno_i,
                                               history.qty,
                                               history.mat_class,
                                               history.pickslipseqno_i
                                 FROM history
                                 WHERE (history.vm='BN' AND history.qty&lt;0
                                                 OR 
                                                 history.vm IN (
                                                                            'AA', /* списание на вс (book PS)  */
                                                                            'AS', /* списание не на вс (book PS)  */
                                                                            'EA', /* отмена списания на ВС (отмена PS)  */
                                                                            'ES', /* отмена списания в shop (отмена PS)  */
                                                                             'I' /* inventory */
                                                                           )
                                                  )
                                               /* AND history.owner='AFL' уточнить  */
                                                AND history.del_date &gt;=16803
                                                AND history.del_date &lt;=17167
                                ) h
                    WHERE (h.historyno_i=h.max_historyno_i OR h.vm='BN')
                                   AND h.vm IN ('BN')
                                   AND h.mat_class IN ('E','C')
                     GROUP BY h.recdetailno_i
                   ) max_h_rn ON max_h_rn.recdetailno_i = od_rec_detail.recdetailno_i


WHERE od_header.order_type='P'
               AND od_rec_detail.status &lt;&gt; 9
               AND ( part.mat_class IN ('C', 'E'))
               AND od_rec_header.del_date &gt;=16803
               AND od_rec_header.del_date &lt;=17167
/*               AND od_header.orderno='P1105217'
               AND od_rec_detail.partno='152710-02C34' */

/*
max_h.mat_class IN ('C', 'E') OR


               AND (
                          '@VAR.interval_type@'='write_off_date'
                           AND max_h.del_date&gt;=@VAR.from@
                           AND max_h.del_date&lt;=@VAR.to@
                           OR
                           '@VAR.interval_type@'='receiving_date'
                           AND od_rec_header.del_date &gt;=@VAR.from@
                           AND od_rec_header.del_date &lt;=@VAR.to@
                           OR
                           '@VAR.interval_type@'='order_date'
                           AND od_header.orderdate &gt;=@VAR.from@
                           AND od_header.orderdate &lt;=@VAR.to@
                          )

               AND (REGEXP_LIKE(part.ata_chapter, '^@VAR.ata@(*)') OR '@VAR.ata@' IS NULL) 
               AND (REGEXP_LIKE(od_header.vendor, REPLACE('@VAR.vendor@', ', ', '|')) OR '@VAR.vendor@' IS NULL)

               AND od_rec_detail.partno='M81934-2-11A010'
               AND od_rec_detail.batchno='39572'
*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
