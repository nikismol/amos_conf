        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (od_header.orderdate+729)'DD.MM.YYYY') as order_date" id="order_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.vendor as vendor" id="vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (od_rec_header.del_date+729)'DD.MM.YYYY')  as receiving_date" id="receiving_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TRUNC(TO_NUMBER(od_rec_detail.purch_price)2) as purch_price" id="purch_price"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.currency as currency" id="currency"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.qty as received_qty" id="received_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="max_h.sum_off_qty as off_qty" id="off_qty"/>
