      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN REGEXP_LIKE(od_rec_detail.partno'^[0-9]+$') THEN chr(39)||od_rec_detail.partno ELSE od_rec_detail.partno END as partno" id="partno"/>
