                                 OR '@VAR.v04_planned_date_in@'='6M' AND part_forecast.planned_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 6), 'dd')-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v04_planned_date_in@'='3M' AND part_forecast.planned_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 3), 'dd')-to_date('19711231','yyyymmdd'))
