                                 OR '@VAR.v04_planned_date_in@'='1W' AND part_forecast.planned_date &lt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))+7
                                 OR '@VAR.v04_planned_date_in@'='CUR_W' AND part_forecast.planned_date &lt;= FLOOR(TRUNC (SYSDATE, 'D') + 6 - to_date('19711231','yyyymmdd'))
