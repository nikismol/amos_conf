                                 OR '@VAR.v03_due_date_in@'='2YE' AND part_forecast.expected_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 24), 'dd')-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v03_due_date_in@'='1YE' AND part_forecast.expected_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 12), 'dd')-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v03_due_date_in@'='CUR_YE' AND part_forecast.expected_date &lt;= FLOOR(TRUNC (ADD_MONTHS (SYSDATE, 12), 'YY') - 1 - to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v03_due_date_in@'='6M' AND part_forecast.expected_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 6), 'dd')-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v03_due_date_in@'='3M' AND part_forecast.expected_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 3), 'dd')-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v03_due_date_in@'='2M' AND part_forecast.expected_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 2), 'dd')-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v03_due_date_in@'='1M' AND part_forecast.expected_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 1), 'dd')-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v03_due_date_in@'='CUR_M' AND part_forecast.expected_date &lt;= FLOOR(TRUNC(LAST_DAY (SYSDATE)) - to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v03_due_date_in@'='2W' AND part_forecast.expected_date &lt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))+14
                                 OR '@VAR.v03_due_date_in@'='1W' AND part_forecast.expected_date &lt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))+7
                                 OR '@VAR.v03_due_date_in@'='CUR_W' AND part_forecast.expected_date &lt;= FLOOR(TRUNC (SYSDATE, 'D') + 6 - to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v03_due_date_in@'='3D' AND part_forecast.expected_date &lt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))+3
                                 OR '@VAR.v03_due_date_in@'='1D' AND part_forecast.expected_date &lt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))+1
                                 OR '@VAR.v03_due_date_in@'='TODAY' AND part_forecast.expected_date &lt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v04_planned_date_in@'='ALL'
                                 OR '@VAR.v04_planned_date_in@'='3YE' AND part_forecast.planned_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 36), 'dd')-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v04_planned_date_in@'='2YE' AND part_forecast.planned_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 24), 'dd')-to_date('19711231','yyyymmdd'))
                                 OR '@VAR.v04_planned_date_in@'='1YE' AND part_forecast.planned_date &lt;= FLOOR(TRUNC(ADD_MONTHS(sysdate, 12), 'dd')-to_date('19711231','yyyymmdd'))
