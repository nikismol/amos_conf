    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_AOG_DETAILS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT od_header.pool_ac_typ as pool_ac_typ" id="pool_ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno as orderno" id="orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.vendor as vendor" id="vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.pool_reason as pool_reason" id="pool_reason"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (od_header.created_date + 729)'DD.MM.YYYY') as order_created_date" id="order_created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (od_header.orderdate + 729)'DD.MM.YYYY') as order_date" id="order_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (od.order_date_plus_3days + 729)'DD.MM.YYYY') as order_date_plus_3days" id="order_date_plus_3days"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DDMMYYYY') + (od_detail.target_date + 729)'DD.MM.YYYY') as target_date" id="target_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wp_header.end_date + 729)'DD.MM.YYYY') as wp_end_date" id="wp_end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (sh_pr.flight_date + 729)'DD.MM.YYYY') as filght_date" id="filght_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (rec.del_date + 729)'DD.MM.YYYY') as receiving_date" id="receiving_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as WO" id="WO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header_crx.aog_risk as aog_wo" id="aog_wo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;       CASE WHEN od_header.pool_ac_typ='RRJ' AND od_header.vendor='ZPL_GSS'&#10;            THEN CASE WHEN NVL(rec.del_date 99999)&lt;=NVL(od_detail.target_date od_header.created_date+1) THEN 'in_time'&#10;                 ELSE CASE WHEN rec.del_date IS NOT NULL AND rec.del_date&gt;od_header.created_date+1 THEN 'delay'&#10;                           WHEN rec.del_date IS NULL AND od_detail.target_date&lt;od_header.created_date+1 AND FLOOR(sysdate-to_date('19711231''yyyymmdd'))&gt;od_header.created_date+1 THEN 'delay' &#10;                           WHEN rec.del_date IS NULL AND od_detail.target_date&gt;=od_header.created_date+1 AND FLOOR(sysdate-to_date('19711231''yyyymmdd'))&gt;od_detail.target_date THEN 'delay' &#10;                           ELSE 'in_time'&#10;                      END&#10;                 END&#10;            WHEN od_header.pool_ac_typ='RRJ' AND od_header.vendor!='ZPL_GSS'&#10;            THEN CASE WHEN NVL(sh_pr.flight_date 99999)&lt;=NVL(od_detail.target_date od_header.created_date+1) THEN 'in_time'&#10;                      ELSE CASE WHEN sh_pr.flight_date IS NOT NULL AND sh_pr.flight_date&gt;od_header.created_date+1 THEN 'delay'&#10;                                WHEN sh_pr.flight_date IS NULL AND od_detail.target_date&lt;od_header.created_date+1 AND FLOOR(sysdate-to_date('19711231''yyyymmdd'))&gt;od_header.created_date+1 THEN 'delay' &#10;                                WHEN sh_pr.flight_date IS NULL AND od_detail.target_date&gt;=od_header.created_date+1 AND FLOOR(sysdate-to_date('19711231''yyyymmdd'))&gt;od_detail.target_date THEN 'delay' &#10;                           ELSE 'in_time'&#10;                      END&#10;                 END                        &#10;            ELSE CASE WHEN NVL(sh_pr.flight_date 99999)&lt;=GREATEST(NVL(wp_header.end_date0) NVL(od_detail.target_date0)) THEN 'in_time'&#10;                      ELSE CASE WHEN sh_pr.flight_date IS NOT NULL AND sh_pr.flight_date&gt;od_header.orderdate+3 THEN 'delay'&#10;                                WHEN sh_pr.flight_date IS NULL AND GREATEST(NVL(wp_header.end_date0) NVL(od_detail.target_date0))&lt;od_header.orderdate+3  AND FLOOR(sysdate-to_date('19711231''yyyymmdd'))&gt;od_header.orderdate+3 THEN 'delay' &#10;                                WHEN sh_pr.flight_date IS NULL AND GREATEST(NVL(wp_header.end_date0) NVL(od_detail.target_date0))&gt;=od_header.orderdate+3  AND FLOOR(sysdate-to_date('19711231''yyyymmdd'))&gt;GREATEST(NVL(wp_header.end_date0) NVL(od_detail.target_date0)) THEN 'delay' &#10;                                ELSE 'in_time'&#10;                           END&#10;                 END&#10;       END as time_check" id="time_check"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (od_header.orderdate+729)'MM.YYYY (month)') as issue_month" id="issue_month"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_month@">
          <ds:object>@VAR.v01_month@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
       od.pool_ac_typ as pool_ac_typ,
       od.orderno as orderno,
       od.vendor as vendor,
       od.pool_reason as pool_reason,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od.order_created_date + 729), 'DD.MM.YYYY') as order_created_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od.order_date + 729), 'DD.MM.YYYY') as order_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od.order_date_plus_3days + 729), 'DD.MM.YYYY') as order_date_plus_3days,
       TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od.target_date + 729), 'DD.MM.YYYY') as target_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od.end_date + 729), 'DD.MM.YYYY') as wp_end_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od.flight_date + 729), 'DD.MM.YYYY') as filght_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od.receiving_date + 729), 'DD.MM.YYYY') as receiving_date,
       od.workorder as WO,
       od.aog_wo as aog_wo,
       od.time_check as time_check,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od.order_date+729), 'MM.YYYY (month)') as issue_month
FROM MRG_MONITOR_MONTHLY_AOG_ORDERS od
WHERE TO_CHAR(ADD_MONTHS(SYSDATE, '@VAR.v01_month@'), 'MM.YYYY (month)') = TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + od.order_date, 'MM.YYYY (month)')          </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_VAR_DESCRIPTION" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE ('@VAR.01_month@'&#10;                               '-1' TO_CHAR(ADD_MONTHS(SYSDATE -1) 'MM.YYYY (month)')&#10;                               '0' TO_CHAR(ADD_MONTHS(SYSDATE 0) 'MM.YYYY (month)')'') as var_desc" id="var_desc"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_month@">
          <ds:object>@VAR.v01_month@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DECODE ('@VAR.v01_month@',
                               '-1', TO_CHAR(ADD_MONTHS(SYSDATE, -1), 'MM.YYYY (month)'),
                               '0', TO_CHAR(ADD_MONTHS(SYSDATE, 0), 'MM.YYYY (month)'),
                               '') as var_desc
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
