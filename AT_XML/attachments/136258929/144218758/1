      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
                     CASE WHEN p.partno LIKE ('0%') AND REGEXP_LIKE(p.partno, '^[0-9]+$') THEN chr(39)||p.partno ELSE p.partno END as partno,
                     p.sn_bn as sn_bn,
                     ROUND(SUM(p.qty), 2) as qty,
                     p.description description,
                     p.owner as owner,
                     p.mat_class as mat_class,
                     p.repairable,
                     p.mat_type as mat_type,
                     p.ata_chapter as ata_chapter,
                     p.station as station,
                     p.store as store,
                     p.store_description as store_description,
                     p.location as location,
                     p.location_description as location_description,
                     p.ac_typ as ac_typ,
                     DECODE(p.last_removal, NULL, NULL, TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + p.last_removal, 'dd.mm.yyyy')) as last_removal,
                     p.int_capability_list as int_capability_list,
                     p.ext_capability_list_shop as ext_capability_list_shop,
                     p.ext_capability_list_shop_name as ext_capability_list_shop_name,
                     NVL(CASE WHEN p.mat_class = 'R' THEN ROUND(r_stock.qty, 2) ELSE ROUND(c_stock.qty, 2) END, 0) as stock_qty,
                     NVL(CASE WHEN p.mat_class = 'R' THEN ROUND(r_stock_incl_alt.qty, 2) ELSE ROUND(c_stock_incl_alt.qty, 2) END, 0) as alt_stock_qty,
                     DECODE(p.store,
                                     '1011', 'Входной контроль ОМТО',
                                     '1014', 'Карантинная зона ОМТО',
                                     '1045', 'Виртуальный склада BASE ОМТО',
                                     '1143', '13 цех ЦОПИ',
                                     '1160', 'Утилизировано в металлолом ОМТО',
                                     '1221', 'Реализация ДУЗД',
                                     '1222', 'Возврат из представительств ДУЗД',
                                     '1250', 'Отправка в ремонт ДУЗД',
                                     '1253', 'Непрошедшие вх.контроль ДУЗД',
                                     '302R', 'ДТО ВС ЖИТКОВА С.В.',
                                     '3504', 'АФАНАСЬЕВА О.В.',
                                     '4008', 'Острава ',
                                     '4019', 'Оренбург',
                                     '4020', 'Гонгконг',
                                     '4031', 'Сочи',
                                     '4032', 'А-техникс SVO чехлы',
                                     '6220', 'Зарубежные представительства',
                                     '_REMOVAL', 'Производство',
                                     'ACC', 'Аварийно-спасательное оборудование ОМТО',
                                     'APOBEDA', 'Зпч для ремонта АК Победа',
                                     'AROSSIYA', 'Зпч для ремонта АК Россия',
                                     'AS7', 'Зпч для ремонта АК S7',
                                     'ATSVO', 'А-техникс SVO масло',
                                     'AURAL', 'Зпч для ремонта АК Уральские авиалинии',
                                     'BASE', 'ИВС основной ОМТО',
                                     'CABIN', 'Кабинное оборудование ОМТО',
                                     'EXTERNAL', 'Виртуальный  внешний склад',
                                     'F201', 'Петропавловск-Камчатский',
                                     'LISTOFTL', 'Инструмент 8цеха ДТО',
                                     'PRODUCE', 'Изготовленные внутри АФЛ ОМТО',
                                     'SRS', '5 цех  ДТО',
                                     'SSJ', 'ОВС RRJ ОМТО',
                                     'TOOLS', 'Инструмент ОМТО',
                                     'WHEELS', 'Колесный ОМТО',
                                     '') as add_store_description,
                     p_remarks.text as repair_remarks,
                     CASE WHEN db_link.destination_key IS NULL THEN '' ELSE  'web://'||db_link.destination_key END as link_path,
                     p.orderno as orderno,
                     p.ext_state as ext_state,
                     p.vendor,
                     p.order_type as order_type,
	     part_special.special
FROM (

/* получаю u/s rotables */
              SELECT
                     part.partno,
                     CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE rotables.serialno END as sn_bn,
                     1 as qty,
                     part.description,
                     CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE rotables.owner END as owner,
                     part.mat_class,
                     part.repairable,
                     part.mat_type,
                     part.ata_chapter,
                     location.station,
                     location.store,
                     station_store.description as store_description,
                     CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE location.location END as location,
                     CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE location.description END as location_description,
                     part.ac_typ,
                     CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE last_removal.last_removal END as last_removal,
                     cl_internal.capability_list as int_capability_list,
                     cl_external.shop as ext_capability_list_shop,
                     cl_external.shop_name as ext_capability_list_shop_name,
                     od.orderno,
                     od.ext_state,
                     od.vendor,
                     od.order_type
              FROM part
              JOIN rotables on part.partno = rotables.partno
              JOIN location ON rotables.locationno_i = location.locationno_i
              LEFT JOIN station_store ON location.store = station_store.store AND location.station = station_store.station
              LEFT JOIN (
                         SELECT
                                history.psn,
                                max(history.del_date) as last_removal
                         FROM history
                         WHERE 1=1
                               AND history.vm = 'YA'
                         GROUP BY history.psn
                        ) last_removal ON rotables.psn = last_removal.psn
              LEFT JOIN (
                         SELECT part_capability.partseqno_i,
                                LISTAGG(DISTINCT part_capability.shop || ' (' || address.name || ')', ', '||CHR(10)) WITHIN GROUP (ORDER BY part_capability.shop) as capability_list
                         FROM part_capability
                         JOIN address ON part_capability.shop = address.vendor
                         JOIN adr_properties ON address.address_i = adr_properties.address_i
                         JOIN adr_prop_type ON adr_prop_type.prop_type_i = adr_properties.prop_type_i AND adr_prop_type.code = 'IS'
                         WHERE 1=1
                               AND part_capability.status &lt;&gt; 9
                         GROUP BY part_capability.partseqno_i
                        ) cl_internal ON part.partseqno_i = cl_internal.partseqno_i
              LEFT JOIN (
                         SELECT part_capability.partseqno_i,
                                       LISTAGG(DISTINCT part_capability.shop, ', '||CHR(10)) WITHIN GROUP (ORDER BY part_capability.shop) as shop,
                                       LISTAGG(DISTINCT address.name, ', '||CHR(10)) WITHIN GROUP (ORDER BY part_capability.shop) as shop_name
                         FROM part_capability
                         JOIN address ON part_capability.shop = address.vendor
                         LEFT JOIN (SELECT address.address_i
                                            FROM address
                                            JOIN adr_properties ON address.address_i = adr_properties.address_i
                                            JOIN adr_prop_type ON adr_prop_type.prop_type_i = adr_properties.prop_type_i AND adr_prop_type.code = 'IS'
                                           ) is_address ON address.address_i = is_address.address_i
                         WHERE 1=1
                               AND is_address.address_i IS NULL
                               AND part_capability.status &lt;&gt; 9
                         GROUP BY part_capability.partseqno_i
                        ) cl_external ON part.partseqno_i = cl_external.partseqno_i
              LEFT JOIN (
                         SELECT od_detail.psn,
                                LISTAGG(od_header.orderno, ', ') WITHIN GROUP (ORDER BY od_header.orderno) as orderno,
                                LISTAGG(od_header.order_type, ', ') WITHIN GROUP (ORDER BY od_header.orderno) as order_type,
                                LISTAGG(od_header.ext_state, ', ') WITHIN GROUP (ORDER BY od_header.orderno) as ext_state,
                                LISTAGG(od_header.vendor, ', ') WITHIN GROUP ( ORDER BY  od_header.orderno) as vendor
                         FROM od_detail
                         JOIN od_header ON od_detail.orderno_i = od_header.orderno_i AND od_header.ext_state IN ('D', 'O', 'BO', 'PR', 'PB') AND od_header.order_type IN ('PX','R','LU','RU','PU','YU')
                                 WHERE 1=1
                         GROUP BY od_detail.psn
                        ) od ON rotables.psn = od.psn
              WHERE 1=1
                    AND part.mat_class = 'R'
                    AND location.location_type &lt;&gt; -200
                    AND rotables.condition = 'US'
                    AND (rotables.partnonew = ' ' OR  ASCII(rotables.partnonew) = 49824 OR rotables.partnonew IS NULL)
                    AND (rotables.ac_registr = ' ' OR rotables.ac_registr = 'TRANSF' OR ASCII(rotables.ac_registr) = 49824 OR rotables.ac_registr IS NULL)

UNION ALL
/* получаю u/s consumbales */

              SELECT
                     part.partno,
                     CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE consumables.batchno END as sn_bn,
                     consumables.qty,
                     part.description,
                      CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE consumables.owner END as owner,
                     part.mat_class,
                     part.repairable,
                     part.mat_type,
                     part.ata_chapter,
                     location.station,
                     location.store,
                     station_store.description as store_description,
                     CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE location.location END as location,
                     CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE location.description END as location_description,
                     part.ac_typ,
                     CASE WHEN '@VAR.v01_group_by_store@' = 'Y' THEN NULL ELSE last_removal.last_removal END as last_removal,
                     cl_internal.capability_list as int_capability_list,
                     cl_external.shop as ext_capability_list_shop,
                     cl_external.shop_name as ext_capability_list_shop_name,
                     od.orderno,
                     od.ext_state,
                     od.vendor,
                     od.order_type
              FROM part
              JOIN consumables on part.partno = consumables.partno
              JOIN location ON consumables.locationno_i = location.locationno_i
              LEFT JOIN station_store ON location.store = station_store.store AND location.station = station_store.station
              LEFT JOIN condition ON consumables.condition = condition.condition
              LEFT JOIN (
                         SELECT history.partno,
                                history.batchno,
                                history.recdetailno_i,
                                max(history.del_date) as last_removal
                         FROM history
                         WHERE 1=1
                               AND history.vm = 'B8'
                         GROUP BY history.partno, history.batchno, history.recdetailno_i
                        ) last_removal ON consumables.partno = last_removal.partno AND consumables.batchno = last_removal.batchno AND consumables.recdetailno_i = last_removal.recdetailno_i
              LEFT JOIN (
                         SELECT part_capability.partseqno_i,
                                LISTAGG(DISTINCT part_capability.shop || ' (' || address.name || ')', ', '||CHR(10)) WITHIN GROUP (ORDER BY part_capability.shop) as capability_list
                         FROM part_capability
                         JOIN address ON part_capability.shop = address.vendor
                         JOIN adr_properties ON address.address_i = adr_properties.address_i
                         JOIN adr_prop_type ON adr_prop_type.prop_type_i = adr_properties.prop_type_i AND adr_prop_type.code = 'IS'
                         WHERE 1=1
                               AND part_capability.status &lt;&gt; 9
                         GROUP BY part_capability.partseqno_i
                        ) cl_internal ON part.partseqno_i = cl_internal.partseqno_i
              LEFT JOIN (
                         SELECT part_capability.partseqno_i,
                                       LISTAGG(DISTINCT part_capability.shop, ', '||CHR(10)) WITHIN GROUP (ORDER BY part_capability.shop) as shop,
                                       LISTAGG(DISTINCT address.name, ', '||CHR(10)) WITHIN GROUP (ORDER BY part_capability.shop) as shop_name
                         FROM part_capability
                         JOIN address ON part_capability.shop = address.vendor
                         LEFT JOIN (SELECT address.address_i
                                            FROM address
                                            JOIN adr_properties ON address.address_i = adr_properties.address_i
                                            JOIN adr_prop_type ON adr_prop_type.prop_type_i = adr_properties.prop_type_i AND adr_prop_type.code = 'IS'
                                           ) is_address ON address.address_i = is_address.address_i
                         WHERE 1=1
                               AND is_address.address_i IS NULL
                               AND part_capability.status &lt;&gt; 9
                         GROUP BY part_capability.partseqno_i
                        ) cl_external ON part.partseqno_i = cl_external.partseqno_i
              LEFT JOIN (
                         SELECT od_detail.partno,
                                od_detail.serialno,
                                od_detail.storeno_i,
                                LISTAGG(od_header.orderno, ', ') WITHIN GROUP (ORDER BY od_header.orderno) as orderno,
                                LISTAGG(od_header.order_type, ', ') WITHIN GROUP (ORDER BY od_header.orderno) as order_type,
                                LISTAGG(od_header.ext_state, ', ') WITHIN GROUP (ORDER BY od_header.orderno) as ext_state,
                                LISTAGG(od_header.vendor, ', ') WITHIN GROUP ( ORDER BY  od_header.orderno) as vendor
                         FROM od_detail
                         JOIN od_header ON od_detail.orderno_i = od_header.orderno_i AND od_header.ext_state IN ('D', 'O', 'BO', 'PR', 'PB') AND od_header.order_type IN ('PX','R','LU','RU','PU','YU')
                                 WHERE 1=1
                         GROUP BY od_detail.partno,
                                             od_detail.serialno,
                                             od_detail.storeno_i
                        ) od ON consumables.partno = od.partno AND consumables.batchno = od.serialno AND consumables.storeno_i = od.storeno_i
              WHERE 1=1
                    AND part.mat_class IN ('C','E')
                    AND location.location_type &lt;&gt; -200
                    AND COALESCE (consumables.condition, ' ') = 'US'
                    /* AND part.repairable = 'Y' */
) p

LEFT JOIN (
              SELECT SUM(consumables.qty) as qty,
                     p2.partno
              FROM part p2
              JOIN consumables on p2.partno = consumables.partno
              JOIN location ON consumables.locationno_i = location.locationno_i
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v02_station@', ', ', '|')) OR '@VAR.v02_station@' IS NULL)
                             AND (REGEXP_LIKE(location.store, REPLACE('@VAR.v03_store@', ', ', '|')) OR '@VAR.v03_store@' IS NULL)
                             /* AND location.station in ('SVO', 'SHRM') */
                             /* AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE') */
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             /* AND (consumables.owner IN (' ', 'AFL') OR consumables.owner IS NULL OR ASCII(consumables.owner) = 49824) */
             group by p2.partno
) c_stock ON p.partno = c_stock.partno

LEFT JOIN (
SELECT SUM(qty) as qty,
       partno
FROM (
              SELECT consumables.qty,
                     p2.partno
              FROM part p2
              JOIN consumables ON p2.partno = consumables.partno
              JOIN location ON consumables.locationno_i = location.locationno_i
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v02_station@', ', ', '|')) OR '@VAR.v02_station@' IS NULL)
                             AND (REGEXP_LIKE(location.store, REPLACE('@VAR.v03_store@', ', ', '|')) OR '@VAR.v03_store@' IS NULL)
                             /* AND location.station in ('SVO', 'SHRM') */
                             /* AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE') */
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             /* AND (consumables.owner IN (' ', 'AFL') OR consumables.owner IS NULL OR ASCII(consumables.owner)= 49824) */

              UNION ALL

              SELECT consumables.qty,
                     p2.partno
              FROM part p2
              JOIN part_alternate ON p2.partno = part_alternate.partno
              JOIN consumables ON consumables.partno = part_alternate.altpartno
              JOIN location ON consumables.locationno_i = location.locationno_i
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v02_station@', ', ', '|')) OR '@VAR.v02_station@' IS NULL)
                             AND (REGEXP_LIKE(location.store, REPLACE('@VAR.v03_store@', ', ', '|')) OR '@VAR.v03_store@' IS NULL)
                             /* AND location.station in ('SVO', 'SHRM') */
                             /* AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE') */
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             /* AND (consumables.owner IN (' ', 'AFL') OR consumables.owner IS NULL OR ASCII(consumables.owner)= 49824) */
                             AND part_alternate.type IN ('A' /*, 'R', 'S'*/)
             )
group by partno
) c_stock_incl_alt ON c_stock_incl_alt.partno = p.partno

LEFT JOIN (
              SELECT COUNT(rotables.psn) as qty,
                     part.partno
              FROM part
              JOIN rotables on part.partno = rotables.partno
              JOIN location ON rotables.locationno_i = location.locationno_i
              WHERE 1=1
                            AND part.mat_class = 'R'
                            AND location.location_type &lt;&gt; -200
                            AND rotables.condition &lt;&gt; 'US'
                            AND (rotables.partnonew = ' ' OR  ASCII(rotables.partnonew) = 49824)
                            AND (rotables.ac_registr = ' ' OR rotables.ac_registr = 'TRANSF' OR ASCII(rotables.ac_registr) = 49824)
                            /* AND (rotables.owner IN (' ','AFL') OR rotables.owner IS NULL OR ASCII(rotables.owner) = 49824) */
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v02_station@', ', ', '|')) OR '@VAR.v02_station@' IS NULL)
                             AND (REGEXP_LIKE(location.store, REPLACE('@VAR.v03_store@', ', ', '|')) OR '@VAR.v03_store@' IS NULL)
                             /* AND location.station in ('SVO', 'SHRM') */
                             /* AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE') */
             group by part.partno
) r_stock ON p.partno = r_stock.partno

LEFT JOIN (
SELECT SUM(qty) as qty,
       partno
FROM (
              SELECT 1 as qty,
                     part.partno
              FROM part
              JOIN rotables on part.partno = rotables.partno
              JOIN location ON rotables.locationno_i = location.locationno_i
              WHERE 1=1
                            AND part.mat_class = 'R'
                            AND location.location_type &lt;&gt; -200
                            AND rotables.condition &lt;&gt; 'US'
                            AND (rotables.partnonew = ' ' OR  ASCII(rotables.partnonew) = 49824)
                            AND (rotables.ac_registr = ' ' OR rotables.ac_registr = 'TRANSF' OR ASCII(rotables.ac_registr) = 49824)
                            /* AND (rotables.owner IN (' ','AFL') OR rotables.owner IS NULL OR ASCII(rotables.owner) = 49824) */
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v02_station@', ', ', '|')) OR '@VAR.v02_station@' IS NULL)
                             AND (REGEXP_LIKE(location.store, REPLACE('@VAR.v03_store@', ', ', '|')) OR '@VAR.v03_store@' IS NULL)
                             /* AND location.station in ('SVO', 'SHRM') */
                             /* AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE') */

              UNION ALL

              SELECT 1 as qty,
                     part.partno
              FROM part
              JOIN part_alternate ON part.partno = part_alternate.partno
              JOIN rotables on part_alternate.altpartno = rotables.partno
              JOIN location ON rotables.locationno_i = location.locationno_i
              WHERE 1=1
                            AND part.mat_class = 'R'
                            AND location.location_type &lt;&gt; -200
                            AND rotables.condition &lt;&gt; 'US'
                            AND (rotables.partnonew = ' ' OR  ASCII(rotables.partnonew) = 49824)
                            AND (rotables.ac_registr = ' ' OR rotables.ac_registr = 'TRANSF' OR ASCII(rotables.ac_registr) = 49824)
                            /* AND (rotables.owner IN (' ','AFL') OR rotables.owner IS NULL OR ASCII(rotables.owner) = 49824) */
                            AND part_alternate.type IN ('A' /*, 'R', 'S'*/)
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v02_station@', ', ', '|')) OR '@VAR.v02_station@' IS NULL)
                             AND (REGEXP_LIKE(location.store, REPLACE('@VAR.v03_store@', ', ', '|')) OR '@VAR.v03_store@' IS NULL)
                             /* AND location.station in ('SVO', 'SHRM') */
                             /* AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE') */
             )
group by partno
) r_stock_incl_alt ON r_stock_incl_alt.partno = p.partno

LEFT JOIN (SELECT part_remarks.partno,
                                 LISTAGG(part_remarks.text, ' ') WITHIN GROUP (ORDER BY part_remarks.recno) as text
                   FROM part_remarks
                   WHERE part_remarks.effectivity = 'REPAIR'
                   GROUP BY part_remarks.partno
                  ) p_remarks ON p.partno = p_remarks.partno

LEFT JOIN db_link ON p.partno =  db_link.source_pk AND db_link.source_type = 'PR-PURCH' AND db_link.link_type = 'D'

LEFT JOIN  part_special  ON p.partno =   part_special.partno  AND (part_special.special ='EXP_Y' OR  part_special.special ='EXP_N' OR part_special.special IN ('EXP_X', 'Remarks') )

GROUP BY p.partno,
                    p.sn_bn,
                    p.description,
                    p.owner,
                    p.mat_class,
                    p.repairable,
                    p.mat_type,
                    p.ata_chapter,
                    p.station,
                    p.store,
                    p.store_description,
                    p.location,
                    p.location_description,
                    p.ac_typ,
                    p.last_removal,
                    p.int_capability_list,
                    p.ext_capability_list_shop,
                    p.ext_capability_list_shop_name,
                    r_stock.qty,
                    r_stock_incl_alt.qty,
                    c_stock.qty,
                    c_stock_incl_alt.qty,
                    p_remarks.text,
                    db_link.destination_key,
                    p.orderno,
                    p.ext_state,
                    p.vendor,
                    p.order_type,
	    part_special.special
ORDER BY p.mat_class DESC, p.partno</se:textStatement>
