    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Sum_Qty_Stok_2" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="stock.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="stock.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="stock.mat_class as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;            &#9;WHEN stock.location_restriction_alt= '0' THEN stock.alt_qty &#10;            &#9;ELSE null&#10;&#9;END  standard" id="standard"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;            &#9;WHEN stock.location_restriction_alt= '1' THEN stock.alt_qty &#10;            &#9;ELSE null&#10;&#9;END  restricted" id="restricted"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;            &#9;WHEN stock.location_restriction_alt= '2' THEN stock.alt_qty &#10;            &#9;ELSE null&#10;&#9;END  inaccessible" id="inaccessible"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="stock.altpartno as altpartno" id="altpartno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;            &#9;WHEN stock.location_restriction_alt= '0' THEN stock.alt_qty &#10;            &#9;ELSE null&#10;&#9;END  standard_alt" id="standard_alt"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;            &#9;WHEN stock.location_restriction_alt= '1' THEN stock.alt_qty &#10;            &#9;ELSE null&#10;&#9;END  restricted_alt" id="restricted_alt"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;            &#9;WHEN stock.location_restriction_alt= '2' THEN stock.alt_qty &#10;            &#9;ELSE null&#10;&#9;END  inaccessible_alt" id="inaccessible_alt"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  	
	stock.partno as partno,
	stock.description as description,
	stock.mat_class as mat_class,
	CASE 
            	WHEN stock.location_restriction= '0' THEN stock.part_qty
            	ELSE null
	END  standard,
	CASE 
            	WHEN stock.location_restriction= '1' THEN stock.part_qty
            	ELSE null
	END  restricted,
	CASE 
            	WHEN stock.location_restriction= '2' THEN stock.part_qty
            	ELSE null
	END  inaccessible,
	stock.altpartno as altpartno,
	CASE 
            	WHEN stock.location_restriction_alt= '0' THEN stock.alt_qty 
            	ELSE null
	END  standard_alt,
	CASE 
            	WHEN stock.location_restriction_alt= '1' THEN stock.alt_qty 
            	ELSE null
	END  restricted_alt,
	CASE 
            	WHEN stock.location_restriction_alt= '2' THEN stock.alt_qty 
            	ELSE null
	END  inaccessible_alt
FROM  (
	SELECT distinct          		
		CASE WHEN REGEXP_LIKE(part.partno,'^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
		part.description as description,
		DECODE (
			part.mat_class,
			'C','Consumable',
			'E','Expendable',
			'R','Rotable',
			'S','Service'                		          
               		) as mat_class,
		CASE WHEN REGEXP_LIKE(alt_parts_cons.altpartno,'^[0-9]+$') THEN chr(39)||alt_parts_cons.altpartno ELSE alt_parts_cons.altpartno END as  altpartno,
		cons_stock_qty.part_qty as part_qty,
		alt_parts_cons.alt_qty as  alt_qty,
		alt_parts_cons.location_restriction_alt as location_restriction_alt,
		cons_stock_qty.location_restriction as location_restriction	
	FROM part  		
		LEFT JOIN (
			SELECT 			         
				part.partno,
				part_alternate.altpartno,
				SUM(consumables.qty) AS alt_qty,
				location.location_restriction as location_restriction_alt 			         
			FROM part 			         	
				JOIN part_alternate ON part_alternate.partno = part.partno 			         	
				LEFT JOIN consumables ON part_alternate.altpartno = consumables.partno 			         	
				LEFT JOIN location ON consumables.locationno_i = location.locationno_i  			         
			WHERE 1=1 			         	
				AND consumables.owner = 'AFL' 			         	
				AND consumables.condition &lt;&gt; 'US' 			         
			GROUP BY part.partno, part_alternate.altpartno, location.location_restriction               			     
             		) alt_parts_cons ON part.partno = alt_parts_cons.partno 		
		LEFT JOIN (
			SELECT 			        	 
				part.partno,
				SUM(consumables.qty) AS part_qty,
				location.location_restriction as location_restriction			         
			FROM part 			         	
				JOIN consumables on part.partno = consumables.partno 			         	
				JOIN location ON consumables.locationno_i = location.locationno_i  			         
			WHERE 1=1  			         	
                           		AND consumables.owner = 'AFL' 			         	
                           		AND consumables.condition &lt;&gt; 'US' 			         
			GROUP BY part.partno, location.location_restriction			     
			    ) cons_stock_qty ON part.partno = cons_stock_qty.partno 
	WHERE part.mat_class &lt;&gt;  'R' 
UNION 
	SELECT distinct 
 		CASE WHEN REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
 		part.description as description,
 		DECODE (
 			part.mat_class,
			 'C','Consumable',
			'E','Expendable',
			'R','Rotable',
			'S', 'Service'                 		
			) as mat_class,
 		alt_parts_rot.altpartno as altpartno,
 		rot_stock_qty.part_qty,
 		alt_parts_rot.alt_qty,
 		alt_parts_rot.location_restriction_alt as location_restriction_alt, 
 		rot_stock_qty.location_restriction as location_restriction
	FROM part  	
		LEFT JOIN (
                     		SELECT 		        	
				part.partno,
				part_alternate.altpartno,
				count(rotables.psn) AS alt_qty,
				location.location_restriction as location_restriction_alt 		        
                     		FROM part 		        	
                     			LEFT JOIN part_alternate ON part.partno = part_alternate.partno 			        
                     			LEFT JOIN rotables on part_alternate.altpartno = rotables.partno 			        
                     			LEFT JOIN location ON rotables.locationno_i = location.locationno_i  		        
                     		WHERE 1=1 			        
                     			AND rotables.owner = 'AFL' 			        
                     			AND rotables.condition &lt;&gt; 'US' 			        
                     		GROUP BY part.partno,part_alternate.altpartno, location.location_restriction          		        
                     		) alt_parts_rot ON part.partno = alt_parts_rot.partno 	
		LEFT JOIN (
                     		SELECT 		        
				part.partno,
				count(rotables.psn) AS part_qty,
				location.location_restriction as location_restriction		        
                     		FROM part 		        	
                     			LEFT JOIN rotables on part.partno = rotables.partno 			        
                     			LEFT JOIN location ON rotables.locationno_i = location.locationno_i  		        
                     		WHERE 1=1  		        	
                     			AND rotables.condition &lt;&gt; 'US' 		        	
                     			 AND rotables.owner = 'AFL' 		       
                     		GROUP BY part.partno, location.location_restriction  		
                     		) rot_stock_qty ON part.partno = rot_stock_qty.partno 
	WHERE part.mat_class not in ( 'C','E','S') 
) stock</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
