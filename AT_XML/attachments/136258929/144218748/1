        <ds:columnDescriptor amosType="ALPHANUM" description="case when wo_header_4.event_classification = 'H' then 'Heavy'&#10;        when wo_header_4.event_classification = 'L' then 'Line'&#10;        when wo_header_4.event_classification = 'B' then 'Base'&#10;        else ' '&#10; end as maint" id="maint"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when wo_header.mel_code = 'A' then 'M'&#10;        when wo_header.mel_code = 'B' then 'M'&#10;        when wo_header.mel_code = 'C' then 'M'&#10;        when wo_header.mel_code = 'D' then 'M'&#10;        when wo_header.mel_code = 'L' then 'M'&#10;        else ' '&#10; end as mel" id="mel"/>
