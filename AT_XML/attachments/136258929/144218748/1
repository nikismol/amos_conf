        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'dd.mm.yyyy') + (forecast.expected_date+729)'dd.mm.yyyy') AS wo_due_at" id="wo_due_at"/>
