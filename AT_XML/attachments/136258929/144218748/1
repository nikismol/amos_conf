      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select  wo_header.workorderno_display
,aircraft.ac_registr AS ac_registr
,aircraft.ac_typ AS ac_typ
,wo_header.event_perfno_i AS wo
,part.partno AS PN
,part.description AS part_descr
,part_request_2.qty
,TO_NUMBER(part.reord_level) AS reorder_lvl
,od_header.orderno AS orderno
,sh_header.awbno AS AWB
, case when forecast.sched_unsched = 'S' then 'SH'
            else 'US'
  end          as sched_unsched
, case when wo_header.hil = 'Y' then 'DD'
        else ' '
  end as hil
, case when wo_header_crx.aog_risk = 'Y' then 'A'
        else ' '
 end as aog
, case when wo_header.type = 'S' and wo_header.cannibalized = 'Y' then 'C'
        else ' '
 end as cannibalized
, case when wo_header_4.event_classification = 'H' then 'Heavy'
        when wo_header_4.event_classification = 'L' then 'Line'
        when wo_header_4.event_classification = 'B' then 'Base'
        else ' '
 end as maint
, case when wo_header.mel_code = 'A' then 'A'
        when wo_header.mel_code = 'B' then 'B'
        when wo_header.mel_code = 'C' then 'C'
        when wo_header.mel_code = 'D' then 'D'
        when wo_header.mel_code = 'L' then 'L'
        else ' '
 end as mel
,sh_header.shipmentno_i
,od_detail.vendor
,TO_CHAR(TO_DATE('01.01.1970', 'dd.mm.yyyy') + (forecast.expected_date+729),'dd.mm.yyyy') AS wo_due_at
from od_header
join od_detail on od_header.orderno_i = od_detail.orderno_i
join allocation_link on allocation_link.ref_type = 'ORDER_DE' and allocation_link.ref_key = od_detail.detailno_i
join part_request_2 on part_request_2.part_requestno_i = allocation_link.source_key and allocation_link.source_type = 'PARTRQST' 
join workstep_link on workstep_link.workstep_linkno_i = part_request_2.event_key and part_request_2.event_type = 'WSL'
join wo_header on workstep_link.event_perfno_i = wo_header.event_perfno_i
left join wo_header_4 on wo_header_4.event_perfno_i = wo_header.event_perfno_i
left join wo_header_crx on wo_header_crx.event_perfno_i = wo_header.event_perfno_i
join forecast on wo_header.event_perfno_i = forecast.event_perfno_i
left join sh_detail on od_detail.detailno_i = sh_detail.od_detailno_i
left join sh_header on sh_detail.shipmentno_i = sh_header.shipmentno_i
join aircraft on wo_header.ac_registr = aircraft.ac_registr and aircraft.status != 9
join part on part_request_2.partno = part.partno
where od_header.state = 'O'
        and od_header.order_type &lt;&gt; 'T'
        and (REGEXP_LIKE(aircraft.ac_typ, REPLACE( '@VAR.AC_TYP@', ', ', '|')) OR '@VAR.AC_TYP@' IS NULL)
        and (TO_CHAR(TO_DATE('01.01.1970', 'dd.mm.yyyy') + (forecast.expected_date+729),'dd.mm.yyyy') &lt;= (SYSDATE+7) AND (forecast.expected_date&gt;0))
ORDER BY forecast.expected_date</se:textStatement>
        </se:sqlStatement>
