      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
       TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (history.del_date), 'DD.MM.YYYY') as b_date, 
       voucher.description || ' - ' ||history.vm AS booking,
       history.partno,
       CASE 
	WHEN history.mat_class = 'R' OR history.serialno &lt;&gt; ' ' THEN history.serialno 
	ELSE history.batchno 
       END SN_BN,
       history.condition AS CO,
       history.ac_registr,
       history.qty,
       history.receiver AS ORD_REC,
       history.voucherno
FROM history
	JOIN entity_header ON history.entityno_i = entity_header.entityno_i
	JOIN (
		SELECT voucher_mode.description as description,
			voucher_mode.vm
		FROM voucher_mode
	        ) voucher ON  history.vm = voucher.vm
	JOIN aircraft ON   history.ac_registr =  aircraft.ac_registr
WHERE (history.partno ='@VAR.v01_partno@' OR '@VAR.v01_partno@' IS NULL)
	AND  (REGEXP_LIKE(history.serialno, REPLACE('@VAR.v02_serialno@', ', ', '|')) OR '@VAR.v02_serialno@' IS NULL)
	AND  (REGEXP_LIKE(history.batchno, REPLACE('@VAR.v03_batchno@', ', ', '|')) OR '@VAR.v03_batchno@' IS NULL)
	AND (aircraft.ac_typ = '@VAR.v04_ac_typ@' OR '@VAR.v04_ac_typ@' = 'ALL')
	AND  (history.ac_registr ='@VAR.v05_ac_registr@' OR '@VAR.v05_ac_registr@' IS NULL)
	AND  (history.vm='@VAR.v06_voucher_mo@' OR '@VAR.v06_voucher_mo@' IS NULL)
	AND  (history.del_date &gt;= '@VAR.v07_date_from@' OR '@VAR.v07_date_from@' IS NULL)
	AND (history.del_date &lt;= '@VAR.v08_date_to@'OR '@VAR.v08_date_to@' IS NULL)
ORDER BY history.del_date DESC</se:textStatement>
        </se:sqlStatement>
