      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT consumables.qty as qty,
       consumables.partno as partno,
       consumables.batchno as batchno,
       CASE WHEN (
                  SELECT inspection_detail.status
                  FROM inspection_detail
                  WHERE inspection_detail.inspection_detailno_i = (
                                                                   SELECT MAX (inspection_detail.inspection_detailno_i)
                                                                   FROM inspection_detail
                                                                   WHERE inspection_detail.ref_type = 'ST'
                                                                         AND inspection_detail.ref_key = consumables.storeno_i
                                                                  )
                 ) = 1 THEN 'Y' ELSE 'N' END as inspection,
       part.description as description,
       part.mat_class || CASE WHEN part.repairable = 'Y' THEN 'R' ELSE ' ' END as mat_class,
       part.tool as tool,
       location.station as station,
       location.store as store,
       location.location as location,
       CASE 
	WHEN consumables.expire_date &gt; 0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (consumables.expire_date+729), 'DD.MM.YYYY')
	ELSE NULL
       END expire_date,
       consumables.recdetailno_i as recdetailno_i,
       location.locationno_i as locationno_i,
       part.measure_unit as measure_unit,
       (
          SELECT COUNT (*)
          FROM pickslip_header
          JOIN pickslip_booked ON pickslip_header.pickslipno = pickslip_booked.pickslipno
          WHERE pickslip_header.state &lt;&gt; 'C'
                AND pickslip_booked.partno = consumables.partno
                AND pickslip_booked.batchno = consumables.batchno
                AND pickslip_booked.recdetailno_i = consumables.recdetailno_i
                AND pickslip_booked.expire_date = consumables.expire_date
       ) as ps,
       location.location_type as location_type,
       consumables.owner as owner,
       consumables.storeno_i as storeno_i,
       part.storetime as storetime,
       od_rec_detail.orderno as orderno
FROM location
JOIN consumables ON location.locationno_i = consumables.locationno_i
JOIN part ON part.partno = consumables.partno
LEFT JOIN od_rec_detail ON consumables.recdetailno_i=od_rec_detail.recdetailno_i
WHERE 
             (consumables.expire_date &gt; 0 
	   AND '@VAR.v03_NO_Expiry_Date_Materials_(Only)@'='N'
                   AND (consumables.expire_date &lt;= '@VAR.date_to@' OR '@VAR.date_to@' IS NULL)
                   AND (consumables.expire_date &gt;= '@VAR.date_from@' OR '@VAR.date_from@' IS NULL)
                   AND (consumables.condition IS NULL OR consumables.condition &lt;&gt; 'US')
 	  OR
                            '@VAR.v03_NO_Expiry_Date_Materials_(Only)@'='Y'
                    AND (consumables.expire_date IS NULL OR ASCII(consumables.expire_date) IN ('49824', '48')))
             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v01_Station@', ', ', '|')) OR '@VAR.v01_Station@' IS NULL)
             AND (REGEXP_LIKE(location.store, REPLACE('@VAR.v02_Store@', ', ', '|')) OR '@VAR.v02_Store@' IS NULL)
             AND (
           	part.tool NOT IN ('Y') AND '@VAR.tool@'='N'
       	   OR 
           	(part.tool LIKE ('%') OR part.tool IS NULL) AND '@VAR.tool@'='Y'
        	)
               AND (
           	part.mat_class='C' AND '@VAR.consumable@'='Y'
           	OR
          	 part.mat_class='E' AND '@VAR.expendable@'='Y'
          	)</se:textStatement>
        </se:sqlStatement>
