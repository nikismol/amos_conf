      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
history.partno,
history.serialno,
history.batchno,
spec,
history.qty,
history.created_date,
history.orderno,
od_header.vendor,
pickslipno,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (history.created_date+729),'dd.mm.yyyy') as dat,
voucher_mode.description

FROM history
LEFT JOIN od_header ON od_header.orderno = history.orderno
LEFT JOIN 
            (
                SELECT
                part_special.partno,
                LISTAGG(part_special.special, ';') WITHIN GROUP (order by part_special.partno ASC) as spec
                FROM part_special
                LEFT JOIN 
                                (  
                                SELECT 
                                partno 
                                FROM history 
                                GROUP BY partno
                                ) 
                                his ON his.partno = part_special.partno
                                    GROUP BY part_special.partno
            ) 
            special ON special.partno = history.partno
LEFT JOIN 
            (
            SELECT 
            COUNT(1),
            pickslipno,
            pickslipseqno_i
            FROM pickslip_booked
            GROUP BY pickslipseqno_i,pickslipno
            ) ps 
            ON ps.pickslipseqno_i = history.pickslipseqno_i
LEFT JOIN voucher_mode ON history.vm = voucher_mode.vm       
Where history.store = '1014'
and history.vm in ('B1', 'TR', 'YA')
and (REGEXP_LIKE(history.partno, REPLACE( '@VAR.PARTNO@', ', ', '|')) OR '@VAR.PARTNO@' IS NULL)
and (history.created_date &gt;= '@VAR.DATE_FROM@' OR '@VAR.DATE_FROM@' IS NULL)
and (history.created_date &lt;= '@VAR.DATE_TO@' OR '@VAR.DATE_TO@' IS NULL)
ORDER BY history.partno ASC</se:textStatement>
