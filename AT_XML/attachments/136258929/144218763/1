      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
       DECODE('@VAR.v07_use_part_list_from_tq76089@', 'Y', t.pos ,rownum) as rn,
       CASE WHEN '@VAR.v07_use_part_list_from_tq76089@' = 'Y' THEN NVL(part.partno, 'N/A') ELSE part.partno END as partno,
       t.partno as partno_tq76089,
       part.description as description,
       part.ac_typ as ac_typ,
       part.ata_chapter as ata_chapter,
       part.mat_class as mat_class
FROM part
FULL OUTER JOIN RAMAX_READ_ONLY.RMX_TMP_DATA_UPLOAD_tq76089 t ON part.partno = t.partno AND '@VAR.v07_use_part_list_from_tq76089@' = 'Y'
WHERE 1=1
      AND (
                 part.partno IN (
                                              SELECT t.v
                                              FROM (
                                                           SELECT column_value as v
                                                           FROM TABLE(amosserver_prod.string_splitter('@VAR.v06_partno_list@','line_feed'))
                                                          ) t
                                              WHERE t.v is not null
                                             )
