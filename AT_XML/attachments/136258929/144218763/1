             FROM od_header
             JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
             JOIN part_alternate ON od_detail.partno = part_alternate.altpartno AND part_alternate.type = 'A'
             WHERE 1=1
                           AND od_header.vendor NOT IN ('CLOSED')
                           AND od_header.order_type IN ('P')
                           AND od_header.ext_state in ('O', 'PR', 'D')
                           AND od_detail.ext_state in ('O', 'PR', 'D', 'PC')
                           AND part_alternate.partno = '@295_PSA_Main.partno@'
