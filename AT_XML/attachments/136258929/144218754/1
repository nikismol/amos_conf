    ,TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (sh_header.awbdate+729), 'dd.Mm.yyyy') as awbdate
from sh_header
join sh_detail on sh_header.shipmentno_i = sh_detail.shipmentno_i
join od_detail on sh_detail.od_detailno_i = od_detail.detailno_i
join od_header on od_detail.orderno_i = od_header.orderno_i
where od_header.orderno = '@order_info.od_header.orderno@'
and sh_header.type = 'EI'</se:textStatement>
        </se:sqlStatement>
