    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Check_Staff_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.user_sign as user_sign" id="user_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname as firstname" id="firstname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.lastname as lastname" id="lastname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.department as department" id="department"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="address.name as department_name" id="department_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.workgroup as workgroup" id="workgroup"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_department@">
          <ds:object>@VAR.v01_department@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select sign.user_sign as user_sign,
            sign.firstname as firstname,
            sign.lastname as lastname,
            sign.department as department, 
            address.name as department_name,
            case when ASCII(sign.workgroup) = 49824 then NULL else sign.workgroup end as workgroup
from sign
left join address ON sign.department = address.vendor
where 1=1
             and sign.department= '@VAR.v01_department@'
             /* and (ASCII(sign.workgroup) = 49824 OR sign.workgroup is null) */
             and sign.status&lt;&gt;9
ORDER BY workgroup NULLS FIRST, 1 </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
