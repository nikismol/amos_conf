          <ds:object>@AC_REG@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT rotables.ac_registr,
       rotables.partno,
       rotables.serialno,
       rotables.location,
       rotables.mfg_date,
       rotables.owner,
       rotables.del_date,
       rotables.date_inst,
       history.tam,
       history.tac,
       history.msn,
       history.csn,
       history.tsn_unknown,
       history.csn_unknown,
       history.mfg_unknown,
       rotables.condition,
       rotables.mod_status,
       rotables.processor 
FROM rotables, history 
WHERE (rotables.partno = history.partno) 
                  AND (rotables.serialno = history.serialno)
               AND (rotables.ac_registr = history.ac_registr)
             AND (rotables.ac_registr = '@AC_REG@')
           AND (history.vm = 'YE')
          AND (history.del_date = rotables.date_inst)
ORDER BY rotables.date_inst DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
