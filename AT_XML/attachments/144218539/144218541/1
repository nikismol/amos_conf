        <ds:columnDescriptor amosType="DATE" description="rotables.del_date" id="rotables.del_date"/>
        <ds:columnDescriptor amosType="DATE" description="rotables.date_inst" id="rotables.date_inst"/>
        <ds:columnDescriptor amosType="TIME" description="history.tam" id="history.tam"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.tac" id="history.tac"/>
        <ds:columnDescriptor amosType="TIME" description="history.msn" id="history.msn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.csn" id="history.csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.tsn_unknown" id="history.tsn_unknown"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.csn_unknown" id="history.csn_unknown"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.mfg_unknown" id="history.mfg_unknown"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.condition" id="rotables.condition"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.mod_status" id="rotables.mod_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.processor" id="rotables.processor"/>
