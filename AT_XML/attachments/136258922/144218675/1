      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT pr.taskcardno as taskcardno,
              pr.title as title,
             pr.ws_sequence as ws_sequence,
             pr.partno as partno,
             pr.qty as qty,
             pr.description as description,
             pr.mat_class as mat_class,
             pr.mat_type as mat_type,
             pr.mat_type_description as mat_type_description,
             pr.tool as tool,
             pr.measure_unit as measure_unit,
             alt_parts.altpartno as altpartno,
             CASE WHEN pr.mat_class = 'R' THEN r_stock.qty ELSE c_stock.qty END as stock_qty,
             CASE WHEN pr.mat_class = 'R' THEN r_stock_incl_alt.qty ELSE c_stock_incl_alt.qty END as alt_stock_qty,
             pr.section_code as section_code,
             th.threshold as threshold,
             i.interval as interval,
             eff.eff_time_rec as eff_time_rec,
             eff.ref as eff_ref,
             r.ref as ref,
th_FH.threshold as threshold_fh,
th_FC.threshold as threshold_fc,
th_DY.threshold as threshold_dy,
th_HRS.threshold as threshold_hrs,
th_MO.threshold as threshold_mo,
th_YE.threshold as threshold_ye,
th_AH.threshold as threshold_ah,
th_AC.threshold as threshold_ac,
th_SD.threshold as threshold_sd,
th_ID.threshold as threshold_id,

i_FH.interval as interval_fh,
i_FC.interval as interval_fc,
i_DY.interval as interval_dy,
i_HRS.interval as interval_hrs,
i_MO.interval as interval_mo,
i_YE.interval as interval_ye,
i_AH.interval as interval_ah,
i_AC.interval as interval_ac,
i_SD.interval as interval_sd,
i_ID.interval as interval_id,

ch.checks as checks

             
FROM (
                   select DISTINCT msc_taskcard.taskcardno as taskcardno
                              ,msc_taskcard_version.taskcard_verno_i
                              ,msc_taskcard.title as title
                              ,workstep_link.sequenceno as ws_sequence
                              ,part_request_template.partno as partno
                              ,TO_NUMBER(part_request_template.qty) as qty
                              ,part.description as description
                              ,part.mat_class as mat_class
                              ,mat_type.mat_type as mat_type
                              ,mat_type.description as mat_type_description
                              ,part.tool as tool
                              ,part.measure_unit as measure_unit
                              ,msc_section_code.section_code
                              
                   FROM msc_taskcard
                   JOIN msc_taskcard_version ON msc_taskcard.taskcardno_i = msc_taskcard_version.taskcardno_i
                   JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i
                   JOIN msc_mp_revision ON msc_mprev_taskcards.revisionno_i = msc_mp_revision.revisionno_i AND msc_mp_revision.revision_type='MP'
                                                                                                                                                                                            AND (msc_mp_revision.revision_status in ('a', 'b') AND '@VAR.v04_rev_status@' = 'a'
                                                                                                                                                                                                      OR 
                                                                                                                                                                                                      msc_mp_revision.revision_status in ('t') AND '@VAR.v04_rev_status@' = 't')
