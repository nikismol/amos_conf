      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    rotables.partno,
    rotables.serialno,
    history.ata_chapter,
    history.ac_registr,
    history.ac_typ,
    history.event_perfno_i,
    workstep_link.SEQUENCENO,
    rotables.condition,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (history.del_date), 'DD.MM.YYYY') as removal_date,
    history.LABELNO,
    wo_text_description.text,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (history.del_date), 'DD.MM.YYYY') AS mfg_date,
    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn)/60),'FM999999999900')) || ':'
        ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn),60)),'FM00') as TSN,
    history.csn,
    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi)/60),'FM999999999900')) || ':'
        ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi),60)),'FM00') as TBI,
    history.cbi,
    CASE WHEN '@VAR.v7_all_action@'='Y' THEN full_text.full_text
        ELSE wo_text_action.text
    END AS text_action
FROM rotables
LEFT JOIN (
    SELECT
        max(history.historyno_i) as historyno_i,
        history.psn,
        history.event_perfno_i,
        history.mbi,
        history.cbi,
        history.msn,
        history.csn,
        history.ac_registr,
        history.ata_chapter,
        history.del_date,
        history.ac_typ,
        history.labelno
    FROM history
    WHERE history.VM='YA'
    GROUP BY history.psn, history.event_perfno_i, history.mbi, history.cbi, history.msn,
             history.csn, history.ac_registr, history.ata_chapter, history.del_date, history.ac_typ,
             history.labelno
) history ON rotables.psn=history.psn
LEFT JOIN aircraft ON history.ac_registr=aircraft.ac_registr
LEFT JOIN wo_part_on_off ON history.event_perfno_i=wo_part_on_off.event_perfno_i AND history.labelno=wo_part_on_off.labelno
LEFT JOIN wo_text_action ON wo_part_on_off.actionno_i=wo_text_action.actionno_i
LEFT JOIN workstep_link ON wo_text_action.workstep_linkno_i=workstep_link.workstep_linkno_i
LEFT JOIN wo_text_description ON workstep_link.descno_i = wo_text_description.descno_i
LEFT JOIN (
    SELECT
        wo_text_action.workstep_linkno_i,
        RTRIM(XMLAGG(XMLELEMENT(E, wo_text_action.text, ' ;      ').EXTRACT('//text()')  ORDER BY wo_text_action.workstep_linkno_i).GetClobVal(), CHR(10)) as full_text
    FROM wo_text_action
    GROUP BY wo_text_action.workstep_linkno_i
) full_text ON workstep_link.workstep_linkno_i=full_text.workstep_linkno_i
WHERE (
    history.del_date &gt;= '@VAR.v1_start_date@'
        AND history.del_date &lt;= '@VAR.v2_end_date@'
    )
  AND (REGEXP_LIKE(history.ata_chapter, REPLACE('@VAR.v3_ata_chapter@', ', ', '|')) OR '@VAR.v3_ata_chapter@' IS NULL)
  AND (REGEXP_LIKE(history.ac_registr, REPLACE('@VAR.v4_ac_registr@', ', ', '|')) OR '@VAR.v4_ac_registr@' IS NULL)
  AND (
      (
          history.ac_typ='A32S' AND '@VAR.v5_ac_typ@'='A32S'
          )
          OR (
              history.ac_typ='A330' AND '@VAR.v5_ac_typ@'='A330'
              )
          OR (
              history.ac_typ='A350' AND '@VAR.v5_ac_typ@'='A350'
              )
          OR (
              history.ac_typ='B737' AND '@VAR.v5_ac_typ@'='B737'
              )
          OR (
              history.ac_typ='B777' AND '@VAR.v5_ac_typ@'='B777'
              )
          OR (
              history.ac_typ IN ('A32S','A330','A350', 'B737', 'B777') AND '@VAR.v5_ac_typ@'='ALL'
              )
    )
  AND (REGEXP_LIKE(rotables.partno, REPLACE('@VAR.v6_part@', ', ', '|')) OR '@VAR.v6_part@' IS NULL)
    AND rotables.locationno_i&lt;&gt;-1</se:textStatement>
        </se:sqlStatement>
