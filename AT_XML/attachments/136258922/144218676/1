      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno as taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.title as title" id="title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link.sequenceno as ws_sequence" id="ws_sequence"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_template.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(part_request_template.qty) as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.mat_class as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mat_type.mat_type as mat_type" id="mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mat_type.description as mat_type_description" id="mat_type_description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.tool as tool" id="tool"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.measure_unit as measure_unit" id="measure_unit"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_mpno_i@">
          <ds:object>@VAR.v01_mpno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_taskcardno@">
          <ds:object>@VAR.v02_taskcardno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_delimeter@">
          <ds:object>@VAR.v03_delimeter@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select DISTINCT msc_taskcard.taskcardno as taskcardno
           ,msc_taskcard.title as title
           ,workstep_link.sequenceno as ws_sequence
           ,part_request_template.partno as partno
           ,TO_NUMBER(part_request_template.qty) as qty
           ,part.description as description
           ,part.mat_class as mat_class
           ,mat_type.mat_type as mat_type
           ,mat_type.description as mat_type_description
           ,part.tool as tool
           ,part.measure_unit as measure_unit
FROM msc_taskcard
JOIN msc_taskcard_version ON msc_taskcard.taskcardno_i = msc_taskcard_version.taskcardno_i
JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i
JOIN msc_mp_revision ON msc_mprev_taskcards.revisionno_i = msc_mp_revision.revisionno_i AND  msc_mp_revision.revision_status IN ('a','b')
JOIN msc_mp_issue ON msc_mp_revision.issueno_i = msc_mp_issue.issueno_i
JOIN msc_maintenance_program ON msc_mp_issue.mpno_i = msc_maintenance_program.mpno_i
                                                                   AND msc_taskcard.mpno_i=msc_maintenance_program.mpno_i
                                                                   AND msc_maintenance_program.program_type='MP'
                                                                   AND msc_maintenance_program.mpno_i=@VAR.v01_mpno_i@
JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
JOIN msc_requirement_tc_link ON msc_item.itemno_i=msc_requirement_tc_link.itemno_i_mri
JOIN requirement_header ON msc_requirement_tc_link.itemno_i_mri=requirement_header.event_key AND requirement_header.event_type = 'TI'
JOIN worktemplate_link ON worktemplate_link.event_key = requirement_header.requirement_headerno_i AND worktemplate_link.event_type = 'REQH'
JOIN work_template ON worktemplate_link.wtno_i=work_template.wtno_i
JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i AND event_template.revision_status=1
JOIN workstep_link ON event_template.event_perfno_i = workstep_link.event_perfno_i
LEFT JOIN part_request_template ON workstep_link.descno_i = part_request_template.event_key AND part_request_template.event_type = 'WS' AND part_request_template.partno IS NOT NULL
LEFT JOIN part on part_request_template.partno=part.partno
LEFT JOIN mat_type on part.mat_type=mat_type.mat_type
WHERE 1=1
               AND msc_taskcard.taskcardno IN (
                                                                                SELECT t.v
                                                                                FROM (
                                                                                             SELECT column_value as v
                                                                                             FROM TABLE(amosserver_prod.string_splitter('@VAR.v02_taskcardno@','@VAR.v03_delimeter@'))
                                                                                            ) t
                                                                                WHERE t.v is not null
                                                                               )
ORDER BY 1, 3, 4</se:textStatement>
        </se:sqlStatement>
