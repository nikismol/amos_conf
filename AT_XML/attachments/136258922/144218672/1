          <ds:object>@VAR.excl_llp@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT mts.psn as psn
FROM (
             SELECT rotables.psn
             FROM history, rotables  
             WHERE 1=1
                            AND ('@VAR.partno@' IS NOT NULL OR  '@VAR.serialno@' IS NOT NULL)
                            AND (REGEXP_LIKE(history.partno, REPLACE('@VAR.partno@', ', ', '|')) OR '@VAR.partno@' IS NULL)
                            AND (REGEXP_LIKE(history.serialno, REPLACE('@VAR.serialno@', ', ', '|')) OR '@VAR.serialno@' IS NULL)
                            AND rotables.ac_registr IS NOT NULL
                            AND history.psn=rotables.psn
             /* for rotables (not assembly) on A/C */
             
             UNION
             
             SELECT tree.psn
             FROM (
                          SELECT CONNECT_BY_ROOT r_tree.partno as root_pn,
                                         CONNECT_BY_ROOT r_tree.serialno as root_sn,
                                         CONNECT_BY_ROOT r_tree.psn as root_psn,
                                         LEVEL,
                                         r_tree.psn,
                                         r_tree.partno,
                                         r_tree.serialno,
                                         r_tree.partnonew,
                                         r_tree.serialnonew
                          FROM (
                                       SELECT r.psn,
                                                     r_parent.psn as parent_psn,
                                                     r.partno,
                                                     r.serialno,
                                                     r.partnonew,
                                                     r.serialnonew
                                       FROM rotables r
                                       LEFT JOIN rotables r_parent ON r.partnonew=r_parent.partno AND r.serialnonew=r_parent.serialno
                                       WHERE r.partnonew IS NOT NULL AND r.serialnonew IS NOT NULL AND ASCII(r.partnonew)!=49824 AND ASCII(r.serialnonew)!=49824
             
                                       UNION 
             
                                       SELECT r.psn,
                                                     NULL as parent_psn,
                                                     r.partno,
                                                     r.serialno,
                                                     r.partnonew,
                                                     r.serialnonew
                                       FROM rotables r
                                       WHERE r.partnonew IS NULL AND r.serialnonew IS NULL OR ASCII(r.partnonew)=49824 AND ASCII(r.serialnonew)=49824
                                      ) r_tree
                          START WITH r_tree.parent_psn IN (
                                                                                           SELECT rotables.psn
                                                                                           FROM rotables
                                                                                           WHERE rotables.ac_registr IS NOT NULL
                                                                                                          AND ('@VAR.high_partno@' IS NOT NULL OR  '@VAR.high_serialno@' IS NOT NULL)
                                                                                                          AND (REGEXP_LIKE(rotables.partno, REPLACE('@VAR.high_partno@', ', ', '|')) OR '@VAR.high_partno@' IS NULL)
                                                                                             AND (REGEXP_LIKE(rotables.serialno, REPLACE('@VAR.high_serialno@', ', ', '|')) OR '@VAR.high_serialno@' IS NULL)
                                                                                          )
                          CONNECT BY NOCYCLE PRIOR r_tree.psn=r_tree.parent_psn
                        ) tree
             WHERE ('@VAR.high_partno@' IS NOT NULL OR  '@VAR.high_serialno@' IS NOT NULL)
                            AND '@VAR.partno@' IS NULL
                            AND '@VAR.serialno@' IS NULL
             /* for assembly on A/C */
             
             UNION
             
             SELECT mh.psn
             FROM (
                          SELECT history.psn,
                                         history.historyno_i,
                                         MAX (history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i
                          FROM history
                          LEFT JOIN rotables ON history.psn=rotables.psn AND rotables.ac_registr IS NULL
                          WHERE history.vm='YA'
                                         AND ('@VAR.partno@' IS NOT NULL OR  '@VAR.serialno@' IS NOT NULL)
                                         AND (REGEXP_LIKE(history.partno, REPLACE('@VAR.partno@', ', ', '|')) OR '@VAR.partno@' IS NULL)
                                         AND (REGEXP_LIKE(history.serialno, REPLACE('@VAR.serialno@', ', ', '|')) OR '@VAR.serialno@' IS NULL)
                         ) mh
              WHERE mh.historyno_i=mh.max_historyno_i
             /* for rotables (not assembly) NOT on A/C */
             
             UNION
             
             SELECT 
                            h_tree_ya.psn as psn
             FROM (
                          SELECT history.psn,
                                         history.historyno_i,
                                         MAX (history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i,
                                         history.voucherno
                          FROM history
                          LEFT JOIN rotables ON history.psn=rotables.psn 
                          WHERE history.vm='YA'
                                         AND rotables.ac_registr IS NULL
                                         AND ('@VAR.high_partno@' IS NOT NULL OR  '@VAR.high_serialno@' IS NOT NULL)
                                         AND (REGEXP_LIKE(history.partno, REPLACE('@VAR.high_partno@', ', ', '|')) OR '@VAR.high_partno@' IS NULL)
                                         AND (REGEXP_LIKE(history.serialno, REPLACE('@VAR.high_serialno@', ', ', '|')) OR '@VAR.high_serialno@' IS NULL)
                         ) max_h
             LEFT JOIN history h_tree_ya ON max_h.voucherno=h_tree_ya.voucherno AND h_tree_ya.vm='YA' AND h_tree_ya.psn&lt;&gt;max_h.psn
             LEFT JOIN (
                                 SELECT history.psn,
                                               h_parent.psn as parent_psn,
                                               history.partno,
                                               history.serialno,
                                               history.higher_partno,
                                               history.higher_serialno
                                 FROM history
                                 LEFT JOIN history h_parent ON history.higher_partno=h_parent.partno AND history.higher_serialno=h_parent.serialno
                                 WHERE history.higher_partno IS NOT NULL AND history.higher_serialno IS NOT NULL AND ASCII(history.higher_partno)!=49824 AND ASCII(history.higher_serialno)!=49824
                                 ORDER BY parent_psn
                                ) h_tree ON h_tree_ya.psn=h_tree.psn
             WHERE max_h.historyno_i=max_h.max_historyno_i
                            AND '@VAR.partno@' IS NULL
                            AND '@VAR.serialno@' IS NULL
             START WITH h_tree.parent_psn=max_h.psn
             CONNECT BY NOCYCLE PRIOR h_tree.psn=h_tree.parent_psn
             /* for assembly NOT on A/C */
            ) mts
LEFT JOIN (
                    SELECT DISTINCT history.psn,
                                   forecast.requirement 
                    FROM history
	     LEFT JOIN rotables ON history.psn=rotables.psn
                    LEFT JOIN forecast ON rotables.serialno = forecast.serialno AND forecast.partno = rotables.partno
                    WHERE forecast.requirement = 'LL'
                   ) llp ON mts.psn = llp.psn
WHERE (llp.requirement ='LL' AND '@VAR.excl_llp@'='Y') OR '@VAR.excl_llp@'='N'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
