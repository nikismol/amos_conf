        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;              CASE WHEN NVL(rotables.locationno_i 999) = -1 THEN CASE WHEN oh_at_tsn_unknown='N'&#10;                                                                                                                       THEN TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value-rotables.oh_at_msn)/60)'FM999999999900')) || ':' ||&#10;                                                                                                                                  TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value-rotables.oh_at_msn)60))'FM00')&#10;                                                                                                                       ELSE 'UNKNOWN' END  &#10;                        WHEN NVL(rotables.locationno_i 999) NOT IN (-1 999) THEN CASE WHEN oh_at_tsn_unknown='N'&#10;                                                                                                                                            THEN TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_h.life_value-rotables.oh_at_msn)/60)'FM999999999900')) || ':' ||&#10;                                                                                                                                                       TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_h.life_value-rotables.oh_at_msn)60))'FM00')&#10;                                                                                                                                            ELSE 'UNKNOWN' END&#10;                        WHEN NVL(rotables.locationno_i999) = 999 THEN max_since_oh.cso&#10;                        ELSE ''&#10;              END ||' H' as current_tso" id="current_tso"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;              CASE WHEN NVL(rotables.locationno_i 999) = -1 THEN CASE WHEN oh_at_csn_unknown='N'&#10;                                                                                                                       THEN TO_CHAR(TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on+counter_c.life_value-rotables.oh_at_csn))&#10;                                                                                                                       ELSE 'UNKNOWN' END  &#10;                        WHEN NVL(rotables.locationno_i 999) NOT IN (-1 999) THEN CASE WHEN oh_at_csn_unknown='N'&#10;                                                                                                                                            THEN TO_CHAR(TO_NUMBER(counter_c.life_value-rotables.oh_at_csn))&#10;                                                                                                                                            ELSE 'UNKNOWN' END&#10;                        WHEN NVL(rotables.locationno_i999) = 999 THEN max_since_oh.cso&#10;                        ELSE ''&#10;              END ||' C' as current_cso" id="current_cso"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@PSN_LIST.psn@">
          <ds:object>@PSN_LIST.psn@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.vm@">
          <ds:object>@VAR.vm@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT part.description as description,
              CASE WHEN history.vm IN ('YE', 'ME') OR history.vm IN ('MO', 'SW', 'PN') AND history.qty&lt;0
                        THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (history.del_date+729), 'dd-Mon-yyyy', 'NLS_DATE_LANGUAGE = ENGLISH') ELSE '' END as pn_date_on,
              CASE WHEN history.vm IN ('YA', 'MA') OR history.vm IN ('MO', 'SW', 'PN') AND history.qty&gt;0
                        THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (history.del_date+729), 'dd-Mon-yyyy', 'NLS_DATE_LANGUAGE = ENGLISH') ELSE '' END as pn_date_off,
              history.reason||' ('||history.vm||')' as reason,
              history.partno as partno,
              history.serialno as serialno,
              CASE WHEN history.tsn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(msn)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(msn),60)),'FM00') END as tsn,
              CASE WHEN history.csn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(history.csn) END as csn,
              CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.partnonew ELSE history.higher_partno END as higher_partno,
              CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.serialnonew ELSE history.higher_serialno END as higher_serialno,
              since_oh.tso as tso,
              since_oh.cso as cso,
              TO_CHAR(aircraft.ac_model)||CASE WHEN aircraft.ac_subtype IS NULL OR ASCII(aircraft.ac_subtype)=49824 THEN '' ELSE '-'||TO_CHAR(aircraft.ac_subtype) END as model,
              aircraft.serialno as msn,
              TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.tam)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.tam),60)),'FM00') as tah_ac,
              history.tac as tac_ac,
              CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.location ELSE history.location END as pos,
              '' as endorsement,
              aircraft.ac_registr as ac_registr,
              aircraft.ac_typ as ac_typ,
              ac_rat.ac_rating as wv,
              history.del_date,
              CASE WHEN history.event_perfno_i&gt;0  AND (history.vm IN ('ME') OR history.vm IN ('MO') AND history.qty&gt;0)
                         THEN mod_doc.docno
                         WHEN (history.event_perfno_i IS NULL OR history.event_perfno_i=0)
                                      AND (history.vm IN ('ME') OR history.vm IN ('MO') AND history.qty&gt;0)
                                      AND history.partno=mod_doc_h.comp_partno
                                      AND history.serialno=mod_doc_h.comp_serialno
                         THEN mod_doc_h.docno
                         ELSE '' END as docno,
              history.historyno_i,

              CASE WHEN counter_h.is_unknown = 'Y' THEN 'Unknown'
                        ELSE (TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value)/60),'FM999999999900')) || ':' ||
                                 TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value),60)),'FM00') ||'H')
              END as current_tsn,

              CASE WHEN counter_c.is_unknown = 'Y' THEN 'Unknown'
                        ELSE (TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on+counter_c.life_value)||'C')
              END as current_csn,

              CASE WHEN NVL(rotables.locationno_i, 999) IN (-1, -4) AND NVL(ASCII(rotables.ac_registr), 999) NOT IN (49824, 999)
                        THEN CASE WHEN rotables.oh_at_tsn_unknown='N'
                                            THEN TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value-rotables.oh_at_msn)/60),'FM999999999900')) || ':' ||
                                                      TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value-rotables.oh_at_msn),60)),'FM00')
                                            ELSE 'UNKNOWN'
                                   END
                        WHEN NVL(rotables.locationno_i, 999) NOT IN (-1, -4, 999) AND NVL(ASCII(rotables.ac_registr), 999) IN (49824, 999)
                        THEN CASE WHEN rotables.oh_at_tsn_unknown='N'
                                            THEN TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_h.life_value-rotables.oh_at_msn)/60),'FM999999999900')) || ':' ||
                                                      TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_h.life_value-rotables.oh_at_msn),60)),'FM00')
                                            ELSE 'UNKNOWN'
                                  END
                        WHEN NVL(rotables.locationno_i, 999) = 999 AND NVL(rotables.ac_registr,999) = 999 THEN max_since_oh.cso
                        ELSE ''
              END ||'H' as current_tso,

              CASE WHEN NVL(rotables.locationno_i, 999) IN (-1, -4) AND NVL(ASCII(rotables.ac_registr), 999) NOT IN (49824, 999)
                        THEN CASE WHEN rotables.oh_at_csn_unknown='N'
                                            THEN TO_CHAR(TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on+counter_c.life_value-rotables.oh_at_csn))
                                            ELSE 'UNKNOWN'
                                  END  
                        WHEN NVL(rotables.locationno_i, 999) NOT IN (-1, -4, 999) AND NVL(ASCII(rotables.ac_registr), 999) IN (49824, 999)
                        THEN CASE WHEN rotables.oh_at_csn_unknown='N'
                                            THEN TO_CHAR(TO_NUMBER(counter_c.life_value-rotables.oh_at_csn))
                                  ELSE 'UNKNOWN' END
                        WHEN NVL(rotables.locationno_i, 999) = 999 AND NVL(rotables.ac_registr,999) = 999 THEN max_since_oh.cso
                        ELSE ''
              END ||'C' as current_cso
FROM history
LEFT JOIN part ON history.partno = part.partno
LEFT JOIN rotables ON history.psn = rotables.psn

/* current tsn_csn */
LEFT JOIN (
                   SELECT 
                          DISTINCT counter.ref_key,
                          counter.counterno_i,
                          counter.is_unknown AS is_unknown,
                          counter.master_counterno_i,
                          max_counter_value.on_counter_valueno_i,
                          counter_definition.code,
                          NVL(max_counter_value.life_value, 0) as life_value,
                          NVL(counter_value_on.life_value, 0) as life_value_on
                   FROM 
                          counter
                   JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                   JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                   LEFT JOIN (
                                      SELECT 
                                             counter_value.counter_valueno_i as counter_valueno_i,
                                             counter_value.counterno_i as counterno_i,
                                             counter_value.on_counter_valueno_i,
                                             MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                             counter_value.readout_date*86400000+counter_value.readout_time as readout,
                                             counter_value.life_value as life_value,
                                             counter_definition.counter_defno_i
                                      FROM counter
                                      JOIN counter_value ON counter_value.counterno_i=counter.counterno_i
                                      JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                      JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                      WHERE 1=1
                                             AND counter.ref_type='RO'
                                             AND counter.ref_key= @PSN_LIST.psn@  
                                             AND counter_definition.counter_defno_i='1'
                                             AND counter_value.on_counter_valueno_i IS NOT NULL
                                      ORDER BY
                                             counter_value.counterno_i
                                     ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
                   LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
                   WHERE 1=1
                          AND counter.ref_type='RO'
                          AND counter.ref_key= @PSN_LIST.psn@
                          AND counter_definition.counter_defno_i='1'
                          AND max_counter_value.readout=max_counter_value.max_readout
                  ) counter_h ON rotables.psn=counter_h.ref_key 
LEFT JOIN counter counter_m_h ON counter_h.master_counterno_i=counter_m_h.counterno_i
LEFT JOIN (
                   SELECT 
                          max_counter_value.counterno_i as counterno_i,
                          max_counter_value.counter_valueno_i as counter_valueno_i,
                          NVL(max_counter_value.life_value, 0) as life_value
                   FROM (
                                SELECT 
                                       counter_value.counter_valueno_i as counter_valueno_i,
                                       counter_value.counterno_i as counterno_i,
                                       MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                       counter_value.readout_date*86400000+counter_value.readout_time as readout,
                                       counter_value.life_value as life_value,
                                       counter_definition.counter_defno_i
                                FROM
                                       counter_value
                                LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
                                LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                WHERE
                                       counter_definition.counter_defno_i='1'
                                       AND counter_value.readout_ref_type!='LB'
                                ORDER BY
                                       counter_value.counterno_i
                               ) max_counter_value
                   WHERE
                          max_counter_value.readout=max_counter_value.max_readout
                  ) counter_value_m_h ON counter_m_h.counterno_i=counter_value_m_h.counterno_i
LEFT JOIN (
                   SELECT
                          DISTINCT (counter.ref_key),
                          counter.counterno_i,
                          counter.is_unknown AS is_unknown,
                          counter.master_counterno_i,
                          max_counter_value.on_counter_valueno_i,
                          counter_definition.code,
                          NVL(max_counter_value.life_value, 0) as life_value,
                          NVL(counter_value_on.life_value, 0) as life_value_on
                   FROM 
                          counter
                   JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                   JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                   LEFT JOIN (
                                      SELECT
                                              counter_value.counter_valueno_i as counter_valueno_i,
                                              counter_value.counterno_i as counterno_i,
                                              counter_value.on_counter_valueno_i,
                                              MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                              counter_value.readout_date*86400000+counter_value.readout_time as readout,
                                              counter_value.life_value as life_value,
                                              counter_definition.counter_defno_i
                                      FROM
                                              counter
                                      JOIN counter_value ON counter_value.counterno_i=counter.counterno_i
                                      JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                      JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                      WHERE 1=1
                                                     AND counter.ref_type='RO'
                                                     AND counter.ref_key= @PSN_LIST.psn@ 
                                                     AND counter_definition.counter_defno_i='2'
                                                     AND counter_value.on_counter_valueno_i IS NOT NULL
                                      ORDER BY
                                              counter_value.counterno_i
                                     ) max_counter_value ON counter.counterno_i=max_counter_value.counterno_i
                   LEFT JOIN counter_value counter_value_on ON max_counter_value.on_counter_valueno_i=counter_value_on.counter_valueno_i
                   WHERE 1=1
                          AND counter.ref_type='RO'
                          AND counter.ref_key= @PSN_LIST.psn@  
                          AND counter_definition.counter_defno_i='2'
                          AND max_counter_value.readout=max_counter_value.max_readout
                  ) counter_c ON rotables.psn=counter_c.ref_key 
LEFT JOIN counter counter_m_c ON counter_c.master_counterno_i=counter_m_c.counterno_i
LEFT JOIN (
                   SELECT 
                          max_counter_value.counterno_i as counterno_i,
                          max_counter_value.counter_valueno_i as counter_valueno_i,
                          NVL(max_counter_value.life_value, 0) as life_value
                   FROM (
                                SELECT
                                       counter_value.counter_valueno_i as counter_valueno_i,
                                       counter_value.counterno_i as counterno_i,
                                       MAX (counter_value.readout_date*86400000+counter_value.readout_time) OVER (PARTITION BY counter_value.counterno_i)  as max_readout,
                                       counter_value.readout_date*86400000+counter_value.readout_time as readout,
                                       counter_value.life_value as life_value,
                                       counter_definition.counter_defno_i
                                FROM 
                                       counter_value
                                LEFT JOIN counter ON counter_value.counterno_i=counter.counterno_i
                                LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                WHERE
                                       counter_definition.counter_defno_i='2'
                                       AND counter_value.readout_ref_type!='LB'
                                ORDER BY
                                       counter_value.counterno_i
                               ) max_counter_value
                   WHERE
                          max_counter_value.readout=max_counter_value.max_readout
                  ) counter_value_m_c ON counter_m_c.counterno_i=counter_value_m_c.counterno_i
LEFT JOIN aircraft ON aircraft.ac_registr=history.ac_registr
LEFT JOIN (
                   SELECT
                               ac_rating.ac_rating as ac_rating,
                               rating_assignment.ref_key
                   FROM 
                               ac_rating
                   JOIN rating_assignment ON ac_rating.ac_ratingno_i = rating_assignment.ratingno_i AND rating_assignment.ref_type = 'AC_INT'
                   JOIN ac_rating_category ON ac_rating.ac_rating_categoryno_i = ac_rating_category.ac_rating_categoryno_i AND ac_rating_category.code='WHT'
                   ) ac_rat ON aircraft.aircraftno_i = ac_rat.ref_key
LEFT JOIN (
                    SELECT wo_event_link.event_perfno_i,
                                  doc_header.docno
                    FROM wo_event_link
                    LEFT JOIN doc_header ON wo_event_link.event_key_parent=doc_header.docno_i
                    WHERE wo_event_link.event_type in ('DOC_EFF', 'MED') /* DOC_EFF - можно убрать после обновления на 21.6 */
                                   AND doc_header.ac_or_comp_doc='C'
                  ) mod_doc ON mod_doc.event_perfno_i=history.event_perfno_i
LEFT JOIN (
                   SELECT wo_header.psn,
                                wo_header.comp_partno,
                                wo_header.comp_serialno,
                                doc_header.docno
                   FROM wo_header
                   LEFT JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i
                   LEFT JOIN doc_header ON wo_event_link.event_key_parent=doc_header.docno_i
                   LEFT JOIN event_effectivity_mapping ON event_effectivity_mapping.event_key_parent = doc_header.docno_i 
                   WHERE wo_event_link.event_type in ('DOC_EFF', 'MED') /* DOC_EFF - можно убрать после обновления на 21.6 */
                                AND wo_event_link.pending_status = 0
                                AND doc_header.ac_or_comp_doc = 'C'
                                AND doc_header.release_state &lt;&gt; 'I'
                                AND event_effectivity_mapping.event_type = 'EFL' 
                                AND event_effectivity_mapping.psn = wo_header.psn 
                                AND event_effectivity_mapping.affected = 'Y'
                                AND wo_header.psn=@PSN_LIST.psn@
                  ) mod_doc_h ON history.psn=mod_doc_h.psn
LEFT JOIN (
                    SELECT
                            oh.historyno_i,
                            CASE WHEN oh.tsn_unknown='Y' OR oh.oh_tsn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(oh.msn - NVL(oh.msn_oh, 0))/60),'FM999999999900')) || ':' 
                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(oh.msn - NVL(oh.msn_oh, 0)),60)),'FM00') END as tso,
                            CASE WHEN oh.csn_unknown='Y' OR oh.oh_csn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_NUMBER(oh.csn - NVL(oh.csn_oh, 0))) END as cso
                    FROM (
                                 SELECT 
                                         h.historyno_i,
                                         h_rec.historyno_i as historyno_i_oh,                                          
                                         MAX(h_rec.historyno_i) OVER (PARTITION BY h.historyno_i) as last_historyno_i_oh,
                                         h.msn,
                                         h.csn,
                                         h_rec.msn as msn_oh,
                                         h_rec.csn as csn_oh,
                                         h.tsn_unknown,
                                         h.csn_unknown,
                                         h_rec.tsn_unknown as oh_tsn_unknown,
                                         h_rec.csn_unknown as oh_csn_unknown 
                                 FROM history h
                                 JOIN history h_rec ON h.psn=h_rec.psn AND h_rec.vm='B1' AND h_rec.condition='OH'
                                 WHERE REGEXP_LIKE(h.vm, REPLACE('@VAR.vm@', ', ', '|'))
                                              AND h_rec.historyno_i&lt;h.historyno_i 
                                ) oh
                    WHERE oh.last_historyno_i_oh=oh.historyno_i_oh
                  ) since_oh ON history.historyno_i=since_oh.historyno_i
LEFT JOIN (
                    SELECT
                            oh.historyno_i,
                            CASE WHEN oh.tsn_unknown='Y' OR oh.oh_tsn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(CEIL(TO_NUMBER(oh.msn - NVL(oh.msn_oh, 0))/60)) END as tso,
                            CASE WHEN oh.csn_unknown='Y' OR oh.oh_csn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_NUMBER(oh.csn - NVL(oh.csn_oh, 0))) END as cso
                    FROM (
                                 SELECT 
                                         h.historyno_i,
                                         MAX(h.historyno_i) OVER (PARTITION BY h.historyno_i) as max_historyno_i,
                                         h_rec.historyno_i as historyno_i_oh,                                          
                                         MAX(h_rec.historyno_i) OVER (PARTITION BY h.historyno_i) as last_historyno_i_oh,
                                         h.msn,
                                         h.csn,
                                         h_rec.msn as msn_oh,
                                         h_rec.csn as csn_oh,
                                         h.tsn_unknown,
                                         h.csn_unknown,
                                         h_rec.tsn_unknown as oh_tsn_unknown,
                                         h_rec.csn_unknown as oh_csn_unknown 
                                 FROM history h
                                 JOIN history h_rec ON h.psn=h_rec.psn AND h_rec.vm='B1' AND h_rec.condition='OH'
                                 WHERE REGEXP_LIKE(h.vm, REPLACE('@VAR.vm@', ', ', '|'))
                                              AND h_rec.historyno_i&lt;h.historyno_i 
                                ) oh
                    WHERE oh.last_historyno_i_oh=oh.historyno_i_oh
                                  AND oh.historyno_i=oh.max_historyno_i
                  ) max_since_oh ON history.historyno_i=max_since_oh.historyno_i
LEFT JOIN   (
                	SELECT  history.del_date,
                        	        history.psn
                	FROM     history
                	WHERE history.vm = 'YA'
                                              AND history.psn=@PSN_LIST.psn@
            ) h2 ON history.psn = h2.psn AND history.del_date &lt; h2.del_date 
WHERE history.psn=@PSN_LIST.psn@
               AND REGEXP_LIKE(history.vm, REPLACE('@VAR.vm@', ', ', '|'))
ORDER BY history.historyno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
