    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="290_CHECK_WD_LINK_Events" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN wo_header.workorderno_display IS NULL THEN 'TC' ELSE 'WO' END as object_type" id="object_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              NVL(TO_CHAR(wo_header.workorderno_display)msc_taskcard.taskcardno)  as objectno" id="objectno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              DECODE(wo_header.type 'M' 'Maint.' 'S' 'Sched.' 'C' 'Cabin' 'P' 'Pirep' DECODE(msc_requirement_tc_link.type 'S' 'SRT' 'O' 'On Demand TC' 'B' 'BTC' 'R' 'Rotable Controlled' 'Taskcard Controlled' 'C' 'Check Controlled' 'D' 'Document Controlled''')) as type" id="type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.state as state" id="state"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@290_CHECK_WD_LINKS_Main.linkno_i@">
          <ds:object>@290_CHECK_WD_LINKS_Main.linkno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ac_typ,
              ac_registr,
              event_perfno_i,
              object_type,
              objectno,
              type,
              state
FROM (
SELECT aircraft.ac_typ as ac_typ,
              wo_header.ac_registr as ac_registr,
              wo_header.event_perfno_i as event_perfno_i,
              'WO' as object_type,
              TO_CHAR(wo_header.workorderno_display) as objectno,
              DECODE(wo_header.type,
                               'M', 'Maint.',
                               'C', 'Cabin',
                               'P', 'Pirep',
                               'S', 'Sched. (' || DECODE (wo_header.event_type,
                                                                             'D', 'Document',
                                                                             'R', 'Rotable Requirement',
                                                                             'C', 'Check',
                                                                             'T', 'Block Taskcard',
                                                                             'Q', 'Single Running / On Demand Taskcard',
                                                                             'V', 'Replacement Event',
                                                                             'E', 'Change Order',
                                                                             'O', 'Event Tracking WO', 
                                                                             'SV', 'Shop Visit WO',
                                                                             'SC', 'Sim. Complaint WO', 
                                                                             'W', 'Finding WO',
                                                                             'I', 'Import WO',
                                                                             'P', 'Panel Workorder',
                                                                             'J', 'JIC Workorder',
                                                                             'TW', 'Unlinked Work Template',
                                                                             'JC', 'Jobcard',
                                                                             'CD', 'Customer Requirement - Document',
                                                                             'CC', 'Customer Requirement - Check',
                                                                             'CT', 'Customer Requirement - Task',
                                                                             'CP', 'Customer Requirement - Part',
                                                                             ''
                                                                            )|| ')',
                               '') as type,
              wo_header.state as state
FROM (
             SELECT workstep_link.event_perfno_i
             FROM workstep_link
             JOIN db_link ON TO_NUMBER(db_link.source_pk) = workstep_link.descno_i AND db_link.source_type = 'WS' AND workstep_link.event_perfno_i &gt; 0
             WHERE 1=1
                            AND db_link.linkno_i = @290_CHECK_WD_LINKS_Main.linkno_i@

             UNION

             SELECT TO_NUMBER(db_link.source_pk) as event_perfno_i
             FROM db_link 
             WHERE 1=1
                           AND TO_NUMBER(db_link.source_pk)&gt;0
                           AND db_link.linkno_i = @290_CHECK_WD_LINKS_Main.linkno_i@
                           AND db_link.source_type = 'WO'
            ) ev
JOIN wo_header ON ev.event_perfno_i = wo_header.event_perfno_i 
JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
WHERE 1=1
              AND wo_header.workorderno_display &gt; 0

UNION

SELECT aircraft.ac_typ as ac_typ,
              wo_header.ac_registr as ac_registr,
              wo_header.event_perfno_i as event_perfno_i,
              'TC' as object_type,
              msc_taskcard.taskcardno as objectno,
              DECODE(msc_requirement_tc_link.type, 'S', 'SRT', 'O', 'On Demand TC', 'B', 'BTC', 'R', 'Rotable Controlled', 'Taskcard Controlled', 'C', 'Check Controlled', 'D', 'Document Controlled', '') as type,
              wo_header.state as state
FROM (
             SELECT workstep_link.event_perfno_i
             FROM workstep_link
             JOIN db_link ON TO_NUMBER(db_link.source_pk) = workstep_link.descno_i AND db_link.source_type = 'WS' AND workstep_link.event_perfno_i &gt; 0
             WHERE 1=1
                            AND db_link.linkno_i = @290_CHECK_WD_LINKS_Main.linkno_i@

             UNION

             SELECT TO_NUMBER(db_link.source_pk) as event_perfno_i
             FROM db_link 
             WHERE 1=1
                           AND TO_NUMBER(db_link.source_pk)&gt;0
                           AND db_link.linkno_i = @290_CHECK_WD_LINKS_Main.linkno_i@
                           AND db_link.source_type = 'WO'
            ) ev
JOIN wo_header ON ev.event_perfno_i = wo_header.event_perfno_i 
JOIN wo_event_link ON wo_event_link.event_perfno_i = wo_header.event_perfno_i AND wo_event_link.event_type = 'TCEFFLI'
JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
JOIN msc_requirement_tc_link ON wo_event_link.event_key_parent = msc_requirement_tc_link.req_linkno_i
JOIN msc_taskcard_version ON msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
JOIN msc_taskcard ON msc_taskcard.taskcardno_i = msc_taskcard_version.taskcardno_i
WHERE 1=1
               AND wo_header.workorderno_display IS NULL

UNION

SELECT null as ac_typ,
              null as ac_registr,
              event_template.event_perfno_i as event_perfno_i,
              'WT' as object_type,
              TO_CHAR(work_template.wtno_i) as objectno,
              'rev.'||revision as type,
              DECODE(event_template.revision_status, 0, 'New', 1, 'Active', '2', 'Deactivated', '') as state
FROM (
             SELECT workstep_link.event_perfno_i
             FROM workstep_link
             JOIN db_link ON db_link.source_pk = workstep_link.descno_i AND db_link.source_type = 'WS' AND workstep_link.event_perfno_i &lt; 0
             WHERE 1=1
                            AND db_link.linkno_i = @290_CHECK_WD_LINKS_Main.linkno_i@

             UNION ALL

             SELECT TO_NUMBER(db_link.source_pk) as event_perfno_i
             FROM db_link 
             WHERE 1=1
                           AND db_link.linkno_i = @290_CHECK_WD_LINKS_Main.linkno_i@
                           AND db_link.source_type = 'WO'
                           AND TO_NUMBER(db_link.source_pk) &lt; 0
            ) ev 
JOIN event_template ON event_template.event_perfno_i = ev.event_perfno_i
JOIN work_template ON event_template.wtno_i = work_template.wtno_i
WHERE 1=1

UNION

SELECT aircraft.ac_typ as ac_typ,
              wo_header.ac_registr as ac_registr,
              wo_header.event_perfno_i as event_perfno_i,
              'DOC.' as object_type,
              wo_event_link.event_name as objectno,
              'rev.'||doc_header.revision as type,
              wo_header.state as state
FROM (
             SELECT workstep_link.event_perfno_i
             FROM workstep_link
             JOIN db_link ON TO_NUMBER(db_link.source_pk) = workstep_link.descno_i AND db_link.source_type = 'WS' AND workstep_link.event_perfno_i &gt; 0
             WHERE 1=1
                            AND db_link.linkno_i = 258175556

             UNION

             SELECT TO_NUMBER(db_link.source_pk) as event_perfno_i
             FROM db_link 
             WHERE 1=1
                           AND TO_NUMBER(db_link.source_pk)&gt;0
                           AND db_link.linkno_i = @290_CHECK_WD_LINKS_Main.linkno_i@
                           AND db_link.source_type = 'WO'
            ) ev
JOIN wo_header ON ev.event_perfno_i = wo_header.event_perfno_i 
JOIN wo_event_link ON wo_event_link.event_perfno_i = wo_header.event_perfno_i AND wo_event_link.event_type = 'DOC_EFF'
JOIN doc_header ON wo_event_link.event_key_parent = doc_header.docno_i 
JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
WHERE 1=1
               AND wo_header.workorderno_display IS NULL

)
ORDER BY object_type, event_perfno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
