      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT CASE WHEN part.partno LIKE ('0%') AND REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
              CASE WHEN rotables.serialno LIKE ('0%') AND REGEXP_LIKE(rotables.serialno, '^[0-9]+$') THEN chr(39)||rotables.serialno ELSE rotables.serialno END as serialno,
              part.description as description,
              rotables.ac_registr as ac_registr,
              aircraft.ac_typ as ac_typ,
              rotables.location as location,
              rotables.condition as condition,
              TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + rotables.del_date, 'dd.mm.yyyy') as del_date,
TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + mod_component.mod_date, 'dd.mm.yyyy') as mod_component_date,
mod_component.mod_status as mod_component_status,

TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + mod_hardware.mod_date, 'dd.mm.yyyy') as mod_hardware_date,
mod_hardware.mod_status as mod_hardware_status,

TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + mod_software.mod_date, 'dd.mm.yyyy') as mod_software_date,
mod_software.mod_status as mod_software_status,

TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + mod_database.mod_date, 'dd.mm.yyyy') as mod_database_date,
mod_database.mod_status as mod_database_status

FROM part
JOIN rotables ON part.partno = rotables.partno
JOIN aircraft ON rotables.ac_registr = aircraft.ac_registr AND aircraft.status &lt;&gt; 9
LEFT JOIN (
                    SELECT rotables_mod_history.mod_date,
                                  rotables_mod_history.mod_status,
                                  rotables_mod_history.mod_status_type,
                                  rotables_mod_history.type,
                                  rotables_mod_history.event_perfno_i,
                                  od_header.orderno,
                                  rotables.psn
                    FROM od_header
                    RIGHT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i 
                    RIGHT JOIN rotables_mod_history rotables_mod_history ON od_detail.detailno_i = rotables_mod_history.detailno_i 
                    RIGHT JOIN rotables ON rotables_mod_history.psn = rotables.psn
                    WHERE 1=1
                                   AND rotables_mod_history.mod_status_type IN ('C')
                    ORDER BY rotables_mod_history.mod_date
                   ) mod_component ON rotables.psn = mod_component.psn
LEFT JOIN (
                    SELECT rotables_mod_history.mod_date,
                                  rotables_mod_history.mod_status,
                                  rotables_mod_history.mod_status_type,
                                  rotables_mod_history.type,
                                  rotables_mod_history.event_perfno_i,
                                  od_header.orderno,
                                  rotables.psn
                    FROM od_header
                    RIGHT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i 
                    RIGHT JOIN rotables_mod_history rotables_mod_history ON od_detail.detailno_i = rotables_mod_history.detailno_i 
                    RIGHT JOIN rotables ON rotables_mod_history.psn = rotables.psn
                    WHERE 1=1
                                   AND rotables_mod_history.mod_status_type IN ('H')
                    ORDER BY rotables_mod_history.mod_date
                   ) mod_hardware ON rotables.psn = mod_hardware.psn
LEFT JOIN (
                    SELECT rotables_mod_history.mod_date,
                                  rotables_mod_history.mod_status,
                                  rotables_mod_history.mod_status_type,
                                  rotables_mod_history.type,
                                  rotables_mod_history.event_perfno_i,
                                  od_header.orderno,
                                  rotables.psn
                    FROM od_header
                    RIGHT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i 
                    RIGHT JOIN rotables_mod_history rotables_mod_history ON od_detail.detailno_i = rotables_mod_history.detailno_i 
                    RIGHT JOIN rotables ON rotables_mod_history.psn = rotables.psn
                    WHERE 1=1
                                   AND rotables_mod_history.mod_status_type IN ('S')
                    ORDER BY rotables_mod_history.mod_date
                   ) mod_software ON rotables.psn = mod_software.psn
LEFT JOIN (
                    SELECT rotables_mod_history.mod_date,
                                  rotables_mod_history.mod_status,
                                  rotables_mod_history.mod_status_type,
                                  rotables_mod_history.type,
                                  rotables_mod_history.event_perfno_i,
                                  od_header.orderno,
                                  rotables.psn
                    FROM od_header
                    RIGHT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i 
                    RIGHT JOIN rotables_mod_history rotables_mod_history ON od_detail.detailno_i = rotables_mod_history.detailno_i 
                    RIGHT JOIN rotables ON rotables_mod_history.psn = rotables.psn
                    WHERE 1=1
                                   AND rotables_mod_history.mod_status_type IN ('D')
                    ORDER BY rotables_mod_history.mod_date
                   ) mod_database ON rotables.psn = mod_database.psn

WHERE 1=1
              AND (aircraft.ac_typ = '@VAR.v03_ac_typ@' OR '@VAR.v03_ac_typ@' = 'ALL')
              AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.v04_ac_registr@', ', ', '|')) OR '@VAR.v04_ac_registr@' IS NULL) 
              AND ('@VAR.v01_partno@' = 'ALL'
                          OR
                          UPPER(part.partno) IN (
                                                   SELECT UPPER(t.v)
