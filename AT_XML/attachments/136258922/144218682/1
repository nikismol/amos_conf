    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="276_ACDA_Current_Values" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              LISTAGG(aircraft.ac_registr '') WITHIN GROUP (ORDER BY aircraft.ac_registr) as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_CHAR(TRUNC(av_hours.average/60)'FM999999999900'))||':'||TO_CHAR(TRUNC(MOD(av_hours.average60))'FM00') as avh" id="avh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="av_cycles.average as avc" id="avc"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_ac_registr@">
          <ds:object>@VAR.v03_ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_ac_typ@">
          <ds:object>@VAR.v04_ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT aircraft.ac_typ,
              LISTAGG(aircraft.ac_registr, ', ') WITHIN GROUP (ORDER BY aircraft.ac_registr) as ac_registr,
              TO_CHAR(TO_CHAR(TRUNC(av_hours.average/60),'FM999999999900'))||':'||TO_CHAR(TRUNC(MOD(av_hours.average,60)),'FM00') as avh,
              av_cycles.average as avc
FROM aircraft
LEFT JOIN ac_daily_average ac_daily_average_hours ON ac_daily_average_hours.ac_register = aircraft.ac_registr AND ac_daily_average_hours.counter_defno_i='1'
LEFT JOIN ac_average_period av_hours ON av_hours.daily_averageno_i = ac_daily_average_hours.daily_averageno_i 
LEFT JOIN ac_daily_average ac_daily_average_cycles ON ac_daily_average_cycles.ac_register = aircraft.ac_registr AND ac_daily_average_cycles.counter_defno_i='2'
LEFT JOIN ac_average_period av_cycles ON av_cycles.daily_averageno_i = ac_daily_average_cycles.daily_averageno_i 
WHERE 1=1
              AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.v03_ac_registr@', ', ', '|')) OR '@VAR.v03_ac_registr@' IS NULL)
              AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.v04_ac_typ@', ', ', '|')) OR '@VAR.v04_ac_typ@' = 'ALL')
              AND aircraft.status &lt;&gt; 9
              AND aircraft.operator = 'AFL'
GROUP BY aircraft.ac_typ, 
                    av_hours.average,
                    av_cycles.average</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
