          <se:textStatement>SELECT
TO_CHAR(daily_average) as daily_average,
TO_CHAR(diff_value, 'FM999999999900') as diff_value
FROM (
             SELECT        
                           ROUND((SUM(counter_end.life_value - NVL(counter_start.life_value, counter_first_flight.life_value)))/(SUM(@VAR.v02_date_to@ - @VAR.v01_date_from@ + 1)), 2) as daily_average,
                           SUM(counter_end.life_value - NVL(counter_start.life_value, counter_first_flight.life_value)) as diff_value,
                           SUM(NVL(counter_start.life_value, counter_first_flight.life_value)) AS start_value,
                           SUM(counter_end.life_value) AS end_value
             FROM (
                          SELECT ce.life_value,
                                        ce.ref_key
                          FROM (
                                       SELECT counter.ref_key,
                                                     counter_value.life_value,
                                                     counter_value.readout_date,
                                                     max (counter_value.readout_date*86400000+counter_value.readout_time) over (partition by counter_value.counterno_i) as max_readout,
                                                     counter_value.readout_date*86400000+counter_value.readout_time as readout,
                                                     counter.counterno_i
                                       FROM counter
                                       JOIN counter_template on counter.counter_templateno_i=counter_template.counter_templateno_i
                                       JOIN counter_definition on counter_template.counter_defno_i=counter_definition.counter_defno_i
                                       JOIN counter_value on counter_value.counterno_i=counter.counterno_i
                                       JOIN aircraft ON aircraft.aircraftno_i = counter.ref_key AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.v03_ac_registr@', ', ', '|')) OR '@VAR.v03_ac_registr@' IS NULL)
                                                                                                                                         AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.v04_ac_typ@', ', ', '|')) OR '@VAR.v04_ac_typ@' = 'ALL')
                                                                                                                                         AND (aircraft.status &lt;&gt; 9 OR '@VAR.v05_excl_inactive_aircraft@' = 'N')
                                                                                                                                         AND aircraft.operator = 'AFL'
                                       WHERE 1=1
                                                      AND counter_value.readout_ref_type in ('LEG', 'FL2L')
                                                      AND counter.ref_type='AC_INT'
                                                      AND counter_definition.counter_defno_i='2'
                                                      AND counter_value.readout_date &lt;= @VAR.v02_date_to@
                                       ORDER BY readout DESC
                                      ) ce
                          WHERE 1=1
                                         AND ce.max_readout = ce.readout
                         ) counter_end
              JOIN (
                        SELECT cf.life_value,
                                      cf.ref_key
                        FROM (
                                     SELECT counter.ref_key,
                                                   counter_value.life_value - counter_value.delta_value as life_value,
                                                   counter_value.readout_date,
                                                   min (counter_value.readout_date*86400000+counter_value.readout_time) over (partition by counter_value.counterno_i) as min_readout,
                                                   counter_value.readout_date*86400000+counter_value.readout_time as readout,
                                                   counter.counterno_i
                                     FROM counter
                                     JOIN counter_template on counter.counter_templateno_i=counter_template.counter_templateno_i
                                     JOIN counter_definition on counter_template.counter_defno_i=counter_definition.counter_defno_i
                                     JOIN counter_value on counter_value.counterno_i=counter.counterno_i
                                     JOIN aircraft ON aircraft.aircraftno_i = counter.ref_key AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.v03_ac_registr@', ', ', '|')) OR '@VAR.v03_ac_registr@' IS NULL)
                                                                                                                                              AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.v04_ac_typ@', ', ', '|')) OR '@VAR.v04_ac_typ@' = 'ALL')
                                                                                                                                              AND (aircraft.status &lt;&gt; 9 OR '@VAR.v05_excl_inactive_aircraft@' = 'N')
                                                                                                                                              AND aircraft.operator = 'AFL'
                                     WHERE 1=1
                                                   and counter_value.readout_ref_type in ('LEG', 'FL2L')
                                                   and counter.ref_type='AC_INT'
                                                   and counter_definition.counter_defno_i='2'
                                     ORDER BY readout DESC
                                   ) cf
                        WHERE 1=1
                                      AND cf.min_readout = cf.readout
                       ) counter_first_flight ON counter_first_flight.ref_key = counter_end.ref_key
             LEFT JOIN (
                                SELECT c.life_value,
                                              c.ref_key
                                FROM (
                                             SELECT counter.ref_key,
                                                           CASE WHEN counter_value.readout_date &lt; @VAR.v01_date_from@ THEN counter_value.life_value ELSE counter_value.life_value - counter_value.delta_value END as life_value,
                                                           counter_value.readout_date,
                                                           max (counter_value.readout_date) over (partition by counter_value.counterno_i) as max_readout_date,
                                                           min (counter_value.readout_date*86400000+counter_value.readout_time) over (partition by counter_value.counterno_i, counter_value.readout_date) as min_day_readout,
                                                           max (counter_value.readout_date*86400000+counter_value.readout_time) over (partition by counter_value.counterno_i) as max_readout,
                                                           counter_value.readout_date*86400000+counter_value.readout_time as readout
                                             FROM counter
                                             JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
                                             JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
                                             JOIN counter_value ON counter_value.counterno_i=counter.counterno_i
                                             JOIN aircraft ON aircraft.aircraftno_i = counter.ref_key AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.v03_ac_registr@', ', ', '|')) OR '@VAR.v03_ac_registr@' IS NULL)
                                                                                                                                              AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.v04_ac_typ@', ', ', '|')) OR '@VAR.v04_ac_typ@' = 'ALL')
                                                                                                                                              AND (aircraft.status &lt;&gt; 9 OR '@VAR.v05_excl_inactive_aircraft@' = 'N')
                                                                                                                                              AND aircraft.operator = 'AFL'
                                             WHERE 1=1
                                                            AND counter_value.readout_ref_type in ('LEG', 'FL2L')
                                                            AND counter.ref_type='AC_INT'
                                                            AND counter_definition.counter_defno_i='2'
                                                            AND counter_value.readout_date &lt;= @VAR.v01_date_from@
                                             ORDER BY readout DESC
                                            ) c
                                WHERE 1=1
                                              AND (c.readout_date &lt; @VAR.v01_date_from@
                                                        AND c.max_readout = readout
                                                        OR
                                                        c.readout_date = @VAR.v01_date_from@
                                                        AND c.max_readout_date = c.readout_date
                                                        AND c.min_day_readout = c.readout
                                                       )
                             ) counter_start ON counter_end.ref_key = counter_start.ref_key
            ) count_av</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="276_Date_Format" type="SQL_EDITOR_DATASOURCE" version="2.0">
