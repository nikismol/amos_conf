          <ds:object>@266_PCF_Summary_MAIN.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_incl_altparts_reordering@">
          <ds:object>@VAR.v03_incl_altparts_reordering@</ds:object>
