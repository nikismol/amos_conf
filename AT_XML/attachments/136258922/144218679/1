      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT max_purch,
              reorder_level,
              alert_qty
FROM (
             SELECT part.max_purch as max_purch,
                           part.reord_level as reorder_level,
                           part.alert_qty as alert_qty,
                           row_number() over(partition BY part_alternate.partno  ORDER BY part.reord_level DESC) as num,
                           part.partno,
                           part_alternate.partno as main_partno
             FROM part_alternate
             JOIN part ON part_alternate.altpartno = part.partno
             WHERE 1=1
                            AND part.reorder IN ('H', 'F') 
                            AND part_alternate.partno = '@266_PCF_Summary_MAIN.partno@'
                            AND '@VAR.v03_incl_altparts_reordering@'= 'Y'
                            AND part_alternate.type IN ('A')
            )
WHERE num = 1</se:textStatement>
        </se:sqlStatement>
