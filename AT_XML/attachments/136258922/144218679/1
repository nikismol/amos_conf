        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select 
pcf.partno as partno,
pcf.description as description,
pcf.measure_unit as measure_unit,
pcf.mat_class as mat_class,
pcf.is_tool as is_tool,
pcf.ata_chapter as ata_chapter,
pcf.total_requested_qty as total_requested_qty,
pcf.A32S_requested_qty as A32S_requested_qty,
pcf.A330_requested_qty as A330_requested_qty,
pcf.A350_requested_qty as A350_requested_qty, 
pcf.B737_requested_qty as B737_requested_qty,
pcf.B777_requested_qty as B777_requested_qty,
pcf.RRJ_requested_qty as RRJ_requested_qty,
pcf.stock_svo_incl_alt as stock_svo_incl_alt,
pcf.firts_unavaliable_at_due_date as firts_unavaliable_at_due_date,
pcf.stock_forecast as stock_forecast,
pcf.total_last_fe as total_last_fe,
pcf.A32S_last_fe as A32S_last_fe,
pcf.A330_total_last_fe as A330_total_last_fe,
pcf.A350_total_last_fe as A350_total_last_fe,
pcf.B737_total_last_fe as B737_total_last_fe,
pcf.B777_total_last_fe as B777_total_last_fe,
pcf.RRJ_total_last_fe as RRJ_total_last_fe,
CASE WHEN part.reorder IN ('H', 'F') then TO_NUMBER(part.max_purch) else null end as max_purch,
CASE WHEN part.reorder IN ('H', 'F') then TO_NUMBER(part.reord_level) else null end as reord_level,
