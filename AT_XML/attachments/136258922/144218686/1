    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="285_letter_check" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_registr" id="aircraft.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when aircraft.status=0 then 'Active'&#10;        else 'Inactive'&#10;    end as status" id="status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.description" id="wp_header.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_event_link.event_display" id="wo_event_link.event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (wo_transfer.absolute_due_date + 729)'dd.mm.yyyy') as per_date" id="per_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v3_ac_type@">
          <ds:object>@VAR.v3_ac_type@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v1_start_date@">
          <ds:object>@VAR.v1_start_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v2_end_date@">
          <ds:object>@VAR.v2_end_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select
    aircraft.ac_typ,
    aircraft.ac_registr,
    case when aircraft.status=0 then 'Active'
        else 'Inactive'
    end as status,
    wp_header.wpno,
    wp_header.description,
    wo_event_link.event_display,
    to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (wo_transfer.absolute_due_date + 729),'dd.mm.yyyy') as per_date
from wp_header
left join wp_assignment on wp_header.wpno_i = wp_assignment.wpno_i
left join wo_event_link on wp_assignment.event_perfno_i = wo_event_link.event_perfno_i
                               and wo_event_link.event_type='CHTI'
left join check_type on wo_event_link.event_key_root = check_type.checkno_i
left join wo_transfer on wo_event_link.event_perfno_i=wo_transfer.event_perfno_i
left join aircraft on wp_header.ac_registr = aircraft.ac_registr
where check_type in ('1C','2C','4C', /*для отчечествнных ВС*/'1С','2С', '4С')
    and wo_transfer.transfer_type='R'
    and ((aircraft.ac_typ = 'A32S' AND (REGEXP_LIKE('A32S', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'A330' AND (REGEXP_LIKE('A330', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
       (aircraft.ac_typ = 'A350' AND (REGEXP_LIKE('A350', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'B737' AND (REGEXP_LIKE('B737', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'B777' AND (REGEXP_LIKE('B777', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
 	   (aircraft.ac_typ = 'RRJ' AND (REGEXP_LIKE('RRJ', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
       )
    and wo_transfer.absolute_due_date&gt;='@VAR.v1_start_date@'
    and wo_transfer.absolute_due_date&lt;='@VAR.v2_end_date@'
order by aircraft.ac_typ, aircraft.ac_registr, wp_header.wpno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
