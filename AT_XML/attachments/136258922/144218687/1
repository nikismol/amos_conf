    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="287_Parts_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partseqno_i as partseqno_i" id="partseqno_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_partno@">
          <ds:object>@VAR.v01_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_delimeter@">
          <ds:object>@VAR.v02_delimeter@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT CASE WHEN part.partno LIKE ('0%') AND REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
              part.partseqno_i as partseqno_i
FROM part
WHERE 1=1
               AND ('@VAR.v01_partno@' = 'ALL'
                          OR
                          UPPER(part.partno) IN (
                                                   SELECT UPPER(t.v)
                                                   FROM (
                                                                SELECT column_value as v
                                                                FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_partno@','@VAR.v02_delimeter@'))
                                                               ) t
                                                   WHERE t.v is not null
                                                  )
                        )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="287_Requirement_Types" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              requirement ||'-'|| ROW_NUMBER(1) OVER (PARTITION BY requirementinterval) as req" id="req"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_partno@">
          <ds:object>@VAR.v01_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_delimeter@">
          <ds:object>@VAR.v02_delimeter@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT req FROM (
SELECT partno,
              requirement ||'-'|| ROW_NUMBER() OVER (PARTITION BY partno, requirement ORDER BY interval) as req,
              interval
FROM (
                   SELECT DISTINCT p.partno,
                                 requirement_type.requirement,
                                 requirement_type.requirement
                                ||'/'
                                ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                               WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                               WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                               WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NOT NULL THEN treq_interval.unit
                                               WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                               WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                               WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                               WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                              ELSE '' 
                                    END
                                ||'/'
                                ||treq_interval.amount_interval as interval 
                   FROM event_effectivity_parts
                   JOIN (
                             SELECT part.partno,
                                           part.partseqno_i
                             FROM part
                             WHERE 1=1
                                            AND ('@VAR.v01_partno@' = 'ALL'
                                                       OR
                                                       UPPER(part.partno) IN (
                                                                                SELECT UPPER(t.v)
                                                                                FROM (
                                                                                             SELECT column_value as v
                                                                                             FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_partno@','@VAR.v02_delimeter@'))
                                                                                            ) t
                                                                                WHERE t.v is not null
                                                                               )
                                                     )
                             
                            ) p ON event_effectivity_parts.partseqno_i = p.partseqno_i
                   JOIN event_effectivity_link ON event_effectivity_link.effectivityno_i = event_effectivity_parts.effectivityno_i AND event_effectivity_link.event_type = 'PARTREQ'
                   JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_parts.effectivityno_i AND event_effectivity.status = 0
                   JOIN treq_time_requirement ON event_effectivity_link.effectivity_linkno_i = treq_time_requirement.event_key AND treq_time_requirement.event_type = 'EFL' AND treq_time_requirement.status = 0
                   JOIN part_requirement ON part_requirement.part_requirementno_i = event_effectivity_link.event_key
                   JOIN requirement_type ON requirement_type.requirement_typeno_i = part_requirement.type
                   JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i = treq_interval_group.timerequirementno_i
                   JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i = treq_dimension_group.interval_groupno_i
                   JOIN treq_interval ON treq_interval.dimension_groupno_i = treq_dimension_group.dimension_groupno_i AND treq_interval.dimension_type IN ('I')
                   WHERE 1=1
            )
)
ORDER BY 1</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="287_Requirement_Details" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              requirement ||'-'|| ROW_NUMBER() OVER (PARTITION BY partnorequirement ORDER BY interval) as req" id="req"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="interval" id="interval"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_partno@">
          <ds:object>@VAR.v01_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_delimeter@">
          <ds:object>@VAR.v02_delimeter@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@287_Parts_MAIN.partseqno_i@">
          <ds:object>@287_Parts_MAIN.partseqno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT r_typ.req_colomun as req,
              r_detail.interval as interval
FROM ( /* получаю набор типов requirements, актуальный для заднных partno */
             SELECT 'LL/DIM/TYPE/INT/Compliance/RemReq-'||LEVEL as req_colomun 
             FROM (
                          SELECT MAX(cnt_interval) as cnt
                          FROM (
                                       SELECT p.partno,
                                                     COUNT(DISTINCT   
                                                    requirement_type.requirement
                                                    ||'/'
                                                    ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                   WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NOT NULL THEN treq_interval.unit
                                                                   WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                   WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                   WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                   WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                                  ELSE '-' 
                                                        END
                                                    ||'/'
                                                    ||DECODE(treq_interval.dimension_type, 'I', 'I', 'W', 'T', 'B', 'T', '-')
                                                    ||'/'
                                                    ||CASE WHEN treq_interval_group.status = 1 THEN 'UNLIM' ELSE TO_CHAR(treq_interval.amount_interval) END
                                                    ||'/'
                                                    ||compliance_type.code
                                                    ||'/'
                                                    ||CASE WHEN (part_requirement.on_shelf = 'N' AND part_requirement.on_wing = 'N') THEN 'Y' ELSE 'N' END) as cnt_interval 
                                       FROM event_effectivity_parts
                                       JOIN (
                                                 SELECT part.partno,
                                                               part.partseqno_i
                                                 FROM part
                                                 WHERE 1=1
                                                                AND ('@VAR.v01_partno@' = 'ALL'
                                                                           OR
                                                                           UPPER(part.partno) IN (
                                                                                                    SELECT UPPER(t.v)
                                                                                                    FROM (
                                                                                                                 SELECT column_value as v
                                                                                                                 FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_partno@','@VAR.v02_delimeter@'))
                                                                                                                ) t
                                                                                                    WHERE t.v is not null
                                                                                                   )
                                                                         )
                                                ) p ON event_effectivity_parts.partseqno_i = p.partseqno_i
                                       JOIN event_effectivity_link ON event_effectivity_link.effectivityno_i = event_effectivity_parts.effectivityno_i AND event_effectivity_link.event_type = 'PARTREQ'
                                       JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_parts.effectivityno_i AND event_effectivity.status = 0
                                       JOIN treq_time_requirement ON event_effectivity_link.effectivity_linkno_i = treq_time_requirement.event_key AND treq_time_requirement.event_type = 'EFL' AND treq_time_requirement.status = 0
                                       JOIN part_requirement ON part_requirement.part_requirementno_i = event_effectivity_link.event_key
                                       JOIN requirement_type ON requirement_type.requirement_typeno_i = part_requirement.type
                                       JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i = treq_interval_group.timerequirementno_i
                                       LEFT JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i = treq_dimension_group.interval_groupno_i
                                       LEFT JOIN treq_interval ON treq_interval.dimension_groupno_i = treq_dimension_group.dimension_groupno_i AND treq_interval.dimension_type IN ('I', 'W', 'B')
                                       LEFT JOIN compliance_type_link ON event_effectivity_link.event_key = compliance_type_link.event_key AND compliance_type_link.event_type = 'PARTREQ'
                                       LEFT JOIN compliance_type ON compliance_type_link.compliance_typeno_i = compliance_type.compliance_typeno_i
                                       WHERE 1=1
                                                      AND requirement_type.requirement = 'LL'
                                       GROUP BY p.partno
                                      )
                         )
             CONNECT BY LEVEL &lt;= cnt

             UNION

             SELECT 'RQ/DIM/TYPE/INT/Compliance/RemReq-'||LEVEL as req_colomun 
             FROM (
                          SELECT MAX(cnt_interval) as cnt
                          FROM (
                                       SELECT p.partno,
                                                     COUNT(DISTINCT   
                                                     requirement_type.requirement
                                                    ||'/'
                                                    ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                   WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NOT NULL THEN treq_interval.unit
                                                                   WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                   WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                   WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                   WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                                  ELSE '-' 
                                                        END
                                                    ||'/'
                                                    ||DECODE(treq_interval.dimension_type, 'I', 'I', 'W', 'T', 'B', 'T', '-')
                                                    ||'/'
                                                    ||CASE WHEN treq_interval_group.status = 1 THEN 'UNLIM' ELSE TO_CHAR(treq_interval.amount_interval) END
                                                    ||'/'
                                                    ||compliance_type.code
                                                    ||'/'
                                                    ||CASE WHEN (part_requirement.on_shelf = 'N' AND part_requirement.on_wing = 'N') THEN 'Y' ELSE 'N' END) as cnt_interval 
                                       FROM event_effectivity_parts
                                       JOIN (
                                                 SELECT part.partno,
                                                               part.partseqno_i
                                                 FROM part
                                                 WHERE 1=1
                                                                AND ('@VAR.v01_partno@' = 'ALL'
                                                                           OR
                                                                           UPPER(part.partno) IN (
                                                                                                    SELECT UPPER(t.v)
                                                                                                    FROM (
                                                                                                                 SELECT column_value as v
                                                                                                                 FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_partno@','@VAR.v02_delimeter@'))
                                                                                                                ) t
                                                                                                    WHERE t.v is not null
                                                                                                   )
                                                                         )
                                                ) p ON event_effectivity_parts.partseqno_i = p.partseqno_i
                                       JOIN event_effectivity_link ON event_effectivity_link.effectivityno_i = event_effectivity_parts.effectivityno_i AND event_effectivity_link.event_type = 'PARTREQ'
                                       JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_parts.effectivityno_i AND event_effectivity.status = 0
                                       JOIN treq_time_requirement ON event_effectivity_link.effectivity_linkno_i = treq_time_requirement.event_key AND treq_time_requirement.event_type = 'EFL' AND treq_time_requirement.status = 0
                                       JOIN part_requirement ON part_requirement.part_requirementno_i = event_effectivity_link.event_key
                                       JOIN requirement_type ON requirement_type.requirement_typeno_i = part_requirement.type
                                       JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i = treq_interval_group.timerequirementno_i
                                       LEFT JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i = treq_dimension_group.interval_groupno_i
                                       LEFT JOIN treq_interval ON treq_interval.dimension_groupno_i = treq_dimension_group.dimension_groupno_i AND treq_interval.dimension_type IN ('I', 'W', 'B')
                                       LEFT JOIN compliance_type_link ON event_effectivity_link.event_key = compliance_type_link.event_key AND compliance_type_link.event_type = 'PARTREQ'
                                       LEFT JOIN compliance_type ON compliance_type_link.compliance_typeno_i = compliance_type.compliance_typeno_i
                                       WHERE 1=1
                                                      AND requirement_type.requirement != 'LL'
                                       GROUP BY p.partno
                                      )
                         )
             CONNECT BY LEVEL &lt;= cnt
             ORDER BY 1
            ) r_typ

LEFT JOIN ( /*получаю информацию о requirements */
                   SELECT partno,
                                 is_life_limit,
                                 CASE WHEN is_life_limit = 'Y' THEN 'LL/DIM/TYPE/INT/Compliance/RemReq-'|| ROW_NUMBER() OVER (PARTITION BY partno, is_life_limit  ORDER BY interval) ELSE 'RQ/DIM/TYPE/INT/Compliance/RemReq-'|| ROW_NUMBER() OVER (PARTITION BY partno, is_life_limit  ORDER BY interval) END as req_colomun,
                                 interval
                   FROM (
                                      SELECT DISTINCT p.partno,
                                                    DECODE(requirement_type.requirement, 'LL', 'Y', 'N') as is_life_limit,
                                                    requirement_type.requirement
                                                   ||'/'
                                                   ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                  WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NOT NULL THEN treq_interval.unit
                                                                  WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                  WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                  WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                  WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                                 ELSE '-' 
                                                       END
                                                   ||'/'
                                                   ||DECODE(treq_interval.dimension_type, 'I', 'I', 'W', 'T', 'B', 'T', '-')
                                                   ||'/'
                                                   ||CASE WHEN treq_interval_group.status = 1 THEN 'UNLIM' ELSE TO_CHAR(treq_interval.amount_interval) END
                                                   ||'/'
                                                   ||compliance_type.code
                                                   ||'/'
                                                   ||CASE WHEN (part_requirement.on_shelf = 'N' AND part_requirement.on_wing = 'N') THEN 'Y' ELSE 'N' END as interval
                                      FROM event_effectivity_parts
                                      JOIN part p ON event_effectivity_parts.partseqno_i = p.partseqno_i
                                      JOIN event_effectivity_link ON event_effectivity_link.effectivityno_i = event_effectivity_parts.effectivityno_i AND event_effectivity_link.event_type = 'PARTREQ'
                                      JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_parts.effectivityno_i AND event_effectivity.status = 0
                                      JOIN treq_time_requirement ON event_effectivity_link.effectivity_linkno_i = treq_time_requirement.event_key AND treq_time_requirement.event_type = 'EFL' AND treq_time_requirement.status = 0
                                      JOIN part_requirement ON part_requirement.part_requirementno_i = event_effectivity_link.event_key
                                      JOIN requirement_type ON requirement_type.requirement_typeno_i = part_requirement.type
                                      JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i = treq_interval_group.timerequirementno_i
                                      LEFT JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i = treq_dimension_group.interval_groupno_i
                                      LEFT JOIN treq_interval ON treq_interval.dimension_groupno_i = treq_dimension_group.dimension_groupno_i AND treq_interval.dimension_type IN ('I', 'W', 'B')
                                      LEFT JOIN compliance_type_link ON event_effectivity_link.event_key = compliance_type_link.event_key AND compliance_type_link.event_type = 'PARTREQ'
                                      LEFT JOIN compliance_type ON compliance_type_link.compliance_typeno_i = compliance_type.compliance_typeno_i
                                      WHERE 1=1
                                                    AND event_effectivity_parts.partseqno_i = '@287_Parts_MAIN.partseqno_i@'
                               )
                   ORDER BY 1
                  ) r_detail ON r_typ.req_colomun  = r_detail.req_colomun
ORDER BY 1</se:textStatement>
        </se:sqlStatement>
