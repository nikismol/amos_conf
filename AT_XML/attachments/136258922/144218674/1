    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="236_WO_ASSIGNMENT_HISTORY_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rownum" id="rownum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpno" id="wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="assignment_date" id="assignment_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="assignment_time" id="assignment_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="deassignment_date" id="deassignment_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="deassignment_time" id="deassignment_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_wo@">
          <ds:object>@VAR.v01_wo@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT rownum,
             event_perfno_i,
             wpno,
             assignment_date,
             assignment_time,
             deassignment_date,
             deassignment_time
FROM (
             SELECT wo_header.event_perfno_i,
                          wp_history_a.wp_historyno_i as wp_historyno_i_a,
                          wp_header.wpno,
                          TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + wp_history_a.action_date, 'DD.MM.YYYY') as assignment_date,
                          TO_CHAR(TO_DATE(wp_history_a.action_time*60,'sssss'),'hh24:mi') as assignment_time,
                          TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + wp_history_d.action_date, 'DD.MM.YYYY') as deassignment_date,
                          TO_CHAR(TO_DATE(wp_history_d.action_time*60,'sssss'),'hh24:mi') as deassignment_time,
                          wp_history_d.wp_historyno_i as wp_historyno_i_d,
                          MIN (wp_history_d.wp_historyno_i) OVER (PARTITION BY wp_history_a.wpno_i, wp_history_a.event_perfno_i, wp_history_a.wp_historyno_i) as min_wp_historyno_i_d
             FROM wo_header
             LEFT JOIN wp_history wp_history_a ON wo_header.event_perfno_i=wp_history_a.event_perfno_i AND wp_history_a.action_type='A'
             LEFT JOIN wp_header ON wp_history_a.wpno_i=wp_header.wpno_i
             LEFT JOIN wp_history wp_history_d ON wp_history_a.event_perfno_i=wp_history_d.event_perfno_i
                                                                                 AND wp_history_a.wpno_i=wp_history_d.wpno_i
                                                                                 AND wp_history_d.action_type='D' 
                                                                                 AND wp_history_a.wp_historyno_i&lt;wp_history_d.wp_historyno_i
             WHERE 1=1
                           AND wo_header.event_perfno_i=@VAR.v01_wo@
             ORDER BY wp_historyno_i_a
            )
WHERE 1=1
              AND (wp_historyno_i_d=min_wp_historyno_i_d OR wp_historyno_i_d IS NULL)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
