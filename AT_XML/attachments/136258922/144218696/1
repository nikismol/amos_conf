    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="311_part_info" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.mat_class as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.repairable as repairable" id="repairable"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ as ac_typ" id="ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_partno@">
          <ds:object>@VAR.v01_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_partno_list@">
          <ds:object>@VAR.v03_partno_list@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    part.partno as partno,
    part.mat_class as mat_class,
    part.repairable as repairable,
    part.description as description,
    part.ac_typ as ac_typ

FROM part
WHERE 1=1
    AND
    (
        part.partno IN (
            SELECT t.v
            FROM
                (
                    SELECT column_value as v
                    FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_partno@','comma'))
                    ) t
            WHERE t.v is not null
            )
            OR '@VAR.v01_partno@' IS NULL
        )
    AND
    (
        part.partno IN (
            SELECT t.v
            FROM (
                SELECT column_value as v
                FROM TABLE(amosserver_prod.string_splitter('@VAR.v03_partno_list@','line_feed'))
                ) t
            WHERE t.v is not null
            )
            OR '@VAR.v03_partno_list@' IS NULL
        )
ORDER BY part.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="311_period" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="@VAR.v02_year_start@ - 1 + LEVEL as yr" id="yr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_year_start@">
          <ds:object>@VAR.v02_year_start@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT @VAR.v02_year_start@ - 1 + LEVEL as yr
FROM DUAL
CONNECT BY LEVEL - 1 &lt;= to_char(sysdate, 'YYYY') - @VAR.v02_year_start@</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="311_history" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno" id="history.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(history.VOUCHERNO) as cnt_removal" id="cnt_removal"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@311_period.yr@">
          <ds:object>@311_period.yr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@311_part_info.partno@">
          <ds:object>@311_part_info.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    history.partno,
    count(history.VOUCHERNO) as cnt_removal
FROM
    (
    SELECT
        history.partno,
        history.VOUCHERNO,
        history.EVENT_PERFNO_I
    FROM history
    WHERE 1=1
        AND history.vm in ('YA')
        AND TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + history.created_date, 'YYYY') = '@311_period.yr@'
    ) history
LEFT JOIN wo_header ON history.EVENT_PERFNO_I=wo_header.EVENT_PERFNO_I
LEFT JOIN wo_part_on_off ON wo_header.EVENT_PERFNO_I=WO_PART_ON_OFF.EVENT_PERFNO_I AND wo_part_on_off.REMOVAL_TYPE&lt;&gt;'C'
WHERE history.partno='@311_part_info.partno@'
group by history.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
