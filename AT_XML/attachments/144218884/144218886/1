CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Распечатан' ELSE 'Printed On' END as label_printed_on,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Пункт' ELSE 'Item' END as label_deferred_item,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Ссылка №' ELSE 'Ref. No' END as label_refno,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Причина незавершения' ELSE 'Reason for Non-Completion' END as label_reason_for_noncompl,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Роспись' ELSE 'SIGN' END as label_sign,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Крайний срок' ELSE 'Deadline' END as label_deadline,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Остаток' ELSE 'Remaining' END as label_remaining,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'ПДО Росп.' ELSE 'MPCD SIGN' END as label_ppcd_sign,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Описание' ELSE 'Description' END as label_desc,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Все перечисленные пункты отложенных работ приняты оператором ________________________________ (Дата, роспись)' ELSE 'All Mentioned above Deferred Items are accepted by Operator ________________________________ (Date and Signature)' END as label_def_cad_sign

