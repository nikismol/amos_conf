CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Заводской №' ELSE 'MSN' END as label_msn,
CASE when '@WP_TRANSLATION_FLAG.print_rus@' = 'Y' THEN 'Контролер'||CHR(10)||'(штамп, подпись)' ELSE 'Inspector' END as label_inspector,

