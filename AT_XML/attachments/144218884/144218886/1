    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WP_PANEL_LIST" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpp.panelno_i" id="wpp.panelno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mpt.panel_no" id="mpt.panel_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ev.items as items" id="items"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@wp.wpno@">
          <ds:object>@wp.wpno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
         wpp.panelno_i,
         mpt.panel_no,
         ev.items as items
FROM 
         wp_panel wpp
JOIN wp_header wph ON wph.wpno_i = wpp.wpno_i
JOIN msc_panel_type mpt ON wpp.panelno_i = mpt.panelno_i
LEFT JOIN (
                  SELECT p.panel_no,
                               LISTAGG (p.seqno_i, '; ') WITHIN GROUP (ORDER BY p.seqno_i) as items
                  FROM (
                               SELECT panel_code_link.panel_no,
                                            wp_sequence.seqno_i
                               FROM wp_header
                               JOIN wp_assignment ON wp_header.wpno_i=wp_assignment.wpno_i
                               JOIN wo_header ON wp_assignment.event_perfno_i=wo_header.event_perfno_i
                               JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
                               JOIN panel_code_link ON workstep_link.descno_i=panel_code_link.source_pk AND panel_code_link.source_type='WS'
                               JOIN wp_sequence ON wp_assignment.event_perfno_i=wp_sequence.event_perfno_i AND wp_sequence.status IN (0,5)
                               WHERE wp_header.wpno = '@wp.wpno@'

                               UNION

                               SELECT msc_requirement_panel.panel_no,
                                            wp_sequence.seqno_i
                               FROM wp_header
                               JOIN wp_assignment ON wp_header.wpno_i=wp_assignment.wpno_i
                               JOIN wo_event_link ON wp_assignment.event_perfno_i=wo_event_link.event_perfno_i
                               JOIN msc_requirement_tc_link ON wo_event_link.event_key_parent = msc_requirement_tc_link.req_linkno_i
                                                                                               AND (wo_event_link.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%'
                                                                                                          OR wo_event_link.event_type = 'MET' AND '@AMOS_VERSION@' NOT LIKE '19.12%') 
                               JOIN msc_taskcard_version ON msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
                               JOIN msc_requirement_panel ON msc_taskcard_version.taskcard_verno_i=msc_requirement_panel.taskcard_verno_i
                               JOIN wp_sequence ON wp_assignment.event_perfno_i=wp_sequence.event_perfno_i AND wp_sequence.status IN (0,5)
                               WHERE wp_header.wpno = '@wp.wpno@'
                              ) p
                  GROUP BY p.panel_no
                ) ev ON mpt.panel_no=ev.panel_no
WHERE
         wph.wpno = '@wp.wpno@'
ORDER BY
         mpt.panel_no asc</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WP_PANEL_LIST_NOPAGES" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ceil(count(*)/25) as total" id="total"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(5+ceil(count(*)/25)) as endpage" id="endpage"/>
        <ds:columnDescriptor amosType="INT" description="CASE ceil(count(*)/12) WHEN 0 then 5 ELSE (4+ceil(count(*)/12)) END as endpage_mo" id="endpage_mo"/>
        <ds:columnDescriptor amosType="INT" description="(4) as startpage" id="startpage"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@WP_RRJ_852_FORM.contain_check@">
          <ds:object>@WP_RRJ_852_FORM.contain_check@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@wp.wpno@">
          <ds:object>@wp.wpno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	 CASE ceil(count(*)/9) WHEN 0 then 1 ELSE ceil(count(*)/9) END as total,
     CASE WHEN '@WP_RRJ_852_FORM.contain_check@'='Y'
          THEN CASE ceil(count(*)/9) WHEN 0 then 8 ELSE (7+ceil(count(*)/9)) END
          ELSE CASE ceil(count(*)/9) WHEN 0 then 6 ELSE (5+ceil(count(*)/9)) END
     END as endpage,     
     TO_NUMBER(CASE WHEN '@WP_RRJ_852_FORM.contain_check@'='Y'
          THEN CASE ceil(count(*)/9) WHEN 0 then 7 ELSE (6+ceil(count(*)/9)) END
          ELSE CASE ceil(count(*)/9) WHEN 0 then 5 ELSE (4+ceil(count(*)/9)) END
     END) as endpage_mo,
	(6) as startpage
FROM wp_panel wpp
LEFT JOIN wp_header wph ON wph.wpno_i = wpp.wpno_i
LEFT JOIN msc_panel_type mpt ON wpp.panelno_i = mpt.panelno_i
WHERE wph.wpno = '@wp.wpno@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WP_REV_ISSUE" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="iss.issue_no as issue" id="issue"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rev.revision_no as rev" id="rev"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@wp.ac_type@">
          <ds:object>@wp.ac_type@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT iss.issue_no as issue, rev.revision_no as rev
FROM msc_mp_revision rev
JOIN msc_mp_issue iss ON rev.issueno_i = iss.issueno_i
JOIN msc_maintenance_program mp ON iss.mpno_i = mp.mpno_i
WHERE mp.mpno = '@wp.ac_type@' 
AND mp.program_type = 'MP' 
AND (rev.revision_status = 'a' or rev.revision_status = 'b')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WP_MJSS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>MJSS</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ws.seqno_i as seqno" id="seqno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.workorderno_display as wo_nom" id="wo_nom"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" &#10;         decode (wo.event_type&#10;                       'C' 'Check'&#10;                       'T' 'BTC'&#10;                       'Q' 'SRT' &#10;                       'D' 'Doc.'&#10;                       'R' 'Rot. Req.'&#10;                       'V' 'RE'&#10;                       'O' 'ET WO'&#10;                       'W' 'Find. WO'&#10;                       'XX' 'Obs. RR'&#10;                       'E' 'Change Order'&#10;                       'SV' 'Shop Visit WO'&#10;                       'SC' 'Sim. Complaint WO'&#10;                       'I' 'Import WO'&#10;                       'P' 'Panel Workorder'&#10;                       'J' 'JIC Workorder''WO')  type" id="type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="fc.event_display as f_event" id="f_event"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" &#10;         LISTAGG(areas.area ``) WITHIN GROUP (ORDER BY areas.area) as area" id="area"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@wp.wpno@">
          <ds:object>@wp.wpno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  ws.seqno_i as seqno, wo.workorderno_display as wo_nom, 
         decode (wo.event_type,
                       'C', 'Check',
                       'T', 'BTC',
                       'Q', 'SRT', 
                       'D', 'Doc.',
                       'R', 'Rot. Req.',
                       'V', 'RE',
                       'O', 'ET WO',
                       'W', 'Find. WO',
                       'XX', 'Obs. RR',
                       'E', 'Change Order',
                       'SV', 'Shop Visit WO',
                       'SC', 'Sim. Complaint WO',
                       'I', 'Import WO',
                       'P', 'Panel Workorder',
                       'J', 'JIC Workorder',  
                       'WO')  type, 
         CASE WHEN wo.state='C' AND fc.event_display IS NULL
			  THEN wo.workorderno_display||'/'||wo_descr.header||' '|| CASE WHEN LENGTH(wo_descr.text)&gt;42 THEN SUBSTR(wo_descr.text, 1, 42)||'...' ELSE wo_descr.text END
			  ELSE fc.event_display
	     END as f_event,
         LISTAGG(areas.area, ', ') WITHIN GROUP (ORDER BY areas.area) as area 
FROM wp_header wph  
LEFT JOIN wp_assignment wa ON wph.wpno_i = wa.wpno_i  
LEFT JOIN wo_header wo ON  wo.event_perfno_i = wa.event_perfno_i 
LEFT JOIN forecast fc ON fc.event_perfno_i = wa.event_perfno_i 
LEFT JOIN wo_event_link wel ON wo.event_perfno_i = wel.event_perfno_i  
LEFT JOIN (SELECT max_ws.max_seqno_i as seqno_i,
				  max_ws.wpno_i as wpno_i,
				  max_ws.event_perfno_i as event_perfno_i
		   FROM (SELECT wp_sequence.event_perfno_i as event_perfno_i ,
						wp_sequence.wpno_i as wpno_i,
						wp_sequence.seqno_i as seqno_i,
						MAX (wp_sequence.seqno_i) OVER (PARTITION BY wp_sequence.event_perfno_i) as max_seqno_i
				 FROM 
				  		wp_sequence
				 WHERE
						wp_sequence.status&lt;&gt;9
				 ORDER BY 
						wp_sequence.event_perfno_i
				 ) max_ws
			WHERE max_ws.max_seqno_i=max_ws.seqno_i
		   ) ws ON ws.event_perfno_i = wo.event_perfno_i and ws.wpno_i = wph.wpno_i 
LEFT JOIN (
                SELECT DISTINCT area_code_link.ac_area as area, workstep_link.event_perfno_i as epi FROM area_code_link
                LEFT JOIN workstep_link ON area_code_link.source_pk = workstep_link.descno_i
                WHERE area_code_link.source_type = 'WS' OR (area_code_link.ac_area IS NULL AND area_code_link.source_type IS NULL)
) areas ON areas.epi = wo.event_perfno_i
LEFT JOIN (SELECT wo_text_description.header as header,
				  DBMS_lob.substr(wo_text_description.text,100,1) as text,
	              workstep_link.event_perfno_i as event_perfno_i
           FROM wo_text_description
           LEFT JOIN workstep_link ON wo_text_description.descno_i=workstep_link.descno_i
		   WHERE workstep_link.sequenceno=1
		  ) wo_descr ON wo.event_perfno_i=wo_descr.event_perfno_i
WHERE wph.wpno = '@wp.wpno@'    
AND ((wo.event_type = 'C' AND wo.issue_date is not null) OR (wo.event_type != 'C'))
GROUP BY ws.seqno_i, wo.workorderno_display, wo.event_type, fc.event_display, wo_descr.header, wo.state, wo_descr.text
ORDER BY ws.seqno_i asc</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WP_RRJ_852_FORM" type="SQL_EDITOR_DATASOURCE" version="2.0">
