      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 'Y' as contain_check
FROM DUAL
WHERE EXISTS (
                           SELECT wp_header.wpno
                           FROM wp_header
                           LEFT JOIN wp_assignment ON wp_header.wpno_i=wp_assignment.wpno_i
                           LEFT JOIN wo_event_link ON wp_assignment.event_perfno_i=wo_event_link.event_perfno_i
                           LEFT JOIN check_type_int ON wo_event_link.event_key_parent=check_type_int.check_intno_i
                           LEFT JOIN aircraft ON aircraft.ac_registr = wp_header.ac_registr
                           WHERE wp_header.wpno = '@wp.wpno@'
                                          AND (wo_event_link.event_type = 'CHTI' AND '@AMOS_VERSION@' LIKE '19.12%'
                                                     OR wo_event_link.event_type = 'MEС' AND '@AMOS_VERSION@' NOT LIKE '19.12%') 
                                         AND check_type_int.internal_check IN ('375FH', 'A01', 'A02', '1C', '2C', '4C')
                                         AND aircraft.ac_typ='RRJ'
                          )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WP_TRANSLATION_FLAG" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE when regexp_like(aircraft.ac_typ'RRJ*') THEN 'Y' ELSE 'N' END as print_rus" id="print_rus"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@wp.wpno@">
          <ds:object>@wp.wpno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT CASE when regexp_like(NVL(aircraft.ac_typ, wp_header.ac_typ), 'RRJ*') THEN 'Y' ELSE 'N' END as print_rus
FROM wp_header
LEFT JOIN aircraft ON wp_header.ac_registr=aircraft.ac_registr
WHERE wp_header.wpno = '@wp.wpno@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
