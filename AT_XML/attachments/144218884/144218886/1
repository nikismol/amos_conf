    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WP_INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Basic Workpackage Information</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.wpno" id="wph.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.station" id="wph.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(a.ac_registr_prefix || a.ac_registr) as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.serialno" id="a.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_typ" id="a.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_model" id="a.ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="address.vendor as ac_authority" id="ac_authority"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@wp.wpno@">
          <ds:object>@wp.wpno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
	wph.wpno,
	wph.station,
	(a.ac_registr_prefix || a.ac_registr) as ac_registr,
	a.serialno,
	a.ac_typ,
	a.ac_model,
              address.vendor as ac_authority
FROM wp_header wph
LEFT JOIN aircraft a ON wph.ac_registr = a.ac_registr
LEFT JOIN address ON a.auth_address_i = address.address_i
WHERE wph.wpno='@wp.wpno@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
