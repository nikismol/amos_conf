    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="FINDINGS_TABLE" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.qa_problemno_i" id="qa_item_find_problems.qa_problemno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_audit.qa_audit_name" id="qa_audit.qa_audit_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_audit.qa_auditno_i" id="qa_audit.qa_auditno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_audit.lead_auditor" id="qa_audit.lead_auditor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_location.location" id="qa_location.location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_pool.item" id="qa_item_pool.item"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_pool.requirement" id="qa_item_pool.requirement"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.problem" id="qa_item_find_problems.problem"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.action_taken" id="qa_item_find_problems.action_taken"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_priority.priority" id="qa_priority.priority"/>
        <ds:columnDescriptor amosType="DATE" description="qa_item_find_problems.date_due" id="qa_item_find_problems.date_due"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.date_due_ext1" id="qa_item_find_problems.date_due_ext1"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.date_due_ext2" id="qa_item_find_problems.date_due_ext2"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.date_closed" id="qa_item_find_problems.date_closed"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.answer_until" id="qa_item_find_problems.answer_until"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.reminder_date" id="qa_item_find_problems.reminder_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.responsible_person" id="qa_item_find_problems.responsible_person"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_item_find_problems.responsible_org" id="qa_item_find_problems.responsible_org"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="risk_severity.severity_no_i" id="risk_severity.severity_no_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="risk_probability.probability_no_i" id="risk_probability.probability_no_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       DECODE (CONCAT (risk_probability.probability_display_value risk_severity.severity_display_value) &#10;                                                                                               '1E' '1A1'&#10;                                                                        &#9;&#9;&#9;&#9;&#9;   '2E' '1B2'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '3E' '1C3'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '4E' '1D4'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '5E' '1E5'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '1D' '2A2'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '2D' '2B4'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '3D' '2C6'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '4D' '2D8'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '5D' '2E10'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '1C' '3A3'&#10;                                                                                               '2C' '3B6'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '3C' '3C9'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '4C' '3D12'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '5C' '3E15'&#10;&#9;&#9;       &#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '1B' '4A4'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '2B' '4B8'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '3B' '4C12'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '4B' '4D16'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '5B' '4E20'&#10;&#9;&#9;&#9;&#9;                                                                               '1A' '5A5'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '2A' '5B10'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '3A' '5C15'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '4A' '5D20'&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   '5A''5E25'&#10;                                                                                                               ) as risk" id="risk"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@QA@">
          <ds:object>@QA@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT qa_item_find_problems.qa_problemno_i,
       qa_audit.qa_audit_name,
       qa_audit.qa_auditno_i,
       qa_audit.lead_auditor,
       qa_location.location,
       qa_item_pool.item,
       qa_item_pool.requirement,
       qa_item_find_problems.problem,
       qa_item_find_problems.action_taken,
       qa_priority.priority,
       qa_item_find_problems.date_due,
       qa_item_find_problems.date_due_ext1,
       qa_item_find_problems.date_due_ext2,
       qa_item_find_problems.date_closed,
       qa_item_find_problems.answer_until,
       qa_item_find_problems.reminder_date,
       qa_item_find_problems.responsible_person,
       qa_item_find_problems.responsible_org,
       risk_severity.severity_no_i,
       risk_probability.probability_no_i,
       DECODE (CONCAT (risk_probability.probability_display_value, risk_severity.severity_display_value), 
                                                                                               																	   'A1', '1A1',
                                                                        					   													                  'A2', '2A2',
																							   'A3', '3A3',
																							   'A4', '4A4',
																							   'A5', '5A5',
																							   'B1', '1B2',
																							   'B2', '2B4',
																							   'B3', '3B6',
																							   'B4', '4B8',
																							   'B5', '5B10',
																							   'C1', '1C3',
                                                                                             																	   'C2', '2C6',
																							   'C3', '3C9',
																							   'C4', '4C12',
																							   'C5', '5C15',
		       																				   	   'D1', '1D4',
																							   'D2', '2D8',
																							   'D3', '3D12',
																							   'D4', '4D16',
																							   'D5', '5D20',
				                                                                               														    'E1', '1E5',
																							   'E2', '2E10',
																							   'E3', '3E15',
																							   'E4', '4E20',
																							   'E5', '5E25'
                                                                                                               ) as risk
       
FROM qa_item_findings_history
JOIN qa_audit ON qa_item_findings_history.qa_auditno_i = qa_audit.qa_auditno_i
JOIN qa_item_pool ON qa_item_findings_history.qa_itemno_i = qa_item_pool.qa_itemno_i
JOIN qa_finding_type ON qa_item_findings_history.qa_findno_i = qa_finding_type.qa_findno_i
JOIN qa_item_find_problems ON qa_item_findings_history.qa_find_historyno_i = qa_item_find_problems.qa_find_historyno_i
LEFT JOIN qa_location ON qa_audit.qa_locationno_i = qa_location.qa_locationno_i
LEFT JOIN qa_priority ON qa_item_find_problems.qa_priorityno_i = qa_priority.qa_priorityno_i
LEFT JOIN risk_severity ON qa_item_find_problems.qa_risk_severity = risk_severity.severity_no_i
LEFT JOIN risk_probability ON qa_item_find_problems.qa_risk_probability = risk_probability.probability_no_i
WHERE qa_finding_type.is_finding = 1
      AND qa_item_find_problems.date_closed IS NULL
      AND qa_audit.qa_auditno_i = @QA@
ORDER BY qa_item_find_problems.qa_problemno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="NOTES" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
