      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Audit_Checklist" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Quality Audit Checklist</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.qa_auditno_i" id="a.qa_auditno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;      to_char(sysdate'YY')" id="x2"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.qa_audit_name" id="a.qa_audit_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.description" id="a.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.notes" id="a.notes"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (a.scheduled+729)'DD.Mon.YYYY') as scheduled" id="scheduled"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.lead_auditor" id="a.lead_auditor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.distribution" id="a.distribution"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.assistant" id="a.assistant"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.assistant_2" id="a.assistant_2"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.assistant_3" id="a.assistant_3"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.checklist" id="a.checklist"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.duration" id="a.duration"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="c.category" id="c.category"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qa_organisation.description" id="qa_organisation.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="c.description" id="c.description"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@QA@">
          <ds:object>@QA@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT a.qa_auditno_i,
      to_char(sysdate,'YY'),
       a.qa_audit_name,
       a.description,
       a.notes,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (a.scheduled+729), 'DD.Mon.YYYY') as scheduled,
       a.lead_auditor,
       a.distribution,
       a.assistant,
       a.assistant_2,
       a.assistant_3,
       a.checklist,
       a.duration,
       c.category,
       qa_organisation.description,
       c.description
FROM qa_audit a
LEFT JOIN qa_category c ON c.qa_category_i = a.qa_category_i
LEFT JOIN qa_organisation ON a.checklist = qa_organisation.organisation
WHERE qa_auditno_i = @QA@</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AUDIT_ITEMS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Items from the audit</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.qa_sectionno_i" id="s.qa_sectionno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.title" id="s.title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.description" id="s.description"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@QA@">
          <ds:object>@QA@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT s.qa_sectionno_i,
       s.title,
       s.description
FROM qa_audit_section s
WHERE s.qa_auditno_i = @QA@
ORDER BY s.section_order</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Audit_table" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Checklist</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.item" id="p.item"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.requirement" id="p.requirement"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AUDIT_ITEMS.s.qa_sectionno_i@">
          <ds:object>@AUDIT_ITEMS.s.qa_sectionno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT p.item,
       p.requirement
FROM qa_item_pool p
LEFT JOIN qa_audit_section_item si ON p.qa_itemno_i = si.qa_itemno_i
WHERE si.qa_sectionno_i = @AUDIT_ITEMS.s.qa_sectionno_i@
ORDER BY si.item_order </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
