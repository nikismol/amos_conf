  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="STOO" description="" id="store_from"/>
        <ds:columnDescriptor amosType="STA" description="" id="station_from"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_to"/>
        <ds:columnDescriptor amosType="BOOL" description="" id="hanging"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_from"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Store From" id="store_from">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
