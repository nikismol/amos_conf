    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_RMT" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_header.pickslipno as pickslipno" id="pickslipno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.partno as booked_pn" id="booked_pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.serialno as booked_sn" id="booked_sn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (pickslip_header.pickslip_date+729)'DD.MM.YYYY') as booking_date" id="booking_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.owner as owner" id="owner"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_header.receiver as receiver" id="receiver"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_header.station_to as station_to" id="station_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_header.store_to as store_to" id="store_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.location as current_location" id="current_location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.station as current_station" id="current_station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.store as current_store" id="current_store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.owner as current_owner" id="current_owner"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.pickslipseqno_i" id="h.pickslipseqno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.labelno" id="h.labelno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h.vm!='TS' THEN h2.partno ELSE '' END as off_partno" id="off_partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h.vm!='TS' THEN h2.serialno ELSE '' END as off_serialno" id="off_serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.vm as vm" id="vm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.voucherno as voucherno" id="voucherno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h.vm!='TS' THEN off_r_location.location ELSE '' END as current_off_r_location" id="current_off_r_location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h.vm!='TS' THEN off_r_location.station ELSE '' END as current_off_r_station" id="current_off_r_station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h.vm!='TS' THEN off_r_location.store ELSE '' END as current_off_r_store" id="current_off_r_store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date+729)'DD.MM.YYYY') as last_vm_date" id="last_vm_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_last_vm.vm_description||' '||'('||h_last_vm.vm||')' as last_vm" id="last_vm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_last_vm.voucherno as last_voucherno" id="last_voucherno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (h_last_vm_removal.del_date+729)'DD.MM.YYYY') as last_vm_date_removal" id="last_vm_date_removal"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_last_vm_removal.vm_description||' '||'('||h_last_vm_removal.vm||')' as last_vm_removal" id="last_vm_removal"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_last_vm_removal.voucherno as last_voucherno_removal" id="last_voucherno_removal"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.station_from@">
          <ds:object>@VAR.station_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.store_from@">
          <ds:object>@VAR.store_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.hanging@">
          <ds:object>@VAR.hanging@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT DISTINCT pickslip_header.pickslipno as pickslipno,
	   pickslip_booked.partno as booked_pn,
	   pickslip_booked.serialno as booked_sn,
	   TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (pickslip_header.pickslip_date+729), 'DD.MM.YYYY') as booking_date,
	   pickslip_booked.owner as owner,
	   pickslip_header.receiver as receiver,
	   pickslip_header.station_to as station_to,
	   pickslip_header.store_to as store_to,
	   location.location as current_location,
	   location.station as current_station,
	   location.store as current_store,
	   rotables.owner as current_owner,
	   h.pickslipseqno_i,
	   h.labelno,

	   CASE WHEN h.vm!='TS' THEN h2.partno ELSE '' END as off_partno,
	   CASE WHEN h.vm!='TS' THEN h2.serialno ELSE '' END as off_serialno,
	   h.vm_description||' '||'('||h.vm||')' as vm,
	   h.voucherno as voucherno,

	   CASE WHEN h.vm!='TS' THEN off_r_location.location ELSE '' END as current_off_r_location,
	   CASE WHEN h.vm!='TS' THEN off_r_location.station ELSE '' END as current_off_r_station,
	   CASE WHEN h.vm!='TS' THEN off_r_location.store ELSE '' END as current_off_r_store,
	   TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (h_last_vm.del_date+729), 'DD.MM.YYYY') as last_vm_date,
	   h_last_vm.vm_description||' '||'('||h_last_vm.vm||')' as last_vm,
	   h_last_vm.voucherno as last_voucherno,

	   CASE WHEN h.vm!='TS' AND h2.psn IS NOT NULL THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (h_last_vm_removal.del_date+729), 'DD.MM.YYYY') ELSE '' END as last_vm_date_removal,
	   CASE WHEN h.vm!='TS' AND h2.psn IS NOT NULL THEN h_last_vm_removal.vm_description||' '||'('||h_last_vm_removal.vm||')' ELSE '' END as last_vm_removal,
	   CASE WHEN h.vm!='TS' AND h2.psn IS NOT NULL THEN h_last_vm_removal.voucherno ELSE '' END as last_voucherno_removal

FROM
pickslip_header
LEFT JOIN (
		   SELECT DISTINCT aircraft.ac_registr as receiver,
       	          'AIRCRAFT' as type
		   FROM aircraft 
           WHERE aircraft.status &lt;&gt; 9 
           UNION 
           SELECT costcenter.costcenter as receiver,
                  'COSTCENTER' as type
           FROM costcenter 
           WHERE costcenter.status &lt;&gt; 9 
                 AND costcenter.material_affected = 'Y'
		  ) receiver_type ON pickslip_header.receiver=receiver_type.receiver
LEFT JOIN station_store ON pickslip_header.store_from=station_store.store
LEFT JOIN pickslip_booked ON pickslip_header.pickslipno=pickslip_booked.pickslipno
LEFT JOIN rotables ON pickslip_booked.partno=rotables.partno AND pickslip_booked.serialno=rotables.serialno
LEFT JOIN location ON rotables.locationno_i=location.locationno_i
LEFT JOIN (
		   SELECT history.pickslipseqno_i as pickslipseqno_i,
		   		  history.historyno_i as historyno_i,
				  history.labelno as labelno,
				  history.psn as psn,
				  history.vm as vm,
				  voucher_mode.description as vm_description,
				  history.voucherno as voucherno,
				  MAX (history.historyno_i) OVER (PARTITION BY history.pickslipseqno_i) as max_historyno_i,
				  history.del_date as del_date
		   FROM history
		   LEFT JOIN voucher_mode ON history.vm=voucher_mode.vm
	   	   WHERE history.labelno != 0
		  ) h ON pickslip_booked.pickslipseqno_i=h.pickslipseqno_i

LEFT JOIN (SELECT history.labelno as labelno,
		          history.partno as partno,
				  history.serialno as serialno,
				  history.psn as psn,
				  history.pickslipseqno_i as pickslipseqno_i,
				  history.historyno_i as historyno_i
           FROM history
		   WHERE history.vm='YA'
		  ) h2 ON h.labelno=h2.labelno
LEFT JOIN rotables off_rotables ON h2.psn=off_rotables.psn
LEFT JOIN location off_r_location ON off_rotables.locationno_i=off_r_location.locationno_i
LEFT JOIN (
		   SELECT max_h.psn as psn,
				  max_h.historyno_i as historyno_i,
      			  max_h.del_date as del_date,
				  max_h.vm as vm,
				  max_h.vm_description as vm_description,
				  max_h.voucherno as voucherno,
				  max_h.max_historyno_i,
				  max_h.max_del_date
		   FROM    (
				       SELECT history.psn as psn,
				              history.historyno_i as historyno_i,
      			              history.del_date as del_date,
				              history.vm as vm,
				              voucher_mode.description as vm_description,
				              history.voucherno as voucherno,
				              MAX (history.historyno_i) OVER (PARTITION BY history.psn,history.del_date) as max_historyno_i,
				              MAX (history.del_date) OVER (PARTITION BY history.psn) as max_del_date
		               FROM history
		               LEFT JOIN voucher_mode ON history.vm=voucher_mode.vm
				   ) max_h
		   WHERE
				 max_h.del_date=max_h.max_del_date
                 AND max_h.historyno_i=max_h.max_historyno_i
		  ) h_last_vm ON h.psn=h_last_vm.psn
LEFT JOIN (
		   SELECT max_h_rem.psn as psn,
				  max_h_rem.historyno_i as historyno_i,
      			  max_h_rem.del_date as del_date,
				  max_h_rem.vm as vm,
				  max_h_rem.vm_description as vm_description,
				  max_h_rem.voucherno as voucherno,
				  max_h_rem.max_historyno_i,
				  max_h_rem.max_del_date
		   FROM    (
				       SELECT history.psn as psn,
				              history.historyno_i as historyno_i,
      			              history.del_date as del_date,
				              history.vm as vm,
				              voucher_mode.description as vm_description,
				              history.voucherno as voucherno,
				              MAX (history.historyno_i) OVER (PARTITION BY history.psn,history.del_date) as max_historyno_i,
				              MAX (history.del_date) OVER (PARTITION BY history.psn) as max_del_date
		               FROM history
		               LEFT JOIN voucher_mode ON history.vm=voucher_mode.vm
				   ) max_h_rem
		   WHERE
				 max_h_rem.del_date=max_h_rem.max_del_date
                 AND max_h_rem.historyno_i=max_h_rem.max_historyno_i
		  ) h_last_vm_removal ON h2.psn=h_last_vm_removal.psn
WHERE
pickslip_header.pickslip_date &gt;='@VAR.date_from@'
AND pickslip_header.pickslip_date &lt;='@VAR.date_to@'
AND (REGEXP_LIKE(pickslip_header.station_from, REPLACE('@VAR.station_from@', ', ', '|')) OR '@VAR.station_from@' IS NULL)
AND (REGEXP_LIKE(station_store.station_storeno_i, REPLACE('@VAR.store_from@', ', ', '|')) OR '@VAR.store_from@' IS NULL)
AND (
	 '@VAR.hanging@'='N'
	 OR
	 '@VAR.hanging@'='Y' AND (
	                          location.location IN ('HANGAR', 'TRANSFER')
	                          AND location.station IN ('SVO', 'SHRM')
	                          AND h_last_vm.del_date&lt;=@VAR.date_to@-4
	                          OR
	                          location.location IN ('AIRCRAFT', 'TREE')
                              AND h.vm!='TS'
                              AND h2.psn IS NOT NULL
                              AND off_r_location.location IN ('HANGAR', 'TRANSFER')
	                          AND h_last_vm_removal.del_date&lt;=@VAR.date_to@-4
	                         )
	)
AND pickslip_header.status NOT IN (0,1,8,10)
AND pickslip_booked.qty_booked &gt; 0
AND pickslip_booked.serialno IS NOT NULL
AND pickslip_booked.serialno!=' '
AND h.historyno_i=h.max_historyno_i

ORDER BY booking_date</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
