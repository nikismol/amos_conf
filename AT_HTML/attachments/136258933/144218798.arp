  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="mult_ac_typ"/>
        <ds:columnDescriptor amosType="AC" description="" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="sort_order"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Типы ВС в отчете" id="mult_ac_typ">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>A32S&amp;=&amp;A32S;A330&amp;=&amp;A330;B737&amp;=&amp;B737;B777&amp;=&amp;B777;A350&amp;=&amp;A350;ALL&amp;=&amp;Все типы;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>ALL</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="ВС (пустое=все)" id="ac_registr">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Сортировка записей по" id="sort_order">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>wonum&amp;=&amp;Номер WO;melnum&amp;=&amp;Номер пункта MEL;mel_date&amp;=&amp;Дата последнего Transfer;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>wonum</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MEL_CurrentDateTime" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(SYSDATE'MM-DD-YYYY') as f_date" id="f_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(SYSDATE'HH24:MI:SS') as f_time" id="f_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	TO_CHAR(SYSDATE, 'MM.DD.YYYY') as f_date,
	TO_CHAR(SYSDATE, 'HH24:MI:SS') as f_time
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MEL_MainACTyp" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ.ac_typ" id="ac_typ.ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.mult_ac_typ@">
          <ds:object>@VAR.mult_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ac_typ.ac_typ
FROM ac_typ
LEFT JOIN aircraft ON aircraft.ac_typ = ac_typ.ac_typ
WHERE 
	((ac_typ.ac_typ = 'A32S' AND (REGEXP_LIKE('A32S', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR REGEXP_LIKE('A321', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL'))
OR 
	(ac_typ.ac_typ = 'A330' AND (REGEXP_LIKE('A330', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR REGEXP_LIKE('A333', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL'))
OR 
	(ac_typ.ac_typ = 'A350' AND (REGEXP_LIKE('A350', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR REGEXP_LIKE('A350', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL'))
OR 
	ac_typ.ac_typ = 'B737' AND (REGEXP_LIKE('B737', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL')
OR 
	ac_typ.ac_typ = 'B777' AND (REGEXP_LIKE('B777', REPLACE('@VAR.mult_ac_typ@', ', ', '|')) OR '@VAR.mult_ac_typ@' = 'ALL'))
AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.ac_registr@', ', ', '|')) OR '@VAR.ac_registr@' IS NULL)
GROUP BY ac_typ.ac_typ
ORDER BY ac_typ.ac_typ
/*AFL_MEL2*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_MEL_Main" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.text as c_wo_step_text" id="c_wo_step_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.mel_code" id="wo_header.mel_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_header.issue_date+729)'DD.MM.YYYY') as wo_issue_date" id="wo_issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header_more.mel_chapter" id="wo_header_more.mel_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" DECODE(wo_header.type 'M' 'Maint.' 'P' 'PiRep' 'C' 'Cabin''Unknown') as wo_type" id="wo_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_transfer.absolute_due_date+729)'DD.MM.YYYY') as wo_due_date" id="wo_due_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno as partno" id="partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_MEL_MainACTyp.ac_typ.ac_typ@">
          <ds:object>@AFL_MEL_MainACTyp.ac_typ.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.sort_order@">
          <ds:object>@VAR.sort_order@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    wo_header.ac_registr,
    aircraft.ac_typ,
    wo_header.event_perfno_i,
    wo_text_description.text as c_wo_step_text,
    wo_header.mel_code,
    TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.issue_date+729), 'DD.MM.YYYY') as wo_issue_date,
    wo_header_more.mel_chapter,
    DECODE(wo_header.type, 'M', 'Maint.', 'P', 'PiRep', 'C', 'Cabin', 'Unknown') as wo_type,
    TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_transfer.absolute_due_date+729), 'DD.MM.YYYY') as wo_due_date,
    part.partno as partno
FROM wo_header
LEFT JOIN aircraft ON aircraft.ac_registr = wo_header.ac_registr
LEFT JOIN workstep_link ON (workstep_link.event_perfno_i = wo_header.event_perfno_i AND workstep_link.sequenceno = 1)
LEFT JOIN wo_text_description ON wo_text_description.descno_i = workstep_link.descno_i
LEFT JOIN wo_transfer ON (wo_header.event_perfno_i = wo_transfer.event_perfno_i AND wo_transfer.is_last_transfer = 'Y')
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN wo_opus ON wo_header.event_perfno_i = wo_opus.event_perfno_i
LEFT JOIN wo_header_4 on wo_header_4.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN mel_detail ON mel_detail.mel_detailno_i = wo_header_4.mel_detailno_i
LEFT JOIN mel_tree ON mel_detail.mel_treeno_i = mel_tree.mel_treeno_i
LEFT JOIN mel_procedure ON mel_procedure.mel_treeno_i = mel_tree.mel_treeno_i
LEFT JOIN mel_revision mrm ON mel_tree.melno_i = mrm.melno_i AND (mrm.active='Y' OR NVL(aircraft.ac_typ, 1) != 'RRJ') AND mrm.type='M'
LEFT JOIN (
	SELECT
		limitation_config.configuration_key as event_perfno_i,
		'&lt;b&gt;WO Downgrades (limitations):&lt;/b&gt;&lt;br /&gt;'||LISTAGG(TO_CHAR(limitation_type.limitation_type)||': '||TO_CHAR(limitation_type.description), '; ') WITHIN GROUP (ORDER BY limitation_type.limitation_type, limitation_type.description)  as limitations_agg
	FROM limitation_config
	LEFT JOIN limitation_type ON limitation_type.limitation_typeno_i = limitation_config.limitation_typeno_i
	WHERE limitation_config.mime_type = 'WO'
	GROUP BY limitation_type.limitation_type, limitation_type.description, limitation_config.configuration_key
) ac_lim ON ac_lim.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN (
    SELECT
        wh.event_perfno_i,
        listagg(case when stock.alt_qty is null and stock.part_qty is null THEN ('PN: ' || to_char(pr2.partno))||(' Desc: ' || p.description) ||(' QTY: '||to_number(pr2.qty)) end, ',  ') as partno
    FROM wo_header wh
        left join workstep_link wl on wh.event_perfno_i=wl.event_perfno_i
        left join part_request_2 pr2 on wl.workstep_linkno_i=pr2.event_key and pr2.event_type='WSL'
        left join part p on pr2.partno = p.partno
        left join 	(
            SELECT
                stock.partno as partno,
                stock.description as description,
                stock.mat_class as mat_class,
                stock.altpartno as altpartno,
                stock.part_qty,
                stock.alt_qty
            FROM (
                SELECT distinct
                    CASE WHEN REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
                    part.description as description,
                    DECODE (part.mat_class, 'C', 'Consumable',
                                				'E', 'Expendable',
                                				'R', 'Rotable',
                                				'S', 'Service'
               		          ) as mat_class,
                    CASE WHEN REGEXP_LIKE(alt_parts_cons.altpartno, '^[0-9]+$') THEN chr(39)||alt_parts_cons.altpartno ELSE alt_parts_cons.altpartno END as  altpartno,
                    cons_stock_qty.part_qty as part_qty,
                    alt_parts_cons.alt_qty as  alt_qty
                FROM part
                LEFT JOIN (
    			     SELECT
			         	part.partno,
			         	part_alternate.altpartno,
			         	SUM(consumables.qty) AS alt_qty
			         FROM part
			         	JOIN part_alternate ON part_alternate.partno = part.partno
			         	LEFT JOIN consumables ON part_alternate.altpartno = consumables.partno
			         	LEFT JOIN location ON consumables.locationno_i = location.locationno_i
			         WHERE 1=1
			         	AND consumables.owner = 'AFL'
			         	AND consumables.condition &lt;&gt; 'US'
			            AND location.station='SVO'
			         GROUP BY part.partno, part_alternate.altpartno
			         ) alt_parts_cons ON part.partno = alt_parts_cons.partno
                LEFT JOIN (
			         SELECT
			        	 part.partno,
			         	SUM(consumables.qty) AS part_qty
			         FROM part
			         	JOIN consumables on part.partno = consumables.partno
			         	JOIN location ON consumables.locationno_i = location.locationno_i
			         WHERE 1=1
			         	AND consumables.owner = 'AFL'
			         	AND consumables.condition &lt;&gt; 'US'
			            AND location.station='SVO'
			         GROUP BY part.partno
			     ) cons_stock_qty ON part.partno = cons_stock_qty.partno
                WHERE part.mat_class &lt;&gt;  'R'
            UNION
            SELECT distinct
                CASE WHEN REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
                part.description as description,
                DECODE (part.mat_class, 'C', 'Consumable',
                            			'E', 'Expendable',
                            			'R', 'Rotable',
                                        'S', 'Service'
                		) as mat_class,
                alt_parts_rot.altpartno as altpartno,
                rot_stock_qty.part_qty,
                alt_parts_rot.alt_qty
            FROM part
            LEFT JOIN (
		        SELECT
		        	part.partno,
		        	part_alternate.altpartno,
		        	count(rotables.psn) AS alt_qty
		        FROM part
		        	LEFT JOIN part_alternate ON part.partno = part_alternate.partno
			        LEFT JOIN rotables on part_alternate.altpartno = rotables.partno
			        LEFT JOIN location ON rotables.locationno_i = location.locationno_i
		        WHERE 1=1
			        AND rotables.owner = 'AFL'
			        AND rotables.condition &lt;&gt; 'US'
		            AND location.station='SVO'
			        GROUP BY part.partno, part_alternate.altpartno
		        ) alt_parts_rot ON part.partno = alt_parts_rot.partno
                LEFT JOIN (
                    SELECT
                        part.partno,
                        count(rotables.psn) AS part_qty
		            FROM part
		        	LEFT JOIN rotables on part.partno = rotables.partno
			        LEFT JOIN location ON rotables.locationno_i = location.locationno_i
		            WHERE 1=1
		        	    AND rotables.condition &lt;&gt; 'US'
		        	    AND rotables.owner = 'AFL'
		                AND location.station='SVO'
		            GROUP BY part.partno
		        ) rot_stock_qty ON part.partno = rot_stock_qty.partno
                WHERE part.mat_class not in ( 'C', 'E', 'S')
                ) stock
            ) stock on pr2.partno = stock.partno
    where wl.workstep_state is null
    group by wh.event_perfno_i
    ) part on wo_header.event_perfno_i=part.event_perfno_i
WHERE
    (
        wo_header.mel_code IS NOT NULL
            AND
        (
            (
                aircraft.ac_typ = 'A32S' AND (
                    regexp_like(wo_header_more.mel_chapter, '25-20-02(-?(A|B|C|D|E|F))', 'i')
                    )
                )
                OR
            (
                aircraft.ac_typ = 'A350' AND (
                    regexp_like(wo_header_more.mel_chapter, '25-21-02(-?(A|B))', 'i')
                    )
                )
                OR
            (
                aircraft.ac_typ = 'A330' AND (
                    regexp_like(wo_header_more.mel_chapter, '25-20-02(-?(A|B|E|F))', 'i')
                    )
                )
                OR
            (
                aircraft.ac_typ = 'B737' AND (
                    regexp_like(wo_header_more.mel_chapter, '25-06-01-01(-?(A|B))', 'i')
                        OR
                    regexp_like(wo_header_more.mel_chapter, '25-06-01-02(-?(A|B))', 'i')
	        OR
	     wo_header_more.mel_chapter = '25-06-02-01'
                    )
                )
                OR
            (
                aircraft.ac_typ = 'B777' AND (
                    regexp_like(wo_header_more.mel_chapter, '25-25-02-01(-?(A|B|C|D|F|G))', 'i')
                    )
                )
            )
        )
    AND wo_header.state = 'O'
    AND aircraft.status&lt;&gt;9
    AND (aircraft.ac_typ = '@AFL_MEL_MainACTyp.ac_typ.ac_typ@')
    AND wo_header.type != 'S'
    AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.ac_registr@', ', ', '|')) OR '@VAR.ac_registr@' IS NULL)
    AND (
        mel_tree.version = (
            SELECT MAX (mt.version)
            FROM mel_tree mt
            WHERE mel_tree.mel_treeno_i = mt.mel_treeno_i
                AND mel_tree.revision = mt.revision
      )
        OR mel_tree.version IS NULL
      )
    AND (
        mel_tree.revision = (
        SELECT MAX (mt.revision)
        FROM mel_tree mt
        WHERE mel_tree.mel_treeno_i = mt.mel_treeno_i
            AND mt.revision &lt;= mrm.revision
      )
        OR mel_tree.revision IS NULL
      )
    AND (
        mel_detail.version = (
            SELECT MAX (md.version)
            FROM mel_detail md
            WHERE mel_detail.mel_detailno_i = md.mel_detailno_i
                AND mel_detail.revision = md.revision
    )
        OR mel_detail.version IS NULL
    )
    AND (
        mel_detail.revision = (
            SELECT MAX (md.revision)
            FROM mel_detail md
            WHERE mel_detail.mel_detailno_i = md.mel_detailno_i
            AND md.revision &lt;= mrm.revision
    )
        OR mel_detail.revision IS NULL
    )
    AND (
        mel_procedure.version = (
            SELECT MAX (mp.version)
            FROM mel_procedure mp
            WHERE mel_procedure.mel_treeno_i = mp.mel_treeno_i
                AND mel_procedure.revision = mp.revision
    )
      OR mel_procedure.version IS NULL
    )
ORDER BY
    CASE WHEN '@VAR.sort_order@' = 'wonum' THEN wo_header.ac_registr END ASC,
    CASE WHEN '@VAR.sort_order@' = 'wonum' THEN wo_header.event_perfno_i END DESC,
    CASE WHEN '@VAR.sort_order@' = 'melnum' THEN wo_header_more.mel_chapter END DESC,
    CASE WHEN '@VAR.sort_order@' = 'melnum' THEN wo_header.event_perfno_i END DESC,
    CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_transfer.date_transfer END DESC,
    CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_transfer.transfer_time END DESC,
    CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_header.ac_registr END DESC,
    CASE WHEN '@VAR.sort_order@' = 'mel_date' THEN wo_header.event_perfno_i END DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
