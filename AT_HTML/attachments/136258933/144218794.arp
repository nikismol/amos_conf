  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="WO" description="" id="v01_wo"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="01. Workorder" id="v01_wo">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WO_PR_Worksteps_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link.workstep_linkno_i as workstep_linkno_i" id="workstep_linkno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (workstep_link.workstep_date)'DD.MM.YYYY') as ws_date" id="ws_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(trunc(sysdate) + workstep_link.workstep_time/24/60'hh24:mi') as ws_time" id="ws_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link.sequenceno as sequenceno" id="sequenceno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_wo@">
          <ds:object>@VAR.v01_wo@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  wo_header.event_perfno_i as event_perfno_i
              ,workstep_link.workstep_linkno_i as workstep_linkno_i
              ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (workstep_link.workstep_date), 'DD.MM.YYYY') as ws_date
              ,TO_CHAR(trunc(sysdate) + workstep_link.workstep_time/24/60, 'hh24:mi') as ws_time
              ,workstep_link.sequenceno as sequenceno
FROM wo_header
JOIN workstep_link ON wo_header.event_perfno_i = workstep_link.event_perfno_i
WHERE wo_header.event_perfno_i = @VAR.v01_wo@
ORDER BY sequenceno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WO_PR_Workstep_detail" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rownum as rn" id="rn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (workstep_link.workstep_date)'DD.MM.YYYY') as ws_date" id="ws_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(trunc(sysdate) + workstep_link.workstep_time/24/60'hh24:mi') as ws_time" id="ws_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link.sequenceno as sequenceno" id="sequenceno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.text as ws_text" id="ws_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.text_html as ws_text_html" id="ws_text_html"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link.workstep_sign as workstep_sign" id="workstep_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (wo_text_action.action_date)'DD.MM.YYYY') as action_date" id="action_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(trunc(sysdate) + wo_text_action.action_time/24/60'hh24:mi') as action_time" id="action_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_action.text as action_text" id="action_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_action.actionno_i" id="wo_text_action.actionno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE(wo_text_action.sign_performed NULL NULL'Performed Sign: '||wo_text_action.sign_performed) as perf_sign" id="perf_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE(wo_text_action.sign_inspected NULL NULL'Inspection Sign: '||wo_text_action.sign_inspected) as insp_sign" id="insp_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE(wo_text_action.sign_double_inspected NULL NULL'Independent Inspection (DI): '||wo_text_action.sign_double_inspected) as di_sign" id="di_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_req.part_req_info as part_req_info" id="part_req_info"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ch.comp_change as comp_change" id="comp_change"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@WO_PR_Worksteps_MAIN.event_perfno_i@">
          <ds:object>@WO_PR_Worksteps_MAIN.event_perfno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@WO_PR_Worksteps_MAIN.workstep_linkno_i@">
          <ds:object>@WO_PR_Worksteps_MAIN.workstep_linkno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  row_number () over (order by wo_text_action.actionno_i) as rn
                ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (workstep_link.workstep_date), 'DD.MM.YYYY') as ws_date
                ,TO_CHAR(trunc(sysdate) + workstep_link.workstep_time/24/60, 'hh24:mi') as ws_time
                ,workstep_link.sequenceno as sequenceno
                ,wo_text_description.text as ws_text
                ,wo_text_description.text_html as ws_text_html
                ,workstep_link.workstep_sign as workstep_sign
                ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wo_text_action.action_date), 'DD.MM.YYYY') as action_date
                ,TO_CHAR(trunc(sysdate) + wo_text_action.action_time/24/60, 'hh24:mi') as action_time
                ,wo_text_action.text as action_text
                ,wo_text_action.actionno_i
                ,DECODE(wo_text_action.sign_performed, NULL, NULL, 'Performed Sign: '||wo_text_action.sign_performed) as perf_sign
                ,DECODE(wo_text_action.sign_inspected, NULL, NULL, 'Inspection Sign: '||wo_text_action.sign_inspected) as insp_sign
                ,DECODE(wo_text_action.sign_double_inspected, NULL, NULL, 'Independent Inspection (DI): '||wo_text_action.sign_double_inspected) as di_sign
                ,part_req.part_req_info as part_req_info
                ,ch.comp_change as comp_change
FROM workstep_link
JOIN wo_text_description ON workstep_link.descno_i = wo_text_description.descno_i
LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i = wo_text_action.workstep_linkno_i
LEFT JOIN (
                    SELECT workstep_link.workstep_linkno_i,
                                   LISTAGG(
                                                    'PN: '
                                                    ||part.partno
                                                    ||' DESC: '
                                                    ||CASE WHEN part.description IS NULL THEN '*** UNKNOWN PART ***' ELSE part.description END
                                                    ||' QTY: '
                                                    ||TO_CHAR(TRUNC(TO_NUMBER(part_request_2.qty), 2))
                                                    ||' '
                                                    ||part.measure_unit
                                                    ||' ON_STOCK: '
                                                    ||CASE WHEN part_request_2.status IN ('1', '2') THEN 'Closed'
                                                                   WHEN part_request_2.status='3' THEN 'Suspended'
                                                                   ELSE CASE WHEN planned_station IS NULL THEN TO_CHAR(TRUNC(TO_NUMBER(part_forecast.accessable_system_qty), 2))
                                                                                        ELSE TO_CHAR(TRUNC(TO_NUMBER(part_forecast.accessable_station_qty), 2))
                                                                             END
                                                        END
                                                     ||' FORECAST: '
                                                     ||DECODE(part_forecast.status,
                                                                           0, 'New',
                                                                           1, 'Unavaliable',
                                                                           2, 'Unavaliable',
                                                                           3, 'Ordered',
                                                                           4, 'Needs_Trensfer',
                                                                           5, '-',
                                                                           6, 'Avaliable',
                                                                           7, 'Avaliable',
                                                                           8, 'Externally_Provisioned',
                                                                           '-'
                                                                         ) 
                                                     , ';'||CHR(10)
                                                    ) WITHIN GROUP (ORDER BY part_request_2.part_requestno_i) as part_req_info
                    FROM workstep_link
                    JOIN part_request_2 ON workstep_link.workstep_linkno_i = part_request_2.event_key and part_request_2.event_type='WSL'
                    LEFT JOIN part ON part_request_2.partno=part.partno
                    LEFT JOIN part_forecast ON part_request_2.part_requestno_i=part_forecast.part_requestno_i
                    WHERE 1=1
                                   AND workstep_link.event_perfno_i = @WO_PR_Worksteps_MAIN.event_perfno_i@
                    GROUP BY workstep_link.workstep_linkno_i
                   ) part_req ON workstep_link.workstep_linkno_i=part_req.workstep_linkno_i
LEFT JOIN (
                    SELECT wo_part_on_off.actionno_i,
                                   LISTAGG (
                                                     DECODE(wo_part_on_off.partno,
                                                                      NULL, NULL,
                                                                      'ON:'
                                                                     ||CHR(10)
                                                                     ||'pn '
                                                                     ||wo_part_on_off.partno
                                                                     ||CHR(10)
                                                                     ||'sn '
                                                                     ||wo_part_on_off.serialno
                                                                    )
                                                     || DECODE(wo_part_on_off.partno,
                                                                            NULL, NULL,
                                                                            CHR(10)
                                                                            ||'OFF:'
                                                                            ||CHR(10)
                                                                            ||'pn '
                                                                            ||wo_part_on_off.partno_off
                                                                            ||CHR(10)
                                                                            ||'sn '
                                                                            ||wo_part_on_off.serialno_off
                                                                            )
                                                     , ';'||CHR(10)||CHR(10)
                                                    ) WITHIN GROUP (ORDER BY wo_part_on_off.partno) as comp_change
                    FROM wo_part_on_off
                    GROUP BY wo_part_on_off.actionno_i 
                   ) ch ON ch.actionno_i=wo_text_action.actionno_i
WHERE 1=1
               AND workstep_link.event_perfno_i = @WO_PR_Worksteps_MAIN.event_perfno_i@
               AND workstep_link.workstep_linkno_i = @WO_PR_Worksteps_MAIN.workstep_linkno_i@
ORDER BY actionno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
