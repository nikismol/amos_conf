    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="ACTYPES" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="decode ('@VAR.actip@' &#10;               'A332' 'A330-200'&#10;               'A333' 'A330-300'&#10;               'B738' 'B737'&#10;               'B763' 'B767'&#10;               'B77' 'B777'&#10;               'RRJ95B' 'RRJ95''@VAR.actip@') atype" id="atype"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.actip@">
          <ds:object>@VAR.actip@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT decode ('@VAR.actip@', 
               'A332', 'A330-200',
               'A333', 'A330-300',
               'B738', 'B737',
               'B763', 'B767',
               'B77W', 'B777',
               'RRJ95B', 'RRJ95', 
               'A350', 'A359',
               '@VAR.actip@') atype 
FROM dual</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_WO_Mhrs" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="(SUM(time_captured.duration)/60) as perf_dec" id="perf_dec"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;to_char(trunc(sysdate) + SUM(time_captured.duration)/24'hh24:mi') as perf_hrs" id="perf_hrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as type" id="type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr as tail" id="tail"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.workorderno_display as wono" id="wono"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.closing_date as cdate" id="cdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mhrs_requested.request_minutes/60 as planned_dec" id="planned_dec"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;to_char(trunc(sysdate) + mhrs_requested.request_minutes/24/60'hh24:mi') as planned_hrs" id="planned_hrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.workgroup as workgroup" id="workgroup"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mhrs_requested.woc as classification" id="classification"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.user_sign as user_sign" id="user_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_captured.scope as scope" id="scope"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_captured.qualification as skill" id="skill"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="check_type.check_type as check_type" id="check_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;               TO_CHAR(TO_DATE(TO_CHAR(wo_header.release_time'0000')'HH24MI')'HH24:MI') as wo_closing_time" id="wo_closing_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.department as department" id="department"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.begin@">
          <ds:object>@VAR.begin@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end@">
          <ds:object>@VAR.end@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.actip@">
          <ds:object>@VAR.actip@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.department@">
          <ds:object>@VAR.department@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ROUND((SUM(time_captured.duration)/60), 2) as perf_dec,
               to_char(trunc(sysdate) + SUM(time_captured.duration)/24/60, 'hh24:mi') as perf_hrs,
               aircraft.ac_typ as type,
               wo_header.ac_registr as tail,
               wo_header.workorderno_display as wono,
               TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.closing_date+729), 'DD.MM.YYYY') as cdate,
               ROUND(mhrs_requested.request_minutes/60, 2) as planned_dec,
               to_char(trunc(sysdate) + mhrs_requested.request_minutes/24/60, 'hh24:mi') as planned_hrs,
               sign.workgroup as workgroup,
               mhrs_requested.woc as classification,
               sign.user_sign as user_sign,
               time_captured.scope as scope,
               time_captured.qualification as skill,
               check_type.check_type as check_type,
               TO_CHAR(TO_DATE(TO_CHAR(wo_header.release_time,'0000'),'HH24MI'),'HH24:MI') as wo_closing_time,
               sign.department as department
FROM time_captured 
LEFT JOIN wo_header ON wo_header.event_perfno_i = time_captured.primkey
LEFT JOIN aircraft ON aircraft.ac_registr = wo_header.ac_registr
LEFT JOIN sign ON sign.user_sign = time_captured.user_sign
LEFT JOIN time_captured_additional ON time_captured.bookingno_i = time_captured_additional.bookingno_i
LEFT JOIN (
                    SELECT wo_header.event_perfno_i as epi,
                                  wo_header_4.event_classification as woc,
                                  SUM(rm_resource_requirement.total_hours) as request_minutes
                    FROM wo_header
                    LEFT JOIN wo_header_4 ON wo_header_4.event_perfno_i = wo_header.event_perfno_i
                    LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wo_header.event_perfno_i
                    LEFT JOIN rm_resource_request ON workstep_link.descno_i = rm_resource_request.request_owner_amos_key
                    LEFT JOIN rm_resource_requirement ON rm_resource_requirement.resource_request_noi = rm_resource_request.resource_request_noi
                    GROUP BY wo_header.event_perfno_i, wo_header_4.event_classification
	    ) mhrs_requested ON mhrs_requested.epi = wo_header.event_perfno_i
LEFT JOIN wo_event_link ON wo_header.event_perfno_i=wo_event_link.event_perfno_i
LEFT JOIN check_type_int ON check_type_int.check_intno_i = wo_event_link.event_key_parent
LEFT JOIN check_type ON check_type.checkno_i = check_type_int.checkno_i 
WHERE
               time_captured.start_date &gt;= '@VAR.begin@' 
               AND time_captured.start_date &lt;= '@VAR.end@'
               AND aircraft.ac_model = '@VAR.actip@'
               AND time_captured.mime_type = 'WO'
               AND REGEXP_LIKE(sign.department, '@VAR.department@')
               AND (
                          (wo_event_link.event_type NOT IN ('CHTI') OR wo_event_link.event_type IS NULL)
                          AND '@AMOS_VERSION@' LIKE '19.12%'
                          OR
                          (wo_event_link.event_type NOT IN ('MEC') OR wo_event_link.event_type IS NULL)
                         AND '@AMOS_VERSION@' NOT LIKE '19.12%'
                         )
GROUP BY wo_header.workorderno_display,
                     aircraft.ac_typ,
                     wo_header.ac_registr,
                     wo_header.closing_date,
                     mhrs_requested.request_minutes,
                     sign.workgroup,
                     mhrs_requested.woc,
                     sign.user_sign,
                     time_captured.scope,
                     time_captured.qualification,
                     check_type.check_type,
                     wo_header.release_time,
                     sign.department
ORDER BY wo_header.workorderno_display
/*q91*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_TASK_Mhrs" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ROUND((SUM(time_captured.duration)/60)2) as perf_dec" id="perf_dec"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             to_char(trunc(sysdate) + SUM(time_captured.duration)/24/60'hh24:mi') as perf_hrs" id="perf_hrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as type" id="type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr as tail" id="tail"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_event_link.event_name as taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             wo_event_link.event_name as taskcardno&#10;             TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_header.closing_date+729)'DD.MM.YYYY') as cdate" id="cdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             ROUND(mhrs_requested.request_minutes/602) as planned_dec" id="planned_dec"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             to_char(trunc(sysdate) + mhrs_requested.request_minutes/24/60'hh24:mi') as planned_hrs" id="planned_hrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.workgroup as workgroup" id="workgroup"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mhrs_requested.woc as classification" id="classification"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.user_sign as user_sign" id="user_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_captured.scope as scope" id="scope"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_captured.qualification as skill" id="skill"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             TO_CHAR(TO_DATE(TO_CHAR(wo_header.release_time'0000')'HH24MI')'HH24:MI') as wo_closing_time" id="wo_closing_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.department as department" id="department"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno as wpno" id="wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_closing.sign as closing_sign" id="closing_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_closing.department as closing_department" id="closing_department"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_closing.workgroup as closing_workgroup" id="closing_workgroup"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.department@">
          <ds:object>@VAR.department@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.begin@">
          <ds:object>@VAR.begin@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end@">
          <ds:object>@VAR.end@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.actip@">
          <ds:object>@VAR.actip@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.Task@">
          <ds:object>@VAR.Task@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ROUND((SUM(time_captured.duration)/60), 2) as perf_dec,
             to_char(trunc(sysdate) + SUM(time_captured.duration)/24/60, 'hh24:mi') as perf_hrs,
             aircraft.ac_typ as type,
             wo_header.ac_registr as tail,
             wo_event_link.event_name as taskcardno,
             TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.closing_date+729), 'DD.MM.YYYY') as cdate,
             ROUND(mhrs_requested.request_minutes/60, 2) as planned_dec,
             to_char(trunc(sysdate) + mhrs_requested.request_minutes/24/60, 'hh24:mi') as planned_hrs,
             sign.workgroup as workgroup,
             mhrs_requested.woc as classification,
             sign.user_sign as user_sign,
             time_captured.scope as scope,
             time_captured.qualification as skill,
             TO_CHAR(TO_DATE(TO_CHAR(wo_header.release_time,'0000'),'HH24MI'),'HH24:MI') as wo_closing_time,
             sign.department as department,
             wp_header.wpno as wpno,
             sign_closing.user_sign as closing_sign,
             sign_closing.department as closing_department,
             sign_closing.workgroup as closing_workgroup
FROM wo_header
JOIN aircraft ON aircraft.ac_registr = wo_header.ac_registr
JOIN wo_event_link on wo_event_link.event_perfno_i = wo_header.event_perfno_i
JOIN wp_assignment on wo_header.event_perfno_i=wp_assignment.event_perfno_i
JOIN wp_header on wp_assignment.wpno_i=wp_header.wpno_i
JOIN sign sign_closing on wo_header.mech_sign=sign_closing.user_sign
LEFT JOIN time_captured ON wo_header.event_perfno_i = time_captured.primkey AND time_captured.mime_type = 'MET'
LEFT JOIN time_captured_additional ON time_captured.bookingno_i = time_captured_additional.bookingno_i
LEFT JOIN sign ON sign.user_sign = time_captured.user_sign
LEFT JOIN (
                    SELECT wo_header.event_perfno_i,
                                  wo_header_4.event_classification as woc,
                                  SUM(rm_resource_requirement.total_hours) as request_minutes
                    FROM wo_header
                    LEFT JOIN wo_header_4 ON wo_header_4.event_perfno_i = wo_header.event_perfno_i
                    LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wo_header.event_perfno_i
                    LEFT JOIN rm_resource_request ON workstep_link.descno_i = rm_resource_request.request_owner_amos_key
                    LEFT JOIN rm_resource_requirement ON rm_resource_requirement.resource_request_noi = rm_resource_request.resource_request_noi
                    GROUP BY wo_header.event_perfno_i, wo_header_4.event_classification
                   ) mhrs_requested ON mhrs_requested.event_perfno_i = wo_header.event_perfno_i
WHERE 1=1
              AND REGEXP_LIKE(sign_closing.department, '@VAR.department@')
              AND wo_header.closing_date BETWEEN '@VAR.begin@' AND '@VAR.end@'
              AND aircraft.ac_model like '@VAR.actip@'
              AND wo_event_link.event_name NOT IN ( 
                            /*A32S*/
                     	'101100-03-AFL',
                        'A20-10-1143-01',
                        'A20-10-1143-02', 
	                    'A20-10-1143-03',
                        'A20-10-1152',
                        'A20-10-1152-02',
                        'A20-10-1152-03',
                        'A20-10-1152-04',
                        'A20-10-1152-05',
                        'A20-10-1143-04',
                        'A20-10-1159-03',
                        'A20-10-1159-04',
                        'A20-10-1159-05',
                        'A20-10-1159-06', 
					    'A20-10-1159-01',
					    'A20-10-1159-02', 
					    'A20-10-1159-07', 
					    'A20-10-1159-08', 
					    'A20-10-1159-09',
                        'A20-23-0727',
                        '050000-04-AFL',

  					         /*A330*/
					    '101100-01-AFL',
                        '101100-03-AFL',
                        '101100-04-AFL',
                        '101200-09-AFL',
                        '101200-10-AFL',
                        '101100-05-AFL',
                        '101100-06-AFL',
                        '101100-07-AFL', 
					    '101100-08-AFL', 
					    '101200-03-AFL', 
					    '101200-04-AFL',
					    '101200-05-AFL',
					    '101200-01-AFL', 
					    '101200-06-AFL', 
					    '101200-07-AFL', 
					    '101200-09-AFL',
                        '237100-01-AFL',
                        
                         /*A320*/
                         '2371XX-00M01-AFL',

						/*B777*/
                        'B7-10-0277-1',
                        'B7-10-0277-2',
                        'B7-10-0277-3',
                        'B7-10-0277-6',
                        'B7-10-0277-4',
                        'B7-10-0277-5',
					    'B7-10-0277-7',
                        '23-999-00-18',
                        'B7-10-0287-1',

	        /*A350*/
	'1011XX-00M02-AFL',
	'1011XX-00M03-AFL',
	'1011XX-00M04-AFL', 
	'1011XX-00M05-AFL',
	'1011XX-00M06-AFL'
)
              AND wo_header.event_type='Q'
              AND wo_event_link.taskcard_type  in ('@VAR.Task@')
GROUP BY wo_header.event_perfno_i,
                    wo_event_link.event_name,
                    aircraft.ac_typ,
                    wo_header.ac_registr,
                    wo_header.closing_date,
                    mhrs_requested.request_minutes,
                    sign.workgroup,
                    mhrs_requested.woc,
                    sign.user_sign,
                    time_captured.scope,
                    time_captured.qualification,
                    wo_header.release_time,
                    sign.department,
                    wp_header.wpno,
                    sign_closing.user_sign,
                    sign_closing.department,
                    sign_closing.workgroup
ORDER BY wpno, taskcardno
/*q92*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
