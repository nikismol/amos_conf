    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="stok_1250_1254" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT&#10;&#9;CASE WHEN REGEXP_LIKE(par.serialno'^[0-9]+$') THEN chr(39)||par.serialno ELSE par.serialno END as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="par.partno" id="par.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="par.description" id="par.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    DECODE (par.mat_class &#10;&#9;&#9;'C' 'Consumable'&#10;                                'E' 'Expendable'&#10;                                'R' 'Rotable'&#10;                                'S''Service'&#10;&#9;&#9;) as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="par.station" id="par.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="par.store" id="par.store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="par.vendor" id="par.vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="par.name" id="par.name"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_station@">
          <ds:object>@VAR.v03_station@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_store@">
          <ds:object>@VAR.v04_store@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT
	CASE WHEN REGEXP_LIKE(par.serialno, '^[0-9]+$') THEN chr(39)||par.serialno ELSE par.serialno END as serialno,
	par.partno,
	par.description,
	DECODE (par.mat_class, 
                                'C', 'Consumable',
                                'E', 'Expendable',
                                'R', 'Rotable',
                                'S', 'Service'
		) as mat_class,
	par.station,
	par.store,
	par.vendor,
	par.name
FROM
	(
		SELECT DISTINCT
			od_header.orderdate,
			od_header.order_type,
			od_detail.partno,
			od_detail.serialno,
			part.description,
			part.mat_class,
			location.station,
			location.store,
			address.vendor,
			address.name
		FROM od_header 
			JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
			LEFT JOIN consumables ON od_detail.partno = consumables.partno AND od_detail.serialno=consumables.batchno
			JOIN location ON consumables.locationno_i = location.locationno_i
			LEFT JOIN station_store ON station_store.station = location.station and station_store.store = location.store
			LEFT JOIN address ON od_header.vendor = address.vendor
			LEFT JOIN part ON part.partno = od_detail.partno

UNION

		SELECT DISTINCT
			od_header.orderdate,
			od_header.order_type,
			part.partno,
			od_detail.serialno,
			part.description,
			part.mat_class,
			location.station,
			location.store,
			address.vendor,
			address.name
		FROM od_header
 			 JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
  			LEFT JOIN rotables ON od_detail.serialno = rotables.serialno and od_detail.partno = rotables.partno
 			  JOIN location ON rotables.locationno_i = location.locationno_i
  			LEFT JOIN station_store ON station_store.station =location.station and station_store.store = location.store
 			 LEFT JOIN address  ON od_header.vendor = address.vendor
 			 LEFT JOIN part ON part.partno = od_detail.partno 
	) par
WHERE 1=1
	AND par.order_type NOT IN ('T')
	AND (par.description NOT LIKE '%TIRE%' and par.description NOT LIKE '%АВИАШИНА%')
	AND par.vendor NOT IN ('ZHB_ENGINEER', '0021000008', '0011000038', '0011002792', '0011004393', 
                           			'0011002102', '0011019891', '0011030115', '4019', '0011004413', '0011057857', 
                          			 'CMD_WS', '0011004393', '0011003897', '4018', '0011025042', '0021017605','0011057889', 
				           '0011014639', 'BASE', 'CMD_EPES', '0011025042', '1014'
				)
	AND par.station = '@VAR.v03_station@'
	AND  (par.store = '@VAR.v04_store@' OR '@VAR.v04_store@' = 'ALL')
	AND par.orderdate&gt;= '@VAR.v01_date_from@' 
	AND par.orderdate&lt;= '@VAR.v02_date_to@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
