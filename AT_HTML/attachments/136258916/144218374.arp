    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="test_khm" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="MIN(history.historyno_i)" id="x1"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.partno" id="rotables.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.serialno" id="rotables.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.station" id="location.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.store" id="location.store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.location" id="location.location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.ac_registr" id="rotables.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.orderno" id="history.orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.condition" id="rotables.condition"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.owner" id="rotables.owner"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.rotable_status" id="rotables.rotable_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="certificate_link.certificate_i" id="certificate_link.certificate_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.Vendor@">
          <ds:object>@VAR.Vendor@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.Partno@">
          <ds:object>@VAR.Partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.Orderno@">
          <ds:object>@VAR.Orderno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    MIN(history.historyno_i),
    '''' || rotables.partno,
   '''' || rotables.serialno,
    location.station,
    location.store,
    location.location,
    rotables.ac_registr,
    history.orderno,
    rotables.condition,
    rotables.owner,
    rotables.rotable_status,
    certificate_link.certificate_i
FROM
    rotables left
    JOIN history ON history.psn = rotables.psn
    LEFT JOIN od_header ON history.orderno = od_header.orderno
    LEFT JOIN location ON location.locationno_i = rotables.locationno_i
    LEFT JOIN certificate_link ON certificate_link.source_key = rotables.psn
WHERE
    (od_header.vendor =   '0011041035' OR
    od_header.vendor = '@VAR.Vendor@' AND '@VAR.Vendor@' IS NOT NULL)
    AND history.vm = 'B1'
    AND 
    (rotables.partno = '@VAR.Partno@' AND '@VAR.Partno@' IS NOT NULL
     OR '@VAR.Partno@' IS NULL)
      AND 
    (od_header.orderno = '@VAR.Orderno@' AND '@VAR.Orderno@' IS NOT NULL
     OR '@VAR.Orderno@' IS NULL)
      AND  od_header.order_type = 'L' 
GROUP BY
    history.historyno_i,
    rotables.partno,
    rotables.serialno,
    location.station,
    location.store,
    location.location,
    rotables.ac_registr,
    history.orderno,
    rotables.condition,
    rotables.owner,
    rotables.rotable_status,
    certificate_link.certificate_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
