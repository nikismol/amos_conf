  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="MC"/>
        <ds:columnDescriptor amosType="DATE_INT" description="Date2" id="date2"/>
        <ds:columnDescriptor amosType="DATE_INT" description="Date1" id="date1"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Material Class" id="MC">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>R</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>R&amp;=&amp;R;CR&amp;=&amp;CR;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Date to" id="date2">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Date from" id="date1">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="CLONER" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.psn AS PSN" id="PSN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno" id="history.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="'''' || TO_CHAR(history.serialno) as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.labelno" id="history.labelno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.created_by" id="history.created_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.del_date AS del_date" id="del_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date +729)'DD.MM.YYYY') as new_del_date" id="new_del_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date1@">
          <ds:object>@VAR.date1@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date2@">
          <ds:object>@VAR.date2@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  
	history.psn AS PSN,
	history.partno,
               '''' || TO_CHAR(history.serialno) as serialno,
               history.labelno,
               history.created_by,
	history.del_date AS del_date,
	       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date +729), 'DD.MM.YYYY') as new_del_date
FROM history 
LEFT JOIN od_header ON history.orderno = od_header.orderno 
WHERE od_header.vendor = 'CLOSED' 
      AND history.vm = 'B1' 
      AND  (history.del_date &gt;= '@VAR.date1@' or  '@VAR.date1@' IS NULL)
      AND  (history.del_date &lt;= '@VAR.date2@' or  '@VAR.date2@' IS NULL)
      AND history.mat_class = 'R'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.psn AS psn" id="psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.vm AS VM" id="VM"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.del_date AS DELDATE" id="DELDATE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.historyno_i AS histno" id="histno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.maxno AS MAXNO" id="MAXNO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history3.WO AS WO" id="WO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.ac_typ AS AC_TYP" id="AC_TYP"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.ac_registr AS AC_reg" id="AC_reg"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@CLONER.PSN@">
          <ds:object>@CLONER.PSN@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@CLONER.del_date@">
          <ds:object>@CLONER.del_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
		h2.psn AS psn,
		h2.vm AS VM,
		h2.del_date AS DELDATE,
		h2.historyno_i AS histno,
		h2.maxno AS MAXNO,
		h2.event_perfno_i AS WO,
		h2.ac_typ AS AC_TYP,
		h2.ac_registr AS AC_reg
FROM
								(
									SELECT  
											history.psn,
											history.vm,
											history.del_date,
											historyno_i,
											history.event_perfno_i,
											history.ac_typ,
											history.ac_registr,
											MAX(historyno_i) OVER (PARTITION BY history.psn) AS maxno
									FROM history
									WHERE
									history.vm = 'YA' 
									AND history.mat_class = 'R' 
									AND history.psn = '@CLONER.PSN@'
									AND history.del_date &lt;= '@CLONER.del_date@'
								) h2
WHERE h2.historyno_i = h2.maxno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="CLONER_CR" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno AS PARTNO" id="PARTNO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.batchno AS BN" id="BN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.qty AS QTY" id="QTY"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.labelno" id="history.labelno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.created_by" id="history.created_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.del_date AS del_date" id="del_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date +729)'DD.MM.YYYY') as new_del_date" id="new_del_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date1@">
          <ds:object>@VAR.date1@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date2@">
          <ds:object>@VAR.date2@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  
	history.partno AS PARTNO,
	history.batchno AS BN,
               history.qty AS QTY,
               history.labelno,
               history.created_by,
	history.del_date AS del_date,
	       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date +729), 'DD.MM.YYYY') as new_del_date
FROM history 
LEFT JOIN od_header ON history.orderno = od_header.orderno 
LEFT JOIN part ON history.partno = part.partno
WHERE 
       history.vm = 'B1' 
      AND history.status&lt;&gt;9
      AND  (history.del_date &gt;= '@VAR.date1@' or  '@VAR.date1@' IS NULL)
      AND  (history.del_date &lt;= '@VAR.date2@' or  '@VAR.date2@' IS NULL)
      AND part.mat_class= 'C' 
      AND part.repairable='Y'
</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="INFO_CR" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.partno AS partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.vm AS VM" id="VM"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.del_date AS DELDATE" id="DELDATE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.historyno_i AS histno" id="histno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.maxno AS MAXNO" id="MAXNO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.event_perfno_i AS WO" id="WO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.ac_typ AS AC_TYP" id="AC_TYP"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.ac_registr AS AC_reg" id="AC_reg"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@CLONER_CR.PARTNO@">
          <ds:object>@CLONER_CR.PARTNO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@CLONER_CR.del_date@">
          <ds:object>@CLONER_CR.del_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
		h2.partno AS partno,
		h2.vm AS VM,
		h2.del_date AS DELDATE,
		h2.historyno_i AS histno,
		h2.maxno AS MAXNO,
		h2.event_perfno_i AS WO,
		h2.ac_typ AS AC_TYP,
		h2.ac_registr AS AC_reg
FROM
								(
									SELECT  
											history.partno,
											history.vm,
											history.del_date,
											historyno_i,
											history.event_perfno_i,
											history.ac_typ,
											history.ac_registr,
											MAX(historyno_i) OVER (PARTITION BY history.partno) AS maxno
									FROM history
									LEFT JOIN part ON history.partno = part.partno 
									WHERE 1=1
									AND history.vm = 'Y2' 
									AND part.mat_class= 'C' 
									AND part.repairable='Y'
									AND history.partno = '@CLONER_CR.PARTNO@'
									AND history.del_date &lt;= '@CLONER_CR.del_date@'
								) h2
WHERE h2.historyno_i = h2.maxno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
