    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="171_ODS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno as order_number" id="order_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.posno as position" id="position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderdate as order_date" id="order_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.vendor as vendor_code" id="vendor_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="address.name||' '||address.name_1||' '||address.name_2 as vendore_name" id="vendore_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       DECODE (od_header.ext_state 'BO' 'booked_open' 'O' 'open' 'B' 'booked' 'R' 'recived' 'PR' 'partly_received''') as order_status" id="order_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       DECODE (od_detail.ext_state 'BO' 'booked_open' 'O' 'open' 'B' 'booked' 'R' 'recived' 'PR' 'partly_received''') as position_status" id="position_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DDMMYYYY') + (od_detail.target_date + 729)'DD.MM.YYYY') as target_date" id="target_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (MAX(NVL(od_rec_header.del_date 99999)) OVER (PARTITION BY od_header.orderno NVL(od_detail.ac_registr od_detail.partno wo_header.ac_registr))) + 729'DD.MM.YYYY') as max_target_date" id="max_target_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DDMMYYYY') + (od_detail.confirmed_date + 729)'DD.MM.YYYY') as confirmed_date" id="confirmed_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (sh_pr.flight_date + 729)'DD.MM.YYYY') as flight_date" id="flight_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (sh_header.awbdate + 729)'DD.MM.YYYY') as awb_date" id="awb_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + od_rec_header.del_date + 729'DD.MM.YYYY') as pos_rec_date" id="pos_rec_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       CASE WHEN MAX(NVL(od_rec_header.del_date 99999)) OVER (PARTITION BY od_header.orderno NVL(od_detail.ac_registr wo_header.ac_registr))=99999 THEN ''&#10;                 ELSE TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (MAX(NVL(od_rec_header.del_date 99999)) OVER (PARTITION BY od_header.orderno NVL(od_detail.ac_registr wo_header.ac_registr))) + 729'DD.MM.YYYY')&#10;       END as max_rec_date" id="max_rec_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       CASE WHEN REGEXP_LIKE(od_detail.partno'^[0-9]+$') THEN chr(39)||od_detail.partno ELSE od_detail.partno END as part_number" id="part_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN od_detail.ac_registr=' ' OR od_detail.ac_registr IS NULL THEN wo_header.ac_registr ELSE od_detail.ac_registr END as aicraft" id="aicraft"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_no" id="event_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       CASE WHEN wo_header.type IN ('C' 'M' 'P') THEN 'unsched (wo)'&#10;                  WHEN wo_header.type IN ('T''PD') THEN 'Sched'&#10;                  WHEN wo_header.type IN ('S') THEN 'Sched (wo)'&#10;                  ELSE ''&#10;       END as event_type" id="event_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + part_request_2.created_date + 729'DD.MM.YYYY') as pr_created_date" id="pr_created_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p01_ac_typ@">
          <ds:object>@VAR.p01_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p02_date_from@">
          <ds:object>@VAR.p02_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p03_date_to@">
          <ds:object>@VAR.p03_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p04_add_nolink@">
          <ds:object>@VAR.p04_add_nolink@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
       od_header.orderno as order_number,
       od_detail.posno as position,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_header.orderdate + 729, 'DD.MM.YYYY') as order_date,
       od_header.vendor as vendor_code,
       address.name||' '||address.name_1||' '||address.name_2 as vendore_name,
       DECODE (od_header.ext_state, 'BO', 'booked_open', 'O', 'open', 'B', 'booked', 'R', 'recived', 'PR', 'partly_received', '') as order_status,
       DECODE (od_detail.ext_state, 'BO', 'booked_open', 'O', 'open', 'B', 'booked', 'R', 'recived', 'PR', 'partly_received', '') as position_status,
       CASE WHEN od_detail.target_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_detail.target_date + 729), 'DD.MM.YYYY') ELSE '' END as target_date,
       CASE WHEN MAX(od_detail.target_date) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))&gt;0
                 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (MAX(od_detail.target_date) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))) + 729, 'DD.MM.YYYY') ELSE '' END as max_target_date,
       CASE WHEN od_detail.confirmed_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_detail.confirmed_date + 729), 'DD.MM.YYYY') ELSE '' END as confirmed_date,
       CASE WHEN sh_pr.flight_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (sh_pr.flight_date + 729), 'DD.MM.YYYY') ELSE '' END as flight_date,
       CASE WHEN sh_pr.awbdate&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (sh_pr.awbdate + 729), 'DD.MM.YYYY') ELSE '' END as awb_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_rec_header.del_date + 729, 'DD.MM.YYYY') as pos_rec_date,
       CASE WHEN MAX(NVL(od_rec_header.del_date, 99999)) OVER (PARTITION BY od_header.orderno, od_detail.partno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr)) IN (99999) THEN ''
                 ELSE TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (MAX(NVL(od_rec_header.del_date, 99999)) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, od_detail.partno, wo_header.ac_registr))) + 729, 'DD.MM.YYYY')
       END as max_rec_date,
       CASE WHEN REGEXP_LIKE(od_detail.partno, '^[0-9]+$') THEN chr(39)||od_detail.partno ELSE od_detail.partno END as part_number,
       part.description as description,
       CASE WHEN od_detail.ac_registr=' ' OR od_detail.ac_registr IS NULL THEN COALESCE (wo_header.ac_registr, od_header.pool_ac_typ||'(POOL)') ELSE od_detail.ac_registr END as aicraft,
       wo_header.event_perfno_i as event_no,
       CASE WHEN wo_header.type IN ('C', 'M', 'P') THEN 'unsched (wo)'
                  WHEN wo_header.type IN ('T', 'PD') THEN 'Sched'
                  WHEN wo_header.type IN ('S') THEN 'Sched (wo)'
                  ELSE ''
       END as event_type,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + part_request_2.created_date + 729, 'DD.MM.YYYY') as pr_created_date
FROM od_header
JOIN od_detail ON od_header.orderno_i=od_detail.orderno_i
LEFT JOIN od_rec_detail ON od_detail.detailno_i=od_rec_detail.detailno_i AND od_rec_detail.receivingno &gt; 0 AND od_rec_detail.status &lt;&gt; 9 AND od_rec_detail.recno &lt;&gt; -1
LEFT JOIN od_rec_header ON od_rec_detail.receivingno=od_rec_header.receivingno
LEFT JOIN aircraft ON od_detail.ac_registr=aircraft.ac_registr
LEFT JOIN part ON od_detail.partno=part.partno
LEFT JOIN allocation_link ON allocation_link.ref_key = od_detail.detailno_i AND allocation_link.source_type = 'PARTRQST' AND allocation_link.ref_type = 'ORDER_DE'
LEFT JOIN part_request_2 ON allocation_link.source_key = part_request_2.part_requestno_i AND part_request_2.event_type='WSL'
LEFT JOIN workstep_link ON workstep_link.workstep_linkno_i = part_request_2.event_key
LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN aircraft ac_wo ON wo_header.ac_registr=ac_wo.ac_registr
LEFT JOIN address ON od_header.vendor=address.vendor
LEFT JOIN (
                  SELECT sh_header.awbdate,
                         sh_detail.od_detailno_i,
                         sh_header.awbno,
                         sh_header.flight_date
                  FROM sh_header
                  LEFT JOIN sh_detail ON sh_header.shipmentno_i = sh_detail.shipmentno_i
                  WHERE sh_header.status &lt;&gt; -5
                        AND sh_header.type='EI'
                 ) sh_pr ON sh_pr.od_detailno_i=od_detail.detailno_i
WHERE
(aircraft.ac_typ='@VAR.p01_ac_typ@' OR ac_wo.ac_typ='@VAR.p01_ac_typ@' OR od_header.pool_ac_typ='@VAR.p01_ac_typ@')
AND od_header.vendor NOT IN ('TECH_V', 'DUZD_TECH')
AND od_header.ext_state NOT IN ('CA', 'D', 'IC', 'T', 'C', 'B')
AND od_detail.ext_state NOT IN ('C','B','CA')
AND od_header.orderdate&gt;='@VAR.p02_date_from@'
AND od_header.orderdate&lt;='@VAR.p03_date_to@'
AND od_header.order_type NOT IN ('T', 'PU', 'YU', 'LU', 'D', 'W', 'MP', 'Q', 'C')
AND od_header.internal_repair!='Y'

UNION

SELECT
       od_header.orderno as order_number,
       od_detail.posno as position,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_header.orderdate + 729, 'DD.MM.YYYY') as order_date,
       od_header.vendor as vendore_code,
       address.name||' '||address.name_1||' '||address.name_2 as vendore_name,
       DECODE (od_header.ext_state, 'BO', 'booked_open', 'O', 'open', 'B', 'booked', 'R', 'recived', 'PR', 'partly_received', '') as order_status,
       DECODE (od_detail.ext_state, 'BO', 'booked_open', 'O', 'open', 'B', 'booked', 'R', 'recived', 'PR', 'partly_received', '') as position_status,
       CASE WHEN od_detail.target_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_detail.target_date + 729), 'DD.MM.YYYY') ELSE '' END as target_date,
       CASE WHEN MAX(od_detail.target_date) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))&gt;0
                 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (MAX(od_detail.target_date) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))) + 729, 'DD.MM.YYYY') ELSE '' END as max_target_date,
       CASE WHEN od_detail.confirmed_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_detail.confirmed_date + 729), 'DD.MM.YYYY') ELSE '' END as confirmed_date,
       CASE WHEN sh_pr.flight_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (sh_pr.flight_date + 729), 'DD.MM.YYYY') ELSE '' END as flight_date,
       CASE WHEN sh_pr.awbdate&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (sh_pr.awbdate + 729), 'DD.MM.YYYY') ELSE '' END as awb_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_rec_header.del_date + 729, 'DD.MM.YYYY') as pos_rec_date,
       CASE WHEN MAX(NVL(od_rec_header.del_date, 99999)) OVER (PARTITION BY od_header.orderno, od_detail.partno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr)) IN (99999) THEN ''
                 ELSE TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (MAX(NVL(od_rec_header.del_date, 99999)) OVER (PARTITION BY od_header.orderno, od_detail.partno, COALESCE (od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))) + 729, 'DD.MM.YYYY')
       END as max_rec_date,
       CASE WHEN REGEXP_LIKE(od_detail.partno, '^[0-9]+$') THEN chr(39)||od_detail.partno ELSE od_detail.partno END as part_number,
       part.description as description,
       '' as aicraft,
       TO_NUMBER('') as event_no,
       '' as event_type,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + part_request_2.created_date + 729, 'DD.MM.YYYY') as pr_created_date
FROM od_header
JOIN od_detail ON od_header.orderno_i=od_detail.orderno_i
LEFT JOIN od_rec_detail ON od_detail.detailno_i=od_rec_detail.detailno_i AND od_rec_detail.receivingno &gt; 0 AND od_rec_detail.status &lt;&gt; 9 AND od_rec_detail.recno &lt;&gt; -1
LEFT JOIN od_rec_header ON od_rec_detail.receivingno=od_rec_header.receivingno
LEFT JOIN aircraft ON od_detail.ac_registr=aircraft.ac_registr
LEFT JOIN allocation_link ON allocation_link.ref_key = od_detail.detailno_i AND allocation_link.source_type = 'PARTRQST' AND allocation_link.ref_type = 'ORDER_DE'
JOIN part ON od_detail.partno=part.partno
JOIN part_request_2 ON od_detail.partno = part_request_2.partno AND part_request_2.event_type='WSL'
JOIN workstep_link ON workstep_link.workstep_linkno_i = part_request_2.event_key
JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
JOIN aircraft ac_wo ON wo_header.ac_registr=ac_wo.ac_registr
LEFT JOIN address ON od_header.vendor=address.vendor
LEFT JOIN (
                  SELECT sh_header.awbdate,
                         sh_detail.od_detailno_i,
                         sh_header.awbno,
                         sh_header.flight_date
                  FROM sh_header
                  LEFT JOIN sh_detail ON sh_header.shipmentno_i = sh_detail.shipmentno_i
                  WHERE sh_header.status &lt;&gt; -5
                        AND sh_header.type='EI'
                 ) sh_pr ON sh_pr.od_detailno_i=od_detail.detailno_i
WHERE
'@VAR.p04_add_nolink@'='Y'
AND aircraft.ac_typ IS NULL
AND allocation_link.ref_key IS NULL
AND ASCII(od_header.pool_ac_typ)=49824
AND wo_header.type IN ('P','C','M')
AND ac_wo.ac_typ='@VAR.p01_ac_typ@'
AND od_header.vendor NOT IN ('TECH_V', 'DUZD_TECH')
AND od_header.ext_state NOT IN ('CA', 'D', 'IC', 'T', 'C', 'B')
AND od_detail.ext_state NOT IN ('C','B','CA')
AND od_header.orderdate&gt;='@VAR.p02_date_from@'
AND od_header.orderdate&lt;='@VAR.p03_date_to@'
AND part_request_2.created_date&gt;=od_header.orderdate-10
AND part_request_2.created_date&lt;=od_header.orderdate
AND od_header.order_type NOT IN ('T', 'PU', 'YU', 'LU', 'D', 'W', 'MP', 'Q', 'C')
AND od_header.internal_repair!='Y'
ORDER BY aicraft, 1</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="171_CONVERT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + @VAR.p02_date_from@ + 729'DD.MM.YYYY') as date_from" id="date_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + @VAR.p03_date_to@ + 729'DD.MM.YYYY') as date_to" id="date_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;DECODE ('@VAR.p04_add_nolink@' 'Y' 'YES' 'N' 'NO''') as add_nolink" id="add_nolink"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p02_date_from@">
          <ds:object>@VAR.p02_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p03_date_to@">
          <ds:object>@VAR.p03_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p04_add_nolink@">
          <ds:object>@VAR.p04_add_nolink@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + @VAR.p02_date_from@ + 729, 'DD.MM.YYYY') as date_from,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + @VAR.p03_date_to@ + 729, 'DD.MM.YYYY') as date_to,
DECODE ('@VAR.p04_add_nolink@', 'Y', 'YES', 'N', 'NO', '') as add_nolink
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="171_ODS_GROUP" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT od.order_number as order_number" id="order_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG(od.posno CHR(10)||'') WITHIN GROUP (ORDER BY od.posno) as position" id="position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.order_date as order_date" id="order_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.vendor_code as vendor_code" id="vendor_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.vendore_name as vendore_name" id="vendore_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.order_status" id="od.order_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG(od.position_status CHR(10)||'') WITHIN GROUP (ORDER BY od.posno) as position_status" id="position_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG(od.confirmed_date CHR(10)||'') WITHIN GROUP (ORDER BY od.posno) as target_date" id="target_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.max_target_date as max_target_date" id="max_target_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG(od.confirmed_date CHR(10)||'') WITHIN GROUP (ORDER BY od.posno) as target_date" id="target_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG(od.flight_date CHR(10)||'') WITHIN GROUP (ORDER BY od.posno) as flight_date" id="flight_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG(od.awb_date CHR(10)||'') WITHIN GROUP (ORDER BY od.posno) as awb_date" id="awb_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG(od.pos_rec_date CHR(10)||'') WITHIN GROUP (ORDER BY od.posno) as pos_rec_date" id="pos_rec_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.max_rec_date as max_rec_date" id="max_rec_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG(od.part_number CHR(10)||'') WITHIN GROUP (ORDER BY od.posno) as part_number" id="part_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG(od.description CHR(10)||'') WITHIN GROUP (ORDER BY od.posno) as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.aicraft as aicraft" id="aicraft"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.event_no as event_no" id="event_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.event_type as event_type" id="event_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.pr_created_date as part_req_date" id="part_req_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p01_ac_typ@">
          <ds:object>@VAR.p01_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p02_date_from@">
          <ds:object>@VAR.p02_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p03_date_to@">
          <ds:object>@VAR.p03_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p04_add_nolink@">
          <ds:object>@VAR.p04_add_nolink@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT od.order_number as order_number,
             LISTAGG(od.position, CHR(10)||', ') WITHIN GROUP (ORDER BY od.position) as position,
             od.order_date as order_date,
             od.vendor_code as vendor_code,
             od.vendore_name as vendore_name,
             od.order_status,
             LISTAGG(od.position_status, CHR(10)||', ') WITHIN GROUP (ORDER BY od.position) as position_status,
             LISTAGG(od.target_date, CHR(10)||', ') WITHIN GROUP (ORDER BY od.position) as target_date,
             od.max_target_date as max_target_date,
             LISTAGG(od.confirmed_date, CHR(10)||', ') WITHIN GROUP (ORDER BY od.position) as target_date,
             LISTAGG(od.flight_date, CHR(10)||', ') WITHIN GROUP (ORDER BY od.position) as flight_date,
             LISTAGG(od.awb_date, CHR(10)||', ') WITHIN GROUP (ORDER BY od.position) as awb_date,
             LISTAGG(od.pos_rec_date, CHR(10)||', ') WITHIN GROUP (ORDER BY od.position) as pos_rec_date,
             od.max_rec_date as max_rec_date,
             LISTAGG(od.part_number, CHR(10)||', ') WITHIN GROUP (ORDER BY od.position) as part_number,
             LISTAGG(od.description, CHR(10)||', ') WITHIN GROUP (ORDER BY od.position) as description,
             od.aicraft as aicraft,
             od.event_no as event_no,
             od.event_type as event_type,
             od.pr_created_date as part_req_date
FROM (
SELECT 
       od_header.orderno as order_number,
       od_detail.posno as position,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_header.orderdate + 729, 'DD.MM.YYYY') as order_date,
       od_header.vendor as vendor_code,
       address.name||' '||address.name_1||' '||address.name_2 as vendore_name,
       DECODE (od_header.ext_state, 'BO', 'booked_open', 'O', 'open', 'B', 'booked', 'R', 'recived', 'PR', 'partly_received', '') as order_status,
       DECODE (od_detail.ext_state, 'BO', 'booked_open', 'O', 'open', 'B', 'booked', 'R', 'recived', 'PR', 'partly_received', '') as position_status,
       CASE WHEN od_detail.target_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_detail.target_date + 729), 'DD.MM.YYYY') ELSE '' END as target_date,
       CASE WHEN MAX(od_detail.target_date) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))&gt;0
                 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (MAX(od_detail.target_date) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))) + 729, 'DD.MM.YYYY') ELSE '' END as max_target_date,
       CASE WHEN od_detail.confirmed_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_detail.confirmed_date + 729), 'DD.MM.YYYY') ELSE '' END as confirmed_date,
       CASE WHEN sh_pr.flight_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (sh_pr.flight_date + 729), 'DD.MM.YYYY') ELSE '' END as flight_date,
       CASE WHEN sh_pr.awbdate&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (sh_pr.awbdate + 729), 'DD.MM.YYYY') ELSE '' END as awb_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_rec_header.del_date + 729, 'DD.MM.YYYY') as pos_rec_date,
       CASE WHEN MAX(NVL(od_rec_header.del_date, 99999)) OVER (PARTITION BY od_header.orderno, od_detail.partno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr)) IN (99999) THEN ''
                 ELSE TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (MAX(NVL(od_rec_header.del_date, 99999)) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, od_detail.partno, wo_header.ac_registr))) + 729, 'DD.MM.YYYY')
       END as max_rec_date,
       CASE WHEN REGEXP_LIKE(od_detail.partno, '^[0-9]+$') THEN chr(39)||od_detail.partno ELSE od_detail.partno END as part_number,
       part.description as description,
       CASE WHEN od_detail.ac_registr=' ' OR od_detail.ac_registr IS NULL THEN COALESCE (wo_header.ac_registr, od_header.pool_ac_typ||'(POOL)') ELSE od_detail.ac_registr END as aicraft,
       wo_header.event_perfno_i as event_no,
       CASE WHEN wo_header.type IN ('C', 'M', 'P') THEN 'unsched (wo)'
                  WHEN wo_header.type IN ('T', 'PD') THEN 'Sched'
                  WHEN wo_header.type IN ('S') THEN 'Sched (wo)'
                  ELSE ''
       END as event_type,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + part_request_2.created_date + 729, 'DD.MM.YYYY') as pr_created_date
FROM od_header
JOIN od_detail ON od_header.orderno_i=od_detail.orderno_i
LEFT JOIN od_rec_detail ON od_detail.detailno_i=od_rec_detail.detailno_i AND od_rec_detail.receivingno &gt; 0 AND od_rec_detail.status &lt;&gt; 9 AND od_rec_detail.recno &lt;&gt; -1
LEFT JOIN od_rec_header ON od_rec_detail.receivingno=od_rec_header.receivingno
LEFT JOIN aircraft ON od_detail.ac_registr=aircraft.ac_registr
LEFT JOIN part ON od_detail.partno=part.partno
LEFT JOIN allocation_link ON allocation_link.ref_key = od_detail.detailno_i AND allocation_link.source_type = 'PARTRQST' AND allocation_link.ref_type = 'ORDER_DE'
LEFT JOIN part_request_2 ON allocation_link.source_key = part_request_2.part_requestno_i AND part_request_2.event_type='WSL'
LEFT JOIN workstep_link ON workstep_link.workstep_linkno_i = part_request_2.event_key
LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN aircraft ac_wo ON wo_header.ac_registr=ac_wo.ac_registr
LEFT JOIN address ON od_header.vendor=address.vendor
LEFT JOIN (
                  SELECT sh_header.awbdate,
                         sh_detail.od_detailno_i,
                         sh_header.awbno,
                         sh_header.flight_date
                  FROM sh_header
                  LEFT JOIN sh_detail ON sh_header.shipmentno_i = sh_detail.shipmentno_i
                  WHERE sh_header.status &lt;&gt; -5
                        AND sh_header.type='EI'
                 ) sh_pr ON sh_pr.od_detailno_i=od_detail.detailno_i
WHERE
(aircraft.ac_typ='@VAR.p01_ac_typ@' OR ac_wo.ac_typ='@VAR.p01_ac_typ@' OR od_header.pool_ac_typ='@VAR.p01_ac_typ@')
AND od_header.vendor NOT IN ('TECH_V', 'DUZD_TECH')
AND od_header.ext_state NOT IN ('CA', 'D', 'IC', 'T', 'C', 'B')
AND od_detail.ext_state NOT IN ('C','B','CA')
AND od_header.orderdate&gt;='@VAR.p02_date_from@'
AND od_header.orderdate&lt;='@VAR.p03_date_to@'
AND od_header.order_type NOT IN ('T', 'PU', 'YU', 'LU', 'D', 'W', 'MP', 'Q', 'C')
AND od_header.internal_repair!='Y'

UNION

SELECT
       od_header.orderno as order_number,
       od_detail.posno as position,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_header.orderdate + 729, 'DD.MM.YYYY') as order_date,
       od_header.vendor as vendore_code,
       address.name||' '||address.name_1||' '||address.name_2 as vendore_name,
       DECODE (od_header.ext_state, 'BO', 'booked_open', 'O', 'open', 'B', 'booked', 'R', 'recived', 'PR', 'partly_received', '') as order_status,
       DECODE (od_detail.ext_state, 'BO', 'booked_open', 'O', 'open', 'B', 'booked', 'R', 'recived', 'PR', 'partly_received', '') as position_status,
       CASE WHEN od_detail.target_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_detail.target_date + 729), 'DD.MM.YYYY') ELSE '' END as target_date,
       CASE WHEN MAX(od_detail.target_date) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))&gt;0
                 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (MAX(od_detail.target_date) OVER (PARTITION BY od_header.orderno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))) + 729, 'DD.MM.YYYY') ELSE '' END as max_target_date,
       CASE WHEN od_detail.confirmed_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (od_detail.confirmed_date + 729), 'DD.MM.YYYY') ELSE '' END as confirmed_date,
       CASE WHEN sh_pr.flight_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (sh_pr.flight_date + 729), 'DD.MM.YYYY') ELSE '' END as flight_date,
       CASE WHEN sh_pr.awbdate&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (sh_pr.awbdate + 729), 'DD.MM.YYYY') ELSE '' END as awb_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_rec_header.del_date + 729, 'DD.MM.YYYY') as pos_rec_date,
       CASE WHEN MAX(NVL(od_rec_header.del_date, 99999)) OVER (PARTITION BY od_header.orderno, od_detail.partno, COALESCE(od_detail.ac_registr, od_detail.partno, wo_header.ac_registr)) IN (99999) THEN ''
                 ELSE TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (MAX(NVL(od_rec_header.del_date, 99999)) OVER (PARTITION BY od_header.orderno, od_detail.partno, COALESCE (od_detail.ac_registr, od_detail.partno, wo_header.ac_registr))) + 729, 'DD.MM.YYYY')
       END as max_rec_date,
       CASE WHEN REGEXP_LIKE(od_detail.partno, '^[0-9]+$') THEN chr(39)||od_detail.partno ELSE od_detail.partno END as part_number,
       part.description as description,
       '' as aicraft,
       TO_NUMBER('') as event_no,
       '' as event_type,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + part_request_2.created_date + 729, 'DD.MM.YYYY') as pr_created_date
FROM od_header
JOIN od_detail ON od_header.orderno_i=od_detail.orderno_i
LEFT JOIN od_rec_detail ON od_detail.detailno_i=od_rec_detail.detailno_i AND od_rec_detail.receivingno &gt; 0 AND od_rec_detail.status &lt;&gt; 9 AND od_rec_detail.recno &lt;&gt; -1
LEFT JOIN od_rec_header ON od_rec_detail.receivingno=od_rec_header.receivingno
LEFT JOIN aircraft ON od_detail.ac_registr=aircraft.ac_registr
LEFT JOIN allocation_link ON allocation_link.ref_key = od_detail.detailno_i AND allocation_link.source_type = 'PARTRQST' AND allocation_link.ref_type = 'ORDER_DE'
JOIN part ON od_detail.partno=part.partno
JOIN part_request_2 ON od_detail.partno = part_request_2.partno AND part_request_2.event_type='WSL'
JOIN workstep_link ON workstep_link.workstep_linkno_i = part_request_2.event_key
JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
JOIN aircraft ac_wo ON wo_header.ac_registr=ac_wo.ac_registr
LEFT JOIN address ON od_header.vendor=address.vendor
LEFT JOIN (
                  SELECT sh_header.awbdate,
                         sh_detail.od_detailno_i,
                         sh_header.awbno,
                         sh_header.flight_date
                  FROM sh_header
                  LEFT JOIN sh_detail ON sh_header.shipmentno_i = sh_detail.shipmentno_i
                  WHERE sh_header.status &lt;&gt; -5
                        AND sh_header.type='EI'
                 ) sh_pr ON sh_pr.od_detailno_i=od_detail.detailno_i
WHERE
'@VAR.p04_add_nolink@'='Y'
AND aircraft.ac_typ IS NULL
AND allocation_link.ref_key IS NULL
AND od_header.pool_ac_typ=' '
AND wo_header.type IN ('P','C','M')
AND ac_wo.ac_typ='@VAR.p01_ac_typ@'
AND od_header.vendor NOT IN ('TECH_V', 'DUZD_TECH')
AND od_header.ext_state NOT IN ('CA', 'D', 'IC', 'T', 'C', 'B')
AND od_detail.ext_state NOT IN ('C','B','CA')
AND od_header.orderdate&gt;='@VAR.p02_date_from@'
AND od_header.orderdate&lt;='@VAR.p03_date_to@'
AND part_request_2.created_date&gt;=od_header.orderdate-10
AND part_request_2.created_date&lt;=od_header.orderdate
AND od_header.order_type NOT IN ('T', 'PU', 'YU', 'LU', 'D', 'W', 'MP', 'Q', 'C')
AND od_header.internal_repair!='Y'
) od
GROUP BY
             od.order_number,
             od.aicraft,
             od.event_no,
             od.max_target_date,
             od.max_rec_date,
             od.order_status,
             od.order_date,
             od.vendor_code,
             od.vendore_name,
             od.event_type,
             od.pr_created_date 
ORDER BY 1, aicraft</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
