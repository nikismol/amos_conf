      <ds:configurationParameters>
        <ds:value amosType="NONE" description="4. Add orders with no event link / no AC defined" id="p04_add_nolink">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
