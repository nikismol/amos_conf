      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
CASE WHEN REGEXP_LIKE(partno, '^[0-9]+$') THEN chr(39)||partno ELSE partno END as partno,
description,
ac_typ,
mat_class,
measure_unit,
consumpted_2022,
avg_consumpted,
consumpted_2022_svo,
avg_consumpted_svo,
consumpted_2022_out,
avg_consumpted_out,
stock_qty,
stock_qty_svo,
stock_qty_out,
days_left,
end_date,
days_left_svo,
end_date_svo,
days_left_out,
end_date_out
from AMOSSERVER_PROD.R261_CAD_PARTS_CONSUMPTION_ROTABLES
order by 1</se:textStatement>
        </se:sqlStatement>
