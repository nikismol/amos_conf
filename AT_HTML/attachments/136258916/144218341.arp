          <ds:object>@VAR.part@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
wod.workorderno as workorderno,
wod.ac_registr as ac_registr,
wod.ac_typ as ac_typ,
wod.workorder_issue_date as workorder_issue_date,
wod.workorder_due_date as workorder_due_date,
wod.workorder_state as workorder_state,
wod.critical as critical,
wod.ata_chapter as ata_chapter,
wod.type as type,
wod.issue_station as issue_station,
wod.mel_code as mel_code,
wod.ext_workorderno as ext_workorderno,
wod.wpno as assign_wpno,
wod.planned_station as planned_station,
wod.workstep as workstep,
wod.header as header,
wod.workstep_issue_date as workstep_issue_date,
wod.workstep_status as workstep_status,
wod.part_request as part_request,
wod.part_request_created_date as part_request_created_date,
wod.partno as partno,
wod.part_description as part_description,
wod.pr_qty as pr_qty,
wod.confirmed_qty as confirmed_qty,
wod.part_request_state as part_request_state,
wod.orderno as orderno,
wod.order_issue_date as order_issue_date,
wod.order_priority as order_priority,
wod.order_state as order_state,
wod.order_closing_date as order_closing_date,
wod.stock_info as stock_info,
TRUNC(TO_NUMBER(wod.qty_svo), 2) as qty_svo
FROM
(
SELECT
DISTINCT (wo_header.workorderno_display) workorderno,
wo_header.ac_registr as ac_registr,
aircraft.ac_typ as ac_typ,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.issue_date+729), 'DD.MM.YYYY') as workorder_issue_date,
CASE WHEN wo_transfer.is_last_transfer IS NULL THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.issue_date+729), 'DD.MM.YYYY')
	 WHEN wo_transfer.is_last_transfer='Y' THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_transfer.absolute_due_date+729), 'DD.MM.YYYY')
	 ELSE '' END as workorder_due_date,
CASE WHEN wo_header.state='O' THEN 'Open' ELSE '' END as workorder_state,
CASE WHEN (workstep_classification.critical_task='Y' OR wo_header_crx.aog_risk='Y') THEN 'Y' ELSE '' END as critical,
wo_header.ata_chapter as ata_chapter,
wo_header.type as type,
wo_header.issue_station as issue_station,
wo_header.mel_code as mel_code,
wo_header.ext_workorderno as ext_workorderno,
wp_header.wpno as wpno,
wp_header.station as planned_station,
/* workstep_link.workstep_linkno_i, */
workstep_link.sequenceno as workstep,
wo_text_description.header as header,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (workstep_link.workstep_date+729), 'DD.MM.YYYY') as workstep_issue_date,
CASE WHEN workstep_link.workstep_state='C' THEN 'Closed'
	 WHEN workstep_link.workstep_state IS NULL THEN 'Open'
	 ELSE '' END as workstep_status,
part_request_2.part_requestno_i as part_request,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (part_request_2.created_date+729), 'DD.MM.YYYY') as part_request_created_date,
part_request_2.partno as partno,
part.description as part_description,
TO_NUMBER(part_request_2.qty) as pr_qty,
TO_NUMBER(part_request_2.confirmed_qty) as confirmed_qty,
CASE WHEN part_request_2.status IN ('1','2') THEN 'Closed'
	 WHEN part_request_2.status='0' THEN 'Open'
	 WHEN part_request_2.status='3' THEN 'Suspended'
	 ELSE '' END as part_request_state,
od_header.orderno as orderno,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od_header.orderdate+729), 'DD.MM.YYYY') as order_issue_date,
od_header.priority as order_priority, 
od_header.state as order_state,
CASE WHEN od_header.closing_date IS NOT NULL THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od_header.closing_date+729), 'DD.MM.YYYY') ELSE '' END as order_closing_date,
CASE WHEN wp_header.station IS NULL AND part_forecast.accessable_system_qty&gt;=part_request_2.qty
	 THEN 'IN STOCK '||'('||'requested_qty:'||TO_CHAR(TRUNC(TO_NUMBER(part_request_2.qty), 2))||' '||'accessable_qty:'||TO_CHAR(TRUNC(TO_NUMBER(part_forecast.accessable_system_qty), 2))||')'
	 WHEN wp_header.station IS NULL AND part_forecast.accessable_system_qty&lt;part_request_2.qty
	 THEN 'NOT IN STOCK '||'('||'requested_qty:'||TO_CHAR(TRUNC(TO_NUMBER(part_request_2.qty), 2))||' '||'accessable_qty:'||TO_CHAR(TRUNC(TO_NUMBER(part_forecast.accessable_system_qty), 2))||')'
	 WHEN wp_header.station IS NOT NULL AND part_forecast.accessable_station_qty&gt;=part_request_2.qty
	 THEN 'IN STOCK '||'('||'requested_qty:'||TO_CHAR(TRUNC(TO_NUMBER(part_request_2.qty), 2))||' '||'accessable_qty:'||TO_CHAR(TRUNC(TO_NUMBER(part_forecast.accessable_station_qty), 2))||')'
	 WHEN wp_header.station IS NOT NULL AND part_forecast.accessable_station_qty&lt;part_request_2.qty
	 THEN 'NOT IN STOCK '||'('||'requested_qty:'||TO_CHAR(TRUNC(TO_NUMBER(part_request_2.qty), 2))||' '||'accessable_qty:'||TO_CHAR(TRUNC(TO_NUMBER(part_forecast.accessable_station_qty), 2))||')'
	 ELSE ''
END as stock_info,
CASE WHEN part.mat_class='R' THEN TO_CHAR(TO_NUMBER((NVL(r_stock_svo.qty_svo,0))+(NVL(alt_stock_svo.alt_r_qty,0))))
	 WHEN part.mat_class='C' OR part.mat_class='E' THEN TO_CHAR(TO_NUMBER(((NVL(c_stock_svo.qty_svo,0)) + (NVL(alt_stock_svo.alt_c_qty,0))))) ELSE '' END as qty_svo
FROM
wo_header
LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
LEFT JOIN workstep_classification ON workstep_classification.descno_i=workstep_link.descno_i
LEFT JOIN wo_header_crx ON wo_header.event_perfno_i=wo_header_crx.event_perfno_i
LEFT JOIN wo_transfer ON wo_header.event_perfno_i=wo_transfer.event_perfno_i
LEFT JOIN aircraft ON aircraft.ac_registr=wo_header.ac_registr
LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key
LEFT JOIN part_request_od_detail ON part_request_2.part_requestno_i=part_request_od_detail.part_requestno_i
LEFT JOIN od_detail ON part_request_od_detail.od_detailno_i=od_detail.detailno_i
LEFT JOIN od_header ON od_header.orderno_i=od_detail.orderno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i=wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i=wp_header.wpno_i
LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
LEFT JOIN part_forecast ON part_request_2.part_requestno_i=part_forecast.part_requestno_i
LEFT JOIN part ON part_request_2.partno=part.partno
LEFT JOIN (SELECT
		   COUNT (1) as qty_svo,
		   location.station as station,
		   rotables.partno as partno
		   FROM
		   rotables 
		   JOIN location ON rotables.locationno_i = location.locationno_i 
		   WHERE
		   rotables.ac_registr IN (' ', 'TRANSF')
		   AND rotables.partnonew=' '
		   AND rotables.condition&lt;&gt;'US'
		   AND (rotables.outgoing_detailno_i IS NULL OR rotables.locationno_i &lt;&gt; -200)
		   AND location.locationno_i &lt;&gt; -1 
		   AND location.location_restriction = 0 
		   AND location.station='SVO'
		   GROUP BY
		   location.station,
           rotables.partno
		  ) r_stock_svo ON part.partno=r_stock_svo.partno
LEFT JOIN (SELECT
		   location.station as station,
		   TO_NUMBER(sum(consumables.qty)) as qty_svo,
		   consumables.partno as partno
		   FROM consumables 
		   LEFT JOIN location ON consumables.locationno_i = location.locationno_i 
		   WHERE
		   location.station&lt;&gt;' '
	  	   AND location.station='SVO'
  		   AND location.location_type &lt;&gt; -107
   		   AND location.location_type &lt;&gt; -4
    	   AND location.location_type &lt;&gt; -8
		   GROUP BY
		   location.station,
		   consumables.partno
		  ) c_stock_svo ON part.partno=c_stock_svo.partno

LEFT JOIN (
		   SELECT
		   part_alternate.partno as partno,
		   SUM(alt_r_stock_svo.qty_svo) as alt_r_qty,
		   SUM(alt_c_stock_svo.qty_svo) as alt_c_qty
		   FROM
		   part_alternate
		   LEFT JOIN (SELECT
		   		   	  COUNT (1) as qty_svo,
		   		   	  location.station as station,
		   		   	  rotables.partno as partno
		   		   	  FROM
		   		   	  rotables 
		   		   	  JOIN location ON rotables.locationno_i = location.locationno_i 
		   		   	  WHERE
		   		   	  rotables.ac_registr IN (' ', 'TRANSF')
		   		   	  AND rotables.partnonew=' '
		   		   	  AND rotables.condition&lt;&gt;'US'
		   		   	  AND (rotables.outgoing_detailno_i IS NULL OR rotables.locationno_i &lt;&gt; -200)
		   		   	  AND location.locationno_i &lt;&gt; -1 
		   		   	  AND location.location_restriction = 0 
		   		   	  AND location.station='SVO'
		   		   	  GROUP BY
		   		   	  location.station,
		              rotables.partno
		   			 ) alt_r_stock_svo ON part_alternate.altpartno=alt_r_stock_svo.partno
		   LEFT JOIN (SELECT
		   		   	  location.station as station,
		   		   	  TO_NUMBER(sum(consumables.qty)) as qty_svo,
		   		   	  consumables.partno as partno
		   		   	  FROM consumables 
		   		   	  LEFT JOIN location ON consumables.locationno_i = location.locationno_i 
		   		   	  WHERE
		   		   	  location.station&lt;&gt;' '
		   		   	  AND location.station='SVO'
		   		   	  AND location.location_type &lt;&gt; -107
		   		   	  AND location.location_type &lt;&gt; -4
		   		   	  AND location.location_type &lt;&gt; -8
		   		   	  GROUP BY
		   		   	  location.station,
		   		   	  consumables.partno
					 ) alt_c_stock_svo ON part_alternate.altpartno=alt_c_stock_svo.partno
		   WHERE
		   part_alternate.type IN ('A', 'R', 'S')
		   GROUP BY 
		   part_alternate.partno
		  ) alt_stock_svo ON part.partno=alt_stock_svo.partno
LEFT JOIN part ON part_request_2.partno=part.partno
WHERE
wo_header.state='O'
AND (wo_transfer.transfer_type IN ('T', 'E') OR wo_transfer.transfer_type IS NULL)
AND (wo_transfer.is_last_transfer='Y' OR wo_transfer.is_last_transfer IS NULL)
AND wo_header.issue_date&gt;='@VAR.from@'
AND wo_header.issue_date&lt;='@VAR.to@'
AND (
	 aircraft.ac_typ='@VAR.ac_type@'
	 OR 
	 /* 17-01-2020 
        vtsymbal add new ac_typ A350
    */
	 (REGEXP_LIKE (aircraft.ac_typ, REPLACE('@VAR.ac_type@', 'ALL', 'A32S|A330|B737|B777|A350')))
	)
AND (REGEXP_LIKE(part_request_2.partno, REPLACE('@VAR.part@', ', ', '|')) OR '@VAR.part@' IS NULL)
AND part_request_2.event_type='WSL'
) wod

ORDER BY
wod.workorderno,
wod.workstep</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
