      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.from@">
          <ds:object>@VAR.from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.to@">
          <ds:object>@VAR.to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_type@">
          <ds:object>@VAR.ac_type@</ds:object>
        </ds:value>
