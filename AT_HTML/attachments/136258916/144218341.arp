        <ds:columnDescriptor amosType="ALPHANUM" description="wod.pr_qty as pr_qty" id="pr_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wod.pr_qty as pr_qty&#10;wod.confirmed_qty as confirmed_qty" id="confirmed_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wod.part_request_state as part_request_state" id="part_request_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wod.orderno as orderno" id="orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wod.order_issue_date as order_issue_date" id="order_issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wod.order_priority as order_priority" id="order_priority"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wod.order_state as order_state" id="order_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wod.order_closing_date as order_closing_date" id="order_closing_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wod.stock_info as stock_info" id="stock_info"/>
