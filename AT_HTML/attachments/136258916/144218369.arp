    <view class="LabelReportView" id="20154">
      <attribute name="name">Label_2</attribute>
      <attribute name="position">0 17</attribute>
      <attribute name="size">1000 25</attribute>
      <attribute name="visible">YES</attribute>
      <attribute name="auto-resize">NO</attribute>
      <attribute name="rotation">0.0</attribute>
      <conditional_attributes>
        <conditional_attribute id="1">
          <attribute name="text">Based on data in @SYSTEM.AMOS_SERVER@ environment as of @195_CurrentDateTime.f_date@ @195_CurrentDateTime.f_time@UTC (Receivings: @195_conv_period_date.date_from@ - @195_conv_period_date.date_to@)</attribute>
          <conditions>
            <condition class="GenericStyleCondition">
              <field id="1">@VAR.date_from@</field>
              <field id="2">0</field>
              <operator negated="NO">IS_BIGGER</operator>
            </condition>
          </conditions>
        </conditional_attribute>
      </conditional_attributes>
      <attribute name="color">000000</attribute>
      <attribute name="margin">0 0 0 0</attribute>
      <attribute name="padding">0 0 0 0</attribute>
      <attribute name="border">0 SOLID 000000</attribute>
      <attribute name="text">Based on data in @SYSTEM.AMOS_SERVER@ environment as of @195_CurrentDateTime.f_date@ @195_CurrentDateTime.f_time@UTC</attribute>
      <attribute name="text-decoration">NONE</attribute>
      <attribute name="font">SansSerif PLAIN 10</attribute>
      <attribute name="text-align">CENTER</attribute>
      <attribute name="line-break">AS_IS</attribute>
      <attribute name="splitable">NO</attribute>
      <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
      <attribute name="antialias">false</attribute>
      <anchor>
        <location>TOP_LEFT</location>
        <anchor_view>20153</anchor_view>
        <anchor_location>TOP_LEFT</anchor_location>
        <x_offset>0</x_offset>
        <y_offset>16</y_offset>
      </anchor>
    </view>
  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="STA" description="" id="STATION"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="MAT_CLASS"/>
        <ds:columnDescriptor amosType="STOO" description="" id="STORE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="AC_TYP"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_to"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_from"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="5. Station" id="STATION">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="4.Material class:" id="MAT_CLASS">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>ALL</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>R&amp;=&amp;Rotables;C&amp;=&amp;Consumables;E&amp;=&amp;Expendables;ALL&amp;=&amp;ALL;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="6. Store" id="STORE">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="3. AC type:" id="AC_TYP">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>RRJ</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>RRJ&amp;=&amp;RRJ;A32S&amp;=&amp;A32S;B777&amp;=&amp;B777;A330&amp;=&amp;A330;B737&amp;=&amp;B737;A350&amp;=&amp;A350;ALL&amp;=&amp;ALL;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="2. Receiving Date to" id="date_to">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="1. Receiving Date from:" id="date_from">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="DET" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              CASE WHEN REGEXP_LIKE(od_rec_detail.partno '^[0-9]+$') AND REGEXP_LIKE(od_rec_detail.partno'^0') THEN chr(39)||od_rec_detail.partno ELSE od_rec_detail.partno END as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              CASE WHEN od_rec_detail.serialno IS NULL&#10;                         THEN CASE WHEN REGEXP_LIKE(od_rec_detail.batchno '^[0-9]+$') AND REGEXP_LIKE(od_rec_detail.batchno '^0') THEN chr(39)||od_rec_detail.batchno ELSE od_rec_detail.batchno END&#10;                         ELSE CASE WHEN REGEXP_LIKE(od_rec_detail.serialno '^[0-9]+$') AND REGEXP_LIKE(od_rec_detail.serialno'^0') THEN chr(39)||od_rec_detail.serialno ELSE od_rec_detail.serialno END&#10;              END as sn_bn" id="sn_bn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.measure_unit ||chr(10)||'('||measure_unit.description||')' as measure_unit" id="measure_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.qty as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (od_rec_header.del_date+729)'dd.mm.yyyy') as receiving_date" id="receiving_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             to_char(to_date('31.12.1971' 'dd.mm.yyyy') + od_rec_header.mutation + od_rec_header.mutation_time  / 1000 / 60 / 60 / 24'dd.mm.yyyy hh24:mi:ss') as receiving_mutation" id="receiving_mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_header.mutator" id="od_rec_header.mutator"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_header.awbno as awbno" id="awbno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno as orderno" id="orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.pool_reason as prio" id="prio"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.priority" id="od_header.priority"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.station||'/'||history.store as store" id="store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="station_store.description as stor_desc" id="stor_desc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sh_inf_eo.awbno as eo_awbno" id="eo_awbno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.lastname||' '||sign.firstname AS Name" id="Name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.mat_class" id="part.mat_class"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_TYP@">
          <ds:object>@VAR.AC_TYP@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.MAT_CLASS@">
          <ds:object>@VAR.MAT_CLASS@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.STATION@">
          <ds:object>@VAR.STATION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.STORE@">
          <ds:object>@VAR.STORE@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
              CASE WHEN REGEXP_LIKE(od_rec_detail.partno, '^[0-9]+$') AND REGEXP_LIKE(od_rec_detail.partno, '^0') THEN chr(39)||od_rec_detail.partno ELSE od_rec_detail.partno END as partno,
              CASE WHEN od_rec_detail.serialno IS NULL
                         THEN CASE WHEN REGEXP_LIKE(od_rec_detail.batchno, '^[0-9]+$') AND REGEXP_LIKE(od_rec_detail.batchno, '^0') THEN chr(39)||od_rec_detail.batchno ELSE od_rec_detail.batchno END
                         ELSE CASE WHEN REGEXP_LIKE(od_rec_detail.serialno, '^[0-9]+$') AND REGEXP_LIKE(od_rec_detail.serialno, '^0') THEN chr(39)||od_rec_detail.serialno ELSE od_rec_detail.serialno END
              END as sn_bn,
             part.description as description,
             part.measure_unit ||chr(10)||'('||measure_unit.description||')' as measure_unit,
             od_rec_detail.qty as qty,
             to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (od_rec_header.del_date+729),'dd.mm.yyyy') as receiving_date,
             to_char(to_date('31.12.1971', 'dd.mm.yyyy') + od_rec_header.mutation + od_rec_header.mutation_time  / 1000 / 60 / 60 / 24, 'dd.mm.yyyy hh24:mi:ss') as receiving_mutation,
             od_rec_header.mutator,
             od_rec_header.awbno as awbno,
             od_detail.ac_registr as ac_registr,
             od_header.orderno as orderno,
             od_header.pool_reason as prio,
             wo_header.event_perfno_i as event_perfno_i,
             od_header.priority,
             history.station||'/'||history.store as store,
             station_store.description as stor_desc,
             sh_inf_eo.awbno as eo_awbno,
	sign.lastname||' '||sign.firstname AS Name,
	part.mat_class
FROM od_rec_detail
LEFT JOIN (
                   SELECT sh_header.awbno,
                                sh_detail.od_detailno_i                                   
                   FROM sh_header
                   LEFT JOIN sh_detail ON sh_header.shipmentno_i = sh_detail.shipmentno_i
                   WHERE sh_header.status &lt;&gt; -5
                                AND sh_header.type='EO'
                  ) sh_inf_eo ON sh_inf_eo.od_detailno_i = od_rec_detail.detailno_i
LEFT JOIN od_rec_header ON od_rec_header.receivingno = od_rec_detail.receivingno
LEFT JOIN sign ON od_rec_header.mutator = sign.user_sign

LEFT JOIN part ON part.partno = od_rec_detail.partno
LEFT JOIN measure_unit ON measure_unit.measure_unit = part.measure_unit

LEFT JOIN od_header ON od_header.orderno = od_rec_detail.orderno
LEFT JOIN od_detail ON od_detail.orderno_i = od_header.orderno_i
LEFT JOIN aircraft ON od_detail.ac_registr = aircraft.ac_registr

LEFT JOIN (
                    SELECT allocation_link.ref_key,
                                  allocation_link.source_key
                    FROM allocation_link
                    WHERE allocation_link.source_type = 'PARTRQST'
                                   AND allocation_link.ref_type = 'ORDER_DE'
                  ) al_link ON al_link.ref_key = od_detail.detailno_i
LEFT JOIN part_request_2 ON al_link.source_key = part_request_2.part_requestno_i
LEFT JOIN workstep_link ON workstep_link.workstep_linkno_i = part_request_2.event_key
LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN aircraft wo_aircraft ON wo_header.ac_registr=wo_aircraft.ac_registr
LEFT JOIN history ON history.recdetailno_i = od_rec_detail.recdetailno_i
LEFT JOIN station_store ON station_store.station = history.station and station_store.store = history.store
WHERE od_rec_detail.status &lt;&gt; 9
              AND history.vm = 'B1'
              AND od_header.vendor NOT IN ('TECH_V', 'DUZD_TECH')
              AND od_header.ext_state NOT IN ('CA', 'D', 'IC', 'T', 'C', 'B')
              AND od_header.order_type NOT IN ('T', 'PU', 'YU', 'LU', 'D', 'W', 'MP', 'Q', 'C')
              AND od_header.internal_repair!='Y'
              AND (
                        @VAR.date_from@&gt;0
                        AND @VAR.date_to@&gt;0
                        AND od_rec_header.del_date&gt;=@VAR.date_from@
                        AND od_rec_header.del_date&lt;=@VAR.date_to@
                        AND (
                           		((aircraft.ac_typ = 'RRJ' OR part.ac_typ = 'RRJ' OR  wo_aircraft.ac_typ ='RRJ' OR od_header.pool_ac_typ IN ('RRJ'))  AND '@VAR.AC_TYP@' = 'RRJ') OR
	            		((aircraft.ac_typ = 'A32S' OR part.ac_typ = 'A32S' OR  wo_aircraft.ac_typ ='A32S' OR od_header.pool_ac_typ IN ('A32S'))  AND '@VAR.AC_TYP@' = 'A32S') OR
                           		((aircraft.ac_typ = 'B777' OR part.ac_typ = 'B777' OR  wo_aircraft.ac_typ ='B777' OR od_header.pool_ac_typ IN ('B777'))  AND '@VAR.AC_TYP@' = 'B777') OR
                           		((aircraft.ac_typ = 'A330' OR part.ac_typ = 'A330' OR  wo_aircraft.ac_typ ='A330' OR od_header.pool_ac_typ IN ('A330'))  AND '@VAR.AC_TYP@' = 'A330') OR
                           		((aircraft.ac_typ = 'B737' OR part.ac_typ = 'B737' OR  wo_aircraft.ac_typ ='B737' OR od_header.pool_ac_typ IN ('B737'))  AND '@VAR.AC_TYP@' = 'B737') OR
								/* 15-01-2020 
								   vtsymbal add new ac_typ A350
								*/
								((aircraft.ac_typ = 'A350' OR part.ac_typ = 'A350' OR  wo_aircraft.ac_typ ='A350' OR od_header.pool_ac_typ IN ('A350'))  AND '@VAR.AC_TYP@' = 'A350') OR
                           		'@VAR.AC_TYP@' = 'ALL'
                                  )
	        AND  (
				part.mat_class = 'C' AND '@VAR.MAT_CLASS@' = 'C' OR
				part.mat_class = 'R' AND '@VAR.MAT_CLASS@' = 'R' OR
				part.mat_class = 'E' AND '@VAR.MAT_CLASS@' = 'E' OR
				'@VAR.MAT_CLASS@' = 'ALL' AND part.mat_class IN ('C', 'R', 'E')
                                  )

			OR 
                        @VAR.date_from@=0
                        AND @VAR.date_to@=0
	          AND (aircraft.ac_typ = 'RRJ' OR part.ac_typ = 'RRJ' OR  wo_aircraft.ac_typ ='RRJ' OR od_header.pool_ac_typ IN ('RRJ') )
                        AND od_rec_header.del_date=od_rec_header.mutation
                        AND od_rec_header.mutation*(24*60*60*1000)+od_rec_header.mutation_time&gt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))*(24*60*60*1000) + TO_CHAR(SYSTIMESTAMP, 'SSSSS')*1000 - 1*60*60*1000
                      )
and (REGEXP_LIKE(history.station, REPLACE( '@VAR.STATION@', ', ', '|')) OR '@VAR.STATION@' IS NULL)
and (REGEXP_LIKE(station_store.station_storeno_i, REPLACE( '@VAR.STORE@', ', ', '|')) OR '@VAR.STORE@' IS NULL)
ORDER BY  od_rec_header.del_date, od_header.orderno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="195_CurrentDateTime" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(SYSDATE'MM.DD.YYYY') as f_date" id="f_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(SYSDATE'HH24:MI:SS') as f_time" id="f_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	TO_CHAR(SYSDATE, 'MM.DD.YYYY') as f_date,
	TO_CHAR(SYSDATE, 'HH24:MI:SS') as f_time
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="195_conv_period_date" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + @VAR.date_from@ + 729'DD.MM.YYYY') as date_from" id="date_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + @VAR.date_to@ + 729'DD.MM.YYYY') as date_to" id="date_to"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + @VAR.date_from@ + 729, 'DD.MM.YYYY') as date_from,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + @VAR.date_to@ + 729, 'DD.MM.YYYY') as date_to
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
