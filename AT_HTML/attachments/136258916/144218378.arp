  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="STA" description="" id="STATION"/>
        <ds:columnDescriptor amosType="STOO" description="" id="STORE"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="1.Station" id="STATION">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="2.Store" id="STORE">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.partno AS PN" id="PN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.serialno AS SN" id="SN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.station AS STATION" id="STATION"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.store AS STORE" id="STORE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_header.pickslipno AS PICKSLIP" id="PICKSLIP"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_header.booking_sign||' '||sign.firstname||' '||sign.lastname AS MECH_NAME" id="MECH_NAME"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (pickslip_header.pickslip_date+729)'dd.mm.yyyy') AS PICKSLIP_DATE" id="PICKSLIP_DATE"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.STATION@">
          <ds:object>@VAR.STATION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.STORE@">
          <ds:object>@VAR.STORE@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT   r.partno AS PN
        ,r.serialno AS SN
        ,location.station AS STATION
        ,location.store AS STORE
        ,pickslip_header.pickslipno AS PICKSLIP
        ,pickslip_header.booking_sign||' '||sign.firstname||' '||sign.lastname AS MECH_NAME
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (pickslip_header.pickslip_date+729), 'dd.mm.yyyy') AS PICKSLIP_DATE
FROM rotables r
LEFT JOIN location ON r.locationno_i = location.locationno_i
LEFT JOIN
            (
                            SELECT   rotables.psn AS psn
                                    ,wo_part_on_off.labelno AS LB
                            FROM rotables 
                            LEFT JOIN history ON rotables.psn = history.psn
                            LEFT JOIN wo_part_on_off ON history.labelno =  wo_part_on_off.labelno
                            WHERE NVL(wo_part_on_off.labelno, 0) != 0
                            AND wo_part_on_off.status = '0'
            ) lb ON r.psn = lb.psn
LEFT JOIN
            (
                            SELECT 
                                wo_header.event_perfno_i AS WO
                                ,pickslip_booked.pickslipno AS Pickslip
                                ,pickslip_booked.partno AS Partno
                                ,pickslip_booked.serialno AS Serialno
                                ,pickslip_header.receiver
                                ,rotables.psn AS psn
                            FROM pickslip_booked
                            LEFT JOIN pickslip_detail ON pickslip_booked.pickslipno = pickslip_detail.pickslipno AND  pickslip_detail.recno = pickslip_booked.recno
                            LEFT JOIN pickslip_header ON pickslip_booked.pickslipno = pickslip_header.pickslipno
                            LEFT JOIN part_request_2 ON pickslip_detail.part_requestno_i =  part_request_2.part_requestno_i
                            LEFT JOIN workstep_link ON part_request_2.event_key = workstep_link.workstep_linkno_i AND  part_request_2.event_type = 'WSL'
                            LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
                            LEFT JOIN rotables ON pickslip_booked.partno = rotables.partno AND pickslip_booked.serialno = rotables.serialno
                            WHERE 
                            rotables.location = 'HANGAR'
                            AND wo_header.state = 'O'                              
            ) ps ON r.psn = ps.psn
LEFT JOIN pickslip_booked ON r.partno = pickslip_booked.partno AND r.serialno = pickslip_booked.serialno AND pickslip_booked.status = '9'  AND pickslip_booked.location_to = 'HANGAR'     
LEFT JOIN pickslip_header ON pickslip_booked.pickslipno = pickslip_header.pickslipno
LEFT JOIN sign ON pickslip_header.booking_sign = sign.user_sign
WHERE location.location_type = '-5'
AND NVL(lb.LB, 0) = 0
AND NVL(ps.WO, 0) = 0
AND (REGEXP_LIKE(location.station, REPLACE('@VAR.STATION@', ', ', '|')) OR '@VAR.STATION@' IS NULL)
AND (REGEXP_LIKE(location.linked_key, REPLACE('@VAR.STORE@', ', ', '|')) OR '@VAR.STORE@' IS NULL)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
