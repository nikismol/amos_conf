        <attribute name="border-bottom-style">SOLID</attribute>
        <attribute name="border-bottom-color">000000</attribute>
        <attribute name="border-right-width">1</attribute>
        <attribute name="border-right-style">SOLID</attribute>
        <attribute name="border-right-color">000000</attribute>
      </border>
      <attribute name="text">Уникальные ВС типа (@VAR.ac_type@)
из столбца 2</attribute>
