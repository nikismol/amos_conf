            <attribute name="text">@RR_MAIN.duration@</attribute>
            <attribute name="text-decoration">NONE</attribute>
            <attribute name="font">SansSerif PLAIN 10</attribute>
            <attribute name="text-align">LEFT</attribute>
            <attribute name="line-break">AS_IS</attribute>
            <attribute name="splitable">NO</attribute>
            <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
            <attribute name="antialias">false</attribute>
          </view>
        </column>
      </column_model>
      <attribute name="data-source">RR_MAIN</attribute>
    </view>
  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="AC" description="" id="v02_ac_registr"/>
        <ds:columnDescriptor amosType="VD" description="" id="v03_mro_provider"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="v01_ac_typ"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="v05_date_to"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="v04_date_from"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="02. Aircraft" id="v02_ac_registr">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
