    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RR_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno as wpno" id="wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_sequence.seqno_i as seqno" id="seqno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="decode(wp_header.wp_status&#10;                              -1 'Open'&#10;                              -2 'Closed'&#10;                              -3 'In_progress''') as wp_status" id="wp_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(to_date('31.12.1971''DD.MM.YYYY') + wp_header.start_date'DD.MM.YYYY') as wp_planned_start_date" id="wp_planned_start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(to_date('31.12.1971''DD.MM.YYYY') + wp_header.end_date'DD.MM.YYYY') as wp_planned_end_date" id="wp_planned_end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="decode(wp_header.act_start_date&#10;                             null null&#10;                             TO_CHAR(to_date('31.12.1971''DD.MM.YYYY') + wp_header.act_start_date'DD.MM.YYYY')) as wp_act_start_date" id="wp_act_start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="decode(wp_header.act_end_date&#10;                             null null&#10;                             TO_CHAR(to_date('31.12.1971''DD.MM.YYYY') + wp_header.act_end_date'DD.MM.YYYY')) as wp_act_end_date" id="wp_act_end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(wp_header.est_groundtime)/60)'FM999999999900')) ||':'||TO_CHAR(TRUNC(MOD(TO_NUMBER(wp_header.est_groundtime)60))'FM00') as est_groundtime_hrs" id="est_groundtime_hrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.hidden as wp_classification" id="wp_classification"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as wono" id="wono"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_event_link.event_display as event_display" id="event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.header||' '||TO_CHAR(DBMS_LOB.SUBSTR(NVL(wo_text_description.text wo_text_description.text_html) 20001)) as wo_text" id="wo_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link.sequenceno as workstep_no" id="workstep_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_captured.user_sign as Staff_Times_Sign" id="Staff_Times_Sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(to_date('31.12.1971''DD.MM.YYYY')+time_captured.start_date'DD.MM.YYYY') as Staff_Times_Start_date" id="Staff_Times_Start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="LPAD((time_captured.end_time - MOD(time_captured.end_time60))/60 2 0)  ||':'|| LPAD(MOD(time_captured.end_time60) 20) as Staff_Times_Start_Time" id="Staff_Times_Start_Time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(to_date('31.12.1971' 'DD.MM.YYYY') + time_captured.end_date'DD.MM.YYYY') as Staff_Times_End_Date" id="Staff_Times_End_Date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="LPAD((time_captured.end_time - MOD(time_captured.end_time60))/60 2 0)  ||':'|| LPAD(MOD(time_captured.end_time60) 20) as Staff_Times_End_Time" id="Staff_Times_End_Time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(time_captured.duration)/60)'FM999999999900')) ||':'||TO_CHAR(TRUNC(MOD(TO_NUMBER(time_captured.duration)60))'FM00') as Staff_Times_Prod_MHR" id="Staff_Times_Prod_MHR"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_captured.type_of_work_no as Staff_Times_Type" id="Staff_Times_Type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(resource_req.total_hours)/60)'FM999999999900')) ||':'||TO_CHAR(TRUNC(MOD(TO_NUMBER(resource_req.total_hours)60))'FM00') as total_hours" id="total_hours"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="resource_req.resource_quantity as resource_quantity" id="resource_quantity"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(rr_dur.duration)/60)'FM999999999900')) ||':'||TO_CHAR(TRUNC(MOD(TO_NUMBER(rr_dur.duration)60))'FM00') as duration" id="duration"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v01_ac_typ@">
          <ds:object>@v01_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v02_ac_registr@">
          <ds:object>@v02_ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v03_mro_provider@">
          <ds:object>@v03_mro_provider@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v04_date_from@">
          <ds:object>@v04_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_date_to@">
          <ds:object>@v05_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT wp_header.wpno as wpno
              ,wp_sequence.seqno_i as seqno
              ,decode(wp_header.wp_status,
                              -1, 'Open',
                              -2, 'Closed',
                              -3, 'In_progress',
                              '') as wp_status
             ,aircraft.ac_typ as ac_typ
             ,aircraft.ac_registr as ac_registr
             ,TO_CHAR(to_date('31.12.1971','DD.MM.YYYY') + wp_header.start_date, 'DD.MM.YYYY') as wp_planned_start_date
             ,TO_CHAR(to_date('31.12.1971','DD.MM.YYYY') + wp_header.end_date, 'DD.MM.YYYY') as wp_planned_end_date
             ,decode(wp_header.act_start_date,
                             null, null,
                             TO_CHAR(to_date('31.12.1971','DD.MM.YYYY') + wp_header.act_start_date, 'DD.MM.YYYY')) as wp_act_start_date
             ,decode(wp_header.act_end_date,
                             null, null,
                             TO_CHAR(to_date('31.12.1971','DD.MM.YYYY') + wp_header.act_end_date, 'DD.MM.YYYY')) as wp_act_end_date
             ,TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(wp_header.est_groundtime)/60),'FM999999999900')) ||':'||TO_CHAR(TRUNC(MOD(TO_NUMBER(wp_header.est_groundtime),60)),'FM00') as est_groundtime_hrs
             ,wp_header.hidden as wp_classification
             ,wo_header.event_perfno_i as wono
             ,wo_event_link.event_display as event_display
             ,wo_text_description.header||' '||TO_CHAR(DBMS_LOB.SUBSTR(NVL(wo_text_description.text, wo_text_description.text_html), 2000, 1)) as wo_text
             ,workstep_link.sequenceno as workstep_no
             ,time_captured.user_sign as Staff_Times_Sign
             ,TO_CHAR(to_date('31.12.1971','DD.MM.YYYY')+time_captured.start_date, 'DD.MM.YYYY') as Staff_Times_Start_date
             ,LPAD((time_captured.start_time-MOD(time_captured.start_time,60))/60, 2, 0) ||':'|| LPAD(MOD(time_captured.start_time,60), 2, 0) as Staff_Times_Start_Time
             ,TO_CHAR(to_date('31.12.1971', 'DD.MM.YYYY') + time_captured.end_date,'DD.MM.YYYY') as Staff_Times_End_Date
             ,LPAD((time_captured.end_time - MOD(time_captured.end_time,60))/60, 2, 0)  ||':'|| LPAD(MOD(time_captured.end_time,60), 2, 0) as Staff_Times_End_Time
             ,TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(time_captured.duration)/60),'FM999999999900')) ||':'||TO_CHAR(TRUNC(MOD(TO_NUMBER(time_captured.duration),60)),'FM00') as Staff_Times_Prod_MHR
             ,time_captured.type_of_work_no as Staff_Times_Type
             ,TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(resource_req.total_hours)/60),'FM999999999900')) ||':'||TO_CHAR(TRUNC(MOD(TO_NUMBER(resource_req.total_hours),60)),'FM00') as total_hours
             ,resource_req.resource_quantity as resource_quantity
             ,TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(rr_dur.duration)/60),'FM999999999900')) ||':'||TO_CHAR(TRUNC(MOD(TO_NUMBER(rr_dur.duration),60)),'FM00') as duration 
FROM time_captured

LEFT JOIN workstep_link wsl_text ON time_captured.primkey = wsl_text.event_perfno_i AND wsl_text.sequenceno = 1
LEFT JOIN wo_text_description ON wsl_text.descno_i = wo_text_description.descno_i

LEFT JOIN time_captured_additional ON time_captured.bookingno_i=time_captured_additional.bookingno_i
LEFT JOIN wo_text_action ON time_captured_additional.itemno_i=wo_text_action.actionno_i
LEFT JOIN wo_header ON time_captured.primkey = wo_header.event_perfno_i AND time_captured.mime_type IN ('WO', 'MET', 'SCA', 'JCA', 'CR', 'NT')  
LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
LEFT JOIN wp_assignment ON wp_assignment.event_perfno_i=wo_header.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i=wp_header.wpno_i
LEFT JOIN wp_sequence ON wo_header.event_perfno_i=wp_sequence.event_perfno_i AND wp_sequence.wpno_i=wp_header.wpno_i AND wp_sequence.status=0
LEFT JOIN sign ON time_captured.user_sign =sign.user_sign
LEFT JOIN wo_event_link ON wo_header.event_perfno_i=wo_event_link.event_perfno_i
LEFT JOIN workstep_link ON workstep_link.event_perfno_i=wo_header.event_perfno_i AND wo_text_action.workstep_linkno_i=workstep_link.workstep_linkno_i
LEFT JOIN (
                   SELECT SUM(rm_resource_requirement.total_hours) as total_hours,
                                  SUM( rm_resource_requirement.resource_quantity) as resource_quantity,
                                  workstep_link.workstep_linkno_i
                   FROM workstep_link
                   JOIN rm_resource_request ON rm_resource_request.request_owner_amos_key = workstep_link.descno_i
                   JOIN rm_resource_requirement ON rm_resource_request.resource_request_noi=rm_resource_requirement.resource_request_noi
                   JOIN rm_resource_constraint ON rm_resource_constraint.resource_requirement_noi=rm_resource_requirement.resource_requirement_noi
                   JOIN rm_property_type ON rm_property_type.property_type_no_i = rm_resource_constraint.property_type_no_i
                   WHERE 1=1
                                  AND rm_resource_request.request_owner_amos_type = 'WS'
                                  AND rm_property_type.property_type_id = 'SCOPE'
                   GROUP BY workstep_link.workstep_linkno_i
                 ) resource_req ON workstep_link.workstep_linkno_i=resource_req.workstep_linkno_i
LEFT JOIN (
                   SELECT workstep_link.workstep_linkno_i,
                                  rm_resource_requirement.elapsed_time as duration,
                                  MAX(rm_resource_requirement.elapsed_time) OVER (PARTITION BY workstep_link.workstep_linkno_i) as max_duration
                   FROM workstep_link
                   JOIN rm_resource_request ON rm_resource_request.request_owner_amos_key = workstep_link.descno_i
                   JOIN rm_resource_requirement ON rm_resource_request.resource_request_noi=rm_resource_requirement.resource_request_noi
                   JOIN rm_resource_constraint ON rm_resource_constraint.resource_requirement_noi=rm_resource_requirement.resource_requirement_noi
                   JOIN rm_property_type ON rm_property_type.property_type_no_i = rm_resource_constraint.property_type_no_i
                   WHERE 1=1
                                  AND rm_resource_request.request_owner_amos_type = 'WS'
                                  AND rm_property_type.property_type_id = 'SCOPE'
                 ) rr_dur ON workstep_link.workstep_linkno_i=rr_dur.workstep_linkno_i AND rr_dur.duration=rr_dur.max_duration
WHERE 1=1
               AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@v01_ac_typ@', ', ', '|')) OR '@v01_ac_typ@' IS NULL)
               AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@v02_ac_registr@', ', ', '|')) OR '@v02_ac_registr@' IS NULL)
               AND ('@v03_mro_provider@' IS NULL
                         OR
                         sign.company_new='@v03_mro_provider@'
                         OR
                         sign.department =  regexp_replace('@v03_mro_provider@', '^00', '')
                         AND NVL(sign.company_new, 'S')!='AFL'
                         AND not regexp_like(sign.user_sign, '^[0-9]+$')  
                         )
               AND time_captured.start_date BETWEEN @v04_date_from@ AND @v05_date_to@
ORDER BY wpno nulls last, wono, workstep_no, Staff_Times_Sign</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
