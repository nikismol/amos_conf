  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AC_TYPE" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as ac_typ" id="ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT (aircraft.ac_typ) as ac_typ
FROM aircraft
/* 16-01-2020 
     vtsymbal add new ac_typ A350
 */
WHERE aircraft.ac_typ IN ('A330','B737','B777', 'A32S', 'A350')
ORDER BY ac_typ</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_IFE_INOP" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.workorderno_display as wo" id="wo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT wo_header.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(wo_text_description.text) as issue" id="issue"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="action_text.action_text as investigation_sum" id="investigation_sum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_req.pn as pn" id="pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN part_accessable_qty.store_report='Closed' THEN '' ELSE part_accessable_qty.store_report END as store_report" id="store_report"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AC_TYPE.ac_typ@">
          <ds:object>@AC_TYPE.ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
       DISTINCT wo.event_perfno_i as wo,
       wo_header.ac_registr as ac_registr,
       NVL(TO_CHAR(wo_text_description.text), TO_CHAR(wo_text_description.text_html)) as issue,
       DBMS_lob.substr(wo.action_text, 3000, 1) as investigation_sum,
       part_req.pn as pn,
       part_accessable_qty.store_report as store_report
FROM (
    SELECT
        DISTINCT wo_header.event_perfno_i,
        RTRIM(XMLAGG(XMLELEMENT(E, TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wo_text_action.action_date), 'DD.MM.YYYY') || CASE WHEN wo_text_action.text IS NOT NULL THEN ': '||TO_CHAR(wo_text_action.text)||'.' ELSE '' END).EXTRACT('//text()')  ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as action_text
    FROM
        wo_header
    LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
    LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
    LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
    LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
    LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i=wo_text_action.workstep_linkno_i and wo_text_action.actionno_i!=3388154
    WHERE
        wo_header.state='O'
      AND wo_header.type NOT IN ('S', 'T', 'PD')
      AND (
          wo_header.ata_chapter LIKE ('44%') AND aircraft.ac_typ IN ('B737', 'B777')
              OR
          wo_header.ata_chapter LIKE ('23%') AND aircraft.ac_typ IN ('A330', 'B737')
              OR
          aircraft.ac_typ IN ('A32S')
              AND
          (wo_header.ata_chapter LIKE ('23%') OR wo_header.ata_chapter LIKE ('44%'))
              AND
          (wo_header_more.mel_chapter NOT LIKE ('23%') OR wo_header_more.mel_chapter IS NULL)
              AND
          (NOT REGEXP_LIKE(wo_text_description.header, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.header IS NULL)
              AND
          (NOT REGEXP_LIKE(wo_text_description.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text IS NULL)
              AND
          (NOT REGEXP_LIKE(wo_text_description.text_html, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text_html IS NULL)
              AND
          (NOT REGEXP_LIKE(wo_text_action.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_action.text IS NULL))
    GROUP BY wo_header.event_perfno_i
    ) wo
JOIN wo_header ON wo.event_perfno_i=wo_header.event_perfno_i
JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i AND workstep_link.sequenceno='1'
LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
LEFT JOIN (
    SELECT wo_header.event_perfno_i as event_perfno_i,
           LISTAGG (CASE WHEN LENGTH(part.description) + LENGTH(part_request_2.partno) &lt;= 48
               THEN part.description||' '||part_request_2.partno||' - '||TO_NUMBER(part_request_2.qty)||'ea'
               ELSE SUBSTR(part.description, 1, 42)||'...'||' '||part_request_2.partno||' - '||TO_NUMBER(part_request_2.qty)||'ea'
               END, CHR(10)
               ) WITHIN GROUP (ORDER BY part_request_2.part_requestno_i) as pn
    FROM wo_header
    JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
    /* 16-01-2020 vtsymbal add new ac_typ A350 */
                                AND aircraft.ac_typ IN ('A32S', 'A330', 'B737','B777', 'A350')
    JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i and wo_header.state='O' AND wo_header.type NOT IN ('S', 'T', 'PD')
    JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key
    LEFT JOIN part ON part_request_2.partno=part.partno
    WHERE part_request_2.event_type = 'WSL'
    GROUP BY wo_header.event_perfno_i
    ) part_req ON wo_header.event_perfno_i=part_req.event_perfno_i
LEFT JOIN (
    SELECT wo_header.event_perfno_i as event_perfno_i,
           LISTAGG (part_frcst.store_report, CHR(10)) WITHIN GROUP (ORDER BY part_request_2.part_requestno_i) as store_report
    FROM wo_header
    JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
                    /* 16-01-2020 vtsymbal add new ac_typ A350 */
                                AND aircraft.ac_typ IN ('A32S', 'A330', 'B737','B777', 'A350')
    JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i and wo_header.state='O' AND wo_header.type NOT IN ('S', 'T', 'PD')
    LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key
    LEFT JOIN (
        SELECT part_request_2.part_requestno_i as part_requestno_i,
               CASE WHEN part_request_2.status IN ('1', '2') THEN 'Closed'
                   WHEN part_request_2.status='3' THEN 'Suspended'
                   ELSE CASE WHEN planned_station IS NULL THEN TRUNC(TO_NUMBER(part_forecast.accessable_system_qty), 2)||'ea on stock'
                       ELSE TO_NUMBER(part_forecast.accessable_station_qty)||'ea on stock'
                       END
                END as store_report
        FROM part_request_2
        LEFT JOIN part_forecast ON part_request_2.part_requestno_i=part_forecast.part_requestno_i
        ) part_frcst ON part_request_2.part_requestno_i=part_frcst.part_requestno_i
    WHERE part_request_2.event_type = 'WSL'
    GROUP BY wo_header.event_perfno_i
    ) part_accessable_qty ON wo_header.event_perfno_i=part_accessable_qty.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
WHERE
    aircraft.ac_typ='@AC_TYPE.ac_typ@'
AND (
    REGEXP_LIKE(wo_text_description.header, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS |CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
        OR
    REGEXP_LIKE(wo_text_description.text, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS |CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
        OR
    REGEXP_LIKE(wo_text_description.text_html, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
        OR
    REGEXP_LIKE(wo.action_text, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
        OR
    (REGEXP_LIKE(wo_text_description.header, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.header, '(CREW TERMINAL)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.text, '(CREW TERMINAL)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text_html, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(CREW TERMINAL)','i'))
        OR
    (REGEXP_LIKE(wo.action_text, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo.action_text, '(CREW TERMINAL)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.header, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.header, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.text, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text_html, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
        OR
    (REGEXP_LIKE(wo.action_text, '(UPLOAD)','i') AND REGEXP_LIKE(wo.action_text, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.header, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.header, '(SYSTEM)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.text, '(SYSTEM)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text_html, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(SYSTEM)','i'))
        OR
    (REGEXP_LIKE(wo.action_text, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo.action_text, '(SYSTEM)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.header, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.header, '(BUTTON)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.text, '(BUTTON)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text_html, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(BUTTON)','i'))
        OR
    (REGEXP_LIKE(wo.action_text, '(CALL)','i') AND REGEXP_LIKE(wo.action_text, '(BUTTON)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.header, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.header, '(POWER)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.text, '(POWER)','i'))
        OR
    (REGEXP_LIKE(wo_text_description.text_html, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(POWER)','i'))
        OR
    (REGEXP_LIKE(wo.action_text, '(VCC)','i') AND REGEXP_LIKE(wo.action_text, '(POWER)','i'))
      )
  AND
    (NOT REGEXP_LIKE(wo_text_description.header, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.header IS NULL)
  AND
    (NOT REGEXP_LIKE(wo_text_description.text, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.text IS NULL)
  AND
    (NOT REGEXP_LIKE(wo_text_description.text_html, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.text_html IS NULL)
  AND
    (NOT REGEXP_LIKE(wo.action_text, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo.action_text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.header, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.header, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.header IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.text, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text_html, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.text_html, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.text_html IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo.action_text, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo.action_text, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo.action_text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.header, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.header, '(HORN)','i')) OR wo_text_description.header IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.text, '(HORN)','i')) OR wo_text_description.text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text_html, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(HORN)','i')) OR wo_text_description.text_html IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo.action_text, '(EXT)','i') AND REGEXP_LIKE(wo.action_text, '(HORN)','i')) OR wo.action_text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.header, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.header, '(PRERECORDED)','i')) OR wo_text_description.header IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.text, '(PRERECORDED)','i')) OR wo_text_description.text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text_html, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(PRERECORDED)','i')) OR wo_text_description.text_html IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo.action_text, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo.action_text, '(PRERECORDED)','i')) OR wo.action_text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.header, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.header, '(LIGHT-OUTLET)','i')) OR wo_text_description.header IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.text, '(LIGHT-OUTLET)','i')) OR wo_text_description.text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text_html, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(LIGHT-OUTLET)','i')) OR wo_text_description.text_html IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo.action_text, '(IUL)','i') AND REGEXP_LIKE(wo.action_text, '(LIGHT-OUTLET)','i')) OR wo.action_text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.header, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.header, '(SEB)','i')) OR wo_text_description.header IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.text, '(SEB)','i')) OR wo_text_description.text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text_html, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(SEB)','i')) OR wo_text_description.text_html IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo.action_text, '(DOOR)','i') AND REGEXP_LIKE(wo.action_text, '(SEB)','i')) OR wo.action_text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.header, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.header, '(VOICE)','i')) OR wo_text_description.header IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.text, '(VOICE)','i')) OR wo_text_description.text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text_html, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(VOICE)','i')) OR wo_text_description.text_html IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo.action_text, '(SATCOM)','i') AND REGEXP_LIKE(wo.action_text, '(VOICE)','i')) OR wo.action_text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.header, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.header, '(CALL BUTTON)','i')) OR wo_text_description.header IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.text, '(CALL BUTTON)','i')) OR wo_text_description.text IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo_text_description.text_html, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(CALL BUTTON)','i')) OR wo_text_description.text_html IS NULL)
  AND
    (NOT (REGEXP_LIKE(wo.action_text, '(LAV)','i') AND REGEXP_LIKE(wo.action_text, '(CALL BUTTON)','i')) OR wo.action_text IS NULL)
ORDER BY wo DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
