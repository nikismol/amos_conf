      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
	 wp_header.wpno
	,wo_header.event_perfno_i
	,tech_query.queryno_i
	,tech_query.description
FROM tech_query
LEFT JOIN wo_header ON (tech_query.ref_key) = (wo_header.event_perfno_i)
LEFT JOIN wp_assignment ON (wo_header.event_perfno_i) = (wp_assignment.event_perfno_i)
LEFT JOIN wp_header ON (wp_assignment.wpno_i) = (wp_header.wpno_i)
WHERE 
(REGEXP_LIKE(wp_header.wpno_i, REPLACE( '@VAR.WP@', ', ', '|')) OR '@VAR.WP@' IS NULL)
AND tech_query.ref_type = 'WO'
AND tech_query.status IN ('1', '2', '4')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="COMP_CH" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_part_on_off.partno AS pn_on" id="pn_on"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_part_on_off.serialno AS sn_on" id="sn_on"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_part_on_off.partno_off AS pn_off" id="pn_off"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_part_on_off.serialno_off AS sn_off" id="sn_off"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
	 wp_header.wpno
	,wo_header.event_perfno_i
	,wo_part_on_off.partno AS pn_on
	,wo_part_on_off.serialno AS sn_on
	,wo_part_on_off.partno_off AS pn_off
	,wo_part_on_off.serialno_off AS sn_off 
FROM wo_part_on_off
LEFT JOIN wo_header ON wo_part_on_off.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i = wp_header.wpno_i
WHERE 
(REGEXP_LIKE(wp_header.wpno_i, REPLACE( '@VAR.WP@', ', ', '|')) OR '@VAR.WP@' IS NULL)
AND NVL(wo_part_on_off.labelno, 0) = 0
AND wo_part_on_off.status = '0'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="PICKSLIPS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.pickslipno AS Pickslip" id="Pickslip"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.partno AS Partno" id="Partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.serialno AS Serialno" id="Serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_header.receiver" id="pickslip_header.receiver"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	 wp_header.wpno
	,wo_header.event_perfno_i
	,pickslip_booked.pickslipno AS Pickslip
	,pickslip_booked.partno AS Partno
	,pickslip_booked.serialno AS Serialno
    ,pickslip_header.receiver
FROM pickslip_booked
LEFT JOIN pickslip_detail ON pickslip_booked.pickslipno = pickslip_detail.pickslipno AND  pickslip_detail.recno = pickslip_booked.recno
LEFT JOIN pickslip_header ON pickslip_booked.pickslipno = pickslip_header.pickslipno
LEFT JOIN part_request_2 ON pickslip_detail.part_requestno_i =  part_request_2.part_requestno_i
LEFT JOIN workstep_link ON part_request_2.event_key = workstep_link.workstep_linkno_i AND  part_request_2.event_type = 'WSL'
LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i = wp_header.wpno_i
LEFT JOIN rotables ON pickslip_booked.partno = rotables.partno AND pickslip_booked.serialno = rotables.serialno
LEFT JOIN location ON rotables.locationno_i = location.locationno_i
WHERE 
wp_header.wpno_i = '@VAR.WP@'
AND rotables.location = 'HANGAR'
AND location.station = (SELECT station FROM wp_header WHERE wp_header.wpno_i = '@VAR.WP@')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="PU_orders" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno AS PR_Order" id="PR_Order"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od2.orderno AS PU_Order" id="PU_Order"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od2.ext_state" id="od2.ext_state"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT      wp_header.wpno
            ,wo_header.event_perfno_i
            ,od_header.orderno AS PR_Order
            ,od2.orderno AS PU_Order
	,od2.ext_state
FROM od_detail
JOIN od_header ON od_detail.orderno_i = od_header.orderno_i
JOIN allocation_link ON allocation_link.ref_type = 'ORDER_DE' AND allocation_link.ref_key = od_detail.detailno_i AND od_detail.backorder &gt; 0
JOIN part_request_2 ON part_request_2.part_requestno_i = allocation_link.source_key AND allocation_link.source_type = 'PARTRQST'
JOIN workstep_link ON workstep_link.workstep_linkno_i = part_request_2.event_key AND part_request_2.event_type = 'WSL'
LEFT JOIN wo_header ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i = wp_header.wpno_i
LEFT JOIN od_header od2 ON od_header.orderno_i = od2.created_from_orderno_i
WHERE   (REGEXP_LIKE(wp_header.wpno_i, REPLACE( '@VAR.WP@', ', ', '|')) OR '@VAR.WP@' IS NULL)  
        AND od_header.order_type = 'PR'
        AND od2.order_type =  'PU'
        AND od2.ext_state != 'B'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
