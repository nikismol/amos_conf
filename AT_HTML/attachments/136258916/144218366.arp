    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="181_MEL_WO_PC" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as workorder" id="workorder"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_header.issue_date+729)'DD.MM.YYYY') as wo_issue_date" id="wo_issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_header.closing_date+729)'DD.MM.YYYY') as wo_closing_date" id="wo_closing_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE(wo_header.state 'O' 'Open' 'C' 'Closed''') as wo_state" id="wo_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.mel_code as mel_code" id="mel_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE(wo_header.mel_code 'A' 'N/A' 'B' '3' 'C' '10' 'D' '120'wo_header.mel_code) as mel_days" id="mel_days"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.part_requestno_i as part_requestno" id="part_requestno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + part_request_2.created_date + 729'DD.MM.YYYY') as part_request_date" id="part_request_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN REGEXP_LIKE(part_request_2.partno'^[0-9]+$') AND part_request_2.partno LIKE ('0%') THEN chr(39)||part_request_2.partno ELSE part_request_2.partno END as requested_pn" id="requested_pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno as linked_order" id="linked_order"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN REGEXP_LIKE(od_ord.partno'^[0-9]+$') AND od_ord.partno LIKE ('0%') THEN chr(39)||od_ord.partno ELSE od_ord.partno END as received_pn" id="received_pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + od_header.orderdate + 729'DD.MM.YYYY') as order_date" id="order_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (od_orh.del_date+729)'DD.MM.YYYY') as order_rec_date" id="order_rec_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_detail.pickslipno as pickslipno_booked" id="pickslipno_booked"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + pickslip_header.issue_date + 729'DD.MM.YYYY') as pickslip_issue_date" id="pickslip_issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + pickslip_header.pickslip_date + 729'DD.MM.YYYY') as pickslip_book_date" id="pickslip_book_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.partno as booked_pn" id="booked_pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="NVL(pickslip_booked.serialnopickslip_booked.batchno) as booked_sn_bn" id="booked_sn_bn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (od_rec_header.del_date+729)'DD.MM.YYYY') as pn_receiving_date" id="pn_receiving_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.orderno as pn_receiving_order" id="pn_receiving_order"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="NVL(TO_CHAR(wo_transfer.recno)'unknown (transfer is removed)') as transfer_qty" id="transfer_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(wo_header.closing_date - wo_header.issue_date) as ci_01" id="ci_01"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(od_rec_header.del_date - wo_header.issue_date) as ri_02" id="ri_02"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(wo_header.closing_date - od_rec_header.del_date) as cr_03" id="cr_03"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(pickslip_header.pickslip_date - od_rec_header.del_date) as br_04" id="br_04"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN  wo_transfer.absolute_due_date&gt;0 THEN wo_header.closing_date-wo_transfer.absolute_due_date ELSE 'due date is N/A' END as cd_05" id="cd_05"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_ac_typ@">
          <ds:object>@VAR.v01_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_ac_registr@">
          <ds:object>@VAR.v02_ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_wo_issue_from@">
          <ds:object>@VAR.v03_wo_issue_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_wo_issue_to@">
          <ds:object>@VAR.v04_wo_issue_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_wo_closing_from@">
          <ds:object>@VAR.v05_wo_closing_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v06_wo_closing_to@">
          <ds:object>@VAR.v06_wo_closing_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v07_wo_state@">
          <ds:object>@VAR.v07_wo_state@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v08_incl_inactive_ac@">
          <ds:object>@VAR.v08_incl_inactive_ac@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
        wo_header.event_perfno_i as workorder
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.issue_date+729), 'DD.MM.YYYY') as wo_issue_date
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_header.closing_date+729), 'DD.MM.YYYY') as wo_closing_date
       ,DECODE(wo_header.state, 'O', 'Open', 'C', 'Closed', '') as wo_state
       ,aircraft.ac_typ as ac_typ
       ,wo_header.mel_code as mel_code
       ,DECODE(wo_header.mel_code, 'A', 'N/A', 'B', '3', 'C', '10', 'D', '120', wo_header.mel_code) as mel_days
       ,part_request_2.part_requestno_i as part_requestno
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + part_request_2.created_date + 729, 'DD.MM.YYYY') as part_request_date
       ,CASE WHEN REGEXP_LIKE(part_request_2.partno, '^[0-9]+$') AND part_request_2.partno LIKE ('0%') THEN chr(39)||part_request_2.partno ELSE part_request_2.partno END as requested_pn
       ,od_header.orderno as linked_order
       ,CASE WHEN REGEXP_LIKE(od_ord.partno, '^[0-9]+$') AND od_ord.partno LIKE ('0%') THEN chr(39)||od_ord.partno ELSE od_ord.partno END as received_pn
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_header.orderdate + 729, 'DD.MM.YYYY') as order_date
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od_orh.del_date+729), 'DD.MM.YYYY') as order_rec_date
       ,pickslip_detail.pickslipno as pickslipno_booked
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + pickslip_header.issue_date + 729, 'DD.MM.YYYY') as pickslip_issue_date
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + pickslip_header.pickslip_date + 729, 'DD.MM.YYYY') as pickslip_book_date
       ,CASE WHEN REGEXP_LIKE(pickslip_booked.partno, '^[0-9]+$') AND pickslip_booked.partno LIKE ('0%') THEN chr(39)||pickslip_booked.partno ELSE pickslip_booked.partno END as booked_pn
       ,CASE WHEN ASCII(pickslip_booked.serialno)=49824
                  THEN CASE WHEN REGEXP_LIKE(pickslip_booked.batchno, '^[0-9]+$') AND pickslip_booked.batchno LIKE ('0%') THEN chr(39)||pickslip_booked.batchno ELSE pickslip_booked.batchno END
                  ELSE CASE WHEN REGEXP_LIKE(pickslip_booked.serialno, '^[0-9]+$') AND pickslip_booked.serialno LIKE ('0%') THEN chr(39)||pickslip_booked.serialno ELSE pickslip_booked.serialno END
         END as booked_sn_bn
       ,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (od_rec_header.del_date+729), 'DD.MM.YYYY') as pn_receiving_date
       ,od_rec_detail.orderno as pn_receiving_order
       ,NVL(TO_CHAR(wo_transfer.recno), 'unknown (transfer is removed)') as transfer_qty
       ,(wo_header.closing_date - wo_header.issue_date) as ci_01
       ,(NVL(od_rec_header.del_date, od_orh.del_date) - wo_header.issue_date) as ri_02
       ,(wo_header.closing_date - NVL(od_rec_header.del_date, od_orh.del_date)) as cr_03
       ,(pickslip_header.pickslip_date - NVL(od_rec_header.del_date, od_orh.del_date)) as br_04
       ,CASE WHEN  wo_transfer.absolute_due_date&gt;0 THEN TO_CHAR(wo_header.closing_date-wo_transfer.absolute_due_date) ELSE 'due date is N/A' END as cd_05
FROM
wo_header
LEFT JOIN aircraft ON aircraft.ac_registr = wo_header.ac_registr
LEFT JOIN wo_transfer ON wo_header.event_perfno_i = wo_transfer.event_perfno_i AND wo_transfer.is_last_transfer = 'Y'
LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i = part_request_2.event_key AND part_request_2.event_type='WSL'
LEFT JOIN allocation_link ON allocation_link.source_key = part_request_2.part_requestno_i AND allocation_link.source_type = 'PARTRQST' AND allocation_link.ref_type = 'ORDER_DE'
LEFT JOIN od_detail ON allocation_link.ref_key = od_detail.detailno_i AND od_detail.ext_state NOT IN ('C','B','CA')
LEFT JOIN od_header ON (od_header.orderno_i=od_detail.orderno_i AND od_header.vendor NOT IN ('TECH_V', 'DUZD_TECH')
                                                                                                                     AND od_header.ext_state NOT IN ('CA', 'D', 'IC', 'T', 'C', 'B')
                                                                                                                     AND od_header.order_type NOT IN ('T', 'PU', 'YU', 'LU', 'D', 'W', 'MP', 'Q', 'C', 'R')
                                                                                                                     AND od_header.internal_repair!='Y')
LEFT JOIN od_rec_detail od_ord ON od_detail.detailno_i=od_ord.detailno_i AND od_ord.status&lt;&gt;9
LEFT JOIN od_rec_header od_orh ON od_ord.receivingno=od_orh.receivingno
LEFT JOIN pickslip_detail ON part_request_2.part_requestno_i=pickslip_detail.part_requestno_i AND pickslip_detail.status IN (6,7,9)
LEFT JOIN pickslip_booked ON pickslip_detail.pickslipno=pickslip_booked.pickslipno AND pickslip_detail.recno=pickslip_booked.recno AND pickslip_booked.status IN (6,7,9) AND pickslip_booked.qty_booked&gt;0
LEFT JOIN pickslip_header ON pickslip_booked.pickslipno=pickslip_header.pickslipno AND pickslip_header.status IN (6,7,9)
LEFT JOIN od_rec_detail ON pickslip_booked.recdetailno_i=od_rec_detail.recdetailno_i
LEFT JOIN od_rec_header ON od_rec_detail.receivingno=od_rec_header.receivingno
WHERE (aircraft.ac_typ = '@VAR.v01_ac_typ@' OR '@VAR.v01_ac_typ@'='ALL')
             AND (REGEXP_LIKE(aircraft.ac_registr, REPLACE('@VAR.v02_ac_registr@', ', ', '|')) OR '@VAR.v02_ac_registr@' IS NULL)
             AND (wo_header.issue_date &gt;= '@VAR.v03_wo_issue_from@' OR '@VAR.v03_wo_issue_from@' IS NULL)
             AND (wo_header.issue_date &lt;= '@VAR.v04_wo_issue_to@' OR '@VAR.v04_wo_issue_to@' IS NULL)
             AND (wo_header.closing_date &gt;= '@VAR.v05_wo_closing_from@' OR '@VAR.v05_wo_closing_from@' IS NULL)
             AND (wo_header.closing_date &lt;= '@VAR.v06_wo_closing_to@' OR '@VAR.v06_wo_closing_to@' IS NULL)
             AND (wo_header.state = '@VAR.v07_wo_state@' OR '@VAR.v07_wo_state@'='ALL')
             AND wo_header.mel_code IS NOT NULL
             AND wo_header.mel_code&lt;&gt;'L'
             AND (aircraft.status&lt;&gt;9 AND '@VAR.v08_incl_inactive_ac@'='N' OR '@VAR.v08_incl_inactive_ac@'='Y')
             AND wo_header.type != 'S'
             AND wo_header.state &lt;&gt; 'V'
             AND (part_request_2.status IN (1,2) AND pickslip_booked.status IN (6,7,9) OR part_request_2.status IN (0))
ORDER BY ac_typ, workorder</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
