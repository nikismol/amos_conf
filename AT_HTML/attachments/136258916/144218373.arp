  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="AC" description="" id="AC_REG"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_to"/>
        <ds:columnDescriptor amosType="AT" description="" id="AC_TYPE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="WO_STATE"/>
        <ds:columnDescriptor amosType="ATA" description="" id="ATA"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_from"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="3.AC_Registr" id="AC_REG">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="5.Date_To" id="date_to">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="2.AC_Type" id="AC_TYPE">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>B737</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="4.WO_State" id="WO_STATE">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>O&amp;=&amp;O;C&amp;=&amp;C;ALL&amp;=&amp;ALL;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="1.ATA" id="ATA">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>44</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="5.Date_From" id="date_from">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WO_LIST" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT rownum" id="rownum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT wo_header.event_perfno_i AS event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;                    LISTAGG (TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (wo_text_description.created_date+729) 'DD.MM.YYYY')||CASE WHEN wo_text_description.text IS NOT NULL THEN ': '||TO_CHAR(wo_text_description.text)||'.' ELSE '' ENDCHR(10)||CHR(10))&#10;                                      WITHIN GROUP (ORDER BY workstep_link.sequenceno) as step_text" id="step_text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_REG@">
          <ds:object>@VAR.AC_REG@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_TYPE@">
          <ds:object>@VAR.AC_TYPE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ATA@">
          <ds:object>@VAR.ATA@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_STATE@">
          <ds:object>@VAR.WO_STATE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT     DISTINCT
                    rownum
	     ,wo_header.event_perfno_i AS event_perfno_i
                    ,LISTAGG (TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_text_description.created_date+729), 'DD.MM.YYYY')||CASE WHEN wo_text_description.text IS NOT NULL THEN ': '||TO_CHAR(wo_text_description.text)||'.' ELSE '' END, CHR(10)||CHR(10))
                                      WITHIN GROUP (ORDER BY workstep_link.sequenceno) as step_text
             FROM
                    wo_header
             LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
             LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
             LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
             LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
             LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i=wo_text_action.workstep_linkno_i
             WHERE
		(REGEXP_LIKE( wo_header.ac_registr, REPLACE('@VAR.AC_REG@', ', ', '|')) OR '@VAR.AC_REG@' IS NULL)
		AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE( '@VAR.AC_TYPE@', ', ', '|')) OR '@VAR.AC_TYPE@' IS NULL)
		AND (REGEXP_LIKE( wo_header.ATA_CHAPTER, REPLACE( '@VAR.ATA@', ', ', '|')) OR '@VAR.ATA@' IS NULL)
		AND 
		(
			(wo_header.state = 'O' AND '@VAR.WO_STATE@' = 'O') OR
			(wo_header.state = 'C' AND '@VAR.WO_STATE@' = 'C') OR
			((wo_header.state = 'O' OR wo_header.state = 'C') AND '@VAR.WO_STATE@' = 'ALL')
		)
		AND (wo_header.issue_date &gt;= '@VAR.date_from@' OR '@VAR.date_from@' IS NULL)
		AND (wo_header.issue_date &lt;= '@VAR.date_to@' OR '@VAR.date_to@' IS NULL)
		AND wo_header.type IN ('M', 'C', 'P')
                    AND (
                               wo_header.ata_chapter LIKE ('44%') AND aircraft.ac_typ = 'B737'
          		AND (
					REGEXP_LIKE (wo_text_description.text, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
					OR
					REGEXP_LIKE (wo_text_description.text_html, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
					OR
					REGEXP_LIKE (wo_text_description.header, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
					OR 
					REGEXP_LIKE (wo_text_action.text, '(\sIFE|WIFI|WI-FI|WI FI|MOVIE|MOVIES|MUSIC|VIDEO)','i')
			       )
		)
	GROUP BY rownum, wo_header.event_perfno_i
	ORDER BY rownum</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WO_LINKS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="LISTAGG ( dbl.ref_type||' '||dbl.descriptionCHR(10)) WITHIN GROUP (ORDER BY dbl.ref_type) as ref" id="ref"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@WO_LIST.event_perfno_i@">
          <ds:object>@WO_LIST.event_perfno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
      LISTAGG ( dbl.ref_type||' '||dbl.description, CHR(10)) WITHIN GROUP (ORDER BY dbl.ref_type) as ref  
FROM (
             SELECT
                    workstep_link.event_perfno_i,
                    db_link.description,
                    db_link.ref_type
             FROM workstep_link
             JOIN db_link ON TO_CHAR(workstep_link.descno_i) = TO_CHAR(db_link.source_pk) AND db_link.source_type='WS' AND workstep_link.event_perfno_i='@WO_LIST.event_perfno_i@'
                  
             UNION

             SELECT
                    wo_header.event_perfno_i,
                    db_link.description,
                    db_link.ref_type
             FROM wo_header
             JOIN db_link ON TO_CHAR(wo_header.event_perfno_i) = TO_CHAR(db_link.source_pk) AND db_link.source_type='WO' AND wo_header.event_perfno_i='@WO_LIST.event_perfno_i@'
             ) dbl
GROUP BY dbl.event_perfno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WO_PARTS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="LISTAGG (CASE WHEN LENGTH(part.description) + LENGTH(part_request_2.partno) &lt;= 48&#10;                                                           THEN part.description||' '||part_request_2.partno||' - '||TO_NUMBER(part_request_2.qty)||'ea'&#10;                                                           ELSE SUBSTR(part.description 1 42)||'...'||' '||part_request_2.partno||' - '||TO_NUMBER(part_request_2.qty)||'ea'&#10;                                                           ENDCHR(10)&#10;                                                ) WITHIN GROUP (ORDER BY part_request_2.part_requestno_i) as pn" id="pn"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@WO_LIST.event_perfno_i@">
          <ds:object>@WO_LIST.event_perfno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
                                LISTAGG (CASE WHEN LENGTH(part.description) + LENGTH(part_request_2.partno) &lt;= 48
                                                           THEN part.description||' '||part_request_2.partno||' - '||TO_NUMBER(part_request_2.qty)||'ea'
                                                           ELSE SUBSTR(part.description, 1, 42)||'...'||' '||part_request_2.partno||' - '||TO_NUMBER(part_request_2.qty)||'ea'
                                                           END, CHR(10)
                                                ) WITHIN GROUP (ORDER BY part_request_2.part_requestno_i) as pn
                   FROM wo_header
                   JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr AND aircraft.ac_typ IN ('A32S', 'A330', 'B737','B777')
                   JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i and wo_header.state='O' AND wo_header.type NOT IN ('S', 'T', 'PD')
                   JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key
                   LEFT JOIN part ON part_request_2.partno=part.partno
                   WHERE part_request_2.event_type = 'WSL'
                   AND wo_header.event_perfno_i = '@WO_LIST.event_perfno_i@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WO_INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE   WHEN wo_header.type = 'C' THEN 'Cabin'&#10;                WHEN wo_header.type = 'P' THEN 'Pirep' &#10;                WHEN wo_header.type = 'M' THEN 'Maintenance'&#10;                ELSE ' ' END AS wo_type" id="wo_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN wo_header.mel_code IS NULL &#10;                AND wo_header.hil = 'Y'&#10;                AND wo_opus.free_text IS NOT NULL THEN 'Y' ELSE ' ' END AS dd" id="dd"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.issue_sign" id="wo_header.issue_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + ( wo_header.issue_date+729)'dd.mm.yyyy') as issue_date" id="issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + ( wo_header.closing_date+729)'dd.mm.yyyy') as closing_date" id="closing_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ata_chapter" id="wo_header.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.mel_code AS mel_cat" id="mel_cat"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header_more.mel_chapter AS mel_chap" id="mel_chap"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.state" id="wo_header.state"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@WO_LIST.event_perfno_i@">
          <ds:object>@WO_LIST.event_perfno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
         wo_header.ac_registr
        ,aircraft.ac_typ
        ,CASE  WHEN wo_header.type = 'C' THEN 'Cabin'
                WHEN wo_header.type = 'P' THEN 'Pirep' 
                WHEN wo_header.type = 'M' THEN 'Maintenance'
                ELSE ' ' END AS wo_type
        ,CASE WHEN wo_header.mel_code IS NULL 
                AND wo_header.hil = 'Y'
                AND wo_opus.free_text IS NOT NULL THEN 'Y' ELSE ' ' END AS dd 
        ,wo_header.issue_sign
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.issue_date+729),'dd.mm.yyyy') as issue_date 
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.closing_date+729),'dd.mm.yyyy') as closing_date
        ,wo_header.ata_chapter
        ,wo_header.mel_code AS mel_cat
        ,wo_header_more.mel_chapter AS mel_chap
        ,wo_header.state
FROM wo_header
LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN wo_opus ON wo_header.event_perfno_i = wo_opus.event_perfno_i
WHERE wo_header.event_perfno_i = '@WO_LIST.event_perfno_i@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
