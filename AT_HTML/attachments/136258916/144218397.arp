  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_DISMANTLED_ENG" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="eng.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN rotables.partno='1887M10G05' THEN 'ENGINE A32S'&#10;            WHEN rotables.partno='1887M10G06' THEN 'ENGINE A32S'&#10;            WHEN rotables.partno='1887M10G07' THEN 'ENGINE A32S'&#10;            WHEN rotables.partno='3800454-6' THEN 'APU A330'&#10;            WHEN rotables.partno='3800550-1' THEN 'APU B777'&#10;            WHEN rotables.partno='3800702-1' THEN 'APU B737'&#10;            WHEN rotables.partno='3800708-1' THEN 'APU A32S'&#10;            WHEN rotables.partno='CFM56-7B26EG05' THEN 'ENGINE B737'&#10;            WHEN rotables.partno='FK30858' THEN 'ENGINE A330'&#10;            WHEN rotables.partno='GE90-115B' THEN 'ENGINE B777'&#10;            WHEN rotables.partno='SAM146-1S17' THEN 'ENGINE RRJ'&#10;            WHEN rotables.partno='WE3800770-3' THEN 'APU RRJ'&#10;            ELSE ''&#10;       END as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cond.description as condition" id="condition"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.station as station" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.store as store" id="store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location.location as location" id="location"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AC_TYP.ac_typ@">
          <ds:object>@AC_TYP.ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT eng.partno as partno,
       eng.serialno as serialno,
       eng.ac_typ as ac_typ,
       eng.description as description,
       eng.condition as condition,
       eng.station as station,
       eng.store as store,
       eng.location as location
FROM (
      SELECT rotables.partno as partno,
             rotables.serialno as serialno,
             CASE WHEN rotables.partno='1887M10G05' THEN 'A32S'
                  WHEN rotables.partno='1887M10G06' THEN 'A32S'
                  WHEN rotables.partno='1887M10G07' THEN 'A32S'
                  WHEN rotables.partno='3800454-6' THEN 'A330'
				  WHEN rotables.partno='TRENT-XWB-84' THEN 'A350'
                  WHEN rotables.partno='3800550-1' THEN 'B777'
                  WHEN rotables.partno='3800702-1' THEN 'B737'
                  WHEN rotables.partno='3800708-1' THEN 'A32S'
                  WHEN rotables.partno='CFM56-7B26EG05' THEN 'B737'
                  WHEN rotables.partno='FK30858' THEN 'A330'
                  WHEN rotables.partno='GE90-115B' THEN 'B777'
                  WHEN rotables.partno='SAM146-1S17' THEN 'RRJ'
                  WHEN rotables.partno='WE3800770-3' THEN 'RRJ'
                  ELSE ''
             END as ac_typ,
             CASE WHEN rotables.partno='1887M10G05' THEN 'ENGINE'
                  WHEN rotables.partno='1887M10G06' THEN 'ENGINE'
                  WHEN rotables.partno='1887M10G07' THEN 'ENGINE'
                  WHEN rotables.partno='3800454-6' THEN 'APU'
                  WHEN rotables.partno='3800550-1' THEN 'APU'
                  WHEN rotables.partno='3800702-1' THEN 'APU'
                  WHEN rotables.partno='3800708-1' THEN 'APU'
                  WHEN rotables.partno='CFM56-7B26EG05' THEN 'ENGINE'
                  WHEN rotables.partno='FK30858' THEN 'ENGINE'
                  WHEN rotables.partno='GE90-115B' THEN 'ENGINE'
                  WHEN rotables.partno='SAM146-1S17' THEN 'ENGINE'
				  WHEN rotables.partno='TRENT-XWB-84' THEN 'ENGINE'
                  WHEN rotables.partno='WE3800770-3' THEN 'APU'
                  ELSE ''
             END as description,
             cond.description as condition,
             location.station as station,
             location.store as store,
             location.location as location
      FROM rotables
      LEFT JOIN location ON rotables.locationno_i = location.locationno_i
      LEFT JOIN (SELECT condition.condition as condition,
                        condition.description as description
                 FROM condition
                 WHERE condition.status&lt;&gt;9
                ) cond ON rotables.condition=cond.condition
      WHERE
      rotables.partno IN ('1887M10G05',
                          '1887M10G06',
                          '1887M10G07',
                          '3800454-6', 
                          '3800550-1',
                          '3800702-1',
                          '3800708-1',
                          'CFM56-7B26EG05',
                          'FK30858',
                          'GE90-115B',
                          'SAM146-1S17',
                          'WE3800770-3',
						  'TRENT-XWB-84'
                         )
      AND location.location NOT IN ('AIRCRAFT','OUTGOING')
     ) ENG
WHERE ENG.ac_typ='@AC_TYP.ac_typ@'
ORDER BY description DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AC_TYP" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT aircraft.ac_typ as ac_typ" id="ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT aircraft.ac_typ as ac_typ
FROM aircraft
WHERE aircraft.ac_typ IN ('A32S','A330','B737','B777','RRJ','A350')
ORDER BY aircraft.ac_typ</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
