  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="p01_ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="p04_unlinked_pr"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="p02_date_from"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="p03_date_to"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="1. AC Type" id="p01_ac_typ">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>RRJ&amp;=&amp;RRJ;A32S&amp;=&amp;A32S;A330&amp;=&amp;A330;A350&amp;=&amp;A350;B737&amp;=&amp;B737;B777&amp;=&amp;B777;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>RRJ</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="4. Include WO with nolinked Part Request" id="p04_unlinked_pr">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>Y&amp;=&amp;Yes;N&amp;=&amp;No;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>N</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="2. Order Date From:" id="p02_date_from">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="3. Order Date To:" id="p03_date_to">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="173_PR_ORDERED_STATUS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.wokrorder_no" id="wo.wokrorder_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.state as wo_state" id="wo_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.wo_type" id="wo.wo_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.aog_risk as aog_risk" id="aog_risk"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.wo_created_date" id="wo.wo_created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.requested_partno" id="wo.requested_partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.description" id="wo.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.part_request_date" id="wo.part_request_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.wp_start_date" id="wo.wp_start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.wp_end_date" id="wo.wp_end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.due_date" id="wo.due_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.order_number" id="wo.order_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.order_created_date" id="wo.order_created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.order_date" id="wo.order_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.od_detail_ext_state as odd_state" id="odd_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.received_date as receiving_date" id="receiving_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.received_partno as received_partno" id="received_partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.aircraft" id="wo.aircraft"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.delta_preq_odcreated" id="wo.delta_preq_odcreated"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p01_ac_typ@">
          <ds:object>@VAR.p01_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p02_date_from@">
          <ds:object>@VAR.p02_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p03_date_to@">
          <ds:object>@VAR.p03_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p04_unlinked_pr@">
          <ds:object>@VAR.p04_unlinked_pr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
       wo.wokrorder_no,
       wo.state as wo_state,
       wo.wo_type,
       wo.aog_risk as aog_risk,
       wo.wo_created_date,
       wo.requested_partno,
       wo.description,
       wo.part_request_date,
       wo.wp_start_date,
       wo.wp_end_date,
       wo.due_date,
       wo.order_number,
       wo.order_created_date,
       wo.order_date,
       wo.od_detail_ext_state as odd_state,
       wo.received_date as receiving_date,
       wo.received_partno as received_partno,
       wo.aircraft,
       wo.delta_preq_odcreated
FROM (
SELECT 
       wo_header.event_perfno_i as wokrorder_no,
       decode(wo_header.state, 'O', 'Open', 'C', 'Closed', 'V', 'Inactive', wo_header.state) as state,
       CASE WHEN wo_header.type IN ('C', 'M', 'P') THEN 'Unsched'
                 WHEN wo_header.type IN ('S') THEN 'Sched'
                 ELSE '' END as wo_type,
       DECODE(wo_header_crx.aog_risk, 'Y', 'Y', '') as aog_risk, 
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + wo_header.created_date + 729, 'DD.MM.YYYY') as wo_created_date,
       part_request_2.partno as requested_partno,
       part.description as description,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + part_request_2.created_date + 729, 'DD.MM.YYYY') as part_request_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wp_header.start_date + 729), 'DD.MM.YYYY') as wp_start_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wp_header.end_date + 729), 'DD.MM.YYYY') as wp_end_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + wo_transfer.absolute_due_date + 729, 'DD.MM.YYYY') as due_date,
       od_header.orderno as order_number,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_header.created_date + 729, 'DD.MM.YYYY') as order_created_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_header.orderdate + 729, 'DD.MM.YYYY') as order_date,
       DECODE(od_detail.ext_state,
                        'IC', 'INCOMPLETE',
                        'O', 'OPEN',
                        'PR', 'PARTLY RECEIVED',
                        'PB', 'PARTLY BOOKED',
                        'B', 'BOOKED',
                        'R', 'RECEIVED',
                        'C', 'CLOSED',
                        'CA', 'CANCELLED',
                        'BO', 'BOOKED / OPEN',
                        'T', 'TEMPORARY',
                        'D', 'DRAFT',
                        'PC', 'PARTLY CLOSED',
                        'UK', 'UNKNOWN',
                        od_detail.ext_state) as od_detail_ext_state,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_rec_header.del_date + 729, 'DD.MM.YYYY') as received_date,
       od_rec_detail.partno as received_partno,
       wo_header.ac_registr as aircraft,
       MIN (od_header.orderno_i) OVER (PARTITION BY part_request_2.part_requestno_i) as min_orderno_i,
       od_header.orderno_i,
       od_header.created_date - part_request_2.created_date as delta_preq_odcreated
FROM wo_header
LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i = part_request_2.event_key AND part_request_2.event_type='WSL'
LEFT JOIN allocation_link ON allocation_link.source_key = part_request_2.part_requestno_i
LEFT JOIN od_detail ON allocation_link.ref_key = od_detail.detailno_i 
LEFT JOIN od_header ON od_header.orderno_i = od_detail.orderno_i
LEFT JOIN od_rec_detail ON od_rec_detail.detailno_i = od_detail.detailno_i AND od_rec_detail.status &lt;&gt; 9 AND od_rec_detail.recno &lt;&gt; -1
LEFT JOIN od_rec_header ON od_rec_detail.receivingno = od_rec_header.receivingno
LEFT JOIN wp_assignment ON wo_header.event_perfno_i=wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i=wp_header.wpno_i
LEFT JOIN wo_transfer ON wo_header.event_perfno_i=wo_transfer.event_perfno_i and is_last_transfer='Y' and transfer_type in ('T', 'E') 
LEFT JOIN part ON part_request_2.partno=part.partno
LEFT JOIN wo_header_crx ON wo_header_crx.event_perfno_i = wo_header.event_perfno_i 
WHERE
aircraft.ac_typ='@VAR.p01_ac_typ@'
AND od_header.vendor NOT IN ('TECH_V', 'DUZD_TECH')
AND od_header.ext_state NOT IN ('CA', 'D', 'IC', 'T', 'C', 'B')
AND od_header.order_type NOT IN ('T', 'PU', 'YU', 'LU', 'D', 'W', 'MP', 'Q', 'C', 'R')
AND od_header.internal_repair!='Y'
AND wo_header.created_date&gt;='@VAR.p02_date_from@'
AND wo_header.created_date&lt;='@VAR.p03_date_to@'
AND wo_header.type NOT IN ('T', 'PD')
AND wo_header.state NOT IN ('V')
AND od_detail.ext_state NOT IN ('C','B','CA')
AND allocation_link.source_type = 'PARTRQST'
AND allocation_link.ref_type = 'ORDER_DE'
) wo
WHERE wo.orderno_i=wo.min_orderno_i

UNION ALL

SELECT 
       wo.wokrorder_no,
       wo.state as wo_state,
       wo.wo_type,
       wo.aog_risk,
       wo.wo_created_date,
       wo.requested_partno,
       wo.description,
       wo.part_request_date,
       wo.wp_start_date,
       wo.wp_end_date,
       wo.due_date,
       wo.order_number,
       wo.order_created_date,
       wo.order_date,
       wo.od_detail_ext_state as odd_state,
       wo.received_date as receiving_date,
       wo.received_partno as received_partno,
       wo.aircraft,
       wo.delta_preq_odcreated
FROM (
SELECT DISTINCT
       wo_header.event_perfno_i as wokrorder_no,
       decode(wo_header.state, 'O', 'Open', 'C', 'Closed', 'V', 'Inactive', wo_header.state) as state,
       CASE WHEN wo_header.type IN ('C', 'M', 'P') THEN 'Unsched'
                 WHEN wo_header.type IN ('S') THEN 'Sched'
                 ELSE '' END as wo_type,
       DECODE(wo_header_crx.aog_risk, 'Y', 'Y', '') as aog_risk, 
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + wo_header.created_date + 729, 'DD.MM.YYYY') as wo_created_date,
       part_request_2.partno as requested_partno,
       part.description as description,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + part_request_2.created_date + 729, 'DD.MM.YYYY') as part_request_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wp_header.start_date + 729), 'DD.MM.YYYY') as wp_start_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wp_header.end_date + 729), 'DD.MM.YYYY') as wp_end_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + wo_transfer.absolute_due_date + 729, 'DD.MM.YYYY') as due_date,
       od_header.orderno as order_number,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_header.created_date + 729, 'DD.MM.YYYY') as order_created_date,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_header.orderdate + 729, 'DD.MM.YYYY') as order_date,
       DECODE(od_detail.ext_state,
                        'IC', 'INCOMPLETE',
                        'O', 'OPEN',
                        'PR', 'PARTLY RECEIVED',
                        'PB', 'PARTLY BOOKED',
                        'B', 'BOOKED',
                        'R', 'RECEIVED',
                        'C', 'CLOSED',
                        'CA', 'CANCELLED',
                        'BO', 'BOOKED / OPEN',
                        'T', 'TEMPORARY',
                        'D', 'DRAFT',
                        'PC', 'PARTLY CLOSED',
                        'UK', 'UNKNOWN',
                        od_detail.ext_state) as od_detail_ext_state,
       TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + od_rec_header.del_date + 729, 'DD.MM.YYYY') as received_date,
       od_rec_detail.partno as received_partno,
       wo_header.ac_registr as aircraft,
       MIN (od_header.orderno_i) OVER (PARTITION BY part_request_2.part_requestno_i) as min_orderno_i,
       od_header.orderno_i,
       od_header.created_date - part_request_2.created_date as delta_preq_odcreated
FROM wo_header
LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i = part_request_2.event_key AND part_request_2.event_type='WSL'
LEFT JOIN allocation_link ON allocation_link.source_key = part_request_2.part_requestno_i
LEFT JOIN od_detail ON od_detail.partno = part_request_2.partno
LEFT JOIN od_header ON od_header.orderno_i=od_detail.orderno_i
LEFT JOIN od_rec_detail ON od_rec_detail.detailno_i = od_detail.detailno_i AND od_rec_detail.status &lt;&gt; 9 AND od_rec_detail.recno &lt;&gt; -1
LEFT JOIN od_rec_header ON od_rec_detail.receivingno = od_rec_header.receivingno
LEFT JOIN wp_assignment ON wo_header.event_perfno_i=wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i=wp_header.wpno_i
LEFT JOIN wo_transfer ON wo_header.event_perfno_i=wo_transfer.event_perfno_i and is_last_transfer='Y' and transfer_type in ('T', 'E') 
LEFT JOIN part ON part_request_2.partno=part.partno
LEFT JOIN wo_header_crx ON wo_header_crx.event_perfno_i = wo_header.event_perfno_i 
WHERE
aircraft.ac_typ='@VAR.p01_ac_typ@'
AND od_header.vendor NOT IN ('TECH_V', 'DUZD_TECH')
AND od_header.ext_state NOT IN ('CA', 'D', 'IC', 'T', 'C', 'B')
AND od_header.order_type NOT IN ('T', 'PU', 'YU', 'LU', 'D', 'W', 'MP', 'Q', 'C', 'R')
AND od_header.internal_repair!='Y'
AND wo_header.issue_date&gt;=17168
AND wo_header.issue_date&lt;=17363
AND wo_header.type NOT IN ('T', 'PD')
AND wo_header.state NOT IN ('V')
AND od_detail.ext_state NOT IN ('C','B','CA')
AND allocation_link.source_type IS NULL
AND allocation_link.ref_type IS NULL
AND allocation_link.ref_key IS NULL
AND part_request_2.created_date&gt;=od_header.created_date-10
AND part_request_2.created_date&lt;=od_header.created_date
AND '@VAR.p04_unlinked_pr@'='Y'
) wo
WHERE wo.orderno_i=wo.min_orderno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="173_CONVERT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + @VAR.p02_date_from@ + 729'DD.MM.YYYY') as date_from" id="date_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + @VAR.p03_date_to@ + 729'DD.MM.YYYY') as date_to" id="date_to"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p02_date_from@">
          <ds:object>@VAR.p02_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.p03_date_to@">
          <ds:object>@VAR.p03_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + @VAR.p02_date_from@ + 729, 'DD.MM.YYYY') as date_from,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + @VAR.p03_date_to@ + 729, 'DD.MM.YYYY') as date_to
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
