    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_RRJ_MR_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno as taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="treq_time_requirement.timerequirementno_i as timerequirementno_i" id="timerequirementno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mp_rev.revision_no as mp_revision_no" id="mp_revision_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="type_code" id="type_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="source" id="source"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT(event_perfno_i) as perf_times" id="perf_times"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v04_mpno_i@">
          <ds:object>@v04_mpno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_taskcardno@">
          <ds:object>@VAR.v03_taskcardno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT taskcardno,
             timerequirementno_i,
             mp_revision_no,
             type_code,
             source,
             COUNT(event_perfno_i) as perf_times
FROM (
             SELECT DISTINCT tc.taskcardno,
                          tc.timerequirementno_i,
                          tc.event_perfno_i,
                          tc.closing_date,
                          tc.type_code,
                          tc.source,
                          mp_rev.revision_no as mp_revision_no,
                          TO_NUMBER(mp_rev.activation_date) as mp_activation_date,
                          TO_NUMBER(mp_rev.deactivation_date) as mp_deactivation_date
             FROM AMOSSERVER_PROD.R_218_MAINTENANCE_REPORT tc
             JOIN (
                       SELECT msc_mprev_taskcards.revisionno_i,
                                    MAX (msc_mprev_taskcards.revisionno_i) OVER (PARTITION BY msc_taskcard.taskcardno_i) as max_revisionno_i,
                                    msc_taskcard.taskcardno_i
                       FROM msc_taskcard
                       JOIN msc_taskcard_version ON msc_taskcard.taskcardno_i = msc_taskcard_version.taskcardno_i
                       JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i
                       JOIN msc_mp_revision ON msc_mprev_taskcards.revisionno_i = msc_mp_revision.revisionno_i
                       JOIN msc_mp_issue ON msc_mp_revision.issueno_i = msc_mp_issue.issueno_i AND msc_mp_issue.mpno_i='@v04_mpno_i@'
                      ) tc_mp_rev ON tc_mp_rev.taskcardno_i=tc.taskcardno_i
             JOIN (
                       SELECT m.no,
                                    m.revision_no,
                                    m.issueno_i,
                                    CASE WHEN m.revisionno_i IN (1, 2, 3, 4, 5) THEN 16587 ELSE NVL(m.activation_date, PRIOR m.mutation+1) END as activation_date,
                                    m.revisionno_i,
                                    m.revision_status,
                                    DECODE (m.revision_status, 'i', m.mutation, TRUNC (SYSDATE) - TO_DATE ('31.12.1971', 'dd.mm.yyyy')) as deactivation_date
                       FROM (
                                    SELECT row_number () OVER (PARTITION BY mpr.issueno_i ORDER BY mpr.revisionno_i) as no,
                                                 mpr.revision_no,
                                                 mpr.issueno_i,
                                                 mpr.activation_date,
                                                 mpr.revisionno_i,
                                                 mpr.revision_status,
                                                 mpr.mutation
                                    FROM msc_mp_revision mpr
                                    JOIN msc_mp_issue ON mpr.issueno_i=msc_mp_issue.issueno_i AND msc_mp_issue.mpno_i='@v04_mpno_i@'
                                    WHERE 1=1
                                                  AND mpr.revision_status&lt;&gt;'t'
                                   ) m
                       START WITH m.no=1
                       CONNECT BY  PRIOR m.no=m.no - 1
                      ) mp_rev ON tc_mp_rev.revisionno_i=mp_rev.revisionno_i 
                                             AND (tc.closing_date BETWEEN mp_rev.activation_date AND mp_rev.deactivation_date OR tc_mp_rev.revisionno_i=tc_mp_rev.max_revisionno_i AND tc.closing_date&gt;mp_rev.deactivation_date)
             WHERE 1=1 
                           AND '@v04_mpno_i@'=tc.mpno_i
                           AND tc.closing_date BETWEEN DECODE(@VAR.v01_date_from@, -1, ADD_MONTHS(TRUNC(SYSDATE, 'Q'), -3) - to_date('31.12.1971', 'dd.mm.yyyy'), @VAR.v01_date_from@) AND DECODE(@VAR.v02_date_to@, -1, TRUNC(SYSDATE, 'Q') - 1 -  to_date('31.12.1971', 'dd.mm.yyyy'), @VAR.v02_date_to@)
                           AND (tc.taskcardno_i='@VAR.v03_taskcardno@' OR '@VAR.v03_taskcardno@' IS NULL)
            )
GROUP BY taskcardno, timerequirementno_i, mp_revision_no, type_code, source
ORDER BY taskcardno, mp_revision_no, timerequirementno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_RRJ_MR_Threshold" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="treq_time_requirement.timerequirementno_i" id="treq_time_requirement.timerequirementno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG ('T:'&#10;                              ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)&#10;                                            WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + treq_interval.due_at 'DD.MM.YYYY')&#10;                                            ELSE TO_CHAR(treq_interval.amount_interval)&#10;                                   END&#10;                              ||' '&#10;                              ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'&#10;                                            WHEN treq_interval.counter_defno_i=2 THEN 'FC'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'&#10;                                            WHEN treq_interval.counter_defno_i=101 THEN 'AH'&#10;                                            WHEN treq_interval.counter_defno_i=102 THEN 'AC'&#10;                                            WHEN treq_interval.counter_defno_i=103 THEN 'SD'&#10;                                            WHEN treq_interval.counter_defno_i=104 THEN 'ID'&#10;                                            ELSE ''&#10;                                  ENDCHR(10)&#10;                             ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as threshold" id="threshold"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_RRJ_MR_MAIN.timerequirementno_i@">
          <ds:object>@AFL_RRJ_MR_MAIN.timerequirementno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT treq_time_requirement.timerequirementno_i,
             'Порог:'||
             LISTAGG (
                              CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)
                                            WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + treq_interval.due_at, 'DD.MM.YYYY')
                                            ELSE TO_CHAR(treq_interval.amount_interval)
                                   END
                              ||' '
                              ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                            WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                            WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                            WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                            WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                            WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                            ELSE ''
                                  END, ', '
                             ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as threshold
FROM treq_time_requirement
JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i=treq_dimension_group.interval_groupno_i
JOIN treq_interval ON treq_interval.dimension_groupno_i=treq_dimension_group.dimension_groupno_i AND treq_interval.dimension_type IN ('W', 'B')
JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
WHERE 1=1
              AND treq_time_requirement.timerequirementno_i='@AFL_RRJ_MR_MAIN.timerequirementno_i@'
              AND treq_time_requirement.event_type = 'REQH'
              AND treq_time_requirement.type = 'OP'
GROUP BY treq_time_requirement.timerequirementno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_RRJ_MR_Interval" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description/>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="treq_time_requirement.timerequirementno_i" id="treq_time_requirement.timerequirementno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG ('I:'&#10;                              ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)&#10;                                            WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + treq_interval.due_at 'DD.MM.YYYY')&#10;                                            ELSE TO_CHAR(treq_interval.amount_interval)&#10;                                   END&#10;                              ||' '&#10;                              ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'&#10;                                            WHEN treq_interval.counter_defno_i=2 THEN 'FC'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'&#10;                                            WHEN treq_interval.counter_defno_i=101 THEN 'AH'&#10;                                            WHEN treq_interval.counter_defno_i=102 THEN 'AC'&#10;                                            WHEN treq_interval.counter_defno_i=103 THEN 'SD'&#10;                                            WHEN treq_interval.counter_defno_i=104 THEN 'ID'&#10;                                            ELSE ''&#10;                                  ENDCHR(10)&#10;                             ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as interval" id="interval"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_RRJ_MR_MAIN.timerequirementno_i@">
          <ds:object>@AFL_RRJ_MR_MAIN.timerequirementno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT treq_time_requirement.timerequirementno_i,
             'Интервал:'||
             LISTAGG (
                              CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)
                                            WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + treq_interval.due_at, 'DD.MM.YYYY')
                                            ELSE TO_CHAR(treq_interval.amount_interval)
                                   END
                              ||' '
                              ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                            WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                            WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                            WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                            WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                            WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                            ELSE ''
                                  END, ', '
                             ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as interval
FROM treq_time_requirement
JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i=treq_dimension_group.interval_groupno_i
JOIN treq_interval ON treq_interval.dimension_groupno_i=treq_dimension_group.dimension_groupno_i AND treq_interval.dimension_type IN ('I')
JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
WHERE 1=1
              AND treq_time_requirement.timerequirementno_i='@AFL_RRJ_MR_MAIN.timerequirementno_i@'
              AND treq_time_requirement.event_type = 'REQH'
              AND treq_time_requirement.type = 'OP'
GROUP BY treq_time_requirement.timerequirementno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_RRJ_MR_Findings" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="timerequirementno_i" id="timerequirementno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mp_revision_no" id="mp_revision_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT(finding_event_perfno_i) as perf_times" id="perf_times"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v04_mpno_i@">
          <ds:object>@v04_mpno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_taskcardno@">
          <ds:object>@VAR.v03_taskcardno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_RRJ_MR_MAIN.taskcardno@">
          <ds:object>@AFL_RRJ_MR_MAIN.taskcardno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_RRJ_MR_MAIN.timerequirementno_i@">
          <ds:object>@AFL_RRJ_MR_MAIN.timerequirementno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_RRJ_MR_MAIN.mp_revision_no@">
          <ds:object>@AFL_RRJ_MR_MAIN.mp_revision_no@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT taskcardno,
             timerequirementno_i,
             mp_revision_no,
             COUNT(finding_event_perfno_i) as perf_times
FROM (
             SELECT DISTINCT tc.taskcardno,
                          tc.timerequirementno_i,
                          tc.finding_event_perfno_i,
                          tc.closing_date,
                          mp_rev.revision_no as mp_revision_no,
                          TO_NUMBER(mp_rev.activation_date) as mp_activation_date,
                          TO_NUMBER(mp_rev.deactivation_date) as mp_deactivation_date
             FROM AMOSSERVER_PROD.R_218_MAINTENANCE_REPORT tc
             JOIN (
                       SELECT msc_mprev_taskcards.revisionno_i,
                                    MAX (msc_mprev_taskcards.revisionno_i) OVER (PARTITION BY msc_taskcard.taskcardno_i) as max_revisionno_i,
                                    msc_taskcard.taskcardno_i
                       FROM msc_mprev_taskcards 
                       JOIN msc_taskcard_version ON msc_mprev_taskcards.taskcard_verno_i=msc_taskcard_version.taskcard_verno_i
                       JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i=msc_taskcard.taskcardno_i
                       JOIN msc_mp_revision ON msc_mp_revision.revisionno_i=msc_mprev_taskcards.revisionno_i
                       JOIN msc_mp_issue ON msc_mp_revision.issueno_i=msc_mp_issue.issueno_i AND msc_mp_issue.mpno_i='@v04_mpno_i@'
                      ) tc_mp_rev ON tc_mp_rev.taskcardno_i=tc.taskcardno_i
             JOIN (
                       SELECT m.no,
                                    m.revision_no,
                                    m.issueno_i,
                                    CASE WHEN m.revisionno_i IN (1, 2, 3, 4, 5) THEN 16587 ELSE NVL(m.activation_date, PRIOR m.mutation+1) END as activation_date,
                                    m.revisionno_i,
                                    m.revision_status,
                                    DECODE (m.revision_status, 'i', m.mutation, TRUNC (SYSDATE) - TO_DATE ('31.12.1971', 'dd.mm.yyyy')) as deactivation_date
                       FROM (
                                    SELECT row_number () OVER (PARTITION BY mpr.issueno_i ORDER BY mpr.revisionno_i) as no,
                                                 mpr.revision_no,
                                                 mpr.issueno_i,
                                                 mpr.activation_date,
                                                 mpr.revisionno_i,
                                                 mpr.revision_status,
                                                 mpr.mutation
                                    FROM msc_mp_revision mpr
                                    JOIN msc_mp_issue ON mpr.issueno_i=msc_mp_issue.issueno_i AND msc_mp_issue.mpno_i='@v04_mpno_i@'
                                    WHERE 1=1
                                                  AND mpr.revision_status&lt;&gt;'t'
                                   ) m
                       START WITH m.no=1
                       CONNECT BY  PRIOR m.no=m.no-1
                      ) mp_rev ON tc_mp_rev.revisionno_i=mp_rev.revisionno_i 
                                             AND (tc.closing_date BETWEEN mp_rev.activation_date AND mp_rev.deactivation_date OR tc_mp_rev.revisionno_i=tc_mp_rev.max_revisionno_i AND tc.closing_date&gt;mp_rev.deactivation_date)
             WHERE 1=1 
                           AND '@v04_mpno_i@'=tc.mpno_i
                           AND tc.closing_date BETWEEN DECODE(@VAR.v01_date_from@, -1, ADD_MONTHS(TRUNC(SYSDATE, 'Q'), -3) - to_date('31.12.1971', 'dd.mm.yyyy'), @VAR.v01_date_from@) AND DECODE(@VAR.v02_date_to@, -1, TRUNC(SYSDATE, 'Q') - 1 -  to_date('31.12.1971', 'dd.mm.yyyy'), @VAR.v02_date_to@)
                           AND (tc.taskcardno_i='@VAR.v03_taskcardno@' OR '@VAR.v03_taskcardno@' IS NULL)
            )
WHERE 1=1
              AND taskcardno='@AFL_RRJ_MR_MAIN.taskcardno@'
              AND timerequirementno_i='@AFL_RRJ_MR_MAIN.timerequirementno_i@'
              AND mp_revision_no='@AFL_RRJ_MR_MAIN.mp_revision_no@'
GROUP BY taskcardno, timerequirementno_i, mp_revision_no</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_RRJ_MR_CurrentDateTime" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(SYSDATE'MM.DD.YYYY') as cur_date" id="cur_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(SYSDATE'HH24:MI:SS') as cur_time" id="cur_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
TO_CHAR(SYSDATE, 'DD.MM.YYYY') as cur_date,
TO_CHAR(SYSDATE, 'HH24:MI:SS') as cur_time
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_RRJ_MR_PeriodDateTime" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + @VAR.v01_date_from@'DD.MM.YYYY') as date_from" id="date_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + @VAR.v02_date_to@'DD.MM.YYYY') as date_to" id="date_to"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + DECODE(@VAR.v01_date_from@, -1, ADD_MONTHS(TRUNC(SYSDATE, 'Q'), -3) - to_date('31.12.1971', 'dd.mm.yyyy'), @VAR.v01_date_from@), 'DD.MM.YYYY') as date_from,
TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + DECODE(@VAR.v02_date_to@, -1, TRUNC(SYSDATE, 'Q') - 1 -  to_date('31.12.1971', 'dd.mm.yyyy'), @VAR.v02_date_to@), 'DD.MM.YYYY') as date_to
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
