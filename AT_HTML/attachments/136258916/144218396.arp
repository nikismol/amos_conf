    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_CounterDiff_dates" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (@VAR.st_date@)'DD.MM.YYYY') as st_date" id="st_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;SELECT TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (@VAR.end_date@)'DD.MM.YYYY') as end_date" id="end_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.st_date@">
          <ds:object>@VAR.st_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end_date@">
          <ds:object>@VAR.end_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + ('@VAR.st_date@'), 'DD.MM.YYYY') as st_date,
TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + ('@VAR.end_date@'), 'DD.MM.YYYY') as end_date
FROM dual</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_GetRotableByPsn" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="psn" id="psn"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.rotable_psn@">
          <ds:object>@VAR.rotable_psn@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT serialno, partno, psn FROM rotables WHERE psn = '@VAR.rotable_psn@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
