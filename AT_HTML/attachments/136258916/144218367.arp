  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ as AC_TYPE" id="AC_TYPE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event" id="event"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event_display" id="event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wORkORderno_display" id="wORkORderno_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpno_i" id="wpno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (expected_date+729)'DD.MM.YYYY') expected_date" id="expected_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT	ac_typ as AC_TYPE
		,ac_registr
		,event
		,event_display
		,wORkORderno_display
		,wpno_i
		,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (expected_date+729), 'DD.MM.YYYY') expected_date 
FROM forecast where 
(interval_dimension = 'D' AND togo &lt; 3 OR 
interval_dimension = 'H' AND togo &lt; 20 OR 
interval_dimension = 'C' AND togo &lt; 10) 
AND ( workorderno_display is null OR (workorderno_display is not null AND wpno_i IS NOT NULL AND expected_date&gt;date_planned) )
AND (requirement = 'VSB' OR requirement = 'EAD' OR requirement = 'AD' OR  requirement = 'SB' OR requirement = 'AOT'  OR requirement = 'АД'  OR requirement = 'ЛИБ')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
