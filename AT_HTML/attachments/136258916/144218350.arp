  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="OH" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="psn" id="psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN REGEXP_LIKE(partno '^[0-9]+$') AND REGEXP_LIKE(partno'^0') THEN chr(39)||partno ELSE partno END as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN REGEXP_LIKE(serialno '^[0-9]+$') AND REGEXP_LIKE(serialno'^0') THEN chr(39)||serialno ELSE serialno END as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_type" id="ac_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_reg" id="ac_reg"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="special" id="special"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="engine_side" id="engine_side"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cur_ac_registr" id="cur_ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cur_ac_position" id="cur_ac_position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_ac_registr" id="last_ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_ac_position" id="last_ac_position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cur_condition" id="cur_condition"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_removal_date" id="last_removal_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_oh_receving_date" id="last_oh_receving_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_oh_certificate_date" id="last_oh_certificate_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_oh_removal" id="last_oh_removal"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_installation_date" id="last_installation_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="next_oh_removal_date" id="next_oh_removal_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ind_llp" id="ind_llp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="del_ac_reg" id="del_ac_reg"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="del_ac_model" id="del_ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="del_engine_side" id="del_engine_side"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
psn,
CASE WHEN REGEXP_LIKE(partno, '^[0-9]+$') AND REGEXP_LIKE(partno, '^0') THEN chr(39)||partno ELSE partno END as partno,
CASE WHEN REGEXP_LIKE(serialno, '^[0-9]+$') AND REGEXP_LIKE(serialno, '^0') THEN chr(39)||serialno ELSE serialno END as serialno,
ac_type,
ac_reg,
special,
engine_side,
cur_ac_registr,
cur_ac_position,
last_ac_registr,
last_ac_position,
cur_condition,
last_removal_date,
last_oh_receving_date,
last_oh_certificate_date,
last_oh_removal,
last_installation_date,
next_oh_removal_date,
