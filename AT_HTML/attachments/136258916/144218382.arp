  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="DATE" description="" id="date"/>
        <ds:columnDescriptor amosType="TSEC" description="" id="tc_sec"/>
        <ds:columnDescriptor amosType="BOOL" description="" id="panels"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="mp_rev_status"/>
        <ds:columnDescriptor amosType="CHTI" description="" id="check_intno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="v08_format"/>
        <ds:columnDescriptor amosType="TC" description="" id="taskcardno_i"/>
        <ds:columnDescriptor amosType="MPA" description="" id="MP_NO"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="01. Date" id="date">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="04. Section" id="tc_sec">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>3, 4</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="05. Show Panels" id="panels">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="02. MP Revision Status" id="mp_rev_status">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>t</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>t&amp;=&amp;Tentative;b&amp;=&amp;Temporary;a&amp;=&amp;Active;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="07. Check (OPTIONAL, USED BY SPTO)" id="check_intno_i">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="08. Format Adapted to" id="v08_format">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>XLSX</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>XLSX&amp;=&amp;EXCEL;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="06. Taskcard" id="taskcardno_i">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="03. Maintenance Program" id="MP_NO">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="TC" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>TC</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i as taskcard_verno_i" id="taskcard_verno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno as tc_no" id="tc_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.title as tc_title" id="tc_title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.revision_no as rev_no" id="rev_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wsl_zone.zone as zone" id="zone"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tc_descr.description AS tc_descr" id="tc_descr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tc_descr_html.description_html AS tc_html" id="tc_html"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tc_remarks.remarks as remarks" id="remarks"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN '@VAR.panels@'='Y' THEN CASE WHEN tc_pnl.panels IS NOT NULL THEN 'Access panels:'||tc_pnl.panels ELSE '' END&#10;&#9;&#9; ELSE ''&#10;&#9;END as panels" id="panels"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN tc_spec.skill IS NOT NULL THEN 'Skills:'||tc_spec.skill ELSE '' END as skill" id="skill"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tc_src.source as source" id="source"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_type_code.typecode as code" id="code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN (tc_status.TC_T='S' AND tc_status.TC_R&gt;='1' AND (tc_rem.status&lt;&gt;0 OR tc_rem.status IS NULL)) THEN 'R'||' '&#10;&#9;&#9; WHEN (tc_status.TC_T='S' AND tc_status.TC_R='0' AND (tc_rem.status&lt;&gt;0 OR tc_rem.status IS NULL)) THEN 'N'||' '&#10;&#9; &#9; WHEN (tc_rem.status='0' OR tc_rem.status IS NOT NULL) THEN 'D'||' '&#10;&#9; &#9; ELSE ' ' END as status" id="status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ata_chapter.description as ata_desc" id="ata_desc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN msc_maintenance_program.mpno='RRJ' THEN '' ELSE 'ATA:'||tc_ata.ata END as tc_ata" id="tc_ata"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.panels@">
          <ds:object>@VAR.panels@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.mp_rev_status@">
          <ds:object>@VAR.mp_rev_status@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.MP_NO@">
          <ds:object>@VAR.MP_NO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.check_intno_i@">
          <ds:object>@VAR.check_intno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tc_sec@">
          <ds:object>@VAR.tc_sec@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.taskcardno_i@">
          <ds:object>@VAR.taskcardno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_taskcard_version.taskcard_verno_i as taskcard_verno_i,
             msc_taskcard.taskcardno as tc_no,
             msc_taskcard.title as tc_title,
             msc_taskcard_version.revision_no as rev_no,
             wsl_zone.zone as zone,
tc_descr.description AS tc_descr,
tc_descr_html.description_html AS tc_html,
             tc_remarks.remarks as remarks,
             CASE WHEN '@VAR.panels@'='Y'
                        THEN CASE WHEN tc_pnl.panels IS NOT NULL THEN 'Access panels:'||tc_pnl.panels ELSE '' END
                        ELSE ''
             END as panels,
             CASE WHEN tc_spec.skill IS NOT NULL THEN 'Skills:'||tc_spec.skill ELSE '' END as skill,
             tc_src.source as source,
             msc_type_code.typecode as code,
             CASE WHEN (tc_status.TC_T='S' AND tc_status.TC_R&gt;='1' AND (tc_rem.status&lt;&gt;0 OR tc_rem.status IS NULL)) THEN 'R'||' '
                       WHEN (tc_status.TC_T='S' AND tc_status.TC_R='0' AND (tc_rem.status&lt;&gt;0 OR tc_rem.status IS NULL)) THEN 'N'||' '
                       WHEN (tc_rem.status='0' OR tc_rem.status IS NOT NULL) THEN 'D'||' '
                       ELSE ' ' END as status,
             ata_chapter.description as ata_desc,
             CASE WHEN msc_maintenance_program.mpno='RRJ' THEN '' ELSE 'ATA:'||tc_ata.ata END as tc_ata
FROM msc_taskcard_version
LEFT JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i=msc_taskcard.taskcardno_i
LEFT JOIN msc_maintenance_program ON msc_taskcard.mpno_i=msc_maintenance_program.mpno_i
LEFT JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
LEFT JOIN worktemplate_link ON worktemplate_link.event_key = msc_item.itemno_i 
LEFT JOIN work_template ON worktemplate_link.wtno_i=work_template.wtno_i
LEFT JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i
LEFT JOIN (
                    SELECT zone_code_link.source_pk
                           ,LISTAGG (zone_code_link.zone||'; ', CHR(10)) WITHIN GROUP (ORDER BY zone_code_link.zone) as zone
                    FROM zone_code_link 
                    WHERE zone_code_link.source_type='WO'
                    GROUP BY zone_code_link.source_pk
                   ) wsl_zone ON event_template.event_perfno_i=wsl_zone.source_pk
LEFT JOIN (
                    SELECT msc_taskcard_version.taskcard_verno_i as tcvno_rmk,
                                   DBMS_lob.substr(msc_taskcard_version.internal_remarks,4000,1) as remarks
                    FROM msc_taskcard_version
                   ) tc_remarks ON tc_remarks.tcvno_rmk=msc_taskcard_version.taskcard_verno_i
LEFT JOIN 
        (SELECT 
                    workstep_link.event_perfno_i AS event_perfno_i,
                    TO_CHAR(wo_text_description.text) AS description
         FROM workstep_link
         LEFT JOIN wo_text_description ON workstep_link.descno_i = wo_text_description.descno_i AND WORKSTEP_LINK.SEQUENCENO = 1
         ) tc_descr ON  event_template.event_perfno_i = tc_descr.event_perfno_i
LEFT JOIN 
        (SELECT 
                    workstep_link.event_perfno_i AS event_perfno_i,
                    TO_CHAR(wo_text_description.text_html) AS description_html
         FROM workstep_link
         LEFT JOIN wo_text_description ON workstep_link.descno_i = wo_text_description.descno_i AND WORKSTEP_LINK.SEQUENCENO = 1
         ) tc_descr_html ON  event_template.event_perfno_i = tc_descr_html.event_perfno_i
LEFT JOIN (
                   SELECT msc_requirement_panel.taskcard_verno_i as tcvno_pnl,
                                 LISTAGG (msc_requirement_panel.panel_no, '     ') WITHIN GROUP (ORDER BY msc_requirement_panel.panel_no) as panels
                   FROM msc_requirement_panel
                   GROUP BY msc_requirement_panel.taskcard_verno_i
                  ) tc_pnl ON msc_taskcard_version.taskcard_verno_i=tc_pnl.tcvno_pnl
LEFT JOIN (
                    SELECT msc_task_special.taskcard_verno_i as tcvno_spec,
                                   LISTAGG(
                                                    msc_special.special
                                                    ||'     '
                                                    ||msc_special.description, CHR(10)
                                                   ) WITHIN GROUP (ORDER BY msc_special.special) as skill
                    FROM msc_task_special
                    LEFT JOIN msc_special ON msc_task_special.specialno_i=msc_special.specialno_i
                    GROUP BY msc_task_special.taskcard_verno_i
                   ) tc_spec ON msc_taskcard_version.taskcard_verno_i=tc_spec.tcvno_spec
LEFT JOIN (
                    SELECT msc_taskcard_version.taskcard_verno_i as tcvno_src,
                                  LISTAGG (db_link.description||'; ', CHR(10)) WITHIN GROUP (ORDER BY db_link.description) as source
                    FROM msc_taskcard_version
                    LEFT JOIN db_link ON db_link.source_pk=msc_taskcard_version.taskcard_verno_i  
                    WHERE db_link.source_type='TCLS'
                    GROUP BY msc_taskcard_version.taskcard_verno_i
                   ) tc_src ON msc_taskcard_version.taskcard_verno_i=tc_src.tcvno_src
LEFT JOIN msc_task_type ON msc_taskcard_version.taskcard_verno_i=msc_task_type.taskcard_verno_i
LEFT JOIN msc_type_code ON msc_task_type.typecodeno_i=msc_type_code.typecodeno_i
LEFT JOIN (
                    SELECT msc_taskcard_version.taskcard_verno_i as tc_vnoi,
                                   msc_mp_revision_remtc.status as status,
                                   msc_mp_revision.revision_status as revision_status
                    FROM msc_taskcard_version
                    LEFT JOIN msc_mp_revision_remtc ON msc_taskcard_version.taskcard_verno_i=msc_mp_revision_remtc.taskcard_verno_i
                    LEFT JOIN msc_mp_revision ON msc_mp_revision.revisionno_i=msc_mp_revision_remtc.revisionno_i
                    WHERE msc_mp_revision_remtc.revisionno_i = (
                                                                                                              SELECT msc_mp_revision.revisionno_i
                                                                                                              FROM msc_mp_revision
                                                                                                              LEFT JOIN msc_mp_issue ON msc_mp_revision.issueno_i=msc_mp_issue.issueno_i
                                                                                                              WHERE msc_mp_revision.revision_type='MP'
                                                                                                                             AND msc_mp_revision.revision_status='@VAR.mp_rev_status@'
                                                                                                                             AND msc_mp_issue.mpno_i='@VAR.MP_NO@'
                                                                                                           )
                                   AND msc_taskcard_version.taskcard_status&lt;&gt;'T'  
                   ) tc_rem ON msc_taskcard_version.taskcard_verno_i=tc_rem.tc_vnoi
LEFT JOIN msc_task_section ON msc_taskcard_version.taskcard_verno_i=msc_task_section.taskcard_verno_i
LEFT JOIN msc_section_code ON msc_task_section.sectionno_i=msc_section_code.sectionno_i
LEFT JOIN (
                    SELECT tc.taskcardno,
                                  tc_rev.revision_no as rno,
                                  tc_rev.taskcard_verno_i as tcvrn_i,
                                  tc_rev.taskcard_status,
                                  tc_rev.not_applicable,
                                  tc.tc_type,
                                  (
                                   SELECT COUNT (*) 
                                   FROM msc_taskcard_version 
                                   JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i 
                                   WHERE msc_taskcard_version.taskcardno_i = tc.taskcardno_i 
                                                  AND msc_taskcard_version.taskcard_verno_i &lt;&gt; tc_rev.taskcard_verno_i 
                                                  AND msc_taskcard_version.taskcard_status = 'T' 
                                                  AND msc_taskcard_version.status &lt;&gt; 8
                                  ) as TC_A,
                                  CASE WHEN tc_rev.taskcard_verno_i = (
                                                                                                           SELECT MAX (mpr.taskcard_verno_i) 
                                                                                                           FROM msc_mprev_taskcards mpr 
                                                                                                           JOIN msc_taskcard_version ON mpr.taskcard_verno_i = msc_taskcard_version.taskcard_verno_i 
                                                                                                           WHERE mpr.revisionno_i = mp_tc.revisionno_i 
                                                                                                                          AND msc_taskcard_version.taskcardno_i = tc_rev.taskcardno_i 
                                                                                                                          AND mpr.taskcard_verno_i IN (
                                                                                                                                                                                   SELECT v1.taskcard_verno_i 
                                                                                                                                                                                   FROM msc_taskcard_version v1 
                                                                                                                                                                                   WHERE v1.taskcardno_i = (
                                                                                                                                                                                                                                    SELECT v2.taskcardno_i 
                                                                                                                                                                                                                                    FROM msc_taskcard_version v2 
                                                                                                                                                                                                                                    WHERE v2.taskcard_verno_i = v1.taskcard_verno_i
                                                                                                                                                                                                                                   ) 
                                                                                                                                                                                   AND v1.taskcard_status IN ('A', 'B')
                                                                                                                                                                                  )
                                            ) THEN ' ' ELSE 'S' END as TC_T,
                                   (
                                    SELECT COUNT (*) 
                                    FROM msc_taskcard_version 
                                    JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i 
                                    WHERE msc_taskcard_version.taskcardno_i = tc.taskcardno_i 
                                                   AND msc_taskcard_version.taskcard_verno_i &lt;&gt; tc_rev.taskcard_verno_i 
                                                   AND msc_taskcard_version.taskcard_status = 'A' 
                                                   AND msc_taskcard_version.status &lt;&gt; 8
                                   ) as TC_R
                    FROM msc_mprev_taskcards mp_tc 
                    JOIN msc_taskcard_version tc_rev ON mp_tc.taskcard_verno_i = tc_rev.taskcard_verno_i 
                    JOIN msc_taskcard tc ON tc_rev.taskcardno_i = tc.taskcardno_i 
                    ORDER BY tc.taskcardno, tc_rev.taskcard_verno_i
                   ) tc_status ON tc_status.tcvrn_i=msc_taskcard_version.taskcard_verno_i
LEFT JOIN msc_mprev_taskcards ON msc_mprev_taskcards.taskcard_verno_i=msc_taskcard_version.taskcard_verno_i
LEFT JOIN msc_mp_revision ON msc_mprev_taskcards.revisionno_i=msc_mp_revision.revisionno_i
LEFT JOIN ata_chapter ON msc_taskcard.ata_chapter=ata_chapter.ata_chapter
LEFT JOIN (
                    SELECT SUBSTR (msc_taskcard.ata_chapter, 1, 2) as ata,
                                  msc_taskcard.taskcardno as tc_no
                    FROM msc_taskcard
                    WHERE (REGEXP_LIKE(msc_taskcard.mpno_i, REPLACE('@VAR.MP_NO@', ', ', '|')) OR '@VAR.MP_NO@' IS NULL)
                   ) tc_ata ON msc_taskcard.taskcardno=tc_ata.tc_no
LEFT JOIN (
                    SELECT msc_taskcard_version.taskcard_verno_i as taskcard_verno_i,
                                   check_type_int.internal_check as internal_check,
                                   check_type_int.check_intno_i as check_intno_i
                    FROM msc_taskcard_version 
                    JOIN msc_requirement_tc_link ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri 
                    JOIN requirement_link ON msc_requirement_tc_link.req_linkno_i = requirement_link.source 
                    JOIN msc_requirement_approve_op ON msc_requirement_approve_op.req_linkno_i = msc_requirement_tc_link.req_linkno_i
                    LEFT JOIN check_type_int ON requirement_link.target=check_type_int.check_intno_i
                    WHERE requirement_link.source_mimetype = 'TCREQLI' 
                                   AND requirement_link.target_mimetype = 'CHTI' 
                                   AND requirement_link.code IN ('IN', 'PD')
		     AND check_type_int.check_intno_i = @VAR.check_intno_i@
                                   AND msc_requirement_approve_op.approval_status &lt;&gt; 'S'
                   ) tc_check ON msc_taskcard_version.taskcard_verno_i=tc_check.taskcard_verno_i
WHERE worktemplate_link.event_type = 'TI'
               AND (msc_maintenance_program.mpno_i = '@VAR.MP_NO@')
               AND msc_mp_revision.revision_type='MP'
               AND (
                         msc_mp_revision.revision_status='@VAR.mp_rev_status@' AND tc_rem.status IS NULL
                         OR tc_rem.revision_status='@VAR.mp_rev_status@' AND tc_rem.status='0'
	          )
               AND (REGEXP_LIKE(msc_section_code.section_code, REPLACE('@VAR.tc_sec@', ', ', '|')) OR '@VAR.tc_sec@' IS NULL)
               AND (
                         msc_taskcard_version.taskcard_status='A' AND tc_status.TC_A='0'
                         OR msc_taskcard_version.taskcard_status='T' AND tc_status.TC_T='S'
                         OR msc_taskcard_version.taskcard_status='A'
                               AND tc_status.TC_A='1' 
                               AND msc_mp_revision.revision_status='b'
                         OR msc_taskcard_version.taskcard_status IN ('B')
                               AND tc_status.TC_A='0' 
                               AND msc_mp_revision.revision_status='b'
                        )
               AND event_template.revision_status=1
               AND (REGEXP_LIKE(tc_check.check_intno_i, REPLACE('@VAR.check_intno_i@', ', ', '|')) OR '@VAR.check_intno_i@' IS NULL)
               AND (REGEXP_LIKE(msc_taskcard_version.taskcardno_i, REPLACE('@VAR.taskcardno_i@', ', ', '|')) OR '@VAR.taskcardno_i@' IS NULL)
GROUP BY tc_ata.ata,
                     msc_taskcard.taskcardno,
                     msc_taskcard.title,
                     msc_taskcard_version.taskcard_verno_i,
                     msc_taskcard_version.revision_no,
                     wsl_zone.zone,
                     tc_remarks.remarks,
tc_descr.description,
tc_descr_html.description_html,
                     tc_pnl.panels,
                     tc_spec.skill,
                     tc_src.source,
                     msc_type_code.typecode,
                     tc_status.rno,
                     tc_status.TC_T,
                     tc_status.TC_R,
                     ata_chapter.description,
                     tc_rem.status,
                     msc_maintenance_program.mpno
ORDER BY tc_ata.ata,
                    msc_taskcard.taskcardno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="MP" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="mpno" id="mpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'Номер задачи'  ELSE 'Task Number' END as Task_Number" id="Task_Number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'Зона'  ELSE 'Zone' END as Zone" id="Zone"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'Описание задачи'  ELSE 'Task Title' END as Task_Title" id="Task_Title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'Описание задачи' ELSE 'Task Title' END as Task_Title_2" id="Task_Title_2"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'Исх. док' ELSE 'Source' END as Source" id="Source"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'Код задачи' ELSE 'Task code' END as Task_code" id="Task_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'Порог'||chr(10)||'Интервал' ELSE 'Threshold Interval' END as Interval" id="Interval"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'Ссылка на документы' ELSE 'Referneces' END as ref" id="ref"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'Применимость' ELSE 'Eff' END as eff" id="eff"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN regexp_like(msc_maintenance_program.mpno'RRJ*') THEN 'ПРОГРАММА ТЕХНИЧЕСКОГО ОБСЛУЖИВАНИЯ' ELSE 'AIRCRAFT MAINTENANCE PROGRAM' END as mp" id="mp"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.MP_NO@">
          <ds:object>@VAR.MP_NO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_maintenance_program.mpno as mpno,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'Номер задачи' ELSE 'Task Number' END as Task_Number,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'Зона' ELSE 'Zone' END as Zone,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'Описание задачи' ELSE 'Task Title' END as Task_Title,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'Описание задачи' ELSE 'Task Title' END as Task_Title_2,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'Исх.'||chr(10)||'док' ELSE 'Source' END as Source,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'Код задачи' ELSE 'Task code' END as Task_code,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'Порог'||chr(10)||'Интервал' ELSE 'Threshold Interval' END as Interval,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'Ссылка на документы' ELSE 'References' END as ref,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'Применимость' ELSE 'Eff' END as eff,
CASE WHEN regexp_like(msc_maintenance_program.mpno, 'RRJ*') THEN 'ПРОГРАММА ТЕХНИЧЕСКОГО ОБСЛУЖИВАНИЯ' ELSE 'AIRCRAFT MAINTENANCE PROGRAM' END as mp

FROM msc_maintenance_program
WHERE msc_maintenance_program.mpno_i='@VAR.MP_NO@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="EFF_LIST" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i as tcvno_i" id="tcvno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="eff_zone.zone as zone" id="zone"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_item.itemno_i" id="msc_item.itemno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event_effectivity_link.effectivity_linkno_i" id="event_effectivity_link.effectivity_linkno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="eff_tc_threshold.threshold || CHR(10) || CHR(10) || eff_tc_interval.interval as eff_time_rec" id="eff_time_rec"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="eff_ws_ref.ref || CASE WHEN eff_ws_ref.ref IS NULL THEN '' ELSE CHR(10) END || eff_wo_ref.ref as ref" id="ref"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="eff_ac.sn as eff_ac" id="eff_ac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(SELECT COUNT (*) &#10;              FROM msc_taskcard_version&#10;              JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i&#10;              JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'&#10;              WHERE msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@') as eff_count" id="eff_count"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@TC.taskcard_verno_i@">
          <ds:object>@TC.taskcard_verno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v08_format@">
          <ds:object>@VAR.v08_format@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_taskcard_version.taskcard_verno_i as tcvno_i,
             eff_zone.zone as zone,
             msc_item.itemno_i,
             event_effectivity_link.effectivity_linkno_i,
             eff_tc_threshold.threshold || CHR(10) || CHR(10) || eff_tc_interval.interval as eff_time_rec,
             eff_ws_ref.ref || CASE WHEN eff_ws_ref.ref IS NULL THEN '' ELSE CHR(10) END || eff_wo_ref.ref as ref,
             CASE WHEN eff_ac_all.range_type IS NOT NULL
                        THEN 'ALL'||CASE WHEN eff_ac_all.aircraft_model IS NULL OR ASCII(eff_ac_all.aircraft_model)=49824  THEN '' ELSE ' (A/C Model:'||eff_ac_all.aircraft_model||')' END||CHR(10)
                        ELSE ''
             END||eff_ac.sn as eff_ac,
             (SELECT COUNT (*) 
              FROM msc_taskcard_version
              JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
              JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
              WHERE msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@') as eff_count
FROM msc_taskcard_version
JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
LEFT JOIN (
                   SELECT event_effectivity_link.effectivity_linkno_i,
                                LISTAGG ('T:'
                                                     ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)
                                                                   WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + treq_interval.due_at, 'DD.MM.YYYY')
                                                                   ELSE TO_CHAR(treq_interval.amount_interval)
                                                         END
                                                     ||' '
                                                     ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                   WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                                                   WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                   WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                   WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                   WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                         ELSE ''
                                                         END, CHR(10)
                                                ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as threshold
                                FROM event_effectivity_link
                                LEFT JOIN treq_time_requirement ON treq_time_requirement.event_key=event_effectivity_link.effectivity_linkno_i
                                LEFT JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
                                LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i
                                LEFT JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
                                WHERE event_effectivity_link.event_type = 'TI'  
                                             AND treq_time_requirement.status='0'
                                             AND treq_interval.dimension_type IN ('W', 'B')
                                             AND treq_time_requirement.event_type = 'EFL' 
                                             AND treq_time_requirement.type = 'OP'
                                GROUP BY event_effectivity_link.effectivity_linkno_i
                  ) eff_tc_threshold ON event_effectivity_link.effectivity_linkno_i=eff_tc_threshold.effectivity_linkno_i
LEFT JOIN (
                   SELECT event_effectivity_link.effectivity_linkno_i,
                                LISTAGG ('I:'
                                                    ||treq_interval.amount_interval
                                                    ||' '
                                                    ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                  WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                                                  WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                  WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                  WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                  WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                                  ELSE '' 
                                                        END, CHR(10)
                                                ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as interval
                   FROM event_effectivity_link
                   LEFT JOIN treq_time_requirement ON treq_time_requirement.event_key=event_effectivity_link.effectivity_linkno_i
                   LEFT JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
                   LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i
                   LEFT JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
                   WHERE event_effectivity_link.event_type = 'TI'  
                                AND treq_time_requirement.status='0'
                                AND treq_interval.dimension_type='I'
                                AND treq_time_requirement.event_type = 'EFL' 
                                AND treq_time_requirement.type = 'OP' 
                   GROUP BY event_effectivity_link.effectivity_linkno_i
                  ) eff_tc_interval ON event_effectivity_link.effectivity_linkno_i=eff_tc_interval.effectivity_linkno_i

LEFT JOIN (
                   SELECT
                          ws_ref.effectivity_linkno_i,
                          LISTAGG (ws_ref.ref, CHR(10)) WITHIN GROUP (ORDER BY ws_ref.ref) as ref
                   FROM (
                                SELECT
                                       DISTINCT event_effectivity_link.effectivity_linkno_i,
                                       db_link.ref_type ||' '
                                                                   || CASE WHEN (db_link.ref_type IS NULL) THEN TO_CHAR(db_link.link_remarks)||' ' ELSE '' END 
                                                                   || CASE WHEN (db_link.ref_type='MJC' OR TO_CHAR(db_link.link_remarks)='MJC')
                                                                                  THEN REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''),  '^(.*MJC)(A20|A30|B3|B7|R95)([0-9-]{8})(.*)', '\2\3')
                                                                                  ELSE REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''), '\[([a-zA-Z]+[0-9]*?)\]', ' \1') END as ref
                                FROM msc_taskcard_version
                                JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                                JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
                                JOIN worktemplate_link ON worktemplate_link.event_key=event_effectivity_link.effectivity_linkno_i AND worktemplate_link.event_type = 'EFL'
                                JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i
                                JOIN workstep_link ON event_template.event_perfno_i=workstep_link.event_perfno_i
                                JOIN db_link ON TO_CHAR(workstep_link.descno_i)=TO_CHAR(db_link.source_pk)
                                WHERE
                                       msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
                                       AND db_link.source_type='WS'
                                       AND event_template.revision_status=1
                                       AND event_template.status = 0 
                               ) ws_ref
                   GROUP BY ws_ref.effectivity_linkno_i
                  ) eff_ws_ref ON eff_ws_ref.effectivity_linkno_i = event_effectivity_link.effectivity_linkno_i

LEFT JOIN (
                   SELECT
                          wo_ref.effectivity_linkno_i,
                          LISTAGG (wo_ref.ref, CHR(10)) WITHIN GROUP (ORDER BY wo_ref.ref) as ref
                   FROM (
                                SELECT
                                       DISTINCT event_effectivity_link.effectivity_linkno_i,
                                       db_link.ref_type ||' '
                                                                   || CASE WHEN (db_link.ref_type IS NULL) THEN TO_CHAR(db_link.link_remarks)||' ' ELSE '' END 
                                                                   || CASE WHEN (db_link.ref_type='MJC' OR TO_CHAR(db_link.link_remarks)='MJC')
                                                                                  THEN REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''),  '^(.*MJC)(A20|A30|B3|B7|R95)([0-9-]{8})(.*)', '\2\3')
                                                                                  ELSE REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''), '\[([a-zA-Z]+[0-9]*?)\]', ' \1') END as ref
                                FROM msc_taskcard_version
                                JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                                JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
                                JOIN worktemplate_link ON worktemplate_link.event_key=event_effectivity_link.effectivity_linkno_i AND worktemplate_link.event_type = 'EFL'
                                JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i
                                JOIN db_link ON TO_CHAR(event_template.event_perfno_i)=TO_CHAR(db_link.source_pk)
                                WHERE
                                       msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
                                       AND db_link.source_type='WO'
                                       AND event_template.revision_status=1
                                       AND event_template.status = 0 
                               ) wo_ref
                   GROUP BY wo_ref.effectivity_linkno_i
                  ) eff_wo_ref ON eff_wo_ref.effectivity_linkno_i = event_effectivity_link.effectivity_linkno_i
LEFT JOIN (
                   SELECT event_effectivity_link.effectivity_linkno_i,
                                 DECODE (event_effectivity_sns.range_type,
                                                   'A', 'ALL',
                                                    '' ) as range_type,
                                event_effectivity.status,
                                event_effectivity.aircraft_model
                   FROM event_effectivity_link 
                   LEFT JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
                   LEFT jOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i
                   WHERE event_effectivity_link.event_type = 'TI'
                                 AND event_effectivity.status='0'
                                 AND event_effectivity_sns.range_type='A'
                 ) eff_ac_all ON event_effectivity_link.effectivity_linkno_i = eff_ac_all.effectivity_linkno_i
LEFT JOIN (
                   SELECT ac.effectivity_linkno_i,
                                 LISTAGG (ac.sn, CHR(10)) WITHIN GROUP (ORDER BY ac.sn) as sn
                   FROM (
                                SELECT
                                      event_effectivity_link.effectivity_linkno_i,
                                      DECODE (event_effectivity_sns.include_exclude,'E','Excl.: ','I','Incl.: ','')||
                                      LISTAGG (
                                                       CASE WHEN REGEXP_LIKE(event_effectivity_sns.serialno_to, '^[0-9]+$')
                                                                 THEN 'Serialno-From:'||' '||event_effectivity_sns.serialno_from||' '||CHR(10)||'Serialno-To:'||' '||event_effectivity_sns.serialno_to
                                                                 ELSE event_effectivity_sns.serialno_from END, '; ') WITHIN GROUP (ORDER BY event_effectivity_sns.serialno_from) as sn,
                                      event_effectivity_sns.range_type,
                                      event_effectivity.aircraft_model
                                FROM event_effectivity_link 
                                JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
                                LEFT jOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i
                                WHERE
                                       event_effectivity_link.event_type = 'TI'
                                       AND event_effectivity.status='0'
                                       AND event_effectivity_sns.range_type='S'
                                GROUP BY event_effectivity_link.effectivity_linkno_i, event_effectivity_sns.include_exclude, event_effectivity.aircraft_model, event_effectivity_sns.range_type

                                UNION

                                SELECT
                                       event_effectivity_link.effectivity_linkno_i,
                                       DECODE (event_effectivity_sns.include_exclude,'E','Excl.: ','I','Incl.: ','')
                                      ||LISTAGG ('Serialno-From:'
                                                            ||' '
                                                            ||event_effectivity_sns.serialno_from
                                                            ||' '
                                                            ||CHR(10)
                                                            ||'Serialno-To:'
                                                            ||' '||event_effectivity_sns.serialno_to, ';'
                                                            ||CHR(10)
                                                           ) WITHIN GROUP (ORDER BY event_effectivity_sns.serialno_from) as sn,
                                       event_effectivity_sns.range_type,
                                       event_effectivity.aircraft_model
                                FROM event_effectivity_link 
                                JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
                                LEFT jOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i
                                WHERE
                                        event_effectivity_link.event_type = 'TI'
                                        AND event_effectivity.status='0'
                                        AND event_effectivity_sns.range_type='R'
                                GROUP BY event_effectivity_link.effectivity_linkno_i, event_effectivity_sns.include_exclude, event_effectivity.aircraft_model, event_effectivity_sns.range_type
                               ) ac
                   GROUP BY ac.effectivity_linkno_i
                  ) eff_ac ON event_effectivity_link.effectivity_linkno_i = eff_ac.effectivity_linkno_i

LEFT JOIN (
                   SELECT
                          z.taskcard_verno_i,
                          LISTAGG (z.zone, CHR(10)) WITHIN GROUP (ORDER BY z.zone) as zone
                   FROM (
                                SELECT
                                       DISTINCT msc_taskcard_version.taskcard_verno_i,
                                       zone_code_link.zone
                                FROM
                                       msc_taskcard_version
                                JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                                JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
                                JOIN worktemplate_link ON worktemplate_link.event_key=event_effectivity_link.effectivity_linkno_i AND worktemplate_link.event_type = 'EFL'
                                JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i
                                JOIN workstep_link ON event_template.event_perfno_i=workstep_link.event_perfno_i
                                JOIN zone_code_link ON workstep_link.descno_i=zone_code_link.source_pk
                                WHERE
                                       msc_taskcard_version.taskcard_verno_i = '@TC.taskcard_verno_i@'
                                       AND zone_code_link.source_type='WS' 
                                       AND event_template.revision_status=1
                                       AND event_template.status = 0
                               ) z
                   GROUP BY z.taskcard_verno_i
                  ) eff_zone ON eff_zone.taskcard_verno_i = msc_taskcard_version.taskcard_verno_i

WHERE 
       '@VAR.v08_format@'='PDF'
       AND msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
       AND  (
                  SELECT COUNT (*) 
                  FROM msc_taskcard_version
                  JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                  JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
                  WHERE msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@') &gt; 1
ORDER BY 
       effectivity_linkno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="REFERENCES" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="LISTAGG (dbl.refCHR(10)) WITHIN GROUP (ORDER BY dbl.ref) as ref" id="ref"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@TC.taskcard_verno_i@">
          <ds:object>@TC.taskcard_verno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
      LISTAGG (dbl.ref, CHR(10)) WITHIN GROUP (ORDER BY dbl.ref) as ref  
FROM (
             SELECT
                    msc_taskcard_version.taskcard_verno_i,
                    db_link.ref_type
                    ||' '
                    || CASE WHEN (db_link.ref_type IS NULL) THEN TO_CHAR(db_link.link_remarks)||' ' ELSE '' END 
                    || CASE WHEN (db_link.ref_type='MJC' OR TO_CHAR(db_link.link_remarks)='MJC')
                                   THEN REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''),  '^(.*MJC)(A20|A30|B3|B7|R95)([0-9-]{8})(.*)', '\2\3')
                                   ELSE REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''), '\[([a-zA-Z]+[0-9]*?)\]', ' \1') 
                         END as ref
             FROM 
             msc_taskcard_version
             JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
             JOIN worktemplate_link ON worktemplate_link.event_key = msc_item.itemno_i AND worktemplate_link.event_type = 'TI'
             JOIN work_template ON (worktemplate_link.wtno_i=work_template.wtno_i OR worktemplate_link.wtno_i = work_template.parent_wtno_i)
             JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i AND event_template.revision_status=1 AND event_template.status = 0 
             JOIN workstep_link ON event_template.event_perfno_i=workstep_link.event_perfno_i
             JOIN db_link ON TO_CHAR(workstep_link.descno_i) = TO_CHAR(db_link.source_pk) AND db_link.source_type='WS'
             WHERE 
                     msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'

             UNION

             SELECT
                     msc_taskcard_version.taskcard_verno_i,
             db_link.ref_type
             ||' '
             || CASE WHEN (db_link.ref_type IS NULL) THEN TO_CHAR(db_link.link_remarks)||' ' ELSE '' END 
             || CASE WHEN (db_link.ref_type='MJC' OR TO_CHAR(db_link.link_remarks)='MJC')
                            THEN REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''),  '^(.*MJC)(A20|A30|B3|B7|R95)([0-9-]{8})(.*)', '\2\3')
                            ELSE REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''), '\[([a-zA-Z]+[0-9]*?)\]', ' \1') 
                  END as ref
              FROM 
              msc_taskcard_version
              JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
              JOIN worktemplate_link ON worktemplate_link.event_key = msc_item.itemno_i AND worktemplate_link.event_type = 'TI'
              JOIN work_template ON (worktemplate_link.wtno_i=work_template.wtno_i OR worktemplate_link.wtno_i = work_template.parent_wtno_i)
              JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i AND event_template.revision_status=1 AND event_template.status = 0
              JOIN db_link ON TO_CHAR(event_template.event_perfno_i)=TO_CHAR(db_link.source_pk) AND db_link.source_type='WO'
              WHERE 
                      msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
             ) dbl
GROUP BY dbl.taskcard_verno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="TREQ_THRESHOLD" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i" id="msc_taskcard_version.taskcard_verno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i&#10;             LISTAGG (CASE WHEN treq_time_requirement.ac_group='A330 SAMPLE' THEN 'S' ELSE '' END&#10;                              ||'T:'&#10;                              ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)&#10;                                            WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + treq_interval.due_at 'DD.MM.YYYY')&#10;                                            ELSE TO_CHAR(treq_interval.amount_interval)&#10;                                   END&#10;                              ||' '&#10;                              ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'&#10;                                            WHEN treq_interval.counter_defno_i=2 THEN 'FC'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'&#10;                                            WHEN treq_interval.counter_defno_i=101 THEN 'AH'&#10;                                            WHEN treq_interval.counter_defno_i=102 THEN 'AC'&#10;                                            WHEN treq_interval.counter_defno_i=103 THEN 'SD'&#10;                                            WHEN treq_interval.counter_defno_i=104 THEN 'ID'&#10;                                            ELSE ''&#10;                                  END CHR(10)&#10;                             ) WITHIN GROUP (ORDER BY treq_time_requirement.ac_group NULLS LASTtreq_interval.amount_interval) as threshold" id="threshold"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@TC.taskcard_verno_i@">
          <ds:object>@TC.taskcard_verno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_taskcard_version.taskcard_verno_i,
             LISTAGG (CASE WHEN treq_time_requirement.ac_group='A330 SAMPLE' THEN 'S' ELSE '' END
                              ||'T:'
                              ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)
                                            WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + treq_interval.due_at, 'DD.MM.YYYY')
                                            ELSE TO_CHAR(treq_interval.amount_interval)
                                   END
                              ||' '
                              ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                            WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                            WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                            WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                            WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                            WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                            ELSE ''
                                  END, CHR(10)
                             ) WITHIN GROUP (ORDER BY treq_time_requirement.ac_group NULLS LAST, treq_interval.amount_interval) as threshold
FROM msc_taskcard_version
JOIN treq_time_requirement ON treq_time_requirement.event_key=msc_taskcard_version.taskcard_verno_i AND treq_time_requirement.status='0'
                                                                                                                                                                                         AND treq_time_requirement.event_type = 'TCREV'
                                                                                                                                                                                         AND treq_time_requirement.type = 'OP'
JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i AND treq_interval.dimension_type IN ('W', 'B')
JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
WHERE msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
GROUP BY msc_taskcard_version.taskcard_verno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="TREQ_INTERVAL" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i" id="msc_taskcard_version.taskcard_verno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG (CASE WHEN treq_time_requirement.ac_group='A330 SAMPLE' THEN 'S' ELSE '' END&#10;                              ||'I:'&#10;                              ||treq_interval.amount_interval&#10;                              ||' '&#10;                              ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'&#10;                                            WHEN treq_interval.counter_defno_i=2 THEN 'FC'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'&#10;                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'&#10;                                            WHEN treq_interval.counter_defno_i=101 THEN 'AH'&#10;                                            WHEN treq_interval.counter_defno_i=102 THEN 'AC'&#10;                                            WHEN treq_interval.counter_defno_i=103 THEN 'SD'&#10;                                            WHEN treq_interval.counter_defno_i=104 THEN 'ID'&#10;                                            ELSE '' &#10;                                  END CHR(10)&#10;                             ) WITHIN GROUP (ORDER BY treq_time_requirement.ac_group NULLS LASTtreq_interval.amount_interval) as interval" id="interval"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@TC.taskcard_verno_i@">
          <ds:object>@TC.taskcard_verno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_taskcard_version.taskcard_verno_i,
             LISTAGG (CASE WHEN treq_time_requirement.ac_group='A330 SAMPLE' THEN 'S' ELSE '' END
                              ||'I:'
                              ||treq_interval.amount_interval
                              ||' '
                              ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                            WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                            WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                            WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                            WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                            WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                            WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                            ELSE '' 
                                  END, CHR(10)
                             ) WITHIN GROUP (ORDER BY treq_time_requirement.ac_group NULLS LAST, treq_interval.amount_interval) as interval
FROM msc_taskcard_version
JOIN treq_time_requirement ON treq_time_requirement.event_key=msc_taskcard_version.taskcard_verno_i AND treq_time_requirement.status='0'
                                                                                                                                                                                         AND treq_time_requirement.event_type = 'TCREV'
                                                                                                                                                                                         AND treq_time_requirement.type = 'OP'
JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i AND treq_interval.dimension_type IN ('I')
JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
WHERE msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
GROUP BY msc_taskcard_version.taskcard_verno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="TREQ_EFF" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i as tcvno_i" id="tcvno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event_effectivity_link.effectivity_linkno_i" id="event_effectivity_link.effectivity_linkno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="eff_tc_threshold.threshold || CHR(10) || CHR(10) || eff_tc_interval.interval as treq" id="treq"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@TC.taskcard_verno_i@">
          <ds:object>@TC.taskcard_verno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_taskcard_version.taskcard_verno_i as tcvno_i,
             event_effectivity_link.effectivity_linkno_i,
             eff_tc_threshold.threshold || CHR(10) || CHR(10) || eff_tc_interval.interval as treq
FROM msc_taskcard_version
JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
LEFT JOIN (
                   SELECT event_effectivity_link.effectivity_linkno_i,
                                LISTAGG ('T:'
                                                     ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)
                                                                   WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + treq_interval.due_at, 'DD.MM.YYYY')
                                                                   ELSE TO_CHAR(treq_interval.amount_interval)
                                                         END
                                                     ||' '
                                                     ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                   WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                                                   WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                   WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                   WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                   WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                         ELSE ''
                                                         END, CHR(10)
                                                ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as threshold
                                FROM event_effectivity_link
                                LEFT JOIN treq_time_requirement ON treq_time_requirement.event_key=event_effectivity_link.effectivity_linkno_i
                                LEFT JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
                                LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i
                                LEFT JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
                                WHERE event_effectivity_link.event_type = 'TI'  
                                             AND treq_time_requirement.status='0'
                                             AND treq_interval.dimension_type IN ('W', 'B')
                                             AND treq_time_requirement.event_type = 'EFL' 
                                             AND treq_time_requirement.type = 'OP'
                                GROUP BY event_effectivity_link.effectivity_linkno_i
                  ) eff_tc_threshold ON event_effectivity_link.effectivity_linkno_i=eff_tc_threshold.effectivity_linkno_i
LEFT JOIN (
                   SELECT event_effectivity_link.effectivity_linkno_i,
                                LISTAGG ('I:'
                                                    ||treq_interval.amount_interval
                                                    ||' '
                                                    ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                  WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                                                  WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                  WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                  WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                  WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                                  ELSE '' 
                                                        END, CHR(10)
                                                ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as interval
                   FROM event_effectivity_link
                   LEFT JOIN treq_time_requirement ON treq_time_requirement.event_key=event_effectivity_link.effectivity_linkno_i
                   LEFT JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
                   LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i
                   LEFT JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
                   WHERE event_effectivity_link.event_type = 'TI'  
                                AND treq_time_requirement.status='0'
                                AND treq_interval.dimension_type='I'
                                AND treq_time_requirement.event_type = 'EFL' 
                                AND treq_time_requirement.type = 'OP' 
                   GROUP BY event_effectivity_link.effectivity_linkno_i
                  ) eff_tc_interval ON event_effectivity_link.effectivity_linkno_i=eff_tc_interval.effectivity_linkno_i
WHERE 
       msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
ORDER BY 
       effectivity_linkno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="EFF_AC" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i as taskcard_verno_i" id="taskcard_verno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN ev_eff_all.range_type IS NOT NULL&#10;                        THEN 'ALL'||CASE WHEN ev_eff_all.aircraft_model IS NULL OR ASCII(ev_eff_all.aircraft_model)=49824  THEN '' ELSE ' (A/C Model:'||ev_eff_all.aircraft_model||')' END||CHR(10)&#10;                        ELSE ''&#10;             END||              &#10;                         CASE WHEN ev_eff_r_s.event_key IS NOT NULL&#10;                                   THEN ev_eff_r_s.sn&#10;                                   ELSE ''&#10;                         END as eff" id="eff"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@TC.taskcard_verno_i@">
          <ds:object>@TC.taskcard_verno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_taskcard_version.taskcard_verno_i as taskcard_verno_i,
             CASE WHEN ev_eff_all.range_type IS NOT NULL
                        THEN 'ALL'||CASE WHEN ev_eff_all.aircraft_model IS NULL OR ASCII(ev_eff_all.aircraft_model)=49824  THEN '' ELSE ' (A/C Model:'||ev_eff_all.aircraft_model||')' END||CHR(10)
                        ELSE ''
             END||              
                         CASE WHEN ev_eff_r_s.event_key IS NOT NULL
                                   THEN ev_eff_r_s.sn
                                   ELSE ''
                         END as eff
FROM msc_taskcard_version
JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
LEFT JOIN (
                   SELECT event_effectivity_link.event_key,
                                 event_effectivity.effectivityno_i,
                                 DECODE (event_effectivity_sns.range_type,
                                                   'A', 'ALL',
                                                    '' ) as range_type,
                                event_effectivity.status,
                                event_effectivity.aircraft_model
                   FROM event_effectivity_link 
                   LEFT JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
                   LEFT jOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i
                   WHERE event_effectivity_link.event_type = 'TI'
                                 AND event_effectivity.status='0'
                                 AND event_effectivity_sns.range_type='A'
                 ) ev_eff_all ON ev_eff_all.event_key = msc_item.itemno_i
LEFT JOIN (
                   SELECT eff.event_key,
                                 LISTAGG (eff.sn, CHR(10)) WITHIN GROUP (ORDER BY eff.sn) as sn
                   FROM (
                                SELECT event_effectivity_link.event_key,
                                             DECODE (event_effectivity_sns.include_exclude,'E','Excl.: ','I','Incl.: ','')||
                                             LISTAGG (
                                                              CASE WHEN REGEXP_LIKE(event_effectivity_sns.serialno_to, '^[0-9]+$')
                                                                        THEN 'Serialno-From:'||' '||event_effectivity_sns.serialno_from||' '||CHR(10)||'Serialno-To:'||' '||event_effectivity_sns.serialno_to
                                                                        ELSE event_effectivity_sns.serialno_from END, '; ') WITHIN GROUP (ORDER BY event_effectivity_sns.serialno_from) as sn,
                                             event_effectivity.effectivityno_i,
                                             event_effectivity_sns.range_type,
                                             event_effectivity.aircraft_model
                                FROM event_effectivity_link 
                                LEFT JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
                                LEFT jOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i
                                WHERE event_effectivity_link.event_type = 'TI'
                                              AND event_effectivity.status='0'
                                              AND event_effectivity_sns.range_type='S'
                                GROUP BY event_effectivity.effectivityno_i,event_effectivity_sns.include_exclude, event_effectivity.aircraft_model, event_effectivity_link.event_key, event_effectivity_sns.range_type

                                UNION

                                SELECT event_effectivity_link.event_key,
                                              DECODE (event_effectivity_sns.include_exclude,'E','Excl.: ','I','Incl.: ','')
                                             ||LISTAGG ('Serialno-From:'
                                                                    ||' '
                                                                    ||event_effectivity_sns.serialno_from
                                                                    ||' '
                                                                    ||CHR(10)
                                                                    ||'Serialno-To:'
                                                                    ||' '||event_effectivity_sns.serialno_to, ';'
                                                                    ||CHR(10)
                                                                  ) WITHIN GROUP (ORDER BY event_effectivity_sns.serialno_from) as sn,
                                             event_effectivity.effectivityno_i,
                                             event_effectivity_sns.range_type,
                                             event_effectivity.aircraft_model
                                FROM event_effectivity_link 
                                LEFT JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
                                LEFT jOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i
                                WHERE event_effectivity_link.event_type = 'TI'
                                              AND event_effectivity.status='0'
                                              AND event_effectivity_sns.range_type='R'
                                GROUP BY event_effectivity.effectivityno_i, event_effectivity_sns.include_exclude, event_effectivity.aircraft_model, event_effectivity_link.event_key, event_effectivity_sns.range_type
                               ) eff 
                   GROUP BY eff.event_key
                 ) ev_eff_r_s ON ev_eff_r_s.event_key = msc_item.itemno_i
WHERE msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
             AND (
                       SELECT COUNT(*)
                       FROM (
                                    SELECT DISTINCT event_effectivity_link.effectivityno_i
                                    FROM msc_taskcard_version
                                    JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                                    JOIN event_effectivity_link ON event_effectivity_link.event_key = msc_item.itemno_i AND event_effectivity_link.event_type = 'TI'
                                    JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i AND event_effectivity.status='0'
                                    JOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i AND event_effectivity_sns.range_type IN ('R', 'A', 'S')
                                    WHERE msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@')
                      ) = 1</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="EFF_ADAPTED_TO_XLSX" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard_version.taskcard_verno_i as tcvno_i" id="tcvno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG (eff_tc_threshold.threshold || CHR(10) || CHR(10) || eff_tc_interval.interval '; ') WITHIN GROUP (ORDER BY eff_tc_threshold.thresholdeff_tc_interval.interval) as eff_time_rec" id="eff_time_rec"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG (eff_ws_ref.ref || CASE WHEN eff_ws_ref.ref IS NULL THEN '' ELSE CHR(10) END || eff_wo_ref.ref '; ') WITHIN GROUP (ORDER BY eff_ws_ref.refeff_wo_ref.ref) as ref" id="ref"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             LISTAGG (CASE WHEN eff_ac_all.range_type IS NOT NULL&#10;                                        THEN 'ALL'||CASE WHEN eff_ac_all.aircraft_model IS NULL OR ASCII(eff_ac_all.aircraft_model)=49824  THEN '' ELSE ' (A/C Model:'||eff_ac_all.aircraft_model||')' END||CHR(10)&#10;                                        ELSE ''&#10;                              END||eff_ac.sn '; ') WITHIN GROUP (ORDER BY eff_ac_all.aircraft_modeleff_ac.sn) as eff_ac" id="eff_ac"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@TC.taskcard_verno_i@">
          <ds:object>@TC.taskcard_verno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v08_format@">
          <ds:object>@VAR.v08_format@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT msc_taskcard_version.taskcard_verno_i as tcvno_i,
             LISTAGG (eff_tc_threshold.threshold ||' '|| eff_tc_interval.interval, '; ') WITHIN GROUP (ORDER BY eff_tc_threshold.threshold, eff_tc_interval.interval) as eff_time_rec,
             LISTAGG (eff_ws_ref.ref || CASE WHEN eff_ws_ref.ref IS NULL THEN '' ELSE CHR(10) END || eff_wo_ref.ref, '; ') WITHIN GROUP (ORDER BY eff_ws_ref.ref, eff_wo_ref.ref) as ref,
             LISTAGG (CASE WHEN eff_ac_all.range_type IS NOT NULL THEN 'ALL'||CASE WHEN eff_ac_all.aircraft_model IS NULL OR ASCII(eff_ac_all.aircraft_model)=49824  THEN '' ELSE ' (A/C Model:'||eff_ac_all.aircraft_model||')' END||CHR(10)
                                        ELSE ''
                              END||eff_ac.sn, '; ') WITHIN GROUP (ORDER BY eff_ac_all.aircraft_model, eff_ac.sn) as eff_ac
FROM msc_taskcard_version
JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
LEFT JOIN (
                   SELECT event_effectivity_link.effectivity_linkno_i,
                                LISTAGG ('T:'
                                                     ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)
                                                                   WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + treq_interval.due_at, 'DD.MM.YYYY')
                                                                   ELSE TO_CHAR(treq_interval.amount_interval)
                                                         END
                                                     ||' '
                                                     ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                   WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                                                   WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                                                   WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                   WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                   WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                   WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                         ELSE ''
                                                         END, CHR(10)
                                                ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as threshold
                                FROM event_effectivity_link
                                LEFT JOIN treq_time_requirement ON treq_time_requirement.event_key=event_effectivity_link.effectivity_linkno_i
                                LEFT JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
                                LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i
                                LEFT JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
                                WHERE event_effectivity_link.event_type = 'TI'  
                                             AND treq_time_requirement.status='0'
                                             AND treq_interval.dimension_type IN ('W', 'B')
                                             AND treq_time_requirement.event_type = 'EFL' 
                                             AND treq_time_requirement.type = 'OP'
                                GROUP BY event_effectivity_link.effectivity_linkno_i
                  ) eff_tc_threshold ON event_effectivity_link.effectivity_linkno_i=eff_tc_threshold.effectivity_linkno_i
LEFT JOIN (
                   SELECT event_effectivity_link.effectivity_linkno_i,
                                LISTAGG ('I:'
                                                    ||treq_interval.amount_interval
                                                    ||' '
                                                    ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH'
                                                                  WHEN treq_interval.counter_defno_i=2 THEN 'FC'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO'
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE'
                                                                  WHEN treq_interval.counter_defno_i=101 THEN 'AH'
                                                                  WHEN treq_interval.counter_defno_i=102 THEN 'AC'
                                                                  WHEN treq_interval.counter_defno_i=103 THEN 'SD'
                                                                  WHEN treq_interval.counter_defno_i=104 THEN 'ID'
                                                                  ELSE '' 
                                                        END, CHR(10)
                                                ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as interval
                   FROM event_effectivity_link
                   LEFT JOIN treq_time_requirement ON treq_time_requirement.event_key=event_effectivity_link.effectivity_linkno_i
                   LEFT JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
                   LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i=treq_interval.interval_groupno_i
                   LEFT JOIN counter_definition ON treq_interval.counter_defno_i=counter_definition.counter_defno_i
                   WHERE event_effectivity_link.event_type = 'TI'  
                                AND treq_time_requirement.status='0'
                                AND treq_interval.dimension_type='I'
                                AND treq_time_requirement.event_type = 'EFL' 
                                AND treq_time_requirement.type = 'OP' 
                   GROUP BY event_effectivity_link.effectivity_linkno_i
                  ) eff_tc_interval ON event_effectivity_link.effectivity_linkno_i=eff_tc_interval.effectivity_linkno_i

LEFT JOIN (
                   SELECT
                          ws_ref.effectivity_linkno_i,
                          LISTAGG (ws_ref.ref, CHR(10)) WITHIN GROUP (ORDER BY ws_ref.ref) as ref
                   FROM (
                                SELECT
                                       DISTINCT event_effectivity_link.effectivity_linkno_i,
                                       db_link.ref_type ||' '
                                                                   || CASE WHEN (db_link.ref_type IS NULL) THEN TO_CHAR(db_link.link_remarks)||' ' ELSE '' END 
                                                                   || CASE WHEN (db_link.ref_type='MJC' OR TO_CHAR(db_link.link_remarks)='MJC')
                                                                                  THEN REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''),  '^(.*MJC)(A20|A30|B3|B7|R95)([0-9-]{8})(.*)', '\2\3')
                                                                                  ELSE REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''), '\[([a-zA-Z]+[0-9]*?)\]', ' \1') END as ref
                                FROM msc_taskcard_version
                                JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                                JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
                                JOIN worktemplate_link ON worktemplate_link.event_key=event_effectivity_link.effectivity_linkno_i AND worktemplate_link.event_type = 'EFL'
                                JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i
                                JOIN workstep_link ON event_template.event_perfno_i=workstep_link.event_perfno_i
                                JOIN db_link ON TO_CHAR(workstep_link.descno_i)=TO_CHAR(db_link.source_pk)
                                WHERE
                                       msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
                                       AND db_link.source_type='WS'
                                       AND event_template.revision_status=1
                                       AND event_template.status = 0 
                               ) ws_ref
                   GROUP BY ws_ref.effectivity_linkno_i
                  ) eff_ws_ref ON eff_ws_ref.effectivity_linkno_i = event_effectivity_link.effectivity_linkno_i

LEFT JOIN (
                   SELECT
                          wo_ref.effectivity_linkno_i,
                          LISTAGG (wo_ref.ref, CHR(10)) WITHIN GROUP (ORDER BY wo_ref.ref) as ref
                   FROM (
                                SELECT
                                       DISTINCT event_effectivity_link.effectivity_linkno_i,
                                       db_link.ref_type ||' '
                                                                   || CASE WHEN (db_link.ref_type IS NULL) THEN TO_CHAR(db_link.link_remarks)||' ' ELSE '' END 
                                                                   || CASE WHEN (db_link.ref_type='MJC' OR TO_CHAR(db_link.link_remarks)='MJC')
                                                                                  THEN REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''),  '^(.*MJC)(A20|A30|B3|B7|R95)([0-9-]{8})(.*)', '\2\3')
                                                                                  ELSE REGEXP_REPLACE(REGEXP_REPLACE(TO_CHAR(db_link.description), '(.pdf)', ''), '\[([a-zA-Z]+[0-9]*?)\]', ' \1') END as ref
                                FROM msc_taskcard_version
                                JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                                JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
                                JOIN worktemplate_link ON worktemplate_link.event_key=event_effectivity_link.effectivity_linkno_i AND worktemplate_link.event_type = 'EFL'
                                JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i
                                JOIN db_link ON TO_CHAR(event_template.event_perfno_i)=TO_CHAR(db_link.source_pk)
                                WHERE
                                       msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
                                       AND db_link.source_type='WO'
                                       AND event_template.revision_status=1
                                       AND event_template.status = 0 
                               ) wo_ref
                   GROUP BY wo_ref.effectivity_linkno_i
                  ) eff_wo_ref ON eff_wo_ref.effectivity_linkno_i = event_effectivity_link.effectivity_linkno_i
LEFT JOIN (
                   SELECT event_effectivity_link.effectivity_linkno_i,
                                 DECODE (event_effectivity_sns.range_type,
                                                   'A', 'ALL',
                                                    '' ) as range_type,
                                event_effectivity.status,
                                event_effectivity.aircraft_model
                   FROM event_effectivity_link 
                   LEFT JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
                   LEFT jOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i
                   WHERE event_effectivity_link.event_type = 'TI'
                                 AND event_effectivity.status='0'
                                 AND event_effectivity_sns.range_type='A'
                 ) eff_ac_all ON event_effectivity_link.effectivity_linkno_i = eff_ac_all.effectivity_linkno_i
LEFT JOIN (
                   SELECT ac.effectivity_linkno_i,
                                 LISTAGG (ac.sn, CHR(10)) WITHIN GROUP (ORDER BY ac.sn) as sn
                   FROM (
                                SELECT
                                      event_effectivity_link.effectivity_linkno_i,
                                      DECODE (event_effectivity_sns.include_exclude,'E','Excl.: ','I','Incl.: ','')||
                                      LISTAGG (
                                                       CASE WHEN REGEXP_LIKE(event_effectivity_sns.serialno_to, '^[0-9]+$')
                                                                 THEN 'Serialno-From:'||' '||event_effectivity_sns.serialno_from||' '||CHR(10)||'Serialno-To:'||' '||event_effectivity_sns.serialno_to
                                                                 ELSE event_effectivity_sns.serialno_from END, '; ') WITHIN GROUP (ORDER BY event_effectivity_sns.serialno_from) as sn,
                                      event_effectivity_sns.range_type,
                                      event_effectivity.aircraft_model
                                FROM event_effectivity_link 
                                JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
                                LEFT jOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i
                                WHERE
                                       event_effectivity_link.event_type = 'TI'
                                       AND event_effectivity.status='0'
                                       AND event_effectivity_sns.range_type='S'
                                GROUP BY event_effectivity_link.effectivity_linkno_i, event_effectivity_sns.include_exclude, event_effectivity.aircraft_model, event_effectivity_sns.range_type

                                UNION

                                SELECT
                                       event_effectivity_link.effectivity_linkno_i,
                                       DECODE (event_effectivity_sns.include_exclude,'E','Excl.: ','I','Incl.: ','')
                                      ||LISTAGG ('Serialno-From:'
                                                            ||' '
                                                            ||event_effectivity_sns.serialno_from
                                                            ||' '
                                                            ||CHR(10)
                                                            ||'Serialno-To:'
                                                            ||' '||event_effectivity_sns.serialno_to, ';'
                                                            ||CHR(10)
                                                           ) WITHIN GROUP (ORDER BY event_effectivity_sns.serialno_from) as sn,
                                       event_effectivity_sns.range_type,
                                       event_effectivity.aircraft_model
                                FROM event_effectivity_link 
                                JOIN event_effectivity ON event_effectivity.effectivityno_i = event_effectivity_link.effectivityno_i
                                LEFT jOIN event_effectivity_sns ON event_effectivity.effectivityno_i=event_effectivity_sns.effectivityno_i
                                WHERE
                                        event_effectivity_link.event_type = 'TI'
                                        AND event_effectivity.status='0'
                                        AND event_effectivity_sns.range_type='R'
                                GROUP BY event_effectivity_link.effectivity_linkno_i, event_effectivity_sns.include_exclude, event_effectivity.aircraft_model, event_effectivity_sns.range_type
                               ) ac
                   GROUP BY ac.effectivity_linkno_i
                  ) eff_ac ON event_effectivity_link.effectivity_linkno_i = eff_ac.effectivity_linkno_i

LEFT JOIN (
                   SELECT
                          z.taskcard_verno_i,
                          LISTAGG (z.zone, CHR(10)) WITHIN GROUP (ORDER BY z.zone) as zone
                   FROM (
                                SELECT
                                       DISTINCT msc_taskcard_version.taskcard_verno_i,
                                       zone_code_link.zone
                                FROM
                                       msc_taskcard_version
                                JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                                JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
                                JOIN worktemplate_link ON worktemplate_link.event_key=event_effectivity_link.effectivity_linkno_i AND worktemplate_link.event_type = 'EFL'
                                JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i
                                JOIN workstep_link ON event_template.event_perfno_i=workstep_link.event_perfno_i
                                JOIN zone_code_link ON workstep_link.descno_i=zone_code_link.source_pk
                                WHERE
                                       msc_taskcard_version.taskcard_verno_i = '@TC.taskcard_verno_i@'
                                       AND zone_code_link.source_type='WS' 
                                       AND event_template.revision_status=1
                                       AND event_template.status = 0
                               ) z
                   GROUP BY z.taskcard_verno_i
                  ) eff_zone ON eff_zone.taskcard_verno_i = msc_taskcard_version.taskcard_verno_i

WHERE
       '@VAR.v08_format@'='XLSX'
       AND msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@'
       AND  (
                  SELECT COUNT (*) 
                  FROM msc_taskcard_version
                  JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                  JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
                  WHERE msc_taskcard_version.taskcard_verno_i='@TC.taskcard_verno_i@') &gt; 1
GROUP BY
       msc_taskcard_version.taskcard_verno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
