  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="IFE_DATE" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="(TO_CHAR(TO_DATE(SYSDATE-1'DD.MM.YYYY'))) as yesterday" id="yesterday"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT (TO_CHAR(TO_DATE(SYSDATE-1, 'DD.MM.YYYY'))) as yesterday FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="IFE_WO_COUNT_ALL" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT (ife.event_perfno_i) as WO_COUNT" id="WO_COUNT"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@IFE_AC_TYPE.ac_type@">
          <ds:object>@IFE_AC_TYPE.ac_type@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT COUNT (ife.event_perfno_i) as WO_COUNT
FROM (
SELECT DISTINCT wo_header.event_perfno_i
FROM wo_header
LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
LEFT JOIN (
                    SELECT workstep_link.event_perfno_i as event_perfno_i,
                                 RTRIM(XMLAGG(XMLELEMENT(E, TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_text_action.action_date+729), 'DD.MM.YYYY')||': '||TO_CHAR(wo_text_action.text), '.'||CHR(10)||CHR(10)).EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as action_text
                    FROM wo_header
                    JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
                    JOIN wo_text_action ON workstep_link.workstep_linkno_i=wo_text_action.workstep_linkno_i
                    JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
                    LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
                    JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
                    WHERE wo_text_action.action_date IS NOT NULL
                                  AND wo_header.type NOT IN ('S', 'T', 'PD')
                                  AND wo_header.state='O'
                                  AND (
                                            wo_header.ata_chapter LIKE ('44%') AND aircraft.ac_typ IN ('B737', 'B777')
                                            OR wo_header.ata_chapter LIKE ('23%') AND aircraft.ac_typ IN ('A330', 'B737')
                                            OR aircraft.ac_typ IN ('A32S') 
                                                  AND (wo_header.ata_chapter LIKE ('23%') OR wo_header.ata_chapter LIKE ('44%'))
                                                  AND (wo_header_more.mel_chapter NOT LIKE ('23%') OR wo_header_more.mel_chapter IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_description.header, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.header IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_description.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_description.text_html, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text_html IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_action.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_action.text IS NULL)
                                          )
                    GROUP BY workstep_link.event_perfno_i
                   ) action_text ON wo_header.event_perfno_i=action_text.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
WHERE wo_header.state='O'
               AND aircraft.ac_typ='@IFE_AC_TYPE.ac_type@' 
               AND wo_header.type NOT IN ('S', 'T', 'PD')
               AND wo_header.state!='V'
               AND workstep_link.sequenceno='1'
               AND (
                          wo_header.ata_chapter LIKE ('44%') AND aircraft.ac_typ IN ('B737', 'B777')
                          OR wo_header.ata_chapter LIKE ('23%') AND aircraft.ac_typ IN ('A330', 'B737')
                          OR aircraft.ac_typ IN ('A32S') 
                                 AND (wo_header.ata_chapter LIKE ('23%') OR wo_header.ata_chapter LIKE ('44%'))
                                 AND (wo_header_more.mel_chapter NOT LIKE ('23%') OR wo_header_more.mel_chapter IS NULL)
                                 AND (NOT REGEXP_LIKE(wo_text_description.header, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.header IS NULL)
                                 AND (NOT REGEXP_LIKE(wo_text_description.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text IS NULL)
                                 AND (NOT REGEXP_LIKE(wo_text_description.text_html, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text_html IS NULL)
                                 AND (NOT REGEXP_LIKE(action_text.action_text, '(COCKPIT|OCCUPANT)','i') OR action_text.action_text IS NULL)
                         )
               AND (
REGEXP_LIKE(wo_text_description.header, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS |CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
OR
REGEXP_LIKE(wo_text_description.text, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS |CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
OR
REGEXP_LIKE(wo_text_description.text_html, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
OR
REGEXP_LIKE(action_text.action_text, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')

OR (REGEXP_LIKE(wo_text_description.header, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.header, '(CREW TERMINAL)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.text, '(CREW TERMINAL)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(CREW TERMINAL)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(action_text.action_text, '(CREW TERMINAL)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.header, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.text, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(UPLOAD)','i') AND REGEXP_LIKE(action_text.action_text, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.header, '(SYSTEM)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.text, '(SYSTEM)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(SYSTEM)','i'))
OR (REGEXP_LIKE(action_text.action_text, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(action_text.action_text, '(SYSTEM)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.header, '(BUTTON)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.text, '(BUTTON)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(BUTTON)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(CALL)','i') AND REGEXP_LIKE(action_text.action_text, '(BUTTON)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.header, '(POWER)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.text, '(POWER)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(POWER)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(VCC)','i') AND REGEXP_LIKE(action_text.action_text, '(POWER)','i'))

          )

      AND (NOT REGEXP_LIKE(wo_text_description.header, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.header IS NULL)
      AND (NOT REGEXP_LIKE(wo_text_description.text, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.text IS NULL)
      AND (NOT REGEXP_LIKE(wo_text_description.text_html, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.text_html IS NULL)
      AND (NOT REGEXP_LIKE(action_text.action_text, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.header, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.text, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.text_html, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(action_text.action_text, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR action_text.action_text IS NULL)
          
      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.header, '(HORN)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.text, '(HORN)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(HORN)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(EXT)','i') AND REGEXP_LIKE(action_text.action_text, '(HORN)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.header, '(PRERECORDED)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.text, '(PRERECORDED)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(PRERECORDED)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(action_text.action_text, '(PRERECORDED)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.header, '(LIGHT-OUTLET)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.text, '(LIGHT-OUTLET)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(LIGHT-OUTLET)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(IUL)','i') AND REGEXP_LIKE(action_text.action_text, '(LIGHT-OUTLET)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.header, '(SEB)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.text, '(SEB)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(SEB)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(DOOR)','i') AND REGEXP_LIKE(action_text.action_text, '(SEB)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.header, '(VOICE)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.text, '(VOICE)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(VOICE)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(SATCOM)','i') AND REGEXP_LIKE(action_text.action_text, '(VOICE)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.header, '(CALL BUTTON)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.text, '(CALL BUTTON)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(CALL BUTTON)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(LAV)','i') AND REGEXP_LIKE(action_text.action_text, '(CALL BUTTON)','i')) OR action_text.action_text IS NULL)
) ife</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="IFE_AC_COUNT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT (ife.ac_registr) as AC_COUNT" id="AC_COUNT"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@IFE_AC_TYPE.ac_type@">
          <ds:object>@IFE_AC_TYPE.ac_type@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT COUNT (ife.ac_registr) as AC_COUNT
FROM (
SELECT DISTINCT wo_header.ac_registr       
FROM wo_header
LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
LEFT JOIN (
                    SELECT workstep_link.event_perfno_i as event_perfno_i,
                                 RTRIM(XMLAGG(XMLELEMENT(E, TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_text_action.action_date+729), 'DD.MM.YYYY')||': '||TO_CHAR(wo_text_action.text), '.'||CHR(10)||CHR(10)).EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as action_text
                    FROM wo_header
                    JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
                    JOIN wo_text_action ON workstep_link.workstep_linkno_i=wo_text_action.workstep_linkno_i
                    JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
                    LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
                    JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
                    WHERE wo_text_action.action_date IS NOT NULL
                                  AND wo_header.type NOT IN ('S', 'T', 'PD')
                                  AND wo_header.state='O'
                                  AND (
                                            wo_header.ata_chapter LIKE ('44%') AND aircraft.ac_typ IN ('B737', 'B777')
                                            OR wo_header.ata_chapter LIKE ('23%') AND aircraft.ac_typ IN ('A330', 'B737')
                                            OR aircraft.ac_typ IN ('A32S') 
                                                  AND (wo_header.ata_chapter LIKE ('23%') OR wo_header.ata_chapter LIKE ('44%'))
                                                  AND (wo_header_more.mel_chapter NOT LIKE ('23%') OR wo_header_more.mel_chapter IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_description.header, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.header IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_description.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_description.text_html, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text_html IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_action.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_action.text IS NULL)
                                          )
                    GROUP BY workstep_link.event_perfno_i
                   ) action_text ON wo_header.event_perfno_i=action_text.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
WHERE wo_header.state='O'
               AND aircraft.ac_typ='@IFE_AC_TYPE.ac_type@'
               AND wo_header.type NOT IN ('S', 'T', 'PD')
               AND wo_header.state!='V'
               AND workstep_link.sequenceno='1'
               AND (
                          wo_header.ata_chapter LIKE ('44%') AND aircraft.ac_typ IN ('B737', 'B777')
                          OR wo_header.ata_chapter LIKE ('23%') AND aircraft.ac_typ IN ('A330', 'B737')
                          OR aircraft.ac_typ IN ('A32S') 
                                 AND (wo_header.ata_chapter LIKE ('23%') OR wo_header.ata_chapter LIKE ('44%'))
                                 AND (wo_header_more.mel_chapter NOT LIKE ('23%') OR wo_header_more.mel_chapter IS NULL)
                                 AND (NOT REGEXP_LIKE(wo_text_description.header, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.header IS NULL)
                                 AND (NOT REGEXP_LIKE(wo_text_description.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text IS NULL)
                                 AND (NOT REGEXP_LIKE(wo_text_description.text_html, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text_html IS NULL)
                                 AND (NOT REGEXP_LIKE(action_text.action_text, '(COCKPIT|OCCUPANT)','i') OR action_text.action_text IS NULL)
                         )
               AND (
REGEXP_LIKE(wo_text_description.header, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS |CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
OR
REGEXP_LIKE(wo_text_description.text, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS |CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
OR
REGEXP_LIKE(wo_text_description.text_html, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
OR
REGEXP_LIKE(action_text.action_text, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')

OR (REGEXP_LIKE(wo_text_description.header, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.header, '(CREW TERMINAL)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.text, '(CREW TERMINAL)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(CREW TERMINAL)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(action_text.action_text, '(CREW TERMINAL)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.header, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.text, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(UPLOAD)','i') AND REGEXP_LIKE(action_text.action_text, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.header, '(SYSTEM)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.text, '(SYSTEM)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(SYSTEM)','i'))
OR (REGEXP_LIKE(action_text.action_text, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(action_text.action_text, '(SYSTEM)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.header, '(BUTTON)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.text, '(BUTTON)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(BUTTON)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(CALL)','i') AND REGEXP_LIKE(action_text.action_text, '(BUTTON)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.header, '(POWER)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.text, '(POWER)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(POWER)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(VCC)','i') AND REGEXP_LIKE(action_text.action_text, '(POWER)','i'))

          )

      AND (NOT REGEXP_LIKE(wo_text_description.header, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.header IS NULL)
      AND (NOT REGEXP_LIKE(wo_text_description.text, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.text IS NULL)
      AND (NOT REGEXP_LIKE(wo_text_description.text_html, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.text_html IS NULL)
      AND (NOT REGEXP_LIKE(action_text.action_text, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.header, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.text, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.text_html, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(action_text.action_text, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR action_text.action_text IS NULL)
          
      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.header, '(HORN)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.text, '(HORN)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(HORN)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(EXT)','i') AND REGEXP_LIKE(action_text.action_text, '(HORN)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.header, '(PRERECORDED)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.text, '(PRERECORDED)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(PRERECORDED)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(action_text.action_text, '(PRERECORDED)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.header, '(LIGHT-OUTLET)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.text, '(LIGHT-OUTLET)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(LIGHT-OUTLET)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(IUL)','i') AND REGEXP_LIKE(action_text.action_text, '(LIGHT-OUTLET)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.header, '(SEB)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.text, '(SEB)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(SEB)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(DOOR)','i') AND REGEXP_LIKE(action_text.action_text, '(SEB)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.header, '(VOICE)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.text, '(VOICE)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(VOICE)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(SATCOM)','i') AND REGEXP_LIKE(action_text.action_text, '(VOICE)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.header, '(CALL BUTTON)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.text, '(CALL BUTTON)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(CALL BUTTON)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(LAV)','i') AND REGEXP_LIKE(action_text.action_text, '(CALL BUTTON)','i')) OR action_text.action_text IS NULL)
) ife</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="IFE_WO_COUNT_DAILY" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT (ife.event_perfno_i) as WO_COUNT" id="WO_COUNT"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT (ife.closed) as WO_C_COUNT" id="WO_C_COUNT"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@IFE_AC_TYPE.ac_type@">
          <ds:object>@IFE_AC_TYPE.ac_type@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT COUNT (ife.event_perfno_i) as WO_COUNT,
               COUNT (ife.closed) as WO_C_COUNT
FROM (
SELECT DISTINCT wo_header.event_perfno_i,
               DECODE(wo_header.state,'C','C') as closed
FROM wo_header
LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
LEFT JOIN (
                    SELECT workstep_link.event_perfno_i as event_perfno_i,
                                 RTRIM(XMLAGG(XMLELEMENT(E, TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (wo_text_action.action_date+729), 'DD.MM.YYYY')||': '||TO_CHAR(wo_text_action.text), '.'||CHR(10)||CHR(10)).EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as action_text
                    FROM wo_header
                    JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
                    JOIN wo_text_action ON workstep_link.workstep_linkno_i=wo_text_action.workstep_linkno_i
                    JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
                    LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
                    JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
                    WHERE wo_text_action.action_date IS NOT NULL
                                  AND wo_header.type NOT IN ('S', 'T', 'PD')
                                  AND wo_header.issue_date=FLOOR(sysdate-to_date('19711231','yyyymmdd')) - 1
                                  AND wo_header.state!='V'
                                  AND (
                                            wo_header.ata_chapter LIKE ('44%') AND aircraft.ac_typ IN ('B737', 'B777')
                                            OR wo_header.ata_chapter LIKE ('23%') AND aircraft.ac_typ IN ('A330', 'B737')
                                            OR aircraft.ac_typ IN ('A32S') 
                                                  AND (wo_header.ata_chapter LIKE ('23%') OR wo_header.ata_chapter LIKE ('44%'))
                                                  AND (wo_header_more.mel_chapter NOT LIKE ('23%') OR wo_header_more.mel_chapter IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_description.header, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.header IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_description.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_description.text_html, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text_html IS NULL)
                                                  AND (NOT REGEXP_LIKE(wo_text_action.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_action.text IS NULL)
                                          )
                    GROUP BY workstep_link.event_perfno_i
                   ) action_text ON wo_header.event_perfno_i=action_text.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr=aircraft.ac_registr
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
WHERE wo_header.issue_date=FLOOR(sysdate-to_date('19711231','yyyymmdd')) - 1
               AND aircraft.ac_typ IN '@IFE_AC_TYPE.ac_type@' 
               AND wo_header.type NOT IN ('S', 'T', 'PD')
               AND wo_header.state!='V'
               AND workstep_link.sequenceno='1'
               AND (
                          wo_header.ata_chapter LIKE ('44%') AND aircraft.ac_typ IN ('B737', 'B777')
                          OR wo_header.ata_chapter LIKE ('23%') AND aircraft.ac_typ IN ('A330', 'B737')
                          OR aircraft.ac_typ IN ('A32S') 
                                 AND (wo_header.ata_chapter LIKE ('23%') OR wo_header.ata_chapter LIKE ('44%'))
                                 AND (wo_header_more.mel_chapter NOT LIKE ('23%') OR wo_header_more.mel_chapter IS NULL)
                                 AND (NOT REGEXP_LIKE(wo_text_description.header, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.header IS NULL)
                                 AND (NOT REGEXP_LIKE(wo_text_description.text, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text IS NULL)
                                 AND (NOT REGEXP_LIKE(wo_text_description.text_html, '(COCKPIT|OCCUPANT)','i') OR wo_text_description.text_html IS NULL)
                                 AND (NOT REGEXP_LIKE(action_text.action_text, '(COCKPIT|OCCUPANT)','i') OR action_text.action_text IS NULL)
                         )
               AND (
REGEXP_LIKE(wo_text_description.header, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS |CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
OR
REGEXP_LIKE(wo_text_description.text, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS |CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
OR
REGEXP_LIKE(wo_text_description.text_html, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')
OR
REGEXP_LIKE(action_text.action_text, '(SVDU|SDU|QSEB|CONTROL|JACK|TPMU|PCU|WIFI|IFE|USB|PED|SOCKET|MCU|SOUND|OML|OUTLET UNIT|ENTERTAINMENT SYSTEM|VIDEO|CORD|DART|CABLE|REMOTE|MONITOR|MONITORES|MONITORS CONTR|SEB|CORD|HAND SET|AUDIO)|((H)([A-Za-z0-9]{3})(PHON)([A-Za-z0-9]{1}|\s|\.))|((H)([A-Za-z0-9]{2,4})(SET)([A-Za-z0-9]{1}|\s|\.))|((WI)((-)|\s{1})(FI)|GSM|CRADLE)','i')

OR (REGEXP_LIKE(wo_text_description.header, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.header, '(CREW TERMINAL)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.text, '(CREW TERMINAL)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(CREW TERMINAL)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(VCI MAIN PUSHBUTTON)','i') AND REGEXP_LIKE(action_text.action_text, '(CREW TERMINAL)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.header, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.text, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(UPLOAD)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(UPLOAD)','i') AND REGEXP_LIKE(action_text.action_text, '(ADVERTI)([A-Za-z0-9]{1})(ING DATA)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.header, '(SYSTEM)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.text, '(SYSTEM)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(SYSTEM)','i'))
OR (REGEXP_LIKE(action_text.action_text, '([A-Za-z0-9]{1})(FE)','i') AND REGEXP_LIKE(action_text.action_text, '(SYSTEM)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.header, '(BUTTON)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.text, '(BUTTON)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(CALL)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(BUTTON)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(CALL)','i') AND REGEXP_LIKE(action_text.action_text, '(BUTTON)','i'))

OR (REGEXP_LIKE(wo_text_description.header, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.header, '(POWER)','i'))
OR (REGEXP_LIKE(wo_text_description.text, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.text, '(POWER)','i'))
OR (REGEXP_LIKE(wo_text_description.text_html, '(VCC)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(POWER)','i'))
OR (REGEXP_LIKE(action_text.action_text, '(VCC)','i') AND REGEXP_LIKE(action_text.action_text, '(POWER)','i'))

          )

      AND (NOT REGEXP_LIKE(wo_text_description.header, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.header IS NULL)
      AND (NOT REGEXP_LIKE(wo_text_description.text, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.text IS NULL)
      AND (NOT REGEXP_LIKE(wo_text_description.text_html, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR wo_text_description.text_html IS NULL)
      AND (NOT REGEXP_LIKE(action_text.action_text, '(CDSS|ENG#|PRAM|ACARS|INTERPHONE|LAV L|VHF)','i') OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.header, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.text, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(wo_text_description.text_html, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(HANDSET|((H)([A-Za-z0-9]{3})(SET)))','i') AND REGEXP_LIKE(action_text.action_text, '(OBSERVER|OBSERVERS|OBSERVER\WS)','i')) OR action_text.action_text IS NULL)
          
      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.header, '(HORN)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.text, '(HORN)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(EXT)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(HORN)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(EXT)','i') AND REGEXP_LIKE(action_text.action_text, '(HORN)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.header, '(PRERECORDED)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.text, '(PRERECORDED)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(PRERECORDED)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(ANNOUNCEMENT)','i') AND REGEXP_LIKE(action_text.action_text, '(PRERECORDED)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.header, '(LIGHT-OUTLET)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.text, '(LIGHT-OUTLET)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(IUL)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(LIGHT-OUTLET)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(IUL)','i') AND REGEXP_LIKE(action_text.action_text, '(LIGHT-OUTLET)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.header, '(SEB)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.text, '(SEB)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(DOOR)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(SEB)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(DOOR)','i') AND REGEXP_LIKE(action_text.action_text, '(SEB)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.header, '(VOICE)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.text, '(VOICE)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(SATCOM)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(VOICE)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(SATCOM)','i') AND REGEXP_LIKE(action_text.action_text, '(VOICE)','i')) OR action_text.action_text IS NULL)

      AND (NOT (REGEXP_LIKE(wo_text_description.header, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.header, '(CALL BUTTON)','i')) OR wo_text_description.header IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.text, '(CALL BUTTON)','i')) OR wo_text_description.text IS NULL)
      AND (NOT (REGEXP_LIKE(wo_text_description.text_html, '(LAV)','i') AND REGEXP_LIKE(wo_text_description.text_html, '(CALL BUTTON)','i')) OR wo_text_description.text_html IS NULL)
      AND (NOT (REGEXP_LIKE(action_text.action_text, '(LAV)','i') AND REGEXP_LIKE(action_text.action_text, '(CALL BUTTON)','i')) OR action_text.action_text IS NULL)
) ife</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="IFE_AC_TYPE" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="'A32S' as ac_type" id="ac_type"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 'A32S' as ac_type FROM DUAL
UNION
SELECT 'A330' as ac_type FROM DUAL
UNION
SELECT 'A350' as ac_type FROM DUAL
UNION
SELECT 'B737' as ac_type FROM DUAL
UNION
SELECT 'B777' as ac_type FROM DUAL
order by 1 ASC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
