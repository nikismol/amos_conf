  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ROLE" description="" id="v02_user_group"/>
        <ds:columnDescriptor amosType="SG" description="" id="v01_user_sign"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="02. User role" id="v02_user_group">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="01. User sign" id="v01_user_sign">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="231_CHECKED_USERS_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="menu_user.login_sign as login_sign" id="login_sign"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_user-sign@">
          <ds:object>@VAR.v01_user-sign@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT menu_user.login_sign as login_sign
FROM menu_user
WHERE 1=1
              AND (REGEXP_LIKE(menu_user.login_sign, REPLACE('@VAR.v01_user-sign@', ', ', '|')) OR '@VAR.v01_user-sign@' IS NULL)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="231_CHECKED_ROLES" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="r_base.program_id as program_id" id="program_id"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r_base.read_write as read_write" id="read_write"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@231_CHECKED_USERS_MAIN.login_sign@">
          <ds:object>@231_CHECKED_USERS_MAIN.login_sign@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_user_group@">
          <ds:object>@VAR.v02_user_group@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT r_base.program_id as program_id,
             r_base.read_write as read_write
FROM (
             select DISTINCT
                        ng_user_access.program_id,
                        ng_user_access.read_write,
                        ng_user_access.program_id||ng_user_access.read_write as r_access
             from user_access
             join ng_user_access ON user_access.user_group = ng_user_access.user_group
             join user_group ON user_access.user_group=user_group.user_group and user_group.status&lt;&gt;9
             where 1=1
                         and user_access.login_sign = '@231_CHECKED_USERS_MAIN.login_sign@'
             order by 1, 2 
            ) r_base
LEFT JOIN (
                   select DISTINCT
                              ng_user_access.program_id,
                              ng_user_access.read_write,                             
                              ng_user_access.program_id||ng_user_access.read_write as r_access
                   from user_access
                   join ng_user_access ON user_access.user_group = ng_user_access.user_group
                   join user_group ON user_access.user_group=user_group.user_group and user_group.status&lt;&gt;9
                   where 1=1
                               and user_access.login_sign = '@231_CHECKED_USERS_MAIN.login_sign@'
                               and user_access.user_group &lt;&gt; '@VAR.v02_user_group@'
                   order by 1, 2
                  ) r_check on r_base.r_access=r_check.r_access
WHERE r_check.r_access IS NULL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="231_CHECKED_ROLE_ACCESS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ng_user_access.program_id as program_id" id="program_id"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ng_user_access.read_write as read_write" id="read_write"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_user_group@">
          <ds:object>@VAR.v02_user_group@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select ng_user_access.program_id as program_id,
           ng_user_access.read_write as read_write
from ng_user_access
where 1=1
            and ng_user_access.user_group = '@VAR.v02_user_group@'
order by 1, 2</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
