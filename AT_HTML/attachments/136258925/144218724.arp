  <content/>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_SCHD_GROUP" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="scheduler_group.name as group_name" id="group_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="scheduler_group.scheduler_groupno_i as scheduler_groupno_i" id="scheduler_groupno_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT scheduler_group.name as group_name,
             scheduler_group.scheduler_groupno_i as scheduler_groupno_i
FROM scheduler_group</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_SCHD_TASK" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="scheduler_conf.name||' ('||scheduler_conf.scheduler_confno_i||')' as task_name" id="task_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="scheduler_conf.scheduler_confno_i" id="scheduler_conf.scheduler_confno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="scheduler_conf.status" id="scheduler_conf.status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             DECODE (schd_log.status&#10;                              '1' 'INTERFACE_WARNING'&#10;                              '2' 'INTERFACE_ERROR'&#10;                              '4' 'хз'&#10;                              '7' 'INTERFACE_PARALLEL_EXECUTION'&#10;                              '6' 'EXECUTING'&#10;                              '0''SUCCESS') as state" id="state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="schd_log.log_text as log_text" id="log_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (schd_log.mutation+729) 'DD.MM.YYYY') ||' '||&#10;             TO_CHAR(FLOOR (schd_log.mutation_time)/1000/60)||':'||CASE WHEN (TO_CHAR( MOD(schd_log.mutation_time 60000)))&lt;10&#10;                                                                                                                             THEN '0'||(TO_CHAR( MOD (schd_log.mutation_time 60000)))&#10;                                                                                                                             ELSE (TO_CHAR( MOD (schd_log.mutation_time60000)))&#10;                                                                                                                   END as log_time" id="log_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="scheduler_conf.scheduler_groupno_i" id="scheduler_conf.scheduler_groupno_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_SCHD_GROUP.scheduler_groupno_i@">
          <ds:object>@RMX_SCHD_GROUP.scheduler_groupno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT scheduler_conf.name||' ('||scheduler_conf.scheduler_confno_i||')' as task_name,
             scheduler_conf.scheduler_confno_i,
             scheduler_conf.status,
             DECODE (schd_log.status,
                              '1', 'INTERFACE_WARNING',
                              '2', 'INTERFACE_ERROR',
                              '4', 'хз',
                              '7', 'INTERFACE_PARALLEL_EXECUTION',
                              '6', 'EXECUTING',
                              '0', 'SUCCESS') as state,
 /*            schd_log.log_text as log_text, */
             TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (schd_log.mutation+729), 'DD.MM.YYYY') ||' '||
             TO_CHAR(FLOOR (schd_log.mutation_time)/1000/60)||':'||CASE WHEN (TO_CHAR( MOD(schd_log.mutation_time, 60000)))&lt;10
                                                                                                                             THEN '0'||(TO_CHAR( MOD (schd_log.mutation_time, 60000)))
                                                                                                                             ELSE (TO_CHAR( MOD (schd_log.mutation_time, 60000)))
                                                                                                                   END as log_time,
             scheduler_conf.scheduler_groupno_i
              
FROM scheduler_conf
LEFT jOIN scheduler_group ON scheduler_conf.scheduler_groupno_i=scheduler_group.scheduler_groupno_i
LEFT JOIN (SELECT scheduler_log.scheduler_confno_i,
                                scheduler_log.scheduler_logno_i,
                                MAX (scheduler_log.scheduler_logno_i) OVER (PARTITION BY scheduler_log.scheduler_confno_i) as max_scheduler_logno_i,
                                scheduler_log.log_text,
                                scheduler_log.log_summary,
                                scheduler_log.mutation,
                                scheduler_log.mutation_time,
                                scheduler_log.status,
                                scheduler_log.parameters
                  FROM scheduler_log
                 ) schd_log ON schd_log.scheduler_confno_i=scheduler_conf.scheduler_confno_i
WHERE scheduler_conf.scheduler_confno_i NOT IN ( 2002, /*ExportComponentHistory*/
                                                                                          2003, /*ExportAircraft*/ 
                                                                                          6404, /*TransferPartDefition*/
                                                                                          6402, /*TransferShipment*/
                                                                                          2004, /*TransferOrder*/
                                                                                          2005 /*TransferReceiving*/)
             AND schd_log.scheduler_logno_i=schd_log.max_scheduler_logno_i
     /*        AND scheduler_conf.scheduler_groupno_i='@RMX_SCHD_GROUP.scheduler_groupno_i@' */</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
