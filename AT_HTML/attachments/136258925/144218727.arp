          <se:textStatement>select count(*) as count_tq_high
from
(SELECT 
        DISTINCT
        tech_query.queryno_i 
FROM 
        tech_query
            LEFT JOIN
                    tech_query_note ON tech_query_note.queryno_i = tech_query.queryno_i
            
WHERE (
(((@VAR.DATE_FROM@)&lt;=(tech_query.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query.created_date)))
and tech_query.assigned_to_group IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ') and tech_query.priority = 'HIGH'
)

or (tech_query_note.note like ('%to%1.ДИС%') 
and (((@VAR.DATE_FROM@)&lt;=(tech_query_note.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query_note.created_date)))
and tech_query.priority = 'HIGH')

or (tech_query_note.note like ('%to%2.SUPPORT_2%') 
and (((@VAR.DATE_FROM@)&lt;=(tech_query_note.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query_note.created_date)))
and tech_query.priority = 'HIGH')

or (tech_query_note.note like ('%to%3.SUPPORT_3%') 
and (((@VAR.DATE_FROM@)&lt;=(tech_query_note.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query_note.created_date)))
and tech_query.priority = 'HIGH')

or (tech_query_note.note like ('%to%4.ИНТЕГРАЦИЯ%') 
and (((@VAR.DATE_FROM@)&lt;=(tech_query_note.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query_note.created_date)))
and tech_query.priority = 'HIGH'))</se:textStatement>
        </se:sqlStatement>
