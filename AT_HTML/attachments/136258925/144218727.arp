    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_TQ" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="tqn.queryno_i" id="tqn.queryno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;        &#9;RTRIM(XMLAGG(XMLELEMENT(E tqn.note ' / ').EXTRACT('//text()') ORDER BY  tech_query_note.note_type).GetClobVal()CHR(10)) as super_note" id="super_note"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tqn.headline" id="tqn.headline"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tqn.assigned_to_group" id="tqn.assigned_to_group"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tqn.assigned_to" id="tqn.assigned_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tqn.priority" id="tqn.priority"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_FROM@">
          <ds:object>@VAR.DATE_FROM@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_TO@">
          <ds:object>@VAR.DATE_TO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.SIGN@">
          <ds:object>@VAR.SIGN@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  
        tqn.queryno_i,
        RTRIM(XMLAGG(XMLELEMENT(E, tqn.note, ' / ').EXTRACT('//text()') ORDER BY  tqn.note).GetClobVal(), CHR(10)) as super_note,
        tqn.headline,
        tqn.assigned_to_group,
        tqn.assigned_to,
        tqn.priority
FROM 	(
                SELECT	tech_query.queryno_i,
                        		tech_query.headline,
                        		tech_query.assigned_to_group,
                        		tech_query.assigned_to,
                        		tech_query.priority,
                CASE  		
                WHEN tech_query_note.note_type='R' and tech_query_note.note like ('%Deassigned from group 1.ДИС%') or tech_query_note.note like ('%Reassigned from group 1.ДИС%' )  
                THEN 'Заявка перенаправлена с группы 1.ДИС (отработана)' 		
                WHEN tech_query_note.note_type='R' and tech_query_note.note like ('%Deassigned from group 2.SUPPORT_2%') or tech_query_note.note like ('%Reassigned from group 2.SUPPORT_2%' ) 
                THEN 'Заявка перенаправлена с группы 2.SUPPORT_2 (отработана)' 		
                WHEN tech_query_note.note_type='R' and tech_query_note.note like ('%Deassigned from group 3.SUPPORT_3%') or tech_query_note.note like ('%Reassigned from group 3.SUPPORT_3%' ) 
                THEN 'Заявка перенаправлена с группы 3.SUPPORT_3 (отработана)'  		
                WHEN tech_query_note.note_type='O' 
                THEN 'Заявка открыта (переоткрыта)' 		
                WHEN tech_query_note.note_type='P' 
                THEN 'В заявку внесена Note' 		
                WHEN tech_query_note.note_type='C' 
                THEN 'Заявка закрыта'  		
                WHEN tech_query.status='9' 
                THEN 'Заявка удалена' 
                WHEN tech_query_note.note_type = 'R' and tech_query_note.note like ('%assigned the query to himself/herself%')
                THEN    'Assigned the query to himself/herself'
                WHEN tech_query_note.note_type='R' and tech_query_note.note like ('%Assigned to group 2.SUPPORT_2%')
                or tech_query_note.note like ('%to 2.SUPPORT_2%')
                Then 'Заявка назначена на группу 2.Support_2'
                WHEN tech_query_note.note_type='R' and tech_query_note.note like ('%Assigned to group 3.SUPPORT_3%')
                or tech_query_note.note like ('%to 3.SUPPORT_3%')
                Then 'Заявка назначена на группу 3.Support_3'
                WHEN tech_query_note.note_type='R' and tech_query_note.note like ('%Assigned to group 4.ИНТЕГРАЦИЯ%')
                or tech_query_note.note like ('%to 4.ИНТЕГРАЦИЯ%')
                Then 'Заявка назначена на группу 4.ИНТЕГРАЦИЯ'
                WHEN tech_query_note.note_type='R' and tech_query_note.note like ('%Assigned to%') 
                or tech_query_note.note_type='R' and tech_query_note.note like ('%Reassigned from group%') 
                Then 'Заявка перенаправлена не на группу техподдержки'
                ELSE 'Другое действие'        
                END AS note
                FROM tech_query_note
                LEFT JOIN tech_query ON  tech_query_note.queryno_i = tech_query.queryno_i
                WHERE ( ('@VAR.DATE_FROM@' &lt;= tech_query_note.created_date) AND ('@VAR.DATE_TO@' &gt;= tech_query_note.created_date) )
		AND tech_query_note.mutator = '@VAR.SIGN@' AND tech_query_note.mutator IN ('FEDOSEEN', 'IVANENKO', 'VRYBIN', 'PASECHNI', 'LABUSHEV', 'SDAMRIN', 'NFILIP')
            	) tqn                         
GROUP BY    
            tqn.queryno_i,
            tqn.headline,
            tqn.assigned_to_group,
            tqn.assigned_to,
            tqn.priority</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_TQ_COUNT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(*) as all_count_tq" id="all_count_tq"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_FROM@">
          <ds:object>@VAR.DATE_FROM@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_TO@">
          <ds:object>@VAR.DATE_TO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select  count(*) as all_count_tq
from
(SELECT 
        DISTINCT
        tech_query.queryno_i 
FROM 
        tech_query
            LEFT JOIN
                    tech_query_note ON tech_query_note.queryno_i = tech_query.queryno_i
            
WHERE (
 (((@VAR.DATE_FROM@)&lt;=(tech_query.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query.created_date)))
and tech_query.assigned_to_group IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ'))

or (tech_query_note.note like ('%to%1.ДИС%') 
and (((@VAR.DATE_FROM@)&lt;=(tech_query_note.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query_note.created_date)))
)
or (tech_query_note.note like ('%to%2.SUPPORT_2%') 
and (((@VAR.DATE_FROM@)&lt;=(tech_query_note.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query_note.created_date)))
)
or (tech_query_note.note like ('%to%3.SUPPORT_3%') 
and (((@VAR.DATE_FROM@)&lt;=(tech_query_note.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query_note.created_date)))
)
or (tech_query_note.note like ('%to%4.ИНТЕГРАЦИЯ%') 
and (((@VAR.DATE_FROM@)&lt;=(tech_query_note.created_date))
and ((@VAR.DATE_TO@)&gt;=(tech_query_note.created_date)))
)


ORDER BY tech_query.queryno_i asc)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_SHIFT_DATES" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (@VAR.shift_start@+729)'DD.MM.YYYY') as shift_start" id="shift_start"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (@VAR.shift_finish@+729)'DD.MM.YYYY') as shift_finish" id="shift_finish"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_FROM@">
          <ds:object>@VAR.DATE_FROM@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_TO@">
          <ds:object>@VAR.DATE_TO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (@VAR.DATE_FROM@+729), 'DD.MM.YYYY') as shift_start,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (@VAR.DATE_TO@+729), 'DD.MM.YYYY') as shift_finish
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_TQ_HIGH_COUNT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
