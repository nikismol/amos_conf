    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_TQ" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT tech_query.queryno_i as queryno_i" id="queryno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.headline as headline" id="headline"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tech_query.priority as priority" id="priority"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       CASE WHEN tech_query.status='3' THEN 'Closed'&#10;            WHEN tech_query.status='2'&#10;                 AND tech_query.assigned_to_group NOT IN ('1.ДИС''2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ' '5.ОЗМ_SAP')&#10;                 AND tech_query.assigned_to_group IS NOT NULL&#10;            THEN 'Waiting for feedback'&#10;&#9;&#9;&#9;WHEN tech_query.status='2'&#10;                 AND (tech_query.assigned_to_group IN ('1.ДИС''2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ''5.ОЗМ_SAP') OR assigned_to_group IS NULL)&#10;            THEN 'Assigned to '||tech_query.assigned_to_group&#10;            ELSE ''&#10;        END as status" id="status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN tech_query.assigned_to_group IS NULL AND tech_query.assigned_to IS NULL THEN 'assignment required!!!' ELSE tech_query.assigned_to_group END as assign_group" id="assign_group"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.shift_start@">
          <ds:object>@VAR.shift_start@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@SYSTEM.LOGIN_SIGN@">
          <ds:object>@SYSTEM.LOGIN_SIGN@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT DISTINCT tech_query.queryno_i as queryno_i,
       tech_query.headline as headline,
       tech_query.priority as priority,
       CASE WHEN tech_query.status='3' THEN 'Закрыто'
            WHEN tech_query.status IN ('2','4')
                 AND tech_query.assigned_to_group NOT IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                 AND tech_query.assigned_to_group IS NOT NULL
            THEN 'Заявка отработана - ожидается ответ'
			WHEN tech_query.status IN ('1', '2', '4')
                 AND (tech_query.assigned_to_group IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ') AND (assigned_to_group IS NOT NULL OR tech_query.assigned_to IS NOT NULL))
            THEN 'Заявка назначена на группу ТП'
            WHEN tech_query.status='9' THEN 'Заявка удалена'
            ELSE ''
       END as status,
       CASE WHEN tech_query.assigned_to_group IS NULL AND tech_query.assigned_to IS NULL THEN 'assignment required!!!' ELSE tech_query.assigned_to_group END as assign_group
FROM 
tech_query
LEFT JOIN tech_query_note ON tech_query.queryno_i=tech_query_note.queryno_i
WHERE (
       (
        tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=960
        OR
        tech_query_note.created_date = @VAR.shift_start@+1  AND tech_query_note.created_time &lt;= 360
       )
       OR  (
            tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=960
            OR
            tech_query_note.created_date = @VAR.shift_start@+1  AND tech_query_note.created_time &lt;= 360
           )
      )
      AND (
           tech_query.assigned_to_group IN ('1.ДИС', '2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
           OR tech_query_note.created_by='@SYSTEM.LOGIN_SIGN@'
           OR tech_query.assigned_to_group IS NULL AND tech_query.assigned_to IS NULL
          )
      OR (tech_query.status='9'
          AND (
               tech_query.mutation = @VAR.shift_start@ AND tech_query.mutation_time&gt;=960
               OR 
               tech_query_note.mutation = @VAR.shift_start@+1  AND tech_query_note.mutation_time &lt;= 360
              )
          AND tech_query_note.mutator='@SYSTEM.LOGIN_SIGN@'
         )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_TQ_COUNT" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="(SELECT COUNT (tech_query.queryno_i)&#10;        FROM tech_query&#10;        LEFT JOIN tech_query_note ON tech_query.queryno_i=tech_query_note.queryno_i&#10;        WHERE (&#10;               tech_query.issued_date = @VAR.shift_start@ AND tech_query.issued_time &gt;=1020&#10;               OR&#10;               tech_query.issued_date = @VAR.shift_start@+1  AND tech_query.issued_time &lt;300&#10;              )&#10;              AND (&#10;                   assigned_to_group IN ('1.ДИС''2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ''5.ОЗМ_SAP')&#10;                   OR&#10;                   tech_query_note.created_by='@VAR.login@'&#10;                  )&#10;        GROUP BY tech_query.queryno_i&#10;       ) as query_count" id="query_count"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;       (SELECT COUNT (tech_query.queryno_i)&#10;        FROM tech_query&#10;        LEFT JOIN tech_query_note ON tech_query.queryno_i=tech_query_note.queryno_i&#10;        WHERE tech_query_note.created_by='@SYSTEM.LOGIN_SIGN@'&#10;              AND (&#10;                   tech_query.status='3'&#10;                   OR tech_query.status='9'&#10;                   OR tech_query.status='2'&#10;                      AND tech_query.assigned_to_group NOT IN ('1.ДИС''2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ' '5.ОЗМ_SAP')   &#10;                  )&#10;              AND (&#10;                   tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=1020&#10;                   OR&#10;                   tech_query_note.created_date = @VAR.shift_start@+1  AND tech_query_note.created_time &lt;300&#10;                  )&#10;              AND (&#10;                   tech_query.assigned_to_group IN ('1.ДИС''2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ''5.ОЗМ_SAP')&#10;                   OR&#10;                   tech_query_note.created_by='@SYSTEM.LOGIN_SIGN@'&#10;                  )               &#10;        GROUP BY tech_query.queryno_i&#10;       ) as query_count_performed" id="query_count_performed"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;       (SELECT COUNT (tech_query.queryno_i)&#10;        FROM tech_query&#10;        LEFT JOIN tech_query_note ON tech_query.queryno_i=tech_query_note.queryno_i&#10;        WHERE tech_query.status IN ('1' '2' '4')&#10;              AND (&#10;                   tech_query.assigned_to_group IN ('1.ДИС''2.SUPPORT_2' '3.SUPPORT_3' '4.ИНТЕГРАЦИЯ''5.ОЗМ_SAP')&#10;                   OR&#10;                   tech_query.assigned_to_group IS NULL AND tech_query.assigned_to&#10;                  )&#10;              AND (&#10;                    (&#10;                     tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=1020&#10;                     OR&#10;                     tech_query_note.created_date = @VAR.shift_start@+1  AND tech_query_note.created_time &lt;300&#10;                    )&#10;                    OR  (&#10;                         tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=1020&#10;                         OR&#10;                         tech_query_note.created_date = @VAR.shift_start@+1  AND tech_query_note.created_time &lt;300&#10;                        )&#10;                  )&#10;           &#10;        GROUP BY tech_query.queryno_i&#10;       ) as query_count_assigned" id="query_count_assigned"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;NVL(tq_cnt.query_count_assigned_h0) as query_count_assigned_h" id="query_count_assigned_h"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.shift_start@">
          <ds:object>@VAR.shift_start@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@SYSTEM.LOGIN_SIGN@">
          <ds:object>@SYSTEM.LOGIN_SIGN@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT
NVL(tq_cnt.query_count, 0) as query_count,
NVL(tq_cnt.query_count_performed, 0) as query_count_performed,
NVL(tq_cnt.query_count_assigned, 0) as query_count_assigned,
NVL(tq_cnt.query_count_assigned_h, 0) as query_count_assigned_h

FROM (
      SELECT  
             (SELECT COUNT (tech_query.queryno_i)
              FROM tech_query
              LEFT JOIN tech_query_note ON tech_query.queryno_i=tech_query_note.queryno_i
              WHERE  (
                      tech_query.issued_date = @VAR.shift_start@ AND tech_query.issued_time &gt;=1020
                      OR
                      tech_query.issued_date = @VAR.shift_start@+1 AND tech_query.issued_time &lt;300
                     )
                     AND (
                          tech_query.assigned_to_group IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                          OR tech_query.assigned_to_group IS NULL AND tech_query.assigned_to IS NULL
                         )
                     OR (
                         tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=1020
                         OR
                         tech_query_note.created_date = @VAR.shift_start@+1  AND tech_query_note.created_time &lt;300
                        )
                        AND tech_query.assigned_to_group IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')  
                        AND tech_query_note.created_by!='@SYSTEM.LOGIN_SIGN@'        
                     OR (
                         tech_query.issued_date = @VAR.shift_start@ AND tech_query.issued_time &gt;=1020
                         OR
                         tech_query.issued_date = @VAR.shift_start@+1 AND tech_query.issued_time &lt;300
                        )
                        AND (
                             tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=1020
                             OR
                             tech_query_note.created_date = @VAR.shift_start@+1  AND tech_query_note.created_time &lt;300
                            )
                        AND tech_query.assigned_to_group NOT IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                        AND tech_query_note.created_by='@SYSTEM.LOGIN_SIGN@'
                            
             ) as query_count,

             (SELECT COUNT (tech_query.queryno_i)
              FROM tech_query
              LEFT JOIN tech_query_note ON tech_query.queryno_i=tech_query_note.queryno_i
              WHERE tech_query_note.created_by='@SYSTEM.LOGIN_SIGN@'
                    AND (
                         tech_query.status='3'
                         OR tech_query.status IN ('2', '4')
                            AND tech_query.assigned_to_group NOT IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                        )
                    AND (
                         tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=960
                         OR
                         tech_query_note.created_date = @VAR.shift_start@+1 AND tech_query_note.created_time &lt;360
                        ) 
                    OR (tech_query.status='9'
                        AND (
                             tech_query.mutation = @VAR.shift_start@ AND tech_query.mutation_time&gt;=960
                             OR 
                             tech_query_note.mutation = @VAR.shift_start@+1  AND tech_query_note.mutation_time &lt;360
                            )
                        AND tech_query_note.mutator='@SYSTEM.LOGIN_SIGN@'
                       )
             ) as query_count_performed,

             (SELECT COUNT (tech_query.queryno_i)
              FROM tech_query
              LEFT JOIN tech_query_note ON tech_query.queryno_i=tech_query_note.queryno_i
              WHERE tech_query.status IN ('1', '2', '4')
                    AND (
                         tech_query.assigned_to_group IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                         OR
                         tech_query.assigned_to_group IS NULL AND tech_query.assigned_to IS NULL
                        )
                    AND (
                          (
                           tech_query.issued_date = @VAR.shift_start@ AND tech_query.issued_time &gt;=1020
                           OR
                           tech_query.issued_date = @VAR.shift_start@+1  AND tech_query.issued_time &lt;300
                          )
                          OR  (
                               tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=1020
                               OR
                               tech_query_note.created_date = @VAR.shift_start@+1  AND tech_query_note.created_time &lt;300
                              )
                        )
             ) as query_count_assigned,

             (SELECT COUNT (tech_query.queryno_i)
              FROM tech_query
              LEFT JOIN tech_query_note ON tech_query.queryno_i=tech_query_note.queryno_i
              WHERE tech_query.priority='HIGH'
                    AND tech_query.status IN ('1', '2', '4')
                    AND (
                         tech_query.assigned_to_group IN ('1.ДИС','2.SUPPORT_2', '3.SUPPORT_3', '4.ИНТЕГРАЦИЯ')
                         OR
                         tech_query.assigned_to_group IS NULL AND tech_query.assigned_to IS NULL
                        )
                    AND (
                          (
                           tech_query.issued_date = @VAR.shift_start@ AND tech_query.issued_time &gt;=1020
                           OR
                           tech_query.issued_date = @VAR.shift_start@+1  AND tech_query.issued_time &lt;300
                          )
                          OR  (
                               tech_query_note.created_date = @VAR.shift_start@ AND tech_query_note.created_time &gt;=1020
                               OR
                               tech_query_note.created_date = @VAR.shift_start@+1  AND tech_query_note.created_time &lt;300
                              )
                        )

             ) as query_count_assigned_h
      FROM
      DUAL
     ) tq_cnt</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_SHIFT_DATES" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (@VAR.shift_start@+729)'DD.MM.YYYY') as shift_start" id="shift_start"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (@VAR.shift_finish@+729)'DD.MM.YYYY') as shift_finish" id="shift_finish"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.shift_start@">
          <ds:object>@VAR.shift_start@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (@VAR.shift_start@+729), 'DD.MM.YYYY') as shift_start,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (@VAR.shift_start@+1+729), 'DD.MM.YYYY') as shift_finish
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
