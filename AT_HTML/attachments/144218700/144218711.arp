  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="AC" description="" id="ACREG"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="AC_reg" id="ACREG">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="STR_DAMAGE" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.external_struct_id AS externalno" id="externalno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damage_type.description AS Description" id="Description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="linkremarks.link_remarks_1" id="linkremarks.link_remarks_1"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.location_fr_sta" id="struct_damages.location_fr_sta"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.location_st_lon" id="struct_damages.location_st_lon"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.location_rib" id="struct_damages.location_rib"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.location_side" id="struct_damages.location_side"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.location_other" id="struct_damages.location_other"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.depth" id="struct_damages.depth"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.dimension_unit" id="struct_damages.dimension_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.length" id="struct_damages.length"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.width" id="struct_damages.width"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.diameter" id="struct_damages.diameter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="direction.name" id="direction.name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.dimension" id="struct_damages.dimension"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_charts.ac_typ" id="struct_charts.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.ac_registr" id="struct_damages.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.event_perfno_i" id="struct_damages.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.event_perfno_i_final" id="struct_damages.event_perfno_i_final"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.notes" id="struct_damages.notes"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;            &#9;TO_CHAR(TO_DATE('01.01.1970' 'dd.mm.yyyy') + ( wstruct_damages.entry_date+729)'dd.mm.yyyy') AS entry_date" id="entry_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="struct_damages.ata_chapter" id="struct_damages.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN struct_damages.damage_status = 'F'&#10;&#9;           THEN 'Finally Reapired (Cat. A)'&#10;&#9;           WHEN struct_damages.damage_status = 'T'&#10;&#9;           THEN 'Temporary Repair (Cat. C)'&#10;                          WHEN struct_damages.damage_status = 'R'&#10;&#9;           THEN 'Repaired (Cat. B)' AS damage_status" id="damage_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="first_insp_table.first_insp" id="first_insp_table.first_insp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_insp_table.last_insp" id="last_insp_table.last_insp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="next_insp_table.next_insp" id="next_insp_table.next_insp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="next_insp_table.interval" id="next_insp_table.interval"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ACREG@">
          <ds:object>@VAR.ACREG@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ACTYPE@">
          <ds:object>@VAR.ACTYPE@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT struct_damages.external_struct_id AS externalno,
        	struct_damage_type.description AS Description,
            	linkremarks.link_remarks_1,
        	struct_damages.location_fr_sta,
            	struct_damages.location_st_lon,
        	struct_damages.location_rib,
            	struct_damages.location_side,
            	struct_damages.location_other,
        	struct_damages.depth,
        	struct_damages.dimension_unit,
            	struct_damages.length,
            	struct_damages.width,
            	struct_damages.diameter,
            	direction.name,
            	struct_damages.dimension,
        	struct_charts.ac_typ,
        	struct_damages.ac_registr,
            	struct_damages.event_perfno_i,
            	struct_damages.event_perfno_i_final,    
            	struct_damages.notes,
            	TO_CHAR(TO_DATE('01.01.1970', 'dd.mm.yyyy') + (struct_damages.entry_date+729), 'dd.mm.yyyy') AS entry_date,
            	struct_damages.ata_chapter,
	CASE WHEN struct_damages.damage_status = 'F'
	           THEN 'Finally Reapired (Cat. A)'
	           WHEN struct_damages.damage_status = 'T'
	           THEN 'Temporary Repair (Cat. C)'
                          WHEN struct_damages.damage_status = 'R'
	           THEN 'Repaired (Cat. B)' 
	           WHEN struct_damages.damage_status = 'N'
	           THEN 'New'
	           WHEN struct_damages.damage_status = 'HI'
	           THEN 'Component replaced'  
	END AS damage_status,
            	first_insp_table.first_insp,
            	last_insp_table.last_insp,
            	next_insp_table.next_insp,
            	next_insp_table.interval
FROM struct_damages
LEFT JOIN	(
                		SELECT	db_link.destination_key, 
                        			db_link.source_pk
                		FROM db_link
                		WHERE db_link.destination_type = 'WO'
                		AND   db_link.source_type = 'TCLS'
            		) db_link ON struct_damages.event_perfno_i = db_link.destination_key
LEFT JOIN struct_charts ON struct_damages.chartno_i = struct_charts.chartno_i
LEFT JOIN direction ON struct_damages.directionno_i = direction.directionno_i
LEFT JOIN struct_damage_type ON struct_damages.type =  struct_damage_type.damage_type                            	
        /*ссылки на документы одной строкой*/ 
LEFT JOIN	(
                		SELECT	TO_CHAR(db_link.source_pk) as source_pk,
                			RTRIM(XMLAGG(XMLELEMENT(E, db_link.link_remarks, '; ').EXTRACT('//text()') ORDER BY  db_link.linkno_i).GetClobVal(), CHR(10)) as link_remarks_1
                		FROM db_link
                		WHERE db_link.source_type = 'SD'
                		GROUP BY  db_link.source_pk
            		) linkremarks ON TO_CHAR(struct_damages.structno_i) = linkremarks.source_pk
LEFT JOIN msc_taskcard_version ON TO_CHAR(db_link.source_pk) = TO_CHAR(msc_taskcard_version.taskcard_verno_i) 
LEFT JOIN msc_requirement_tc_link ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri
        /*первая инспекция*/
	LEFT JOIN	( 
				SELECT	dblink.event_key_parent,
                                    			dblink.first_insp,
                                    			dblink.pending_status
                            			FROM	(
                                    				SELECT wo_event_link.event_key_parent,
                                            				NVL(to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_transfer.absolute_due_date+729), 'dd.mm.yyyy'), to_char(to_date('01.01.1970', 'dd.mm.yyyy') 
                                            				+ ( forecast.absolute_due_at_ac+729), 'dd.mm.yyyy')) AS first_insp,
                                            				MAX(wo_event_link.pending_status) OVER (PARTITION BY msc_taskcard_version.taskcard_verno_i) AS max_ps,
                                            				wo_event_link.pending_status
                                    				FROM db_link
                                    				LEFT JOIN msc_taskcard_version ON TO_CHAR(db_link.source_pk) = TO_CHAR(msc_taskcard_version.taskcard_verno_i) 
                                    				LEFT JOIN msc_requirement_tc_link ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri
                                    				LEFT JOIN wo_event_link ON msc_requirement_tc_link.req_linkno_i = wo_event_link.event_key_parent
                                    				LEFT JOIN forecast ON wo_event_link.event_perfno_i = forecast.event_perfno_i
                                    				LEFT JOIN wo_transfer ON wo_event_link.event_perfno_i = wo_transfer.event_perfno_i
                                    				WHERE db_link.destination_type = 'WO'
                                    				AND   db_link.source_type = 'TCLS'
                                    				AND   wo_transfer.transfer_type = 'R'                                                        
                                    				AND   wo_event_link.pending_status &lt; '0'
                                			) dblink 
                            			WHERE dblink.pending_status = dblink.max_ps
                         		) first_insp_table ON msc_requirement_tc_link.req_linkno_i = first_insp_table.event_key_parent     
        /*крайняя инспекция*/
	LEFT JOIN	(
                            			SELECT dblink2.event_key_parent,
                                    			dblink2.last_insp,
                                    			dblink2.pending_status
                            			FROM	(  
                                    				SELECT wo_event_link.event_key_parent,
                                            			to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_transfer.absolute_due_date+729), 'dd.mm.yyyy') AS last_insp,
                                            			MIN(wo_event_link.pending_status) OVER (PARTITION BY msc_taskcard_version.taskcard_verno_i) AS min_ps,
                                            			wo_event_link.pending_status
                                    				FROM db_link
                                    				LEFT JOIN msc_taskcard_version ON TO_CHAR(db_link.source_pk) = TO_CHAR(msc_taskcard_version.taskcard_verno_i) 
                                    				LEFT JOIN msc_requirement_tc_link ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri
                                    				LEFT JOIN wo_event_link ON msc_requirement_tc_link.req_linkno_i = wo_event_link.event_key_parent
                                    				LEFT JOIN forecast ON wo_event_link.event_perfno_i = forecast.event_perfno_i
                                    				LEFT JOIN wo_transfer ON wo_event_link.event_perfno_i = wo_transfer.event_perfno_i
                                    				WHERE db_link.destination_type = 'WO'
                                    				AND   db_link.source_type = 'TCLS'                                                  
                                    				AND   wo_transfer.transfer_type = 'R'                                                        
                                    				AND   wo_event_link.pending_status &lt; '0'
                                			) dblink2
                            			WHERE dblink2.pending_status = dblink2.min_ps
                        		) last_insp_table ON msc_requirement_tc_link.req_linkno_i = last_insp_table.event_key_parent
        /*следующая инспекция*/
	LEFT JOIN	(
				SELECT	dblink3.event_key_parent,
                                    			dblink3.next_insp,
                                    			dblink3.pending_status,
                                    			dblink3.interval
                            			FROM	(        
                            					SELECT wo_event_link.event_key_parent,
                                    					ndate.next_insp,
                                    					wo_event_link.pending_status,
                                    					ninterval.interval
                            						FROM db_link
                            					LEFT JOIN msc_taskcard_version ON TO_CHAR(db_link.source_pk) = TO_CHAR(msc_taskcard_version.taskcard_verno_i) 
                            					LEFT JOIN msc_requirement_tc_link ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri
                            					LEFT JOIN wo_event_link ON msc_requirement_tc_link.req_linkno_i = wo_event_link.event_key_parent
                            					LEFT JOIN wo_transfer ON wo_event_link.event_perfno_i = wo_transfer.event_perfno_i
                            					LEFT JOIN	(
									SELECT forecast_dimension.event_perfno_i,
                                               							LISTAGG(	CASE WHEN   forecast_dimension.dimension = 'C' 
                                                              								THEN 	TO_CHAR(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC))||' '||forecast_dimension.dimension
                                                              								WHEN   forecast_dimension.dimension = 'D' 
                                                              								THEN 	TO_CHAR(to_date('01.01.1970', 'dd.mm.yyyy') + ( forecast_dimension.ABSOLUTE_DUE_AT_AC+729), 'dd.mm.yyyy')||' '||forecast_dimension.dimension
                                                        									ELSE	TO_CHAR(	FLOOR (TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC)/60))||':'
                                                                   											||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC), 60)))&lt;10
                                                                   											THEN '0'||(TO_CHAR(MOD(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC), 60)))||' '||forecast_dimension.dimension
                                                                   											ELSE (TO_CHAR(MOD(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC), 60)))||' '||forecast_dimension.dimension
                                                                   											END
                                                        							     		END, '/')   WITHIN GROUP(ORDER BY forecast_dimension.COUNTER_DEFNO_I) AS next_insp
                                        							FROM forecast_dimension 
                                        							GROUP BY forecast_dimension.event_perfno_i
                                     						) ndate ON wo_event_link.event_perfno_i = ndate.event_perfno_i   
                            					LEFT JOIN 	(	
									SELECT forecast_dimension.event_perfno_i,
                                               							LISTAGG(	TO_NUMBER(forecast_dimension.INTERVAL_VALUE)||' '||forecast_dimension.dimension, '/') WITHIN GROUP(ORDER BY forecast_dimension.COUNTER_DEFNO_I) AS interval
                                        							FROM forecast_dimension
                                        							GROUP BY forecast_dimension.event_perfno_i) ninterval ON wo_event_link.event_perfno_i = ninterval.event_perfno_i 
                            					WHERE db_link.destination_type = 'WO'
                            					AND   db_link.source_type = 'TCLS'                                                                                                        
                         				) dblink3
                            			WHERE dblink3.pending_status = '0'
                        		) next_insp_table ON msc_requirement_tc_link.req_linkno_i =  next_insp_table.event_key_parent 
WHERE struct_damages.ac_registr = '@VAR.ACREG@'
/*(REGEXP_LIKE(struct_damages.ac_registr, REPLACE('@VAR.ACREG@', ', ', '|')) OR '@VAR.ACREG@' IS NULL)
AND
(REGEXP_LIKE(struct_charts.ac_typ, REPLACE('@VAR.ACTYPE@', ', ', '|')) OR '@VAR.ACTYPE@' IS NULL)*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
