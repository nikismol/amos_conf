    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="DOC_WO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.ac_registr" id="wp_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;REPLACE (wp_header.wpno '/''_') WPNO" id="WPNO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="doc_header.docno" id="doc_header.docno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="doc_header.revision" id="doc_header.revision"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_seq.seqno_i" id="wp_seq.seqno_i"/>
        <ds:columnDescriptor amosType="DATE" description="wo_header.issue_date" id="wo_header.issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.state" id="wo_header.state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="doc_header.doc_type" id="doc_header.doc_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;REGEXP_SUBSTR(wo_header.event_perfno_i '(\d)(\d)') || ' ' || REGEXP_SUBSTR(wo_header.event_perfno_i '(\d)(\d)(\d)'3) || ' ' || REGEXP_SUBSTR(wo_header.event_perfno_i '(\d)(\d)(\d)'6) WO_F1" id="WO_F1"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.ac_typ" id="wp_header.ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DOC@">
          <ds:object>@VAR.DOC@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC@">
          <ds:object>@VAR.AC@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.TYPE@">
          <ds:object>@VAR.TYPE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.REV@">
          <ds:object>@VAR.REV@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.PRE_RBME@">
          <ds:object>@VAR.PRE_RBME@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_STATE@">
          <ds:object>@VAR.WO_STATE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.POST_RBME@">
          <ds:object>@VAR.POST_RBME@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AL@">
          <ds:object>@VAR.AL@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
wo_header.event_perfno_i,
wo_header.ac_registr,
wp_header.ac_registr,
wp_header.wpno,
REPLACE (wp_header.wpno, '/', '_') WPNO,
doc_header.docno,
doc_header.revision,
wp_seq.seqno_i,
wo_header.issue_date,
wo_header.state,
doc_header.doc_type,
REGEXP_SUBSTR(wo_header.event_perfno_i, '(\d)(\d)') || ' ' || REGEXP_SUBSTR(wo_header.event_perfno_i, '(\d)(\d)(\d)',3) || ' ' || REGEXP_SUBSTR(wo_header.event_perfno_i, '(\d)(\d)(\d)',6) WO_F1,
wp_header.ac_typ
FROM  doc_header
LEFT JOIN wo_event_link ON doc_header.docno_i = wo_event_link.event_key_parent
LEFT JOIN wo_header ON wo_event_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i = wp_header.wpno_i
LEFT JOIN (
                    SELECT wp_sequence.event_perfno_i,
                                   wp_sequence.seqno_i
                    FROM wp_sequence
                    WHERE wp_sequence.status &lt;&gt; 9
                   ) wp_seq ON wp_assignment.event_perfno_i = wp_seq.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
WHERE  (REGEXP_LIKE(doc_header.docno_i, REPLACE('@VAR.DOC@', ', ', '|')) OR '@VAR.DOC@' IS NULL)
AND  (REGEXP_LIKE(wo_header.ac_registr, REPLACE('@VAR.AC@', ', ', '|')) OR '@VAR.AC@' IS NULL)
AND  (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.TYPE@', ', ', '|')) OR '@VAR.TYPE@' IS NULL)
AND  (REGEXP_LIKE(doc_header.revision, REPLACE('@VAR.REV@', ', ', '|')) OR '@VAR.REV@' IS NULL)
AND wp_header.wpno IS NOT NULL
AND '@VAR.PRE_RBME@' = 'Y'
AND wo_event_link.pending_status = '0'
AND (wo_event_link.event_type = 'DOC_EFF' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MED' AND '@AMOS_VERSION@' NOT LIKE '19.12%')
AND (wo_header.state = 'O' AND '@VAR.WO_STATE@' = 'OPEN'
OR wo_header.state = 'C' AND '@VAR.WO_STATE@' = 'CLOSED'
OR  '@VAR.WO_STATE@' = 'ALL')
UNION
(
SELECT 
wo_header.event_perfno_i,
wo_header.ac_registr,
wp_header.ac_registr,
wp_header.wpno,
REPLACE (wp_header.wpno, '/', '_') WPNO,
doc_header.docno,
doc_header.revision,
wp_seq.seqno_i,
wo_header.issue_date,
wo_header.state,
doc_header.doc_type,
REGEXP_SUBSTR(wo_header.event_perfno_i, '(\d)(\d)') || ' ' || REGEXP_SUBSTR(wo_header.event_perfno_i, '(\d)(\d)(\d)',3) || ' ' || REGEXP_SUBSTR(wo_header.event_perfno_i, '(\d)(\d)(\d)',6) WO_F1,
wp_header.ac_typ
FROM  doc_header
LEFT JOIN wo_event_link ON doc_header.docno_i = wo_event_link.event_key_parent
LEFT JOIN wo_header ON wo_event_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i = wp_header.wpno_i
LEFT JOIN (
                    SELECT wp_sequence.event_perfno_i,
                                   wp_sequence.seqno_i
                    FROM wp_sequence
                    WHERE wp_sequence.status&lt;&gt;9
                   ) wp_seq ON wp_assignment.event_perfno_i = wp_seq.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
WHERE  (REGEXP_LIKE(doc_header.docno_i, REPLACE('@VAR.DOC@', ', ', '|')) OR '@VAR.DOC@' IS NULL)
AND  (REGEXP_LIKE(wo_header.ac_registr, REPLACE('@VAR.AC@', ', ', '|')) OR '@VAR.AC@' IS NULL)
AND  (REGEXP_LIKE(aircraft.ac_typ, REPLACE('@VAR.TYPE@', ', ', '|')) OR '@VAR.TYPE@' IS NULL)
AND  (REGEXP_LIKE(doc_header.revision, REPLACE('@VAR.REV@', ', ', '|')) OR '@VAR.REV@' IS NULL)
AND wp_header.wpno IS NOT NULL
AND '@VAR.POST_RBME@' = 'Y'
AND ('@VAR.AL@' = '1' AND wo_event_link.pending_status &lt;= '-1' OR '@VAR.AL@' = '2' AND wo_event_link.pending_status = '-1')
AND (wo_event_link.event_type = 'DOC_EFF' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MED' AND '@AMOS_VERSION@' NOT LIKE '19.12%')
AND (wo_header.state = 'O' AND '@VAR.WO_STATE@' = 'OPEN'
OR wo_header.state = 'C' AND '@VAR.WO_STATE@' = 'CLOSED'
OR  '@VAR.WO_STATE@' = 'ALL')
)
ORDER BY 6</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
