        <ds:columnDescriptor amosType="DATE_INT" description="" id="date1"/>
        <ds:columnDescriptor amosType="ATA" description="" id="ATA"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="4.To" id="date2">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
