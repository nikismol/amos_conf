    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="ADHOC_JIC" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT&#10;msc_item.itemno_i" id="msc_item.itemno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr AS AC_number" id="AC_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.status" id="aircraft.status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="next_insp_table.event_key_parent" id="next_insp_table.event_key_parent"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno AS Task_no" id="Task_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ata_chapter AS ATA_chapter" id="ATA_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.title AS TC_Title" id="TC_Title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;        to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (msc_taskcard_version.revision_date+729)'dd.mm.yyyy') as Revision_date" id="Revision_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.created_date AS TC_Created_date" id="TC_Created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i AS Start_WO_number" id="Start_WO_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.state AS WO_state" id="WO_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tc_interval.interval AS Int" id="Int"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="next_insp_table.next_insp AS Due_at" id="Due_at"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tc_threshold.threshold" id="tc_threshold.threshold"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="next_insp_table.EVI AS forecast_event_perfno_i" id="forecast_event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="woh2.event_perfno_i AS Current_WO" id="Current_WO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="next_insp_table.ac_reg AS Current_AC" id="Current_AC"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_TYPE@">
          <ds:object>@VAR.AC_TYPE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ATA@">
          <ds:object>@VAR.ATA@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date1@">
          <ds:object>@VAR.date1@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date2@">
          <ds:object>@VAR.date2@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  DISTINCT
msc_item.itemno_i,
        wo_header.ac_registr AS AC_number,
        aircraft.ac_typ,
        aircraft.status,
        next_insp_table.event_key_parent,
        msc_taskcard.taskcardno AS Task_no,
        wo_header.ata_chapter AS ATA_chapter,
        msc_taskcard.title AS TC_Title,
        to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (msc_taskcard_version.revision_date+729), 'dd.mm.yyyy') as Revision_date,
        msc_taskcard.created_date AS TC_Created_date,
        wo_header.event_perfno_i AS Start_WO_number,
        wo_header.state AS WO_state,
        tc_interval.interval AS Int,
        next_insp_table.next_insp AS Due_at,
        tc_threshold.threshold
        ,next_insp_table.EVI AS forecast_event_perfno_i
        ,woh2.event_perfno_i AS Current_WO
        ,next_insp_table.ac_reg AS Current_AC
    FROM wo_header
    LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
    LEFT JOIN db_link ON wo_header.event_perfno_i = db_link.destination_key
    LEFT JOIN msc_taskcard_version ON TO_CHAR(db_link.source_pk) = TO_CHAR(msc_taskcard_version.taskcard_verno_i)
    LEFT JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i = msc_taskcard.taskcardno_i
    LEFT JOIN msc_requirement_tc_link ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri
    LEFT JOIN msc_item ON msc_taskcard_version.taskcard_verno_i = msc_item.taskcard_verno_i
    LEFT JOIN (
                   SELECT requirement_header.event_key as event_key,
                                 LISTAGG ('T:'
                                                   ||CASE WHEN treq_interval.amount_interval=-1 AND (treq_interval.counter_defno_i&lt;&gt;3 OR treq_interval.unit&lt;&gt;'D') THEN TO_CHAR(treq_interval.due_at)
                                                                 WHEN treq_interval.amount_interval=-1 AND treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + treq_interval.due_at, 'DD.MM.YYYY')
                                                                 ELSE TO_CHAR(treq_interval.amount_interval)
                                                       END
                                                   ||' '
                                                   ||CASE WHEN treq_interval.counter_defno_i=1 THEN 'FH '
                                                                  WHEN treq_interval.counter_defno_i=2 THEN 'FC '
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY '
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='D' THEN 'DY '
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='H' THEN 'HRS '
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='MT' THEN 'MO '
                                                                  WHEN treq_interval.counter_defno_i=3 AND treq_interval.unit='YR' THEN 'YE '
                                                                  WHEN treq_interval.counter_defno_i=101 THEN 'AH '
                                                                  WHEN treq_interval.counter_defno_i=102 THEN 'AC '
                                                                  WHEN treq_interval.counter_defno_i=103 THEN 'SD '
                                                                  WHEN treq_interval.counter_defno_i=104 THEN 'ID '
                                                                  ELSE ''
                                                       END, CHR(10)
                                                      ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as threshold
                   FROM 
                   requirement_header
                   JOIN treq_time_requirement  ON requirement_header.requirement_headerno_i=treq_time_requirement.event_key AND treq_time_requirement.event_type = 'REQH'
                                                                                                                                                                                                                        AND treq_time_requirement.type = 'OP'
                                                                                                                                                                                                                        AND treq_time_requirement.status = 0
		JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
		JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i=treq_dimension_group.interval_groupno_i
		JOIN treq_interval ON treq_interval.dimension_groupno_i=treq_dimension_group.dimension_groupno_i AND treq_interval.dimension_type IN ('W', 'B')
                   GROUP BY requirement_header.event_key
                  ) tc_threshold ON msc_item.itemno_i = tc_threshold.event_key 
                  
                    LEFT JOIN (SELECT requirement_header.event_key as event_key,
                                  LISTAGG ('I:'
                                                    ||treq_interval.amount_interval
                                                    ||' '
                                                    ||CASE WHEN treq_interval.counter_defno_i='1' THEN 'FH '
                                                                   WHEN treq_interval.counter_defno_i='2' THEN 'FC '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit IS NULL AND treq_interval.accuracy IS NULL THEN 'DY '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='D' THEN 'DY '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='H' THEN 'HRS '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='MT' THEN 'MO '
                                                                   WHEN treq_interval.counter_defno_i='3' AND treq_interval.unit='YR' THEN 'YE '
                                                                   WHEN treq_interval.counter_defno_i='101' THEN 'AH '
                                                                   WHEN treq_interval.counter_defno_i='102' THEN 'AC '
                                                                   ELSE '' 
                                                          END, CHR(10)
                                                      ) WITHIN GROUP (ORDER BY treq_interval.amount_interval) as interval
                    FROM
                    requirement_header
                    JOIN treq_time_requirement  ON requirement_header.requirement_headerno_i=treq_time_requirement.event_key AND treq_time_requirement.event_type = 'REQH'
                                                                                                                                                                                                                        AND treq_time_requirement.type = 'OP'
                                                                                                                                                                                                                        AND treq_time_requirement.status = 0
		JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i=treq_interval_group.timerequirementno_i
		JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i=treq_dimension_group.interval_groupno_i
		JOIN treq_interval ON treq_interval.dimension_groupno_i=treq_dimension_group.dimension_groupno_i AND treq_interval.dimension_type IN ('I')
                    GROUP BY requirement_header.event_key
                   ) tc_interval ON msc_item.itemno_i=tc_interval.event_key 
    /*следующая инспекция*/                        
    LEFT JOIN ( SELECT          dblink3.event_key_parent,
                                    dblink3.event_type,
                                    dblink3.next_insp,
                                    dblink3.pending_status,
                                    dblink3.interval,
                                    dblink3.EVI,
                                    dblink3.ac_reg
                                    
                            FROM (        
                            SELECT  wo_event_link.event_key_parent,
                                    wo_event_link.event_type,
                                    ndate.next_insp,
                                    wo_event_link.pending_status,
                                    ninterval.interval,
                                    ndate.event_perfno_i as EVI,
                                    ndate.ac_registr AS ac_reg
                            FROM db_link
                            LEFT JOIN msc_taskcard_version ON TO_CHAR(db_link.source_pk) = TO_CHAR(msc_taskcard_version.taskcard_verno_i) 
                            LEFT JOIN msc_requirement_tc_link ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri
                            LEFT JOIN wo_event_link ON msc_requirement_tc_link.req_linkno_i = wo_event_link.event_key_parent
                            LEFT JOIN ( SELECT  forecast_dimension.event_perfno_i,
                                                forecast.ac_registr,
                                               LISTAGG( 	CASE  	WHEN   forecast_dimension.dimension = 'C' 
                                                              		THEN TO_CHAR(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC))||' '||forecast_dimension.dimension
                                                              		WHEN   forecast_dimension.dimension = 'D' 
                                                              		THEN to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( forecast_dimension.ABSOLUTE_DUE_AT_AC+729), 'dd.mm.yyyy')||' '||forecast_dimension.dimension
                                                        	    		ELSE TO_CHAR(FLOOR (TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC)/60))||':'
                                                                   		||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC), 60)))&lt;10
                                                                   		THEN '0'||(TO_CHAR(MOD(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC), 60)))||' '||forecast_dimension.dimension
                                                                   		ELSE (TO_CHAR(MOD(TO_NUMBER(forecast_dimension.ABSOLUTE_DUE_AT_AC), 60)))||' '||forecast_dimension.dimension
                                                                   		END
                                                        		END, '/')   WITHIN GROUP(ORDER BY forecast_dimension.COUNTER_DEFNO_I) AS next_insp
                                        		FROM forecast_dimension 
                                                LEFT JOIN forecast ON forecast_dimension.event_perfno_i = forecast.event_perfno_i 
                                        		GROUP BY forecast_dimension.event_perfno_i,  forecast.ac_registr
                                     		) ndate ON wo_event_link.event_perfno_i = ndate.event_perfno_i   
                            LEFT JOIN (	SELECT forecast_dimension.event_perfno_i,
                                               		LISTAGG(TO_NUMBER(forecast_dimension.INTERVAL_VALUE)||' '||forecast_dimension.interval_dimension, '/') WITHIN GROUP(ORDER BY forecast_dimension.COUNTER_DEFNO_I) AS interval
                                        		FROM forecast_dimension
                                        		GROUP BY forecast_dimension.event_perfno_i) ninterval ON wo_event_link.event_perfno_i = ninterval.event_perfno_i 
                            			WHERE db_link.destination_type = 'WO'
                           			AND   db_link.source_type = 'TCLS'                                                                                                        
                         		) dblink3
                            WHERE dblink3.pending_status = '0' AND (dblink3.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%' OR dblink3.event_type = 'MET' AND '@AMOS_VERSION@' NOT LIKE '19.12%')
                        ) next_insp_table ON msc_requirement_tc_link.req_linkno_i =  next_insp_table.event_key_parent 
    LEFT JOIN wo_header woh2 ON next_insp_table.EVI = woh2.workorderno_display
    WHERE       db_link.destination_type = 'WO'
    AND         db_link.source_type = 'TCLS'
    AND         aircraft.status = '0'
    AND         next_insp_table.next_insp IS NOT NULL
    AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE( '@VAR.AC_TYPE@', ', ', '|')) OR '@VAR.AC_TYPE@' IS NULL)
    AND (REGEXP_LIKE(wo_header.ata_chapter, REPLACE('@VAR.ATA@', ', ', '|')) OR '@VAR.ATA@' IS NULL)
    AND (msc_taskcard.created_date &gt;= '@VAR.date1@' OR '@VAR.date1@' IS NULL)
    AND (msc_taskcard.created_date &lt;= '@VAR.date2@' OR '@VAR.date2@' IS NULL)
ORDER BY Task_no</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
