    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="142_RMX_CHECK__PART_REQ_INF" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno" id="msc_taskcard.taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_template.partno" id="part_request_template.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(part_request_template.qty) AS total_qty_for_TC" id="total_qty_for_TC"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;DECODE (part.mat_class 'C' 'Consumable'&#10;                        'E' 'Expendable'&#10;                        'R' 'Rotable'&#10;                        'S''Service') as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;DECODE (part.mat_type 'CONS' 'CONSUMABLES'&#10;                       'EQUI' 'EQUIPMENT'&#10;                       'FLMB' 'FLAMMABLE LIQUIDS'&#10;                       'GREA' 'SPECIAL GREASE'&#10;                       'KIT' 'KIT'&#10;                       'LIQU' 'SPECIAL LIQUIDS'                    &#10;                       'N' 'NON AIRCRAFT MATERIAL'&#10;                       'P' 'AIRCRAFT PART'&#10;                       'RM' 'RAW MATERIAL'&#10;                       'S' 'SERVICE'&#10;                       'SW' 'SOFTWARE'&#10;                       'T' 'TOOL'&#10;                       'ZSOD''SPECIAL PROTECTIVE EQUIPMENT') as mat_type" id="mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_mp_revision.revision_no" id="msc_mp_revision.revision_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.measure_unit" id="part.measure_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.reord_level AS Reorder_Level" id="Reorder_Level"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.max_purch AS Max_Purchase" id="Max_Purchase"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.alert_qty AS Alert_QTY" id="Alert_QTY"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.CHECK@">
          <ds:object>@VAR.CHECK@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.revisionno@">
          <ds:object>@VAR.revisionno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
msc_taskcard.taskcardno,
part_request_template.partno,

part.description,
SUM(part_request_template.qty) AS total_qty_for_TC,
DECODE (part.mat_class, 'C', 'Consumable',
                        'E', 'Expendable',
                        'R', 'Rotable',
                        'S', 'Service') as mat_class,
DECODE (part.mat_type, 'CONS', 'CONSUMABLES',
                       'EQUI', 'EQUIPMENT',
                       'FLMB', 'FLAMMABLE LIQUIDS',
                       'GREA', 'SPECIAL GREASE',
                       'KIT', 'KIT',
                       'LIQU', 'SPECIAL LIQUIDS',                    
                       'N', 'NON AIRCRAFT MATERIAL',
                       'P', 'AIRCRAFT PART',
                       'RM', 'RAW MATERIAL',
                       'S', 'SERVICE',
                       'SW', 'SOFTWARE',
                       'T', 'TOOL',
                       'ZSOD', 'SPECIAL PROTECTIVE EQUIPMENT') as mat_type,
msc_mp_revision.revision_no,
part.measure_unit,
part.reord_level AS Reorder_Level,
part.max_purch AS Max_Purchase,
part.alert_qty AS Alert_QTY
FROM check_type
JOIN check_type_int ON check_type.checkno_i = check_type_int.checkno_i
JOIN event_effectivity_link ON check_type_int.check_intno_i = event_effectivity_link.event_key AND event_effectivity_link.event_type = 'CHTI'
JOIN requirement_link ON event_effectivity_link.effectivity_linkno_i = requirement_link.target AND requirement_link.target_mimetype = 'EFL'
JOIN msc_requirement_tc_link ON requirement_link.source = msc_requirement_tc_link.req_linkno_i AND requirement_link.source_mimetype = 'TCREQLI'
JOIN msc_taskcard_version ON msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
LEFT JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i = msc_taskcard.taskcardno_i 
JOIN msc_operator_rev_req ON msc_requirement_tc_link.req_linkno_i = msc_operator_rev_req.req_linkno_i
JOIN msc_operator_revision ON msc_operator_revision.op_revisionno_i = msc_operator_rev_req.op_revisionno_i AND msc_operator_revision.revision_status = 'a'  
JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
join msc_maintenance_program on msc_taskcard.mpno_i=msc_maintenance_program.mpno_i AND msc_maintenance_program.program_type='MP'
join msc_requirement_tc_link on msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
join msc_mprev_taskcards ON msc_mprev_taskcards.taskcard_verno_i=msc_taskcard_version.taskcard_verno_i
join msc_mp_revision ON msc_mprev_taskcards.revisionno_i=msc_mp_revision.revisionno_i AND msc_mp_revision.revision_type='MP' AND msc_mp_revision.revision_status in ('a', 'b')
JOIN requirement_header ON msc_item.itemno_i = requirement_header.event_key AND requirement_header.event_type = 'TI'
JOIN worktemplate_link ON requirement_header.requirement_headerno_i = worktemplate_link.event_key AND worktemplate_link.event_type = 'REQH' 
JOIN event_template ON worktemplate_link.wtno_i = event_template.wtno_i AND event_template.revision_status = '1'
JOIN workstep_link ON event_template.event_perfno_i = workstep_link.event_perfno_i
JOIN part_request_template ON workstep_link.descno_i = part_request_template.event_key AND part_request_template.event_type = 'WS' AND part_request_template.partno IS NOT NULL
JOIN part ON part.partno = part_request_template.partno
WHERE 
check_type_int.check_intno_i =  '@VAR.CHECK@'  
and (REGEXP_LIKE(msc_mp_revision.revision_no, REPLACE('@VAR.revisionno@', ', ', '|')) OR '@VAR.revisionno@' IS NULL) 
GROUP BY 
msc_taskcard.taskcardno,
part_request_template.partno,
msc_mp_revision.revision_no,
part.description,
part.measure_unit,
part.mat_class,part.mat_type,
part.reord_level,
part.max_purch,
part.alert_qty
ORDER BY msc_taskcard.taskcardno,
part_request_template.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="INFO2" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno" id="msc_taskcard.taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_template.partno" id="part_request_template.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(part_request_template.qty) AS total_qty_for_TC" id="total_qty_for_TC"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;DECODE (part.mat_class 'C' 'Consumable'&#10;                        'E' 'Expendable'&#10;                        'R' 'Rotable'&#10;                        'S''Service') as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;DECODE (part.mat_type 'CONS' 'CONSUMABLES'&#10;                       'EQUI' 'EQUIPMENT'&#10;                       'FLMB' 'FLAMMABLE LIQUIDS'&#10;                       'GREA' 'SPECIAL GREASE'&#10;                       'KIT' 'KIT'&#10;                       'LIQU' 'SPECIAL LIQUIDS'                    &#10;                       'N' 'NON AIRCRAFT MATERIAL'&#10;                       'P' 'AIRCRAFT PART'&#10;                       'RM' 'RAW MATERIAL'&#10;                       'S' 'SERVICE'&#10;                       'SW' 'SOFTWARE'&#10;                       'T' 'TOOL'&#10;                       'ZSOD''SPECIAL PROTECTIVE EQUIPMENT') as mat_type" id="mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.measure_unit" id="part.measure_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.reord_level AS Reorder_Level" id="Reorder_Level"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.max_purch AS Max_Purchase" id="Max_Purchase"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.alert_qty AS Alert_QTY" id="Alert_QTY"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part3.altpartno AS Alt_Partno" id="Alt_Partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part3.reord_level AS Alt_Reorder_Level" id="Alt_Reorder_Level"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part3.max_purch AS Alt_Max_Purchase" id="Alt_Max_Purchase"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part3.alert_qty AS Alt_Alert_QTY" id="Alt_Alert_QTY"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.CHECK@">
          <ds:object>@VAR.CHECK@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.revisionno@">
          <ds:object>@VAR.revisionno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
msc_taskcard.taskcardno,
part_request_template.partno,
part.description,
SUM(part_request_template.qty) AS total_qty_for_TC,
DECODE (part.mat_class, 'C', 'Consumable',
                        'E', 'Expendable',
                        'R', 'Rotable',
                        'S', 'Service') as mat_class,
DECODE (part.mat_type, 'CONS', 'CONSUMABLES',
                       'EQUI', 'EQUIPMENT',
                       'FLMB', 'FLAMMABLE LIQUIDS',
                       'GREA', 'SPECIAL GREASE',
                       'KIT', 'KIT',
                       'LIQU', 'SPECIAL LIQUIDS',                    
                       'N', 'NON AIRCRAFT MATERIAL',
                       'P', 'AIRCRAFT PART',
                       'RM', 'RAW MATERIAL',
                       'S', 'SERVICE',
                       'SW', 'SOFTWARE',
                       'T', 'TOOL',
                       'ZSOD', 'SPECIAL PROTECTIVE EQUIPMENT') as mat_type,
part.measure_unit,
part.reord_level AS Reorder_Level,
part.max_purch AS Max_Purchase,
part.alert_qty AS Alert_QTY,
part3.altpartno AS Alt_Partno,
part3.reord_level AS Alt_Reorder_Level,
part3.max_purch AS Alt_Max_Purchase,
part3.alert_qty AS Alt_Alert_QTY 
FROM check_type
JOIN check_type_int ON check_type.checkno_i = check_type_int.checkno_i
JOIN event_effectivity_link ON check_type_int.check_intno_i = event_effectivity_link.event_key AND event_effectivity_link.event_type = 'CHTI'
JOIN requirement_link ON event_effectivity_link.effectivity_linkno_i = requirement_link.target AND requirement_link.target_mimetype = 'EFL'
JOIN msc_requirement_tc_link ON requirement_link.source = msc_requirement_tc_link.req_linkno_i AND requirement_link.source_mimetype = 'TCREQLI'
JOIN msc_taskcard_version ON msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
LEFT JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i = msc_taskcard.taskcardno_i 
JOIN msc_operator_rev_req ON msc_requirement_tc_link.req_linkno_i = msc_operator_rev_req.req_linkno_i
JOIN msc_operator_revision ON msc_operator_revision.op_revisionno_i = msc_operator_rev_req.op_revisionno_i AND msc_operator_revision.revision_status = 'a'  
join msc_maintenance_program on msc_taskcard.mpno_i=msc_maintenance_program.mpno_i AND msc_maintenance_program.program_type='MP'
join msc_requirement_tc_link on msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
join msc_mprev_taskcards ON msc_mprev_taskcards.taskcard_verno_i=msc_taskcard_version.taskcard_verno_i
join msc_mp_revision ON msc_mprev_taskcards.revisionno_i=msc_mp_revision.revisionno_i AND msc_mp_revision.revision_type='MP' AND msc_mp_revision.revision_status in ('a', 'b')
JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
JOIN requirement_header ON msc_item.itemno_i = requirement_header.event_key AND requirement_header.event_type = 'TI'
JOIN worktemplate_link ON requirement_header.requirement_headerno_i = worktemplate_link.event_key AND worktemplate_link.event_type = 'REQH' 
JOIN event_template ON worktemplate_link.wtno_i = event_template.wtno_i AND event_template.revision_status = '1'
JOIN workstep_link ON event_template.event_perfno_i = workstep_link.event_perfno_i
JOIN part_request_template ON workstep_link.descno_i = part_request_template.event_key AND part_request_template.event_type = 'WS' AND part_request_template.partno IS NOT NULL
JOIN part ON part.partno = part_request_template.partno
LEFT JOIN
            (
                    SELECT 
                                part_alternate.partno AS partno
                                ,part_alternate.altpartno AS altpartno
                                ,part2.reord_level AS reord_level
                                ,part2.max_purch AS max_purch
                                ,part2.alert_qty AS alert_qty
                    FROM part_alternate
                    LEFT JOIN 
                                (
                                    SELECT 
                                            part.partno
                                            ,part.reord_level
                                            ,part.max_purch
                                            ,part.alert_qty
                                    FROM part
                                ) part2 ON part_alternate.altpartno = part2.partno
                    WHERE 
                            (
                                part2.reord_level &lt;&gt; 0 OR
                                part2.max_purch &lt;&gt; 0 OR
                                part2.alert_qty &lt;&gt; 0
                            )
            ) part3 ON part.partno = part3.partno 
WHERE 
check_type_int.check_intno_i = '@VAR.CHECK@' 
and (REGEXP_LIKE(msc_mp_revision.revision_no, REPLACE('@VAR.revisionno@', ', ', '|')) OR '@VAR.revisionno@' IS NULL) 
GROUP BY 
msc_taskcard.taskcardno,
part_request_template.partno,
part.description,
part.measure_unit,
part.mat_class,
part.mat_type,
part.reord_level,
part.max_purch,
part.alert_qty,
part3.altpartno,
part3.reord_level,
part3.max_purch,
part3.alert_qty
ORDER BY msc_taskcard.taskcardno,
        part_request_template.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
