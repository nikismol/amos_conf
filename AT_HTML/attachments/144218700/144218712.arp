  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="PA" description="" id="pns"/>
        <ds:columnDescriptor amosType="BOOL" description="" id="alt"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Part Number" id="pns">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Отобразить alt. part number" id="alt">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_PNs_With_mfg_date" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="pns.partno" id="pns.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pns.serialno" id="pns.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pns.mfg_date" id="pns.mfg_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pns.ac_registr" id="pns.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pns.status" id="pns.status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pns.location" id="pns.location"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.pns@">
          <ds:object>@VAR.pns@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select 
    pns.partno
    ,pns.serialno
    ,pns.mfg_date
    ,pns.ac_registr
    ,pns.status
    ,pns.location
from(
SELECT DISTINCT r.partno,
       	            r.serialno,
       CASE 
            WHEN r.mfg_unknown = 'Y' THEN 'UNKNOWN'
            WHEN r.mfg_date = '0' THEN 'UNKNOWN'
            ELSE to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (r.mfg_date + 729),'dd.mm.yyyy') 
        END as mfg_date
        ,r.ac_registr
        ,case 
            when r.ac_registr is not null and aircraft.status = 9 then 'Inactive'
            when r.ac_registr is not null and aircraft.status = 0 then 'Active'
            else ' '
        end status
        ,case 
            when location.locationno_i = -1 then 'Aircraft'
            when location.locationno_i = -4 then 'Tree'
            when location.locationno_i = -200 then 'External'
            when location.locationno_i = -3 then 'Services'
            when location.locationno_i = -5 then 'En_Route'
            when location.locationno_i = -13 then 'Entity-Trans'
            else location.location
        end location
FROM rotables r
left join (
    select 
        locationno_i
        ,LISTAGG( station||'-'|| store || '-' || location) WITHIN GROUP (ORDER BY locationno_i) as location 
    from location 
    group by locationno_i
) location on r.locationno_i = location.locationno_i
left join aircraft on r.ac_registr = aircraft.ac_registr
WHERE (REGEXP_LIKE( r.partno, REPLACE('@VAR.pns@', ', ', '|')) OR  '@VAR.pns@' IS NULL)
UNION
SELECT DISTINCT r.partno,
       	            r.serialno,
       CASE 
            WHEN r.mfg_unknown = 'Y' THEN 'UNKNOWN'
            WHEN r.mfg_date = '0' THEN 'UNKNOWN'
            ELSE to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (r.mfg_date + 729),'dd.mm.yyyy') 
        END as mfg_date
        ,r.ac_registr
        ,case 
            when r.ac_registr is not null and aircraft.status = 9 then 'Inactive'
            when r.ac_registr is not null and aircraft.status = 0 then 'Active'
            else ' '
        end status
        ,case 
            when location.locationno_i = -1 then 'Aircraft'
            when location.locationno_i = -4 then 'Tree'
            when location.locationno_i = -200 then 'External'
            when location.locationno_i = -3 then 'Services'
            when location.locationno_i = -5 then 'En_Route'
            when location.locationno_i = -13 then 'Entity-Trans'
            else location.location
        end location
FROM part_alternate alt
LEFT JOIN rotables r ON alt.altpartno = r.partno
left join (
    select 
        locationno_i
        ,LISTAGG( station||'-'|| store || '-' || location) WITHIN GROUP (ORDER BY locationno_i) as location 
    from location 
    group by locationno_i
) location on r.locationno_i = location.locationno_i
left join aircraft on r.ac_registr = aircraft.ac_registr
WHERE (REGEXP_LIKE( alt.partno, REPLACE('@VAR.pns@', ', ', '|')) OR  '@VAR.pns@' IS NULL)
) pns
order by partno, serialno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
