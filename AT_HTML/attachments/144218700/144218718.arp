      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="227_Finding_WO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Данные по нормам на запчасти</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_typ" id="a.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when el.event_type = 'TCREQLI'&#10;            then event_name &#10;       else ''&#10;        end taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mt.tc_type" id="mt.tc_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case&#10;            when el.event_type = 'CHTI'&#10;                then cti.internal_check&#10;            else ''&#10;        end chek" id="chek"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.event_perfno_i finding_wo" id="finding_wo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.partno" id="pr.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.description" id="p.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case&#10;            when p.mat_class = 'R' then 'Rotable'&#10;            when p.mat_class = 'C' then 'Consumable'&#10;            when p.mat_class = 'E' then 'Expendable'&#10;            when p.mat_class = 'S' then 'Service'&#10;            else p.mat_class&#10;        end  ma_class" id="ma_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.list" id="sd.list"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.station" id="sd.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.store" id="sd.store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.qty" id="pr.qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sd.ideal_qty" id="sd.ideal_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.reord_level" id="p.reord_level"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.task@">
          <ds:object>@VAR.task@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.wo@">
          <ds:object>@VAR.wo@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select a.ac_typ
     , case
            when el.event_type = 'TCREQLI' 
                then wel.event_name
            else ''
        end taskcardno
     , mt.tc_type
     , case
            when el.event_type = 'CHTI'
                then cti.internal_check
            else ''
        end chek
     , ef.event_perfno_i finding_wo
     , pr.partno
     , p.description
     , case
            when p.mat_class = 'R' then 'Rotable'
            when p.mat_class = 'C' then 'Consumable'
            when p.mat_class = 'E' then 'Expendable'
            when p.mat_class = 'S' then 'Service'
            else p.mat_class
        end  ma_class            
     , sd.list
     , sd.station
     , sd.store
     , pr.qty
     , sd.ideal_qty
     , p.reord_level
from wo_header wh 
join aircraft a on wh.ac_registr = a.ac_registr
join event_finding ef on wh.event_perfno_i = ef.primkey
left join event_effectivity_link el on el.effectivity_linkno_i = ef.headerno_i and ef.header_type = 'EFL'
left join check_type_int cti on cti.check_intno_i = el.event_key
join wo_event_link wel on wel.event_perfno_i = wh.event_perfno_i
left join msc_requirement_tc_link mrtl on wel.event_key_parent = mrtl.req_linkno_i
left join msc_taskcard_version mtv on mtv.taskcard_verno_i = mrtl.taskcard_verno_i_mri
left join msc_taskcard mt on mt.taskcardno_i = mtv.taskcardno_i 
join (
        select 
            wsl.event_perfno_i
            ,pr2.confirmed_qty AS qty
            ,pr2.partno
        from workstep_link wsl
        join part_request_2 pr2 on wsl.workstep_linkno_i = pr2.event_key 
    ) pr on ef.event_perfno_i = pr.event_perfno_i
join part p on p.partno = pr.partno
left join (
        select 
            sd.partno
            , sd.list
            , sh.station
            , sh.store
            , round(ps.qty, 0) qty
            , sd.ideal_qty
            , sd.reorder_level
        from spa_detail sd
        join spa_header sh on sd.list = sh.name
        join part_station ps on sh.station = ps.station and ps.store = sh.store and ps.partno = sd.partno
        left join part_fa_entity pfe on sd.partno = pfe.partno and pfe.entityno_i = 1 
        where ps.status = 2
            and sh.status = 1
      ) sd on sd.partno = p.partno
where ef.type = 'WO'
    and (regexp_like(a.ac_typ, replace('@VAR.ac_typ@', ', ', '|')) or '@VAR.ac_typ@' is null)
    and (regexp_like(mt.taskcardno, replace('@VAR.task@', ', ', '|')) or '@VAR.task@' is null)
    and (regexp_like(wh.event_perfno_i, replace('@VAR.wo@', ', ', '|')) or '@VAR.wo@' is null)
    and (regexp_like(p.partno, replace('@VAR.partno@', ', ', '|')) or '@VAR.partno@' is null)
order by wel.event_name
        , cti.internal_check
        , ef.event_perfno_i
        , p.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
