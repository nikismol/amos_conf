              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_ENG_ALL_PARTS_ON_AC_POSITION" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>RMX_ENG_ALL_PARTS_ON_AC_POSITION</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_registr" id="aircraft.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.partno" id="rotables.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.serialno" id="rotables.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.condition" id="rotables.condition"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.location" id="rotables.location"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_REGISTR@">
          <ds:object>@VAR.AC_REGISTR@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
	aircraft.ac_registr, 
	rotables.partno,
	rotables.serialno, 
	rotables.condition,
	part.description, 
	rotables.location 
FROM aircraft
	LEFT JOIN rotables on rotables.ac_registr = aircraft.ac_registr
	LEFT JOIN part on rotables.partno = part.partno
WHERE aircraft.ac_registr = '@VAR.AC_REGISTR@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
