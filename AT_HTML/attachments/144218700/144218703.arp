  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="AC" description="AC" id="AC"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Введите номер борта:" id="AC">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="EVENT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="AC" description="forecast.ac_registr" id="forecast.ac_registr"/>
        <ds:columnDescriptor amosType="AT" description="forecast.ac_typ" id="forecast.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.event" id="forecast.event"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.event_display" id="forecast.event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.dimension" id="forecast.dimension"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.interval_value" id="forecast.interval_value"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.interval_dimension" id="forecast.interval_dimension"/>
        <ds:columnDescriptor amosType="DATE" description="forecast.expected_date" id="forecast.expected_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="treq_baseline.based_on" id="treq_baseline.based_on"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.mfg_date" id="aircraft.mfg_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC@">
          <ds:object>@VAR.AC@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AC@">
          <ds:object>@AC@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>Select 
forecast.ac_registr,
forecast.ac_typ,
forecast.event,
forecast.event_display,
forecast.dimension,
forecast.interval_value,
forecast.interval_dimension,
forecast.expected_date,
treq_baseline.based_on,
aircraft.mfg_date

FROM Forecast
LEFT JOIN aircraft ON forecast.ac_registr = aircraft.ac_registr
LEFT JOIN wo_event_link ON wo_event_link.event_perfno_i = forecast.event_perfno_i 
LEFT JOIN msc_requirement_tc_link ON  msc_requirement_tc_link.req_linkno_i=wo_event_link.event_key_parent
LEFT JOIN msc_taskcard_version ON msc_taskcard_version.taskcard_verno_i = msc_requirement_tc_link.taskcard_verno_i_mri
LEFT JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i = msc_taskcard.taskcardno_i
LEFT JOIN treq_time_requirement ON msc_taskcard_version.taskcard_verno_i = treq_time_requirement.event_key
LEFT JOIN treq_interval_group ON treq_time_requirement.timerequirementno_i = treq_interval_group.timerequirementno_i
LEFT JOIN treq_interval ON treq_interval_group.interval_groupno_i = treq_interval.interval_groupno_i
LEFT JOIN treq_baseline ON treq_interval.intervalno_i = treq_baseline.intervalno_i
LEFT JOIN msc_maintenance_program ON msc_maintenance_program.mpno = aircraft.ac_typ
LEFT JOIN msc_operator_rev_req ON msc_taskcard.taskcardno_i = msc_operator_rev_req.taskcardno_i
LEFT JOIN msc_operator_revision ON msc_operator_rev_req.op_revisionno_i = msc_operator_revision.op_revisionno_i


WHERE
wo_event_link.pending_status = '0'
and msc_operator_revision.revision_status = 'a'
and treq_interval_group.threshold = 'Y'
and forecast.counter_defno_i = '3'
and treq_baseline.based_on = 'M'
and treq_time_requirement.event_type = 'TCREV'
and msc_maintenance_program.status = '1'
and (REGEXP_LIKE(aircraft.ac_registr, REPLACE( '@VAR.AC@', ', ', '|')) OR '@AC@' IS NULL)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
