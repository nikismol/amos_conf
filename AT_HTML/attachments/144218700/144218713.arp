            <attribute name="visible">YES</attribute>
            <attribute name="auto-resize">YES</attribute>
            <attribute name="rotation">0.0</attribute>
            <conditional_attributes/>
            <attribute name="color">000000</attribute>
            <attribute name="margin">0 0 0 0</attribute>
            <attribute name="padding">2 0 0 0</attribute>
            <attribute name="border">1 SOLID 000000</attribute>
            <attribute name="text">@ORDER.Department@</attribute>
            <attribute name="text-decoration">NONE</attribute>
            <attribute name="font">SansSerif PLAIN 10</attribute>
            <attribute name="text-align">LEFT</attribute>
            <attribute name="line-break">AS_IS</attribute>
            <attribute name="splitable">NO</attribute>
            <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
            <attribute name="antialias">false</attribute>
          </view>
        </column>
      </column_model>
      <attribute name="data-source">ORDER</attribute>
      <anchor>
        <location>TOP_LEFT</location>
        <anchor_view>271</anchor_view>
        <anchor_location>BOTTOM_LEFT</anchor_location>
        <x_offset>0</x_offset>
        <y_offset>0</y_offset>
      </anchor>
    </view>
  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="ORDER"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="STATUS"/>
        <ds:columnDescriptor amosType="PA" description="" id="PARTNO"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="3.Order Status:" id="ORDER">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>OPEN&amp;=&amp;OPEN;HISTORY&amp;=&amp;HISTORY;ALL&amp;=&amp;ALL;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>OPEN</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="2.Request Status:" id="STATUS">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>OPEN&amp;=&amp;OPEN;HISTORY&amp;=&amp;HISTORY;ALL&amp;=&amp;ALL;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>OPEN</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="1.Part Number" id="PARTNO">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="REQUEST" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.workorderno_display" id="wo_header.workorderno_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link.sequenceno" id="workstep_link.sequenceno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_forecast.display_event_type as event_typ" id="event_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.event_type" id="part_request_2.event_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_forecast.event_display as event_display" id="event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wt.wtno_i" id="wt.wtno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wt.template_revisionno_i" id="wt.template_revisionno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.part_requestno_i" id="part_request_2.part_requestno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.created_by AS CREATED_BY" id="CREATED_BY"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname||' '||sign.lastname AS Name" id="Name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.department||' '||department.description AS Department" id="Department"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as part_description" id="part_description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE(part.mat_type 'CONS' 'CONSUMABLES'&#10;                                    'EQUI' 'EQUIPMENT'&#10;                                    'FLMB' 'FLAMMABLE LIQUIDS'&#10;                                    'GREA' 'SPECIAL GREASE'&#10;                                    'KIT' 'KIT'&#10;                                    'LIQU' 'SPECIAL LIQUIDS'&#10;                                    'N' 'NON AIRCRAFT MATERIAL'&#10;                                    'P' 'AIRCRAFT PART'&#10;                                    'RM' 'RAW MATERIAL'&#10;                                    'S' 'SERVICE'&#10;                                    'SW' 'SOFTWARE'&#10;                                    'T' 'TOOL'&#10;                                    'ZSOD''SPECIAL PROTECTIVE EQUIPMENT') as mat_type" id="mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DDMMYYYY') + (forecast.expected_date + 729)'DD.MM.YYYY') as expected_date" id="expected_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN forecast.date_planned IS NULL OR forecast.date_planned=0 THEN '' ELSE TO_CHAR(TO_DATE('01.01.1970' 'DDMMYYYY') + (forecast.date_planned + 729)'DD.MM.YYYY') END as date_planned" id="date_planned"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DDMMYYYY') + (part_request_2.created_date + 729)'DD.MM.YYYY') as part_request_date" id="part_request_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DDMMYYYY') + (part_request_2.mutation + 729)'DD.MM.YYYY') as part_request_mutation_date" id="part_request_mutation_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.qty as part_request_qty" id="part_request_qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.PARTNO@">
          <ds:object>@VAR.PARTNO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.STATUS@">
          <ds:object>@VAR.STATUS@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    wo_header.ac_registr as ac_registr
    ,wo_header.event_perfno_i as event_perfno_i
    ,wo_header.workorderno_display
    ,workstep_link.sequenceno 
    ,part_forecast.display_event_type as event_typ
    ,part_request_2.event_type
    ,part_forecast.event_display as event_display
    ,wt.wtno_i
    ,wt.template_revisionno_i
    ,part_request_2.partno as partno
    ,part_request_2.part_requestno_i
    ,part_request_2.created_by AS CREATED_BY
    ,sign.firstname||' '||sign.lastname AS Name
    ,sign.department||' '||department.description AS Department
    ,part.description as part_description
    ,DECODE(part.mat_type, 'CONS', 'CONSUMABLES',
                           'EQUI', 'EQUIPMENT',
                           'FLMB', 'FLAMMABLE LIQUIDS',
                           'GREA', 'SPECIAL GREASE',
                           'KIT', 'KIT',
                           'LIQU', 'SPECIAL LIQUIDS',
                           'N', 'NON AIRCRAFT MATERIAL',
                           'P', 'AIRCRAFT PART',
                           'RM', 'RAW MATERIAL',
                           'S', 'SERVICE',
                           'SW', 'SOFTWARE',
                           'T', 'TOOL',
                           'ZSOD', 'SPECIAL PROTECTIVE EQUIPMENT') as mat_type
    ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (forecast.expected_date + 729), 'DD.MM.YYYY') as expected_date
    ,CASE WHEN forecast.date_planned IS NULL OR forecast.date_planned=0 THEN '' ELSE TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (forecast.date_planned + 729), 'DD.MM.YYYY') END as date_planned
    ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (part_request_2.created_date + 729), 'DD.MM.YYYY') as part_request_date
    ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (part_request_2.mutation + 729), 'DD.MM.YYYY') as part_request_mutation_date
    ,part_request_2.qty as part_request_qty
FROM wo_header
LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key 
LEFT JOIN sign ON part_request_2.created_by = sign.user_sign
LEFT JOIN department ON sign.department = department.department
LEFT JOIN part ON part_request_2.partno=part.partno
LEFT JOIN part_forecast ON part_request_2.part_requestno_i=part_forecast.part_requestno_i
LEFT JOIN allocation_link ON allocation_link.source_key=part_request_2.part_requestno_i AND allocation_link.source_type = 'PARTRQST'
LEFT JOIN forecast ON wo_header.event_perfno_i=forecast.event_perfno_i
LEFT JOIN (
    SELECT distinct
        event_perfno_i
        ,wtno_i
        ,template_revisionno_i
        ,pending_status
    FROM (
        (
            SELECT 
                wo_event_link.event_perfno_i
                ,worktemplate_link.template_linkno_i
                ,worktemplate_link.wtno_i
                ,event_template.template_revisionno_i
                ,wo_event_link.pending_status
            FROM wo_event_link 
            JOIN msc_requirement_tc_link ON wo_event_link.event_key_parent = msc_requirement_tc_link.req_linkno_i AND (wo_event_link.event_type = 'TCEFFLI')
            JOIN requirement_header ON msc_requirement_tc_link.itemno_i_mri=requirement_header.event_key AND requirement_header.event_type = 'TI'
            JOIN worktemplate_link ON worktemplate_link.event_key = requirement_header.requirement_headerno_i AND worktemplate_link.event_type IN ('REQH')
            JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i AND event_template.revision_status IN (1,0) AND event_template.status = 0 
            where wo_event_link.event_type&lt;&gt;'DOC_EFF'
        )
    UNION
        (
            SELECT 
                wo_event_link.event_perfno_i
                ,worktemplate_link.template_linkno_i
                ,worktemplate_link.wtno_i
                ,event_template.template_revisionno_i
                ,wo_event_link.pending_status
            FROM worktemplate_link
            LEFT JOIN work_template ON worktemplate_link.wtno_i = work_template.wtno_i
            JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i AND event_template.revision_status IN (1,0) AND event_template.status = 0 
            LEFT JOIN event_effectivity_link ON worktemplate_link.event_key = event_effectivity_link.effectivity_linkno_i AND worktemplate_link.event_type='EFL'
            LEFT JOIN doc_header ON event_effectivity_link.event_key=doc_header.docno_i AND event_effectivity_link.event_type = 'DO'
            JOIN wo_event_link  on wo_event_link.event_key_parent=doc_header.docno_i
            where wo_event_link.event_type&lt;&gt;'TCEFFLI'
    ))
) wt on wo_header.event_perfno_i=wt.event_perfno_i
WHERE 1=1 
    AND (REGEXP_LIKE(part_request_2.partno, REPLACE('@VAR.PARTNO@', ', ', '|')) OR '@VAR.PARTNO@' IS NULL)
    AND (('@VAR.STATUS@' = 'OPEN' AND part_request_2.status = '0') OR 
        ('@VAR.STATUS@' = 'HISTORY' AND part_request_2.status IN ('1', '2', '3')) OR
        ('@VAR.STATUS@' = 'ALL'))
ORDER BY part_request_2.partno </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="ORDER" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno AS OrderNumber" id="OrderNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.ext_state AS OrderStatus" id="OrderStatus"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderdate AS OrderDate" id="OrderDate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.partno AS PartNumber" id="PartNumber"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description AS PartDescription" id="PartDescription"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(od_detail.qty) AS QTY" id="QTY"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.created_by" id="od_header.created_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname||' '||sign.lastname AS Name" id="Name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.department||' '||department.description AS Department" id="Department"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.PARTNO@">
          <ds:object>@VAR.PARTNO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ORDER@">
          <ds:object>@VAR.ORDER@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
		od_header.orderno AS OrderNumber
		,od_header.ext_state AS OrderStatus
		,to_char(to_date('31.12.1971', 'dd.mm.yyyy') + od_header.orderdate,'dd.mm.yyyy') AS OrderDate
		,od_detail.partno AS PartNumber
		,part.description AS PartDescription
		,TO_NUMBER(od_detail.qty) AS QTY
		,od_header.created_by
		,sign.firstname||' '||sign.lastname AS Name
		,sign.department||' '||department.description AS Department
FROM od_header
LEFT JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
LEFT JOIN part ON od_detail.partno = part.partno
LEFT JOIN sign ON od_header.created_by = sign.user_sign
LEFT JOIN department ON sign.department = department.department
WHERE 
(REGEXP_LIKE(od_detail.partno, REPLACE('@VAR.PARTNO@', ', ', '|')) OR '@VAR.PARTNO@' IS NULL)
AND od_header.order_type IN ('P', 'R')
AND 
((od_detail.ext_state = 'O' AND '@VAR.ORDER@' = 'OPEN') OR
(od_detail.ext_state = 'C' AND '@VAR.ORDER@' = 'HISTORY') OR
('@VAR.ORDER@' = 'ALL'))  
ORDER BY od_header.orderno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
