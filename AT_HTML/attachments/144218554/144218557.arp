  <content/>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="Для печати тэга для оприходования выберите &quot;Receiving&quot;." id="print_type"/>
        <ds:columnDescriptor amosType="LB" description="" id="labelno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Print type" id="print_type">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>yeya&amp;=&amp;Removal/Installation/Receiving;b1&amp;=&amp;Receiving;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>yeya</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Label No" id="labelno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>16077</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Label_history" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.voucherno as vn" id="vn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno as pn" id="pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno as sn" id="sn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as pdesc" id="pdesc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ as pactyp" id="pactyp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date + 729)'DD.MM.YYYY') as hdate" id="hdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.qty as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="condition.description as cdesc" id="cdesc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.recdetailno_i as recd" id="recd"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.labelno@">
          <ds:object>@VAR.labelno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT
history.voucherno as vn,
history.partno as pn,
history.serialno as sn,
part.description as pdesc,
part.ac_typ as pactyp,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date + 729), 'DD.MM.YYYY') as hdate,
history.qty as qty,
condition.description as cdesc,
history.recdetailno_i as recd

FROM 
history
LEFT JOIN part ON part.partno = history.partno
LEFT JOIN rotables ON history.psn = rotables.psn
LEFT JOIN condition ON condition.condition = history.condition

WHERE
history.labelno = '@VAR.labelno@'
AND history.vm = 'B1'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Label_certificate" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="certificate.certificate_number as certno" id="certno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="certificate.workorder as certwo" id="certwo"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.labelno@">
          <ds:object>@VAR.labelno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
certificate.certificate_number as certno,
certificate_data.workorder as certwo
FROM 

history 

LEFT JOIN certificate ON certificate.source_type = 'RD' AND certificate.source_key = history.recdetailno_i

LEFT JOIN certificate_data ON certificate_data.certificate_i = certificate.certificate_i



WHERE
history.labelno = '@VAR.labelno@'
AND history.vm = 'B1'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Label_serviceable" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.vm" id="history.vm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.psn" id="history.psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.voucherno as vn" id="vn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN (p_spec.cnt&gt;0) THEN part.partno ELSE part.specification END as pn" id="pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno as sn" id="sn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN (p_lngpn.cnt&gt;0) THEN part_description.text ELSE part.description END as pdesc" id="pdesc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ as pactyp" id="pactyp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date + 729)'DD.MM.YYYY') as hdate" id="hdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.qty as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="condition.description as cdesc" id="cdesc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.recdetailno_i as recd" id="recd"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.event_perfno_i as wonum" id="wonum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;CASE WHEN (rotables.mfg_unknown = 'Y') THEN 'UNK' ELSE TO_CHAR(TO_DATE('01.01.1970''DD.MM.YYYY') + (rotables.mfg_date + 729)) END as mfg_date" id="mfg_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(counter_h.life_value/60'999999999999.99') as ch_val" id="ch_val"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(counter_c.life_value'99999999999999999') as cc_val" id="cc_val"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.print_type@">
          <ds:object>@VAR.print_type@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.labelno@">
          <ds:object>@VAR.labelno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT
history.vm,
history.psn,
history.voucherno as vn,
CASE WHEN (p_spec.cnt&gt;0) THEN part.partno ELSE part.specification END as pn,
history.serialno as sn,
CASE WHEN (p_lngpn.cnt&gt;0) THEN part_description.text ELSE part.description END as pdesc,
part.ac_typ as pactyp,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date + 729), 'DD.MM.YYYY') as hdate,
history.qty as qty,
condition.description as cdesc,
history.recdetailno_i as recd,
history.event_perfno_i as wonum,
CASE WHEN (rotables.mfg_unknown = 'Y') THEN 'UNK' ELSE TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (rotables.mfg_date + 729)) END as mfg_date,
CASE WHEN (counter_h.unkn = 'Y') THEN 'UNK' ELSE TO_CHAR(counter_h.life_value/60, '999999999999.99')|| ' hours' END as ch_val,
CASE WHEN (counter_c.unkn = 'Y') THEN 'UNK' ELSE TO_CHAR(counter_c.life_value, '99999999999999999')||' cycles' END as cc_val
FROM 
history
LEFT JOIN part ON part.partno = history.partno
LEFT JOIN rotables ON history.psn = rotables.psn
LEFT JOIN condition ON condition.condition = history.condition
LEFT JOIN (
	SELECT count(*) as cnt, partno FROM part_special WHERE special='SPEC' GROUP BY partno
) p_spec ON p_spec.partno = part.partno
LEFT JOIN (
	SELECT count(*) as cnt, partno FROM part_special WHERE special='LNG_PN' GROUP BY partno
) p_lngpn ON p_lngpn.partno = part.partno
LEFT JOIN part_description ON part.partseqno_i = part_description.partseqno_i
LEFT JOIN inspection_detail ON inspection_detail.source_type = 'RD' AND inspection_detail.source_key = history.recdetailno_i
LEFT JOIN (
	SELECT counter_value.life_value as life_value, counter.is_unknown as unkn, counter.ref_key as psn, counter_value.readout_ref_type as rtype, counter_value.readout_ref_key as rkey 
  FROM counter
	LEFT JOIN counter_value  ON counter.counterno_i = counter_value.counterno_i
	LEFT JOIN counter_template ON counter_template.counter_templateno_i = counter.counter_templateno_i
	LEFT JOIN counter_definition ON counter_template.counter_defno_i = counter_definition.counter_defno_i
	WHERE
  counter_definition.code = 'H'
  AND counter.ref_type = 'RO'
) counter_h ON counter_h.psn = rotables.psn
AND 
(
	('@VAR.print_type@' = 'B1' OR (SELECT count(*) FROM history WHERE history.labelno = '@VAR.labelno@' AND history.vm ='YE') = 0)
	AND counter_h.rtype = 'ID' 
	AND counter_h.rkey = inspection_detail.inspection_detailno_i
) OR (
	'@VAR.print_type@' != 'B1'
	AND counter_h.rtype = 'LB' 
	AND counter_h.rkey = '@VAR.labelno@'
)
LEFT JOIN (
	SELECT counter_value.life_value as life_value, counter.is_unknown as unkn, counter.ref_key as psn, counter_value.readout_ref_type as rtype, counter_value.readout_ref_key as rkey 
  FROM counter
	LEFT JOIN counter_value  ON counter.counterno_i = counter_value.counterno_i
	LEFT JOIN counter_template ON counter_template.counter_templateno_i = counter.counter_templateno_i
	LEFT JOIN counter_definition ON counter_template.counter_defno_i = counter_definition.counter_defno_i
	WHERE
  counter_definition.code = 'C'
  AND counter.ref_type = 'RO'
) counter_c ON counter_c.psn = rotables.psn
AND 
(
	('@VAR.print_type@' = 'B1' OR (SELECT count(*) FROM history WHERE history.labelno = '@VAR.labelno@' AND history.vm ='YE') = 0)
	AND counter_c.rtype = 'ID' 
	AND counter_c.rkey = inspection_detail.inspection_detailno_i
) OR (
	'@VAR.print_type@' != 'B1'
	AND counter_c.rtype = 'LB' 
	AND counter_c.rkey = '@VAR.labelno@'
)
WHERE
history.labelno = '@VAR.labelno@'
AND (
	(history.vm = 'YE' AND '@VAR.print_type@' != 'B1')
	OR
	(history.vm = 'B1' AND 
		('@VAR.print_type@' = 'B1' 
			OR (SELECT count(*) FROM history WHERE history.labelno = '@VAR.labelno@' AND history.vm ='YE') = 0
		)
	)
)
AND counter_h.psn = rotables.psn
AND counter_c.psn = rotables.psn</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Label_unserviceable" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.voucherno as vn" id="vn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno as pn" id="pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.station as removal_station" id="removal_station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno as pn" id="pn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno as sn" id="sn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as pdesc" id="pdesc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ as pactyp" id="pactyp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date + 729)'DD.MM.YYYY') as hdate" id="hdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.qty as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="condition.description as cdesc" id="cdesc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.recdetailno_i as recd" id="recd"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.removel_reason as removal_reason" id="removal_reason"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_text.text as removal_text" id="removal_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_text.n_lines as removal_text_nlines" id="removal_text_nlines"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="label_additional.locid_desc as position" id="position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.event_perfno_i as wonum" id="wonum"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.print_type@">
          <ds:object>@VAR.print_type@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.labelno@">
          <ds:object>@VAR.labelno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT
history.voucherno as vn,
history.partno as pn,
history.station as removal_station,
CASE WHEN (p_spec.cnt&gt;0) THEN part.partno ELSE part.specification END as pn,
history.serialno as sn,
CASE WHEN (p_lngpn.cnt&gt;0) THEN part_description.text ELSE part.description END as pdesc,
part.ac_typ as pactyp,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date + 729), 'DD.MM.YYYY') as hdate,
history.qty as qty,
condition.description as cdesc,
history.recdetailno_i as recd,
history.reason as removal_reason,
h_text.text as removal_text,
h_text.n_lines as removal_text_nlines,
label_additional.locid_desc as position,
history.event_perfno_i as wonum

FROM 
history
LEFT JOIN part ON part.partno = history.partno
LEFT JOIN rotables ON history.psn = rotables.psn
LEFT JOIN condition ON condition.condition = history.condition
LEFT JOIN (SELECT LISTAGG(history_text.short_text, chr(10)) WITHIN GROUP (ORDER BY recno) as text, historyno_i, count(recno) as n_lines FROM history_text GROUP BY historyno_i) h_text ON h_text.historyno_i = history.historyno_i
LEFT JOIN label_additional ON label_additional.labelno = history.labelno
LEFT JOIN (
	SELECT count(*) as cnt, partno FROM part_special WHERE special='SPEC' GROUP BY partno
) p_spec ON p_spec.partno = part.partno
LEFT JOIN (
	SELECT count(*) as cnt, partno FROM part_special WHERE special='LNG_PN' GROUP BY partno
) p_lngpn ON p_lngpn.partno = part.partno
LEFT JOIN part_description ON part.partseqno_i = part_description.partseqno_i

WHERE
'@VAR.print_type@' != 'B1' AND history.labelno = '@VAR.labelno@' AND  history.vm = 'YA'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
