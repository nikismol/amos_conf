  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="WP" description="" id="wpno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Workpackage NO" id="wpno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_CAD_ENG_WP_List" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wel.event_display" id="wel.event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(FLOOR(sum(to_number(rrre.total_hours * rrre.resource_quantity))/60)||':'||LPAD(TO_CHAR(MOD(sum(to_number(rrre.total_hours * rrre.resource_quantity)) 60)) 20)) as mhrs" id="mhrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="LISTAGG(pr2.prs) WITHIN GROUP (ORDER BY pr2.prs) as prs" id="prs"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.wpno@">
          <ds:object>@VAR.wpno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
  wel.event_display
  ,to_char(FLOOR(sum(to_number(rrre.total_hours * rrre.resource_quantity))/60)||':'||LPAD(TO_CHAR(MOD(sum(to_number(rrre.total_hours * rrre.resource_quantity)), 60)), 2, 0)) as mhrs
  ,LISTAGG(pr2.prs) WITHIN GROUP (ORDER BY pr2.prs) as prs
FROM wp_header wph
LEFT JOIN wp_assignment wpa ON wph.wpno_i = wpa.wpno_i
LEFT JOIN wo_header wh ON wh.event_perfno_i = wpa.event_perfno_i
LEFT JOIN wo_event_link wel ON wel.event_perfno_i = wh.event_perfno_i
LEFT JOIN workstep_link wsl ON wsl.event_perfno_i = wh.event_perfno_i
LEFT JOIN rm_resource_request rrr ON rrr.request_owner_amos_type = 'WS' AND rrr.request_owner_amos_key = wsl.descno_i
LEFT JOIN rm_resource_requirement rrre ON rrr.resource_request_noi = rrre.resource_request_noi
LEFT JOIN rm_resource_constraint rrc ON rrc.resource_requirement_noi = rrre.resource_requirement_noi
LEFT JOIN rm_property_type rpt ON rpt.property_type_no_i = rrc.property_type_no_i
LEFT JOIN (
  SELECT 
    pr.event_type, 
    pr.event_key,
    LISTAGG(CASE WHEN pr.partno IS NOT NULL THEN 'PN: '||to_char(pr.partno)||' QTY:'||to_number(pr.qty)||'; ' ELSE '' END) WITHIN GROUP (ORDER BY pr.partno) as prs
  FROM part_request_2 pr
  GROUP BY pr.event_type, pr.event_key
 ) pr2 ON pr2.event_type = 'WSL' AND pr2.event_key = wsl.workstep_linkno_i
WHERE 
wph.wpno_i = '@VAR.wpno@' 
AND wh.event_type IN ('T', 'Q', 'D')
AND rpt.property_type_id IN ('SKILL', 'SCOPE')
GROUP BY wel.event_display</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
