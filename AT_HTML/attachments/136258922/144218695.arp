              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="01. Partno" id="v01_partno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="304_check_repairable_parts" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno" id="part.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.repairable" id="part.repairable"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist.condition" id="hist.condition"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_alternate.partno AS alt_partno" id="alt_partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_alt.description" id="part_alt.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_alt.repairable" id="part_alt.repairable"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist_alt.condition" id="hist_alt.condition"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_partno@">
          <ds:object>@VAR.v01_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_partno_list@">
          <ds:object>@VAR.v02_partno_list@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    part.partno,
    part.description,
    part.repairable,
    hist.condition,
    part_alternate.partno AS alt_partno,
    part_alt.description,
    part_alt.repairable,
    hist_alt.condition
FROM part
LEFT JOIN (
    SELECT
        history.partno,
        LISTAGG(distinct history.condition ||' '|| condition.description, '; ') WITHIN GROUP (ORDER BY history.partno ) as condition
    FROM history
    LEFT JOIN condition ON history.condition=condition.condition
    WHERE history.condition is not null
      AND history.condition IN ('M', 'MD', 'R', 'OH', 'OD')
    GROUP BY history.partno
) hist ON part.partno=hist.partno
LEFT JOIN part_alternate ON part.partno=part_alternate.altpartno
LEFT JOIN part part_alt ON part_alternate.partno=part_alt.partno
LEFT JOIN (
    SELECT
        history.partno,
        LISTAGG(distinct history.condition ||' '|| condition.description, '; ') WITHIN GROUP (ORDER BY history.partno ) as condition
    FROM history
    LEFT JOIN condition ON history.condition=condition.condition
    WHERE history.condition is not null
      AND history.condition IN ('M', 'MD', 'R', 'OH', 'OD')
    GROUP BY history.partno
) hist_alt ON part_alt.partno=hist_alt.partno
LEFT JOIN address ON part.vendor=address.vendor
WHERE part.repairable='Y'
  AND part.mat_class='R'
  AND
    (
        part.partno IN
            (
            SELECT t.v
            FROM
                (
                SELECT column_value as v
                FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_partno@','comma'))
                ) t
            WHERE t.v is not null
            )
        OR '@VAR.v01_partno@' IS NULL
        )
  AND
    (
        part.partno IN
            (
                SELECT t.v
                FROM
                    (
                        SELECT column_value as v
                        FROM TABLE(amosserver_prod.string_splitter('@VAR.v02_partno_list@','line_feed'))
                        ) t
                WHERE t.v is not null
                )
            OR '@VAR.v02_partno_list@' IS NULL
        )
UNION
SELECT
    part.partno,
    part.description,
    part.repairable,
    hist.condition,
    part_alternate.partno AS alt_partno,
    part_alt.description,
    part_alt.repairable,
    hist_alt.condition
FROM part
LEFT JOIN (
    SELECT
        history.partno,
        LISTAGG(distinct history.condition ||' '|| condition.description, '; ') WITHIN GROUP (ORDER BY history.partno ) as condition
    FROM history
    LEFT JOIN condition ON history.condition=condition.condition
    WHERE history.condition is not null
      AND history.condition IN ('M', 'MD', 'R', 'OH', 'OD')
    GROUP BY history.partno
) hist ON part.partno=hist.partno
LEFT JOIN part_alternate ON part.partno=part_alternate.altpartno
LEFT JOIN part part_alt ON part_alternate.partno=part_alt.partno
LEFT JOIN (
    SELECT
        history.partno,
        LISTAGG(distinct history.condition ||' '|| condition.description, '; ') WITHIN GROUP (ORDER BY history.partno ) as condition
    FROM history
    LEFT JOIN condition ON history.condition=condition.condition
    WHERE history.condition is not null
      AND history.condition IN ('M', 'MD', 'R', 'OH', 'OD')
    GROUP BY history.partno
) hist_alt ON part_alt.partno=hist_alt.partno
LEFT JOIN address ON part.vendor=address.vendor
WHERE part.repairable='N' and part.mat_class='R'
  AND
    (
        part.partno IN
            (
            SELECT t.v
            FROM
                (
                SELECT column_value as v
                FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_partno@','comma'))
                ) t
            WHERE t.v is not null
            )
        OR '@VAR.v01_partno@' IS NULL
        )
  AND
    (
        part.partno IN
            (
                SELECT t.v
                FROM
                    (
                        SELECT column_value as v
                        FROM TABLE(amosserver_prod.string_splitter('@VAR.v02_partno_list@','line_feed'))
                        ) t
                WHERE t.v is not null
                )
            OR '@VAR.v02_partno_list@' IS NULL
        )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
