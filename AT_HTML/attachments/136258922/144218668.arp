<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.swiss-as.com/xml/report_3.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="3.0" xsi:schemaLocation="http://www.swiss-as.com/xml/report_3.0 http://www.swiss-as.com/xml/report_3.0.xsd http://www.swiss-as.com/xml/datasource_2.0 http://www.swiss-as.com/xml/datasource_2.0.xsd">
  <header>
    <report_id>AFL.REP.1000441</report_id>
    <revision_number>0</revision_number>
    <meta name="2019-06-27 tq 9935 vtsymbal">изменены наименования колонок Threshold &amp; Interval</meta>
    <meta name="2019-08-15 vtsymbal">исправлена ошибка нахождения интервалов</meta>
    <meta name="2019-08-20 vtsymbal">скорректирован поиск запланированных wo &amp; wp</meta>
    <meta name="2019-12-17 vtsymbal">в DS 38_Taskcard_Status удалено условие wp_status = -1</meta>
    <meta name="2020-01-10 vtsymbal">добавлен поиск исторических тасков</meta>
    <meta name="2020-03-23 vtsymbal">информация по запланированным wp/wo отображалась не у всех тасков из-за условия mv.taskcard_verno_i = plan.verno</meta>
    <meta name="2020-04-17 vtsymbal">В запросе по историческим данным добавлено условие связки таблиц rev и hist по revisionno_i, в операторе EXISTS удалена связка с таблицей forecast, а также исправлена связь с left join на join у таблицы hist</meta>
    <meta name="2020-04-19 vtsymbal">Решен найденный баг в дублировании данных таска (отображение данных по нескольким ревизиям одной карты)</meta>
    <meta name="2020-04-20 vtsymbal">В условие связывания таблицы hist добавлено rev.revisionno_i = hist.revicionno_i</meta>
    <meta name="author">vtsymbal</meta>
    <meta name="serialization">v3</meta>
    <rights>
      <access_right name="visibleToCustomer">true</access_right>
    </rights>
  </header>
