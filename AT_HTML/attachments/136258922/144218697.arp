              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="01. Changes Date From" id="v01_date_from">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="314_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="changesno_i" id="changesno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + wo_header.issue_date'dd.mm.yyyy') as issue_date" id="issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              DECODE(wo_header.type 'M' 'Maint.' 'P' 'PiRep' 'C' 'Cabin' 'S' 'Scheduled''IS NOT WO') as wo_type" id="wo_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN wo_header.hil = 'Y' THEN 'DD'&#10;                        WHEN wo_header.mel_code = 'L' THEN 'CDL'&#10;                        ELSE wo_header.mel_code &#10;              END as mel_code" id="mel_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header_more.mel_chapter as mel_chapter" id="mel_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + bohi_changes.changes_date'dd.mm.yyyy') as changes_date" id="changes_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="bohi_changes.action as action" id="action"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;REGEXP_REPLACE(REGEXP_SUBSTR(bohi_changes.changes '(&lt;column&gt;&lt;name&gt;ac_registr&lt;/name&gt;&lt;newValue&gt;).{16}(&lt;/newValue&gt;&lt;oldValue&gt;).{16}(&lt;/oldValue&gt;&lt;mimeType&gt;AC&lt;/mimeType&gt;&lt;/column&gt;)') '(&lt;column&gt;&lt;name&gt;ac_registr&lt;/name&gt;&lt;newValue&gt;)|(&lt;/newValue&gt;&lt;oldValue&gt;).{16}(&lt;/oldValue&gt;&lt;mimeType&gt;AC&lt;/mimeType&gt;&lt;/column&gt;)''') as new_ac_registr" id="new_ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;REGEXP_REPLACE(REGEXP_SUBSTR(bohi_changes.changes '(&lt;column&gt;&lt;name&gt;ac_registr&lt;/name&gt;&lt;newValue&gt;).{16}(&lt;/newValue&gt;&lt;oldValue&gt;).{16}(&lt;/oldValue&gt;&lt;mimeType&gt;AC&lt;/mimeType&gt;&lt;/column&gt;)') '(&lt;/oldValue&gt;&lt;mimeType&gt;AC&lt;/mimeType&gt;&lt;/column&gt;)|(&lt;column&gt;&lt;name&gt;ac_registr&lt;/name&gt;&lt;newValue&gt;).{16}(&lt;/newValue&gt;&lt;oldValue&gt;)''') AS old_ac_registr" id="old_ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="bohi_changes.user_sign ||' ('|| sign.firstname ||' '|| lastname  ||')' as user_sign" id="user_sign"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
 event_perfno_i, 
 changesno_i,
 issue_date,
 wo_type,
 mel_code,
 mel_chapter,
 changes_date,
 action,
 new_ac_registr,
 old_ac_registr,
 user_sign
FROM amosserver_prod.get_r314_wo_aircraft_replace_history (@VAR.v01_date_from@, @VAR.v02_date_to@)
ORDER BY 1, 2</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="314_WO_Import_History" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="LISTAGG(&#10;                               TO_CHAR(TO_DATE('31.12.1971' 'dd.mm.yyyy') + bohi_info.entry_date 'dd.mm.yyyy') ||' '|| to_char(trunc(sysdate) + bohi_info.entry_time/24/60 'hh24:mi')&#10;                               ';'||CHR(10)&#10;                              ) WITHIN GROUP (ORDER BY bohi_info.infono_i) as import_date_time" id="import_date_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@314_MAIN.event_perfno_i@">
          <ds:object>@314_MAIN.event_perfno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT LISTAGG(
                               TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + bohi_info.entry_date, 'dd.mm.yyyy') ||' '|| to_char(trunc(sysdate) + bohi_info.entry_time/24/60, 'hh24:mi')
                               ,';'||CHR(10)
                              ) WITHIN GROUP (ORDER BY bohi_info.infono_i) as import_date_time
FROM bohi_version
JOIN bohi_changes ON bohi_version.versionno_i=bohi_changes.versionno_i
JOIN bohi_info ON bohi_info.changesno_i = bohi_changes.changesno_i
WHERE 1=1
               AND bohi_version.primkey = @314_MAIN.event_perfno_i@
               AND bohi_info.action LIKE ('Exported via AIM interface TRANSFER WORKORDER%')
               AND bohi_version.mime_type = 'WO'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
