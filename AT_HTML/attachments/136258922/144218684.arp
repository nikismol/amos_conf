    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="part_request" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link.sequenceno" id="workstep_link.sequenceno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_forecast.event_display as event_display" id="event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.created_by AS CREATED_BY" id="CREATED_BY"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname||' '||sign.lastname AS Name" id="Name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.department||' '||department.description AS Department" id="Department"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as part_description" id="part_description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE(part.mat_type 'CONS' 'CONSUMABLES'&#10;                           'EQUI' 'EQUIPMENT'&#10;                           'FLMB' 'FLAMMABLE LIQUIDS'&#10;                           'GREA' 'SPECIAL GREASE'&#10;                           'KIT' 'KIT'&#10;                           'LIQU' 'SPECIAL LIQUIDS'&#10;                           'N' 'NON AIRCRAFT MATERIAL'&#10;                           'P' 'AIRCRAFT PART'&#10;                           'RM' 'RAW MATERIAL'&#10;                           'S' 'SERVICE'&#10;                           'SW' 'SOFTWARE'&#10;                           'T' 'TOOL'&#10;                           'ZSOD''SPECIAL PROTECTIVE EQUIPMENT') as mat_type" id="mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DDMMYYYY') + (part_request_2.created_date + 729)'DD.MM.YYYY') as part_request_date" id="part_request_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DDMMYYYY') + (part_request_2.mutation + 729)'DD.MM.YYYY') as part_request_mutation_date" id="part_request_mutation_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.qty as part_request_qty" id="part_request_qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.start@">
          <ds:object>@VAR.start@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end@">
          <ds:object>@VAR.end@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.typ@">
          <ds:object>@VAR.typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
     wp_header.wpno
    ,wp_header.ac_registr as ac_registr
    ,aircraft.ac_typ
    ,wo_header.event_perfno_i as event_perfno_i
    ,workstep_link.sequenceno 
    ,part_forecast.event_display as event_display
    ,part_request_2.partno as partno
    ,part_request_2.created_by AS CREATED_BY
    ,sign.firstname||' '||sign.lastname AS Name
    ,sign.department||' '||department.description AS Department
    ,part.description as part_description
    ,DECODE(part.mat_type, 'CONS', 'CONSUMABLES',
                           'EQUI', 'EQUIPMENT',
                           'FLMB', 'FLAMMABLE LIQUIDS',
                           'GREA', 'SPECIAL GREASE',
                           'KIT', 'KIT',
                           'LIQU', 'SPECIAL LIQUIDS',
                           'N', 'NON AIRCRAFT MATERIAL',
                           'P', 'AIRCRAFT PART',
                           'RM', 'RAW MATERIAL',
                           'S', 'SERVICE',
                           'SW', 'SOFTWARE',
                           'T', 'TOOL',
                           'ZSOD', 'SPECIAL PROTECTIVE EQUIPMENT') as mat_type
    ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (part_request_2.created_date + 729), 'DD.MM.YYYY') as part_request_date
    ,TO_CHAR(TO_DATE('01.01.1970', 'DD,MM,YYYY') + (part_request_2.mutation + 729), 'DD.MM.YYYY') as part_request_mutation_date
    ,part_request_2.qty as part_request_qty
FROM wp_header
JOIN aircraft on wp_header.ac_registr=aircraft.ac_registr
LEFT JOIN wp_assignment on wp_header.wpno_i=wp_assignment.wpno_i
LEFT JOIN wo_header on wp_assignment.event_perfno_i=wo_header.event_perfno_i
LEFT JOIN workstep_link ON wo_header.event_perfno_i=workstep_link.event_perfno_i
LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key 
LEFT JOIN sign ON part_request_2.created_by = sign.user_sign
LEFT JOIN department ON sign.department = department.department
LEFT JOIN part ON part_request_2.partno=part.partno
LEFT JOIN part_forecast ON part_request_2.part_requestno_i=part_forecast.part_requestno_i
LEFT JOIN allocation_link ON allocation_link.source_key=part_request_2.part_requestno_i AND allocation_link.source_type = 'PARTRQST'
LEFT JOIN forecast ON wo_header.event_perfno_i=forecast.event_perfno_i
WHERE 1=1 
    AND part_request_2.status = '0' 
    AND part_forecast.display_event_type in ('SRT', 'TC')
   AND part_request_2.part_request_template_i IS NULL
    AND part_request_2.created_date&gt;='@VAR.start@' and part_request_2.created_date&lt;='@VAR.end@'
    AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE( '@VAR.typ@', ', ', '|')) OR '@VAR.typ@' IS NULL)
ORDER BY wp_header.wpno, part_forecast.event_display, part_request_2.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
