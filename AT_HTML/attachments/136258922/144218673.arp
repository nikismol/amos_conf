            ) tc
LEFT JOIN (
                   SELECT wtd.taskcard_verno_i,
                                wtd.partno,
                                wtd.qty
                   FROM (
                                SELECT wt.taskcard_verno_i,
                                             wt.partno,
                                             SUM(wt.qty) as qty
                                FROM ( 		 
		                 SELECT DISTINCT
                                                          msc_taskcard_version.taskcard_verno_i,
                                                          part_request_template.partno,
                                                          part_request_template.qty as qty
                                             FROM 
                                                         msc_taskcard_version
                                             JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                                             JOIN worktemplate_link ON worktemplate_link.event_key = msc_item.itemno_i AND worktemplate_link.event_type = 'TI'
                                             JOIN work_template ON (worktemplate_link.wtno_i=work_template.wtno_i OR worktemplate_link.wtno_i = work_template.parent_wtno_i)
                                             JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i AND event_template.revision_status=1 AND event_template.status = 0 
                                             JOIN workstep_link ON event_template.event_perfno_i=workstep_link.event_perfno_i
                                             JOIN part_request_template ON part_request_template.event_key = workstep_link.descno_i AND part_request_template.event_type = 'WS'
                               ) wt
                   GROUP BY wt.taskcard_verno_i, wt.partno
                    ) wtd
          
          UNION
      
          SELECT eff_grouped.taskcard_verno_i,
                       eff_grouped.partno,
                       eff_grouped.qty
          FROM (
                       SELECT DISTINCT eff.taskcard_verno_i,
                                    eff.partno,
                                    MAX(eff.qty) OVER (PARTITION BY eff.partno, eff.taskcard_verno_i) as qty
                       FROM (
                                    SELECT
                                            msc_taskcard_version.taskcard_verno_i,
                                            part_request_template.partno,
                                            SUM(part_request_template.qty) as qty,
                                            workstep_link.event_perfno_i
                                    FROM
                                    msc_taskcard_version
                                    JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
                                    JOIN event_effectivity_link ON msc_item.itemno_i=event_effectivity_link.event_key AND event_effectivity_link.event_type = 'TI'
                                    JOIN worktemplate_link ON worktemplate_link.event_key=event_effectivity_link.effectivity_linkno_i AND worktemplate_link.event_type = 'EFL'
                                    JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i AND event_template.revision_status=1 AND event_template.status = 0 
                                    JOIN workstep_link ON event_template.event_perfno_i=workstep_link.event_perfno_i
                                    JOIN part_request_template ON part_request_template.event_key = workstep_link.descno_i AND part_request_template.event_type = 'WS'
                                    GROUP BY workstep_link.event_perfno_i, msc_taskcard_version.taskcard_verno_i, part_request_template.partno
                                   ) eff 
                      ) eff_grouped
        ) pr ON tc.taskcard_verno_i=pr.taskcard_verno_i
GROUP BY tc.mpno, tc.revision, tc.taskcardno, pr.partno
             ORDER BY 1, 2, 3 DESC, 4</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="DATE_CONVERTER" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(SYSDATE'DD.MM.YYYY') as f_date" id="f_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(SYSDATE'HH24:MI:SS') as f_time" id="f_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	TO_CHAR(SYSDATE, 'DD.MM.YYYY') as f_date,
	TO_CHAR(SYSDATE, 'HH24:MI:SS') as f_time
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
