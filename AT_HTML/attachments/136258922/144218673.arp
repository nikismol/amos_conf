    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="TC" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>TC</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_maintenance_program.mpno as mpno" id="mpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;             msc_mp_revision.revision_no||' '||DECODE (msc_mp_revision.revision_status 'a' '(Active)' 'b' '(Temporary)' 't' '(Tentative)''')  as revision" id="revision"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno as taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.qty as qty" id="qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_mpno@">
          <ds:object>@VAR.v01_mpno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_mp_rev_status@">
          <ds:object>@VAR.v02_mp_rev_status@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_tc_section@">
          <ds:object>@VAR.v04_tc_section@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_taskcardno_i@">
          <ds:object>@VAR.v03_taskcardno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_moe_task_list@">
          <ds:object>@VAR.v05_moe_task_list@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_moe_task_list_2@">
          <ds:object>@VAR.v05_moe_task_list_2@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
       tc.mpno as mpno,
       tc.revision as revision,
       tc.taskcardno as taskcardno,
       CASE WHEN REGEXP_LIKE(pr.partno, '^[0-9]+$') AND pr.partno LIKE ('0%') THEN chr(39)||pr.partno ELSE pr.partno END as partno,
       SUM(pr.qty) as qty
FROM (
             SELECT DISTINCT msc_maintenance_program.mpno as mpno,
                         msc_mp_revision.revision_no||' '||DECODE (msc_mp_revision.revision_status, 'a', '(Active)', 'b', '(Temporary)', 't', '(Tentative)', '')  as revision,
                         msc_taskcard.taskcardno as taskcardno,
                         msc_taskcard_version.taskcard_verno_i
            FROM msc_taskcard_version
            LEFT JOIN msc_taskcard ON msc_taskcard_version.taskcardno_i=msc_taskcard.taskcardno_i
            LEFT JOIN msc_maintenance_program ON msc_taskcard.mpno_i=msc_maintenance_program.mpno_i
            LEFT JOIN msc_item ON msc_taskcard_version.taskcard_verno_i=msc_item.taskcard_verno_i
            LEFT JOIN msc_task_section ON msc_taskcard_version.taskcard_verno_i=msc_task_section.taskcard_verno_i
            LEFT JOIN msc_section_code ON msc_task_section.sectionno_i=msc_section_code.sectionno_i
            LEFT JOIN (
                                SELECT tc.taskcardno,
                                              tc_rev.revision_no as rno,
                                              tc_rev.taskcard_verno_i as tcvrn_i,
                                              tc_rev.taskcard_status,
                                              tc_rev.not_applicable,
                                              tc.tc_type,
                                              (
                                               SELECT COUNT (*) 
                                               FROM msc_taskcard_version 
                                               JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i 
                                               WHERE msc_taskcard_version.taskcardno_i = tc.taskcardno_i 
                                                              AND msc_taskcard_version.taskcard_verno_i &lt;&gt; tc_rev.taskcard_verno_i 
                                                              AND msc_taskcard_version.taskcard_status = 'T' 
                                                              AND msc_taskcard_version.status &lt;&gt; 8
                                              ) as TC_A,
                                              CASE WHEN tc_rev.taskcard_verno_i = (
                                                                                                                 SELECT MAX (mpr.taskcard_verno_i) 
                                                                                                                 FROM msc_mprev_taskcards mpr 
                                                                                                                 JOIN msc_taskcard_version ON mpr.taskcard_verno_i = msc_taskcard_version.taskcard_verno_i 
                                                                                                                 WHERE mpr.revisionno_i = mp_tc.revisionno_i 
                                                                                                                                AND msc_taskcard_version.taskcardno_i = tc_rev.taskcardno_i 
                                                                                                                                AND mpr.taskcard_verno_i IN (
                                                                                                                                                                                         SELECT v1.taskcard_verno_i 
                                                                                                                                                                                         FROM msc_taskcard_version v1 
                                                                                                                                                                                         WHERE v1.taskcardno_i = (
                                                                                                                                                                                                                                          SELECT v2.taskcardno_i 
                                                                                                                                                                                                                                          FROM msc_taskcard_version v2 
                                                                                                                                                                                                                                          WHERE v2.taskcard_verno_i = v1.taskcard_verno_i
                                                                                                                                                                                                                                         ) 
                                                                                                                                                                                         AND v1.taskcard_status IN ('A', 'B')
                                                                                                                                                                                        )
                              ) THEN ' ' ELSE 'S' END as TC_T,
                              (
                               SELECT COUNT (*) 
                               FROM msc_taskcard_version 
                               JOIN msc_mprev_taskcards ON msc_taskcard_version.taskcard_verno_i = msc_mprev_taskcards.taskcard_verno_i 
                               WHERE msc_taskcard_version.taskcardno_i = tc.taskcardno_i 
                                            AND msc_taskcard_version.taskcard_verno_i &lt;&gt; tc_rev.taskcard_verno_i 
                                            AND msc_taskcard_version.taskcard_status = 'A' 
                                            AND msc_taskcard_version.status &lt;&gt; 8
                              ) as TC_R
                          FROM msc_mprev_taskcards mp_tc 
                          JOIN msc_taskcard_version tc_rev ON mp_tc.taskcard_verno_i = tc_rev.taskcard_verno_i 
                          JOIN msc_taskcard tc ON tc_rev.taskcardno_i = tc.taskcardno_i 
                          ORDER BY tc.taskcardno, tc_rev.taskcard_verno_i
                         ) tc_status ON tc_status.tcvrn_i=msc_taskcard_version.taskcard_verno_i
          LEFT JOIN msc_mprev_taskcards ON msc_mprev_taskcards.taskcard_verno_i=msc_taskcard_version.taskcard_verno_i
          LEFT JOIN msc_mp_revision ON msc_mprev_taskcards.revisionno_i=msc_mp_revision.revisionno_i
          WHERE msc_maintenance_program.mpno_i = '@VAR.v01_mpno@'
                   AND msc_mp_revision.revision_type='MP'
                   AND msc_mp_revision.revision_status='@VAR.v02_mp_rev_status@'
                   AND (REGEXP_LIKE(msc_section_code.section_code, REPLACE('@VAR.v04_tc_section@', ', ', '|')) OR '@VAR.v04_tc_section@' IS NULL OR '@VAR.v04_tc_section@'='ALL')
                   AND (
                             msc_taskcard_version.taskcard_status='A' AND tc_status.TC_A='0'
                             OR msc_taskcard_version.taskcard_status='T' AND tc_status.TC_T='S'
                             OR msc_taskcard_version.taskcard_status IN ('A', 'B')
                                   AND tc_status.TC_A='1' 
                                   AND msc_mp_revision.revision_status='b'
                             OR msc_taskcard_version.taskcard_status IN ('B')
                                   AND tc_status.TC_A='0' 
                                   AND msc_mp_revision.revision_status='b'
                            )
                   AND (REGEXP_LIKE(msc_taskcard_version.taskcardno_i, REPLACE('@VAR.v03_taskcardno_i@', ', ', '|')) OR '@VAR.v03_taskcardno_i@' IS NULL)
/*
