                                                                                                                  1, 
                                                                                                                  0,
                                                                                                                  instr('@VAR.v05_moe_task_list@' || ',', ',', 1, level - 1) + 2),
                                                                                           instr('@VAR.v05_moe_task_list@' || ',', ',', 1, level) -
