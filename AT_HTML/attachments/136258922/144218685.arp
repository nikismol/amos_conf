    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="284_rogue_unit" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno" id="history.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno" id="history.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ata_chapter" id="part.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.workorderno_display" id="wo_header.workorderno_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_action.text as action_text" id="action_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link.sequenceno" id="workstep_link.sequenceno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.text as workstep_text" id="workstep_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.vm" id="history.vm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist_cnt.cnt" id="hist_cnt.cnt"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="voucher_mode.description" id="voucher_mode.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.labelno" id="history.labelno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.ac_registr" id="history.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_part_on_off.ac_position" id="wo_part_on_off.ac_position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.reason" id="history.reason"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.confirmed" id="history.confirmed"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (history.del_date+729)'dd-Mon-yyyy') as del_dates" id="del_dates"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn)/60)'FM999999999900')) || ':'&#10;                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn)60))'FM00') as tsn" id="tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_NUMBER(history.csn)) as csn" id="csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi )/60)'FM999999999900')) || ':'&#10;                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi )60))'FM00') as tbi" id="tbi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_NUMBER(history.cbi)) as cbi" id="cbi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    case when history.reason = 'US' and history.confirmed = ' 'then&#10;            case when us.msn_us is null then TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn )/60)'FM999999999900')) || ':'&#10;                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn )60))'FM00')&#10;                else TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn - NVL(us.msn_us 0))/60)'FM999999999900')) || ':'&#10;                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn - NVL(us.msn_us 0))60))'FM00') end&#10;        when history.reason = 'US' and history.confirmed = 'Y' then TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn - NVL(us_y.msn_us 0))/60)'FM999999999900')) || ':'&#10;                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn - NVL(us_y.msn_us 0))60))'FM00')&#10;        when history.reason = 'US' and history.confirmed = 'N' then TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi)/60)'FM999999999900')) || ':'&#10;                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi)60))'FM00')&#10;        else ' '&#10;    end as tsf" id="tsf"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    case when history.reason = 'US' and history.confirmed = ' 'then&#10;        case when us.msn_us is null then TO_CHAR(TO_NUMBER(history.csn))&#10;            else TO_CHAR(TO_NUMBER(history.csn - NVL(us.csn_us 0))) end&#10;        when history.reason = 'US' and history.confirmed = 'Y' then TO_CHAR(TO_NUMBER(history.csn - NVL(us_y.csn_us0)))&#10;        when history.reason = 'US' and history.confirmed = 'N' then TO_CHAR(TO_NUMBER(history.cbi))&#10;        else ' '&#10;    end as csf" id="csf"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.tam)/60)'FM999999999900')) || ':'&#10;                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.tam)60))'FM00') as tah" id="tah"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.tac" id="history.tac"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v1_start_date@">
          <ds:object>@VAR.v1_start_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v2_end_date@">
          <ds:object>@VAR.v2_end_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v3_ac_type@">
          <ds:object>@VAR.v3_ac_type@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v4_tbi@">
          <ds:object>@VAR.v4_tbi@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v5_cbi@">
          <ds:object>@VAR.v5_cbi@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v6_cnt@">
          <ds:object>@VAR.v6_cnt@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v7_ata@">
          <ds:object>@VAR.v7_ata@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select
    history.partno,
    history.serialno,
    part.description,
    part.ata_chapter,
    wo_header.workorderno_display,
    wo_text_action.text as action_text,
    workstep_link.sequenceno,
    wo_text_description.text as workstep_text,
    history.vm,
    hist_cnt.cnt,
    voucher_mode.description,
    history.labelno,
    history.ac_registr,
    aircraft.ac_typ,
    wo_part_on_off.ac_position,
    history.reason,
    history.confirmed,
    TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (history.del_date+729), 'dd-Mon-yyyy') as del_dates,
    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn)/60),'FM999999999900')) || ':'
                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn),60)),'FM00') as tsn,
    TO_CHAR(TO_NUMBER(history.csn)) as csn,
    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi )/60),'FM999999999900')) || ':'
                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi ),60)),'FM00') as tbi,
    TO_CHAR(TO_NUMBER(history.cbi)) as cbi,
    case when history.reason = 'US' and history.confirmed = ' 'then
            case when us.msn_us is null then TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn )/60),'FM999999999900')) || ':'
                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn ),60)),'FM00')
                else TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn - NVL(us.msn_us, 0))/60),'FM999999999900')) || ':'
                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn - NVL(us.msn_us, 0)),60)),'FM00') end
        when history.reason = 'US' and history.confirmed = 'Y' then TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn - NVL(us_y.msn_us, 0))/60),'FM999999999900')) || ':'
                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn - NVL(us_y.msn_us, 0)),60)),'FM00')
        when history.reason = 'US' and history.confirmed = 'N' then TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi)/60),'FM999999999900')) || ':'
                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi),60)),'FM00')
        else ' '
    end as tsf,
    case when history.reason = 'US' and history.confirmed = ' 'then
        case when us.msn_us is null then TO_CHAR(TO_NUMBER(history.csn))
            else TO_CHAR(TO_NUMBER(history.csn - NVL(us.csn_us, 0))) end
        when history.reason = 'US' and history.confirmed = 'Y' then TO_CHAR(TO_NUMBER(history.csn - NVL(us_y.csn_us, 0)))
        when history.reason = 'US' and history.confirmed = 'N' then TO_CHAR(TO_NUMBER(history.cbi))
        else ' '
    end as csf,
    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.tam)/60),'FM999999999900')) || ':'
                            ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.tam),60)),'FM00') as tah,
    history.tac
from history
left join part on history.partno=part.partno
left join (
select
    count(HISTORYNO_I) as cnt,
    psn
from history
left join aircraft on history.ac_registr=aircraft.ac_registr
where history.VM = 'YA'
    and history.del_date &gt;= '@VAR.v1_start_date@'
    and history.del_date &lt;= '@VAR.v2_end_date@'
    and ((aircraft.ac_typ = 'A32S' AND (REGEXP_LIKE('A32S', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'A330' AND (REGEXP_LIKE('A330', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
       (aircraft.ac_typ = 'A350' AND (REGEXP_LIKE('A350', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'B737' AND (REGEXP_LIKE('B737', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'B777' AND (REGEXP_LIKE('B777', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
 	   (aircraft.ac_typ = 'RRJ' AND (REGEXP_LIKE('RRJ', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
       )
    and history.mbi &lt;= @VAR.v4_tbi@
    and history.cbi &lt;= @VAR.v5_cbi@
group by psn
) hist_cnt on history.psn=hist_cnt.psn
left join (
    select
        us.last_historyno_i_us,
        us.historyno_i_us,
        us.historyno_i,
        us.csn_us,
        us.msn_us
    from (
        select
            h.historyno_i,
            MAX(us_h.historyno_i) OVER (PARTITION BY h.historyno_i) as last_historyno_i_us,
            us_h.historyno_i as historyno_i_us,
            us_h.msn as msn_us,
            us_h.csn  as csn_us
        from history h
        left join history us_h on h.psn = us_h.psn and us_h.vm='YA' and us_h.reason = 'US' and us_h.confirmed = ' '
        where h.vm ='YA'
        and h.reason = 'US' and h.confirmed = ' '
        and us_h.historyno_i &lt; h.historyno_i
         ) us WHERE us.last_historyno_i_us=us.historyno_i_us
) us on history.historyno_i=us.historyno_i
left join (
    select
        us_y.last_historyno_i_us_y,
        us_y.historyno_i_us_y,
        us_y.historyno_i,
        us_y.msn_us,
        us_y.csn_us
    from (
        select
            h.historyno_i,
            MAX(us_h_y.historyno_i) OVER (PARTITION BY h.historyno_i) as last_historyno_i_us_y,
            us_h_y.historyno_i as historyno_i_us_y,
            us_h_y.msn as msn_us,
            us_h_y.csn  as csn_us
        from history h
        left join history us_h_y on h.psn = us_h_y.psn and us_h_y.vm='YA' and us_h_y.reason = 'US' and us_h_y.confirmed = 'Y'
        where h.vm ='YA'
        and h.reason = 'US' and h.confirmed = 'Y'
        and us_h_y.historyno_i &lt; h.historyno_i
         ) us_y WHERE us_y.last_historyno_i_us_y=us_y.historyno_i_us_y
) us_y on history.historyno_i=us_y.historyno_i
left join voucher_mode on history.vm=voucher_mode.vm
left join wo_header on history.event_perfno_i=wo_header.event_perfno_i
left join wo_part_on_off on  history.labelno= wo_part_on_off.labelno
left join wo_text_action on wo_part_on_off.actionno_i=wo_text_action.actionno_i
left join workstep_link on wo_header.event_perfno_i=workstep_link.event_perfno_i and workstep_link.sequenceno=1
left join wo_text_description on workstep_link.descno_i=wo_text_description.descno_i
left join aircraft on history.ac_registr = aircraft.ac_registr
where
    history.VM in ('YA')
    and history.del_date &gt;= '@VAR.v1_start_date@'
    and history.del_date &lt;= '@VAR.v2_end_date@'
    and ((aircraft.ac_typ = 'A32S' AND (REGEXP_LIKE('A32S', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'A330' AND (REGEXP_LIKE('A330', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
       (aircraft.ac_typ = 'A350' AND (REGEXP_LIKE('A350', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'B737' AND (REGEXP_LIKE('B737', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
	   (aircraft.ac_typ = 'B777' AND (REGEXP_LIKE('B777', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
           OR
 	   (aircraft.ac_typ = 'RRJ' AND (REGEXP_LIKE('RRJ', REPLACE('@VAR.v3_ac_type@', ', ', '|')) OR '@VAR.v3_ac_type@' = 'ALL'))
       )
    and history.mbi &lt;= @VAR.v4_tbi@
    and history.cbi &lt;= @VAR.v5_cbi@
    and hist_cnt.cnt &gt;= @VAR.v6_cnt@
    and (REGEXP_LIKE(part.ata_chapter, REPLACE('@VAR.v7_ata@', ', ', '|')) OR '@VAR.v7_ata@' IS NULL)
order by history.partno, history.serialno desc</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
