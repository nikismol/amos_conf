  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="v03_delimeter"/>
        <ds:columnDescriptor amosType="DESC_TXT" description="" id="v02_panelno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="v01_ac_typ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="03. Delimeter" id="v03_delimeter">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>line_feed</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>comma&amp;=&amp;Comma (Запятая);line_feed&amp;=&amp;Line Feed (Перенос строки - при копировании колонки Excel);space&amp;=&amp;Space (Пробел);</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="02. List of Panels" id="v02_panelno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>ALL</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="01. AC Type" id="v01_ac_typ">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>ALL</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>ALL&amp;=&amp;ALL;A32S&amp;=&amp;A32S;A330&amp;=&amp;A330;A350&amp;=&amp;A350;B737&amp;=&amp;B737;B777&amp;=&amp;B777;RRJ&amp;=&amp;RRJ;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Panel_PartRequest_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.ac_type as ac_type" id="ac_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.panel_no as panel_no" id="panel_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.panel_description as panel_description" id="panel_description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.quick_access as quick_access" id="quick_access"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.action_type as action_type" id="action_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.qty as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.mat_class as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.mat_type as mat_type" id="mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.mat_type_description as mat_type_description" id="mat_type_description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.tool as tool" id="tool"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.measure_unit as measure_unit" id="measure_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="alt_parts.altpartno as altpartno" id="altpartno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN pr.mat_class = 'R' THEN r_stock.qty ELSE c_stock.qty END as stock_qty" id="stock_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN pr.mat_class = 'R' THEN r_stock_incl_alt.qty ELSE c_stock_incl_alt.qty END as alt_stock_qty" id="alt_stock_qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_ac_typ@">
          <ds:object>@VAR.v01_ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_panelno@">
          <ds:object>@VAR.v02_panelno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_delimeter@">
          <ds:object>@VAR.v03_delimeter@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT pr.ac_type as ac_type,
              pr.panel_no as panel_no,
              pr.panel_description as panel_description,
              pr.quick_access as quick_access,
              pr.action_type as action_type,
              pr.partno as partno,
              pr.qty as qty,
              pr.description as description,
              pr.mat_class as mat_class,
              pr.mat_type as mat_type,
              pr.mat_type_description as mat_type_description,
              pr.tool as tool,
              pr.measure_unit as measure_unit,
              alt_parts.altpartno as altpartno,
              CASE WHEN pr.mat_class = 'R' THEN r_stock.qty ELSE c_stock.qty END as stock_qty,
              CASE WHEN pr.mat_class = 'R' THEN r_stock_incl_alt.qty ELSE c_stock_incl_alt.qty END as alt_stock_qty
FROM (
             SELECT msc_panel_type.ac_type,
                           msc_panel_type.panel_no,
                           msc_panel_type.description as panel_description,
                           CASE WHEN part_request_template.event_key = msc_panel_type.descno_i_opening 
                                     THEN 'Open Panel'
                                     WHEN part_request_template.event_key = msc_panel_type.descno_i_closing
                                     THEN 'Close Panel'
                                     ELSE chr(39)||'-'
                           END as action_type,
                           msc_panel_type.quick_access,
                           part_request_template.partno as partno,
                           TO_NUMBER(part_request_template.qty) as qty,
                           part.description as description,
                           part.mat_class as mat_class,
                           mat_type.mat_type as mat_type,
                           mat_type.description as mat_type_description,
                           part.tool as tool,
                           part.measure_unit as measure_unit
             FROM msc_panel_type
             LEFT JOIN part_request_template ON (part_request_template.event_key = msc_panel_type.descno_i_opening OR part_request_template.event_key = msc_panel_type.descno_i_closing)
                                                                                 AND part_request_template.event_type = 'WS' 
             LEFT JOIN part on part_request_template.partno=part.partno
             LEFT JOIN mat_type on part.mat_type=mat_type.mat_type
             WHERE 1=1 
                           AND ('@VAR.v01_ac_typ@' = 'ALL' AND msc_panel_type.ac_type != 'RRJAKP'  OR msc_panel_type.ac_type = '@VAR.v01_ac_typ@')
                           AND ('@VAR.v02_panelno@' = 'ALL'
                                     OR
                                     UPPER(msc_panel_type.panel_no) IN (
                                                                         SELECT UPPER(t.v)
                                                                         FROM (
                                                                                      SELECT column_value as v
                                                                                      FROM TABLE(amosserver_prod.string_splitter('@VAR.v02_panelno@','@VAR.v03_delimeter@'))
                                                                                     ) t
                                                                         WHERE t.v is not null
                                                                        )
                                    )
            ) pr

LEFT JOIN (
             SELECT part.partno,
                    LISTAGG(part_alternate.altpartno, ', ') within group (ORDER BY part_alternate.altpartno) as altpartno
             FROM part
             JOIN part_alternate ON part_alternate.partno = part.partno
             WHERE 1=1
                   AND part_alternate.type IN ('A' /*, 'R', 'S' */)
             GROUP BY part.partno      
) alt_parts ON pr.partno = alt_parts.partno


LEFT JOIN (
              SELECT SUM(consumables.qty) as qty,
                     p2.partno
              FROM part p2
              JOIN consumables on p2.partno = consumables.partno
              JOIN location ON consumables.locationno_i = location.locationno_i 
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND location.station in ('SVO', 'SHRM')
                             AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE','1014') 
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             /* AND (consumables.owner IN (' ', 'AFL') OR consumables.owner IS NULL OR ASCII(consumables.owner) = 49824) */
             group by p2.partno
) c_stock ON pr.partno = c_stock.partno

LEFT JOIN (
SELECT SUM(qty) as qty,
       partno
FROM (
              SELECT consumables.qty,
                     p2.partno
              FROM part p2
              JOIN consumables ON p2.partno = consumables.partno
              JOIN location ON consumables.locationno_i = location.locationno_i 
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND location.station in ('SVO', 'SHRM')
                             AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE','1014') 
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             /* AND (consumables.owner IN (' ', 'AFL') OR consumables.owner IS NULL OR ASCII(consumables.owner)= 49824) */

              UNION ALL

              SELECT consumables.qty,
                     p2.partno
              FROM part p2
              JOIN part_alternate ON p2.partno = part_alternate.partno
              JOIN consumables ON consumables.partno = part_alternate.altpartno
              JOIN location ON consumables.locationno_i = location.locationno_i 
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND location.station in ('SVO', 'SHRM')
                             AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE','1014') 
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             /* AND (consumables.owner IN (' ', 'AFL') OR consumables.owner IS NULL OR ASCII(consumables.owner)= 49824) */
                             AND part_alternate.type IN ('A' /*, 'R', 'S'*/)  
             )
group by partno
) c_stock_incl_alt ON c_stock_incl_alt.partno = pr.partno

LEFT JOIN (
              SELECT COUNT(rotables.psn) as qty,
                     part.partno
              FROM part
              JOIN rotables on part.partno = rotables.partno
              JOIN location ON rotables.locationno_i = location.locationno_i
              WHERE 1=1
                            AND part.mat_class = 'R'
                            AND location.location_type &lt;&gt; -200
                            AND rotables.condition &lt;&gt; 'US'
                            AND (rotables.partnonew = ' ' OR  ASCII(rotables.partnonew) = 49824)
                            AND (rotables.ac_registr = ' ' OR rotables.ac_registr = 'TRANSF' OR ASCII(rotables.ac_registr) = 49824)
                            /* AND (rotables.owner IN (' ','AFL') OR rotables.owner IS NULL OR ASCII(rotables.owner) = 49824) */
                            AND location.station in ('SVO', 'SHRM')
                            AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE','1014') 
             group by part.partno
) r_stock ON pr.partno = r_stock.partno

LEFT JOIN (
SELECT SUM(qty) as qty,
       partno
FROM (
              SELECT 1 as qty,
                     part.partno
              FROM part
              JOIN rotables on part.partno = rotables.partno
              JOIN location ON rotables.locationno_i = location.locationno_i
              WHERE 1=1
                            AND part.mat_class = 'R'
                            AND location.location_type &lt;&gt; -200
                            AND rotables.condition &lt;&gt; 'US'
                            AND (rotables.partnonew = ' ' OR  ASCII(rotables.partnonew) = 49824)
                            AND (rotables.ac_registr = ' ' OR rotables.ac_registr = 'TRANSF' OR ASCII(rotables.ac_registr) = 49824)
                            /* AND (rotables.owner IN (' ','AFL') OR rotables.owner IS NULL OR ASCII(rotables.owner) = 49824) */
                            AND location.station in ('SVO', 'SHRM')
                            AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE','1014') 

              UNION ALL

              SELECT 1 as qty,
                     part.partno
              FROM part
              JOIN part_alternate ON part.partno = part_alternate.partno
              JOIN rotables on part_alternate.altpartno = rotables.partno
              JOIN location ON rotables.locationno_i = location.locationno_i
              WHERE 1=1
                            AND part.mat_class = 'R'
                            AND location.location_type &lt;&gt; -200
                            AND rotables.condition &lt;&gt; 'US'
                            AND (rotables.partnonew = ' ' OR  ASCII(rotables.partnonew) = 49824)
                            AND (rotables.ac_registr = ' ' OR rotables.ac_registr = 'TRANSF' OR ASCII(rotables.ac_registr) = 49824)
                            /* AND (rotables.owner IN (' ','AFL') OR rotables.owner IS NULL OR ASCII(rotables.owner) = 49824) */
                            AND part_alternate.type IN ('A' /*, 'R', 'S'*/)  
                            AND location.station in ('SVO', 'SHRM')
                            AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE','1014') 
             )
group by partno
) r_stock_incl_alt ON r_stock_incl_alt.partno = pr.partno
ORDER BY 1, 2, 5</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
