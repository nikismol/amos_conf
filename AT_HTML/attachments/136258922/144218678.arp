          <conditions>
            <condition class="GenericStyleCondition">
              <field id="1">@TREQ_INTERVAL.interval@</field>
              <field id="2"/>
              <operator negated="NO">EQUALS</operator>
            </condition>
            <condition class="GenericStyleCondition">
              <field id="1">@TREQ_THRESHOLD.threshold@</field>
