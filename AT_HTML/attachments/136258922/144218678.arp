      <attribute name="rotation">0.0</attribute>
      <conditional_attributes>
        <conditional_attribute id="2">
          <attribute name="text"/>
          <conditions>
            <condition class="GenericStyleCondition">
              <field id="1">@EFF_LIST.eff_count@</field>
              <field id="2"/>
              <operator negated="YES">EQUALS</operator>
            </condition>
            <condition class="GenericStyleCondition">
              <field id="1">@EFF_LIST.eff_time_rec@</field>
              <field id="2"/>
              <operator negated="YES">EQUALS</operator>
