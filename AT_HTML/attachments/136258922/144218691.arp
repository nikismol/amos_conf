            <attribute name="line-break">WORD</attribute>
            <attribute name="splitable">NO</attribute>
            <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
            <attribute name="antialias">false</attribute>
          </view>
          <view class="LabelReportView" id="87761" usage="cell">
            <attribute name="position">0 0</attribute>
            <attribute name="size">100 16</attribute>
            <attribute name="visible">YES</attribute>
            <attribute name="auto-resize">YES</attribute>
            <attribute name="rotation">0.0</attribute>
            <conditional_attributes/>
            <attribute name="color">000000</attribute>
            <attribute name="margin">0 0 0 0</attribute>
            <attribute name="padding">2 0 0 0</attribute>
            <attribute name="border">1 SOLID 000000</attribute>
            <attribute name="text">@301_Heat_installation_on_ac.position@</attribute>
            <attribute name="text-decoration">NONE</attribute>
            <attribute name="font">SansSerif PLAIN 10</attribute>
            <attribute name="text-align">LEFT</attribute>
            <attribute name="line-break">WORD</attribute>
            <attribute name="splitable">NO</attribute>
            <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
            <attribute name="antialias">false</attribute>
          </view>
        </column>
      </column_model>
      <attribute name="data-source">301_Heat_installation_on_ac</attribute>
    </view>
  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="301_Heat_installation_on_ac" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.partno" id="rotables.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.serialno" id="rotables.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.ac_registr as AC_install" id="AC_install"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(hist.msn)/60)'FM999999999900')) || ':'&#10;        ||TO_CHAR(TRUNC(MOD(TO_NUMBER(hist.msn)60))'FM00') as tsn" id="tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hist.csn AS csn" id="csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(tam_ac.tam_ac-hist.tam)/60)'FM999999999900')) || ':'&#10;        ||TO_CHAR(TRUNC(MOD(TO_NUMBER(tam_ac.tam_ac-hist.tam)60))'FM00') as tsi" id="tsi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tac_ac.tac_ac-hist.tac AS csi" id="csi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (rotables.date_inst)'dd-Mon-yyyy') AS Date_Inst" id="Date_Inst"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.partnonew as Higher_PN" id="Higher_PN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.serialnonew as Higher_SN" id="Higher_SN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_mel.workorderno" id="wo_mel.workorderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE&#10;        WHEN position.description LIKE '%2641GM%' THEN '2641GM'&#10;        WHEN position.description LIKE '%2642GM%' THEN '2642GM'&#10;        WHEN position.description LIKE '%2643GM%' THEN '2643GM'&#10;        WHEN position.description LIKE '%2644GM%' THEN '2644GM'&#10;        ELSE high.location&#10;    END as position" id="position"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    rotables.partno,
    rotables.serialno,
    rotables.ac_registr as AC_install,
    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(hist.msn)/60),'FM999999999900')) || ':'
        ||TO_CHAR(TRUNC(MOD(TO_NUMBER(hist.msn),60)),'FM00') as tsn,
    hist.csn AS csn,
    TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(tam_ac.tam_ac-hist.tam)/60),'FM999999999900')) || ':'
        ||TO_CHAR(TRUNC(MOD(TO_NUMBER(tam_ac.tam_ac-hist.tam),60)),'FM00') as tsi,
    tac_ac.tac_ac-hist.tac AS csi,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (rotables.date_inst), 'DD.MM.YYYY') AS Date_Inst,
    rotables.partnonew as Higher_PN,
    rotables.serialnonew as Higher_SN,
    wo_mel.workorderno,
    CASE
        WHEN high.location LIKE '%320085-A330%' THEN '5241GG'
        WHEN high.location LIKE '%320086-A330%' THEN '5245GG'
        WHEN high.location LIKE '%320087-A330%' THEN '5243GG'
        WHEN high.location LIKE '%320088-A330%' THEN '5240GG'
        WHEN high.location LIKE '%320089-A330%' THEN '5242GG'
        WHEN high.location LIKE '%320090-A330%' THEN '5244GG'
        WHEN high.location LIKE '%320091-A330%' THEN '5247GG'
        WHEN high.location LIKE '%320092-A330%' THEN '5246GG'
        ELSE high.location
    END as position
FROM rotables
FULL JOIN aircraft ON rotables.ac_registr=aircraft.ac_registr
LEFT JOIN (
    SELECT
        history.psn,
        max(history.historyno_i) AS historyno_i
    FROM history
    WHERE history.VM='YE'
    GROUP BY  history.psn
) history ON rotables.psn=history.psn
LEFT JOIN history hist ON history.historyno_i=hist.historyno_i
LEFT JOIN (
    SELECT
        rotables.locationno_i,
        rotables.location,
        rotables.partno,
        rotables.serialno
    FROM rotables
) high ON rotables.partnonew=high.partno AND rotables.serialnonew=high.serialno
LEFT JOIN (
    SELECT
        counter.life_value as tac_ac,
        counter.ref_key
    FROM counter
    LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
    LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
    WHERE counter.ref_type='AC_INT'
      AND counter_definition.counter_defno_i='2'
) tac_ac on aircraft.aircraftno_i=tac_ac.ref_key
LEFT JOIN (
    SELECT
        counter.life_value as tam_ac,
        counter.ref_key
    FROM counter
    LEFT JOIN counter_template ON counter.counter_templateno_i=counter_template.counter_templateno_i
    LEFT JOIN counter_definition ON counter_template.counter_defno_i=counter_definition.counter_defno_i
    WHERE counter.ref_type='AC_INT'
      AND counter_definition.counter_defno_i='1'
) tam_ac on aircraft.aircraftno_i=tam_ac.ref_key
LEFT JOIN (
    SELECT
        wo_header.workorderno_display AS workorderno,
        wo_header.ac_registr
    FROM wo_header
    LEFT JOIN wo_header_more ON wo_header.event_perfno_i=wo_header_more.event_perfno_i
    WHERE regexp_like(wo_header_more.mel_chapter, '32-42-01(-?A)', 'i')
      AND wo_header.state = 'O'
) wo_mel ON aircraft.ac_registr=wo_mel.ac_registr
LEFT JOIN position ON high.location=position.position
WHERE rotables.partno IN (
    'LT-537-122-3',
    'LT-537-122-4'
    )
  AND aircraft.status &lt;&gt; '9'
  AND high.locationno_i=-1
ORDER BY rotables.ac_registr ASC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
