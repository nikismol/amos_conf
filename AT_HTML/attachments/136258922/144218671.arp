    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_MTS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              CASE WHEN history.vm IN ('YE' 'ME') OR history.vm IN ('MO' 'SW' 'PN') AND history.qty&lt;0&#10;                        THEN TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (history.del_date+729) 'dd-Mon-yyyy''NLS_DATE_LANGUAGE = ENGLISH') ELSE '' END as pn_date_on" id="pn_date_on"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              CASE WHEN history.vm IN ('YA' 'MA') OR history.vm IN ('MO' 'SW' 'PN') AND history.qty&gt;0&#10;                        THEN TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (history.del_date+729) 'dd-Mon-yyyy''NLS_DATE_LANGUAGE = ENGLISH') ELSE '' END as pn_date_off" id="pn_date_off"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.reason||' ('||history.vm||')' as reason" id="reason"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              CASE WHEN history.tsn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(msn)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(msn)60))'FM00') END as tsn" id="tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN history.csn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(history.csn) END as csn" id="csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.partnonew ELSE history.higher_partno END as higher_partno" id="higher_partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.serialnonew ELSE history.higher_serialno END as higher_serialno" id="higher_serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              (SELECT NVL(&#10;                                      CASE WHEN tsn_unknown='Y' OR oh_tsn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(msn - NVL(msn_oh 0))/60)'FM999999999900')) || ':' &#10;                                     ||TO_CHAR(TRUNC(MOD(TO_NUMBER(msn - NVL(msn_oh 0))60))'FM00') END&#10;                                      'UNK') as tso&#10;               FROM (&#10;                            SELECT              &#10;                                          NVL(h_assy_oh.historyno_i h_assy.historyno_i) as oh_historyno_i&#10;                                          max(NVL(h_assy_oh.historyno_i h_assy.historyno_i)) over (partition by 1) as max_oh_historyno_i      &#10;                                          h_assy.msn&#10;                                          h_assy.csn&#10;                                          NVL(h_assy_oh.msn 0) as msn_oh&#10;                                          NVL(h_assy_oh.csn 0) as csn_oh&#10;                                          h_assy.tsn_unknown&#10;                                          h_assy.csn_unknown&#10;                                          NVL(h_assy_oh.tsn_unknown 'N') as oh_tsn_unknown&#10;                                          NVL(h_assy_oh.csn_unknown 'N') as oh_csn_unknown &#10;                            FROM history h_assy&#10;                            LEFT JOIN history h_assy_oh ON h_assy.psn=h_assy_oh.psn AND h_assy_oh.vm in ('B1''B7') AND h_assy_oh.condition='OH' AND h_assy_oh.historyno_i&lt;h_assy.historyno_i &#10;                            WHERE 1=1&#10;                                           AND h_assy.partno = CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.partnonew ELSE history.higher_partno END&#10;                                           AND h_assy.serialno = CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.serialnonew ELSE history.higher_serialno END&#10;                                           AND h_assy.vm = history.vm&#10;                                           AND h_assy.del_date = history.del_date&#10;                           )&#10;               WHERE 1=1&#10;                             AND max_oh_historyno_i = oh_historyno_i&#10;              ) as assy_tso" id="assy_tso"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;              (SELECT NVL(&#10;                                      CASE WHEN csn_unknown='Y' OR oh_csn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_NUMBER(csn - NVL(csn_oh 0))) END&#10;                                       'UNK') as cso&#10;               FROM (&#10;                            SELECT     &#10;                                          NVL(h_assy_oh.historyno_i h_assy.historyno_i) as oh_historyno_i&#10;                                          max(NVL(h_assy_oh.historyno_i h_assy.historyno_i)) over (partition by 1) as max_oh_historyno_i      &#10;                                          h_assy.msn&#10;                                          h_assy.csn&#10;                                          NVL(h_assy_oh.msn 0) as msn_oh&#10;                                          NVL(h_assy_oh.csn 0) as csn_oh&#10;                                          h_assy.tsn_unknown&#10;                                          h_assy.csn_unknown&#10;                                          NVL(h_assy_oh.tsn_unknown 'N') as oh_tsn_unknown&#10;                                          NVL(h_assy_oh.csn_unknown 'N') as oh_csn_unknown &#10;                            FROM history h_assy&#10;                            LEFT JOIN history h_assy_oh ON h_assy.psn=h_assy_oh.psn AND h_assy_oh.vm in ('B1''B7') AND h_assy_oh.condition='OH' AND h_assy_oh.historyno_i&lt;h_assy.historyno_i &#10;                            WHERE 1=1&#10;                                           AND h_assy.partno = CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.partnonew ELSE history.higher_partno END&#10;                                           AND h_assy.serialno = CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.serialnonew ELSE history.higher_serialno END&#10;                                           AND h_assy.vm = history.vm&#10;                                           AND h_assy.del_date = history.del_date&#10;                           )&#10;               WHERE 1=1&#10;                             AND max_oh_historyno_i = oh_historyno_i&#10;              ) as assy_cso" id="assy_cso"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(aircraft.ac_model)||CASE WHEN aircraft.ac_subtype IS NULL OR ASCII(aircraft.ac_subtype)=49824 THEN '' ELSE '-'||TO_CHAR(aircraft.ac_subtype) END as model" id="model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.serialno as msn" id="msn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.tam)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.tam)60))'FM00') as tah_ac" id="tah_ac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.tac as tac_ac" id="tac_ac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h2.del_date IS NULL AND rotables.locationno_i=-4 THEN rotables.location ELSE history.location END as pos" id="pos"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="'' as endorsement" id="endorsement"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_rat.ac_rating as wv" id="wv"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="del_date" id="del_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN history.event_perfno_i&gt;0  AND (history.vm IN ('ME') OR history.vm IN ('MO') AND history.qty&gt;0)&#10;                         THEN mod_doc.docno&#10;                         WHEN (history.event_perfno_i IS NULL OR history.event_perfno_i=0)&#10;                                      AND (history.vm IN ('ME') OR history.vm IN ('MO') AND history.qty&gt;0)&#10;                                      AND history.partno=mod_doc_h.comp_partno&#10;                                      AND history.serialno=mod_doc_h.comp_serialno&#10;                         THEN mod_doc_h.docno&#10;                         ELSE '' END as docno" id="docno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              DECODE(history.historyno_i 614610 614610 - 2history.historyno_i) as historyno_i" id="historyno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;              CASE WHEN counter_h.is_unknown = 'Y' THEN 'Unknown'&#10;                        ELSE CASE WHEN rotables.ac_registr is NOT NULL AND ASCII(rotables.ac_registr) &lt;&gt; 49824&#10;                                            THEN (TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value)/60)'FM999999999900')) || ':' ||&#10;                                                        TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value)60))'FM00') ||'H')&#10;                                            ELSE (TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_h_not_installed.life_value)/60)'FM999999999900')) || ':' ||&#10;                                                        TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_h_not_installed.life_value)60))'FM00') ||'H')&#10;                                  END  &#10;              END as current_tsn" id="current_tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN counter_c.is_unknown = 'Y' THEN 'Unknown'&#10;                        ELSE CASE WHEN rotables.ac_registr is NOT NULL AND ASCII(rotables.ac_registr) &lt;&gt; 49824&#10;                                            THEN (TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on+counter_c.life_value)||'C')&#10;                                            ELSE TO_NUMBER(counter_c_not_installed.life_value)||'C' &#10;                                  END&#10;              END as current_csn" id="current_csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;              CASE WHEN rotables.ac_registr is NOT NULL AND ASCII(rotables.ac_registr) &lt;&gt; 49824&#10;                        THEN CASE WHEN rotables.oh_at_tsn_unknown='N'&#10;                                            THEN TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value-rotables.oh_at_msn)/60)'FM999999999900')) || ':' ||&#10;                                                      TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_value_m_h.life_value-counter_h.life_value_on+counter_h.life_value-rotables.oh_at_msn)60))'FM00')&#10;                                            ELSE 'UNKNOWN'&#10;                                   END&#10;                        ELSE CASE WHEN rotables.oh_at_tsn_unknown='N'&#10;                                            THEN TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(counter_c_not_installed.life_value - COALESCE(rotables.oh_at_msn max_since_oh.tso 0))/60)'FM999999999900')) || ':' ||&#10;                                                      TO_CHAR(TRUNC(MOD(TO_NUMBER(counter_c_not_installed.life_value - COALESCE(rotables.oh_at_msn max_since_oh.tso 0))60))'FM00')&#10;                                            ELSE 'UNKNOWN'&#10;                                  END&#10;              END ||'H' as current_tso" id="current_tso"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;              CASE WHEN rotables.ac_registr is NOT NULL AND ASCII(rotables.ac_registr) &lt;&gt; 49824&#10;                        THEN CASE WHEN rotables.oh_at_csn_unknown='N'&#10;                                            THEN TO_CHAR(TO_NUMBER(counter_value_m_c.life_value-counter_c.life_value_on+counter_c.life_value-rotables.oh_at_csn))&#10;                                            ELSE 'UNKNOWN'&#10;                                   END  &#10;                        ELSE CASE WHEN rotables.oh_at_csn_unknown='N'&#10;                                            THEN TO_CHAR(TO_NUMBER(counter_c_not_installed.life_value-COALESCE(rotables.oh_at_csn max_since_oh.cso0)))&#10;                                            ELSE 'UNKNOWN'&#10;                                  END&#10;              END ||'C' as current_cso" id="current_cso"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@PSN_LIST.psn@">
          <ds:object>@PSN_LIST.psn@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.vm@">
          <ds:object>@VAR.vm@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select
description,
pn_date_on,
pn_date_off,
reason,
partno,
serialno,
tsn,
csn,
higher_partno,
higher_serialno,
assy_tso,
assy_cso,
model,
msn,
tah_ac,
tac_ac,
pos,
endorsement,
ac_registr,
ac_typ,
wv,
del_date,
docno,
historyno_i,
current_tsn,
current_csn,
current_tso,
current_cso
from amosserver_prod.r112_mts_get_psn_history(@PSN_LIST.psn@, '@VAR.vm@')
order by del_date, historyno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="PSN_LIST" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="psn" id="psn"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.high_partno@">
          <ds:object>@VAR.high_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.high_serialno@">
          <ds:object>@VAR.high_serialno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.excl_llp@">
          <ds:object>@VAR.excl_llp@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select psn from amosserver_prod.r112_mts_get_psn('@VAR.partno@', '@VAR.serialno@', '@VAR.high_partno@', '@VAR.high_serialno@', '@VAR.excl_llp@') p</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
