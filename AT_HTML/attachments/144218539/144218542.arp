    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="A/C Utilization" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>A/C Utilization</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.ac_registr" id="ac_utilization.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.legno_i" id="ac_utilization.legno_i"/>
        <ds:columnDescriptor amosType="TIME" description="ac_utilization.daily_hours" id="ac_utilization.daily_hours"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.daily_cycles" id="ac_utilization.daily_cycles"/>
        <ds:columnDescriptor amosType="TIME" description="ac_utilization.tah" id="ac_utilization.tah"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.tac" id="ac_utilization.tac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.leg_number" id="ac_utilization.leg_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (ac_utilization.departure_date)'DD.MM.YYYY') as departure_date" id="departure_date"/>
        <ds:columnDescriptor amosType="TIME" description="ac_utilization.departure_time" id="ac_utilization.departure_time"/>
        <ds:columnDescriptor amosType="TIME" description="ac_utilization.arrival_time" id="ac_utilization.arrival_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.departure" id="ac_utilization.departure"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_utilization.arrival" id="ac_utilization.arrival"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" &#10;CONVERT(CHAR(20)DATEADD(dd ac_utilization.validity '31 dec 1971')104) as validity" id="validity"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;CONVERT(CHAR(10) getdate()104) date_now" id="date_now"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;CONVERT(CHAR(10) DATEADD(dd DATEDIFF(dd '31 dec 1971' '@VAR.datefrom@') '31 dec 1971')104) date_from" id="date_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;CONVERT(CHAR(10) DATEADD(dd DATEDIFF(dd '31 dec 1971' '@VAR.dateto@') '31 dec 1971')104) date_to" id="date_to"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.datefrom@">
          <ds:object>@VAR.datefrom@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateto@">
          <ds:object>@VAR.dateto@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AC_REG@">
          <ds:object>@AC_REG@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ac_utilization.ac_registr,
	ac_utilization.legno_i,
	ac_utilization.daily_hours,
	ac_utilization.daily_cycles,
	ac_utilization.tah,
	ac_utilization.tac,
	ac_utilization.leg_number,
	TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (ac_utilization.departure_date), 'DD.MM.YYYY') as departure_date,
	ac_utilization.departure_time,
	ac_utilization.arrival_time,
	ac_utilization.departure,
	ac_utilization.arrival, 
	TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (ac_utilization.validity), 'DD.MM.YYYY') as validity,
	TO_CHAR(sysdate, 'DD.MM.YYYY') as date_now,
	TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (@VAR.datefrom@), 'DD.MM.YYYY') as date_from,
	TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (@VAR.dateto@), 'DD.MM.YYYY') as date_to
FROM ac_utilization 
WHERE ac_utilization.ac_registr = '@AC_REG@' 
	
	AND ac_utilization.validity BETWEEN @VAR.datefrom@ AND @VAR.dateto@


ORDER BY ac_utilization.legno_i DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
