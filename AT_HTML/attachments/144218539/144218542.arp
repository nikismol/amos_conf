        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (@VAR.dateto@)'DD.MM.YYYY') as date_to" id="date_to"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
