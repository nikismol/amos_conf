  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="AC" description="" id="ac_registr"/>
        <ds:columnDescriptor amosType="AT" description="" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="trf_sign"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_to"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_from"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="3. Регистрационный номер ВС (пустое = все)" id="ac_registr">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Тип ВС (пустое=все)" id="ac_typ">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>RRJ</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="5. Логин пользователя" id="trf_sign">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>AT&amp;=&amp;AT;AS&amp;=&amp;AS;V&amp;=&amp;V;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>AS</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="2. Конец периода" id="date_to">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>17407</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="1. Начало периода" id="date_from">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>180</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CAD_PP_C12_MPR_ACS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>AFL_CAD_PP_C12_MPR_ACS</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT woh.ac_registr as ac_registr" id="ac_registr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.trf_sign@">
          <ds:object>@VAR.trf_sign@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
    DISTINCT woh.ac_registr as ac_registr
FROM 
    wo_header woh
LEFT JOIN
    aircraft a ON a.ac_registr = woh.ac_registr
LEFT JOIN 
    wo_transfer wot ON woh.event_perfno_i = wot.event_perfno_i
LEFT JOIN 
    wp_deassignment_history wpdh ON wpdh.event_perfno_i = woh.event_perfno_i
WHERE 
    wot.user_sign LIKE '@VAR.trf_sign@%'
    AND wot.date_transfer BETWEEN @VAR.date_from@ AND @VAR.date_to@
    AND wot.reason_code = 'MPR'
    AND (woh.ac_registr = '@VAR.ac_registr@' OR '@VAR.ac_registr@' IS NULL)
    AND (a.ac_typ = '@VAR.ac_typ@' OR '@VAR.ac_typ@' IS NULL)
ORDER BY woh.ac_registr ASC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CAD_PP_C12_MPR_WOS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>AFL_CAD_PP_C12_MPR_WOS</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT woh.event_perfno_i wo_num" id="wo_num"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.trf_sign@">
          <ds:object>@VAR.trf_sign@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_CAD_PP_C12_MPR_ACS.ac_registr@">
          <ds:object>@AFL_CAD_PP_C12_MPR_ACS.ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
    DISTINCT woh.event_perfno_i wo_num
FROM 
    wo_header woh
LEFT JOIN 
    wo_transfer wot ON woh.event_perfno_i = wot.event_perfno_i
WHERE 
    wot.user_sign LIKE '@VAR.trf_sign@%'
    AND wot.date_transfer BETWEEN @VAR.date_from@ AND @VAR.date_to@
    AND wot.reason_code = 'MPR'
    AND woh.ac_registr = '@AFL_CAD_PP_C12_MPR_ACS.ac_registr@'
ORDER BY woh.event_perfno_i ASC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CAD_PP_C12_MPR_TRFS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>AFL_CAD_PP_C12_MPR_TRFS</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wot.recno as trf_recno" id="trf_recno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wot.reason_code as trf_reason_code" id="trf_reason_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wot.user_sign as trf_sign" id="trf_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (wot.date_transfer)'DD.MM.YYYY') as trf_date" id="trf_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_CAD_PP_C12_MPR_WOS.wo_num@">
          <ds:object>@AFL_CAD_PP_C12_MPR_WOS.wo_num@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.trf_sign@">
          <ds:object>@VAR.trf_sign@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT   
	wot.recno as trf_recno, 
	wot.reason_code as trf_reason_code, 
	wot.user_sign as trf_sign,
	TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wot.date_transfer), 'DD.MM.YYYY') as trf_date
FROM     
	wo_transfer wot
WHERE      
    wot.event_perfno_i = @AFL_CAD_PP_C12_MPR_WOS.wo_num@
    AND wot.reason_code = 'MPR'
    AND wot.user_sign LIKE '@VAR.trf_sign@%'
    AND wot.date_transfer BETWEEN @VAR.date_from@ AND @VAR.date_to@
ORDER BY wot.event_perfno_i, wot.recno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CAD_PP_C12_MPR_DSS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>AFL_CAD_PP_C12_MPR_DSS</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpdh.deassignment_reason as ds_reason" id="ds_reason"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpdh.user_sign as ds_sign" id="ds_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (wpdh.deassign_date)'DD.MM.YYYY') as ds_date" id="ds_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.wpno as ds_wpno" id="ds_wpno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_CAD_PP_C12_MPR_WOS.wo_num@">
          <ds:object>@AFL_CAD_PP_C12_MPR_WOS.wo_num@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT    
    wpdh.deassignment_reason as ds_reason, 
    wpdh.user_sign as ds_sign,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wpdh.deassign_date), 'DD.MM.YYYY') as ds_date,
    wph.wpno as ds_wpno
FROM      wo_header woh 
LEFT JOIN      wp_deassignment_history wpdh ON wpdh.event_perfno_i = woh.event_perfno_i
LEFT JOIN      wp_header wph ON wpdh.wpno_i = wph.wpno_i
WHERE
	woh.event_perfno_i = @AFL_CAD_PP_C12_MPR_WOS.wo_num@</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CAD_PP_C12_MPR_WIS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Workorders issued</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(1) as count_issued_wos" id="count_issued_wos"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.trf_sign@">
          <ds:object>@VAR.trf_sign@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AFL_CAD_PP_C12_MPR_ACS.ac_registr@">
          <ds:object>@AFL_CAD_PP_C12_MPR_ACS.ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
    count(1) as count_issued_wos
FROM 
    wo_header woh
WHERE 
    woh.issue_sign LIKE '@VAR.trf_sign@%'
    AND woh.type IN ('M', 'P', 'C')
    AND woh.issue_date BETWEEN @VAR.date_from@ AND @VAR.date_to@
    AND woh.ac_registr = '@AFL_CAD_PP_C12_MPR_ACS.ac_registr@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
