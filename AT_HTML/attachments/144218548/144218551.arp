    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CAD_PP_C141_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="woh.event_perfno_i as wo_number" id="wo_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_model as ac_model" id="ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="woh.issue_sign as wo_issue_sign" id="wo_issue_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.wpno as wp_number" id="wp_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.hidden as wp_type" id="wp_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (wph.start_date + wph.start_time/60/24)'DD.MM.YYYY HH24:MM') as wp_start_date_time" id="wp_start_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (wpah.mutation + wpah.mutation_time/1000/60/60/24)'DD.MM.YYYY HH24:MM') as wo_assignment_date_time" id="wo_assignment_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (wta.action_date + wta.action_time/60/24)'DD.MM.YYYY HH24:MM') as wo_first_action_date_time" id="wo_first_action_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpah.created_by as wp_assignment_done_by" id="wp_assignment_done_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="DBMS_LOB.SUBSTR(wta.text 20001) as action_text" id="action_text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.user_sign@">
          <ds:object>@VAR.user_sign@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.use_acc_data@">
          <ds:object>@VAR.use_acc_data@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    woh.event_perfno_i as wo_number
    ,a.ac_registr as ac_registr
    ,a.ac_typ as ac_typ
    ,a.ac_model as ac_model
    ,woh.issue_sign as wo_issue_sign
    ,wph.wpno as wp_number
    ,wph.hidden as wp_type
    ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wph.start_date + wph.start_time/60/24), 'DD.MM.YYYY HH24:MM') as wp_start_date_time
    ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wpah.mutation + wpah.mutation_time/1000/60/60/24), 'DD.MM.YYYY HH24:MM') as wo_assignment_date_time
    ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wta.action_date + wta.action_time/60/24), 'DD.MM.YYYY HH24:MM') as wo_first_action_date_time
    ,wpah.created_by as wp_assignment_done_by
    ,DBMS_LOB.SUBSTR(wta.text, 2000, 1) as action_text
FROM
    wo_header woh
JOIN
    aircraft a ON woh.ac_registr = a.ac_registr    
LEFT JOIN
    (
        SELECT min(wp_historyno_i) as min_wp_historyno_i, wp_history.event_perfno_i
            FROM wp_history
        WHERE wp_history.action_type = 'A'
        GROUP BY wp_history.event_perfno_i
    ) min_wp_assignment ON min_wp_assignment.event_perfno_i = woh.event_perfno_i
LEFT JOIN    
    wp_history wpah ON wpah.wp_historyno_i = min_wp_assignment.min_wp_historyno_i
LEFT JOIN
    wp_header wph ON wph.wpno_i = wpah.wpno_i
LEFT JOIN
    (
        SELECT min(wo_text_action.actionno_i) as actionno_i, wo_text_action.event_perfno_i
        FROM wo_text_action
        WHERE (wo_text_action.sign_performed LIKE '@VAR.user_sign@%' OR ('@VAR.user_sign@' = 'AT' AND regexp_like(wo_text_action.sign_performed, '^A[0-9]+')))
        GROUP BY wo_text_action.event_perfno_i
    ) min_wo_action ON min_wo_action.event_perfno_i = woh.event_perfno_i
LEFT JOIN
    wo_text_action wta ON wta.actionno_i = min_wo_action.actionno_i
LEFT JOIN 
	(
            SELECT 
                wo_event_perfno_i
                ,current_amosdate
                ,count(CASE WHEN (NVL(part_forecast_status, 6) IN (6, 7, 8, 9)) THEN 0 ELSE 1 END) as pr_not_avl
            FROM AFL_ATECH_MEL_MONITOR 
            GROUP BY 
                wo_event_perfno_i
                ,current_amosdate
	)    partstats ON partstats.wo_event_perfno_i = woh.event_perfno_i AND partstats.current_amosdate = wta.action_date -1
WHERE
    woh.issue_date BETWEEN @VAR.date_from@ AND @VAR.date_to@
    AND ('@VAR.ac_registr@' IS NULL OR a.ac_registr = '@VAR.ac_registr@')
    AND ('@VAR.ac_typ@' IS NULL OR a.ac_typ = '@VAR.ac_typ@')
    AND woh.mel_code IS NOT NULL
    AND woh.type IN ('M', 'P', 'C')
    AND wpah.wpno_i IS NOT NULL /*WO was assigned to a WP*/
    AND wta.actionno_i IS NOT NULL
    AND (wta.action_date + wta.action_time/60/24) - (wph.start_date + wph.start_time/60/24) &gt; 1 /*at least one day after wp is sched to start*/
    AND (
	(wph.start_date + wph.start_time/60/24) &gt;= (wpah.mutation + wpah.mutation_time/1000/60/60/24) /*work added before WP was started*/ 
	OR  (wta.action_date + wta.action_time/60/24) - (wpah.mutation + wpah.mutation_time/1000/60/60/24) &gt; 1 /*OR action is 1 day after work was added to the WP*/
    )
    AND ('@VAR.use_acc_data@' = 'N' OR partstats.pr_not_avl = 0)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
