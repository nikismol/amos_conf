      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CAD_PP_C13_WOS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="date_day" id="date_day"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mel_wo_numbers" id="mel_wo_numbers"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mel_wo_count" id="mel_wo_count"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.user_sign@">
          <ds:object>@VAR.user_sign@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.use_part_logic@">
          <ds:object>@VAR.use_part_logic@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    ac_registr,
    date_day,
    mel_wo_numbers,
    mel_wo_count
FROM
    (
        SELECT 
            wos_with_parts.wo_ac_registr as ac_registr
            ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wos_with_parts.current_amosdate), 'DD.MM.YYYY') as date_day
            ,wos_with_parts.current_amosdate as current_amosdate
            ,LISTAGG(wos_with_parts.wo_event_perfno_i, ', ') WITHIN GROUP (ORDER BY wos_with_parts.wo_event_perfno_i) as mel_wo_numbers
            ,wos_with_parts.wo_ac_typ
            ,count(1) as mel_wo_count
        FROM (
            SELECT 
                wo_event_perfno_i
                ,current_amosdate
                ,wo_ac_registr
                ,wo_ac_typ
                ,count(CASE WHEN (NVL(part_forecast_status, 6) IN (6, 7, 8, 9)) THEN 0 ELSE 1 END) as pr_not_avl
            FROM AFL_ATECH_MEL_MONITOR 
	JOIN wo_header woh ON woh.event_perfno_i = AFL_ATECH_MEL_MONITOR.wo_event_perfno_i AND woh.issue_date &lt;=  AFL_ATECH_MEL_MONITOR.current_amosdate-1
	WHERE (AFL_ATECH_MEL_MONITOR.wo_issue_sign LIKE '@VAR.user_sign@%' OR ('@VAR.user_sign@' = 'AT' AND regexp_like(AFL_ATECH_MEL_MONITOR.wo_issue_sign, '^A[0-9]+')))
            GROUP BY 
                wo_event_perfno_i
                ,current_amosdate
                ,wo_ac_registr
                ,wo_ac_typ
                ,current_amosdate
            HAVING count(CASE WHEN (NVL(part_forecast_status, 6) IN (6, 7, 8, 9)) THEN 0 ELSE 1 END) = 0 OR '@VAR.use_part_logic@' = 'N' /*all parts are available as per forecast*/
        ) wos_with_parts
        GROUP BY
            wos_with_parts.wo_ac_registr
            ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wos_with_parts.current_amosdate), 'DD.MM.YYYY')
            ,wos_with_parts.current_amosdate
            ,wos_with_parts.wo_ac_typ
    ) wo_per_day_per_ac
	WHERE
		wo_per_day_per_ac.current_amosdate BETWEEN @VAR.date_from@ AND @VAR.date_to@
		AND ('@VAR.ac_typ@' IS NULL OR wo_per_day_per_ac.wo_ac_typ = '@VAR.ac_typ@')
		AND ('@VAR.ac_registr@' IS NULL OR wo_per_day_per_ac.ac_registr = '@VAR.ac_registr@')
		AND mel_wo_count &gt; 2
    ORDER BY
    wo_per_day_per_ac.date_day DESC, wo_per_day_per_ac.ac_registr DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
