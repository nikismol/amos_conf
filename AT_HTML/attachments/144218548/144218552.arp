              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_CAD_PP_C142_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="woh.event_perfno_i as wo_number" id="wo_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="woh.issue_sign as wo_issue_sign" id="wo_issue_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (woh.issue_date + woh.issue_time/60/24)'DD.MM.YYYY HH24:MM') as wo_issue_date" id="wo_issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (woh.closing_date)'DD.MM.YYYY') as wo_closing_date" id="wo_closing_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (wph.start_date + wph.start_time/60/24)'DD.MM.YYYY HH24:MM') as wp_start_date_time" id="wp_start_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wph.wpno as wo_wpno" id="wo_wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="LISTAGG(TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (wos_with_part.current_amosdate) 'DD.MM.YYYY') '') WITHIN GROUP (ORDER BY wos_with_part.current_amosdate) as open_wpart_dates" id="open_wpart_dates"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(1) as open_days_count" id="open_days_count"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.use_acc_data@">
          <ds:object>@VAR.use_acc_data@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_registr@">
          <ds:object>@VAR.ac_registr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
     woh.event_perfno_i as wo_number
    ,a.ac_registr as ac_registr
    ,a.ac_typ as ac_typ
    ,woh.issue_sign as wo_issue_sign
    ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (woh.issue_date + woh.issue_time/60/24), 'DD.MM.YYYY HH24:MM') as wo_issue_date
    ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (woh.closing_date), 'DD.MM.YYYY') as wo_closing_date
    ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wph.start_date + wph.start_time/60/24), 'DD.MM.YYYY HH24:MM') as wp_start_date_time
    ,wph.wpno as wo_wpno
    ,LISTAGG(TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wos_with_part.current_amosdate), 'DD.MM.YYYY'), ', ') WITHIN GROUP (ORDER BY wos_with_part.current_amosdate) as open_wpart_dates
    ,count(1) as open_days_count
FROM
    wo_header woh
LEFT JOIN 
    aircraft a ON a.ac_registr = woh.ac_registr
LEFT JOIN
    (
        SELECT min(wp_historyno_i) as min_wp_historyno_i, wp_history.event_perfno_i
            FROM wp_history
        WHERE wp_history.action_type = 'A'
        GROUP BY wp_history.event_perfno_i
    ) min_wp_assignment ON min_wp_assignment.event_perfno_i = woh.event_perfno_i
LEFT JOIN    
    wp_history wpah ON wpah.wp_historyno_i = min_wp_assignment.min_wp_historyno_i
LEFT JOIN
    wp_header wph ON wph.wpno_i = wpah.wpno_i
LEFT JOIN
    (
            SELECT 
                wo_event_perfno_i
                ,current_amosdate
                ,count(CASE WHEN (NVL(part_forecast_status, 6) IN (6, 7, 8, 9)) THEN 0 ELSE 1 END) as pr_not_avl
            FROM AFL_ATECH_MEL_MONITOR 
            GROUP BY 
                wo_event_perfno_i
                ,current_amosdate
                ,wo_ac_registr
                ,wo_ac_typ
                ,current_amosdate
            HAVING (count(CASE WHEN (NVL(part_forecast_status, 6) IN (6, 7, 8, 9)) THEN 0 ELSE 1 END) = 0 OR '@VAR.use_acc_data@' = 'N')/*all parts are available as per forecast*/
        ) wos_with_part ON wos_with_part.wo_event_perfno_i = woh.event_perfno_i
WHERE
    woh.mel_code IS NOT NULL
    AND woh.type IN ('M', 'P', 'C')
    AND wos_with_part.wo_event_perfno_i IS NOT NULL
    AND woh.issue_date BETWEEN @VAR.date_from@ AND @VAR.date_to@
    AND ('@VAR.ac_registr@' IS NULL OR a.ac_registr = '@VAR.ac_registr@')
    AND ('@VAR.ac_typ@' IS NULL OR a.ac_typ = '@VAR.ac_typ@')
    AND (wos_with_part.current_amosdate) - (wph.start_date + wph.start_time/60/24) &gt; 1
GROUP BY woh.event_perfno_i
    ,a.ac_registr
    ,a.ac_typ
    ,woh.issue_sign
    ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (woh.issue_date + woh.issue_time/60/24), 'DD.MM.YYYY HH24:MM')
    ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (woh.closing_date), 'DD.MM.YYYY')
    ,wph.wpno
    ,TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (wph.start_date + wph.start_time/60/24), 'DD.MM.YYYY HH24:MM')
ORDER BY a.ac_registr</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
