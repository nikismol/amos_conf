      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Фильтровать по наличию зпч (данные с 08.09.2019)" id="use_acc_data">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
