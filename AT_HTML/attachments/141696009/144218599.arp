    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="126_WC_Form" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Work Change Form main query</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="distinct&#10;       d.docno_i" id="d.docno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.docno wcf_no" id="wcf_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when issue_date &lt; 1491286 &#10;              then to_char(to_date('31.12.1971' 'dd.mm.yyyy') + issue_date'dd.mm.yyyy') &#10;        else 'Err Date' &#10;       end issue_date" id="issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="issued_by" id="issued_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="m.ac_registr" id="m.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rem" id="rem"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ref_wo" id="ref_wo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="name maintained_by" id="maintained_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="maintained_by operator" id="operator"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_reg@">
          <ds:object>@VAR.ac_reg@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.docno_i@">
          <ds:object>@VAR.docno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select distinct
       d.docno_i
     , d.docno wcf_no
     , case when issue_date &lt; 1491286 
              then to_char(to_date('31.12.1971', 'dd.mm.yyyy') + issue_date, 'dd.mm.yyyy') 
        else 'Err Date' 
       end issue_date
     , issued_by
     , m.ac_registr
     , serialno
     , rem
     , ref_wo
     , case when maintained_by &lt;&gt; ' '
             then name 
         else ''
       end maintained_by
     , maintained_by operator
  from doc_header d
  join event_effectivity_mapping m on d.docno_i = m.event_key_parent
  join aircraft a on m.aircraftno_i = a.aircraftno_i
  left join (
             select docno_i
                  , listagg (text, ' '||chr(13)||chr(10) ) within group (order by recno) rem
               from doc_remarks 
               group by docno_i
            ) dr on d.docno_i = dr.docno_i
/* Ref WO */
  left join (
              select docno_i
                   , docno
                   , m.ac_registr
                   , listagg (
                               'WO: ' || t.workorderno_display || ' for p/n ' ||
                               r.partno || '/' || r.serialno
                               , ', ' || chr(13)||chr(10)
                             ) within group (order by t.workorderno_display) ref_wo
                from event_effectivity_mapping m
                left join rotables r on m.psn = r.psn
                join wo_header t on m.event_perfno_i = t.event_perfno_i and m.event_type = 'EFL'
                join doc_header d on m.event_key_parent = d.docno_i and t.workorderno_display is not null
               group by docno_i
                   , docno
                   , m.ac_registr
             ) w on d.docno_i = w.docno_i and m.ac_registr = w.ac_registr
  left join address a on maintained_by = vendor
where 
/* ac registr */
   ( ('@VAR.ac_reg@') is null or m.aircraftno_i = '@VAR.ac_reg@') 
/* docno */
   and ( ('@VAR.docno_i@') is null or d.docno_i = '@VAR.docno_i@')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="126_WC_Form_customer" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>WC Form for customer users</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="employee_no" id="employee_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="lastname" id="lastname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="firstname" id="firstname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="middlename" id="middlename"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" substr(job_position10) job_position" id="job_position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when @VAR.date_ag@ &gt; 0 &#10;             then to_char(to_date('31.12.1971' 'dd.mm.yyyy') + '@VAR.date_ag@''dd.mm.yyyy')&#10;        else null&#10;       end date_ag" id="date_ag"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_ag@">
          <ds:object>@VAR.date_ag@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.agreed@">
          <ds:object>@VAR.agreed@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select employee_no
     , lastname
     , firstname
     , middlename
     , substr(job_position, 10) job_position
     , case when @VAR.date_ag@ &gt; 0 
             then to_char(to_date('31.12.1971', 'dd.mm.yyyy') + '@VAR.date_ag@', 'dd.mm.yyyy')
        else null
       end date_ag
  from (
        select employee_no
             , char_value
             , property_type_no_i
          from sign s
          join rm_property_value v on employee_no_i = owner_amos_key
         where property_type_no_i in ('40', '41', '42', '50')
    /* Customer */
           and employee_no = '@VAR.agreed@'
       ) t
 pivot (max(char_value) for property_type_no_i in (40 as firstname, 42 as lastname, 41 as middlename, 50 as job_position))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="126_WC_Form_performer" type="SQL_EDITOR_DATASOURCE" version="2.0">
