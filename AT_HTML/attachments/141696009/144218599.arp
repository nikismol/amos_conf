      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select employee_no
     , lastname
     , firstname
     , middlename
     , substr(job_position, 10) job_position
     , case when @VAR.date_perf@ &gt; 0 
             then to_char(to_date('31.12.1971', 'dd.mm.yyyy') + '@VAR.date_perf@', 'dd.mm.yyyy')
        else null
       end date_perf
  from (
        select employee_no
             , char_value
             , property_type_no_i
          from sign s
          join rm_property_value v on employee_no_i = owner_amos_key
         where property_type_no_i in ('40', '41', '42', '50')
    /* Customer */
           and employee_no = '@VAR.performer@'
       ) t
 pivot (max(char_value) for property_type_no_i in (40 as firstname, 42 as lastname, 41 as middlename, 50 as job_position))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
