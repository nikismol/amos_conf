  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="SGB" description="Исполнитель / ФИО / Должность" id="performer"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Итоговая стоимость (Р)" id="total_cost"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Тип цены" id="financial"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Тип изменения" id="changes"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Стоимость материалов (Рублей)" id="cost_of_materials"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Влияние на срок выполнения работ" id="influence"/>
        <ds:columnDescriptor amosType="DATE_INT" description="Дата согласования (заказчик)" id="date_ag"/>
        <ds:columnDescriptor amosType="AC_INT" description="AC Registr" id="ac_reg"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Количество нормо-часов" id="number_of_hours"/>
        <ds:columnDescriptor amosType="DATE_INT" description="Дата согласования (исполнитель)" id="date_perf"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Стоимость нормо-часов (Рублей)" id="cost_of_hours"/>
        <ds:columnDescriptor amosType="DO" description="Doc Number" id="docno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Выбор категории формы" id="category"/>
        <ds:columnDescriptor amosType="SGB" description="Заказчик / ФИО / Должность" id="agreed"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description=". Исполнитель" id="performer">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
