            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Structural_unit" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Структурная единица</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="description" id="description"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.str_ed@">
          <ds:object>@VAR.str_ed@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT case when '@VAR.str_ed@' is null then ' '
       else description
       end  description
FROM department
WHERE department.status &lt;&gt; 9  
and ('@VAR.str_ed@' is null or
 department = '@VAR.str_ed@')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Responsible_person" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Ответственное лицо</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when '@VAR.person_c@' is null then ' '&#10;       else firstname || lastname&#10;       end  name" id="name"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.person_c@">
          <ds:object>@VAR.person_c@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT case when '@VAR.person_c@' is null then ' '
       else firstname || ' ' || lastname
       end  name
FROM sign
where ('@VAR.person_c@' is null or
 employee_no = '@VAR.person_c@')
and status &lt;&gt; 9</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_List_of_Tools" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>List of tools</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.description" id="p.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ti.unit" id="ti.unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.partno" id="r.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case when ti.unit = 'MT' then decode(f.expected_date 0 null to_char(to_date('31.12.1971' 'dd.mm.yyyy') + f.expected_date'dd.mm.yyyy'))&#10;       &#9;end monthly" id="monthly"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case when ti.unit = 'H' then decode(f.expected_date 0 null to_char(to_date('31.12.1971' 'dd.mm.yyyy') +  f.expected_date'dd.mm.yyyy'))&#10;       &#9;end one_half" id="one_half"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case when ti.unit = 'YR' then decode(f.expected_date 0 null to_char(to_date('31.12.1971' 'dd.mm.yyyy') +  f.expected_date'dd.mm.yyyy'))&#10;       &#9;end year" id="year"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case when ti.unit = 'D' then decode(f.expected_date 0 null to_char(to_date('31.12.1971' 'dd.mm.yyyy') +  f.expected_date'dd.mm.yyyy'))&#10;       &#9;end daily" id="daily"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case when ti.unit = ' ' then decode(f.expected_date 0 null to_char(to_date('31.12.1971' 'dd.mm.yyyy') +  f.expected_date'dd.mm.yyyy'))&#10;       &#9;end nothing" id="nothing"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(f.expected_date_pln&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + f.expected_date_pln'dd.mm.yyyy')) expected_date_pln" id="expected_date_pln"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tlmtno.mat_no" id="tlmtno.mat_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tlptno.partno" id="tlptno.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tlslno.sl_no" id="tlslno.sl_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tlidno.ident" id="tlidno.ident"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tlclas.classific" id="tlclas.classific"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tlrfin.instruction" id="tlrfin.instruction"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when to_char(f.interval_value)+ 0 &gt; 0 then to_char(f.interval_value)+ 0 ||' months'&#10;       else '0 month'&#10;       end as interval_value" id="interval_value"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_h.psn" id="wo_h.psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_e.event_perfno_i" id="wo_e.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.event_perfno_i" id="f.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.event" id="f.event"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.mevt_headerno_i" id="f.mevt_headerno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.partseqno_i" id="pr.partseqno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.mat_class" id="p.mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.mat_type" id="p.mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.tool" id="p.tool"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ad.vendor" id="ad.vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="l.location" id="l.location"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.classific@">
          <ds:object>@VAR.classific@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.identif@">
          <ds:object>@VAR.identif@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select p.description,
       ti.unit,
       r.partno,
       case when ti.unit = 'MT' and f.expected_date &gt;= -26297 and f.expected_date &lt;= 10227 then 'UNKNOWN' 
        when ti.unit = 'MT' then decode(f.expected_date, 0, null, to_char(to_date('31.12.1971', 'dd.mm.yyyy') + f.expected_date,'dd.mm.yyyy'))
       	end monthly,
       case when ti.unit = 'H'  and f.expected_date &gt;= -26297 and f.expected_date &lt;= 10227 then 'UNKNOWN' 
        when ti.unit = 'H' then decode(f.expected_date, 0, null, to_char(to_date('31.12.1971', 'dd.mm.yyyy') + f.expected_date,'dd.mm.yyyy'))
       	end one_half,
       case when ti.unit = 'YR' and f.expected_date &gt;= -26297 and f.expected_date &lt;= 10227 then 'UNKNOWN' 
         when ti.unit = 'YR' then decode(f.expected_date, 0, null, to_char(to_date('31.12.1971', 'dd.mm.yyyy') + f.expected_date,'dd.mm.yyyy'))
       	end year,
       case when ti.unit = 'D' and f.expected_date &gt;= -26297 and f.expected_date &lt;= 10227 then 'UNKNOWN' 
        when ti.unit = 'D' then decode(f.expected_date, 0, null, to_char(to_date('31.12.1971', 'dd.mm.yyyy') +  f.expected_date, 'dd.mm.yyyy'))
       	end daily,
       case when ti.unit = ' ' and f.expected_date &gt;= -26297 and f.expected_date &lt;= 10227 then 'UNKNOWN' 
         when ti.unit = ' ' then decode(f.expected_date, 0, null, to_char(to_date('31.12.1971', 'dd.mm.yyyy') +  f.expected_date, 'dd.mm.yyyy'))
       	end nothing,
case when f.expected_date_pln &gt;= -26297 and f.expected_date_pln &lt;= 10227 then 'UNKNOWN'
else decode(f.expected_date_pln,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') +
                      f.expected_date_pln,
                      'dd.mm.yyyy'))
end expected_date_pln,
       tlmtno.mat_no,
       tlptno.partno,
       tlslno.sl_no,
       tlidno.ident,
       tlclas.classific,
       tlrfin.instruction,
       case
         when to_char(f.interval_value) + 0 &gt; 0 then
          to_char(f.interval_value) + 0 || ' months'
         else
          '0 month'
       end as interval_value,
       wo_h.psn,
       wo_e.event_perfno_i,
       f.event_perfno_i,
       f.event,
       f.mevt_headerno_i,
       pr.partseqno_i,
       p.mat_class,
       p.mat_type,
       p.tool,
       ad.vendor,
       l.location
  from rotables r
  left join rotables_remarks rr on r.psn = rr.psn
  left join wo_header wo_h on r.psn = wo_h.psn
  left join wo_event_link wo_e on wo_h.event_perfno_i = wo_e.event_perfno_i
  left join forecast f on wo_e.mevt_headerno_i = f.mevt_headerno_i
  left join location l on r.locationno_i = l.locationno_i
  join part p on r.partno = p.partno
  left join part_req pr on p.partseqno_i = pr.partseqno_i
  left join part_add_req a on pr.reqseqno_i = a.reqseqno_i
  left join treq_time_requirement treq on a.add_reqseqno_i = treq.event_key and treq.event_type = 'RORE'
  left join treq_interval_group tg on treq.timerequirementno_i = tg.timerequirementno_i
  left join treq_interval ti on tg.interval_groupno_i = ti.interval_groupno_i
  left join counter_definition cd on cd.counter_defno_i = ti.counter_defno_i
  left join (select rs.remarks partno, psn
               from rotables_special rs
              where rs.special = 'TLPTNO') tlptno on r.psn = tlptno.psn
  left join (select rs.remarks mat_no, psn
               from rotables_special rs
              where rs.special = 'TLMTNO') tlmtno on r.psn = tlmtno.psn
  left join (select rs.remarks sl_no, psn
               from rotables_special rs
              where rs.special = 'TLSLNO') tlslno on r.psn = tlslno.psn
  left join (select rs.remarks ident, psn
               from rotables_special rs
              where rs.special = 'TLIDNO') tlidno on r.psn = tlidno.psn
  left join (select rs.remarks classific, rs.psn
               from rotables_special rs
              where rs.special = 'TLCLAS') tlclas on r.psn = tlclas.psn
   left join (select rs.remarks instruction, rs.psn
               from rotables_special rs
              where rs.special = 'TLRFIN') tlrfin on r.psn = tlrfin.psn
  join location l on r.locationno_i = l.locationno_i
  join (select a.vendor, a.name, a.name_1
          from Address a
         where a.name = 'LISTOFTL') ad on l.store = ad.vendor
 where p.mat_type = 'T'
   and p.tool = 'Y'
   and l.station = 'SVO'
/* Partnumber */
 and ('@VAR.partno@' is null or
 tlptno.partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
/* Serialno */
 and ('@VAR.serialno@' is null or
 tlslno.sl_no in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))
/* Classification */
and (
nvl(@VAR.classific@, 1) = 1 or (@VAR.classific@ = 2 and tlclas.classific = 'ON CONDITION') or (@VAR.classific@ = 3 and tlclas.classific = 'SERVICE')
or (@VAR.classific@ = 4 and tlclas.classific = 'CALIBRATION') or (@VAR.classific@ = 5 and tlclas.classific = 'CALIBRATION &amp; SERVICE')
)
/* Identification No */
 and ('@VAR.identif@' is null or
 tlidno.ident in
 (select trim(substr('@VAR.identif@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.identif@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.identif@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.identif@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.identif@') -
              length(replace('@VAR.identif@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
