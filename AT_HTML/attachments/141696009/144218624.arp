      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="WP" description="Worckpackage" id="wp"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Workpackage" id="wp">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Fail_Wp_Transfer" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Отчёт по сбою AMOS</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY created_datewpno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpno" id="wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="station" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="start_date_time" id="start_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="end_date_time" id="end_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_start_date_time" id="act_start_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_end_date_time" id="act_end_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_mutation" id="last_mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="is_released" id="is_released"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="responsible" id="responsible"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_trf_date_time" id="last_trf_date_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" /* Last transfer date and time */&#10;       nvl(total_cnt_of_transfers0)" id="x16"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="/* Total count of tranfers */&#10;       last_transfer_success" id="last_transfer_success"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_transfer_error_message" id="last_transfer_error_message"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case&#10;         when trunc(last_mutation 'mi') &gt;&#10;              nvl(last_trf_date_time to_date('31.12.1971' 'dd.mm.yyyy')) then&#10;          (trunc(last_mutation 'mi') -&#10;          nvl(last_trf_date_time to_date('31.12.1971''dd.mm.yyyy'))) * 24 * 60&#10;       &#10;         else&#10;          0&#10;       end transfer_delay_min" id="transfer_delay_min"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.wp@">
          <ds:object>@VAR.wp@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY created_date, wpno) num,
       wpno,
       case
         when description = 'STANDARD WORKPACKAGE' then
          'STAND WP'
         else
          description
       end description,
       ac_registr,
       ac_typ,
       station,
       start_date_time,
       end_date_time,
       act_start_date_time,
       act_end_date_time,
       created_date,
       last_mutation,
       is_released,
       responsible,
       last_trf_date_time, /* Last transfer date and time */
       nvl(total_cnt_of_transfers, 0), /* Total count of tranfers */
       last_transfer_success,
       last_transfer_error_message,
       case
         when trunc(last_mutation, 'mi') &gt;
              nvl(last_trf_date_time, to_date('31.12.1971', 'dd.mm.yyyy')) then
          round((trunc(last_mutation, 'mi') -
                nvl(last_trf_date_time, to_date('31.12.1971', 'dd.mm.yyyy'))),
                3) * 24 * 60
         else
          0
       end transfer_delay_min
  from (select wp.wpno,
               wp.wpno_i,
               wp.description,
               wp.ac_registr,
               wp.ac_typ,
               wp.station,
               wp.start_date_time,
               wp.end_date_time,
               wp.act_start_date_time,
               wp.act_end_date_time,
               wp.created_date,
               wp.last_mutation,
               wp.is_released,
               wp.responsible,
               k.last_trf_date_time, /* Last transfer date and time */
               nvl(k.cnt_per_source_key, 0) total_cnt_of_transfers, /* Total count of tranfers */
               k.success last_transfer_success,
               k.error_message last_transfer_error_message
          from /* Difference tables aim_transfer_history and wp_header */
		       (select wpno_i
                  from (select source_key_i wpno_i
                          from (select h.*,
                                       max(histno_i) over(partition by source_key_i) max_histno_i,
                                       count(1) over(partition by source_key_i) cnt_per_source_key
                                  from aim_transfer_history h
                                 where service = 'EXPORT_WORKPACKAGE_PLANNING'
                                   and source_type = 'WP') t
                         where t.histno_i = max_histno_i
                        minus
                        select wpno_i from wp_header h) wp_difference) wp_diff
          join (select wpno_i,
                      wpno,
                      ac_registr,
                      ac_typ,
                      station,
                      to_date('31.12.1971', 'dd.mm.yyyy') + start_date +
                      start_time / 24 / 60 start_date_time,
                      to_date('31.12.1971', 'dd.mm.yyyy') + end_date +
                      end_time / 24 / 60 end_date_time,
                      case
                        when act_start_date &gt; 0 then
                         to_date('31.12.1971', 'dd.mm.yyyy') + act_start_date +
                         act_start_time / 24 / 60
                        else
                         null
                      end act_start_date_time,
                      case
                        when act_end_date &gt; 0 then
                         to_date('31.12.1971', 'dd.mm.yyyy') + act_end_date +
                         act_end_time / 24 / 60
                        else
                         null
                      end act_end_date_time,
                      to_date('31.12.1971', 'dd.mm.yyyy') + h.created_date created_date,
                      is_released,
                      h.description,
                      rtrim(decode(h.responsible,
                                   null,
                                   null,
                                   '[' || h.responsible || '] ') ||
                            n.lastname || ' ' || n.firstname) responsible,
                      to_date('31.12.1971', 'dd.mm.yyyy') + h.mutation +
                      h.mutation_time / 24 / 60 / 60 / 1000 last_mutation
                 from wp_header h
                 left join sign n on h.responsible = n.user_sign) wp on wp_diff.wpno_i =
                                                                        wp.wpno_i
          left join (select success,
                           error_message,
                           source_key_i,
                           to_date('31.12.1971', 'dd.mm.yyyy') + trf_date +
                           trf_time / 24 / 60 last_trf_date_time,
                           cnt_per_source_key
                      from (select h.*,
                                   max(histno_i) over(partition by source_key_i) max_histno_i,
                                   count(1) over(partition by source_key_i) cnt_per_source_key
                              from aim_transfer_history h
                             where service = 'EXPORT_WORKPACKAGE_PLANNING'
                               and source_type = 'WP') t
                     where t.histno_i = max_histno_i) k on wp.wpno_i =
                                                           k.source_key_i) t
 where /* Last WP mutation more than last transfer date and time of this WP */
 ((trunc(last_mutation, 'mi') -
 nvl(last_trf_date_time, to_date('31.12.1971', 'dd.mm.yyyy'))) * 24 * 60 &gt; 1
 /* Last transfer finished unsuccesfully */
 or nvl(last_transfer_success, 'N') != 'Y')
 /* Workpackage*/
and ('@VAR.wp@' is null or
 wpno_i in
 (select trim(substr('@VAR.wp@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.wp@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.wp@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.wp@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.wp@') -
              length(replace('@VAR.wp@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
