  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Leg_Removal_320" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno" id="history.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno" id="history.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.location" id="history.location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.ac_registr" id="history.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;&#9;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date+729)'DD.MM.YYYY') rem_date" id="rem_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.event_perfno_i" id="history.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.labelno" id="history.labelno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 	part.description, 
		history.partno, 
		history.serialno, 
		history.location, 
		history.ac_registr,
		TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date+729), 'DD.MM.YYYY') rem_date,
		history.event_perfno_i,
		history.labelno
FROM history
LEFT JOIN part ON part.partno = history.partno
WHERE (history.location = '3221N01-A32S-A' OR history.location = '3221N38-A32S-B' OR history.location = '3211L01-A32S' 
OR history.location = '3211L21-A32S' OR history.location = '3211L22-A32S' OR history.location = '3211R01-A32S'
OR history.location = '3211R21-A32S' OR history.location = '3211R22-A32S') AND history.vm = 'YA' 
and history.del_date  &gt;= TRUNC (SYSDATE) - TO_DATE ('31.12.1971', 'dd.mm.yyyy') - 90 and history.del_date &lt;= TRUNC (SYSDATE) - TO_DATE ('31.12.1971', 'dd.mm.yyyy')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
