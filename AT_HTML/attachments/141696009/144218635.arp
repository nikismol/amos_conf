  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="BOOL" description="Alternate part check-box" id="altpart"/>
        <ds:columnDescriptor amosType="PA" description="Partnumber" id="partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Include alternate part`s" id="altpart">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Partnumber`s" id="partno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>3-1530</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Orders_Comp_Stock_GROUP" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Partno grouping</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="bees.partno partno" id="partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.altpart@">
          <ds:object>@VAR.altpart@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select partno
	from
		(select bees.partno
			from od_header no
				join od_detail bees on no.orderno_i = bees.orderno_i and bees.state = 'O' 
				join rotables honey on bees.psn = honey.psn and honey.locationno_i &lt;&gt; -1
			where no.ext_state in (
				 'O',
				 'BO',
				 'PR'
			  ) 
			union
		select bees.partno
			from od_header no
				join od_detail bees on no.orderno_i = bees.orderno_i and bees.state = 'O' 
				join consumables work on bees.partno = work.partno
			where no.ext_state in (
				 'O',
				 'BO',
				 'PR'
			  ) ) x
	where /* Партийный номер */
	('@VAR.partno@' is null or
	  partno in
	 (select trim(substr('@VAR.partno@' || ',',
						  decode(level,
								 1,
								 0,
								 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
						  instr('@VAR.partno@' || ',', ',', 1, level) -
						  decode(level,
								 1,
								 1,
								 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
		 from dual
	   connect by level &lt;= length('@VAR.partno@') -
				  length(replace('@VAR.partno@', ',', '')) + 1))
	group by partno
union
select partno
	from
		(select money.altpartno partno
			from od_header no
				join od_detail bees on no.orderno_i = bees.orderno_i and bees.state = 'O' 
				join part_alternate money on bees.partno = money.partno
				join rotables honey on bees.psn = honey.psn and honey.locationno_i &lt;&gt; -1
			where no.ext_state in (
				 'O',
				 'BO',
				 'PR'
			  ) 
			union
		select money.altpartno partno
			from od_header no
				join od_detail bees on no.orderno_i = bees.orderno_i and bees.state = 'O' 
				join part_alternate money on bees.partno = money.partno
				join consumables work on bees.partno = work.partno 
			where no.ext_state in (
				 'O',
				 'BO',
				 'PR'
			  ) ) x
	where /* Партийный номер */
	('@VAR.partno@' is null or
	  partno in
	 (select trim(substr('@VAR.partno@' || ',',
						  decode(level,
								 1,
								 0,
								 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
						  instr('@VAR.partno@' || ',', ',', 1, level) -
						  decode(level,
								 1,
								 1,
								 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
		 from dual
	   connect by level &lt;= length('@VAR.partno@') -
				  length(replace('@VAR.partno@', ',', '')) + 1))
	and '@VAR.altpart@' = 'Y'
	group by partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Orders_Comp_Stock_TOTAL_STOCK" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Total Stock qty</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(inac.psn) inac" id="inac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(rest.psn) rest" id="rest"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(stand.psn) stand" id="stand"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(rest.psn) + count(stand.psn) total" id="total"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Orders_Comp_Stock_GROUP.partno@">
          <ds:object>@RMX_Orders_Comp_Stock_GROUP.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select r.partno partno, count(inac.psn) inac, count(rest.psn) rest, count(stand.psn) stand
, count(rest.psn) + count(stand.psn) total
	from rotables r 	
		join location l on r.locationno_i = l.locationno_i 	
		join entity_header eh on r.entityno_i = eh.entityno_i 	
		left join (select psn, location.locationno_i
					  from rotables 
					  join location on rotables.locationno_i = location.locationno_i 
					  where location_restriction = 2) inac on r.psn = inac.psn and l.locationno_i = inac.locationno_i
		left join (select psn, location.locationno_i
					  from rotables 
					  join location on rotables.locationno_i = location.locationno_i 
					  where location_restriction = 1) rest on r.psn = rest.psn and l.locationno_i = rest.locationno_i
		left join (select psn, location.locationno_i
					  from rotables 
					  join location on rotables.locationno_i = location.locationno_i 
					  where location_restriction = 0) stand on r.psn = stand.psn and l.locationno_i = stand.locationno_i
	where r.partno in ('@RMX_Orders_Comp_Stock_GROUP.partno@')      
		  and r.ac_registr in (
			 ' ',
			 'TRANSF'       
		  )       
		  and r.partnonew = ' '       
		  and r.condition &lt;&gt; 'US'       
		  and (
			 r.outgoing_detailno_i is null          
			 or r.locationno_i &lt;&gt; -200       
		  )       
		  and l.location_type not in(
			 '-3',
			 '-107'
		  )
	group by r.partno
union
select c.partno partno, count(inac.partno) inac, count(rest.partno) rest, count(stand.partno) stand
, count(rest.partno) + count(stand.partno) total
	from consumables c	
		join location l on c.locationno_i = l.locationno_i 	
		join entity_header eh on c.entityno_i = eh.entityno_i 	
		left join (select partno, location.locationno_i
					  from consumables 
					  join location on consumables.locationno_i = location.locationno_i 
					  where location_restriction = 2) inac on c.partno = inac.partno and l.locationno_i = inac.locationno_i
		left join (select partno, location.locationno_i
					  from consumables 
					  join location on consumables.locationno_i = location.locationno_i 
					  where location_restriction = 1) rest on c.partno = rest.partno and l.locationno_i = rest.locationno_i
		left join (select partno, location.locationno_i
					  from consumables 
					  join location on consumables.locationno_i = location.locationno_i 
					  where location_restriction = 0) stand on c.partno = stand.partno and l.locationno_i = stand.locationno_i
	where c.partno in ('@RMX_Orders_Comp_Stock_GROUP.partno@')      
		  and c.qty &gt; 0
		  and l.location_type not in(
			 '-3',
			 '-107'
		  )
          and (
         c.condition &lt;&gt; 'US'
         or c.condition IS NULL
      )  
	group by c.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Orders_Comp_Stock_ORDERS" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Information about Orders</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY no.orderdateno.orderno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="orderno" id="orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(no.orderno) qty_pos" id="qty_pos"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(no.orderdate 0 null to_char(to_date('31.12.1971' 'dd.mm.yyyy') + no.orderdate'dd.mm.yyyy')) orderdate" id="orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="vendor" id="vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="work.name addressname" id="addressname"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Orders_Comp_Stock_GROUP.partno@">
          <ds:object>@RMX_Orders_Comp_Stock_GROUP.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY orderdate, orderno) num,
	   orderno,
       qty_pos,
       orderdate,
	   vendor,
	   addressname
 from (
	select no.orderno,
		   count(no.orderno) qty_pos,
		   decode(no.orderdate, 0, null, to_char(to_date('31.12.1971', 'dd.mm.yyyy') + no.orderdate, 'dd.mm.yyyy')) orderdate,
		   bees.vendor,
		   work.name addressname,
		   bees.partno
		from od_header no 
		join od_detail bees on no.orderno_i = bees.orderno_i and bees.state = 'O' 
		join rotables honey on bees.psn = honey.psn
		left join address work on no.vendor = work.vendor
		where no.ext_state in (
				 'O',
				 'BO',
				 'PR'
			  ) 
		group by no.orderno, no.orderdate, bees.vendor, work.name, bees.partno
	union
	select no.orderno,
		   count(no.orderno) qty_pos,
		   decode(no.orderdate, 0, null, to_char(to_date('31.12.1971', 'dd.mm.yyyy') + no.orderdate, 'dd.mm.yyyy')) orderdate,
		   bees.vendor,
		   work.name addressname,
		   bees.partno
		from od_header no 
		join od_detail bees on no.orderno_i = bees.orderno_i and bees.state = 'O' 
		join consumables money on bees.partno = money.partno
		left join address work on no.vendor = work.vendor
		where no.ext_state in (
				 'O',
				 'BO',
				 'PR'
			  ) 
		group by no.orderno, no.orderdate, bees.vendor, work.name, bees.partno
	) x
	where partno in ('@RMX_Orders_Comp_Stock_GROUP.partno@')  </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Orders_Comp_Stock_LOCATIONS" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Components QTY on Locations</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.partno partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="l.location" id="l.location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(inac.psn) inac" id="inac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(rest.psn) rest" id="rest"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(stand.psn) stand" id="stand"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(r.psn) total_qty" id="total_qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Orders_Comp_Stock_GROUP.partno@">
          <ds:object>@RMX_Orders_Comp_Stock_GROUP.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select r.partno partno, l.location, count(inac.psn) inac, count(rest.psn) rest, count(stand.psn) stand, count(r.psn) total_qty
	from rotables r 	
		join location l on r.locationno_i = l.locationno_i 	
		join entity_header eh on r.entityno_i = eh.entityno_i 
	    left join (select psn, location.locationno_i
					  from rotables 
					  join location on rotables.locationno_i = location.locationno_i 
					  where location_restriction = 2) inac on r.psn = inac.psn and l.locationno_i = inac.locationno_i
		left join (select psn, location.locationno_i
					  from rotables 
					  join location on rotables.locationno_i = location.locationno_i 
					  where location_restriction = 1) rest on r.psn = rest.psn and l.locationno_i = rest.locationno_i
		left join (select psn, location.locationno_i
					  from rotables 
					  join location on rotables.locationno_i = location.locationno_i 
					  where location_restriction = 0) stand on r.psn = stand.psn and l.locationno_i = stand.locationno_i
	where r.partno in ('@RMX_Orders_Comp_Stock_GROUP.partno@')      
		  and r.ac_registr in (
			 ' ',
			 'TRANSF'       
		  )       
		  and r.partnonew = ' '       
		  and r.condition &lt;&gt; 'US'       
		  and (
			 r.outgoing_detailno_i is null          
			 or r.locationno_i &lt;&gt; -200       
		  )       
		  and l.location_type not in(
			 '-3',
			 '-107'
		  )
group by r.partno, l.location
union
select c.partno partno, l.location, count(inac.partno) inac, count(rest.partno) rest, count(stand.partno) stand, count(c.partno) total_qty
	from consumables c	
		join location l on c.locationno_i = l.locationno_i 	
		join entity_header eh on c.entityno_i = eh.entityno_i 	
		left join (select partno, location.locationno_i
					  from consumables 
					  join location on consumables.locationno_i = location.locationno_i 
					  where location_restriction = 2) inac on c.partno = inac.partno and l.locationno_i = inac.locationno_i
		left join (select partno, location.locationno_i
					  from consumables 
					  join location on consumables.locationno_i = location.locationno_i 
					  where location_restriction = 1) rest on c.partno = rest.partno and l.locationno_i = rest.locationno_i
		left join (select partno, location.locationno_i
					  from consumables 
					  join location on consumables.locationno_i = location.locationno_i 
					  where location_restriction = 0) stand on c.partno = stand.partno and l.locationno_i = stand.locationno_i
	where c.partno in ('@RMX_Orders_Comp_Stock_GROUP.partno@')      
		  and c.qty &gt; 0
		  and l.location_type not in(
			 '-3',
			 '-107'
		  )
          and (
         c.condition &lt;&gt; 'US'
         or c.condition IS NULL
      )  
	group by c.partno, l.location</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
