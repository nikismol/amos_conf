            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Open_Orders_Stat_OD_TYP" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Order type</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="odh.order_type" id="odh.order_type"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_end@">
          <ds:object>@VAR.date_end@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.hod_from@">
          <ds:object>@VAR.hod_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.hod_end@">
          <ds:object>@VAR.hod_end@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ordern@">
          <ds:object>@VAR.ordern@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ordern_y@">
          <ds:object>@VAR.ordern_y@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT odh.order_type
FROM od_header odh
WHERE (odh.order_type in ('P')
	or odh.order_type in ('PX') 
	or odh.order_type in ('PR')
	or odh.order_type in ('PU')
	or odh.order_type in ('L')
	or odh.order_type in ('LU')
    or odh.order_type in ('Y')
	or odh.order_type in ('YU')
	or odh.order_type in ('R') 
	or odh.order_type in ('X'))
   and (odh.state = 'O' and odh.ext_state in ('O', 'B', 'BO'))
/* Дата последнего изменения */
 and ('@VAR.date_from@' is null or odh.mutation &gt;= '@VAR.date_from@')
 and ('@VAR.date_end@' is null or odh.mutation &lt;= '@VAR.date_end@')
/* Дата ордера */
 and ('@VAR.hod_from@' is null or odh.orderdate &gt;= '@VAR.hod_from@')
 and ('@VAR.hod_end@' is null or orderdate &lt;= '@VAR.hod_end@')
/* Order No */
and ('@VAR.ordern@' is null or
odh.orderno in
 (select trim(substr('@VAR.ordern@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.ordern@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.ordern_y@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.ordern@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.ordern@') -
              length(replace('@VAR.ordern@', ',', '')) + 1))
   group by odh.order_type
   order by odh.order_type</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Open_Orders_Stat" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Открытые заказы в статусе Open / Booked</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY mutationorderno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="orderno" id="orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="state" id="state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ext_state" id="ext_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case&#10;         when ext_state = 'O' then&#10;          'OPEN'&#10;         when ext_state in ('B''BO') then&#10;          'BOOKED'&#10;         else&#10;          'NO VALUES'&#10;       end status" id="status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="order_type" id="order_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(mutation&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + mutation'dd.mm.yyyy')) mutation" id="mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="orderdate" id="orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mutator" id="mutator"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RAM_Open_Orders_Stat_OD_TYP.odh.order_type@">
          <ds:object>@RAM_Open_Orders_Stat_OD_TYP.odh.order_type@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_end@">
          <ds:object>@VAR.date_end@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.hod_from@">
          <ds:object>@VAR.hod_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.hod_end@">
          <ds:object>@VAR.hod_end@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ordern@">
          <ds:object>@VAR.ordern@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ordern_y@">
          <ds:object>@VAR.ordern_y@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY mutation, orderno) num,
       orderno,
       state,
       ext_state,
       case
         when ext_state = 'O' then
          'OPEN'
         when ext_state in ('B', 'BO') then
          'BOOKED'
         else
          'NO VALUES'
       end status,
       order_type,
       decode(mutation,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + mutation,
                               'dd.mm.yyyy')) mutation,
       decode(orderdate,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + orderdate,
                               'dd.mm.yyyy')) orderdate,
       mutator
  from od_header
 where order_type = '@RAM_Open_Orders_Stat_OD_TYP.odh.order_type@'
   and (state = 'O' and ext_state in ('O', 'B', 'BO'))
/* Дата последнего изменения */
 and ('@VAR.date_from@' is null or mutation &gt;= '@VAR.date_from@')
 and ('@VAR.date_end@' is null or mutation &lt;= '@VAR.date_end@')
/* Дата ордера */
 and ('@VAR.hod_from@' is null or orderdate &gt;= '@VAR.hod_from@')
 and ('@VAR.hod_end@' is null or orderdate &lt;= '@VAR.hod_end@')
/* Order No */
and ('@VAR.ordern@' is null or
orderno in
 (select trim(substr('@VAR.ordern@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.ordern@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.ordern_y@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.ordern@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.ordern@') -
              length(replace('@VAR.ordern@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
