  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="PR" description="Project No" id="projectno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Description" id="desc"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Project No" id="projectno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Наим. договора КАСУД" id="desc">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Contruct_Search" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Поиск договоров по названию КАСУД</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.projectno" id="p.projectno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="l.description" id="l.description"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.projectno@">
          <ds:object>@VAR.projectno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.desc@">
          <ds:object>@VAR.desc@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select p.projectno, l.description
  from db_link l, project p
 where l.source_type = 'PR'
   and l.source_pk = p.projectno_i
   /* Project No */
   and ('@VAR.projectno@' is null or
       p.projectno_i in
       (select trim(substr('@VAR.projectno@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.projectno@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2),
                            instr('@VAR.projectno@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.projectno@' || ',',
                                         ',',
                                         1,
                                         level - 1) + 2)))
           from dual
         connect by level &lt;= length('@VAR.projectno@') -
                    length(replace('@VAR.projectno@', ',', '')) + 1))
	 /* Description */
   and ('@VAR.desc@' is null or lower(l.description) like lower('%@VAR.desc@%'))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
