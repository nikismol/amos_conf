    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Order_Management" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Related orders &amp; Hierarchy</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rownum" id="rownum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t1.lev" id="t1.lev"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.orderno_i" id="h.orderno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t1.orderno t_orderno" id="t_orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t1.state t1_state_head" id="t1_state_head"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.status d_status_det" id="d_status_det"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t1.vendor" id="t1.vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(t1.orderdate&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + t1.orderdate'dd.mm.yyyy')) t1_orderdate" id="t1_orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.orderno root" id="root"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.state h_state_head" id="h_state_head"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d1.status d1_status_det" id="d1_status_det"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.vendor" id="h.vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.created_from_orderno_i" id="h.created_from_orderno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(h.orderdate&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + h.orderdate'dd.mm.yyyy')) h_orderdate" id="h_orderdate"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.hod_from@">
          <ds:object>@VAR.hod_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.hod_end@">
          <ds:object>@VAR.hod_end@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ordern_x@">
          <ds:object>@VAR.ordern_x@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.hod_from_y@">
          <ds:object>@VAR.hod_from_y@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.hod_end_y@">
          <ds:object>@VAR.hod_end_y@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ordern_y@">
          <ds:object>@VAR.ordern_y@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select rownum,
       t1.lev,
       h.orderno_i,
       t1.orderno t_orderno,
       case when t1.state = 'O' then 'OPEN'  
            when t1.state = 'C' then 'CANCELLED'
            else 'NO STATUS'
            end as t1_state_head,
       case when d.status = '0' then 'Open order'  
            when d.status = '1' then 'Is booked but stays open'
            when d.status = '2' then 'Is in Repair Administration'
            when d.status = '3' then 'Is sent to LHT'
            when d.status = '4' then 'Is in Electronic Pending Shelf'
            when d.status = '5' then 'Is a stock access order'
            else 'NO STATUS'
            end as d_status_det,
       t1.vendor,
       decode(t1.orderdate,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + t1.orderdate,
                               'dd.mm.yyyy')) t1_orderdate,
       h.orderno root,
       case when h.state = 'O' then 'OPEN'  
            when h.state = 'C' then 'CANCELLED'
            else 'NO STATUS'
            end as h_state_head,
       case when d1.status = '0' then 'Open order'  
            when d1.status = '1' then 'Is booked but stays open'
            when d1.status = '2' then 'Is in Repair Administration'
            when d1.status = '3' then 'Is sent to LHT'
            when d1.status = '4' then 'Is in Electronic Pending Shelf'
            when d1.status = '5' then 'Is a stock access order'
            else 'NO STATUS'
            end as d1_status_det,
       h.vendor,
       h.created_from_orderno_i,
       decode(h.orderdate,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + h.orderdate,
                               'dd.mm.yyyy')) h_orderdate
  from (select level lev,
               orderno_i,
               orderno,
               created_from_orderno_i,
               orderdate,
               order_type,
               state,
               vendor,
               connect_by_root orderno as root
          from od_header
         where order_type in ('X', 'Y')
           and level &gt; 1
         start with created_from_orderno_i = 0
        connect by prior orderno_i = created_from_orderno_i
        /* ORDER SIBLINGS BY orderno_i*/
        ) t1
  join od_header h on t1.root = h.orderno
  join (select orderno_i, status from od_detail) d1 on h.orderno_i =
                                                       d1.orderno_i
  join od_detail d on t1.orderno_i = d.orderno_i
 where h.order_type in ('X', 'Y')
/* Дата ордера типа 'X' */
 and ('@VAR.hod_from@' is null or h.orderdate &gt;= '@VAR.hod_from@')
 and ('@VAR.hod_end@' is null or h.orderdate &lt;= '@VAR.hod_end@')
/* Order No type 'X'*/
and ('@VAR.ordern_x@' is null or
 h.orderno in
 (select trim(substr('@VAR.ordern_x@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.ordern_x@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.ordern_x@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.ordern_x@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.ordern_x@') -
              length(replace('@VAR.ordern_x@', ',', '')) + 1))
/* Дата ордера типа 'Y' */
 and ('@VAR.hod_from_y@' is null or t1.orderdate &gt;= '@VAR.hod_from@')
 and ('@VAR.hod_end_y@' is null or t1.orderdate &lt;= '@VAR.hod_end@')
/* Order No type 'Y'*/
and ('@VAR.ordern_y@' is null or
 t1.orderno in
 (select trim(substr('@VAR.ordern_y@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.ordern_y@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.ordern_y@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.ordern_y@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.ordern_y@') -
              length(replace('@VAR.ordern_y@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
