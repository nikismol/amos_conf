  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="CHTI" description="internal check" id="check"/>
        <ds:columnDescriptor amosType="ATA" description="ata chapter" id="ata"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Форма ТО" id="check">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="ATA" id="ata">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="114_Taskcard_SKILL" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Просмотр квалификационного кода по taskcard`ам</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="effectivity_linkno_i" id="effectivity_linkno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mpno ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="m.taskcardno" id="m.taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="internal_check" id="internal_check"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="woh.ata_chapter" id="woh.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="property_type_id" id="property_type_id"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="char_value" id="char_value"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.check@">
          <ds:object>@VAR.check@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ata@">
          <ds:object>@VAR.ata@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select effectivity_linkno_i
    , mpno ac_typ
    , m.taskcardno
    , internal_check
    , woh.ata_chapter
    , property_type_id
    , char_value
from msc_maintenance_program a /* отсюда беру тип самолёта */
join msc_requirement_tc_link m on a.mpno_i = m.mpno_i_operator /* выбираю линки */
join requirement_link r on m.req_linkno_i = r.source
join (select distinct effectivity_linkno_i, event_key_parent
        from wo_event_link e
        where pending_status &lt; 0 and event_type = 'CHTI') e on r.target = e.effectivity_linkno_i and r.source_mimetype = 'TCREQLI'
join msc_mprev_taskcards mp_rev on m.taskcard_verno_i_mri = mp_rev.taskcard_verno_i
join msc_mp_revision rev on mp_rev.revisionno_i = rev.revisionno_i and rev.revision_status not in ('i', 't')
    /* ищу чеки */
join check_type_int c on e.event_key_parent = c.check_intno_i 
    /* ищу данные по SKILL */
join msc_item mi on m.taskcard_verno_i_mri = mi.taskcard_verno_i
join worktemplate_link wt on mi.itemno_i = wt.event_key and event_type = 'TI'
join event_template s on wt.template_revisionno_i = s.template_revisionno_i and s.revision_status = 1  
join wo_header woh on wt.template_revisionno_i = woh.template_revisionno_i and woh.type = 'T'
join workstep_link wl on woh.event_perfno_i = wl.event_perfno_i and sequenceno = 1
join rm_resource_request  rr on wl.descno_i = rr.request_owner_amos_key
join rm_resource_requirement r_req on rr.resource_request_noi = r_req.resource_request_noi
join rm_resource_constraint con on r_req.resource_requirement_noi = con.resource_requirement_noi
join rm_property_type prt on con.property_type_no_i = prt.property_type_no_i
where property_type_id = 'SKILL'
    /* check */
     and ('@VAR.check@' is null or
		 check_intno_i in
		 (select trim(substr('@VAR.check@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.check@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.check@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.check@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.check@') -
					  length(replace('@VAR.check@', ',', '')) + 1))
     /* ata */
     and ('@VAR.ata@' is null or
		 woh.ata_chapter in
		 (select trim(substr('@VAR.ata@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.ata@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.ata@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.ata@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.ata@') -
					  length(replace('@VAR.ata@', ',', '')) + 1))
order by char_value, m.taskcardno </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
