  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Dismissed_Employee" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT&#10;              &#9;NVL(sign.user_signb.sign) as sign" id="sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="b.department" id="b.department"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="b.department_name" id="b.department_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="b.FI" id="b.FI"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN  wta.sign_performed IS NULL  THEN 'N' ELSE 'Y' END as closedWS" id="closedWS"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;              &#9;TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + b.end_date'DD.MM.YYYY') as last_date_booking" id="last_date_booking"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="b.event_name" id="b.event_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="b.eventno" id="b.eventno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;                    &#9;WHEN  b.hidden = 'L' THEN 'Line Maintenance'&#10;                   &#9; WHEN  b.hidden = 'H' THEN 'Heavy Maintenance'&#10;                    &#9;WHEN  b.hidden = 'I' THEN 'Hidden'&#10;                    &#9;WHEN  ASCII(b.hidden) = 49824 THEN 'Unspecified'&#10;              &#9;END Classification" id="Classification"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT
              NVL(sign.user_sign, b.sign) as sign,   
               b.department,
              b.department_name,
              b.FI,
              CASE WHEN  wta.sign_performed IS NULL  THEN 'N' ELSE 'Y' END as closedWS, 
              TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + b.end_date, 'DD.MM.YYYY') as last_date_booking,
              b.event_name,
               b.eventno,
              CASE
                             WHEN  b.hidden = 'L' THEN 'Line Maintenance'
                             WHEN  b.hidden = 'H' THEN 'Heavy Maintenance'
                             WHEN  b.hidden = 'I' THEN 'Hidden'
                             ELSE 'Unspecified'
               END Classification
FROM sign
              LEFT JOIN (
                            SELECT
                                          time_captured.user_sign as sign,
                                          MAX(time_captured.bookingno_i) OVER (PARTITION BY time_captured.user_sign) as max_bookingno_i,
                                          time_captured.bookingno_i,
                                           time_captured.end_date,
                                          wo_event_link.event_name,
                                          time_captured.primkey as eventno,
                                          wp_header.hidden,
                                          sign.company_new,
                                          sign.firstname || ' ' || sign.lastname AS FI,
                                          sign.department AS department,
                                          address.name AS department_name
                            FROM time_captured
                                          LEFT JOIN workstep_link ON time_captured.primkey = workstep_link.event_perfno_i AND workstep_link.sequenceno = 1
                                          JOIN wo_header ON time_captured.primkey = wo_header.event_perfno_i
                                          JOIN wp_assignment ON wp_assignment.event_perfno_i=wo_header.event_perfno_i
                                          JOIN wp_header ON wp_assignment.wpno_i=wp_header.wpno_i
                                          JOIN sign ON time_captured.user_sign =sign.user_sign
                                          JOIN address ON sign.department = address.vendor
                                          LEFT JOIN wo_event_link ON wo_header.event_perfno_i=wo_event_link.event_perfno_i
                            WHERE 1=1
                                           AND wo_header.state &lt;&gt; 'V'
                                          AND REGEXP_LIKE(sign.user_sign, '^[0-9]+$')
                                          AND (sign.company_new = 'AFL' OR sign.company = 'AFL' OR  sign.company_new IS NULL OR ASCII(sign.company_new) = 49824 )
                                          AND (
                                                         sign.status = 9
                                                         OR sign.expire_date &lt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))
                                                      )
                                       ) b ON sign.user_sign = b.sign AND max_bookingno_i = bookingno_i
	LEFT JOIN (
                       	SELECT distinct wo_text_action.sign_performed
                       	FROM wo_text_action
                    	) wta ON sign.user_sign = wta.sign_performed
WHERE 1=1
                AND REGEXP_LIKE(sign.user_sign, '^[0-9]+$')
                AND (sign.company_new = 'AFL' OR sign.company = 'AFL' OR  sign.company_new IS NULL OR ASCII(sign.company_new) = 49824 )
                AND (
                           sign.status = 9
                           OR sign.expire_date &lt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))
                           )
ORDER BY 1, 2
</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
