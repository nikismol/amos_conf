              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Серийный номер" id="serialno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_current_state" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Текущее состояние компонентов</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY hz.partno hz.serialnohz.historyno_i) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   mod((row_number() over(ORDER BY hz.partno hz.serialno hz.historyno_i))2) even_num" id="even_num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz.psn" id="hz.psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz.partno" id="hz.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz.serialno" id="hz.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="vm.description action" id="action"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="higher_partno" id="higher_partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="higher_serialno" id="higher_serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(hz.created_date&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + hz.created_date'dd.mm.yyyy')) date_tran" id="date_tran"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz.station" id="hz.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz.store" id="hz.store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz.location" id="hz.location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when hz.qty &lt;= 1 then hz.qty&#10;&#9;   else 0&#10;&#9;   end qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz.orderno" id="hz.orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(orderdate&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + orderdate'dd.mm.yyyy')) orderdate" id="orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="null as &quot;null&quot;" id="null"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r.psn r_psn" id="r_psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz.historyno_i" id="hz.historyno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when r.ac_registr is null then hz.ac_registr&#10;            else r.ac_registr&#10;            end ac_registr" id="ac_registr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY hz.partno, hz.serialno, hz.historyno_i) num,
	   mod((row_number() over(ORDER BY hz.partno, hz.serialno, hz.historyno_i)), 2) even_num,
	   hz.psn,
       hz.partno,
       hz.serialno,
       vm.description action,
       r.partnonew higher_partno,
       r.serialnonew higher_serialno, 
       to_date('31.12.1971', 'dd.mm.yyyy') + hz.mutation +
                      hz.mutation_time / 24 / 60 / 60 / 1000 date_tran,
       hz.station,
       hz.store,
       hz.location,
       case when hz.qty &gt;= 1 then trunc(hz.qty, 0)
	   else 0
	   end qty,
       hz.orderno,
       decode(hz.orderdate,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + hz.orderdate,
                      'dd.mm.yyyy')) orderdate,
	   null as "null",
	   r.psn r_psn,
	   hz.historyno_i,
       case when r.ac_registr is null then hz.ac_registr
            else r.ac_registr
            end ac_registr
  from (select max(historyno_i) historyno_i from history where serialno &lt;&gt; ' ' group by partno, serialno) h
  join history hz on h.historyno_i = hz.historyno_i
  left join rotables r on hz.psn = r.psn
  join voucher_mode vm on hz.vm = vm.vm
 where /* Part number */
 ('@VAR.partno@' is null or
hz.partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
/* Serial number */
and ('@VAR.serialno@' is null or
hz.serialno in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_history_grouped" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Группировка part number/serial number</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="serialno" id="serialno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select partno, serialno
from history h
where /* Part number */
 ('@VAR.partno@' is null or
partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
/* Serial number */
and ('@VAR.serialno@' is null or
serialno in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))
group by partno, serialno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_history_assembly" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>История сборки</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY date_tranhz_historyno_i) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   mod((row_number() over(ORDER BY date_tran hz_historyno_i))2) even_num" id="even_num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" &#10;       to_date('31.12.1971''dd.mm.yyyy') + hz.mutation +&#10;                      hz.mutation_time / 24 / 60 / 60 / 1000 date_tran" id="date_tran"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz_historyno_i" id="hz_historyno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz_psn" id="hz_psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz_partno" id="hz_partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz_serialno" id="hz_serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="action" id="action"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="higher_partno" id="higher_partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="higher_serialno" id="higher_serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz_station" id="hz_station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz_store" id="hz_store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz_location" id="hz_location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       case when hz.qty &gt;= 1 then trunc(hz.qty0)&#10;&#9;   else 0&#10;&#9;   end qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hz_orderno" id="hz_orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(hz.orderdate&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + hz.orderdate'dd.mm.yyyy')) orderdate" id="orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="null as &quot;null&quot;" id="null"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="r_psn" id="r_psn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when r.ac_registr is null then hz.ac_registr&#10;            else r.ac_registr&#10;            end ac_registr" id="ac_registr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT row_number() over(ORDER BY date_tran desc) num,
	   mod((row_number() over(ORDER BY date_tran desc)), 2) even_num,
       date_tran,
       hz_historyno_i,
	   hz_psn,
       hz_partno,
       hz_serialno,
       action,
       higher_partno,
       higher_serialno, 
       hz_station,
       hz_store,
       hz_location,
       qty,
       hz_orderno,
       orderdate,
	   null as "null",
	   r_psn,
       ac_registr
FROM
(select    hz.psn hz_psn,
		   hz.partno hz_partno,
		   hz.serialno hz_serialno,
		   vm.description action,
		   hz.higher_partno,
		   hz.higher_serialno, 
		   to_date('31.12.1971', 'dd.mm.yyyy') + hz.mutation +
						  hz.mutation_time / 24 / 60 / 60 / 1000 date_tran,
		   hz.station hz_station,
		   hz.store hz_store,
		   hz.location hz_location,
		   case when hz.qty &gt;= 1 then trunc(hz.qty, 0)
		   else 0
		   end qty,
		   hz.orderno hz_orderno,
		   decode(hz.orderdate,
				  0,
				  null,
				  to_char(to_date('31.12.1971', 'dd.mm.yyyy') + hz.orderdate,
						  'dd.mm.yyyy')) orderdate,
		   null as "null",
		   r.psn r_psn,
		   hz.historyno_i hz_historyno_i,
		   case when r.ac_registr is null then hz.ac_registr
				else r.ac_registr
				end ac_registr
  from history hz
  left join rotables r on hz.psn = r.psn
  join voucher_mode vm on hz.vm = vm.vm and hz.vm in ('YA', 'YE', 'B7')
 where /* Part number */
 ('@VAR.partno@' is null or
hz.partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
/* Serial number */
and ('@VAR.serialno@' is null or
hz.serialno in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))
and hz.higher_partno &lt;&gt; ' '
and hz.higher_serialno &lt;&gt; ' '
UNION
select hz.psn hz_psn,
       hz.partno hz_partno,
       hz.serialno hz_serialno,
       vm.description action,
       hz.higher_partno,
       hz.higher_serialno, 
       to_date('31.12.1971', 'dd.mm.yyyy') + hz.mutation +
                      hz.mutation_time / 24 / 60 / 60 / 1000 date_tran,
       hz.station hz_station,
       hz.store hz_store,
       hz.location hz_location,
       case when hz.qty &gt;= 1 then trunc(hz.qty, 0)
	   else 0
	   end qty,
       hz.orderno hz_orderno,
       decode(hz.orderdate,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + hz.orderdate,
                      'dd.mm.yyyy')) orderdate,
	   null as "null",
	   r.psn r_psn,
	   hz.historyno_i hz_historyno_i,
       case when r.ac_registr is null then hz.ac_registr
            else r.ac_registr
            end ac_registr
  from history hz
  left join rotables r on hz.psn = r.psn
  join voucher_mode vm on hz.vm = vm.vm and hz.vm in ('YA', 'YE', 'B7')
 where /* Part number */
 ('@VAR.partno@' is null or
hz.higher_partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
/* Serial number */
and ('@VAR.serialno@' is null or
hz.higher_serialno in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))
			  ) r</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
