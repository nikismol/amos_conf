  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="Tree-position" id="tree_pos"/>
        <ds:columnDescriptor amosType="POS" description="A/C Position" id="position"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Tree-position" id="tree_pos">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Aircraft position" id="position">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Component_Position" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Поиск компонента по позиции установки</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY r.partno tree_chaptertr.tree_position) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location" id="location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tree_type" id="tree_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ata_chapter" id="ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tree_position" id="tree_position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="position" id="position"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.position@">
          <ds:object>@VAR.position@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tree_pos@">
          <ds:object>@VAR.tree_pos@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY position, tree_position, partno, serialno) num,
partno, serialno, location, tree_type, ata_chapter, tree_position, description, position
from position p
join rotables r on p.position = r.location
left join ( select ata_chapter, tree_chapter from tree_reference group by ata_chapter, tree_chapter) tr on r.partno = tr.tree_chapter 
where /* Aircraft position */
 ('@VAR.position@' is null or
position in
 (select trim(substr('@VAR.position@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.position@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.position@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.position@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.position@') -
              length(replace('@VAR.position@', ',', '')) + 1))
and /* Tree-position */
 ('@VAR.tree_pos@' is null or
tree_position in
 (select trim(substr('@VAR.tree_pos@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.tree_pos@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.tree_pos@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.tree_pos@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.tree_pos@') -
              length(replace('@VAR.tree_pos@', ',', '')) + 1))
group by partno, serialno, location, tree_type, ata_chapter, tree_position, description, position</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_tree_position" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Group by tree_position</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr" id="ac_registr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Component_Position.position@">
          <ds:object>@RMX_Component_Position.position@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Component_Position.tree_position@">
          <ds:object>@RMX_Component_Position.tree_position@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select ac_registr
from position p
join rotables r on p.position = r.location
where /* Aircraft position */
(position in ('@RMX_Component_Position.position@') or position = ' ')
/* Tree-position */
and (tree_position in ('@RMX_Component_Position.tree_position@') or tree_position = ' ')
 group by ac_registr
order by ac_registr</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
