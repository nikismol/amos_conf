    <view class="DatasourceTableView" id="9167">
      <attribute name="name">DatasourceTable_1</attribute>
      <attribute name="position">0 27</attribute>
      <attribute name="size">1000 73</attribute>
      <attribute name="visible">YES</attribute>
      <attribute name="auto-resize">NO</attribute>
      <attribute name="rotation">0.0</attribute>
      <conditional_attributes>
        <conditional_attribute id="1">
          <attribute name="visible">NO</attribute>
          <conditions>
            <condition class="GenericStyleCondition">
              <field id="1">@136_DetailedDocStat_ac_or_doc_typ.ac_or_comp_doc@</field>
              <field id="2">C</field>
              <operator negated="NO">EQUALS</operator>
            </condition>
          </conditions>
        </conditional_attribute>
        <conditional_attribute id="2">
          <attribute name="visible">NO</attribute>
