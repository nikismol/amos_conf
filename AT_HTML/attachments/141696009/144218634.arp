  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ORDER" description="Order No" id="orderno"/>
        <ds:columnDescriptor amosType="DATE_INT" description="Order date to" id="date_to"/>
        <ds:columnDescriptor amosType="DATE_INT" description="Order date from" id="date_from"/>
        <ds:columnDescriptor amosType="PA" description="Part No" id="partno"/>
        <ds:columnDescriptor amosType="SERIALNO" description="Serial No" id="serialno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Номер заказа" id="orderno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Дата заказа по" id="date_to">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Дата заказа c" id="date_from">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Партийный номер" id="partno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Серийный номер" id="serialno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Order_Info" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Данные о заказах</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY h.orderdateh.orderno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.orderno" id="h.orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.ext_state Order_State" id="Order_State"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.ext_orderno" id="h.ext_orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.posno" id="d.posno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.ext_state Detail_State" id="Detail_State"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(h.orderdate&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + h.orderdate'dd.mm.yyyy')) order_date" id="order_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.vendor address" id="address"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.name" id="a.name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.partno" id="d.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.serialno" id="d.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.labelno" id="d.labelno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       round(d.qty0) qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.description" id="p.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.backorder" id="d.backorder"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.shipmentno_i" id="s.shipmentno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   decode(d.target_date&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + d.target_date'dd.mm.yyyy')) target_date" id="target_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.orderno@">
          <ds:object>@VAR.orderno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY h.orderdate, h.orderno) num,
	   h.orderno,
	   case when h.ext_state = 'O' then 'OPEN'
		when h.ext_state = 'CA' then 'CANCELLED'
		when h.ext_state = 'R' then 'RECEIVED'
		when h.ext_state = 'BO' then 'BOOKED / OPEN'
		when h.ext_state = 'PR' then 'PARTLY RECEIVED'
		when h.ext_state = 'D' then 'DRAFT'
		when h.ext_state = 'B' then 'BOOKED'
		when h.ext_state = 'T' then 'TEMPORARY'
		when h.ext_state = 'C' then 'CLOSED'
		when h.ext_state = 'IC' then 'INCOMPLETE'
		else 'UNK.' end  Order_State,
       h.ext_orderno,
	   d.posno,
       case when d.ext_state = 'O' then 'OPEN'
		when d.ext_state = 'CA' then 'CANCELLED'
		when d.ext_state = 'R' then 'RECEIVED'
		when d.ext_state = 'BO' then 'BOOKED / OPEN'
		when d.ext_state = 'PR' then 'PARTLY RECEIVED'
		when d.ext_state = 'D' then 'DRAFT'
		when d.ext_state = 'B' then 'BOOKED'
		when d.ext_state = 'T' then 'TEMPORARY'
		when d.ext_state = 'C' then 'CLOSED'
		when d.ext_state = 'IC' then 'INCOMPLETE'
		else 'UNK.' end Detail_State,
       decode(h.orderdate,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + h.orderdate,
                      'dd.mm.yyyy')) order_date,
       a.vendor address,
       a.name,
       d.partno,
       d.serialno,
       d.labelno,
       round(d.qty, 0) qty,
       p.description,
       d.backorder,
       s.shipmentno_i,
	   decode(d.target_date,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + d.target_date,
                      'dd.mm.yyyy')) target_date
from od_header h
left join od_detail d on h.orderno_i = d.orderno_i
left join part p on d.partno = p.partno
left join address a on h.vendor = a.vendor
left join sh_detail s on d.detailno_i = s.od_detailno_i
where /* Тип заказа */ 
h.order_type in ('P', 'PR', 'Y', 'L')
and h.ext_state = 'O'
	/* Дата заказа  */
      and ('@VAR.date_from@' is null or h.orderdate &gt;= '@VAR.date_from@')
	  and ('@VAR.date_to@' is null or h.orderdate &lt;= '@VAR.date_to@')
	/* Номер заказа */ 
and ('@VAR.orderno@' is null or
  h.orderno_i in
 (select trim(substr('@VAR.orderno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.orderno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.orderno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.orderno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.orderno@') -
              length(replace('@VAR.orderno@', ',', '')) + 1))
/* Партийный номер */ 
and ('@VAR.partno@' is null or
  d.partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
/* Серийный номер */ 
and ('@VAR.serialno@' is null or
  d.serialno in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
