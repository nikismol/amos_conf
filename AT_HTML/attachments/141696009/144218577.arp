  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="ac_type"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Тип ВС:" id="ac_type">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>A32S&amp;=&amp;AIRBUS 320 SERIES TYPE;A330&amp;=&amp;AIRBUS 330 SERIES TYPE;A350&amp;=&amp;AIRBUS 350 SERIES TYPE;B737&amp;=&amp;BOEING 737 SERIES TYPE;B777&amp;=&amp;BOEING 777 SERIES TYPE;RRJ&amp;=&amp;RRJ (SSJ) FAMILY TYPE;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_PPCD_ChecksTogo" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.ac_registr" id="f.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;REGEXP_SUBSTR(f.event'^[^/]+') as event_desc" id="event_desc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (f.expected_date+729)'DD.MM.YYYY') as expected_date" id="expected_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD/MM/YYYY') + (fd_d.expected_date+729)'DD/MM/YYYY') as due_at_date" id="due_at_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ROUND(fd_h.absolute_due_at_ac/60) as due_at_hours" id="due_at_hours"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="fd_h.absolute_due_at_ac as due_at_cycles" id="due_at_cycles"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ROUND(fd_d.togo/60/24) as togo_days" id="togo_days"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ROUND(fd_h.togo/60) as togo_hours" id="togo_hours"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="fd_c.togo as togo_cycles" id="togo_cycles"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="flt.arrival" id="flt.arrival"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="flt.departure" id="flt.departure"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('01.01.1970' 'DD/MM/YYYY') + (flt.validity+729)'DD/MM/YYYY') as flt_arrival_date" id="flt_arrival_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="flt.leg_number" id="flt.leg_number"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="flt.legno_i" id="flt.legno_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_type@">
          <ds:object>@VAR.ac_type@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT f.ac_registr,
REGEXP_SUBSTR(f.event_display, '^[^/]+') as event_desc,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (f.expected_date+729), 'DD.MM.YYYY') as expected_date,
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (fd_d.expected_date+729), 'DD.MM.YYYY') as due_at_date,
TO_CHAR(FLOOR(fd_h.absolute_due_at_ac/60), '99999999999999') as due_at_hours,
TO_CHAR(fd_c.absolute_due_at_ac, '99999999999999') as due_at_cycles,
TO_CHAR(FLOOR(fd_d.togo/60/24), '99999999999999') as togo_days,
TO_CHAR(FLOOR(fd_h.togo/60), '99999999999999') as togo_hours,
TO_CHAR(fd_c.togo, '99999999999999') as togo_cycles,
flt.arrival,
flt.departure,
TO_CHAR(TO_DATE('01/01/1970', 'DD/MM/YYYY') + (flt.validity+729), 'DD/MM/YYYY') as flt_arrival_date,
flt.leg_number,
flt.legno_i
FROM forecast f 
LEFT JOIN forecast_dimension fd_d ON (f.event_perfno_i = fd_d.event_perfno_i AND fd_d.dimension = 'D')
LEFT JOIN forecast_dimension fd_h ON (f.event_perfno_i = fd_h.event_perfno_i AND fd_h.dimension = 'H')
LEFT JOIN forecast_dimension fd_c ON (f.event_perfno_i = fd_c.event_perfno_i AND fd_c.dimension = 'C')
LEFT JOIN (
	SELECT DISTINCT ac_registr, first_value(legno_i) OVER (PARTITION BY ac_registr ORDER BY ac_registr, validity DESC, arrival_time DESC) legno FROM ac_utilization WHERE recno !=0
) latest_flight ON latest_flight.ac_registr = f.ac_registr
LEFT JOIN ac_utilization flt ON flt.legno_i = latest_flight.legno
WHERE f.ac_typ='@VAR.ac_type@' AND f.event_type = 'C'
and f.expected_date &lt;&gt; '1491308'

/*AFL_PPCD_ChecksTogo main-q1*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_PPCD_ChecksTogo_ForecastRecalJob" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="end_date" id="end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="end_time" id="end_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT end_date, end_time FROM
(SELECT scheduler_log.end_date as end_date, end_time
FROM scheduler_log 
WHERE scheduler_log.scheduler_confno_i IN (SELECT scheduler_conf.scheduler_confno_i FROM scheduler_conf WHERE scheduler_conf.classname = 'amos.server.admin.scheduler.tasks.scheduled.forecast.AircraftMaintenanceForecastService')
ORDER BY end_date DESC, end_time DESC)
WHERE end_date IS NOT null AND end_time IS NOT null AND rownum=1</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
