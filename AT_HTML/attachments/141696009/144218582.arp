    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Y_YU_Orders" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>ЗАКАЗЫ НА ОБМЕН ТИПА YU/Y (СОБСТВЕННЫЙ POOL)</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY r.orderno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="main_orderno_i" id="main_orderno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="main_orderno" id="main_orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="main_order_type" id="main_order_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="related_orderno_i" id="related_orderno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="related_orderno" id="related_orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="related_order_type" id="related_order_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="order_state" id="order_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   to_char(to_date('31.12.1971' 'dd.mm.yyyy') + orderdate'dd.mm.yyyy') orderdate" id="orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="vendor" id="vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="posno" id="posno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="order_pos_state" id="order_pos_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rel_order_state" id="rel_order_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   to_char(to_date('31.12.1971' 'dd.mm.yyyy') + yu_orderdate'dd.mm.yyyy') yu_orderdate" id="yu_orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="yu_vendor" id="yu_vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rel_posno" id="rel_posno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rel_order_pos_state" id="rel_order_pos_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rel_partno" id="rel_partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rel_serialno" id="rel_serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   to_char(to_date('31.12.1971' 'dd.mm.yyyy') + y_booked_date'dd.mm.yyyy') y_booked_date" id="y_booked_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + yu_booked_date'dd.mm.yyyy') yu_booked_date" id="yu_booked_date"/>
      </ds:columnDescriptors>
