          <ds:object>@VAR.ext_state_rel@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.orderno_r@">
          <ds:object>@VAR.orderno_r@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.orderno_rel@">
          <ds:object>@VAR.orderno_rel@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.orderdate_from_r@">
          <ds:object>@VAR.orderdate_from_r@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.orderdate_end_r@">
          <ds:object>@VAR.orderdate_end_r@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.orderdate_from_rel@">
          <ds:object>@VAR.orderdate_from_rel@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.orderdate_end_rel@">
          <ds:object>@VAR.orderdate_end_rel@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.vendor_r@">
          <ds:object>@VAR.vendor_r@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.vendor_rel@">
          <ds:object>@VAR.vendor_rel@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno_r@">
          <ds:object>@VAR.serialno_r@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno_rel@">
          <ds:object>@VAR.serialno_rel@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY main_orderno) num,
       main_orderno_i,
       main_orderno,
       main_order_type,
       related_orderno_i,
       related_orderno,
       related_order_type,
       order_state,
	   to_char(to_date('31.12.1971', 'dd.mm.yyyy') + orderdate,
               'dd.mm.yyyy') orderdate,
       vendor,
       posno,
       order_pos_state,
       ac_registr,
       partno,
       serialno,
       rel_order_state,
	   to_char(to_date('31.12.1971', 'dd.mm.yyyy') + yu_orderdate,
               'dd.mm.yyyy') yu_orderdate,
       yu_vendor,
       rel_posno,
       rel_order_pos_state,
       rel_partno,
       rel_serialno,
	   to_char(to_date('31.12.1971', 'dd.mm.yyyy') + y_booked_date,
               'dd.mm.yyyy') y_booked_date,
       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + yu_booked_date,
               'dd.mm.yyyy') yu_booked_date
from
(
select a.y_orderno_i main_orderno_i,
       a.y_orderno main_orderno,
       a.y_ordertype main_order_type,
       a.yu_orderno_i related_orderno_i,
       a.yu_orderno related_orderno,
       a.yu_order_type related_order_type,
       case
         when h.ext_state = 'C' then
          'Closed'
         else
          decode(h.ext_state,
                 'O',
                 'Open',
                 'D',
                 'Draft',
                 'T',
                 'Temporary',
                 'B',
                 'Booked',
                 'R',
                 'Received',
                 h.ext_state)
       end order_state,
       h.orderdate orderdate,
       h.vendor vendor,
       d.posno posno,
       case
         when d.state = 'C' then
          'Closed'
         else
          decode(d.state,
                 'O',
                 'Open',
                 'D',
                 'Draft',
                 'T',
                 'Temporary',
                 d.state)
       end order_pos_state,
       d.ac_registr ac_registr,
       d.partno partno,
       d.serialno serialno,
       case
         when a.yu_ext_state = 'C' then
          'Closed'
         else
          decode(a.yu_ext_state,
                 'O',
                 'Open',
                 'D',
                 'Draft',
                 'T',
                 'Temporary',
                 'B',
                 'Booked',
                 'R',
                 'Received',
                 'CA',
                 'Cancelled',
                 a.yu_ext_state)
       end rel_order_state,
       a.yu_orderdate yu_orderdate,
       a.yu_vendor yu_vendor,
       d2.posno rel_posno,
       case
         when d2.state = 'C' then
          'Closed'
         else
          decode(d2.state,
                 'O',
                 'Open',
                 'D',
                 'Draft',
                 'T',
                 'Temporary',
                 d2.state)
       end rel_order_pos_state,
       d2.partno rel_partno,
       d2.serialno rel_serialno,
       case when h.ext_state = 'B' then d.mutation
             else null
             end y_booked_date,
       case when a.yu_ext_state = 'B' then d2.mutation
             else null
             end yu_booked_date
from od_header h
join  
-- a - поиск связанных заказов
(
select y_orderno, 
       y_orderno_i,
       y_created_from,
       y_ordertype,
       yu_orderno,
       yu_orderno_i,
       yu_created_from,
       yu_order_type,
       yu_ext_state,
       yu_orderdate,
       yu_vendor            
from
(
-- Поиск связанных заказов с created_from_orderno_i = 0
select h.orderno                 y_orderno,
       h.orderno_i                y_orderno_i,
       h.created_from_orderno_i   y_created_from,
       h.order_type               y_ordertype,
       odh.orderno                yu_orderno,
       odh.orderno_i              yu_orderno_i,
       odh.created_from_orderno_i yu_created_from,
       odh.order_type             yu_order_type,
       odh.ext_state              yu_ext_state,
       odh.orderdate              yu_orderdate,
       odh.vendor                 yu_vendor
  from od_header h
  left join (select odh.orderno,
               odh.orderno_i,
               odh.created_from_orderno_i,
               odh.order_type,
               odh.ext_state,
               odh.orderdate,
               odh.vendor            
          from od_header odh
         where 
		(
		('@VAR.r_type_y@' = 'Y' and order_type = 'Y') or ('@VAR.r_type_yu@' = 'Y' and order_type = 'YU') or ('@VAR.r_type_pr@' = 'Y' and order_type = 'PR') or ('@VAR.r_type_pu@' = 'Y' and order_type = 'PU') or ('@VAR.r_type_l@' = 'Y' and order_type = 'L') or ('@VAR.r_type_lu@' = 'Y' and order_type = 'LU') 
		or (('@VAR.r_type_y@' = 'N' and '@VAR.r_type_yu@' = 'N' and '@VAR.r_type_pr@' = 'N' and '@VAR.r_type_pu@' = 'N' and '@VAR.r_type_l@' = 'N' and '@VAR.r_type_lu@' = 'N') and order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			)
         and (
		('@VAR.rel_type_y@' = 'Y' and order_type = 'Y') or ('@VAR.rel_type_yu@' = 'Y' and order_type = 'YU') or ('@VAR.rel_type_pr@' = 'Y' and order_type = 'PR') or ('@VAR.rel_type_pu@' = 'Y' and order_type = 'PU') or ('@VAR.rel_type_l@' = 'Y' and order_type = 'L') or ('@VAR.rel_type_lu@' = 'Y' and order_type = 'LU') 
		or (('@VAR.rel_type_y@' = 'N' and '@VAR.rel_type_yu@' = 'N' and '@VAR.rel_type_pr@' = 'N' and '@VAR.rel_type_pu@' = 'N' and '@VAR.rel_type_l@' = 'N' and '@VAR.rel_type_lu@' = 'N') and order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			)			   
         start with created_from_orderno_i = '0'
        connect by prior orderno_i = created_from_orderno_i) odh on h.orderno_i = odh.created_from_orderno_i
 where h.created_from_orderno_i = '0'
 and (
		('@VAR.r_type_y@' = 'Y' and h.order_type = 'Y') or ('@VAR.r_type_yu@' = 'Y' and h.order_type = 'YU') or ('@VAR.r_type_pr@' = 'Y' and h.order_type = 'PR') or ('@VAR.r_type_pu@' = 'Y' and h.order_type = 'PU') or ('@VAR.r_type_l@' = 'Y' and h.order_type = 'L') or ('@VAR.r_type_lu@' = 'Y' and h.order_type = 'LU') 
		or (('@VAR.r_type_y@' = 'N' and '@VAR.r_type_yu@' = 'N' and '@VAR.r_type_pr@' = 'N' and '@VAR.r_type_pu@' = 'N' and '@VAR.r_type_l@' = 'N' and '@VAR.r_type_lu@' = 'N') and h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			)
and (
		('@VAR.rel_type_y@' = 'Y' and h.order_type = 'Y') or ('@VAR.rel_type_yu@' = 'Y' and h.order_type = 'YU') or ('@VAR.rel_type_pr@' = 'Y' and h.order_type = 'PR') or ('@VAR.rel_type_pu@' = 'Y' and h.order_type = 'PU') or ('@VAR.rel_type_l@' = 'Y' and h.order_type = 'L') or ('@VAR.rel_type_lu@' = 'Y' and h.order_type = 'LU') 
		or (('@VAR.rel_type_y@' = 'N' and '@VAR.rel_type_yu@' = 'N' and '@VAR.rel_type_pr@' = 'N' and '@VAR.rel_type_pu@' = 'N' and '@VAR.rel_type_l@' = 'N' and '@VAR.rel_type_lu@' = 'N') and h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			)
 start with h.created_from_orderno_i = '0'
connect by prior h.orderno_i = h.created_from_orderno_i
union
 -- Поиск связанных заказов с указанным created_from_orderno_i
select main_h.orderno                y_orderno,
                       main_h.orderno_i              y_orderno_i,
                       main_h.created_from_orderno_i y_created_from,
                       main_h.order_type             y_ordertype,
                       rel_h.orderno                 yu_orderno,
                       rel_h.orderno_i               yu_orderno_i,
                       rel_h.created_from_orderno_i  yu_created_from,
                       rel_h.order_type              yu_order_type,
                       rel_h.ext_state               yu_ext_state,
                       rel_h.orderdate               yu_orderdate,
                       rel_h.vendor                  yu_vendor
                  from od_header main_h
                  join od_header rel_h on main_h.created_from_orderno_i =
                                           rel_h.orderno_i
                 where main_h.created_from_orderno_i &gt;= 1
and (
		('@VAR.r_type_y@' = 'Y' and main_h.order_type = 'Y') or ('@VAR.r_type_yu@' = 'Y' and main_h.order_type = 'YU') or ('@VAR.r_type_pr@' = 'Y' and main_h.order_type = 'PR') or ('@VAR.r_type_pu@' = 'Y' and main_h.order_type = 'PU') or ('@VAR.r_type_l@' = 'Y' and main_h.order_type = 'L') or ('@VAR.r_type_lu@' = 'Y' and main_h.order_type = 'LU') 
		or (('@VAR.r_type_y@' = 'N' and '@VAR.r_type_yu@' = 'N' and '@VAR.r_type_pr@' = 'N' and '@VAR.r_type_pu@' = 'N' and '@VAR.r_type_l@' = 'N' and '@VAR.r_type_lu@' = 'N') and main_h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			)
   and (
		('@VAR.rel_type_y@' = 'Y' and rel_h.order_type = 'Y') or ('@VAR.rel_type_yu@' = 'Y' and rel_h.order_type = 'YU') or ('@VAR.rel_type_pr@' = 'Y' and rel_h.order_type = 'PR') or ('@VAR.rel_type_pu@' = 'Y' and rel_h.order_type = 'PU') or ('@VAR.rel_type_l@' = 'Y' and rel_h.order_type = 'L') or ('@VAR.rel_type_lu@' = 'Y' and rel_h.order_type = 'LU') 
		or (('@VAR.rel_type_y@' = 'N' and '@VAR.rel_type_yu@' = 'N' and '@VAR.rel_type_pr@' = 'N' and '@VAR.rel_type_pu@' = 'N' and '@VAR.rel_type_l@' = 'N' and '@VAR.rel_type_lu@' = 'N') and main_h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			)
union
-- Поиск связанных заказов с created_from_orderno_i &lt;&gt; 0
select h.orderno                 y_orderno,
       h.orderno_i                y_orderno_i,
       h.created_from_orderno_i   y_created_from,
       h.order_type               y_ordertype,
       odh.orderno                yu_orderno,
       odh.orderno_i              yu_orderno_i,
       odh.created_from_orderno_i yu_created_from,
       odh.order_type             yu_order_type,
       odh.ext_state              yu_ext_state,
       odh.orderdate              yu_orderdate,
       odh.vendor                 yu_vendor
  from od_header h
 left join (select odh.orderno,
               odh.orderno_i,
               odh.created_from_orderno_i,
               odh.order_type,
               odh.ext_state,
               odh.orderdate,
               odh.vendor
          from od_header odh
         where (
		('@VAR.r_type_y@' = 'Y' and order_type = 'Y') or ('@VAR.r_type_yu@' = 'Y' and order_type = 'YU') or ('@VAR.r_type_pr@' = 'Y' and order_type = 'PR') or ('@VAR.r_type_pu@' = 'Y' and order_type = 'PU') or ('@VAR.r_type_l@' = 'Y' and order_type = 'L') or ('@VAR.r_type_lu@' = 'Y' and order_type = 'LU') 
		or (('@VAR.r_type_y@' = 'N' and '@VAR.r_type_yu@' = 'N' and '@VAR.r_type_pr@' = 'N' and '@VAR.r_type_pu@' = 'N' and '@VAR.r_type_l@' = 'N' and '@VAR.r_type_lu@' = 'N') and order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			)
            and (
		('@VAR.rel_type_y@' = 'Y' and order_type = 'Y') or ('@VAR.rel_type_yu@' = 'Y' and order_type = 'YU') or ('@VAR.rel_type_pr@' = 'Y' and order_type = 'PR') or ('@VAR.rel_type_pu@' = 'Y' and order_type = 'PU') or ('@VAR.rel_type_l@' = 'Y' and order_type = 'L') or ('@VAR.rel_type_lu@' = 'Y' and order_type = 'LU') 
		or (('@VAR.rel_type_y@' = 'N' and '@VAR.rel_type_yu@' = 'N' and '@VAR.rel_type_pr@' = 'N' and '@VAR.rel_type_pu@' = 'N' and '@VAR.rel_type_l@' = 'N' and '@VAR.rel_type_lu@' = 'N') and order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			) 			   
         start with created_from_orderno_i = '0'
        connect by prior orderno_i = created_from_orderno_i) odh on h.created_from_orderno_i = odh.orderno_i
 where h.created_from_orderno_i &lt;&gt; '0'
  and (
		('@VAR.r_type_y@' = 'Y' and h.order_type = 'Y') or ('@VAR.r_type_yu@' = 'Y' and h.order_type = 'YU') or ('@VAR.r_type_pr@' = 'Y' and h.order_type = 'PR') or ('@VAR.r_type_pu@' = 'Y' and h.order_type = 'PU') or ('@VAR.r_type_l@' = 'Y' and h.order_type = 'L') or ('@VAR.r_type_lu@' = 'Y' and h.order_type = 'LU') 
		or (('@VAR.r_type_y@' = 'N' and '@VAR.r_type_yu@' = 'N' and '@VAR.r_type_pr@' = 'N' and '@VAR.r_type_pu@' = 'N' and '@VAR.r_type_l@' = 'N' and '@VAR.r_type_lu@' = 'N') and h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			)
   and (
		('@VAR.rel_type_y@' = 'Y' and h.order_type = 'Y') or ('@VAR.rel_type_yu@' = 'Y' and h.order_type = 'YU') or ('@VAR.rel_type_pr@' = 'Y' and h.order_type = 'PR') or ('@VAR.rel_type_pu@' = 'Y' and h.order_type = 'PU') or ('@VAR.rel_type_l@' = 'Y' and h.order_type = 'L') or ('@VAR.rel_type_lu@' = 'Y' and h.order_type = 'LU') 
		or (('@VAR.rel_type_y@' = 'N' and '@VAR.rel_type_yu@' = 'N' and '@VAR.rel_type_pr@' = 'N' and '@VAR.rel_type_pu@' = 'N' and '@VAR.rel_type_l@' = 'N' and '@VAR.rel_type_lu@' = 'N') and h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))
			)
 start with h.created_from_orderno_i = '0'
connect by prior h.orderno_i = h.created_from_orderno_i
 order by y_orderno
 )a ) a on h.orderno_i = a.y_orderno_i
/* Поиск альтернативного парт-номера по main-ордерам */
  join (select pa.altpartno part, h.orderno
        from part_alternate pa
        join od_detail d on pa.altpartno = d.partno
        join od_header h on d.orderno_i = h.orderno_i
        where ('@VAR.partno_r@' is null or
       pa.partno in
       (select trim(substr('@VAR.partno_r@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.partno_r@' || ',', ',', 1, level - 1) + 2),
                            instr('@VAR.partno_r@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.partno_r@' || ',', ',', 1, level - 1) + 2)))
           from dual
         connect by level &lt;=
                    length('@VAR.partno_r@') - length(replace('@VAR.partno_r@', ',', '')) + 1))
        and h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU')
        and '@VAR.altpart_main@' = 'Y'
    union
        select d.partno part, h.orderno
        from od_header h
        join od_detail d on h.orderno_i = d.orderno_i
        where ('@VAR.partno_r@' is null or
       d.partno in
       (select trim(substr('@VAR.partno_r@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.partno_r@' || ',', ',', 1, level - 1) + 2),
                            instr('@VAR.partno_r@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.partno_r@' || ',', ',', 1, level - 1) + 2)))
           from dual
         connect by level &lt;=
                    length('@VAR.partno_r@') - length(replace('@VAR.partno_r@', ',', '')) + 1))
       and h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))pa on h.orderno = pa.orderno
join od_detail d on h.orderno_i = d.orderno_i
left join od_detail d2 on a.yu_orderno_i = d2.orderno_i
/* Поиск альтернативного парт-номера по связанным заказам */
join (select pa.altpartno part, h.orderno
        from part_alternate pa
        join od_detail d on pa.altpartno = d.partno
        join od_header h on d.orderno_i = h.orderno_i
        where ('@VAR.partno_rel@' is null or
       pa.partno in
       (select trim(substr('@VAR.partno_rel@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.partno_rel@' || ',', ',', 1, level - 1) + 2),
                            instr('@VAR.partno_rel@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.partno_rel@' || ',', ',', 1, level - 1) + 2)))
           from dual
         connect by level &lt;=
                    length('@VAR.partno_rel@') - length(replace('@VAR.partno_rel@', ',', '')) + 1))
        and h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU')
        and '@VAR.altpart_rel@' = 'Y'
    union
        select d.partno part, h.orderno
        from od_header h
        join od_detail d on h.orderno_i = d.orderno_i
        where ('@VAR.partno_rel@' is null or
       d.partno in
       (select trim(substr('@VAR.partno_rel@' || ',',
                            decode(level,
                                   1,
                                   0,
                                   instr('@VAR.partno_rel@' || ',', ',', 1, level - 1) + 2),
                            instr('@VAR.partno_rel@' || ',', ',', 1, level) -
                            decode(level,
                                   1,
                                   1,
                                   instr('@VAR.partno_rel@' || ',', ',', 1, level - 1) + 2)))
           from dual
         connect by level &lt;=
                    length('@VAR.partno_rel@') - length(replace('@VAR.partno_rel@', ',', '')) + 1))
       and h.order_type in ('Y', 'YU', 'PR', 'PU', 'L', 'LU'))pa_rel on a.yu_orderno = pa_rel.orderno
where /* Order State */
          ('@VAR.ext_state_r@' is null or
          h.ext_state in
          (select trim(substr('@VAR.ext_state_r@' || ',',
                               decode(level,
                                      1,
                                      0,
                                      instr('@VAR.ext_state_r@' || ',',
                                            ',',
                                            1,
                                            level - 1) + 2),
                               instr('@VAR.ext_state_r@' || ',', ',', 1, level) -
                               decode(level,
                                      1,
                                      1,
                                      instr('@VAR.ext_state_r@' || ',',
                                            ',',
                                            1,
                                            level - 1) + 2)))
              from dual
            connect by level &lt;=
                       length('@VAR.ext_state_r@') -
                       length(replace('@VAR.ext_state_r@', ',', '')) + 1))
/* Order State Relative */
       and ('@VAR.ext_state_rel@' is null or
          a.yu_ext_state in
          (select trim(substr('@VAR.ext_state_rel@' || ',',
                               decode(level,
                                      1,
                                      0,
                                      instr('@VAR.ext_state_rel@' || ',',
                                            ',',
                                            1,
                                            level - 1) + 2),
                               instr('@VAR.ext_state_rel@' || ',', ',', 1, level) -
                               decode(level,
                                      1,
                                      1,
                                      instr('@VAR.ext_state_rel@' || ',',
                                            ',',
                                            1,
                                            level - 1) + 2)))
              from dual
            connect by level &lt;=
                       length('@VAR.ext_state_rel@') -
                       length(replace('@VAR.ext_state_rel@', ',', '')) + 1))
 /* Order No  */     
		  and ('@VAR.orderno_r@' is null or
               a.y_orderno_i in
               (select trim(substr('@VAR.orderno_r@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.orderno_r@' || ',', ',', 1, level - 1) + 2),
                                    instr('@VAR.orderno_r@' || ',', ',', 1, level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.orderno_r@' || ',', ',', 1, level - 1) + 2)))
                   from dual
                 connect by level &lt;=
                            length('@VAR.orderno_r@') - length(replace('@VAR.orderno_r@', ',', '')) + 1))
/* Order No Relative */
           and ('@VAR.orderno_rel@' is null or
               a.yu_orderno_i in
               (select trim(substr('@VAR.orderno_rel@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.orderno_rel@' || ',', ',', 1, level - 1) + 2),
                                    instr('@VAR.orderno_rel@' || ',', ',', 1, level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.orderno_rel@' || ',', ',', 1, level - 1) + 2)))
                   from dual
                 connect by level &lt;=
                            length('@VAR.orderno_rel@') - length(replace('@VAR.orderno_rel@', ',', '')) + 1))
/* Order Date */
           and ('@VAR.orderdate_from_r@' is null or h.orderdate &gt;= '@VAR.orderdate_from_r@')
           and ('@VAR.orderdate_end_r@' is null or h.orderdate &lt;= '@VAR.orderdate_end_r@')
/* Order Date Relative */
           and ('@VAR.orderdate_from_rel@' is null or a.yu_orderdate &gt;= '@VAR.orderdate_from_rel@')
           and ('@VAR.orderdate_end_rel@' is null or a.yu_orderdate &lt;= '@VAR.orderdate_end_rel@')
/* Vendor */
           and ('@VAR.vendor_r@' is null or
               h.vendor in
               (select trim(substr('@VAR.vendor_r@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.vendor_r@' || ',', ',', 1, level - 1) + 2),
                                    instr('@VAR.vendor_r@' || ',', ',', 1, level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.vendor_r@' || ',', ',', 1, level - 1) + 2)))
                   from dual
                 connect by level &lt;=
                            length('@VAR.vendor_r@') - length(replace('@VAR.vendor_r@', ',', '')) + 1))
/* Vendor Relative */
           and ('@VAR.vendor_rel@' is null or
               a.yu_vendor in
               (select trim(substr('@VAR.vendor_rel@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.vendor_rel@' || ',', ',', 1, level - 1) + 2),
                                    instr('@VAR.vendor_rel@' || ',', ',', 1, level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.vendor_rel@' || ',', ',', 1, level - 1) + 2)))
                   from dual
                 connect by level &lt;=
                            length('@VAR.vendor_rel@') - length(replace('@VAR.vendor_rel@', ',', '')) + 1))
/* Serial No */
           and ('@VAR.serialno_r@' is null or
               d.serialno in
               (select trim(substr('@VAR.serialno_r@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.serialno_r@' || ',', ',', 1, level - 1) + 2),
                                    instr('@VAR.serialno_r@' || ',', ',', 1, level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.serialno_r@' || ',', ',', 1, level - 1) + 2)))
                   from dual
                 connect by level &lt;=
                            length('@VAR.serialno_r@') - length(replace('@VAR.serialno_r@', ',', '')) + 1))
/* Serial No Relative */
           and ('@VAR.serialno_rel@' is null or
               d2.serialno in
               (select trim(substr('@VAR.serialno_rel@' || ',',
                                    decode(level,
                                           1,
                                           0,
                                           instr('@VAR.serialno_rel@' || ',', ',', 1, level - 1) + 2),
                                    instr('@VAR.serialno_rel@' || ',', ',', 1, level) -
                                    decode(level,
                                           1,
                                           1,
                                           instr('@VAR.serialno_rel@' || ',', ',', 1, level - 1) + 2)))
                   from dual
                 connect by level &lt;=
                            length('@VAR.serialno_rel@') - length(replace('@VAR.serialno_rel@', ',', '')) + 1))
)t</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
