            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="04 - ! Если ни один из типов заказа не выбран отображаются ВСЕ типы" id="desc_type_r">
          <ds:map>
            <ds:keyValuePair>
