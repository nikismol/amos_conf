        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno_r@">
          <ds:object>@VAR.partno_r@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.altpart_main@">
