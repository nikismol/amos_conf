          <ds:object>@VAR.r_type_lu@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.rel_type_y@">
          <ds:object>@VAR.rel_type_y@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.rel_type_yu@">
