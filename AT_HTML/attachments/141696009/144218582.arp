        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.rel_type_pr@">
          <ds:object>@VAR.rel_type_pr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.rel_type_pu@">
          <ds:object>@VAR.rel_type_pu@</ds:object>
