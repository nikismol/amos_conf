    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="38_Taskcard_Status" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>main query</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_registr" id="a.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.taskcardno_i" id="s.taskcardno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.taskcardno mp_task_no" id="mp_task_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" (select listagg(description '') within&#10;        group (order by description) amazing&#10;         from db_link&#10;        where mv.taskcard_verno_i = db_link.source_pk&#10;          and db_link.source_type = 'TCLS'&#10;     group by db_link.source_pk) task_source" id="task_source"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="threshold" id="threshold"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="intervals" id="intervals"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_perf_fh" id="last_perf_fh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_perf_cy" id="last_perf_cy"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_perf_date" id="last_perf_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_wo last_perf_wp" id="last_perf_wp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="seq_no wp_items" id="wp_items"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="deadline_fh" id="deadline_fh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="deadline_cy" id="deadline_cy"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="due_date deadline_date" id="deadline_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when due_date &lt; to_date(sysdate'dd.mm.yyyy') then 'wtf'&#10;           when due_date is null and deadline_fh is null and deadline_cy is null then 'wtf'&#10;           else 'ok' end check_dl" id="check_dl"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="planned_wp_wo" id="planned_wp_wo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="planned_items" id="planned_items"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when trunc(deadline_fh_round - util.tah) &gt; 0 then&#10;                trunc(deadline_fh_round - util.tah) || ':' || round(((deadline_fh_round - util.tah) - trunc(deadline_fh_round - util.tah))*60)&#10;        else null end remain_fh" id="remain_fh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when deadline_cy - util.tac &gt; 0 then&#10;                 deadline_cy - util.tac else null&#10;        end remain_cy" id="remain_cy"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when trunc(((to_date(due_date 'dd.mm.yyyy') - sysdate) + 1) / 365) &gt; 0 then&#10;                trunc(((to_date(due_date 'dd.mm.yyyy') - sysdate) + 1) / 365) || 'y' || ' ' &#10;                || round(round((to_date(due_date 'dd.mm.yyyy') - sysdate)) - (trunc((to_date(due_date'dd.mm.yyyy') - sysdate) / 365)*365 )) || 'd'&#10;        else null&#10;      end remain_days" id="remain_days"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when to_char(mv.internal_remarks) &lt;&gt; 'В ' and to_char(mv.notes) &lt;&gt; 'В ' then 'Notes: ' || to_char(mv.notes) || chr(13)|| chr(10)|| &#10;             'Int. Remarks: ' || to_char(mv.internal_remarks)&#10;              when to_char(mv.internal_remarks) &lt;&gt; 'В ' then 'Int. Remarks: ' || to_char(mv.internal_remarks)&#10;              when to_char(mv.notes) &lt;&gt; 'В ' then 'Notes: ' || to_char(mv.notes)&#10;            else null&#10;         end notes" id="notes"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when hist.revision_no &lt;&gt; 'В ' and hist.revision_date &lt;&gt; 'В '&#10;                then hist.revision_no || ' / (' ||  hist.revision_date || ')' &#10;      else ' ' end historical_data" id="historical_data"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="1 red_row" id="red_row"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.history@">
          <ds:object>@VAR.history@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_reg@">
          <ds:object>@VAR.ac_reg@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.sec_code@">
          <ds:object>@VAR.sec_code@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.task@">
          <ds:object>@VAR.task@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.overdue@">
          <ds:object>@VAR.overdue@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select a.ac_registr
     , s.taskcardno_i
     , s.taskcardno mp_task_no
     , (select listagg(description, ', ') within
        group (order by description) amazing
         from db_link
        where mv.taskcard_verno_i = db_link.source_pk
          and db_link.source_type = 'TCLS'
     group by db_link.source_pk) task_source
    , threshold
    , intervals
    , last_perf_fh
    , last_perf_cy
    , last_perf_date
    , wp_wo last_perf_wp
    , seq_no wp_items
    , deadline_fh
    , deadline_cy
    , due_date deadline_date
    , case when due_date &lt; to_date(sysdate, 'dd.mm.yyyy') then 'wtf'
           when due_date is null and deadline_fh is null and deadline_cy is null then 'wtf'
           else 'ok' end check_dl
    , planned_wp_wo
    , planned_items
    , case when trunc(deadline_fh_round - util.tah) &gt; 0 then
                trunc(deadline_fh_round - util.tah) || ':' || round(((deadline_fh_round - util.tah) - trunc(deadline_fh_round - util.tah))*60)
        else null end remain_fh
    , case when deadline_cy - util.tac &gt; 0 then
                 deadline_cy - util.tac else null
        end remain_cy
    , case when trunc(((to_date(due_date, 'dd.mm.yyyy') - sysdate) + 1) / 365) &gt; 0 then
                trunc(((to_date(due_date, 'dd.mm.yyyy') - sysdate) + 1) / 365) || 'y' || ' ' 
                || round(round((to_date(due_date, 'dd.mm.yyyy') - sysdate)) - (trunc((to_date(due_date, 'dd.mm.yyyy') - sysdate) / 365)*365 )) || 'd'
		   when trunc(((to_date(due_date, 'dd.mm.yyyy') - sysdate) + 1) / 365) &lt;= 0
             and round((to_date(due_date, 'dd.mm.yyyy') - sysdate)) &gt; 0 then
                 round((to_date(due_date, 'dd.mm.yyyy') - sysdate)) || 'd'
        else null
      end remain_days
    , case when to_char(mv.internal_remarks) &lt;&gt; 'В ' and to_char(mv.notes) &lt;&gt; 'В ' then 'Notes: ' || to_char(mv.notes) || chr(13)|| chr(10)|| 
             'Int. Remarks: ' || to_char(mv.internal_remarks)
              when to_char(mv.internal_remarks) &lt;&gt; 'В ' then 'Int. Remarks: ' || to_char(mv.internal_remarks)
              when to_char(mv.notes) &lt;&gt; 'В ' then 'Notes: ' || to_char(mv.notes)
            else null
         end notes
    , case when hist.revision_no &lt;&gt; 'В ' and hist.revision_date &lt;&gt; 'В '
                then hist.revision_no || ' / (' ||  hist.revision_date || ')' 
      else ' ' end historical_data
    , case when deadline_fh_round &lt; util.tah 
             or deadline_cy &lt; util.tac 
             or due_date &lt; sysdate
           then '1'
           else '0'
       end red_row
 from msc_taskcard s /* taskcards */
 join msc_taskcard_version mv on s.taskcardno_i = mv.taskcardno_i /* task version */
 join msc_maintenance_program m on s.mpno_i = m.mpno_i
 join msc_section_code c on m.mpno_i = c.mpno_i /* section code */
 join msc_mprev_taskcards mp_rev on mv.taskcard_verno_i = mp_rev.taskcard_verno_i
 join msc_mp_revision rev on mp_rev.revisionno_i = rev.revisionno_i 
                         and revision_status not in ('i', 't') /* only actual revision */
 join aircraft a on m.mpno = a.ac_typ
 /* 2019-04-23
    vtsymbal
    TRESHOLD &amp; INTERVALS
 */
 left join (
            select taskcard_verno_i, threshold, intervals
              from (
                    select taskcard_verno_i
                         , threshold
                         , listagg(
                                   case when threshold = 'N' then
                                                              case when ( (unit = accuracy) or (unit is null and accuracy is null) ) 
                                                                                           and amount_interval &gt; 0  
                                                                   then dimension_type || ': ' || amount_interval ||  ' ' || code
                                                                   when unit &lt;&gt; accuracy and due_at is null
                                                                   then dimension_type || ': ' || amount_interval ||  ' ' || unit
                                                                   else dimension_type || ': ' || amount_interval ||  ' ' || unit
                                                               end
                                        when threshold = 'Y' 
                                        then
                                             case when (unit &lt;&gt; accuracy and due_at is not null) or 
                                              ( ((unit &lt;&gt; accuracy) or (accuracy is null and unit is not null)) 
                                                                   and due_at is null and amount_interval &gt; 0 )
                                                  then dimension_type || ': ' || amount_interval || ' ' || unit
                                                  when ( unit = accuracy or unit is null and accuracy is null ) 
                                                                        and amount_interval &lt; 0
                                                  then dimension_type || ': ' || due_at || ' ' || code
                                                  when ( (unit = accuracy) or (due_at is null and accuracy is null and unit is null) ) 
                                                                          and amount_interval &gt; 0
                                                  then dimension_type || ': ' || amount_interval || ' ' || code
                                                  else dimension_type || ': ' || amount_interval ||  ' ' || unit      
                                              end
                                    end, '; '
                                  ) within group (order by threshold desc) unit
                      from msc_taskcard_version mv
                      join treq_time_requirement ttr on mv.taskcard_verno_i = ttr.event_key 
                                                    and ttr.event_type in ('TCREV') 
                                                    and ttr.status = 0
                      join treq_interval_group tig on ttr.timerequirementno_i = tig.timerequirementno_i
                      join (
                            select interval_groupno_i
                                 , counter_defno_i
                                 , amount_interval
                                 , accuracy
                                 , due_at
                                 , case when dimension_type = 'W' then 'WithIn'
                                        when dimension_type = 'I' then 'Interval'
                                        when dimension_type = 'B' then 'Before'
                                        else null
                                    end dimension_type
                                 , unit
                              from treq_interval
                           ) ti on tig.interval_groupno_i = ti.interval_groupno_i
                      join (
                            select counter_defno_i
                                 , case when code = 'H' then 'FH'
                                        when code = 'C' then 'CY'
                                        else code 
                                    end code 
                              from counter_definition
                           ) cd on ti.counter_defno_i = cd.counter_defno_i
                     group by taskcard_verno_i, threshold, taskcard_verno_i
                   )c
             pivot (max(unit) for threshold in ('Y' as threshold, 'N' as intervals))
           ) r on mv.taskcard_verno_i = r.taskcard_verno_i
 /* tah|tac */
 left join (
            select ac_registr, round(max(tah)/60, 2) tah, max(tac) tac
              from ac_utilization ac_util
             group by ac_registr
           ) util on a.ac_registr = util.ac_registr
/* last perfomed */
 left join (
            select rnk
                 , last_perf_date
                 , event_name
                 , ac_registr
                 , last_perf_cy
                 , last_perf_fh
              from (
                    select rank() over(partition by event_name, ac_registr order by absolute_due_date desc ) rnk 
                         , h.ac_registr, event_name
                         , case when th.release_tah &gt; 0 
                                then trunc(th.release_tah/60, 0) || ':'  || trunc(  ( mod(th.release_tah/60, 1) * (60/100) ) * 100, 0) 
                                else null
                            end last_perf_fh
                         , c.release_tac last_perf_cy
                         , to_char(to_date('31.12.1971', 'dd.mm.yyyy') + absolute_due_date, 'dd.mm.yyyy') last_perf_date
                      from wo_event_link e 
                      join wo_header h on e.event_perfno_i = h.event_perfno_i
                      join wo_transfer t on t.event_perfno_i = e.event_perfno_i and t.transfer_type = 'R'
                      left join (
                                 select event_transferno_i
                                      , trunc(due_at, 0) release_tah
                                   from wo_transfer_dimension d
                                   join counter c on d.counterno_i = c.counterno_i
                                   join counter_template ct on c.counter_templateno_i = ct.counter_templateno_i
                                   join counter_definition cd on ct.counter_defno_i = cd.counter_defno_i 
                                                             and code = 'H'
                                ) th on t.event_transferno_i = th.event_transferno_i
                      left join (
                                 select event_transferno_i, trunc(due_at, 0) release_tac
                                   from wo_transfer_dimension d
                                   join counter c on d.counterno_i = c.counterno_i
                                   join counter_template ct on c.counter_templateno_i = ct.counter_templateno_i
                                   join counter_definition cd on ct.counter_defno_i = cd.counter_defno_i and code = 'C'
                                ) c on t.event_transferno_i = c.event_transferno_i
                     where e.event_type in ('TCEFFLI') 
                       and e.event_status &lt;&gt; 'Z'
                       and absolute_due_date &gt; 0
                       and state = 'C'
                     group by h.ac_registr
                            , event_name
                            , th.release_tah
                            , c.release_tac
                            , absolute_due_date
                     order by absolute_due_date desc
                   )x
             where rnk = 1
           ) q on s.taskcardno = q.event_name and a.ac_registr = q.ac_registr
 /* last done wp/wo */
 left join ( 
            select wp_wo
                 , closing_date
                 , event_name
                 , ac_registr
                 , tag
                 , seq_no
              from (
                    select rank() over(partition by event_name, ac_registr order by closing_date desc) rnk
                         , wp_wo
                         , closing_date
                         , event_name
                         , ac_registr
                         , tag
                         , seq_no
                      from (
                            /* last done wp */
                            select wpno wp_wo
                                 , act_end_date closing_date
                                 , event_name
                                 , ac_registr
                                 , 'wp' tag
                                 , seq_no
                              from (
                                    select wpno
                                         , act_end_date
                                         , event_name
                                         , ac_registr
                                         , seqno_i seq_no
                                      from wp_header h
                                      join wp_assignment wa on h.wpno_i = wa.wpno_i
                                      join wo_event_link e on wa.event_perfno_i = e.event_perfno_i
                                      left join wp_sequence q on e.event_perfno_i = q.event_perfno_i
                                     where e.event_type = 'TCEFFLI'
                                       and e.event_status &lt;&gt; 'Z'
                                       and act_end_date &gt; 0
                                    ) x
                            union
                            /* last done wo */
                           select to_char(event_perfno_i) wp_wo
                                , issue_date closing_date
                                , event_name
                                , ac_registr
                                , 'wo' tag
                                , seq_no
                             from (
                                   select e.event_perfno_i
                                        , issue_date
                                        , event_name
                                        , ac_registr
                                        , null seq_no
                                     from wo_header h
                                     join wo_event_link e on h.event_perfno_i = e.event_perfno_i
                                    where h.type &lt;&gt; 'PD'
                                      and event_status &lt;&gt; 'Z'
                                      and e.event_type = 'TCEFFLI'
                                      and state = 'C'
                                  ) x
                           )t 
                   )tt
             where rnk = 1
             group by wp_wo, closing_date, event_name, ac_registr, tag, seq_no
           ) wp on a.ac_registr = wp.ac_registr 
               and s.taskcardno = wp.event_name
 /* deadline */
 join (
       select h.ac_registr
            , round(hours.due_at/60, 2) deadline_fh_round
            , event_name
            , case when hours.due_at &gt; 0
                   then (trunc(to_char(hours.due_at)/60)) || ':' ||(to_char(hours.due_at) - (trunc(to_char(hours.due_at)/60) * 60) )
                   else null end deadline_fh
            , trunc(cycles.due_at, 0) deadline_cy
            , (to_char(to_date('31.12.1971', 'dd.mm.yyyy') + absolute_due_date,'dd.mm.yyyy')) due_date
         from wo_event_link e
         join wo_header h on e.event_perfno_i = h.event_perfno_i
         join wo_transfer t on h.event_perfno_i = t.event_perfno_i
         /* tah */
         left join (
                    select event_transferno_i
                         , due_at
                         , life_value
                      from wo_transfer_dimension 
                      join counter c on wo_transfer_dimension.counterno_i = c.counterno_i 
                                    and c.readout_ref_type = 'LEG'
                      join counter_template ct on c.counter_templateno_i = ct.counter_templateno_i
                      join counter_definition cd on ct.counter_defno_i = cd.counter_defno_i
                     where code = 'H'
                   ) hours on t.event_transferno_i = hours.event_transferno_i
         /* tac */
         left join (
                    select event_transferno_i
                         , due_at
                         , life_value
                      from wo_transfer_dimension 
                      join counter c on wo_transfer_dimension.counterno_i = c.counterno_i 
                                    and c.readout_ref_type = 'LEG'
                      join counter_template ct on c.counter_templateno_i = ct.counter_templateno_i
                      join counter_definition cd on ct.counter_defno_i = cd.counter_defno_i
                     where code = 'C'
                   ) cycles on t.event_transferno_i = cycles.event_transferno_i            
        where e.pending_status = 0
          and e.event_type = 'TCEFFLI'
          and is_last_transfer = 'Y'
      )d on a.ac_registr = d.ac_registr 
        and s.taskcardno = d.event_name
 /*  planned wp/wo */
 left join (  
            select listagg(planned_wp_wo, ' / ') within group (order by tag) planned_wp_wo
                 , verno
                 , event_name
                 , ac_registr
                 , listagg(planned_items, ' / ') within group (order by ac_registr, event_name, planned_items) planned_items
              from (
                    select row_number() over(partition by h.ac_registr, event_name 
                                                 order by absolute_due_date desc) num
                         , taskcard_verno_i_mri verno
                         , event_name
                         , h.ac_registr
                         , to_char(h.event_perfno_i) planned_wp_wo
                         , null planned_items
                         , absolute_due_date planned_date
                         , 'wo' tag
                      from wo_header h
                      join wo_event_link e on h.event_perfno_i = e.event_perfno_i
                      left join msc_requirement_tc_link l on e.event_key_parent = l.req_linkno_i
                      join wo_transfer t on e.event_perfno_i = t.event_perfno_i
                      join aircraft i on h.ac_registr = i.ac_registr
                     where e.event_type = 'TCEFFLI'
                      and state = 'O'
                      and is_last_transfer = 'Y'
                      and (
                           absolute_due_date &gt; to_char(round(sysdate - to_date('31.12.1971', 'dd.mm.yyyy')) ) or
                           absolute_due_date is null
                          )
                      and h.type &lt;&gt; 'PD'
                    union
                   select row_number() over(partition by ac_registr, event_name 
                                                order by start_date desc) num
                        , taskcard_verno_i_mri verno
                        , event_name
                        , h.ac_registr
                        , wpno planned_wp_wo
                        , seqno_i planned_items
                        , start_date planned_date
                        , 'wp' tag
                     from wp_header h
                     join wp_assignment wa on h.wpno_i = wa.wpno_i
                     join wo_event_link e on wa.event_perfno_i = e.event_perfno_i
                     left join msc_requirement_tc_link l on e.event_key_parent = l.req_linkno_i
                     left join wp_sequence q on e.event_perfno_i = q.event_perfno_i
                    where e.event_type = 'TCEFFLI'
            /* 2019-12-17 delete condition wp_status = -1 */
                      and e.pending_status = 0
                   )x
             where num = 1
             group by verno
                    , event_name
                    , ac_registr
           ) plan on s.taskcardno = plan.event_name
                 and a.ac_registr = plan.ac_registr
 /* historical data */
 left join (
            select rank() over(partition by v.taskcard_verno_i
                                          , ac_registr 
                                   order by rev.revision_date desc
                                          , e.event_perfno_i desc
                                  ) rnk
                 , ac_registr
                 , s.taskcardno_i
                 , v.taskcard_verno_i
                 , s.taskcardno
                 , rev.revisionno_i
                 , rev.revision_no
                 , rev.revision_status
                 , to_char(to_date('31.12.1971', 'dd.mm.yyyy') + rev.revision_date, 'dd.mm.yyyy') revision_date
              from msc_taskcard s
              join msc_taskcard_version v on s.taskcardno_i = v.taskcardno_i
              join msc_mprev_taskcards mp_rev on v.taskcard_verno_i = mp_rev.taskcard_verno_i
              join msc_mp_revision rev on mp_rev.revisionno_i = rev.revisionno_i
              join msc_requirement_tc_link t on rev.revisionno_i = t.revisionno_i_mrs
                                            and v.taskcard_verno_i = t.taskcard_verno_i_mri
              join wo_event_link e on req_linkno_i = e.event_key_parent
                                  and event_name = s.taskcardno
                                  and pending_status &lt; 0
                                  and event_type = 'TCEFFLI'
              join wo_header h on e.event_perfno_i = h.event_perfno_i
            ) hist on mv.taskcard_verno_i = hist.taskcard_verno_i
                  and a.ac_registr = hist.ac_registr
                  and hist.rnk = 1
where  '@VAR.history@'='N'
 and  a.ac_registr in ('@VAR.ac_reg@')
  and section_code in ('@VAR.sec_code@')
  and (to_char('@VAR.ac_typ@') is null or a.ac_typ in ('@VAR.ac_typ@'))
  and (to_char('@VAR.task@') is null or  s.taskcardno_i in ('@VAR.task@'))
  and exists (
              select wo_header.ac_registr
                from wo_event_link
                join wo_header on wo_event_link.event_perfno_i = wo_header.event_perfno_i 
                              and wo_event_link.event_type = 'TCEFFLI' 
                join forecast on wo_event_link.event_perfno_i = forecast.event_perfno_i
               where s.taskcardno = wo_event_link.event_name
                 and a.ac_registr = wo_header.ac_registr
                 and a.ac_typ = forecast.ac_typ
                 and pending_status = 0
               group by wo_header.ac_registr
               )
  and ( 
       nvl('@VAR.overdue@', 'N') = 'N'  
       or ( 
           '@VAR.overdue@' = 'Y'  
           and (deadline_fh_round &lt; util.tah 
            or deadline_cy &lt; util.tac
            or due_date &lt; sysdate )
          ) 
      )
order by a.ac_registr
    , s.taskcardno desc</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="38_taskcard_status_GROUPED_AC" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>query for grouping ac_registr</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_model" id="ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="trim(leading '0' from serialno) serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="program_type" id="program_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="section_code" id="section_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_registr ac_reg" id="ac_reg"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="trunc(max(util.tah)/60) || ':' ||(max(util.tah) - (trunc(max(util.tah)/60) * 60) ) tah" id="tah"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="max(tac) tac" id="tac"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_reg@">
          <ds:object>@VAR.ac_reg@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.sec_code@">
          <ds:object>@VAR.sec_code@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select ac_model
	 , trim(leading '0' from serialno) serialno
	 , program_type
	 , section_code
	 , a.ac_registr ac_reg
	 , trunc(max(util.tah)/60) || ':' ||(max(util.tah) - (trunc(max(util.tah)/60) * 60) ) tah
	 , max(tac) tac
    from aircraft a /* ac_model, serialno */
    join msc_maintenance_program m on a.ac_typ = m.mpno /* присоединяю msc_maintenance_program */
    join msc_section_code c on m.mpno_i = c.mpno_i /* чтобы выбрать нужный section code */
    join ac_utilization util on a.ac_registr = util.ac_registr /* нахожу текущий tah/tac */
	where /* Aircraft */
	      a.ac_registr in ('@VAR.ac_reg@')
	  and section_code = '@VAR.sec_code@'
 and (to_char('@VAR.ac_typ@') is null or a.ac_typ in ('@VAR.ac_typ@'))
	group by ac_model, serialno, program_type, section_code, a.ac_registr</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="38_Taskcard_Status_hist" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Historical data</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.ac_registr" id="a.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.taskcardno_i" id="s.taskcardno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mp_task_no" id="mp_task_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="task_source" id="task_source"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="threshold" id="threshold"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="intervals" id="intervals"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_perf_fh" id="last_perf_fh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="last_perf_cy" id="last_perf_cy"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" to_char(to_date('31.12.1971' 'dd.mm.yyyy') + q.absolute_due_date'dd.mm.yyyy') last_perf_date" id="last_perf_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_wo last_perf_wp" id="last_perf_wp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="seq_no wp_items" id="wp_items"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="deadline_fh" id="deadline_fh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="deadline_cy" id="deadline_cy"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" to_char(to_date('31.12.1971' 'dd.mm.yyyy') + deadline_date'dd.mm.yyyy') deadline_date" id="deadline_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when to_char(to_date('31.12.1971' 'dd.mm.yyyy') + deadline_date 'dd.mm.yyyy') &lt; to_date(sysdate'dd.mm.yyyy') then 'wtf'&#10;            when deadline_date is null and deadline_fh is null and deadline_cy is null then 'wtf'&#10;            else 'ok' end check_dl" id="check_dl"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="planned_wp_wo" id="planned_wp_wo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.seqno_i planned_items" id="planned_items"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="notes" id="notes"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when hist.revision_no &lt;&gt; 'В ' and hist.revision_date &lt;&gt; 'В '&#10;                then hist.revision_no || ' / (' ||  hist.revision_date || ')' &#10;      else ' ' end historical_data" id="historical_data"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.history@">
          <ds:object>@VAR.history@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_reg@">
          <ds:object>@VAR.ac_reg@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.sec_code@">
          <ds:object>@VAR.sec_code@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.task@">
          <ds:object>@VAR.task@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select a.ac_registr
     , s.taskcardno_i
     , s.taskcardno mp_task_no
     , (select listagg(description, ', ') within
        group (order by description) amazing
         from db_link
        where mv.taskcard_verno_i = db_link.source_pk
          and db_link.source_type = 'TCLS'
     group by db_link.source_pk) task_source
    , threshold
    , intervals
    , last_perf_fh
    , last_perf_cy
    , last_perf_date
    , wp_wo last_perf_wp
    , seq_no wp_items
    , deadline_fh
    , deadline_cy
    , due_date deadline_date
    , case when due_date &lt; to_date(sysdate, 'dd.mm.yyyy') then 'wtf'
           when due_date is null and deadline_fh is null and deadline_cy is null then 'wtf'
           else 'ok' end check_dl
    , planned_wp_wo
    , planned_items
    , case when to_char(mv.internal_remarks) &lt;&gt; 'В ' and to_char(mv.notes) &lt;&gt; 'В ' then 'Notes: ' || to_char(mv.notes) || chr(13)|| chr(10)|| 
             'Int. Remarks: ' || to_char(mv.internal_remarks)
              when to_char(mv.internal_remarks) &lt;&gt; 'В ' then 'Int. Remarks: ' || to_char(mv.internal_remarks)
              when to_char(mv.notes) &lt;&gt; 'В ' then 'Notes: ' || to_char(mv.notes)
            else null
         end notes
    , case when hist.revision_no &lt;&gt; 'В ' and hist.revision_date &lt;&gt; 'В '
                then hist.revision_no || ' / (' ||  hist.revision_date || ')' 
      else ' ' end historical_data
 from msc_taskcard s /* taskcards */
 join msc_taskcard_version mv on s.taskcardno_i = mv.taskcardno_i /* task version */
 join msc_maintenance_program m on s.mpno_i = m.mpno_i
 join msc_section_code c on m.mpno_i = c.mpno_i /* section code */
 join msc_mprev_taskcards mp_rev on mv.taskcard_verno_i = mp_rev.taskcard_verno_i
 join msc_mp_revision rev on mp_rev.revisionno_i = rev.revisionno_i 
                         and revision_status in ('i', 't') /* only actual revision */
                         and mv.revision_date = (
                                              select max(msc_taskcard_version.revision_date)
                                                from msc_taskcard
                                                   , msc_taskcard_version
                                               where msc_taskcard.taskcardno_i = msc_taskcard_version.taskcardno_i
                                                 and s.taskcardno_i = msc_taskcard.taskcardno_i
                                               group by msc_taskcard.taskcardno_i
                                               )
 join aircraft a on m.mpno = a.ac_typ
 /* 2019-04-23
    vtsymbal
    TRESHOLD &amp; INTERVALS
 */
 left join (
            select taskcard_verno_i
                 , threshold
                 , intervals
              from (
                    select taskcard_verno_i
                         , threshold
                         , listagg(
                                  case when threshold = 'N' then
                                                                case when ( (unit = accuracy) or (unit is null and accuracy is null) ) 
                                                                                             and amount_interval &gt; 0  
                                                                     then dimension_type || ': ' || amount_interval ||  ' ' || code
                                                                     when unit &lt;&gt; accuracy and due_at is null
                                                                     then dimension_type || ': ' || amount_interval ||  ' ' || unit
                                                                     else dimension_type || ': ' || amount_interval ||  ' ' || unit
                                                                 end
                                       when threshold = 'Y' then
                                                                case when (unit &lt;&gt; accuracy and due_at is not null) or 
                                                                ( ((unit &lt;&gt; accuracy) or (accuracy is null and unit is not null)) 
                                                                                     and due_at is null and amount_interval &gt; 0 )
                                                                     then dimension_type || ': ' || amount_interval || ' ' || unit
                                                                     when ( unit = accuracy or unit is null and accuracy is null ) 
                                                                                           and amount_interval &lt; 0
                                                                     then dimension_type || ': ' || due_at || ' ' || code
                                                                     when ( (unit = accuracy) or (due_at is null and accuracy is null and unit is null) ) and amount_interval &gt; 0
                                                                     then dimension_type || ': ' || amount_interval || ' ' || code
                                                                     else dimension_type || ': ' || amount_interval ||  ' ' || unit      
                                                                 end
                                   end
                                  , '; ') within group (order by threshold desc) unit
                      from msc_taskcard_version mv
                      join treq_time_requirement ttr on mv.taskcard_verno_i = ttr.event_key 
                                                    and ttr.event_type in ('TCREV') 
                                                    and ttr.status = 0
                      join treq_interval_group tig on ttr.timerequirementno_i = tig.timerequirementno_i
                      join (
                            select interval_groupno_i
                                 , counter_defno_i
                                 , amount_interval
                                 , accuracy
                                 , due_at
                                 , case when dimension_type = 'W' then 'WithIn'
                                        when dimension_type = 'I' then 'Interval'
                                        when dimension_type = 'B' then 'Before'
                                        else null
                                    end dimension_type
                                 , unit
                              from treq_interval
                            ) ti on tig.interval_groupno_i = ti.interval_groupno_i
                      join (
                            select counter_defno_i
                                 , case when code = 'H' then 'FH'
                                        when code = 'C' then 'CY'
                                        else code 
                                    end code 
                              from counter_definition
                           ) cd on ti.counter_defno_i = cd.counter_defno_i
                      group by taskcard_verno_i, threshold, taskcard_verno_i
                   )c
             pivot (max(unit) for threshold in ('Y' as threshold, 'N' as intervals))
           ) r on mv.taskcard_verno_i = r.taskcard_verno_i
 /* tah|tac */
 left join (
            select ac_registr
                 , round(max(tah)/60, 2) tah
                 , max(tac) tac
              from ac_utilization ac_util
             group by ac_registr
           ) util on a.ac_registr = util.ac_registr
 /* last perfomed */
 left join (
            select rnk
                 , last_perf_date
                 , event_name
                 , ac_registr
                 , last_perf_cy
                 , last_perf_fh
              from (
                    select rank() over(partition by event_name, ac_registr 
                                           order by absolute_due_date desc ) rnk 
                         , h.ac_registr, event_name
                         , case when th.release_tah &gt; 0 
                                   then trunc(th.release_tah/60, 0) || ':'  || trunc(  ( mod(th.release_tah/60, 1) * (60/100) ) * 100, 0) 
                                   else null
                            end last_perf_fh
                         , c.release_tac last_perf_cy
                         , to_char(to_date('31.12.1971', 'dd.mm.yyyy') + absolute_due_date, 'dd.mm.yyyy') last_perf_date
                      from wo_event_link e 
                      join wo_header h on e.event_perfno_i = h.event_perfno_i
                      join wo_transfer t on t.event_perfno_i = e.event_perfno_i and t.transfer_type = 'R'
                      left join (
                                 select event_transferno_i
                                      , trunc(due_at, 0) release_tah
                                   from wo_transfer_dimension d
                                   join counter c on d.counterno_i = c.counterno_i
                                   join counter_template ct on c.counter_templateno_i = ct.counter_templateno_i
                                   join counter_definition cd on ct.counter_defno_i = cd.counter_defno_i and code = 'H'
                                ) th on t.event_transferno_i = th.event_transferno_i
                     left join (
                                select event_transferno_i, trunc(due_at, 0) release_tac
                                  from wo_transfer_dimension d
                                  join counter c on d.counterno_i = c.counterno_i
                                  join counter_template ct on c.counter_templateno_i = ct.counter_templateno_i
                                  join counter_definition cd on ct.counter_defno_i = cd.counter_defno_i and code = 'C'
                               ) c on t.event_transferno_i = c.event_transferno_i
                    where e.event_type in ('TCEFFLI') 
                      and e.event_status &lt;&gt; 'Z'
                      and absolute_due_date &gt; 0
                      and state = 'C'
                    group by h.ac_registr
                           , event_name
                           , th.release_tah
                           , c.release_tac
                           , absolute_due_date
                    order by absolute_due_date desc
                   )x where rnk = 1
           ) q on s.taskcardno = q.event_name 
              and a.ac_registr = q.ac_registr
 /* last done wp/wo  */
 left join (
            select wp_wo
                 , closing_date
                 , event_name
                 , ac_registr
                 , tag
                 , seq_no
              from (
                    select rank() over(partition by event_name, ac_registr 
                                           order by closing_date desc) rnk
                         , wp_wo
                         , closing_date
                         , event_name
                         , ac_registr
                         , tag
                         , seq_no
                      from (
                            /* last done wp */
                        select wpno wp_wo
                             , act_end_date closing_date
                             , event_name
                             , ac_registr
                             , 'wp' tag
                             , seq_no
                          from (
                                select wpno, act_end_date, event_name, ac_registr, seqno_i seq_no
                                  from wp_header h
                                  join wp_assignment wa on h.wpno_i = wa.wpno_i
                                  join wo_event_link e on wa.event_perfno_i = e.event_perfno_i
                                  left join wp_sequence q on e.event_perfno_i = q.event_perfno_i
                                 where e.event_type = 'TCEFFLI'
                                   and e.event_status &lt;&gt; 'Z'
                                   and act_end_date &gt; 0
                               ) x
                        union
                        /* last done wo */
                        select to_char(event_perfno_i) wp_wo
                            , issue_date closing_date
                            , event_name, ac_registr, 'wo' tag, seq_no
                          from (select e.event_perfno_i, issue_date, event_name, ac_registr, null seq_no
                                  from wo_header h
                                  join wo_event_link e on h.event_perfno_i = e.event_perfno_i
                                 where h.type &lt;&gt; 'PD'
                                   and event_status &lt;&gt; 'Z'
                                   and e.event_type = 'TCEFFLI'
                                   and state = 'C') x
                        )t )tt
                where rnk = 1
                group by wp_wo, closing_date, event_name, ac_registr, tag, seq_no
              ) wp on a.ac_registr = wp.ac_registr and s.taskcardno = wp.event_name
        /* deadline */
      join ( 
            select rank() over(partition by event_name, ac_registr order by t.event_transferno_i desc) rnk
                  , h.ac_registr
                  , round(hours.due_at/60, 2) deadline_fh_round
                  , event_name
                  , case when hours.due_at &gt; 0
                         then (trunc(to_char(hours.due_at)/60)) || ':' ||(to_char(hours.due_at) - (trunc(to_char(hours.due_at)/60) * 60) )
                         else null 
                     end deadline_fh
                  , trunc(cycles.due_at, 0) deadline_cy
                  , (to_char(to_date('31.12.1971', 'dd.mm.yyyy') + absolute_due_date,'dd.mm.yyyy')) due_date
               from wo_event_link e
               join wo_header h on e.event_perfno_i = h.event_perfno_i
               join wo_transfer t on h.event_perfno_i = t.event_perfno_i
               /* tah */
               left join (
                          select event_transferno_i
                                , due_at
                                , life_value
                            from wo_transfer_dimension 
                            join counter c on wo_transfer_dimension.counterno_i = c.counterno_i and c.readout_ref_type = 'LEG'
                            join counter_template ct on c.counter_templateno_i = ct.counter_templateno_i
                            join counter_definition cd on ct.counter_defno_i = cd.counter_defno_i
                           where code = 'H'
                        ) hours on t.event_transferno_i = hours.event_transferno_i
                        /* С†РёРєР»С‹ */
               left join (
                          select event_transferno_i
                               , due_at
                               , life_value
                            from wo_transfer_dimension 
                            join counter c on wo_transfer_dimension.counterno_i = c.counterno_i and c.readout_ref_type = 'LEG'
                            join counter_template ct on c.counter_templateno_i = ct.counter_templateno_i
                            join counter_definition cd on ct.counter_defno_i = cd.counter_defno_i
                           where code = 'C'
                         ) cycles on t.event_transferno_i = cycles.event_transferno_i            
              where e.pending_status &lt; 0
                and e.event_type = 'TCEFFLI'
                and transfer_type = 'T'
                and is_last_transfer = 'Y' 
           )d on a.ac_registr = d.ac_registr 
             and s.taskcardno = d.event_name
             and d.rnk = 1
 /* planned wp/wo */
 left join (  
            select listagg(planned_wp_wo, ' / ') within group (order by tag) planned_wp_wo
                 , verno
                 , event_name
                 , ac_registr
                 , listagg(planned_items, ' / ') within group (order by ac_registr, event_name, planned_items) planned_items
              from (
                    select row_number() over(partition by h.ac_registr, event_name 
                                                 order by absolute_due_date desc) num
                         , taskcard_verno_i_mri verno
                         , event_name
                         , h.ac_registr
                         , to_char(h.event_perfno_i) planned_wp_wo
                         , null planned_items
                         , absolute_due_date planned_date
                         , 'wo' tag
                      from wo_header h
                      join wo_event_link e on h.event_perfno_i = e.event_perfno_i
                      left join msc_requirement_tc_link l on e.event_key_parent = l.req_linkno_i
                      join wo_transfer t on e.event_perfno_i = t.event_perfno_i
                      join aircraft i on h.ac_registr = i.ac_registr
                     where e.event_type = 'TCEFFLI'
                       and state = 'O'
                       and is_last_transfer = 'Y'
                       and (
                            absolute_due_date &gt; to_char(round(sysdate - to_date('31.12.1971', 'dd.mm.yyyy')) ) or
                            absolute_due_date is null
                           )
                       and h.type &lt;&gt; 'PD'
                     union
                    select row_number() over(partition by ac_registr, event_name 
                                                 order by start_date desc) num
                         , taskcard_verno_i_mri verno
                         , event_name
                         , h.ac_registr
                         , wpno planned_wp_wo
                         , seqno_i planned_items
                         , start_date planned_date
                         , 'wp' tag
                      from wp_header h
                      join wp_assignment wa on h.wpno_i = wa.wpno_i
                      join wo_event_link e on wa.event_perfno_i = e.event_perfno_i
                      left join msc_requirement_tc_link l on e.event_key_parent = l.req_linkno_i
                      left join wp_sequence q on e.event_perfno_i = q.event_perfno_i
                     where e.event_type = 'TCEFFLI'
                    /* 2019-12-17 delete condition wp_status = -1 */
                       and e.pending_status = 0
                   )x
             where num = 1
             group by verno
                    , event_name
                    , ac_registr
           ) plan on s.taskcardno = plan.event_name
                 and mv.taskcard_verno_i = plan.verno
                 and a.ac_registr = plan.ac_registr
 /* historical data  */
 join (
            select rank() over(partition by v.taskcard_verno_i, ac_registr 
                                   order by rev.revision_date desc
                                          , e.event_perfno_i desc
                              ) rnk
                 , ac_registr
                 , s.taskcardno_i
                 , v.taskcard_verno_i
                 , s.taskcardno
                 , rev.revisionno_i
                 , rev.revision_no
                 , rev.revision_status
                 , to_char(to_date('31.12.1971', 'dd.mm.yyyy') + rev.revision_date, 'dd.mm.yyyy') revision_date
              from msc_taskcard s
              join msc_taskcard_version v on s.taskcardno_i = v.taskcardno_i
              join msc_mprev_taskcards mp_rev on v.taskcard_verno_i = mp_rev.taskcard_verno_i
              join msc_mp_revision rev on mp_rev.revisionno_i = rev.revisionno_i
              join msc_requirement_tc_link t on rev.revisionno_i = t.revisionno_i_mrs
                                            and v.taskcard_verno_i = t.taskcard_verno_i_mri
              join wo_event_link e on req_linkno_i = e.event_key_parent
                                  and event_name = s.taskcardno
                                  and pending_status &lt; 0
                                  and event_type = 'TCEFFLI'
              join wo_header h on e.event_perfno_i = h.event_perfno_i
           ) hist on mv.taskcard_verno_i = hist.taskcard_verno_i
                 and a.ac_registr = hist.ac_registr
                 and rev.revisionno_i = hist.revisionno_i
                 and hist.rnk = 1
where 1=1
  and '@VAR.history@'='Y'
  and a.ac_registr in ('@VAR.ac_reg@')
  and section_code in ('@VAR.sec_code@')
  /* Taskcard */ 
  and (to_char('@VAR.task@') is null or s.taskcardno_i in ('@VAR.task@'))
  and exists (
              select wo_header.ac_registr
                from wo_event_link
                join wo_header on wo_event_link.event_perfno_i = wo_header.event_perfno_i 
                              and wo_event_link.event_type = 'TCEFFLI' 
               where s.taskcardno = wo_event_link.event_name
                 and a.ac_registr = wo_header.ac_registr
                 and pending_status &lt; 0
               group by wo_header.ac_registr
             )
  and (to_char('@VAR.ac_typ@') is null or a.ac_typ in ('@VAR.ac_typ@'))
order by a.ac_registr, s.taskcardno desc</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
