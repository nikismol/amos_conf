  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Part_Capability" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN REGEXP_LIKE(part.partno'^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ" id="part.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.capability" id="part_capability.capability"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="capability.description" id="capability.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.shop" id="part_capability.shop"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="address.name as shop_name" id="shop_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.approved_by" id="part_capability.approved_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.approved_date" id="part_capability.approved_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.remarks" id="part_capability.remarks"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.referenceno" id="part_capability.referenceno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.revision" id="part_capability.revision"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.cmm_revision_date" id="part_capability.cmm_revision_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.entry_sign" id="part_capability.entry_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_capability.entry_date" id="part_capability.entry_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       DECODE(part_capability.status 0 'Active' 9 'Inactive'TO_CHAR(part_capability.status)) as status" id="status"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
       CASE WHEN REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
       part.ac_typ, 
       part_capability.capability,
       capability.description,
       part_capability.shop,
       address.name as shop_name,
       part_capability.approved_by,
       part_capability.approved_date,
       part_capability.remarks,
       part_capability.referenceno,
       part_capability.revision,
       part_capability.cmm_revision_date,
       part_capability.entry_sign,
       part_capability.entry_date,
       DECODE(part_capability.status, 0, 'Active', 9, 'Inactive', TO_CHAR(part_capability.status)) as status
FROM capability
JOIN part_capability ON capability.capability = part_capability.capability
JOIN part ON part.partseqno_i = part_capability.partseqno_i
LEFT JOIN address ON part_capability.shop = address.vendor AND address.status &lt;&gt; 9
WHERE 1=1
ORDER BY 1, 2, 3</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
