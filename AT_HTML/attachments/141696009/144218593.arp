  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="Должность eng" id="f_pos_eng"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Должность rus" id="f_pos_rus"/>
        <ds:columnDescriptor amosType="NONE" description="Заполнять только в случае изменений значений по умолчанию" id="text_1"/>
        <ds:columnDescriptor amosType="SG" description="ФИО - КОМУ" id="staff_to"/>
        <ds:columnDescriptor amosType="DO" description="Document Number" id="doc"/>
        <ds:columnDescriptor amosType="MODDOCTY" description="Document Type" id="doc_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Должность принимающего" id="t_pos_rus"/>
        <ds:columnDescriptor amosType="SG" description="ФИО - ОТ" id="staff_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="Должность принимающего" id="t_pos_eng"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="должность издателя (eng)" id="f_pos_eng">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>/</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="должность издателя (rus)" id="f_pos_rus">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description=".Заполнять только в случае изменений значений по умолчанию" id="text_1">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
