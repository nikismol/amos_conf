    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_Operators_WO_grouped" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Doc grouped</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="docno_i" id="docno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="docno" id="docno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.doc@">
          <ds:object>@VAR.doc@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.doc_typ@">
          <ds:object>@VAR.doc_typ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select docno_i, docno
from doc_header
where doc_type = 'OWO'
      and release_state &lt;&gt; 'I'
	  and /* Документ */
	('@VAR.doc@' is null or
	  docno_i in
	 (select trim(substr('@VAR.doc@' || ',',
						  decode(level,
								 1,
								 0,
								 instr('@VAR.doc@' || ',', ',', 1, level - 1) + 2),
						  instr('@VAR.doc@' || ',', ',', 1, level) -
						  decode(level,
								 1,
								 1,
								 instr('@VAR.doc@' || ',', ',', 1, level - 1) + 2)))
		 from dual
	   connect by level &lt;= length('@VAR.doc@') -
				  length(replace('@VAR.doc@', ',', '')) + 1))
	  and /* Тип документа */
	('@VAR.doc_typ@' is null or
	  doc_type in
	 (select trim(substr('@VAR.doc_typ@' || ',',
						  decode(level,
								 1,
								 0,
								 instr('@VAR.doc_typ@' || ',', ',', 1, level - 1) + 2),
						  instr('@VAR.doc_typ@' || ',', ',', 1, level) -
						  decode(level,
								 1,
								 1,
								 instr('@VAR.doc_typ@' || ',', ',', 1, level - 1) + 2)))
		 from dual
	   connect by level &lt;= length('@VAR.doc_typ@') -
				  length(replace('@VAR.doc_typ@', ',', '')) + 1))
group by docno_i, docno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="99_Operators_WO_basic_info" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Основная информация формы</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="dh.docno_i" id="dh.docno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dh.docno" id="dh.docno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" decode(dh.created_date&#10;                 0&#10;                 null&#10;                 to_char(to_date('31.12.1971' 'dd.mm.yyyy') + dh.created_date'dd.mm.yyyy')) created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dt.text" id="dt.text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr_text" id="ac_registr_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when dimension_type = 'B' then 'Before: '&#10;&#9;&#9;when dimension_type = 'W' then 'Threshold: '&#10;&#9;&#9;when dimension_type = 'I' then 'Interval: '&#10;&#9;&#9;else 'Unk. '&#10;&#9;  end || decode(ti.due_at&#10;                 0&#10;                 null&#10;                 to_char(to_date('31.12.1971' 'dd.mm.yyyy') + ti.due_at'dd.mm.yyyy')) due_at" id="due_at"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="firstname_rus" id="firstname_rus"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="lastname_rus" id="lastname_rus"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="middlename_rus" id="middlename_rus"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="firstname" id="firstname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="lastname" id="lastname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.position human_position" id="human_position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="telefax" id="telefax"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="telecom" id="telecom"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="email" id="email"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Operators_WO_grouped.docno_i@">
          <ds:object>@RMX_Operators_WO_grouped.docno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select dh.docno_i, dh.docno
	, decode(dh.created_date,
                 0,
                 null,
                 to_char(to_date('31.12.1971', 'dd.mm.yyyy') + dh.created_date,
                         'dd.mm.yyyy')) created_date 
	, dt.text
	, ac_typ
	, ac_registr_text
	, case when dimension_type = 'B' then 'Before: '
		when dimension_type = 'W' then 'Threshold: '
		when dimension_type = 'I' then 'Interval: '
		else ' '
	  end || decode(ti.due_at,
                 0,
                 null,
                 to_char(to_date('31.12.1971', 'dd.mm.yyyy') + ti.due_at,
                         'dd.mm.yyyy')) due_at
    , initcap(firstname_rus) firstname_rus
	, initcap(lastname_rus) lastname_rus
	, initcap(middlename_rus) middlename_rus
	, initcap(firstname) firstname
	, initcap(lastname) lastname
	, s.position human_position
	, telefax
	, telecom
	, email
	from doc_header dh
	/* Тут ищу описание WO */
	left join (select docno_i
				, (select listagg(text, ' ') within group (order by recno)
					from doc_text d
					where d.docno_i = doc_text.docno_i
					group by docno_i) text
			   from doc_text 
			   group by docno_i)dt on dh.docno_i = dt.docno_i
	left join event_effectivity_link el on dh.docno_i = el.event_key
	/* Поиск применимости */
	left join (select ap.effectivityno_i
				, ac_typ	
				, case when s.serialno_from = ' ' and s.serialno_to = ' ' then 'All existing and upcoming fleet' 
					else (select listagg(ac_registr, ', ') within group (order by ac_registr)
							from applicability
							join aircraft on applicability.ref_key = aircraft.aircraftno_i
							where ap.effectivityno_i = applicability.effectivityno_i
							and applicable = 'Y'
							group by effectivityno_i) 
				end ac_registr_text
			   from event_effectivity_link el
			   join applicability ap on el.effectivityno_i = ap.effectivityno_i and applicable = 'Y'
			   join aircraft a on ap.ref_key = a.aircraftno_i
               left join event_effectivity_sns s on el.effectivityno_i = s.effectivityno_i
			   group by ap.effectivityno_i, ac_typ, s.serialno_from, s.serialno_to) t on el.effectivityno_i = t.effectivityno_i
	 left join treq_time_requirement ttr on el.effectivity_linkno_i = ttr.event_key and ttr.event_type = 'EFL' and ttr.status = 0
	 left join treq_interval_group tig on ttr.timerequirementno_i = tig.timerequirementno_i and threshold = 'Y'
	 left join treq_interval ti on tig.interval_groupno_i = ti.interval_groupno_i
	 join ( select employee_no, telefax, telecom, email, firstname, lastname
		, (select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where v.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('40') 
			group by rm_property_value.owner_amos_key) firstname_rus
		, (select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where v.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('42') 
			group by rm_property_value.owner_amos_key) lastname_rus
		, (select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where v.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('41') 
			group by rm_property_value.owner_amos_key) middlename_rus
		, substr(translate( 
			(select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where v.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('50') 
			group by rm_property_value.owner_amos_key)
		, '~0123456789','~'), 1) position
	from sign s
	left join rm_property_value v on s.employee_no_i = v.owner_amos_key
	where property_type_no_i in ('40', '41', '42', '50')
	group by owner_amos_key, employee_no, telefax, telecom, email, firstname, lastname ) s on dh.created_by = s.employee_no
	where dh.doc_type = 'OWO'
      and dh.release_state &lt;&gt; 'I'
      and /* Документ */
	  dh.docno_i in ('@RMX_Operators_WO_grouped.docno_i@')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_Operators_WO_employee" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Изменение значений формы ОТ / КОМУ</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when lastname_rus_f &lt;&gt; ' ' then firstname_rus_f || ' ' || middlename_rus_f || ' ' || lastname_rus_f &#10;&#9;&#9;else ' '&#10;&#9;&#9;end fio_rus_f" id="fio_rus_f"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when lastname_f &lt;&gt; ' ' then firstname_f || ' ' || middlename_f || ' ' || lastname_f &#10;&#9;&#9;else ' '&#10;&#9;&#9;end fio_f" id="fio_f"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="position_f" id="position_f"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when lastname_rus_t &lt;&gt; ' ' then firstname_rus_t || ' ' || middlename_rus_t || ' ' || lastname_rus_t&#10;&#9;&#9;else ' '&#10;&#9;&#9;end fio_rus_t" id="fio_rus_t"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when lastname_t &lt;&gt; ' ' then firstname_t || ' ' || middlename_t || ' ' || lastname_t&#10;&#9;&#9;else ' '&#10;&#9;&#9;end fio_t" id="fio_t"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="position_t" id="position_t"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Operators_WO_grouped.docno_i@">
          <ds:object>@RMX_Operators_WO_grouped.docno_i@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.staff_from@">
          <ds:object>@VAR.staff_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.staff_to@">
          <ds:object>@VAR.staff_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select case when lastname_rus_f &lt;&gt; ' ' then firstname_rus_f || ' ' || middlename_rus_f || ' ' || lastname_rus_f 
		else ' '
		end fio_rus_f
	   , case when lastname_f &lt;&gt; ' ' then firstname_f || ' ' || middlename_f || ' ' || lastname_f 
		else ' '
		end fio_f
	   , position_f
	   , case when lastname_rus_t &lt;&gt; ' ' then firstname_rus_t || ' ' || middlename_rus_t || ' ' || lastname_rus_t
		else ' '
		end fio_rus_t
	   , case when lastname_t &lt;&gt; ' ' then firstname_t || ' ' || middlename_t || ' ' || lastname_t
		else ' '
		end fio_t
	   , position_t
	from (select 1 num, docno_i from doc_header where doc_type = 'OWO'
			and release_state &lt;&gt; 'I' and docno_i in ('@RMX_Operators_WO_grouped.docno_i@') ) dh
		left join (
		  select lpad( (select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where vf.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('40') 
			group by rm_property_value.owner_amos_key), 1) || '.' firstname_rus_f
		, lpad( (select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where vt.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('40') 
			group by rm_property_value.owner_amos_key), 1) || '.' firstname_rus_t
		, lpad( (select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where vf.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('41') 
			group by rm_property_value.owner_amos_key), 1) || '.' middlename_rus_f
		, lpad( (select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where vt.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('41') 
			group by rm_property_value.owner_amos_key), 1) || '.' middlename_rus_t
		, (select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where vf.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('42') 
			group by rm_property_value.owner_amos_key) lastname_rus_f
		, (select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where vt.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('42') 
			group by rm_property_value.owner_amos_key) lastname_rus_t
		, substr(translate( 
		(select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where vf.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('50') 
			group by rm_property_value.owner_amos_key)
			, '~0123456789','~'), 1) position_f
		, substr(translate( 
		(select listagg(rm_property_value.char_value, ' ') within group (order by rm_property_value.property_type_no_i desc)
			from rm_property_value
			where vt.owner_amos_key = rm_property_value.owner_amos_key
            and rm_property_value.property_type_no_i in ('50') 
			group by rm_property_value.owner_amos_key)
			, '~0123456789','~'), 1) position_t
		, sf.telefax telefax_f
		, st.telefax telefax_t
		, sf.telecom telecom_f
		, st.telecom telecom_t
		, sf.email email_f
		, st.email email_t
		, lpad(sf.firstname, 1) || '.' firstname_f
		, lpad(st.firstname, 1) || '.' firstname_t
		, sf.lastname lastname_f
		, st.lastname lastname_t
		, ( select initcap(translate( (replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(upper(lpad(rm_property_value.char_value, 1) ), 'ЦЫ','TSY')
			, 'ИЙ','II')
			, 'Ч','CH')
			, 'Ж','ZH')
			, 'КС','X')
			, 'Ё','YO')
			, 'Ю','IU')
			, 'Ш','SH')
			, 'Щ','SCH')
			, 'Э','EH') 
			, 'Ю','YU')
			, 'Я','YA')
			, 'Ц','TS') )
			,'АБВГДЕЗИЙКЛМНОПРСТУФХЫЪЬ', 'ABVGDEZIYKLMNOPRSTUFHY#'||chr(39)) ) || '.' middlename
		from rm_property_value
		where vf.owner_amos_key = rm_property_value.owner_amos_key
		and rm_property_value.property_type_no_i in ('41') ) middlename_f
		, ( select initcap(translate( (replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(upper(lpad(rm_property_value.char_value, 1) ), 'ЦЫ','TSY')
			, 'ИЙ','II')
			, 'Ч','CH')
			, 'Ж','ZH')
			, 'КС','X')
			, 'Ё','YO')
			, 'Ю','IU')
			, 'Ш','SH')
			, 'Щ','SCH')
			, 'Э','EH') 
			, 'Ю','YU')
			, 'Я','YA')
			, 'Ц','TS') )
			,'АБВГДЕЗИЙКЛМНОПРСТУФХЫЪЬ', 'ABVGDEZIYKLMNOPRSTUFHY#'||chr(39)) ) || '.' middlename
		from rm_property_value
		where vt.owner_amos_key = rm_property_value.owner_amos_key
		and rm_property_value.property_type_no_i in ('41') ) middlename_t
		, 1 num
	from (select (select  case when count(employee_no_i) &gt; 1 then null
					else max(employee_no_i)
					end employee_no_i
				from sign s
				where s.user_sign in ('@VAR.staff_from@') or '@VAR.staff_from@' is null ) employee_from
			  , (select  case when count(employee_no_i) &gt; 1 then null
					else max(employee_no_i)
					end employee_no_i
				from sign s
				where s.user_sign in ('@VAR.staff_to@') or '@VAR.staff_to@' is null ) employee_to
 	  from dual) a
	left join sign sf on a.employee_from = sf.employee_no_i
	left join rm_property_value vf on sf.employee_no_i = vf.owner_amos_key and vf.property_type_no_i in ('40', '41', '42', '50')
	left join sign st on a.employee_to = st.employee_no_i
	left join rm_property_value vt on st.employee_no_i = vt.owner_amos_key and vt.property_type_no_i in ('40', '41', '42', '50')
	group by vf.owner_amos_key, sf.employee_no, sf.telefax, sf.telecom, sf.email, sf.firstname, sf.lastname
		   , vt.owner_amos_key, st.employee_no, st.telefax, st.telecom, st.email, st.firstname, st.lastname ) t on dh.num = t.num</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="99_Operators_WO_Applicability" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Применимость</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="dh.docno_i" id="dh.docno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr_text" id="ac_registr_text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Operators_WO_grouped.docno_i@">
          <ds:object>@RMX_Operators_WO_grouped.docno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select dh.docno_i
	, ac_typ
	, listagg (ac_registr_text, ', ') within group (order by ac_registr_text) ac_registr_text
	from doc_header dh
	left join event_effectivity_link el on dh.docno_i = el.event_key 
	/* Поиск применимости */
	left join (select ap.effectivityno_i
				, ac_typ	
				, case when s.serialno_from = 'В ' and s.serialno_to = 'В ' then 'All existing and upcoming fleet' 
					else (select listagg(ac_registr, ', ') within group (order by ac_registr)
							from applicability
							join aircraft on applicability.ref_key = aircraft.aircraftno_i
							where ap.effectivityno_i = applicability.effectivityno_i
							and applicable = 'Y'
							group by effectivityno_i) 
				end ac_registr_text
			   from event_effectivity_link el
			   join applicability ap on el.effectivityno_i = ap.effectivityno_i and applicable = 'Y'
			   join aircraft a on ap.ref_key = a.aircraftno_i
               left join event_effectivity_sns s on el.effectivityno_i = s.effectivityno_i
			   group by ap.effectivityno_i, ac_typ, s.serialno_from, s.serialno_to) t on el.effectivityno_i = t.effectivityno_i
	where dh.doc_type = 'OWO'
      and dh.release_state &lt;&gt; 'I'
      and /* Документ */
      dh.docno_i in ('@RMX_Operators_WO_grouped.docno_i@')
    group by docno_i
           , ac_typ</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="99_Operators_WO_Description" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Описание заказа на выполнение работ</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="dh.docno_i" id="dh.docno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dt.text" id="dt.text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Operators_WO_grouped.docno_i@">
          <ds:object>@RMX_Operators_WO_grouped.docno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select dh.docno_i
	, dt.text
	from doc_header dh
	/* Тут ищу описание WO */
	left join (select docno_i
				, (select listagg(text, chr(13)||chr(10)) within group (order by recno)
					from doc_text d
					where d.docno_i = doc_text.docno_i
					group by docno_i) text
			   from doc_text 
			   group by docno_i)dt on dh.docno_i = dt.docno_i
	where dh.doc_type = 'OWO'
      and dh.release_state &lt;&gt; 'I'
      and /* Документ */
      dh.docno_i in ('@RMX_Operators_WO_grouped.docno_i@')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="99_Operators_WO_Deadline" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Крайний срок исполнения</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="dh.docno_i" id="dh.docno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" case when dimension_type = 'B' then 'Before: '&#10;&#9;&#9;when dimension_type = 'W' then 'Threshold: '&#10;&#9;&#9;when dimension_type = 'I' then 'Interval: '&#10;&#9;&#9;else ' '&#10;&#9;  end || decode(ti.due_at&#10;                 0&#10;                 null&#10;                 to_char(to_date('31.12.1971' 'dd.mm.yyyy') + ti.due_at'dd.mm.yyyy')) due_at" id="due_at"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@RMX_Operators_WO_grouped.docno_i@">
          <ds:object>@RMX_Operators_WO_grouped.docno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select dh.docno_i
	, case when dimension_type = 'B' then 'Before: '
		when dimension_type = 'W' then 'Threshold: '
		when dimension_type = 'I' then 'Interval: '
		else ' '
	  end || decode(ti.due_at,
                 0,
                 null,
                 to_char(to_date('31.12.1971', 'dd.mm.yyyy') + ti.due_at,
                         'dd.mm.yyyy')) due_at
	from doc_header dh
     left join event_effectivity_link el on dh.docno_i = el.event_key
	 left join treq_time_requirement ttr on el.effectivity_linkno_i = ttr.event_key and ttr.event_type = 'EFL' and ttr.status = 0
	 left join treq_interval_group tig on ttr.timerequirementno_i = tig.timerequirementno_i and threshold = 'Y'
	 left join treq_interval ti on tig.interval_groupno_i = ti.interval_groupno_i
	where dh.doc_type = 'OWO'
      and dh.release_state &lt;&gt; 'I'
      and ti.due_at &gt; 0
      and /* Документ */
      dh.docno_i in ('@RMX_Operators_WO_grouped.docno_i@')
    group by dimension_type
           , ti.due_at
           , dh.docno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
