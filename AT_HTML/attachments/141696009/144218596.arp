            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="ac_rob" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="distinct q.partno" id="q.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="q.serialno" id="q.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.ac_registr" id="t.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.rob_date" id="t.rob_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.ac_registr" id="f.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.ata_chapter" id="t.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.location" id="t.location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.d1" id="t.d1"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="t.d2" id="t.d2"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.destination_key" id="f.destination_key"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="q.code" id="q.code"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.Aircraft@">
          <ds:object>@VAR.Aircraft@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT    distinct q.partno,
            q.serialno,
            t.ac_registr,
    	t.rob_date,
               f.ac_registr,
               t.ata_chapter,
	t.location,
	t.d1,
	t.d2,
	f.destination_key,
	q.code
 FROM  
 (select rotables.partno, rotables.serialno, history.location, part.ata_chapter, history.ac_registr, history.historyno_i, rotables.psn, position.description as d1, part.description as d2, history.del_date, TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date+729), 'DD.MM.YYYY') as rob_date,
              MAX(history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i /*выборка по каждому значению из таблицы*/
       from rotables
       left join od_detail on od_detail.psn = rotables.psn
       left join history on rotables.psn = history.psn
       left join od_header on od_detail.orderno_i = od_header.orderno_i
       left join part on part.partno = rotables.partno
       left join position on position.position = history.location
       where 
            history.vm = 'YE'  
      ) t
      left join 
      (select rotables.partno, rotables.serialno, history.ac_registr, history.historyno_i,rotables.psn, history.del_date, db_link.destination_key,
              MAX(history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i /*выборка по каждому значению из таблицы*/
       from rotables
       left join od_detail on od_detail.psn = rotables.psn
       LEFT JOIN certificate_link ON certificate_link.source_key = rotables.psn and certificate_link.source_type = 'RO'
       LEFT JOIN db_link ON certificate_link.certificate_i = db_link.source_pk and db_link.source_type = 'CERT'

       left join history on rotables.psn = history.psn
       left join od_header on od_detail.orderno_i = od_header.orderno_i
       where 
            history.vm = 'YA'  
      ) f  on t.psn = f.psn
       join
  (select rotables.partno, rotables.serialno, history.ac_registr, history.historyno_i,rotables.psn, history.del_date,   od_header.vendor, od_header.order_type, adr_certificate_type.code,
              MAX(history.historyno_i) OVER (PARTITION BY history.psn) as max_historyno_i /*выборка по каждому значению из таблицы*/
       from rotables
       left join od_detail on od_detail.psn = rotables.psn
       left join history on rotables.psn = history.psn
		LEFT JOIN certificate_link ON certificate_link.source_key = rotables.psn and certificate_link.source_type = 'RO'
		left join certificate on certificate_link.certificate_i = certificate.certificate_i
		left join adr_certificate_type on certificate.certificate_type_i = adr_certificate_type.certificate_type_i
       left join od_header on od_detail.orderno_i = od_header.orderno_i
       where
               history.vm = 'B1'  and
	(history.receiver = 'OPEN' or history.receiver = 'CLOSE') or history.vm = 'SW'
      )q
    on t.psn = q.psn
 WHERE t.historyno_i = t.max_historyno_i and f.historyno_i = f.max_historyno_i  and (f.ac_registr != t.ac_registr) 
and (q.del_date &gt;=  f.del_date) and (t.del_date &gt;=  q.del_date) and q.historyno_i = q.max_historyno_i and t.ac_registr = '@VAR.Aircraft@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
