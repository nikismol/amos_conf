  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="LACMT" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="sn.firstname" id="sn.firstname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sn.lastname" id="sn.lastname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sn.mech_stamp" id="sn.mech_stamp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="spq.expiry_date" id="spq.expiry_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="spq.scope" id="spq.scope"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="spq.issue_date" id="spq.issue_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
sn.firstname, 
sn.lastname,
sn.mech_stamp,
spq.expiry_date,
spq.scope,
spq.issue_date
FROM sign sn
JOIN staff_pqs_qualification spq ON spq.employee_no_i=sn.employee_no_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
