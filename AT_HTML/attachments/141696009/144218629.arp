      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_Operating_Time_of_the_Component" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Hаработка компонента между установкой/снятием с ВС</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY f.removal_datef.partno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.partno" id="f.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.serialno" id="f.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.ac_registr" id="f.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.removal_date      date_rem" id="date_rem"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.installation_date date_inst" id="date_inst"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="/* Day Between Installation */&#10;       f.removal_date - f.installation_date dbi" id="dbi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.removal_tah tah_rem" id="tah_rem"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.installation_tah tah_inst" id="tah_inst"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="/* Flight Hours Between Installation */&#10;       f.removal_tah - f.installation_tah tbi" id="tbi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.removal_tac tac_rem" id="tac_rem"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.installation_tac tac_inst" id="tac_inst"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="/* Days Between Installation */&#10;       f.removal_tac - f.installation_tac cbi" id="cbi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="/* REM/INST TSN/CSN */&#10;&#9;   f.removal_tsn tsn_rem" id="tsn_rem"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.removal_csn csn_rem" id="csn_rem"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.installation_csn csn_inst" id="csn_inst"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.installation_tsn tsn_inst" id="tsn_inst"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="f.installation_tsn tsn_inst&#10;&#9;   /* TSN Between Installation */&#10;       f.removal_tsn - f.installation_tsn tsn_bi" id="tsn_bi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="/* CSN Between Installation */&#10;       f.removal_csn - f.installation_csn csn_bi" id="csn_bi"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.rem_date_from@">
          <ds:object>@VAR.rem_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.rem_date_to@">
          <ds:object>@VAR.rem_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY f.removal_date, f.partno, f.ac_registr) num,
       f.partno,
       f.serialno,
       f.ac_registr,
       to_char(f.removal_date, 'DD.Mon.YYYY')      date_rem,
       to_char(f.installation_date, 'DD.Mon.YYYY') date_inst,
       /* Day Between Installation */
       f.removal_date - f.installation_date dbi,
       f.removal_tah tah_rem,
       f.installation_tah tah_inst,
       /* Flight Hours Between Installation */
       f.removal_tah - f.installation_tah tbi,
       f.removal_tac tac_rem,
       f.installation_tac tac_inst,
       /* Days Between Installation */
       f.removal_tac - f.installation_tac cbi,
	   /* REM/INST TSN/CSN */
	   f.removal_tsn tsn_rem,
	   f.removal_csn csn_rem,
	   f.installation_csn csn_inst,
	   f.installation_tsn tsn_inst,
	   /* TSN Between Installation */
       f.removal_tsn - f.installation_tsn tsn_bi,
	   /* CSN Between Installation */
       f.removal_csn - f.installation_csn csn_bi
  from (select r.psn,
               r.partno,
               r.serialno,
               r.removal_date,
               r.removal_tsn,
               r.removal_csn,
               r.removal_tah,
               r.removal_tac,
               r.ac_registr,
               i.installation_date,
               i.installation_tsn,
               i.installation_csn,
               i.installation_tah,
               i.installation_tac,
               row_number() over(partition by r.historyno_i order by i.installation_date desc) rn
          from (select distinct psn,
                                partno,
                                serialno,
                                ac_registr,
                                historyno_i,
                                to_date('31.12.1971', 'dd.mm.yyyy') +
                                del_date removal_date,
                                h.tsn removal_tsn,
                                h.csn removal_csn,
                                h.tah removal_tah,
                                h.tac removal_tac
                  from history h
                 where vm = 'YA' /* Removal */
                   /* Partnumber */
 and ('@VAR.partno@' is null or
 partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
/* Serial No */
 and ('@VAR.serialno@' is null or
 h.serialno in
 (select trim(substr('@VAR.serialno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.serialno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.serialno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.serialno@') -
              length(replace('@VAR.serialno@', ',', '')) + 1))
                   and ('@VAR.rem_date_from@' is null or h.del_date &gt;= '@VAR.rem_date_from@') 
				   and ('@VAR.rem_date_to@' is null or h.del_date &lt;= '@VAR.rem_date_to@')
				   ) r
          left join (select distinct psn,
                                    partno,
                                    serialno,
                                    ac_registr,
                                    to_date('31.12.1971', 'dd.mm.yyyy') +
                                    del_date installation_date,
                                    h.tsn installation_tsn,
                                    h.csn installation_csn,
                                    h.tah installation_tah,
                                    h.tac installation_tac
                      from history h
                     where vm = 'YE' /* Installation */
                    ) i
            on r.psn = i.psn
           and r.ac_registr = i.ac_registr
           and r.removal_date &gt;= i.installation_date) f
 where f.rn = 1
 order by f.removal_date</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
