    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Service Order" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Печатная форма. Основная информация.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.orderno" id="h.orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   decode(orderdate&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + orderdate'dd.mm.yyyy')) orderdate" id="orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   decode(h.created_date&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + h.created_date'dd.mm.yyyy')) created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   decode(h.mutation_time&#10;              0&#10;              null&#10;              to_char(to_timestamp('00:00' 'HH24:MI') + ((h.mutation_time)/1000/60/60/24)'HH24:MI')) mutation_time" id="mutation_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.name || ' ' || a.name_1 || ' ' || a.name_2 vendor_name" id="vendor_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="email" id="email"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="phone" id="phone"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="fax" id="fax"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="header_text" id="header_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="header_remarks" id="header_remarks"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h.ext_orderno" id="h.ext_orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.priority" id="d.priority"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.detail_text" id="d.detail_text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.order@">
          <ds:object>@VAR.order@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select h.orderno,
	   decode(h.orderdate,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + h.orderdate,
                               'dd.mm.yyyy')) orderdate,
	   decode(h.created_date,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + h.created_date,
                               'dd.mm.yyyy')) created_date,
	   decode(h.mutation_time,
              0,
              null,
              to_char(to_timestamp('00:00', 'HH24:MI') + ((h.mutation_time)/1000/60/60/24),
                      'HH24:MI')) mutation_time,
	   a.name || ' ' || a.name_1 || ' ' || a.name_2 vendor_name,
	   email,
	   phone,
	   fax,
	   header_text,
	   header_remarks,
	   h.ext_orderno,
	   d.priority,
	   d.detail_text
	from od_header h
	left join od_detail d on h.orderno_i = d.orderno_i 
	join address a on h.vendor = a.vendor
	left join (select listagg(communication_number, ', ') within group (order by communication_number) email, address_i 
				from adr_communication where communication_type_i = '0' 
				group by address_i) m on a.address_i = m.address_i
	left join (select listagg(communication_number, ', ') within group (order by communication_number) phone, address_i 
				from adr_communication where communication_type_i = '4' 
				group by address_i) p on a.address_i = p.address_i
	left join (select listagg(communication_number, ', ') within group (order by communication_number) fax, address_i 
				from adr_communication where communication_type_i = '1' 
				group by address_i) f on a.address_i = f.address_i
	where h.order_type in ('RC', 'S')
	and (h.orderno_i in ('@VAR.order@') or h.orderno_i is null)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Service_Order_employee" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Service Order employee`s</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when sex = 'F' then 'Mrs. ' || firstname || ' ' || upper(lastname) &#10;&#9;&#9;when sex = 'M' then 'Mr. ' || firstname || ' ' || upper(lastname) &#10;&#9;&#9;else firstname || ' ' || upper(lastname) &#10;&#9;   end employee" id="employee"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" substr(translate(char_value '~0123456789''~')1) position" id="position"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.sign@">
          <ds:object>@VAR.sign@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select case when sex = 'F' then 'Mrs. ' || firstname || ' ' || upper(lastname) 
		when sex = 'M' then 'Mr. ' || firstname || ' ' || upper(lastname) 
		else firstname || ' ' || upper(lastname) 
	   end employee
	   , substr(translate(char_value, '~0123456789','~'), 1) position
	from sign s
	left join rm_property_value vf on s.employee_no_i = vf.owner_amos_key and property_type_no_i = 50
	where 
	/* Employee */
  user_sign = '@VAR.sign@' or  user_sign is null</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Service_Order_surcharges" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Information of surcharges</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY detailno_i) item" id="item"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="null subj" id="subj"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="null description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.amount price" id="price"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.unit curr" id="curr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.order@">
          <ds:object>@VAR.order@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY detailno_i) item
	, null subj
	, null description
	, s.amount price
	, s.unit curr
  from od_detail d
  left join od_surcharges s on d.detailno_i = s.ref_object_i
  where orderno_i in ('@VAR.order@') or orderno_i is null</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
