    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Full tab" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>full tab</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="WP" description="WPNO" id="WPNO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="start_date" id="start_date"/>
        <ds:columnDescriptor amosType="TIME" description="start_time" id="start_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="end_date" id="end_date"/>
        <ds:columnDescriptor amosType="TIME" description="end_time" id="end_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="station" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_start_date" id="act_start_date"/>
        <ds:columnDescriptor amosType="TIME" description="act_start_time" id="act_start_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_end_date" id="act_end_date"/>
        <ds:columnDescriptor amosType="TIME" description="act_end_time" id="act_end_time"/>
        <ds:columnDescriptor amosType="TIME" description="est_groundtime" id="est_groundtime"/>
        <ds:columnDescriptor amosType="TIME" description="est_groundtime-((act_end_date*1440+act_end_time)-(act_start_date*1440+act_start_time)) AS deltaGT" id="deltaGT"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="remarks" id="remarks"/>
        <ds:columnDescriptor amosType="TIME" description="act_end_date*1440+act_end_time-act_start_date*1440-act_start_time AS deltaAGT" id="deltaAGT"/>
        <ds:columnDescriptor amosType="TIME" description="(act_end_date*1440+act_end_time)-(end_date*1440+end_time) AS Zaderjka" id="Zaderjka"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="address.name as prov_name" id="prov_name"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateF@">
          <ds:object>@VAR.dateF@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateTO@">
          <ds:object>@VAR.dateTO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ACreg@">
          <ds:object>@VAR.ACreg@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ACTyp@">
          <ds:object>@VAR.ACTyp@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.timeTO@">
          <ds:object>@VAR.timeTO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.timeF@">
          <ds:object>@VAR.timeF@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ac_typ,
       ac_registr,
       WPNO,
       description,
       to_char(to_date('31.12.1971', 'DD.MM.YYYY') + start_date, 'DD.MM.YYYY') as start_date,
       start_time,
       to_char(to_date('31.12.1971', 'DD.MM.YYYY') + end_date, 'DD.MM.YYYY') as end_date,
       end_time,
       station,
       to_char(to_date('31.12.1971', 'DD.MM.YYYY') + act_start_date, 'DD.MM.YYYY') as act_start_date,
       act_start_time,
       to_char(to_date('31.12.1971', 'DD.MM.YYYY') + act_end_date, 'DD.MM.YYYY') as act_end_date,
       act_end_time,
       est_groundtime,
       est_groundtime-(
          (act_end_date*1440+act_end_time)-(act_start_date*1440+act_start_time)
       ) AS deltaGT,
       remarks,
    act_end_date*1440+act_end_time-act_start_date*1440-act_start_time AS deltaAGT,
		(act_end_date*1440+act_end_time)-(end_date*1440+end_time) AS Zaderjka,
address.name as prov_name
FROM WP_HEADER  
LEFT JOIN
(SELECT address.name, address.vendor FROM address) address ON wp_header.maintprov_address = address.vendor

WHERE   (
         end_date &gt;= '@VAR.dateF@' 
         AND start_date &lt;= '@VAR.dateTO@' 
         and (ac_registr='@VAR.ACreg@' OR '@VAR.ACreg@' IS NULL) 
         AND  (ac_typ='@VAR.ACTyp@' OR '@VAR.ACTyp@'='NON') 
         AND (
            start_date*1440+start_time &lt;= '@VAR.dateTO@'*1440+'@VAR.timeTO@' 
            AND end_date*1440+end_time &gt;= '@VAR.dateF@'*1440+'@VAR.timeF@'
         )
      )     
ORDER BY ac_typ,
         ac_registr,
         start_date,
         start_time</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Output_date" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Output date (from / to)</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971''DD.MM.YYYY') + ('@VAR.dateF@')'DD.Mon.YYYY') as d_beg" id="d_beg"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_DATE('31.12.1971''DD.MM.YYYY') + ('@VAR.dateTO@')'DD.Mon.YYYY') as d_end" id="d_end"/>
        <ds:columnDescriptor amosType="TIME" description="'@VAR.timeF@' as T_beg" id="T_beg"/>
        <ds:columnDescriptor amosType="TIME" description="'@VAR.timeTO@' as T_end" id="T_end"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateF@">
          <ds:object>@VAR.dateF@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateTO@">
          <ds:object>@VAR.dateTO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.timeF@">
          <ds:object>@VAR.timeF@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.timeTO@">
          <ds:object>@VAR.timeTO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
TO_CHAR(TO_DATE('31.12.1971','DD.MM.YYYY') + ('@VAR.dateF@'),'DD.Mon.YYYY') as d_beg,
TO_CHAR(TO_DATE('31.12.1971','DD.MM.YYYY') + ('@VAR.dateTO@'),'DD.Mon.YYYY') as d_end, 
'@VAR.timeF@' as T_beg,
'@VAR.timeTO@' as T_end
FROM dual</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Full_tab" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>full tab</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="WPNO" id="WPNO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="start_date" id="start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="start_time" id="start_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="end_date" id="end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="end_time" id="end_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="station" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_start_date" id="act_start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_start_time" id="act_start_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_end_date" id="act_end_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_end_time" id="act_end_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="est_groundtime" id="est_groundtime"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="est_groundtime-(&#10;          (act_end_date*1440+act_end_time)-(act_start_date*1440+act_start_time)&#10;       ) AS deltaGT" id="deltaGT"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="remarks" id="remarks"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_end_date*1440+act_end_time-act_start_date*1440-act_start_time AS deltaAGT" id="deltaAGT"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(act_end_date*1440+act_end_time)-(end_date*1440+end_time) AS Zaderjka" id="Zaderjka"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateF@">
          <ds:object>@VAR.dateF@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dateTO@">
          <ds:object>@VAR.dateTO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ACreg@">
          <ds:object>@VAR.ACreg@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ACTyp@">
          <ds:object>@VAR.ACTyp@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.timeTO@">
          <ds:object>@VAR.timeTO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.timeF@">
          <ds:object>@VAR.timeF@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT ac_typ,
       ac_registr,
       WPNO,
       description,
       start_date,
       start_time,
       end_date,
       end_time,
       station,
       act_start_date,
       act_start_time,
       act_end_date,
       act_end_time,
       est_groundtime,
       est_groundtime-(
          (act_end_date*1440+act_end_time)-(act_start_date*1440+act_start_time)
       ) AS deltaGT,
       remarks,
    act_end_date*1440+act_end_time-act_start_date*1440-act_start_time AS deltaAGT,
		(act_end_date*1440+act_end_time)-(end_date*1440+end_time) AS Zaderjka
FROM WP_HEADER  
WHERE   (
         end_date &gt;= '@VAR.dateF@' 
         AND start_date &lt;= '@VAR.dateTO@' 
         and (ac_registr='@VAR.ACreg@' OR '@VAR.ACreg@' IS NULL) 
         AND  (ac_typ='@VAR.ACTyp@' OR '@VAR.ACTyp@'='NON') 
         AND (
            start_date*1440+start_time &lt;= '@VAR.dateTO@'*1440+'@VAR.timeTO@' 
            AND end_date*1440+end_time &gt;= '@VAR.dateF@'*1440+'@VAR.timeF@'
         )
      )     
ORDER BY ac_typ,
         ac_registr,
         start_date,
         start_time</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
