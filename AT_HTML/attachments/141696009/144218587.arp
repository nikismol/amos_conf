            <attribute name="size">77 16</attribute>
            <attribute name="visible">YES</attribute>
            <attribute name="auto-resize">NO</attribute>
            <conditional_attributes/>
            <attribute name="background-color">C0C0C0</attribute>
            <attribute name="color">000000</attribute>
            <attribute name="margin">0 0 0 0</attribute>
            <attribute name="padding">0 0 0 0</attribute>
            <attribute name="border">1 SOLID 000000</attribute>
            <attribute name="text">Qty</attribute>
            <attribute name="text-decoration">NONE</attribute>
            <attribute name="font">SansSerif BOLD 11</attribute>
            <attribute name="text-align">CENTER</attribute>
            <attribute name="line-break">WORD</attribute>
            <attribute name="splitable">NO</attribute>
            <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
          </view>
          <view class="LabelReportView" id="315" usage="cell">
            <attribute name="position">0 0</attribute>
            <attribute name="size">77 16</attribute>
            <attribute name="visible">YES</attribute>
            <attribute name="auto-resize">YES</attribute>
            <conditional_attributes/>
            <attribute name="color">000000</attribute>
            <attribute name="margin">0 0 0 0</attribute>
            <attribute name="padding">2 2 0 2</attribute>
            <attribute name="border">1 SOLID 000000</attribute>
            <attribute name="text">@RMX_Search_pn_on_ac_psition.qty@</attribute>
            <attribute name="text-decoration">NONE</attribute>
            <attribute name="font">SansSerif PLAIN 10</attribute>
            <attribute name="text-align">RIGHT</attribute>
            <attribute name="line-break">AS_IS</attribute>
            <attribute name="splitable">NO</attribute>
            <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
          </view>
        </column>
      </column_model>
      <attribute name="data-source">RMX_Search_pn_on_ac_psition</attribute>
    </view>
  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ACLOCIDN" description="LOCID Pk" id="loc"/>
        <ds:columnDescriptor amosType="POS" description="A/C Position" id="pos"/>
        <ds:columnDescriptor amosType="PA" description="P/N" id="part"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="LOCID Pk" id="loc">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="A/C position" id="pos">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Partnumber" id="part">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RMX_Search_pn_on_ac_psition" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Поиск P/N по Aircraft Position</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="ROW_NUMBER() OVER(ORDER BY p.partnopac.position) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.partno" id="p.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pac.ac_typ" id="pac.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ac.description" id="ac.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pac.position" id="pac.position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pos.description" id="pos.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pac.ata_chapter" id="pac.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="a.description" id="a.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pac.qty_per_position" id="pac.qty_per_position"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.partseqno_i" id="p.partseqno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pac.mutator" id="pac.mutator"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pac.mutation" id="pac.mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pac.created_by" id="pac.created_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pac.created_date" id="pac.created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pac.mutation_time" id="pac.mutation_time"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="locid_pk" id="locid_pk"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN pos.status = '0' THEN 'Active'&#10;&#9;   WHEN pos.status = '1' THEN 'New'&#10;&#9;   WHEN pos.status = '9' THEN 'Inactive'&#10;&#9;   ELSE 'Unk.'&#10;&#9;   END status" id="status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="qty_per_position qty" id="qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.pos@">
          <ds:object>@VAR.pos@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.part@">
          <ds:object>@VAR.part@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.loc@">
          <ds:object>@VAR.loc@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT ROW_NUMBER() OVER(ORDER BY p.partno, pac.position) num,
       p.partno,
       pac.ac_typ,
       ac.description,
       pac.position,
       pos.description,
       pac.ata_chapter,
       a.description,
       pac.qty_per_position,
       p.partseqno_i,
       pac.mutator,
       pac.mutation,
       pac.created_by,
       pac.created_date,
       pac.mutation_time,
	   locid_pk,
	   CASE WHEN pos.status = '0' THEN 'Active'
	   WHEN pos.status = '1' THEN 'New'
	   WHEN pos.status = '9' THEN 'Inactive'
	   ELSE 'Unk.'
	   END status,
	   qty_per_position qty
FROM part p
JOIN part_ac_position pac ON p.partseqno_i = pac.partseqno_i
JOIN ac_typ ac ON pac.ac_typ = ac.ac_typ
JOIN position pos ON pac.position = pos.position
JOIN ata_chapter a ON pac.ata_chapter = a.ata_chapter
WHERE /* Position */
('@VAR.pos@' is null or
 pac.position in
 (select trim(substr('@VAR.pos@' || ',',
    decode(level,
    1,
    0,
    instr('@VAR.pos@' || ',', ',', 1, level - 1) + 2),
     instr('@VAR.pos@' || ',', ',', 1, level) -
     decode(level,
     1,
     1,
     instr('@VAR.pos@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.pos@') -
     length(replace('@VAR.pos@', ',', '')) + 1))
/* Partnumber */
	 AND ('@VAR.part@' is null or
 p.partno in
 (select trim(substr('@VAR.part@' || ',',
    decode(level,
    1,
    0,
    instr('@VAR.part@' || ',', ',', 1, level - 1) + 2),
     instr('@VAR.part@' || ',', ',', 1, level) -
     decode(level,
     1,
     1,
     instr('@VAR.part@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.part@') -
     length(replace('@VAR.part@', ',', '')) + 1))
/* LOCID Pk */
	 AND ('@VAR.loc@' is null or
 locid_pk in
 (select trim(substr('@VAR.loc@' || ',',
    decode(level,
    1,
    0,
    instr('@VAR.loc@' || ',', ',', 1, level - 1) + 2),
     instr('@VAR.loc@' || ',', ',', 1, level) -
     decode(level,
     1,
     1,
     instr('@VAR.loc@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.loc@') -
     length(replace('@VAR.loc@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
