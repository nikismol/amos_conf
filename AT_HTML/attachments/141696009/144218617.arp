  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="r_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Дата для статистики:" id="r_date">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_IT_SYSUSE_NumberOfLogins" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(*) as cnt" id="cnt"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.r_date@">
          <ds:object>@VAR.r_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT count(*) as cnt
FROM reactivation_log 
WHERE reactivation_log.description = 'Login' AND reactivation_log.login_date = @VAR.r_date@</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_IT_SYSUSE_FormatDate" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (@VAR.r_date@ + 729)'DD.MM.YYYY') as f_r_date" id="f_r_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.r_date@">
          <ds:object>@VAR.r_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (@VAR.r_date@ + 729), 'DD.MM.YYYY') as f_r_date
FROM dual</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_IT_SYSUSE_NumberOfUsers" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(*) as cnt" id="cnt"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.r_date@">
          <ds:object>@VAR.r_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT count(*) as cnt
FROM (
	SELECT DISTINCT reactivation_log.sign
	FROM reactivation_log
	WHERE reactivation_log.description = 'Login' AND reactivation_log.login_date = @VAR.r_date@ 
)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_IT_SYSUSE_NumberOfUsersPerDept" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>1</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="count(*) cnt" id="cnt"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dept" id="dept"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.r_date@">
          <ds:object>@VAR.r_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT count(*) cnt, dept
FROM
(
SELECT DISTINCT reactivation_log.sign, TRIM(AMOS_AEXT_USER.AFL_JUNK_USER_DEPT.dept) as dept
FROM reactivation_log
LEFT JOIN
AMOS_AEXT_USER.AFL_JUNK_USER_DEPT ON reactivation_log.sign = AMOS_AEXT_USER.AFL_JUNK_USER_DEPT.sign
WHERE reactivation_log.description = 'Login' AND reactivation_log.login_date = @VAR.r_date@
)
GROUP BY dept ORDER BY cnt DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="AFL_IT_SYSUSE_LoginSigns" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT reactivation_log.sign" id="reactivation_log.sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TRIM(AFL_JUNK_USER_DEPT.dept) as dept" id="dept"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aud.subdep" id="aud.subdep"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.lastname" id="sign.lastname"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname" id="sign.firstname"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.r_date@">
          <ds:object>@VAR.r_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
DISTINCT reactivation_log.sign, 
TRIM(aud.dept) as dept, 
aud.subdep, 
sign.lastname, 
sign.firstname
FROM reactivation_log
LEFT JOIN AMOS_AEXT_USER.AFL_JUNK_USER_DEPT aud ON reactivation_log.sign = aud.sign
LEFT JOIN sign ON sign.user_sign = reactivation_log.sign
WHERE reactivation_log.description = 'Login' AND reactivation_log.login_date = @VAR.r_date@
ORDER BY dept, aud.subdep, reactivation_log.sign</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
