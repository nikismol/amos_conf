        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="PHY_Unload_To_SAP" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Physical Stock Unload to SAP</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY partno serialno_batchnorecdetailno_i) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="serialno_batchno" id="serialno_batchno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="vendor" id="vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="owner" id="owner"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="station" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="store" id="store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="location" id="location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="condition" id="condition"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="recdetailno_i" id="recdetailno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   round(qty2) qty" id="qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.station@">
          <ds:object>@VAR.station@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.store@">
          <ds:object>@VAR.store@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.location@">
          <ds:object>@VAR.location@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.condition@">
          <ds:object>@VAR.condition@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.matclass@">
          <ds:object>@VAR.matclass@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.owner@">
          <ds:object>@VAR.owner@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ownerlist@">
          <ds:object>@VAR.ownerlist@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tool@">
          <ds:object>@VAR.tool@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.sploc@">
          <ds:object>@VAR.sploc@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.usp@">
          <ds:object>@VAR.usp@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY partno, serialno_batchno, recdetailno_i) num,
	   partno,
	   serialno_batchno,
	   vendor,
	   mat_class,
	   owner,
	   station,
	   store,
	   location,
	   condition,
	   recdetailno_i,
	   qty
from (select p.partno,
	   r.serialno serialno_batchno,
	   p.vendor,
	   p.mat_class,
	   r.owner,
	   l.station,
	   l.store,
	   l.location,
	   r.condition,
	   r.rec_detailno_i	recdetailno_i,
	   1 qty
from part p
join rotables r on p.partno = r.partno
join location l on r.locationno_i = l.locationno_i
left join station_store s on s.station = l.station and s.store = l.store
left join address a on r.owner = a.vendor
where l.location_type not in ('-3', '-107')
		  and r.locationno_i &lt;&gt; '-4'
		  and p.mat_class = 'R'
	  and r.condition &lt;&gt; 'US'
      and (
         r.outgoing_detailno_i is null
         or r.locationno_i &lt;&gt; -200
      )
      and r.partnonew = ' '
      and (
         r.ac_registr = ' '
         or r.ac_registr = 'TRANSF'
      )
 /* Station*/
 and ('@VAR.station@' is null or
 l.station in
 (select trim(substr('@VAR.station@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.station@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.station@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.station@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.station@') -
              length(replace('@VAR.station@', ',', '')) + 1))
 /* Store*/
 and ('@VAR.store@' is null or
 l.store in
 (select trim(substr('@VAR.store@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.store@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.store@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.store@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.store@') -
              length(replace('@VAR.store@', ',', '')) + 1))
/* Location */
 and (to_char('@VAR.location@') is null or l.locationno_i in ('@VAR.location@'))
/* Partnumber */
 and ('@VAR.partno@' is null or
 p.partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
/* Condition */
 and ('@VAR.condition@' is null or
 r.condition in
 (select trim(substr('@VAR.condition@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.condition@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.condition@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.condition@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.condition@') -
              length(replace('@VAR.condition@', ',', '')) + 1))
/* Material Class */
 and ('@VAR.matclass@' is null or
 mat_class in
 (select trim(substr('@VAR.matclass@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.matclass@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.matclass@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.matclass@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.matclass@') -
              length(replace('@VAR.matclass@', ',', '')) + 1))
/* Owner */
 and (to_char('@VAR.owner@') is null or a.address_i in ('@VAR.owner@'))
/* Owner list */
and (
nvl(@VAR.ownerlist@, 2) = 2 or (@VAR.ownerlist@ = 1 and r.owner = 'AFL')
)
/* Tool */
and p.tool in (@VAR.tool@)
/* Special Location */
and (
nvl(@VAR.sploc@, 1) = 1 or (@VAR.sploc@ = 2 and location_type = -5) or (@VAR.sploc@ = 3 and location_type = -200)
)
/* US Parts */
and (
nvl('@VAR.usp@', 'Y') = 'Y' or ('@VAR.usp@' = 'N' and r.condition &lt;&gt; 'US')
)
union
select p.partno,
	c.batchno serialno_batchno,
	p.vendor,
	p.mat_class,
	c.owner,
	l.station,
	l.store,
	l.location,
	c.condition,
	c.recdetailno_i	recdetailno_i,
	c.qty
from part p
join consumables c on p.partno = c.partno
join location l on c.locationno_i = l.locationno_i
left join station_store s on s.station = l.station and s.store = l.store
left join address a on c.owner = a.vendor
where c.qty &gt; 0
      AND p.mat_class &lt;&gt; 'R'
 /* Station*/
 and ('@VAR.station@' is null or
 l.station in
 (select trim(substr('@VAR.station@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.station@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.station@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.station@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.station@') -
              length(replace('@VAR.station@', ',', '')) + 1))
  /* Store*/
 and ('@VAR.store@' is null or
 l.store in
 (select trim(substr('@VAR.store@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.store@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.store@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.store@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.store@') -
              length(replace('@VAR.store@', ',', '')) + 1))
/* Location */
 and (to_char('@VAR.location@') is null or l.locationno_i in ('@VAR.location@'))
/* Partnumber */
 and ('@VAR.partno@' is null or
 p.partno in
 (select trim(substr('@VAR.partno@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.partno@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.partno@') -
              length(replace('@VAR.partno@', ',', '')) + 1))
/* Condition */
 and ('@VAR.condition@' is null or
 c.condition in
 (select trim(substr('@VAR.condition@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.condition@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.condition@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.condition@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.condition@') -
              length(replace('@VAR.condition@', ',', '')) + 1))
/* Material Class */
 and ('@VAR.matclass@' is null or
 mat_class in
 (select trim(substr('@VAR.matclass@' || ',',
                      decode(level,
                             1,
                             0,
                             instr('@VAR.matclass@' || ',', ',', 1, level - 1) + 2),
                      instr('@VAR.matclass@' || ',', ',', 1, level) -
                      decode(level,
                             1,
                             1,
                             instr('@VAR.matclass@' || ',', ',', 1, level - 1) + 2)))
     from dual
   connect by level &lt;= length('@VAR.matclass@') -
              length(replace('@VAR.matclass@', ',', '')) + 1))
/* Owner */
 and (to_char('@VAR.owner@') is null or a.address_i in ('@VAR.owner@'))
/* Owner list */
and (
nvl(@VAR.ownerlist@, 2) = 2 or (@VAR.ownerlist@ = 1 and c.owner = 'AFL')
)
/* Tool */
and p.tool in (@VAR.tool@)
/* Special Location */
and (
nvl(@VAR.sploc@, 1) = 1 or (@VAR.sploc@ = 2 and location_type = -5) or (@VAR.sploc@ = 3 and location_type = -200)
)
/* US Parts */
and (
nvl('@VAR.usp@', 'Y') = 'Y' or ('@VAR.usp@' = 'N' and c.condition &lt;&gt; 'US')
)
) xxx</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
