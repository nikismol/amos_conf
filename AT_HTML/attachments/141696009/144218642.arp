            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>1&amp;=&amp;NONE;2&amp;=&amp;Hangar Only;3&amp;=&amp;Outgoing Only;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
