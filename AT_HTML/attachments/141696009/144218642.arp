            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>'Y', 'N'&amp;=&amp;--- Выбрать ---;'Y'&amp;=&amp;True;'N'&amp;=&amp;False;</ds:data>
