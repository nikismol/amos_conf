  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="AD" description="&quot;Owner&quot;/&quot;Собственник&quot;" id="owner"/>
        <ds:columnDescriptor amosType="COND" description="&quot;Condition&quot;/&quot;Состояние компонентов&quot;" id="condition"/>
        <ds:columnDescriptor amosType="BOOL" description="" id="usp"/>
        <ds:columnDescriptor amosType="STA" description="&quot;Station&quot;/&quot;Станция&quot;" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="ownerlist"/>
        <ds:columnDescriptor amosType="LOO" description="&quot;Location&quot;/&quot;Локация&quot;" id="location"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="sploc"/>
        <ds:columnDescriptor amosType="STOO" description="&quot;Store&quot;/&quot;Склад&quot;" id="store"/>
        <ds:columnDescriptor amosType="MATCL" description="&quot;Material Class&quot;/&quot;Класс материала&quot;" id="matclass"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="tool"/>
        <ds:columnDescriptor amosType="PA" description="&quot;Partnumber&quot;/&quot;Партийный номер&quot;" id="partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Собственник" id="owner">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Состояние компонентов" id="condition">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
