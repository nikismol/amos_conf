  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="VAR" type="PARAMETER_DATASOURCE" version="1.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="tdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="succ"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Дата создания" id="tdate">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Статус выгрузки" id="succ">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>Y</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>Y&amp;=&amp;Невыгруженные документы;N&amp;=&amp;Неудачные попытки выгрузки;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RCH_ExportOrder" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Проверка невыгруженных записей по интерфейсу Export Order</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY ord.orderno_i) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ord.orderno" id="ord.orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ord.order_type" id="ord.order_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ord.mutation" id="ord.mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ord.mutator" id="ord.mutator"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="odd2.partno" id="odd2.partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tdate@">
          <ds:object>@VAR.tdate@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY ord.orderno_i) num
, ord.orderno
, ord.order_type
, ord.mutation
, ord.mutator
, odd2.partno
  from /* Specified orders in state "open" or draft orders (T) */
       (select hr.orderno_i,
               hr.orderno,
               /* Last mutation date and time */
               to_date('31.12.1971', 'dd.mm.yyyy') + nvl((select max(dl.mutation + dl.mutation_time / 24 / 60 / 60 / 1000) from od_detail dl where dl.orderno_i = hr.orderno_i), hr.mutation + hr.mutation_time / 24 / 60 / 60 / 1000) last_mutation_date,
			 hr.ext_state,
		     hr.order_type,
             hr.mutation,
             hr.mutator
          from od_header hr
         where  ( hr.order_type in ('P', 'PX', 'PR', 'PU', 'L', 'LU', 'Y', 'YU', 'R', 'X') and
               (( hr.state = 'O' and hr.ext_state = 'O') OR ( hr.state = 'O' and hr.ext_state = 'BO' )))
            	or ( hr.order_type = 'T' and hr.state = 'O' and ( hr.ext_state = 'B' or hr.ext_state = 'BO' )   ) /* только когда забукан */
				or hr.order_type = 'D') ord /* T и D в любом случае */
  left join /* Transfer history */
 (select hist.source_key,
         /* Last date of transfer for source_key */
         max(to_date('31.12.1971', 'dd.mm.yyyy') + hist.mutation +
             hist.mutation_time / 24 / 60 / 60 / 1000) last_mutation_date_time
    from aim_transfer_history hist
   where hist.success = 'Y'
     and hist.source_type = 'ORDER'
     and hist.service = 'TRANSFER_ORDER'
     and hist.source_key is not null
   group by hist.source_key) hist
    on ord.orderno = hist.source_key
left join 
(select odd.orderno_i, odd.partno, odd.posno
from od_detail odd
where odd.posno = '1'
group by odd.orderno_i, odd.partno, odd.posno) odd2 on ord.orderno_i = odd2.orderno_i
 where
/* Changed orders (been already loaded)*/
( ord.last_mutation_date &gt; hist.last_mutation_date_time and
ord.last_mutation_date &gt; to_date(TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (@VAR.tdate@+729), 'DD.MM.YYYY'), 'dd.mm.yyyy') and ord.ext_state = 'O' ) 
 or /* New Orders (never been loaded) */
( hist.source_key is null and
 ord.last_mutation_date &gt; to_date(TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (@VAR.tdate@+729), 'DD.MM.YYYY'), 'dd.mm.yyyy') 
 and (ord.ext_state = 'B' OR ord.ext_state = 'O' or ord.ext_state = 'BO') )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RCH_PartDefinition" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Проверка невыгруженных записей по интерфейсу Part Definition</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY partno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.partno" id="p.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" decode(p.created_date&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + p.created_date'dd.mm.yyyy')) created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="p.created_by" id="p.created_by"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tdate@">
          <ds:object>@VAR.tdate@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.succ@">
          <ds:object>@VAR.succ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY p.created_date, p.partno) num
, p.partno
, decode(p.created_date,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + p.created_date,
                               'dd.mm.yyyy')) created_date
, p.created_by
  from part p
  left join  aim_transfer_history aim on p.partno = aim.source_key
where p.created_date &gt;= '@VAR.tdate@'
and aim.success = '@VAR.succ@'
and aim.service = 'TRANSFER_PART_DEFINITION'
and aim.source_key is null
and p.extended_stateno_i = 3
and p.status = 0</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RCH_DateConvert" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Time date convert for report</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (@VAR.tdate@+729)'DD.MM.YYYY') as tdate" id="tdate"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tdate@">
          <ds:object>@VAR.tdate@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>SELECT 
TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (@VAR.tdate@+729), 'DD.MM.YYYY') as tdate
FROM dual</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RAM_RCH_ExportPickslip" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Проверка невыгруженных записей по интерфейсу Export Pickslip</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY pickslip_detail.mutationpickslip_detail.pickslipno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pick.pickslipno" id="pick.pickslipno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_detail.mutator" id="pickslip_detail.mutator"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" decode(pickslip_detail.mutation&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + pickslip_detail.mutation'dd.mm.yyyy')) mutation_date" id="mutation_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tdate@">
          <ds:object>@VAR.tdate@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.succ@">
          <ds:object>@VAR.succ@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY pickslip_detail.mutation, pickslip_detail.pickslipno) num
, pick.pickslipno
, pickslip_detail.mutator
, decode(pickslip_detail.mutation,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + pickslip_detail.mutation,
                               'dd.mm.yyyy')) mutation_date
from (select pickslipno
      from pickslip_detail
      minus
      select source_key from aim_transfer_history) pick
join pickslip_detail on pick.pickslipno = pickslip_detail.pickslipno
where pickslip_detail.mutation &gt;= '@VAR.tdate@'
and pickslip_detail.status not in ('0', '5')
union all
select row_number() over(ORDER BY aim.mutation, aim.source_key_i) num
, aim.source_key
, aim.mutator
, decode(aim.mutation,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + aim.mutation,
                               'dd.mm.yyyy')) mutation_date
from aim_transfer_history aim
where aim.service = 'EXPORT_PICKSLIP'
and aim.source_key is null
and aim.success = '@VAR.succ@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RCH_ComponentHistory" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Проверка невыгруженных записей по интерфейсу Component History</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY hist.source_key) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(hs.del_date&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + hs.del_date'dd.mm.yyyy')) del_date" id="del_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hs.voucherno" id="hs.voucherno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hs.vm" id="hs.vm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hs.historyno_i" id="hs.historyno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hs.partno" id="hs.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hs.serialno" id="hs.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hs.batchno" id="hs.batchno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(hs.mutation&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + hs.mutation'dd.mm.yyyy')) mutation_date" id="mutation_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="hs.mutator" id="hs.mutator"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tdate@">
          <ds:object>@VAR.tdate@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY hist.source_key) num,
       decode(hs.del_date,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + hs.del_date,
                      'dd.mm.yyyy')) del_date,
       hs.voucherno,
       hs.vm,
       hs.historyno_i,
       hs.partno,
       hs.serialno,
       hs.batchno,
       decode(hs.mutation,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + hs.mutation,
                      'dd.mm.yyyy')) mutation_date,
       hs.mutator
  from history hs
  left join od_rec_header rec on decode(length(trim(translate(substr(hs.voucherno,
                                                                     3),
                                                              '1234567890',
                                                              ' '))),
                                        null,
                                        substr(hs.voucherno, 3),
                                        '0') = rec.receivingno
  left join (select hist.source_key
               from aim_transfer_history hist
              where hist.success = 'Y'
                and hist.source_type = 'HI'
                and hist.service = 'EXPORT_COMPONENT_HISTORY'
                and hist.source_key is not null
              group by hist.source_key) hist on hs.historyno_i =
                                                hist.source_key
left join /* from-to locations */
 (select historyno_i,
         /*      regexp_replace(t.short_text,
         `Previous Location: ([[:alnum:]]+)/([[:alnum:]]+)/(.*)`,
         `\1`) station_from, */
         regexp_replace(t.short_text,
                        'Previous Location: ([[:alnum:]]+)/([[:alnum:]]+)/(.*)',
                        '\2') store_from
  /*      regexp_replace(t.short_text,
  `Previous Location: ([[:alnum:]]+)/([[:alnum:]]+)/(.*)`,
  `\3`) location_from */
    from history_text t
   where short_text like 'Previous Location: %') loc
    on hs.historyno_i = loc.historyno_i
 where (hs.vm in ('AA',
                  'AS',
                  'BN',
                  'CE',
                  'CR',
                  'CS',
                  'D',
                  'EA',
                  'ES',
                  'I',
                  'LC',
                  'LE',
                  'PS',
                  'SC',
                  'SX',
                  'TC',
                  'TS',
                  'TR',
                  'YA',
                  'Y2',
                  'SI',
                  'SR',
                  'RS',
                  'SE',
                  'YR') or
       (hs.vm = 'B1' and rec.awbno = 'RELEASE REPAIRABLE' and
       nvl(hs.higher_partno, chr(160)) in (chr(49824), chr(160))) /* higher part - пустое aka равно пробелу или пустоте*/
       or (hs.vm = 'B7' and
       (nvl(hs.orderno, chr(160)) in (chr(49824), chr(160)) or
       substr(hs.orderno, 1, 1) = 'R')) /* B7 (комплектование) выгружать только с пустым orderno или по R заказу */
       or (hs.vm = 'MO' and
       (nvl(hs.orderno, chr(160)) in (chr(49824), chr(160))) and
       nvl(hs.station, chr(160)) not in (chr(49824), chr(160))) /* MO только без ремонтного заказа, если нет ссылки на заказ - невидимый пробел, с самолетов не делаем */
       or (hs.vm = 'YE' and
       nvl(hs.station, chr(160)) not in (chr(49824), chr(160)) and
       nvl(hs.store, chr(160)) not in (chr(49824), chr(160))) /* иначе при загрузке данных по самолету выгрузится куча монтажей */
        or (hs.vm IN ('T', 'LC', 'TS', 'TR') and
       NOT (hs.store = 'LISTOFTL' and loc.store_from = 'LISTOFTL')) /* исключение перемещений внутри LISTOFTL */
       )
   and hist.source_key is null
   and hs.del_date &gt; '@VAR.tdate@'
 Order by num, hs.historyno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RCH_Shipment" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Проверка невыгруженных записей по интерфейсу Transfer Shipment</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY shd.mutationshd.shipmentno_i) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="shd.shipmentno_i" id="shd.shipmentno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(shd.created_date&#10;              0&#10;              null&#10;              to_char(to_date('31.12.1971' 'dd.mm.yyyy') + shd.created_date'dd.mm.yyyy')) created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="shd.created_by" id="shd.created_by"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tdate@">
          <ds:object>@VAR.tdate@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY shd.mutation, shd.shipmentno_i) num,
       shd.shipmentno_i,
       decode(shd.created_date,
              0,
              null,
              to_char(to_date('31.12.1971', 'dd.mm.yyyy') + shd.created_date,
                      'dd.mm.yyyy')) created_date,
       shd.created_by
  from sh_detail shd
  join aim_transfer_history aim on to_char(shd.shipmentno_i) =
                                        aim.source_key
 where (aim.service = 'TRANSFER_SHIPMENT' OR aim.service IS NULL)
   and shd.created_date &gt;= '@VAR.tdate@'
   and aim.source_key is null
   and shd.status = 0</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_1.0" id="RCH_Receiving" type="SQL_EDITOR_DATASOURCE" version="1.0">
      <ds:description>Проверка невыгруженных записей по интерфейсу Transfer Receiving</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(ORDER BY dt.receivingno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" concat('RD.'dt.recdetailno_i) recdetailno_i" id="recdetailno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dt.receivingno" id="dt.receivingno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dt.partno" id="dt.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dt.serialno" id="dt.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dt.batchno" id="dt.batchno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" decode(dt.mutation&#10;                       0&#10;                       null&#10;                       to_char(to_date('31.12.1971' 'dd.mm.yyyy') + dt.mutation'dd.mm.yyyy')) mutation_date" id="mutation_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="dt.mutator" id="dt.mutator"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.tdate@">
          <ds:object>@VAR.tdate@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_1.0" type="TEXT_EDITOR" version="1.0">
          <se:textStatement>select row_number() over(ORDER BY dt.receivingno) num
, concat('RD.', dt.recdetailno_i) recdetailno_i
, dt.receivingno
, dt.partno
, dt.serialno
, dt.batchno
, decode(dt.mutation,
                       0,
                       null,
                       to_char(to_date('31.12.1971', 'dd.mm.yyyy') + dt.mutation,
                               'dd.mm.yyyy')) mutation_date
, dt.mutator
from 
(select created_date, recdetailno_i, receivingno, orderno, status, partno, serialno, batchno, mutation, mutator from od_rec_detail) dt
join (select awbno, receivingno from od_rec_header) hr on hr.receivingno = dt.receivingno
join /* Transfer history */
 (select source_key_i
    from aim_transfer_history hist
   where hist.success = 'Y'
     and hist.source_type = 'RD'
     and hist.service = 'TRANSFER_RECEIVING'
     and hist.source_key_i is not null
   group by hist.source_key_i) hist
    on dt.recdetailno_i = hist.source_key_i
join od_header ord on dt.orderno = ord.orderno
where
	hist.source_key_i is null and
    dt.created_date &gt;= '@VAR.tdate@' and
    ord.order_type in ('P', 'PX', 'PR', 'PU', 'L', 'LU', 'Y', 'YU', 'R', 'RC', 'X') and
  	hr.awbno != 'RELEASE REPAIRABLE' and
	dt.recdetailno_i &gt; 0 and
	dt.status != 9 
  group by dt.recdetailno_i 
, dt.receivingno
, dt.partno
, dt.serialno
, dt.batchno
, dt.mutation
, dt.mutator</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
