    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="313_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="bohi_changes.changesno_i" id="bohi_changes.changesno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i as event_perfno_i" id="event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="bohi_changes.changes_date as changes_date" id="changes_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="bohi_changes.user_sign ||' ('|| sign.firstname ||' '|| lastname  ||')' as user_sign" id="user_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="bohi_changes.action as action" id="action"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="'revision' as history_type" id="history_type"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_from@">
          <ds:object>@VAR.v01_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_to@">
          <ds:object>@VAR.v02_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_user_role@">
          <ds:object>@VAR.v04_user_role@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_sign@">
          <ds:object>@VAR.v03_sign@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT bohi_changes.changesno_i,
              wo_header.event_perfno_i as event_perfno_i,
              TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + bohi_changes.changes_date, 'dd.mm.yyyy') as changes_date,
              bohi_changes.user_sign ||' ('|| sign.firstname ||' '|| lastname  ||')' as user_sign,
              bohi_changes.action as action,
              'revision' as history_type
FROM wo_header
JOIN bohi_version ON bohi_version.primkey = wo_header.event_perfno_i 
JOIN bohi_changes ON bohi_version.versionno_i=bohi_changes.versionno_i AND bohi_changes.changes_date BETWEEN @VAR.v01_date_from@ AND @VAR.v02_date_to@
LEFT JOIN sign ON bohi_changes.user_sign = sign.user_sign
LEFT JOIN user_access ON user_access.login_sign = bohi_changes.user_sign AND '@VAR.v04_user_role@' IS NOT NULL
WHERE 1=1
               AND bohi_version.mime_type = 'WO'
               AND wo_header.type IN ('P','C','M','S')
               AND (bohi_changes.user_sign = '@VAR.v03_sign@' AND '@VAR.v03_sign@' IS NOT NULL
                         OR user_access.user_group = '@VAR.v04_user_role@' AND '@VAR.v04_user_role@' IS NOT NULL)

UNION 

SELECT bohi_changes.changesno_i,
              wo_header.event_perfno_i as event_perfno_i,
              TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + bohi_info.entry_date, 'dd.mm.yyyy') as changes_date,
              bohi_info.user_sign ||' ('|| sign.firstname ||' '|| lastname  ||')' as user_sign,
              bohi_info.action as action,
              'info' as history_type
FROM wo_header
JOIN bohi_version ON bohi_version.primkey = wo_header.event_perfno_i 
JOIN bohi_changes ON bohi_version.versionno_i=bohi_changes.versionno_i AND bohi_changes.changes_date BETWEEN @VAR.v01_date_from@ AND @VAR.v02_date_to@
JOIN bohi_info ON bohi_changes.changesno_i = bohi_info.changesno_i AND bohi_info.entry_date BETWEEN @VAR.v01_date_from@ AND @VAR.v02_date_to@
LEFT JOIN sign ON bohi_info.user_sign = sign.user_sign
LEFT JOIN user_access ON user_access.login_sign = bohi_info.user_sign AND '@VAR.v04_user_role@' IS NOT NULL
WHERE 1=1
               AND bohi_version.mime_type = 'WO'
               AND wo_header.type IN ('P','C','M','S')
               AND (bohi_info.user_sign = '@VAR.v03_sign@' AND '@VAR.v03_sign@' IS NOT NULL
                         OR user_access.user_group = '@VAR.v04_user_role@' AND '@VAR.v04_user_role@' IS NOT NULL)
ORDER BY 1, history_type DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
