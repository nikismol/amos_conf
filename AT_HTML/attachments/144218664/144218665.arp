  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="del_date_from"/>
        <ds:columnDescriptor amosType="ORDER" description="" id="orderno"/>
        <ds:columnDescriptor amosType="SHOP" description="" id="shop"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="v06_search_type"/>
        <ds:columnDescriptor amosType="CM_PROJ" description="" id="cm_projectno"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="del_date_to"/>
        <ds:columnDescriptor amosType="PA" description="" id="partno"/>
        <ds:columnDescriptor amosType="SERIALNO" description="" id="serialno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="04. Date From" id="del_date_from">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="02. Order" id="orderno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
