            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="07. Serial Number" id="serialno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_CM_PROJECT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DISTINCT (cm_project.cm_projectno) as cm_projectno" id="cm_projectno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN cm_project.start_date IS NOT NULL AND cm_project_partition.end_date IS NOT NULL THEN 'Closed'&#10;&#9;&#9;&#9;WHEN cm_project.start_date IS NOT NULL AND cm_project_partition.end_date IS NULL THEN 'Running'&#10;&#9;&#9;&#9;WHEN cm_project.start_date IS NULL AND cm_project_partition.end_date IS NULL THEN 'Planned'&#10;&#9;   ELSE '' END as status" id="status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cm_project_partition.mime_type as partition_type" id="partition_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cm_project_partition.shop as shop" id="shop"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.orderno as orderno" id="orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cm_project_partition.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cm_project_partition.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="'' as partno_disp" id="partno_disp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="'' as serialno_disp" id="serialno_disp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN rotables_mod_history.mod_status IS NULL THEN '-' ELSE rotables_mod_history.mod_status END as mod_status" id="mod_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.ac_registr as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (h2.del_date+729)'DD.MM.YYYY') as del_date" id="del_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h2.csn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(h2.csn) END as csn" id="csn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h2.tsn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(h2.tsn) END as tsn" id="tsn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h2.tsn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(h2.tso) END as tso" id="tso"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN h2.csn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(h2.cso) END as cso" id="cso"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.tbi as tbi" id="tbi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.cbi as cbi" id="cbi"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od.reason as reason" id="reason"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.confirmed as failure" id="failure"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(cm_project_partition.findings_text) as findings" id="findings"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(cm_project_partition.manual_repair_text) as action" id="action"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(cm_project_partition.project_text) as publications" id="publications"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cm_workscope.description as workscope_no" id="workscope_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(cm_workscope.text) as workscope_sp" id="workscope_sp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cm_workscope.perform_user ||' '||sign.lastname||' '||sign.firstname as performed_by" id="performed_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cm_workscope.inspect_user" id="cm_workscope.inspect_user"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="cm_workscope.double_inspect_user" id="cm_workscope.double_inspect_user"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;   CASE WHEN cm_project.start_date IS NOT NULL THEN TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (cm_project.start_date+729)'DD.MM.YYYY') ELSE '' END as start_date" id="start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;&#9;   TO_CHAR(FLOOR(TO_NUMBER(stimecap.duration)/60))||':'||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(stimecap.duration) 60)))&lt;10&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;   &#9;     THEN '0'||(TO_CHAR(MOD(TO_NUMBER(stimecap.duration) 60)))&#10;&#9;   &#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; ELSE (TO_CHAR(MOD(TO_NUMBER(stimecap.duration)60)))&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;    END&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;||' H' as total" id="total"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="upart.used_part as used_part" id="used_part"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.store as store" id="store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.station as station" id="station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h2.location as location" id="location"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v06_search_type@">
          <ds:object>@VAR.v06_search_type@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.del_date_from@">
          <ds:object>@VAR.del_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.del_date_to@">
          <ds:object>@VAR.del_date_to@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.vm@">
          <ds:object>@VAR.vm@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.cm_projectno@">
          <ds:object>@VAR.cm_projectno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.orderno@">
          <ds:object>@VAR.orderno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.shop@">
          <ds:object>@VAR.shop@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.serialno@">
          <ds:object>@VAR.serialno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DISTINCT (cm_project.cm_projectno) as cm_projectno,
             CASE WHEN cm_project_partition.end_date IS NOT NULL THEN 'Closed' ELSE 'Open' END as status,
             cm_project_partition.mime_type as partition_type,
             cm_project_partition.shop as shop,
             od_header.orderno as orderno,
             cm_project_partition.partno as partno,
             cm_project_partition.serialno as serialno,
             part.description as description,
             rotables.partno as partno_disp,
             rotables.serialno as serialno_disp,
             CASE WHEN rotables_mod_history.mod_status IS NULL THEN '-' ELSE rotables_mod_history.mod_status END as mod_status,
             h2.ac_registr as ac_registr,
             h2.ac_typ as ac_typ,
             TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (h2.del_date+729), 'DD.MM.YYYY') as del_date,
             CASE WHEN h2.csn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(h2.csn) END as csn,
             CASE WHEN h2.tsn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(h2.msn)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(h2.msn),60)),'FM00') END as tsn,
            since_oh.tso as tso,
            since_oh.cso as cso,
             TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(h2.mbi)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(h2.mbi),60)),'FM00') as tbi,
             h2.cbi as cbi,
             TO_CHAR(od_header.header_text) as reason,
             h2.confirmed as failure,
             TO_CHAR(cm_project_partition.findings_text) as findings, 
             TO_CHAR(cm_project_partition.manual_repair_text) as action,
             TO_CHAR(cm_project_partition.project_text) as publications,
             cm_workscope.description as workscope_no,
             TO_CHAR(cm_workscope.text) as workscope_sp,
             cm_workscope.perform_user ||' '||sign.lastname||' '||sign.firstname as performed_by,
             cm_workscope.inspect_user,
             cm_workscope.double_inspect_user,
             CASE WHEN cm_project.start_date IS NOT NULL THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (cm_project.start_date+729), 'DD.MM.YYYY') ELSE '' END as start_date, 
             TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(stimecap.duration)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(stimecap.duration),60)),'FM00') ||' H' as total,
             upart.used_part as used_part,
             h2.store as store,
             h2.station as station,
             h2.location as location
FROM cm_project
LEFT JOIN cm_project_partition ON cm_project.cm_projectno_i= cm_project_partition.cm_projectno_i
LEFT JOIN od_detail ON cm_project_partition.mime_type_primary=od_detail.detailno_i AND cm_project_partition.mime_type='ORDER_DE'
LEFT JOIN od_header ON od_detail.orderno_i=od_header.orderno_i

LEFT JOIN (
                   SELECT root_orderno,
                                 child_orderno,
                                 root_detailno_i,
                                 child_detailno_i
                   FROM (
                                SELECT CONNECT_BY_ROOT od_header.orderno as root_orderno,
                                              CONNECT_BY_ROOT od_detail.detailno_i as root_detailno_i,
                                              od_header.orderno as parent_orderno,
                                              od_detail_link.parent_detailno_i,
                                              od_detail_link.child_detailno_i,
                                              od_header_second.orderno as child_orderno
                                FROM od_detail_link
                                LEFT JOIN od_detail ON od_detail.detailno_i = od_detail_link.parent_detailno_i
                                LEFT JOIN od_header ON od_header.orderno_i = od_detail.orderno_i
                                LEFT JOIN od_detail od_detail_second ON od_detail_second.detailno_i = od_detail_link.child_detailno_i
                                LEFT JOIN od_header od_header_second ON od_detail_second.orderno_i = od_header_second.orderno_i
                                START WITH od_detail_link.child_detailno_i is not null
                                CONNECT BY PRIOR  od_detail_link.child_detailno_i = od_detail_link.parent_detailno_i
                               ) 
                   ) od_hierarchy ON od_hierarchy.root_detailno_i = od_detail.detailno_i

LEFT JOIN part ON cm_project_partition.partno=part.partno
LEFT JOIN cm_workscope ON cm_project_partition.project_partition_i=cm_workscope.project_partition_i
LEFT JOIN sign ON cm_workscope.perform_user=sign.user_sign
LEFT JOIN time_captured ON cm_workscope.workscope_i=time_captured.primkey AND time_captured.mime_type='CM_WOSC'
LEFT JOIN (SELECT cm_workscope.project_partition_i as project_partition_i,
                                sum(time_captured.duration) as duration
                   FROM cm_workscope
                   LEFT JOIN time_captured ON cm_workscope.workscope_i=time_captured.primkey
                   WHERE time_captured.mime_type='CM_WOSC'
                   GROUP BY cm_workscope.project_partition_i
                  ) stimecap ON cm_workscope.project_partition_i=stimecap.project_partition_i
JOIN history h2 ON '@VAR.v06_search_type@' = 'removal_date'
                                   AND od_header.orderno=h2.orderno AND (h2.higher_partno IS NULL OR ASCII(h2.higher_partno)=49824)
                                   AND ( h2.higher_serialno IS NULL OR ASCII(h2.higher_serialno)=49824)
                                   AND h2.vm IN ('YA', 'SR', 'Y2')
                                   AND h2.del_date &gt;=  @VAR.del_date_from@
                                   AND h2.del_date &lt;=  @VAR.del_date_to@
                                   OR
                                   '@VAR.v06_search_type@' = 'receiving_date'
                                    AND od_header.orderno=h2.orderno AND h2.vm IN ('B1')
                                   AND h2.del_date &gt;=  @VAR.del_date_from@
                                   AND h2.del_date &lt;=  @VAR.del_date_to@
                                   OR
                                   '@VAR.v06_search_type@' = 'receiving_date'
                                    AND od_hierarchy.child_detailno_i=h2.od_detailno_i AND h2.vm IN ('B1')
                                   AND h2.del_date &gt;=  @VAR.del_date_from@
                                   AND h2.del_date &lt;=  @VAR.del_date_to@

LEFT JOIN od_rec_detail ON h2.recdetailno_i = od_rec_detail.recdetailno_i AND '@VAR.v06_search_type@' = 'receiving_date'
LEFT JOIN (
                    SELECT
                            oh.historyno_i,
                            CASE WHEN oh.tsn_unknown='Y' OR oh.oh_tsn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(CEIL(TO_NUMBER(oh.msn - NVL(oh.msn_oh, 0))/60)) END as tso,
                            CASE WHEN oh.csn_unknown='Y' OR oh.oh_csn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_NUMBER(oh.csn - NVL(oh.csn_oh, 0))) END as cso
                    FROM (
                                 SELECT 
                                         h.historyno_i,
                                         h_rec.historyno_i as historyno_i_oh,                                          
                                         MAX(h_rec.historyno_i) OVER (PARTITION BY h.historyno_i) as last_historyno_i_oh,
                                         h.msn,
                                         h.csn,
                                         h_rec.msn as msn_oh,
                                         h_rec.csn as csn_oh,
                                         h.tsn_unknown,
                                         h.csn_unknown,
                                         h_rec.tsn_unknown as oh_tsn_unknown,
                                         h_rec.csn_unknown as oh_csn_unknown 
                                 FROM history h
                                 JOIN history h_rec ON h.psn=h_rec.psn AND h_rec.vm='B1' AND h_rec.condition='OH'
                                 WHERE /*REGEXP_LIKE(h.vm, REPLACE('@VAR.vm@', ', ', '|'))
                                              AND*/ h_rec.historyno_i&lt;h.historyno_i 
                                ) oh
                    WHERE oh.last_historyno_i_oh=oh.historyno_i_oh
                  ) since_oh ON h2.historyno_i=since_oh.historyno_i
LEFT JOIN rotables_mod_history ON h2.psn=rotables_mod_history.psn
LEFT JOIN rotables ON h2.psn=rotables.psn
LEFT JOIN (SELECT cm_workscope.workscope_i as workscope_i,
                                LISTAGG (pickslip_booked.partno||' '||pickslip_booked.serialno||' '||part.description||' '||pickslip_booked.pickslipno, '; '||CHR(10)) WITHIN GROUP (ORDER BY pickslip_booked.pickslipno) as used_part
                   FROM cm_workscope
                   LEFT JOIN part_request_2 ON cm_workscope.workscope_i=part_request_2.event_key AND part_request_2.event_type = 'CM_WOSC'
                   LEFT JOIN pickslip_detail ON part_request_2.part_requestno_i=pickslip_detail.part_requestno_i
                   LEFT JOIN pickslip_booked ON pickslip_detail.pickslipno=pickslip_booked.pickslipno AND pickslip_detail.recno=pickslip_booked.recno
                   LEFT JOIN part ON pickslip_detail.partno=part.partno
                   WHERE pickslip_booked.status NOT IN ('10', '8')
                   GROUP BY cm_workscope.workscope_i
                  ) upart ON cm_workscope.workscope_i=upart.workscope_i
WHERE cm_workscope.workscope_i IS NOT NULL
              AND (REGEXP_LIKE(cm_project.cm_projectno, REPLACE('@VAR.cm_projectno@', ', ', '|')) OR '@VAR.cm_projectno@' IS NULL)
              AND (REGEXP_LIKE(od_header.orderno, REPLACE('@VAR.orderno@', ', ', '|')) OR '@VAR.orderno@' IS NULL)
              AND (REGEXP_LIKE(cm_project_partition.partno, REPLACE('@VAR.partno@', ', ', '|')) OR '@VAR.partno@' IS NULL)
              AND (REGEXP_LIKE(cm_project_partition.shop, REPLACE('@VAR.shop@', ', ', '|')) OR '@VAR.shop@' IS NULL)
              AND (REGEXP_LIKE(cm_project_partition.serialno, REPLACE('@VAR.serialno@', ', ', '|')) OR '@VAR.serialno@' IS NULL)
              /* исключаю отмененные поступления (при общем поиске по дате поступления -  VAR.v06_search_type = receiving_date) */
              AND (od_rec_detail.status &lt;&gt; 9 AND od_rec_detail.recno &lt;&gt; -1 OR h2.vm != 'B1')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
