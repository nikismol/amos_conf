      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (history.del_date+729)'DD.MM.YYYY') AS DEL_DATE" id="DEL_DATE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.ac_typ" id="history.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.ac_registr" id="history.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno AS pn_off" id="pn_off"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno AS sn_off" id="sn_off"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_part_on_off.partno AS pn_on" id="pn_on"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_part_on_off.serialno AS sn_on" id="sn_on"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN history.tsn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn)60))'FM00') END as TSN" id="TSN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN history.csn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(history.csn) END as CSN" id="CSN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi)60))'FM00') AS TBI" id="TBI"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(history.cbi) AS CBI" id="CBI"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="reason_text.reason" id="reason_text.reason"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.labelno" id="history.labelno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.PN@">
          <ds:object>@VAR.PN@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.SN@">
          <ds:object>@VAR.SN@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_FROM@">
          <ds:object>@VAR.DATE_FROM@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_TO@">
          <ds:object>@VAR.DATE_TO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.dDATE_TO@">
          <ds:object>@VAR.dDATE_TO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  
        TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (history.del_date+729), 'DD.MM.YYYY') AS DEL_DATE
        ,history.ac_typ 
        ,history.ac_registr
        ,history.partno AS pn_off
        ,history.serialno AS sn_off
        ,wo_part_on_off.partno AS pn_on
        ,wo_part_on_off.serialno AS sn_on
        ,CASE WHEN history.tsn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn),60)),'FM00') END as TSN
        ,CASE WHEN history.csn_unknown='Y' THEN 'UNKNOWN' ELSE TO_CHAR(history.csn) END as CSN
        ,TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi),60)),'FM00') AS TBI
        ,TO_CHAR(history.cbi) AS CBI
        ,reason_text.reason
        ,history.labelno
FROM history
LEFT JOIN  (
				SELECT history_text.historyno_i as historyno_i,
				RTRIM(XMLAGG(XMLELEMENT(E, history_text.short_text, ';').EXTRACT('//text()') ORDER BY history_text.recno).GetClobVal(), CHR(10)) as reason
				FROM history_text
				GROUP BY history_text.historyno_i
			) reason_text ON history.historyno_i = reason_text.historyno_i
LEFT JOIN wo_part_on_off ON history.labelno = wo_part_on_off.labelno
WHERE 
(REGEXP_LIKE(history.partno, REPLACE('@VAR.PN@', ', ', '|')) OR '@VAR.PN@' IS NULL)
AND
(REGEXP_LIKE(history.serialno, REPLACE('@VAR.SN@', ', ', '|')) OR '@VAR.SN@' IS NULL)
AND 
(history.del_date &gt;= '@VAR.DATE_FROM@' OR '@VAR.DATE_FROM@' IS NULL)
AND 
(history.del_date &lt;= '@VAR.DATE_TO@' OR '@VAR.dDATE_TO@' IS NULL)
AND 
vm = 'YA'



</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
