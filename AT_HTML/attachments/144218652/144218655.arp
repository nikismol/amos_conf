      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="BOOL" description="" id="main_scope"/>
        <ds:columnDescriptor amosType="WP" description="" id="WP"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Show Main Scope" id="main_scope">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Workpackage" id="WP">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="TO_SPTO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN ((tbl.tpp IS NULL OR tbl.tpp NOT IN ('B' 'S' 'E' 'Q' 'T' 'C')) AND (wo.ext_workorderno IS NOT NULL)) &#10;THEN DECODE(wo.workorderno_displaynullwel.event_name wo.workorderno_display)||'('||wo.ext_workorderno||')'&#10;ELSE DECODE(wo.workorderno_displaynullwel.event_namewo.workorderno_display)&#10;END as name" id="name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       decode(wel.event_display null wtd.header || ' ' || dbms_lob.substr(wtd.text 200 1)wel.event_display) as wel_event" id="wel_event"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="   &#10;decode (tbl.tpp&#10;       'C' 'Check'&#10;       'B' 'BTC'&#10;       'S' 'SRT' &#10;       'D' 'Document'&#10;       'R' 'Rot. Req.'&#10;       'V' 'Replacement Event'&#10;       'O' 'ET WO'&#10;       'W' 'Find. WO'&#10;       'XX' 'RRO'&#10;       'E' 'Change Order'&#10;       'SV' 'Shop Visit WO'&#10;       'SC' 'Sim. Complaint WO'&#10;       'I' 'Import WO'&#10;       'P' 'Panel Workorder'&#10;       'J' 'JIC Workorder'  &#10;       'ODT' 'ODT''Workorder') type" id="type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ws.seqno_i as seqno" id="seqno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.closing_date" id="wo_header.closing_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo.mech_sign||CASE WHEN (wo.mech_sign IS NOT NULL AND (closing_lastname_ru.char_value IS NOT NULL OR closing_firstname_ru.char_value IS NOT NULL)) THEN ' ('||closing_lastname_ru.char_value||' '||closing_firstname_ru.char_value||')' END as closing_name" id="closing_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wta.sign_off||CASE WHEN (wta.sign_off IS NOT NULL AND (signoff_lastname_ru.char_value IS NOT NULL OR signoff_firstname_ru.char_value IS NOT NULL)) THEN ' ('||signoff_lastname_ru.char_value||' '||signoff_firstname_ru.char_value||')' END as signoff_name" id="signoff_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_perf.sign_p as signgrp" id="signgrp"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_perf_BMD_1.sign_p_BMD_1 as signgrp_BMD_1" id="signgrp_BMD_1"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_perf_BMD_5.sign_p_BMD_5 as signgrp_BMD_5" id="signgrp_BMD_5"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_perf_BMD_10.sign_p_BMD_10 as signgrp_BMD_10" id="signgrp_BMD_10"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_perf_BMD_12.sign_p_BMD_12 as signgrp_BMD_12" id="signgrp_BMD_12"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_perf_others.sign_p_others as signgrp_others" id="signgrp_others"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_cap.duration as duration" id="duration"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_cap_BMD_1_dur.duration_BMD_1 as duration_BMD_1" id="duration_BMD_1"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_cap_BMD_5_dur.duration_BMD_5 as duration_BMD_5" id="duration_BMD_5"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_cap_BMD_10_dur.duration_BMD_10 as duration_BMD_10" id="duration_BMD_10"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_cap_BMD_12_dur.duration_BMD_12 as duration_BMD_12" id="duration_BMD_12"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_perf_others.duration_others as duration_others" id="duration_others"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.workgroup as workgroup" id="workgroup"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wr.remarks" id="wr.remarks"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ef.findings" id="ef.findings"/>
        <ds:columnDescriptor amosType="DOUBLE" description="SUM(req.total_hours/60.0)  planned" id="planned"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TRUNC(SUM(req.total_hours/60)0) || ':' || LPAD(TRUNC(SUM(req.total_hours) - floor(SUM(req.total_hours/60))*60 0) 2'0') planned_time" id="planned_time"/>
        <ds:columnDescriptor amosType="DOUBLE" description="&#10;decode (SUM(tc.duration*tc.prod_factor/60) null 0SUM(tc.duration*tc.prod_factor/60)) booked" id="booked"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;decode (TRUNC(SUM(tc.duration*tc.prod_factor/60)0) null 0 TRUNC(SUM(tc.duration*tc.prod_factor/60)0)) &#10;|| ':' ||&#10;decode (LPAD(TRUNC(SUM(tc.duration*tc.prod_factor) - floor(SUM(tc.duration*tc.prod_factor/60))*60 0) 2 '0') null '00' LPAD(TRUNC(SUM(tc.duration*tc.prod_factor) - floor(SUM(tc.duration*tc.prod_factor/60))*60 0) 2'0')) booked_time" id="booked_time"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.main_scope@">
          <ds:object>@VAR.main_scope@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DECODE(wo_header.workorderno_display,
                                null, wo_event_link.event_name,
                                wo_header.workorderno_display)||CASE WHEN (
                                                                                                                            DECODE (wo_event_link.taskcard_type,
                                                                                                                                              null, wo_header.event_type,
                                                                                                                                              'O', 'ODT',
                                                                                                                                               wo_event_link.taskcard_type) IS NULL OR wo_event_link.taskcard_type NOT IN ('B','S','E','Q','T','C')) AND wo_header.ext_workorderno IS NOT NULL
                                                                                                               THEN ' ('||wo_header.ext_workorderno||')'
                                                                                                    END as name,
              DECODE(wo_event_link.event_display,null,wo_text_description.header || ' ' || dbms_lob.substr(wo_text_description.text,200,1),wo_event_link.event_display) as wel_event,
              DECODE (
                                 DECODE (wo_event_link.taskcard_type,
                                                   null, wo_header.event_type,
                                                   'O', 'ODT',
                                                   wo_event_link.taskcard_type),
                                'C','Check',
                                'B','BTC',
                                'S', DECODE (wo_event_link.taskcard_type, 'S', 'SRT', 'Workorder'),
                                'D','Document',
                                'R','Rot. Req.',
                                'V','Replacement Event',
                                'O','ET WO',
                                'W','Find. WO',
                                'XX','RRO',
                                'E','Change Order',
                                'SV','Shop Visit WO',
                                'SC','Sim. Complaint WO',
                                'I','Import WO',
                                'P','Panel Workorder',
                                'J','JIC Workorder',
                                'ODT','ODT',
                                'Workorder') as type,
              wp_sequence.seqno_i as seqno,
              wo_header.closing_date,
              wo_header.mech_sign||CASE WHEN (wo_header.mech_sign IS NOT NULL AND (closing_lastname_ru.char_value IS NOT NULL OR closing_firstname_ru.char_value IS NOT NULL))
                                                                       THEN ' ('||closing_lastname_ru.char_value||' '||closing_firstname_ru.char_value||')'
                                                            END as closing_name,
              wta.sign_off||CASE WHEN (wta.sign_off IS NOT NULL AND (signoff_lastname_ru.char_value IS NOT NULL OR signoff_firstname_ru.char_value IS NOT NULL))
                                                   THEN ' ('||signoff_lastname_ru.char_value||' '||signoff_firstname_ru.char_value||')'
                                         END as signoff_name,
              sign_perf.sign_p as signgrp,
              sign_perf_BMD_1.sign_p_BMD_1 as signgrp_BMD_1,
              sign_perf_BMD_5.sign_p_BMD_5 as signgrp_BMD_5,
              sign_perf_BMD_10.sign_p_BMD_10 as signgrp_BMD_10,
              sign_perf_BMD_12.sign_p_BMD_12 as signgrp_BMD_12,
              sign_perf_others.sign_p_others as signgrp_others,
              time_cap.duration as duration,
              sign_perf_BMD_1.duration_BMD_1 as duration_BMD_1,
              sign_perf_BMD_5.duration_BMD_5 as duration_BMD_5,
              sign_perf_BMD_10.duration_BMD_10 as duration_BMD_10,
              sign_perf_BMD_12.duration_BMD_12 as duration_BMD_12,
              sign_perf_others.duration_others as duration_others,
              sign.workgroup as workgroup,
              wr.remarks,
              ef.findings,
              DECODE (plan_time.plan/60,
                                null, 0,
                                plan_time.plan/60) planned,
              DECODE (plan_time.plan,
                                null, '00:00',
                                TO_CHAR(trunc(sysdate) + (plan_time.plan)/24/60,
                                'hh24:mi')) as planned_time,
              DECODE (timec.mhrs/60,
                                null, 0,
                                timec.mhrs/60) booked,
              DECODE (timec.mhrs,
                                null, '00:00',
                                TO_CHAR(trunc(sysdate) + (timec.mhrs)/24/60,
                                'hh24:mi')) as booked_time
FROM wp_header
LEFT JOIN wp_assignment ON wp_header.wpno_i = wp_assignment.wpno_i     
LEFT JOIN wo_header ON  wo_header.event_perfno_i = wp_assignment.event_perfno_i      
LEFT JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i     
LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wo_header.event_perfno_i and workstep_link.sequenceno = 1  
LEFT JOIN wo_text_description ON wo_text_description.descno_i = workstep_link.descno_i                          
LEFT JOIN wp_sequence ON wp_sequence.event_perfno_i = wo_header.event_perfno_i and wp_sequence.wpno_i = wp_header.wpno_i     
LEFT JOIN sign ON sign.user_sign = wo_header.mech_sign   
LEFT JOIN (
                    SELECT wo_remarks.event_perfno_i as event_perfno_i,
                                  LISTAGG(wo_remarks.text, ', ') WITHIN GROUP (ORDER BY wo_remarks.text) as remarks                          
                    FROM wo_remarks                          
                    LEFT JOIN wp_assignment ON wo_remarks.event_perfno_i = wp_assignment.event_perfno_i                          
                    LEFT JOIN wp_header ON wp_header.wpno_i = wp_assignment.wpno_i                            
                    WHERE wp_header.wpno_i = @VAR.WP@
                    GROUP BY wo_remarks.event_perfno_i           
                   ) wr ON wr.event_perfno_i = wp_assignment.event_perfno_i  
LEFT JOIN (
                    SELECT event_finding.primkey as primkey,
                                  LISTAGG(event_finding.event_perfno_i,', ') WITHIN GROUP (ORDER BY event_finding.event_perfno_i) as findings                          
                    FROM event_finding                          
                    LEFT JOIN wp_assignment ON event_finding.primkey = wp_assignment.event_perfno_i                          
                    LEFT JOIN wp_header ON wp_header.wpno_i = wp_assignment.wpno_i                             
                    WHERE wp_header.wpno_i = @VAR.WP@   
                    GROUP BY event_finding.primkey           
                   ) ef ON ef.primkey = wp_assignment.event_perfno_i  
LEFT JOIN (
                    SELECT wo_text_action.event_perfno_i as event_perfno_i,
                                  LISTAGG(wo_text_action.sign_performed
                                                   ||CASE WHEN (sign.main_scope IS NOT NULL AND '@VAR.main_scope@'='Y') THEN ' '||'('||sign.main_scope||')' ELSE '' END													
                                                   ,', ') WITHIN GROUP (ORDER BY wo_text_action.sign_performed) as sign_off                         
                    FROM wo_text_action
                    LEFT JOIN wp_assignment ON wo_text_action.event_perfno_i = wp_assignment.event_perfno_i                          
                    LEFT JOIN wp_header ON wp_header.wpno_i = wp_assignment.wpno_i
                    LEFT JOIN sign ON wo_text_action.sign_performed=sign.user_sign
                    WHERE wp_header.wpno_i = @VAR.WP@                     
                    GROUP BY wo_text_action.event_perfno_i           
                   ) wta ON wta.event_perfno_i = wp_assignment.event_perfno_i

LEFT JOIN (	
                    SELECT wo_text_action.event_perfno_i as event_perfno_i,
                                  LISTAGG(coalesce(sign.workgroup, 'NO_GR'), ', '||chr(10)) WITHIN GROUP (ORDER BY sign.workgroup) as sign_p
                    FROM wo_text_action
                    LEFT JOIN wp_assignment ON wo_text_action.event_perfno_i = wp_assignment.event_perfno_i                          
                    LEFT JOIN wp_header ON wp_header.wpno_i = wp_assignment.wpno_i 
                    LEFT JOIN sign ON wo_text_action.sign_performed=sign.user_sign
                    WHERE wp_header.wpno_i = @VAR.WP@
                    GROUP BY wo_text_action.event_perfno_i
                   ) sign_perf ON sign_perf.event_perfno_i=wp_assignment.event_perfno_i

LEFT JOIN (
                    SELECT time_captured.primkey as event_perfno_i,
                                   LISTAGG(sign.workgroup, ', '||chr(10)) WITHIN GROUP (ORDER BY sign.workgroup) as sign_p_BMD_1,
                                   LISTAGG((to_char(FLOOR(time_captured.duration/60)||':'||LPAD(TO_CHAR(MOD(time_captured.duration, 60)), 2, 0))),', '||chr(10)) WITHIN GROUP (ORDER BY time_captured.duration) as duration_BMD_1       
                    FROM time_captured
                    JOIN sign ON time_captured.user_sign=sign.user_sign AND sign.workgroup = 'BMD-1'    
                    JOIN wp_assignment ON time_captured.primkey = wp_assignment.event_perfno_i AND time_captured.mime_type IN ('WO', 'MET') AND wp_assignment.wpno_i =  @VAR.WP@
                    GROUP BY time_captured.primkey
                   ) sign_perf_BMD_1 ON sign_perf_BMD_1.event_perfno_i=wp_assignment.event_perfno_i

LEFT JOIN (
                    SELECT time_captured.primkey as event_perfno_i,
                                   LISTAGG(sign.workgroup, ', '||chr(10)) WITHIN GROUP (ORDER BY sign.workgroup) as sign_p_BMD_5,
                                   LISTAGG((to_char(FLOOR(time_captured.duration/60)||':'||LPAD(TO_CHAR(MOD(time_captured.duration, 60)), 2, 0))),', '||chr(10)) WITHIN GROUP (ORDER BY time_captured.duration) as duration_BMD_5
                    FROM time_captured
                    JOIN sign ON time_captured.user_sign=sign.user_sign AND sign.workgroup = 'BMD-5'    
                    JOIN wp_assignment ON time_captured.primkey = wp_assignment.event_perfno_i AND time_captured.mime_type IN ('WO', 'MET') AND wp_assignment.wpno_i =  @VAR.WP@
                    GROUP BY time_captured.primkey
                   ) sign_perf_BMD_5 ON sign_perf_BMD_5.event_perfno_i=wp_assignment.event_perfno_i

LEFT JOIN (
                    SELECT time_captured.primkey as event_perfno_i,
                                   LISTAGG(sign.workgroup, ', '||chr(10)) WITHIN GROUP (ORDER BY sign.workgroup) as sign_p_BMD_10,
                                   LISTAGG((to_char(FLOOR(time_captured.duration/60)||':'||LPAD(TO_CHAR(MOD(time_captured.duration, 60)), 2, 0))),', '||chr(10)) WITHIN GROUP (ORDER BY time_captured.duration) as duration_BMD_10     
                    FROM time_captured
                    JOIN sign ON time_captured.user_sign=sign.user_sign AND sign.workgroup = 'BMD-10'    
                    JOIN wp_assignment ON time_captured.primkey = wp_assignment.event_perfno_i AND time_captured.mime_type IN ('WO', 'MET') AND wp_assignment.wpno_i =  @VAR.WP@
                    GROUP BY time_captured.primkey
                    ) sign_perf_BMD_10 ON sign_perf_BMD_10.event_perfno_i=wp_assignment.event_perfno_i

LEFT JOIN (
                    SELECT time_captured.primkey as event_perfno_i,
                                   LISTAGG(sign.workgroup, ', '||chr(10)) WITHIN GROUP (ORDER BY sign.workgroup) as sign_p_BMD_12,
                                   LISTAGG((to_char(FLOOR(time_captured.duration/60)||':'||LPAD(TO_CHAR(MOD(time_captured.duration, 60)), 2, 0))),', '||chr(10)) WITHIN GROUP (ORDER BY time_captured.duration) as duration_BMD_12      
                    FROM time_captured
                    JOIN sign ON time_captured.user_sign=sign.user_sign AND sign.workgroup = 'BMD-12' 
                    JOIN wp_assignment ON time_captured.primkey = wp_assignment.event_perfno_i AND time_captured.mime_type IN ('WO', 'MET') AND wp_assignment.wpno_i =  @VAR.WP@
                    GROUP BY time_captured.primkey
                   ) sign_perf_BMD_12 ON sign_perf_BMD_12.event_perfno_i=wp_assignment.event_perfno_i

LEFT JOIN (
                    SELECT time_captured.primkey as event_perfno_i,
                                   LISTAGG(CASE WHEN sign.workgroup IS NULL OR ASCII(sign.workgroup)=49824 THEN sign.department||' ('||department.description||')' ELSE sign.workgroup END, ', '||chr(10)) WITHIN GROUP (ORDER BY sign.workgroup) as sign_p_others,
                                   LISTAGG((to_char(FLOOR(time_captured.duration/60)||':'||LPAD(TO_CHAR(MOD(time_captured.duration, 60)), 2, 0))),', '||chr(10)) WITHIN GROUP (ORDER BY time_captured.duration) as duration_others                  
                    FROM time_captured
                    LEFT JOIN sign ON time_captured.user_sign=sign.user_sign 
                    LEFT JOIN department ON department.department=sign.department AND department.status &lt;&gt; 9
                    JOIN wp_assignment ON time_captured.primkey = wp_assignment.event_perfno_i AND time_captured.mime_type IN ('WO', 'MET') AND wp_assignment.wpno_i =  @VAR.WP@
                    WHERE sign.workgroup NOT IN ('BMD-1', 'BMD-5', 'BMD-10', 'BMD-12') OR sign.workgroup IS NULL
                    GROUP BY time_captured.primkey
                   ) sign_perf_others ON sign_perf_others.event_perfno_i=wp_assignment.event_perfno_i

LEFT JOIN (
                   SELECT time_captured.primkey as event_perfno_i,
                                 LISTAGG((to_char(FLOOR(time_captured.duration/60)||':'||LPAD(TO_CHAR(MOD(time_captured.duration, 60)), 2, 0))) ,', '||chr(10))
                                 WITHIN GROUP (ORDER BY (to_char(FLOOR(time_captured.duration/60)||':'||LPAD(TO_CHAR(MOD(time_captured.duration, 60)), 2, 0)))) as duration 
                   FROM time_captured
                   JOIN wp_assignment ON time_captured.primkey = wp_assignment.event_perfno_i AND time_captured.mime_type IN ('WO', 'MET') AND wp_assignment.wpno_i =  @VAR.WP@
                   GROUP BY time_captured.primkey
                  ) time_cap ON time_cap.event_perfno_i=wp_assignment.event_perfno_i

LEFT JOIN sign closing_sign ON closing_sign.user_sign = wo_header.mech_sign 
LEFT JOIN rm_property_value closing_lastname_ru ON closing_lastname_ru.owner_amos_key = closing_sign.employee_no_i AND closing_lastname_ru.property_type_no_i = 42 
LEFT JOIN rm_property_value closing_firstname_ru ON closing_firstname_ru.owner_amos_key = closing_sign.employee_no_i AND closing_firstname_ru.property_type_no_i = 40  
LEFT JOIN sign signoff_sign ON signoff_sign.user_sign = wta.sign_off 
LEFT JOIN rm_property_value signoff_lastname_ru ON signoff_lastname_ru.owner_amos_key = signoff_sign.employee_no_i AND signoff_lastname_ru.property_type_no_i = 42 
LEFT JOIN rm_property_value signoff_firstname_ru ON signoff_firstname_ru.owner_amos_key = signoff_sign.employee_no_i AND signoff_firstname_ru.property_type_no_i = 40  
LEFT JOIN (
                    SELECT SUM(time_captured.duration*time_captured.prod_factor) as mhrs,
                                   time_captured.primkey as wonum
	     FROM time_captured
                    WHERE time_captured.mime_type = 'WO'
                    GROUP BY time_captured.primkey
                   ) timec ON  timec.wonum = wo_header.event_perfno_i  
LEFT JOIN (
                    SELECT SUM(rm_resource_requirement.total_hours) as plan,
                                   workstep_link.event_perfno_i as perfno_i  
                    FROM rm_resource_requirement
                    LEFT JOIN rm_resource_request ON rm_resource_request.resource_request_noi = rm_resource_requirement.resource_request_noi
                    LEFT JOIN workstep_link ON workstep_link.descno_i = rm_resource_request.request_owner_amos_key
                    GROUP BY workstep_link.event_perfno_i
                   ) plan_time ON plan_time.perfno_i = wo_header.event_perfno_i  
LEFT JOIN (
                    SELECT DECODE(wo_event_link.event_display,null,wo_text_description.header || ' ' || dbms_lob.substr(wo_text_description.text,200,1),wo_event_link.event_display) as ev,
                                   wo_header.event_perfno_i as no_i
                    FROM wo_header                                                       
                    LEFT JOIN wo_event_link ON wo_header.event_perfno_i = wo_event_link.event_perfno_i     
                    LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wo_header.event_perfno_i  
                    LEFT JOIN wo_text_description ON wo_text_description.descno_i = workstep_link.descno_i                          
                    WHERE workstep_link.sequenceno = 1    
                   ) wel_event ON wel_event.no_i = wp_assignment.event_perfno_i
WHERE
wp_header.wpno_i = @VAR.WP@
ORDER BY wp_sequence.seqno_i ASC
/*skorolev_sql1*/</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WP_SPTO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpno" id="wpno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select wpno from wp_header where wpno_i = @VAR.WP@</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="PANELS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;FLOOR (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours)/60) ||':'|| MOD (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours)60) as panel_total" id="panel_total"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;FLOOR (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours)/60) ||''|| MOD (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours)60)*100/60 as panel_total_d" id="panel_total_d"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 

FLOOR (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours)/60) ||':'|| MOD (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours), 60) as panel_total,
FLOOR (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours)/60) ||','|| FLOOR (MOD (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours), 60)*100/60) as panel_total_d

FROM
wp_header
LEFT JOIN wp_panel ON wp_header.wpno_i=wp_panel.wpno_i
LEFT JOIN msc_panel_type ON wp_panel.panelno_i=msc_panel_type.panelno_i
LEFT JOIN rm_resource_request reqst_opening ON msc_panel_type.descno_i_opening=reqst_opening.request_owner_amos_key AND reqst_opening.request_owner_amos_type='WS'
LEFT JOIN rm_resource_request reqst_closing ON msc_panel_type.descno_i_closing=reqst_closing.request_owner_amos_key AND reqst_closing.request_owner_amos_type='WS'
LEFT JOIN rm_resource_requirement reqmnt_opening ON reqmnt_opening.resource_request_noi=reqst_opening.resource_request_noi
LEFT JOIN rm_resource_requirement reqmnt_closing ON reqmnt_closing.resource_request_noi=reqst_closing.resource_request_noi
WHERE 
wp_header.wpno_i = @VAR.WP@</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="TOTAL" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="total_planned_hm as total_planned_hm" id="total_planned_hm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;FLOOR (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours + plan_time.plan)/60) ||''|| MOD (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours + plan_time.plan)60)*100/60 as total_planned_h" id="total_planned_h"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;FLOOR (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours + timec.mhrs)/60) ||':'|| MOD (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours + timec.mhrs)60) as total_booked_hm" id="total_booked_hm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;FLOOR (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours + timec.mhrs + plan_time.plan)/60) ||''|| MOD (SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours + timec.mhrs + plan_time.plan)60)*100/60 as total_booked_h" id="total_booked_h"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WP@">
          <ds:object>@VAR.WP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
total_planned_hm as total_planned_hm,
total_planned_h as total_planned_h,
total_booked_hm as total_booked_hm,
total_booked_h as total_booked_h
FROM

(SELECT

TO_CHAR(FLOOR (SUM (total.planned)/60)) ||':'||CASE WHEN (TO_CHAR( MOD (SUM (total.planned), 60)))&lt;10 THEN '0'||(TO_CHAR( MOD (SUM (total.planned), 60))) ELSE (TO_CHAR( MOD (SUM (total.planned), 60))) END as total_planned_hm,
TO_CHAR(FLOOR (SUM (total.planned)/60)) ||','||TO_CHAR( FLOOR (MOD (SUM (total.planned), 60)*100/60)) as total_planned_h,

TO_CHAR(FLOOR (SUM (total.booked)/60)) ||':'||CASE WHEN (TO_CHAR( MOD (SUM (total.booked), 60)))&lt;10 THEN '0'||(TO_CHAR( MOD (SUM (total.booked), 60))) ELSE (TO_CHAR( MOD (SUM (total.booked), 60))) END as total_booked_hm,
TO_CHAR(FLOOR (SUM (total.booked)/60)) ||','||TO_CHAR( FLOOR (MOD (SUM (total.booked), 60)*100/60)) as total_booked_h

FROM(

		SELECT 
		SUM (plan_time.plan) as planned,
		SUM (timec.mhrs) as booked
		FROM
		wp_header
		LEFT JOIN wp_assignment ON wp_header.wpno_i = wp_assignment.wpno_i     
		LEFT JOIN wo_header ON  wo_header.event_perfno_i = wp_assignment.event_perfno_i      
		LEFT JOIN (
					SELECT
					TO_NUMBER (FLOOR (SUM(time_captured.duration*time_captured.prod_factor))) as mhrs,
					time_captured.primkey as wonum
					FROM
					time_captured
					WHERE
					time_captured.mime_type IN  ('WO', 'MET')
					GROUP BY time_captured.primkey
		) timec ON  timec.wonum = wo_header.event_perfno_i  
		LEFT JOIN(
					SELECT
					SUM(rm_resource_requirement.total_hours) as plan,
					workstep_link.event_perfno_i as perfno_i  
					FROM rm_resource_requirement
					LEFT JOIN rm_resource_request ON rm_resource_request.resource_request_noi = rm_resource_requirement.resource_request_noi
					LEFT JOIN workstep_link ON workstep_link.descno_i = rm_resource_request.request_owner_amos_key
					GROUP BY workstep_link.event_perfno_i
				 ) plan_time ON plan_time.perfno_i = wo_header.event_perfno_i  
		WHERE
		wp_header.wpno_i = @VAR.WP@

		UNION

		SELECT 
		SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours) as planned,
		SUM (reqmnt_opening.total_hours + reqmnt_closing.total_hours) as booked
		FROM
		wp_header
		LEFT JOIN wp_panel ON wp_header.wpno_i=wp_panel.wpno_i
		LEFT JOIN msc_panel_type ON wp_panel.panelno_i=msc_panel_type.panelno_i
		LEFT JOIN rm_resource_request reqst_opening ON msc_panel_type.descno_i_opening=reqst_opening.request_owner_amos_key AND reqst_opening.request_owner_amos_type='WS'
		LEFT JOIN rm_resource_request reqst_closing ON msc_panel_type.descno_i_closing=reqst_closing.request_owner_amos_key AND reqst_closing.request_owner_amos_type='WS'
		LEFT JOIN rm_resource_requirement reqmnt_opening ON reqmnt_opening.resource_request_noi=reqst_opening.resource_request_noi
		LEFT JOIN rm_resource_requirement reqmnt_closing ON reqmnt_closing.resource_request_noi=reqst_closing.resource_request_noi
		WHERE 
		wp_header.wpno_i = @VAR.WP@
		) total)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
