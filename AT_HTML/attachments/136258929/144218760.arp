        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + od_detail.target_date'DD.MM.YYYY') as target_date" id="target_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.priority" id="od_detail.priority"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + sh_in.awbdate'DD.MM.YYYY') as awb_in" id="awb_in"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + sh_out.awbdate'DD.MM.YYYY') as awb_out" id="awb_out"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(sh_in.awbdate - sh_out.awbdate) as delta_awb" id="delta_awb"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + sh_in.flight_date'DD.MM.YYYY') as flight_in_date" id="flight_in_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + sh_out.flight_date'DD.MM.YYYY') as flight_out_date" id="flight_out_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(sh_in.flight_date - sh_out.flight_date) as delta_flight" id="delta_flight"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v1_project@">
          <ds:object>@VAR.v1_project@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
    od_header.orderno,
    od_header.ext_state,
    od_header.ext_orderno,
    od_detail.posno,
    od_detail.ext_state,
    od_header.orderdate,
    od_header.vendor,
    address.name,
    od_detail.partno,
    od_detail.serialno,
    od_detail.labelno,
    part.description,
    od_detail.qty,
    od_detail.backorder,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + od_detail.target_date, 'DD.MM.YYYY') as target_date,
    od_detail.priority,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + sh_in.awbdate, 'DD.MM.YYYY') as awb_in,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + sh_out.awbdate, 'DD.MM.YYYY') as awb_out,
    (sh_in.awbdate - sh_out.awbdate) as delta_awb,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + sh_in.flight_date, 'DD.MM.YYYY') as flight_in_date,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + sh_out.flight_date, 'DD.MM.YYYY') as flight_out_date,
    (sh_in.flight_date - sh_out.flight_date) as delta_flight
FROM od_header
    JOIN od_detail ON od_header.orderno_i = od_detail.orderno_i
    JOIN part ON od_detail.partno = part.partno
    JOIN address ON od_header.vendor=address.vendor
    LEFT JOIN od_header_quotation ON od_header.orderno_i = od_header_quotation.orderno_i
    LEFT JOIN address ON od_header_quotation.address_i = address.address_i
    LEFT JOIN (
        SELECT sh_detail.od_detailno_i,
               sh_header.awbdate,
               sh_header.flight_date
        FROM sh_header
        LEFT JOIN sh_detail on sh_header.shipmentno_i=sh_detail.shipmentno_i
        WHERE sh_header.type='EI'
        ) sh_in ON od_detail.detailno_i = sh_in.od_detailno_i
    LEFT JOIN (
        SELECT sh_detail.od_detailno_i,
               sh_header.awbdate,
               sh_header.flight_date
        FROM sh_header
        LEFT JOIN sh_detail on sh_header.shipmentno_i=sh_detail.shipmentno_i
        WHERE sh_header.type='EO'
        ) sh_out ON od_detail.detailno_i = sh_out.od_detailno_i
where od_detail.projectno ='@VAR.v1_project@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
