    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="262_OMTO_Part_Consumption" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tool" id="tool"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="altpartno" id="altpartno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mpno_list" id="mpno_list"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(consumpted_2021) as consumpted_2021" id="consumpted_2021"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(consumpted_2021_svo) as consumpted_2021_svo" id="consumpted_2021_svo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(consumpted_2021_out) as consumpted_2021_out" id="consumpted_2021_out"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(stock) as stock" id="stock"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(stock_incl_alt) stock_incl_alt" id="stock_incl_alt"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(stock_svo) as stock_svo" id="stock_svo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(stock_svo_incl_alt) as stock_svo_incl_alt" id="stock_svo_incl_alt"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(stock_out) as stock_out" id="stock_out"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(stock_out_incl_alt) as stock_out_incl_alt" id="stock_out_incl_alt"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
    partno, 
    description, 
    mat_class, 
    tool, 
    altpartno, 
    mpno_list, 
    TO_NUMBER(consumpted_2021) as consumpted_2021, 
    TO_NUMBER(consumpted_2021_svo) as consumpted_2021_svo, 
    TO_NUMBER(consumpted_2021_out) as consumpted_2021_out, 
    TO_NUMBER(stock) as stock, 
    TO_NUMBER(stock_incl_alt) stock_incl_alt, 
    TO_NUMBER(stock_svo) as stock_svo, 
    TO_NUMBER(stock_svo_incl_alt) as stock_svo_incl_alt, 
    TO_NUMBER(stock_out) as stock_out, 
    TO_NUMBER(stock_out_incl_alt) as stock_out_incl_alt 
FROM AMOSSERVER_PROD.R262_MP_PARTS 
order by 1</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
