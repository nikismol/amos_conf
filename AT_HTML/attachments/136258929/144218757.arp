  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Sum_Qty_Stok" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN REGEXP_LIKE(pr.partno'^[0-9]+$') THEN chr(39)||pr.partno ELSE pr.partno END as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pr.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;DECODE (pr.mat_class 'C' 'Consumable'&#10;&#9;&#9;&#9;&#9;'E' 'Expendable'&#10;&#9;&#9;&#9;&#9;'R' 'Rotable'&#10;&#9;&#9;&#9;&#9;'S''Service') as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="alt_parts.altpartno as altpartno" id="altpartno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="stock.part_qty" id="stock.part_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="stock.alt_qty" id="stock.alt_qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	stock.partno as partno,
	stock.description as description,
	stock.mat_class as mat_class,
	stock.altpartno as altpartno,
	stock.part_qty,
	stock.alt_qty
FROM 
	(
	SELECT distinct 
        		CASE WHEN REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
        		part.description as description,
        		DECODE (part.mat_class, 'C', 'Consumable',
                                				'E', 'Expendable',
                                				'R', 'Rotable',
                                				'S', 'Service'
               		          ) as mat_class,
        		CASE WHEN REGEXP_LIKE(alt_parts_cons.altpartno, '^[0-9]+$') THEN chr(39)||alt_parts_cons.altpartno ELSE alt_parts_cons.altpartno END as  altpartno, 
        		cons_stock_qty.part_qty as part_qty,
        		alt_parts_cons.alt_qty as  alt_qty
	FROM part 
		LEFT JOIN (
    			     SELECT
			         	part.partno,
			         	part_alternate.altpartno,
			         	SUM(consumables.qty) AS alt_qty
			         FROM part
			         	JOIN part_alternate ON part_alternate.partno = part.partno
			         	LEFT JOIN consumables ON part_alternate.altpartno = consumables.partno
			         	LEFT JOIN location ON consumables.locationno_i = location.locationno_i 
			         WHERE 1=1
			         	AND consumables.owner = 'AFL'
			         	AND location.station in ('SVO', 'SHRM')
			         	AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE')
			         	AND consumables.condition &lt;&gt; 'US'
			         GROUP BY part.partno, part_alternate.altpartno              
			     ) alt_parts_cons ON part.partno = alt_parts_cons.partno
		LEFT JOIN (
			         SELECT
			        	 part.partno,
			         	SUM(consumables.qty) AS part_qty 
			         FROM part
			         	JOIN consumables on part.partno = consumables.partno
			         	JOIN location ON consumables.locationno_i = location.locationno_i 
			         WHERE 1=1 
			         	AND consumables.owner = 'AFL'
			         	AND location.station in ('SVO', 'SHRM')
			         	AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE')
			         	AND consumables.condition &lt;&gt; 'US'
			         GROUP BY part.partno
			     ) cons_stock_qty ON part.partno = cons_stock_qty.partno
WHERE part.mat_class &lt;&gt;  'R'
UNION
SELECT distinct 
		CASE WHEN REGEXP_LIKE(part.partno, '^[0-9]+$') THEN chr(39)||part.partno ELSE part.partno END as partno,
		part.description as description,
		DECODE (part.mat_class, 'C', 'Consumable',
                                			'E', 'Expendable',
                               			 'R', 'Rotable',
                                			'S', 'Service'
                		) as mat_class,
		alt_parts_rot.altpartno as altpartno,
		rot_stock_qty.part_qty,
		alt_parts_rot.alt_qty
FROM part 
	LEFT JOIN (
		        SELECT
		        	part.partno,
		        	part_alternate.altpartno,
		        	count(rotables.psn) AS alt_qty
		        FROM part
		        	LEFT JOIN part_alternate ON part.partno = part_alternate.partno
			        LEFT JOIN rotables on part_alternate.altpartno = rotables.partno
			        LEFT JOIN location ON rotables.locationno_i = location.locationno_i 
		        WHERE 1=1
			        AND rotables.owner = 'AFL'
			        AND rotables.condition &lt;&gt; 'US'
			        AND location.station in ('SVO', 'SHRM')
			        AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE')
			        GROUP BY part.partno,
			        	      part_alternate.altpartno        
		        ) alt_parts_rot ON part.partno = alt_parts_rot.partno
	LEFT JOIN (
		        SELECT
		        	part.partno,
		        	count(rotables.psn) AS part_qty 
		        FROM part
		        	LEFT JOIN rotables on part.partno = rotables.partno
			        LEFT JOIN location ON rotables.locationno_i = location.locationno_i 
		        WHERE 1=1 
		       	 AND location.station in ('SVO', 'SHRM')
		        	AND location.store IN ('BASE','1010','CABIN','1221','SSJ','1220','LINE','FLUIDS','123A','ACC','1222','TOOLS','WHEELS','1011','PRODUCE')
		        	AND rotables.condition &lt;&gt; 'US'
		        	AND rotables.owner = 'AFL'
		       GROUP BY part.partno
		) rot_stock_qty ON part.partno = rot_stock_qty.partno
WHERE part.mat_class not in ( 'C', 'E', 'S')
) stock</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
