          </view>
          <view class="LabelReportView" id="192" usage="cell">
            <attribute name="position">0 0</attribute>
            <attribute name="size">80 16</attribute>
            <attribute name="visible">YES</attribute>
            <attribute name="auto-resize">YES</attribute>
            <attribute name="rotation">0.0</attribute>
            <conditional_attributes/>
            <attribute name="color">000000</attribute>
            <attribute name="margin">0 0 0 0</attribute>
            <attribute name="padding">2 0 0 0</attribute>
            <attribute name="border">1 SOLID 000000</attribute>
            <attribute name="text">@AFL_SM_MAIN.first_vm_description@</attribute>
            <attribute name="text-decoration">NONE</attribute>
            <attribute name="font">SansSerif PLAIN 10</attribute>
            <attribute name="text-align">LEFT</attribute>
            <attribute name="line-break">AS_IS</attribute>
            <attribute name="splitable">NO</attribute>
            <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
            <attribute name="antialias">false</attribute>
          </view>
        </column>
      </column_model>
      <attribute name="data-source">AFL_SM_MAIN</attribute>
    </view>
  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="v02_date_end"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="v01_date_start"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="02. Period to (for vm AA, AS)" id="v02_date_end">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="01. Period from (for vm AA, AS)" id="v01_date_start">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_SM_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.station" id="s.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.store" id="s.store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;         CASE WHEN REGEXP_LIKE(s.partno'^[0-9]+$') AND s.partno LIKE ('0%') THEN chr(39)||s.partno ELSE s.partno END as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.description" id="s.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.sum_qty" id="s.sum_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.mat_class" id="s.mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.measure_unit" id="s.measure_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="s.is_tool" id="s.is_tool"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="  &#10;        CASE WHEN h.del_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (h.del_date + 729)'DD.MM.YYYY') ELSE '' END as last_transaction_date" id="last_transaction_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_min.del_date as first_transaction_date" id="first_transaction_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_min.vm as first_transaction_vm" id="first_transaction_vm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="h_min.vm_description as first_vm_description" id="first_vm_description"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_date_start@">
          <ds:object>@VAR.v01_date_start@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_date_end@">
          <ds:object>@VAR.v02_date_end@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
         s.station,
         s.store,
         CASE WHEN REGEXP_LIKE(s.partno, '^[0-9]+$') AND s.partno LIKE ('0%') THEN chr(39)||s.partno ELSE s.partno END as partno,
         s.description,
         s.sum_qty,
         s.mat_class,
         s.measure_unit,
         s.is_tool,  
        CASE WHEN h.del_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (h.del_date + 729), 'DD.MM.YYYY') ELSE '' END as last_transaction_date,
        CASE WHEN h_min.del_date&gt;0 THEN TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (h_min.del_date + 729), 'DD.MM.YYYY') ELSE '' END as first_transaction_date,
        h_min.vm as first_transaction_vm,
        h_min.vm_description as first_vm_description
FROM (
             SELECT
                       location.station,
                       location.store,
                       part.partno,
                       part.description,
                       SUM (consumables.qty) as sum_qty,
                       part.mat_class,
                       measure_unit.description as measure_unit,
                       DECODE (part.tool, 'Y', 'Y', '') as is_tool
             FROM 
                       part
             JOIN consumables ON part.partno = consumables.partno
             JOIN location ON consumables.locationno_i = location.locationno_i
             LEFT JOIN measure_unit ON part.measure_unit=measure_unit.measure_unit
             LEFT JOIN address ON address.vendor=consumables.owner
             WHERE 
                       1=1                       
                       AND location.station = 'SVO'
                       AND consumables.qty &gt; 0
                       AND part.mat_class&lt;&gt;'R'
             GROUP BY part.partno, location.station, location.store, part.description, part.mat_class, measure_unit.description, part.tool
            ) s
LEFT JOIN ( 
                   SELECT history.partno,
                                MAX(history.del_date) as del_date,
                                history.store
                   FROM history
                   LEFT JOIN voucher_mode ON history.vm=voucher_mode.vm
                   WHERE 1=1
                                 AND history.del_date &gt;= '@VAR.v01_date_start@' AND history.del_date &lt;= '@VAR.v02_date_end@'
                                 AND history.status&lt;&gt;9
                                 AND history.station='SVO'
                                 AND history.vm IN (
                                                                   'AS', /* STORE TO SHOP */
                                                                   'AA' /* STORE TO A/C */
                                                                 )
                   GROUP BY history.partno, history.store
                   ) h ON s.partno=h.partno AND h.store=s.store
LEFT JOIN ( 
                   SELECT history.partno,
                                history.del_date,
                                history.historyno_i,
                                MIN(history.historyno_i) OVER (PARTITION BY history.store, history.partno) as min_historyno_i,
                                history.store,
                                history.vm,
                                voucher_mode.description as vm_description
                   FROM history
                   LEFT JOIN voucher_mode ON history.vm=voucher_mode.vm
                   WHERE 1=1
                            /*     AND history.del_date &gt;= '@VAR.v01_date_start@' AND history.del_date &lt;= '@VAR.v02_date_end@' */
                                 AND history.status&lt;&gt;9
                                 AND history.station='SVO'
                   ) h_min ON s.partno=h_min.partno AND h_min.store=s.store AND h_min.min_historyno_i=h_min.historyno_i
WHERE h.del_date &gt;= '@VAR.v01_date_start@' AND h.del_date &lt;= '@VAR.v02_date_end@'
              OR h.del_date is NULL
ORDER BY  2, 3, h.del_date</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
