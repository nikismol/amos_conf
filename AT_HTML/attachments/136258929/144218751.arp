  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="INT" description="" id="v03_year_start"/>
        <ds:columnDescriptor amosType="DESC_TXT" description="" id="v07_partno_list"/>
        <ds:columnDescriptor amosType="UPPERCAS" description="" id="v09_owner"/>
        <ds:columnDescriptor amosType="UPPERCAS" description="" id="v02_station"/>
        <ds:columnDescriptor amosType="VD" description="" id="v04_vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="v06_active_reordering_only"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="v08_matclass"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="v05_include_alternates"/>
        <ds:columnDescriptor amosType="PA" description="" id="v01_partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="03. Year From" id="v03_year_start">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>2018</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="07. Partno List (copy from EXCEL - max200)" id="v07_partno_list">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="09. Stock owned by:" id="v09_owner">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>AFL, ZHB_RR</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="02. Station" id="v02_station">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>SVO, SHRM</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="04. Vendor (for Orders)" id="v04_vendor">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="06. Show Partno With &quot;reordering&quot; ONLY" id="v06_active_reordering_only">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>Y&amp;=&amp;Yes;N&amp;=&amp;No;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>Y</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="08. Material class" id="v08_matclass">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>C&amp;=&amp;Consumable;E&amp;=&amp;Expendable;CE&amp;=&amp;Consumable &amp; Expendable;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>CE</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="05. Include Alternates" id="v05_include_alternates">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>Y&amp;=&amp;Yes;N&amp;=&amp;No;</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data>Y</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="01. Partno" id="v01_partno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_MAIN" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rownum" id="rownum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.max_purch as max_purch" id="max_purch"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.reord_level as reorder_level" id="reorder_level"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.alert_qty as alert_qty" id="alert_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ata_chapter as ata_chapter" id="ata_chapter"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_partno@">
          <ds:object>@VAR.v01_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v06_active_reordering_only@">
          <ds:object>@VAR.v06_active_reordering_only@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v08_matclass@">
          <ds:object>@VAR.v08_matclass@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v07_partno_list@">
          <ds:object>@VAR.v07_partno_list@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT rownum,
       part.partno as partno,
       part.description as description,
       part.ac_typ as ac_typ,
       part.max_purch as max_purch,
       part.reord_level as reorder_level,
       part.alert_qty as alert_qty,
       part.ata_chapter as ata_chapter
FROM part
WHERE 1=1
      AND (
                 part.partno IN (
                                              SELECT t.v
                                              FROM (
                                                           SELECT column_value as v
                                                           FROM TABLE(amosserver_prod.string_splitter('@VAR.v01_partno@','comma'))
                                                          ) t
                                              WHERE t.v is not null
                                             )
                 OR '@VAR.v01_partno@' IS NULL
                )
      AND part.mat_class&lt;&gt;'R'
      AND (part.reorder IN ('H', 'F') OR '@VAR.v06_active_reordering_only@' = 'N')
      AND (part.mat_class = '@VAR.v08_matclass@' OR '@VAR.v08_matclass@' = 'CE' AND part.mat_class &lt;&gt; 'R')
      AND (
                 part.partno IN (
                                              SELECT t.v
                                              FROM (
                                                           SELECT column_value as v
                                                           FROM TABLE(amosserver_prod.string_splitter('@VAR.v07_partno_list@','line_feed'))
                                                          ) t
                                              WHERE t.v is not null
                                             )
                 OR '@VAR.v07_partno_list@' IS NULL
                )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_Stock" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(consumables.qty) as qty" id="qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v02_station@">
          <ds:object>@VAR.v02_station@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v09_owner@">
          <ds:object>@VAR.v09_owner@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_MAIN.partno@">
          <ds:object>@251_Parts_Reordering_MAIN.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_include_alternates@">
          <ds:object>@v05_include_alternates@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT SUM(qty) as qty
FROM (
              SELECT consumables.qty
              FROM consumables
              JOIN location ON consumables.locationno_i = location.locationno_i 
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v02_station@', ', ', '|')) OR '@VAR.v02_station@' IS NULL)
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             AND (ASCII(consumables.owner) = 49824 OR consumables.owner IN (' ') OR consumables.owner IS NULL OR REGEXP_LIKE(consumables.owner, REPLACE('@VAR.v09_owner@', ', ', '|')) OR '@VAR.v09_owner@' IS NULL)
                             AND consumables.partno = '@251_Parts_Reordering_MAIN.partno@'
              
              UNION ALL
              
              SELECT consumables.qty
              FROM part_alternate
              JOIN consumables ON consumables.partno = part_alternate.altpartno
              JOIN location ON consumables.locationno_i = location.locationno_i 
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND (REGEXP_LIKE(location.station, REPLACE('@VAR.v02_station@', ', ', '|')) OR '@VAR.v02_station@' IS NULL)
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             AND (ASCII(consumables.owner) = 49824 OR consumables.owner IN (' ') OR consumables.owner IS NULL OR REGEXP_LIKE(consumables.owner, REPLACE('@VAR.v09_owner@', ', ', '|')) OR '@VAR.v09_owner@' IS NULL)
                             AND part_alternate.type IN ('A', 'R', 'S')  
                             AND part_alternate.partno = '@251_Parts_Reordering_MAIN.partno@'
                             AND '@v05_include_alternates@'= 'Y'
             )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_PERIOD_YEARS" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="2018 - 1 + LEVEL as yr" id="yr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_year_start@">
          <ds:object>@VAR.v03_year_start@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT @VAR.v03_year_start@ - 1 + LEVEL as yr
FROM DUAL
CONNECT BY LEVEL - 1 &lt;= to_char(sysdate, 'YYYY') - @VAR.v03_year_start@
/* все года, начиная с 2018 */</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_RECEIVING" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(od_rec_detail.qty) as rec_qty" id="rec_qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_vendor@">
          <ds:object>@VAR.v04_vendor@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_MAIN.partno@">
          <ds:object>@251_Parts_Reordering_MAIN.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_PERIOD_YEARS.yr@">
          <ds:object>@251_Parts_Reordering_PERIOD_YEARS.yr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_include_alternates@">
          <ds:object>@v05_include_alternates@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT NVL(SUM(qty), 0) as rec_qty
FROM (
              SELECT od_rec_detail.qty
              FROM od_rec_detail
              JOIN od_rec_header ON od_rec_detail.receivingno = od_rec_header.receivingno
              JOIN od_header ON od_rec_detail.orderno = od_header.orderno
              WHERE 1=1
                             AND (od_header.vendor = '@VAR.v04_vendor@' OR '@VAR.v04_vendor@' is NULL)
                             AND od_rec_detail.partno = '@251_Parts_Reordering_MAIN.partno@'
                             AND od_header.order_type = 'P'
                             AND od_rec_detail.status &lt;&gt; 9
                             AND od_rec_detail.recno &lt;&gt; -1
                             AND TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + od_rec_header.del_date, 'YYYY') = '@251_Parts_Reordering_PERIOD_YEARS.yr@'
              
              UNION ALL
              
              SELECT od_rec_detail.qty
              FROM part_alternate
              JOIN od_rec_detail ON od_rec_detail.partno = part_alternate.altpartno
              JOIN od_rec_header ON od_rec_detail.receivingno = od_rec_header.receivingno
              JOIN od_header ON od_rec_detail.orderno = od_header.orderno
              WHERE 1=1
                             AND (od_header.vendor = '@VAR.v04_vendor@' OR '@VAR.v04_vendor@' is NULL)
                             AND od_header.order_type = 'P'
                             AND od_rec_detail.status &lt;&gt; 9
                             AND od_rec_detail.recno &lt;&gt; -1
                             AND TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + od_rec_header.del_date, 'YYYY') = '@251_Parts_Reordering_PERIOD_YEARS.yr@'
                             AND part_alternate.type IN ('A', 'R', 'S')  
                             AND part_alternate.partno = '@251_Parts_Reordering_MAIN.partno@'
                             AND '@v05_include_alternates@'= 'Y'
             )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_CONSUMPTION" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="(SUM(history.qty)) * (-1) as qty" id="qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_MAIN.partno@">
          <ds:object>@251_Parts_Reordering_MAIN.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_PERIOD_YEARS.yr@">
          <ds:object>@251_Parts_Reordering_PERIOD_YEARS.yr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_include_alternates@">
          <ds:object>@v05_include_alternates@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT NVL((SUM(qty)) * (-1), 0) as qty
FROM (
              SELECT history.qty
              FROM history
              WHERE 1=1
                             AND history.vm in ('AA', 'AS', 'EA', 'ES')
                             AND history.partno='@251_Parts_Reordering_MAIN.partno@'
                             AND TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + history.created_date, 'YYYY') = '@251_Parts_Reordering_PERIOD_YEARS.yr@'
              
              UNION ALL
              
              SELECT history.qty
              FROM part_alternate
              JOIN history ON history.partno = part_alternate.altpartno
              WHERE 1=1
                             AND history.vm in ('AA', 'AS', 'EA', 'ES')
                             AND TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + history.created_date, 'YYYY') = '@251_Parts_Reordering_PERIOD_YEARS.yr@'            
                             AND part_alternate.type IN ('A', 'R', 'S')  
                             AND part_alternate.partno = '@251_Parts_Reordering_MAIN.partno@'
                             AND '@v05_include_alternates@'= 'Y'
            ) </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_PART_SPECIAL" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="LISTAGG(part_special.special '') WITHIN GROUP (ORDER BY  part_special.special) as special" id="special"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_MAIN.partno@">
          <ds:object>@251_Parts_Reordering_MAIN.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT LISTAGG(part_special.special, ', ') WITHIN GROUP (ORDER BY  part_special.special) as special
FROM part_special
WHERE part_special.partno = '@251_Parts_Reordering_MAIN.partno@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_ORDERED_QTY" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="COUNT(od_detail.backorder) as qty_left" id="qty_left"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_MAIN.partno@">
          <ds:object>@251_Parts_Reordering_MAIN.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_include_alternates@">
          <ds:object>@v05_include_alternates@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT SUM(backorder) as qty_left
FROM (
              SELECT od_detail.backorder
              FROM od_header
              JOIN od_detail ON od_detail.orderno_i = od_header.orderno_i
              WHERE 1=1
                              AND od_header.order_type = 'P'
                              AND od_detail.ext_state IN ('O', 'PR')
                              AND od_detail.backorder &gt; 0
                              AND od_detail.partno = '@251_Parts_Reordering_MAIN.partno@'
              
              UNION ALL
              
              SELECT od_detail.backorder
              FROM part_alternate
              JOIN od_detail ON od_detail.partno = part_alternate.altpartno
              JOIN od_header ON od_detail.orderno_i = od_header.orderno_i
              WHERE 1=1
                              AND od_header.order_type = 'P'
                              AND od_detail.ext_state IN ('O', 'PR')
                              AND od_detail.backorder &gt; 0
                             AND part_alternate.type IN ('A', 'R', 'S')  
                             AND part_alternate.partno = '@251_Parts_Reordering_MAIN.partno@'
                             AND '@v05_include_alternates@'= 'Y'
             )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_VENDOR_DECODER" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="DECODE(&#10;                                '@VAR.v04_vendor@'&#10;                                '' 'ALL'(SELECT address.name FROM address WHERE address.vendor = '@VAR.v04_vendor@')&#10;                               ) as vendor" id="vendor"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_vendor@">
          <ds:object>@VAR.v04_vendor@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT DECODE(
                                '@VAR.v04_vendor@',
                                '', 'ALL',
                                (SELECT address.name FROM address WHERE address.vendor = '@VAR.v04_vendor@')
                               ) as vendor
FROM DUAL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_StockAllStation" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(qty) as qty" id="qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v09_owner@">
          <ds:object>@VAR.v09_owner@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_MAIN.partno@">
          <ds:object>@251_Parts_Reordering_MAIN.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_include_alternates@">
          <ds:object>@v05_include_alternates@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT SUM(qty) as qty
FROM (
              SELECT consumables.qty
              FROM consumables
              JOIN location ON consumables.locationno_i = location.locationno_i 
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             AND (ASCII(consumables.owner)= 49824 OR consumables.owner IN (' ') OR consumables.owner IS NULL OR REGEXP_LIKE(consumables.owner, REPLACE('@VAR.v09_owner@', ', ', '|')) OR '@VAR.v09_owner@' IS NULL)
                             AND consumables.partno = '@251_Parts_Reordering_MAIN.partno@'
              
              UNION ALL
              
              SELECT consumables.qty
              FROM part_alternate
              JOIN consumables ON consumables.partno = part_alternate.altpartno
              JOIN location ON consumables.locationno_i = location.locationno_i 
              LEFT JOIN condition ON consumables.condition = condition.condition
              WHERE 1=1
                             AND location.location_type &lt;&gt; -200
                             AND consumables.qty &gt; 0
                             AND COALESCE (consumables.condition, ' ') &lt;&gt; 'US'
                             AND (ASCII(consumables.owner)= 49824 OR consumables.owner IN (' ') OR consumables.owner IS NULL OR REGEXP_LIKE(consumables.owner, REPLACE('@VAR.v09_owner@', ', ', '|')) OR '@VAR.v09_owner@' IS NULL)
                             AND part_alternate.type IN ('A', 'R', 'S')  
                             AND part_alternate.partno = '@251_Parts_Reordering_MAIN.partno@'
                             AND '@v05_include_alternates@'= 'Y'
             )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_AltOptions" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="max_purch" id="max_purch"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="reorder_level" id="reorder_level"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="alert_qty" id="alert_qty"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_MAIN.partno@">
          <ds:object>@251_Parts_Reordering_MAIN.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_include_alternates@">
          <ds:object>@v05_include_alternates@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT max_purch,
              reorder_level,
              alert_qty
FROM (
             SELECT part.max_purch as max_purch,
                           part.reord_level as reorder_level,
                           part.alert_qty as alert_qty,
                           row_number() over(partition BY part_alternate.partno  ORDER BY part.reord_level DESC) as num,
                           part.partno,
                           part_alternate.partno as main_partno
             FROM part_alternate
             JOIN part ON part_alternate.altpartno = part.partno
             WHERE 1=1
                            AND part_alternate.partno = '@251_Parts_Reordering_MAIN.partno@'
                            AND '@v05_include_alternates@'= 'Y'
                            AND part_alternate.type IN ('A', 'R', 'S')
            )
WHERE num = 1</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_CONSUMPTION_vm" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="LISTAGG(vm'/') WITHIN GROUP (ORDER BY vm) as vm" id="vm"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_MAIN.partno@">
          <ds:object>@251_Parts_Reordering_MAIN.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_PERIOD_YEARS.yr@">
          <ds:object>@251_Parts_Reordering_PERIOD_YEARS.yr@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@v05_include_alternates@">
          <ds:object>@v05_include_alternates@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT LISTAGG(vm, '/') WITHIN GROUP (ORDER BY vm) as vm
FROM ( 
              SELECT history.vm
              FROM history
              WHERE 1=1
                             AND history.vm in ('AA', 'AS', 'EA', 'ES')
                             AND history.partno='@251_Parts_Reordering_MAIN.partno@'
                             AND TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + history.created_date, 'YYYY') = '@251_Parts_Reordering_PERIOD_YEARS.yr@'
              
              UNION 
              
              SELECT history.vm
              FROM part_alternate
              JOIN history ON history.partno = part_alternate.altpartno
              WHERE 1=1
                             AND history.vm in ('AA', 'AS', 'EA', 'ES')
                             AND TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + history.created_date, 'YYYY') = '@251_Parts_Reordering_PERIOD_YEARS.yr@'            
                             AND part_alternate.type IN ('A', 'R', 'S')  
                             AND part_alternate.partno = '@251_Parts_Reordering_MAIN.partno@'
                             AND '@v05_include_alternates@'= 'Y'
            )</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="251_Parts_Reordering_ORDER_DRAFT" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.backorder AS qty_draft" id="qty_draft"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@251_Parts_Reordering_MAIN.partno@">
          <ds:object>@251_Parts_Reordering_MAIN.partno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT od_detail.qty AS qty_draft
FROM od_header
              JOIN od_detail ON od_detail.orderno_i = od_header.orderno_i
WHERE 1=1
              AND od_header.order_type = 'P'
              AND od_detail.ext_state IN ('D')
              AND od_detail.backorder &gt; 0
              AND od_detail.partno = '@251_Parts_Reordering_MAIN.partno@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
