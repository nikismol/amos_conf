  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="REC" description="" id="v01_recno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="01. Recno" id="v01_recno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="189_SHELVING_TAG" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="batchno" id="batchno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="awbno" id="awbno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_recno@">
          <ds:object>@VAR.v01_recno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
        partno,
         serialno,
         batchno,
         awbno
FROM (
              SELECT
                       DISTINCT od_rec_detail.partno,
                       od_rec_detail.serialno,
                       od_rec_detail.batchno,
                       od_rec_header.awbno,
                       history.transaction_id,
                       MAX(history.transaction_id) OVER (PARTITION BY od_rec_detail.receivingno) as max_transaction_id
              FROM
                       od_rec_detail
              JOIN history ON od_rec_detail.recdetailno_i = history.recdetailno_i
              JOIN od_rec_header ON od_rec_detail.receivingno=od_rec_header.receivingno
              WHERE
                       od_rec_detail.receivingno='@VAR.v01_recno@'
                       AND history.vm='B1'
                       AND od_rec_detail.status&lt;&gt;9
            )
WHERE max_transaction_id=transaction_id</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
