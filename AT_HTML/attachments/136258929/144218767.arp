  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Stock compliance assessment" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.partno" id="sa_search.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;DECODE (part.mat_class 'C' 'Consumable'&#10;                        'E' 'Expendable'&#10;                        'R' 'Rotable'&#10;                        'S''Service') as mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.serialno" id="sa_search.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.condition" id="sa_search.condition"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.ata_chapter" id="sa_search.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.ac_typ" id="sa_search.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ" id="part.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;decode(sa_search.type 'UP' 'Unused Parts' 'OC' 'Overstocked Consumables' 'SR''Slow-moving Rotables') as type" id="type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (sa_search.last_receiving+729)'dd.mm.yyyy') as last_receiving" id="last_receiving"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (sa_search.last_consumption+729)'dd.mm.yyyy') as last_consumption" id="last_consumption"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.consumed_qty" id="sa_search.consumed_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.stock_qty" id="sa_search.stock_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.proposed_qty" id="sa_search.proposed_qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.vendor" id="sa_search.vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.station" id="sa_search.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.store" id="sa_search.store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sa_search.owner" id="sa_search.owner"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.max_purch" id="part.max_purch"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.reord_level" id="part.reord_level"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="total" id="total"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="spec" id="spec"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
sa_search.partno,
part.description,
DECODE (part.mat_class, 'C', 'Consumable',
                        'E', 'Expendable',
                        'R', 'Rotable',
                        'S', 'Service') as mat_class,
sa_search.serialno,
sa_search.condition,
sa_search.ata_chapter,
sa_search.ac_typ,
part.ac_typ,
decode(sa_search.type, 'UP', 'Unused Parts', 'OC', 'Overstocked Consumables', 'SR', 'Slow-moving Rotables') as type,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (sa_search.last_receiving+729), 'dd.mm.yyyy') as last_receiving,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (sa_search.last_consumption+729), 'dd.mm.yyyy') as last_consumption,
sa_search.consumed_qty,
sa_search.stock_qty,
sa_search.proposed_qty,
sa_search.vendor,
sa_search.station,
sa_search.store,
sa_search.owner,
part.max_purch,
part.reord_level,
total,
spec

FROM
        sa_search


LEFT JOIN
        part ON part.partno = sa_search.partno
LEFT JOIN 
        (
        SELECT 
        max(part_forecast.total_requested_qty) as total,
        part_forecast.partno
        FROM part_forecast
        GROUP BY part_forecast.partno
        ) total_req ON total_req.partno = part.partno
LEFT JOIN 
            (
                SELECT
                part_special.partno,
                LISTAGG(part_special.special, ';') WITHIN GROUP (order by part_special.special ASC) as spec
                FROM part_special
                GROUP BY part_special.partno
            ) special ON special.partno = part.partno
            
ORDER BY sa_search.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
