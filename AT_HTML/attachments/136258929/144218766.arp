        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno" id="od_header.orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.ext_state" id="od_detail.ext_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.partno" id="rotables.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.serialno" id="rotables.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.vendor" id="od_header.vendor"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="address.name" id="address.name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (od_header.orderdate+729)'dd.Mm.yyyy') AS order_date" id="order_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (history.del_date+729)'dd.Mm.yyyy') AS Removal_Date" id="Removal_Date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    CASE WHEN od_detail.confirmed_date=0 THEN 'UNKNOWN'&#10;         ELSE TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (od_detail.confirmed_date)'DD.MM.YYYY')&#10;    END Conf_Date" id="Conf_Date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.financial_remarks" id="od_header.financial_remarks"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select
    od_header.orderno,
    od_detail.ext_state,
    rotables.partno,
    rotables.serialno,
    part.description,
    od_header.vendor,
    address.name,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_header.orderdate), 'DD.MM.YYYY') AS order_date,
    TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (history.del_date), 'DD.MM.YYYY') AS Removal_Date,
    CASE WHEN od_detail.confirmed_date=0 THEN ' '
         ELSE TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (od_detail.confirmed_date), 'DD.MM.YYYY')
    END Conf_Date,
    od_header.financial_remarks
from rotables
left join od_detail ON rotables.psn=od_detail.psn
left join od_header on od_header.orderno_i=od_detail.orderno_i
left join part on rotables.partno=part.partno
LEFT JOIN (
    SELECT
        history.psn,
        history.labelno,
        history.del_date
    FROM history
    WHERE history.VM='YA'
) history ON (rotables.psn=history.psn AND rotables.labelno=history.labelno)
join address on od_header.vendor=address.vendor
where od_header.order_type IN ('R','PX')
  and od_detail.ext_state in ('O','BO')
ORDER BY od_header.orderno, od_detail.posno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
