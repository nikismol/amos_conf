      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.partno" id="part.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ata_chapter" id="part.ata_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.measure_unit" id="part.measure_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.ac_typ" id="part.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.mat_class" id="part.mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.mat_type" id="part.mat_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.tool" id="part.tool"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.repairable" id="part.repairable"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.mutator" id="part.mutator"/>
        <ds:columnDescriptor amosType="DATE" description="part.mutation" id="part.mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.created_by" id="part.created_by"/>
        <ds:columnDescriptor amosType="DATE" description="part.created_date" id="part.created_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.start _day@">
          <ds:object>@VAR.start _day@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end_day@">
          <ds:object>@VAR.end_day@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT part.partno, 
    part.description, 
    part.ata_chapter, 
    part.measure_unit, 
    part.ac_typ, 
    part.mat_class, 
    part.mat_type, 
    part.tool, 
    part.repairable, 
    part.mutator, 
    part.mutation, 
    part.created_by, 
    part.created_date 
FROM part
WHERE part.created_date &gt;= '@VAR.start _day@' and part.created_date&lt;= '@VAR.end_day@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
