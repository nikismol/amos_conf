    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Report_stores_for_shift" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rownum" id="rownum"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_header.remarks" id="od_rec_header.remarks"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno" id="history.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description" id="part.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.serialno" id="history.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.batchno" id="history.batchno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.measure_unit ||chr(10)||'('||measure_unit.description||')' as measure_unit" id="measure_unit"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_detail.qty" id="od_rec_detail.qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (od_rec_header.del_date+729)'dd.mm.yyyy') as receiving_date" id="receiving_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('31.12.1971' 'dd.mm.yyyy') + od_rec_header.mutation + od_rec_header.mutation_time  / 1000 / 60 / 60 / 24'dd.mm.yyyy hh24:mi:ss') as receiving_mutation" id="receiving_mutation"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;Decode(pickslip_booked.status '0' 'New' '1' 'issued' '2' 'transfer' '6' 'partly booked' '7' 'partly cancelled' '8' 'cancelled' '9' 'closed' '10''deleted') as Pickslip_status" id="Pickslip_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pickslip_booked.pickslipno" id="pickslip_booked.pickslipno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_rec_header.awbno as awbno" id="awbno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_detail.ac_registr" id="od_detail.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ordnm" id="ordnm"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="prio" id="prio"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.station||'/'||history.store as store" id="store"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="station_store.description as stor_desc" id="stor_desc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#10;to_char(to_date('31.12.1971' 'dd.mm.yyyy') + @VAR.DATE_FROM@ + @VAR.TIME_FROM@  / 60 / 24'dd.mm.yyyy hh24:mi') as date_time_from" id="date_time_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('31.12.1971' 'dd.mm.yyyy') + history.mutation + history.mutation_time  / 1000 / 60 / 60 / 24'dd.mm.yyyy hh24:mi') as rec" id="rec"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('31.12.1971' 'dd.mm.yyyy') + @VAR.DATE_TO@ + @VAR.TIME_TO@  / 60 / 24'dd.mm.yyyy hh24:mi') as date_time_to" id="date_time_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_remarks.text AS text" id="text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_FROM@">
          <ds:object>@VAR.DATE_FROM@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.TIME_FROM@">
          <ds:object>@VAR.TIME_FROM@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.DATE_TO@">
          <ds:object>@VAR.DATE_TO@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.TIME_TO@">
          <ds:object>@VAR.TIME_TO@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
rownum,
od_rec_header.remarks,
history.partno,
part.description,
history.serialno,
history.batchno,
part.measure_unit ||chr(10)||'('||measure_unit.description||')' as measure_unit,
od_rec_detail.qty,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (od_rec_header.del_date+729),'dd.mm.yyyy') as receiving_date,
to_char(to_date('31.12.1971', 'dd.mm.yyyy') + od_rec_header.mutation + od_rec_header.mutation_time  / 1000 / 60 / 60 / 24, 'dd.mm.yyyy hh24:mi:ss') as receiving_mutation,
Decode(pickslip_booked.status, '0', 'New', '1', 'issued', '2', 'transfer', '6', 'partly booked', '7', 'partly cancelled', '8', 'cancelled', '9', 'closed', '10', 'deleted') as Pickslip_status,
pickslip_booked.pickslipno,
od_rec_header.awbno as awbno,
od_detail.ac_registr,
ordnm,
prio,
history.station||'/'||history.store as store,
station_store.description as stor_desc,
to_char(to_date('31.12.1971', 'dd.mm.yyyy') + '@VAR.DATE_FROM@' + '@VAR.TIME_FROM@'  / 60 / 24   , 'dd.mm.yyyy hh24:mi') as date_time_from,
to_char(to_date('31.12.1971', 'dd.mm.yyyy') + history.mutation + history.mutation_time  / 1000 / 60 / 60 / 24, 'dd.mm.yyyy hh24:mi') as rec,
to_char(to_date('31.12.1971', 'dd.mm.yyyy') + '@VAR.DATE_TO@' + '@VAR.TIME_TO@'  / 60 / 24   , 'dd.mm.yyyy hh24:mi') as date_time_to,
CASE WHEN part.ac_typ = 'RRJ' THEN part.description ELSE part_remarks.text END AS text

FROM 
        history
LEFT JOIN 
        od_rec_detail 
        ON od_rec_detail.recdetailno_i = history.recdetailno_i
LEFT JOIN
        part
        ON part.partno = history.partno
LEFT JOIN 
        measure_unit 
        ON measure_unit.measure_unit = part.measure_unit
LEFT JOIN 
        od_rec_header 
        ON od_rec_header.receivingno = od_rec_detail.receivingno
LEFT JOIN
        pickslip_booked
        ON pickslip_booked.pickslipseqno_i = history.pickslipseqno_i and history.partno = pickslip_booked.partno
LEFT JOIN 
        ( SELECT DISTINCT
        od_header.pool_reason as prio,
        od_header.orderno_i,
        od_header.orderno as ordnm
        FROM
            od_header 
        ) ord ON ord.ordnm = od_rec_detail.orderno
LEFT JOIN od_detail ON od_detail.detailno_i = history.od_detailno_i
LEFT JOIN station_store ON station_store.station = history.station and station_store.store = history.store
LEFT JOIN (
		SELECT part_remarks.partno AS partno
		,LISTAGG(part_remarks.text, ' ') WITHIN GROUP (ORDER BY part_remarks.partno) AS text
		FROM  part_remarks
		WHERE part_remarks.effectivity = 'DEFAULT'
		GROUP BY part_remarks.partno
		) part_remarks ON part.partno = part_remarks.partno
WHERE
        od_rec_detail.status not in ('9')
        and history.vm in ('T', 'TR', 'B1')
        and history.store in ('1014','1011')
        and ((@VAR.DATE_FROM@*24*60*60+@VAR.TIME_FROM@*60)&lt;=(history.mutation*60*24*60+history.mutation_time/1000))
        and ((@VAR.DATE_TO@*60*24*60+@VAR.TIME_TO@*60)&gt;=(history.mutation*60*24*60+history.mutation_time/1000))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
