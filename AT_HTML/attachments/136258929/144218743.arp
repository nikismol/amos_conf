  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="DATE_FROM"/>
        <ds:columnDescriptor amosType="TIME" description="" id="TIME_TO"/>
        <ds:columnDescriptor amosType="TIME" description="" id="TIME_FROM"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="DATE_TO"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Date From" id="DATE_FROM">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
