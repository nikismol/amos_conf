        <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
        <attribute name="antialias">false</attribute>
      </view>
      <view class="LabelReportView" id="9">
        <attribute name="name">Label_6</attribute>
        <attribute name="position">0 24</attribute>
        <attribute name="size">1000 41</attribute>
        <attribute name="visible">YES</attribute>
        <attribute name="auto-resize">NO</attribute>
        <attribute name="rotation">0.0</attribute>
        <conditional_attributes>
          <conditional_attribute id="1">
            <attribute name="text">Date Period: @RMX_OMTO_INFORMATION_RECEIVING.date_from@ - @RMX_OMTO_INFORMATION_RECEIVING.date_to@</attribute>
            <conditions>
              <condition class="GenericStyleCondition">
                <field id="1">@VAR.date_from@</field>
                <field id="2">0</field>
                <operator negated="NO">IS_BIGGER</operator>
              </condition>
              <condition class="GenericStyleCondition">
                <field id="1">@VAR.date_to@</field>
                <field id="2">0</field>
                <operator negated="NO">IS_BIGGER</operator>
              </condition>
            </conditions>
          </conditional_attribute>
        </conditional_attributes>
        <attribute name="color">000000</attribute>
        <attribute name="margin">0 0 0 0</attribute>
        <attribute name="padding">0 0 0 0</attribute>
        <attribute name="border">1 SOLID 000000</attribute>
        <attribute name="text">Date Period: @Report_stores_for_shift.date_time_from@ - @Report_stores_for_shift.date_time_to@
(Report Date: @SYSTEM.DATE@ Report Time: @SYSTEM.TIME@ AMOS_SERVER: @SYSTEM.AMOS_SERVER@:@SYSTEM.AMOS_PORT@)</attribute>
        <attribute name="text-decoration">NONE</attribute>
        <attribute name="font">SansSerif PLAIN 12</attribute>
        <attribute name="text-align">CENTER</attribute>
        <attribute name="line-break">AS_IS</attribute>
        <attribute name="splitable">NO</attribute>
        <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
        <attribute name="antialias">false</attribute>
      </view>
    </content>
  </page_master>
