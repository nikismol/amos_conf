  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="PM" description="" id="pm_publicationno_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Цифровой номер публикации" id="pm_publicationno_i">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="PUBLICATION_HEADER" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.pm_publicationno_i as pubno_i" id="pubno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.docno as pub_doc_no" id="pub_doc_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication_type.type as pub_type" id="pub_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.description as pub_desc" id="pub_desc"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.title||' '||pm_publication.title2 AS pub_title" id="pub_title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_document.responsible as responsible_sign" id="responsible_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.created_by as created_sign" id="created_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (pm_publication.created_date)'DD.MM.YYYY') as created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.prepared_by as prepared_sign" id="prepared_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (pm_publication.prep_date)'DD.MM.YYYY') as prepared_date" id="prepared_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.checked_by as checked_sign" id="checked_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (pm_publication.check_date)'DD.MM.YYYY') as checked_date" id="checked_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.approved_by as approved_sign" id="approved_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (pm_publication.approval_date)'DD.MM.YYYY') as approved_date" id="approved_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="issuer_address.vendor as supplier_code" id="supplier_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="issuer_address.vendor as issuer_code" id="issuer_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="issuer_address.name as issuer_name" id="issuer_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_document.planning_rec as owo_deadline" id="owo_deadline"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="issuer_address.name as supplier_name" id="supplier_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN issuer_address.vendor = 'AFL CAD MCC' THEN 'А.О. Макаров'&#10;                WHEN issuer_address.vendor LIKE 'AFL AMD%' THEN 'Э.В. Ушаков'&#10;                ELSE '' as name_ru" id="name_ru"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN issuer_address.vendor = 'AFL CAD MCC' THEN 'A.O. Makarov'&#10;                WHEN issuer_address.vendor LIKE 'AFL AMD%' THEN 'E.V. Ushakov'&#10;                ELSE '' as name_en" id="name_en"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN issuer_address.vendor = 'AFL CAD MCC' THEN 'Начальник ИОО / MCC Manager'&#10;                WHEN issuer_address.vendor LIKE 'AFL AMD%' THEN 'Директор ДТО ВС / AMD Director'&#10;                ELSE '' as position" id="position"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.pm_publicationno_i@">
          <ds:object>@VAR.pm_publicationno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
    pm_publication.pm_publicationno_i as pubno_i
    , pm_publication.docno as pub_doc_no 
    , pm_publication_type.type as pub_type
    , pm_publication.description as pub_desc
    , pm_publication.title||' '||pm_publication.title2 AS pub_title
    , pm_document.responsible as responsible_sign
    , pm_publication.created_by as created_sign
    , TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (pm_publication.created_date), 'DD.MM.YYYY') as created_date
    , pm_publication.prepared_by as prepared_sign
    , TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (pm_publication.prep_date), 'DD.MM.YYYY') as prepared_date
    , pm_publication.checked_by as checked_sign
    , TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (pm_publication.check_date), 'DD.MM.YYYY') as checked_date
    , pm_publication.approved_by as approved_sign
    , TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (pm_publication.approval_date), 'DD.MM.YYYY') as approved_date
    , supplier_address.vendor as supplier_code
    , issuer_address.vendor as issuer_code
    , issuer_address.name as issuer_name
    , pm_document.planning_rec as owo_deadline
    , CASE WHEN supplier_address.vendor = 'AFL CAD MCC' THEN 'Начальник ОКУТО ВС / MCC Manager'
                WHEN supplier_address.vendor LIKE 'AFL AMD ED' THEN 'Начальник ОИТО / ED Manager'
                WHEN supplier_address.vendor LIKE 'AFL AMD' THEN 'Заместитель директора департамента - главный инженер ДПЛГ / Deputy CAD Director - Chief engineer'
                WHEN supplier_address.vendor LIKE 'AFL AMD%' AND supplier_address.vendor NOT IN ('AFL AMD ED', 'AFL AMD') THEN 'Директор ДТО ВС / AMD Director'
                ELSE supplier_address.name 
      END as supplier_name
    , CASE WHEN supplier_address.vendor = 'AFL CAD MCC' THEN 'Ю.В. Орлов'
                WHEN supplier_address.vendor LIKE 'AFL AMD ED' THEN 'С.А. Воробьев'
                WHEN supplier_address.vendor LIKE 'AFL AMD' THEN 'М.М. Рахматуллин'
                WHEN supplier_address.vendor LIKE 'AFL AMD%' AND supplier_address.vendor NOT IN ('AFL AMD ED', 'AFL AMD') THEN 'Э.В. Ушаков'
                ELSE ''
      END as name_ru
    , CASE WHEN supplier_address.vendor = 'AFL CAD MCC' THEN 'Y.V. Orlov'
                WHEN supplier_address.vendor LIKE 'AFL AMD ED' THEN 'S.A. Vorobev'
                WHEN supplier_address.vendor LIKE 'AFL AMD' THEN 'M.M. Rakhmatullin'
                WHEN supplier_address.vendor LIKE 'AFL AMD%' AND supplier_address.vendor NOT IN ('AFL AMD ED', 'AFL AMD') THEN 'E.V. Ushakov'
                ELSE ''
      END as name_en
    , CASE WHEN supplier_address.vendor = 'AFL CAD MCC' THEN 'Начальник ОКУТО ВС / MCC Manager'
                WHEN supplier_address.vendor LIKE 'AFL AMD ED' THEN 'Начальник ОИТО / ED Manager'
                WHEN supplier_address.vendor LIKE 'AFL AMD' THEN 'Заместитель директора департамента - главный инженер ДПЛГ / Deputy CAD Director - Chief engineer'
                WHEN supplier_address.vendor LIKE 'AFL AMD%' AND supplier_address.vendor NOT IN ('AFL AMD ED', 'AFL AMD') THEN 'Директор ДТО ВС / AMD Director'
                ELSE ''
       END as position
                            
FROM pm_publication
LEFT JOIN pm_document ON pm_publication.pm_publicationno_i = pm_document.pm_publicationno_i
LEFT JOIN pm_publication_type ON pm_publication.pm_typeno_i = pm_publication_type.pm_typeno_i
LEFT JOIN address supplier_address ON supplier_address.address_i = pm_publication.owner
LEFT JOIN address issuer_address ON issuer_address.address_i = pm_publication.addressno_i
WHERE pm_publication.pm_publicationno_i = @VAR.pm_publicationno_i@</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="USER_PREPARED" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.user_sign as user_sign" id="user_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" SUBSTR(fname_ru.char_value 0 1)||'. '||SUBSTR(mname_ru.char_value 01)||CASE WHEN mname_ru.char_value IS NOT NULL THEN '. ' ELSE ' ' END||lname_ru.char_value as name_ru" id="name_ru"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" SUBSTR(sign.firstname 01)||'. '||sign.lastname as name_en" id="name_en"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.telecom as user_phone" id="user_phone"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.email as user_email" id="user_email"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@PUBLICATION_HEADER.prepared_sign@">
          <ds:object>@PUBLICATION_HEADER.prepared_sign@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
      sign.user_sign as user_sign
    , SUBSTR(fname_ru.char_value, 0, 1)||'. '||SUBSTR(mname_ru.char_value, 0, 1)||CASE WHEN mname_ru.char_value IS NOT NULL THEN '. ' ELSE ' ' END||lname_ru.char_value as name_ru
    , SUBSTR(sign.firstname, 0, 1)||'. '||sign.lastname as name_en
    , sign.telecom as user_phone
    , sign.email as user_email
FROM sign
LEFT JOIN rm_property_value lname_ru ON lname_ru.owner_amos_type = 'SG' AND lname_ru.owner_amos_key = sign.employee_no_i AND lname_ru.property_type_no_i = 42
LEFT JOIN rm_property_value mname_ru ON mname_ru.owner_amos_type = 'SG' AND mname_ru.owner_amos_key = sign.employee_no_i AND mname_ru.property_type_no_i = 41
LEFT JOIN rm_property_value fname_ru ON fname_ru.owner_amos_type = 'SG' AND fname_ru.owner_amos_key = sign.employee_no_i AND fname_ru.property_type_no_i = 40
WHERE sign.user_sign = '@PUBLICATION_HEADER.prepared_sign@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="USER_APPROVED" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.user_sign as user_sign" id="user_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" SUBSTR(fname_ru.char_value 0 1)||'. '||SUBSTR(mname_ru.char_value 01)||CASE WHEN mname_ru.char_value IS NOT NULL THEN '. ' ELSE ' ' END||lname_ru.char_value as name_ru" id="name_ru"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" SUBSTR(sign.firstname 01)||'. '||sign.lastname as name_en" id="name_en"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.telecom as user_phone" id="user_phone"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.email as user_email" id="user_email"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.email as user_email&#10;    CASE WHEN sign.user_sign = 72601 THEN 'Директор ДПЛГ / CAD Director'&#10;              WHEN sign.user_sign = 56563 THEN 'Зам. директора ДПЛГ / Deputy CAD Director'&#10;              ELSE ''&#10;    END as position" id="position"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@PUBLICATION_HEADER.approved_sign@">
          <ds:object>@PUBLICATION_HEADER.approved_sign@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
      sign.user_sign as user_sign
    , INITCAP(SUBSTR(fname_ru.char_value, 0, 1)||'. '||SUBSTR(mname_ru.char_value, 0, 1)||CASE WHEN mname_ru.char_value IS NOT NULL THEN '. ' ELSE ' ' END||lname_ru.char_value) as name_ru
    , INITCAP(SUBSTR(sign.firstname, 0, 1)||'. '|| DECODE(SUBSTR(mname_ru.char_value, 0, 1), 'В', 'V', 'Г', 'G', '') ||'. '||sign.lastname) as name_en
    , sign.telecom as user_phone
    , sign.email as user_email
    ,CASE WHEN sign.user_sign = '78885' THEN 'Директор ДПЛГ / CAD Director'
               WHEN sign.user_sign = '56563' THEN 'Зам. директора ДПЛГ / Deputy CAD Director'
               ELSE ''
     END as position  
FROM sign
LEFT JOIN rm_property_value lname_ru ON lname_ru.owner_amos_type = 'SG' AND lname_ru.owner_amos_key = sign.employee_no_i AND lname_ru.property_type_no_i = 42
LEFT JOIN rm_property_value mname_ru ON mname_ru.owner_amos_type = 'SG' AND mname_ru.owner_amos_key = sign.employee_no_i AND mname_ru.property_type_no_i = 41
LEFT JOIN rm_property_value fname_ru ON fname_ru.owner_amos_type = 'SG' AND fname_ru.owner_amos_key = sign.employee_no_i AND fname_ru.property_type_no_i = 40
WHERE sign.user_sign = '@PUBLICATION_HEADER.approved_sign@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="PUBLICATION_APPLIC_AGG" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ AS ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       LISTAGG(aircraft.ac_registr '') WITHIN GROUP (ORDER BY applicability.effectivityno_i) AS ac_registr" id="ac_registr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@PUBLICATION_HEADER.pubno_i@">
          <ds:object>@PUBLICATION_HEADER.pubno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
    act.typ AS ac_typ,
    LISTAGG(act.reg || CASE WHEN act.serialno IS NOT NULL THEN ' ('||act.serialno||')' ELSE '' END, ', ') WITHIN GROUP (ORDER BY act.serialno) AS ac_registr
FROM (
    SELECT DISTINCT 
            CASE WHEN applicability.ref_type = 'AC_INT' THEN aircraft.ac_typ ELSE rotables.partno END as typ
        ,   CASE WHEN applicability.ref_type = 'AC_INT' THEN aircraft.ac_registr ELSE rotables.serialno END as reg
        ,   CASE WHEN applicability.ref_type = 'AC_INT' THEN aircraft.serialno ELSE NULL END as serialno
    FROM applicability
    LEFT JOIN aircraft ON applicability.ref_key = aircraft.aircraftno_i AND applicability.ref_type = 'AC_INT'
    LEFT JOIN rotables ON applicability.ref_key = rotables.psn AND applicability.ref_type = 'RO'
    LEFT JOIN event_effectivity_link ON applicability.effectivityno_i = event_effectivity_link.effectivityno_i 
    LEFT JOIN pm_document ON event_effectivity_link.event_key = pm_document.pm_docno_i  AND event_effectivity_link.event_type = 'PMDOCU'
    WHERE pm_document.pm_publicationno_i =   '@PUBLICATION_HEADER.pubno_i@'
    AND applicability.applicable = 'Y'
) act
GROUP BY act.typ</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
