  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="PUBLICATION"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Publication Number" id="PUBLICATION">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="PUBLICATION_PROD" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.docno AS docno" id="docno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.title AS AC_REG" id="AC_REG"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.title2 AS AC_SER" id="AC_SER"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.description AS descr_text" id="descr_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN pm_publication.ext_no IS NOT NULL THEN pm_publication.ext_no ELSE pm_publication.docno END as order_no" id="order_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication_type.type as pt" id="pt"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="adr_iss.name AS name_from" id="name_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="adr_to.name AS name_to" id="name_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (pm_publication.issue_date+729)'dd.mm.yyyy') as issue_date" id="issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.remarks AS reason" id="reason"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_from.lastname||' '||sign_from.firstname AS sign_from" id="sign_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign_to.lastname||' '||sign_to.firstname AS sign_to" id="sign_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="  to_char(to_date('01.01.1970' 'dd.mm.yyyy') + ( pm_final_treatment.due_date+729)'dd.mm.yyyy') as date_from" id="date_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="  to_char(to_date('01.01.1970' 'dd.mm.yyyy') + ( pm_final_treatment.closed_date+729)'dd.mm.yyyy') as date_to" id="date_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ext_no AS contract" id="contract"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.ext_no AS contract_order" id="contract_order"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_final_treatment.remarks AS maint_by" id="maint_by"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.eff_notes AS CAT" id="CAT"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.internal_remarks AS Ch_t" id="Ch_t"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.issue_number AS COST_TYPE" id="COST_TYPE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.revision_number AS WORK_DURATION" id="WORK_DURATION"/>
        <ds:columnDescriptor amosType="MONETARY" description="pm_pub_assess_costs.est_mat_cost AS MAT_PRICE" id="MAT_PRICE"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication_costs.est_labour_cost AS HOUR_PRICE" id="HOUR_PRICE"/>
        <ds:columnDescriptor amosType="DOUBLE" description="pm_pub_assess_costs.cost_ac AS NUM_HOURS" id="NUM_HOURS"/>
        <ds:columnDescriptor amosType="DOUBLE" description="pm_pub_assess_costs.cost_fleet AS DELAY_HOURS" id="DELAY_HOURS"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.PUBLICATION@">
          <ds:object>@VAR.PUBLICATION@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	  pm_publication.docno AS docno
	, pm_publication.title AS AC_REG
	, aircraft.serialno AS AC_SER
	, pm_publication.description AS descr_text
	, CASE WHEN pm_publication.ext_no IS NOT NULL THEN pm_publication.ext_no ELSE pm_publication.docno END as order_no
	, pm_publication_type.type as pt
	, adr_iss.name AS name_from
	, adr_to.name AS name_to
	, to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (pm_publication.issue_date+729),'dd.mm.yyyy') as issue_date      
	, pm_document.remark AS reason        
	, sign_from.lastname||' '||sign_from.firstname AS sign_from
	, sign_to.lastname||' '||sign_to.firstname AS sign_to
	, to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( pm_publication.prep_date+729),'dd.mm.yyyy') as date_from
	, to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( pm_publication.check_date+729),'dd.mm.yyyy') as date_to
	, pm_publication.del_no AS contract
	, pm_publication.ext_no AS contract_order
	, adr_maint.name  AS maint_by
	, pm_publication.eff_notes AS CAT
	, pm_publication.internal_remarks AS Ch_t
	, pm_publication_costs.cost_remarks AS COST_TYPE
	, pm_publication_costs.mat_under_warranty AS WORK_DURATION
	, pm_publication_costs.est_mat_cost AS MAT_PRICE
	, pm_publication_costs.est_labour_cost AS HOUR_PRICE
	, pm_publication_costs.cost_ac AS NUM_HOURS
	, pm_publication_costs.cost_fleet AS DELAY_HOURS
FROM pm_publication
LEFT JOIN pm_publication_type ON pm_publication.pm_typeno_i = pm_publication_type.pm_typeno_i
LEFT JOIN pm_document ON pm_publication.pm_publicationno_i = pm_document.pm_publicationno_i
LEFT JOIN pm_publication_costs ON pm_document.pm_publicationno_i = pm_publication_costs.pm_publicationno_i
LEFT JOIN address adr_iss ON pm_publication.addressno_i = adr_iss.address_i 
LEFT JOIN address adr_to ON pm_publication.owner = adr_to.address_i
LEFT JOIN sign sign_from ON  pm_publication.prepared_by = sign_from.user_sign
LEFT JOIN sign sign_to ON pm_publication.checked_by = sign_to.user_sign
LEFT JOIN aircraft ON pm_publication.title = aircraft.ac_registr 
LEFT JOIN address adr_maint ON aircraft.operator = adr_maint.vendor
WHERE pm_publication.pm_publicationno_i = '@VAR.PUBLICATION@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
