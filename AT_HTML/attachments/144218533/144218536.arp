    , SUBSTR(sign.firstname, 0, 1)||'. '||sign.lastname as name_en
    , sign.telecom as user_phone
    , sign.email as user_email
FROM sign
LEFT JOIN rm_property_value lname_ru ON lname_ru.owner_amos_type = 'SG' AND lname_ru.owner_amos_key = sign.employee_no_i AND lname_ru.property_type_no_i = 42
LEFT JOIN rm_property_value mname_ru ON mname_ru.owner_amos_type = 'SG' AND mname_ru.owner_amos_key = sign.employee_no_i AND mname_ru.property_type_no_i = 41
LEFT JOIN rm_property_value fname_ru ON fname_ru.owner_amos_type = 'SG' AND fname_ru.owner_amos_key = sign.employee_no_i AND fname_ru.property_type_no_i = 40
