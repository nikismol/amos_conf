  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="EO" description="" id="pm_publicationno_i"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Числовой номер E.O." id="pm_publicationno_i">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="EO_HEADER" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication_parent.docno as doc_no" id="doc_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.docno as eo_doc_no" id="eo_doc_no"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication_parent.revision_number as doc_rev" id="doc_rev"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="address.name as issuer_name" id="issuer_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication_parent.title as sb_title" id="sb_title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_engineering.recommendations as eng_judgement" id="eng_judgement"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="doc_header.docno_i as docno_i" id="docno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_engineering.electr_load as sw_affect" id="sw_affect"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.title||' '||pm_publication.title2 AS pub_title" id="pub_title"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.created_by as created_sign" id="created_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (pm_publication.created_date)'DD.MM.YYYY') as created_date" id="created_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.prepared_by as prepared_sign" id="prepared_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (pm_publication.prep_date)'DD.MM.YYYY') as prepared_date" id="prepared_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.checked_by as checked_sign" id="checked_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (pm_publication.check_date)'DD.MM.YYYY') as checked_date" id="checked_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.released_by as released_sign" id="released_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (pm_publication.release_date)'DD.MM.YYYY') as released_date" id="released_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.approved_by as approved_sign" id="approved_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (pm_publication.approval_date)'DD.MM.YYYY') as approved_date" id="approved_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_business_case.maint_no_of_ac as concerned_ac" id="concerned_ac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_business_case.modkits_unitcost as sb_kit_price" id="sb_kit_price"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_business_case.other_unitcost as other_price" id="other_price"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_business_case.modkits_unitcost * CASE WHEN pm_business_case.modkits_no IS NOT NULL THEN pm_business_case.modkits_no ELSE pm_business_case.maint_no_of_ac END +&#10;        pm_business_case.other_unitcost * CASE WHEN pm_business_case.other_no IS NOT NULL THEN pm_business_case.other_no ELSE pm_business_case.maint_no_of_ac END as total_parts_per_ac" id="total_parts_per_ac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_business_case.nonrec_mat_cost as total_est_mh" id="total_est_mh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_business_case.nonrec_loan_cost as total_sb_mh" id="total_sb_mh"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_business_case.nonrec_handling_cost as mh_price" id="mh_price"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_business_case.modkits_unitcost * CASE WHEN pm_business_case.modkits_no IS NOT NULL THEN pm_business_case.modkits_no ELSE pm_business_case.maint_no_of_ac END +&#10;        pm_business_case.other_unitcost * CASE WHEN pm_business_case.other_no IS NOT NULL THEN pm_business_case.other_no ELSE pm_business_case.maint_no_of_ac END +&#10;        pm_business_case.nonrec_future_cost +&#10;        pm_business_case.nonrec_mat_cost * pm_business_case.nonrec_handling_cost *  pm_business_case.maint_no_of_ac as total_cost_concerned_fleet" id="total_cost_concerned_fleet"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.general_text as eo_references" id="eo_references"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.approval_state as approval_state" id="approval_state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication.remarks as approval_reason" id="approval_reason"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="pm_publication_costs.project_currency as pm_currency" id="pm_currency"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.pm_publicationno_i@">
          <ds:object>@VAR.pm_publicationno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
      pm_publication_parent.docno as doc_no
    , pm_publication.docno as eo_doc_no
    , pm_publication_parent.revision_number as doc_rev  
    , issuer_address.name as issuer_name
    , pm_publication_parent.title||' '||pm_publication_parent.title2  as sb_title
    , pm_engineering.recommendations as eng_judgement
    , doc_header.docno_i as docno_i    
    , pm_engineering.electr_load as sw_affect
    , pm_publication.title||' '||pm_publication.title2 AS pub_title
    , pm_publication.created_by as created_sign
    , TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (pm_publication.created_date), 'DD.MM.YYYY') as created_date
    , pm_publication.prepared_by as prepared_sign
    , TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (pm_publication.prep_date), 'DD.MM.YYYY') as prepared_date
    , pm_publication.checked_by as checked_sign
    , TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (pm_publication.check_date), 'DD.MM.YYYY') as checked_date
    , pm_publication.released_by as released_sign
    , TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (pm_publication.release_date), 'DD.MM.YYYY') as released_date
    , pm_publication.approved_by as approved_sign
    , TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (pm_publication.approval_date), 'DD.MM.YYYY') as approved_date
    , pm_business_case.maint_no_of_ac as concerned_ac
    , pm_business_case.modkits_unitcost as sb_kit_price
    , pm_business_case.rotables_unitcost as other_price
    , pm_business_case.modkits_unitcost + pm_business_case.rotables_unitcost as total_parts_per_ac
    , pm_business_case.nonrec_mat_cost as total_est_mh
    , pm_business_case.nonrec_loan_cost as total_sb_mh
    , pm_business_case.nonrec_handling_cost as mh_price
    , pm_business_case.modkits_unitcost * pm_business_case.maint_no_of_ac  +
        pm_business_case.rotables_unitcost *pm_business_case.maint_no_of_ac  +
        pm_business_case.nonrec_mat_cost * pm_business_case.nonrec_handling_cost *  pm_business_case.maint_no_of_ac as total_cost_concerned_fleet
    , pm_engineering.general_text as eo_references
    , pm_publication.approval_state as approval_state
    , pm_publication.remarks as approval_reason
    , pm_publication_costs.project_currency as pm_currency
FROM pm_publication 
LEFT JOIN pm_publication_reference ON pm_publication_reference.pm_publicationno_i = pm_publication.pm_publicationno_i
LEFT JOIN pm_publication pm_publication_parent ON pm_publication_parent.pm_publicationno_i = ref_publicationno_i
LEFT JOIN address issuer_address ON issuer_address.address_i = pm_publication.addressno_i
LEFT JOIN pm_publication_costs ON pm_publication_costs.pm_publicationno_i = pm_publication.pm_publicationno_i
LEFT JOIN pm_engineering ON pm_engineering.pm_publicationno_i = pm_publication.pm_publicationno_i
LEFT JOIN doc_header ON doc_header.docno = pm_publication.docno AND doc_header.doc_type = 'EOD' AND doc_header.revision = pm_publication.revision_number
LEFT JOIN pm_business_case ON pm_business_case.pm_publicationno_i = pm_publication.pm_publicationno_i
WHERE pm_publication.pm_publicationno_i = '@VAR.pm_publicationno_i@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="EO_APPLIC" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as ac_typ" id="ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" LISTAGG(aircraft.serialno '') WITHIN GROUP (ORDER BY applicability.effectivityno_i) AS sns" id="sns"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@EO_HEADER.docno_i@">
          <ds:object>@EO_HEADER.docno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
       aircraft.ac_typ as ac_typ
       , LISTAGG(aircraft.serialno, ', ') WITHIN GROUP (ORDER BY applicability.effectivityno_i) AS sns
FROM applicability
LEFT JOIN aircraft ON applicability.ref_key = aircraft.aircraftno_i AND applicability.ref_type = 'AC_INT'
LEFT JOIN event_effectivity_link ON applicability.effectivityno_i = event_effectivity_link.effectivityno_i 
WHERE event_effectivity_link.event_key = '@EO_HEADER.docno_i@' 
AND event_effectivity_link.event_type = 'DO'
AND applicability.applicable = 'Y'
GROUP BY aircraft.ac_typ</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="EO_APPLIC_RO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="rotables.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" LISTAGG(rotables.serialno '') WITHIN GROUP (ORDER BY applicability.effectivityno_i) AS sns" id="sns"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@EO_HEADER.docno_i@">
          <ds:object>@EO_HEADER.docno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
       rotables.partno as partno
       , LISTAGG(rotables.serialno, ', ') WITHIN GROUP (ORDER BY applicability.effectivityno_i) AS sns
FROM applicability
LEFT JOIN rotables ON  applicability.ref_key = rotables.psn AND applicability.ref_type = 'RO'
LEFT JOIN event_effectivity_link ON applicability.effectivityno_i = event_effectivity_link.effectivityno_i 
WHERE event_effectivity_link.event_key = '@EO_HEADER.docno_i@' 
AND event_effectivity_link.event_type = 'DO'
AND applicability.applicable = 'Y'
GROUP BY rotables.partno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="EO_DUE_DATE" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (i_d.due_at)'DD.MM.YYYY') as due_d" id="due_d"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@EO_HEADER.docno_i@">
          <ds:object>@EO_HEADER.docno_i@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (i_d.due_at), 'DD.MM.YYYY') as due_d
FROM event_effectivity_link
LEFT JOIN treq_time_requirement ON treq_time_requirement.event_type = 'EFL' AND event_effectivity_link.effectivity_linkno_i = treq_time_requirement.event_key
LEFT JOIN treq_interval_group ON treq_interval_group.timerequirementno_i = treq_time_requirement.timerequirementno_i
JOIN treq_dimension_group ON treq_interval_group.interval_groupno_i=treq_dimension_group.interval_groupno_i
        
LEFT JOIN treq_interval i_d ON ((i_d.interval_groupno_i = treq_interval_group.interval_groupno_i) OR (i_d.dimension_groupno_i=treq_dimension_group.dimension_groupno_i))
LEFT JOIN counter_definition c_d ON c_d.counter_defno_i = i_d.counter_defno_i 

WHERE event_effectivity_link.event_type = 'DO' AND  event_effectivity_link.event_key = '@EO_HEADER.docno_i@'
AND treq_interval_group.threshold = 'Y' 
AND c_d.code = 'D'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="USER_PREPARED" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.user_sign as user_sign" id="user_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" SUBSTR(fname_ru.char_value 0 1)||'. '||SUBSTR(mname_ru.char_value 01)||CASE WHEN mname_ru.char_value IS NOT NULL THEN '. ' ELSE ' ' END||lname_ru.char_value as name_ru" id="name_ru"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" SUBSTR(sign.firstname 01)||'. '||sign.lastname as name_en" id="name_en"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.telecom as user_phone" id="user_phone"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.email as user_email" id="user_email"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@EO_HEADER.prepared_sign@">
          <ds:object>@EO_HEADER.prepared_sign@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
      sign.user_sign as user_sign
    , SUBSTR(fname_ru.char_value, 0, 1)||'. '||SUBSTR(mname_ru.char_value, 0, 1)||CASE WHEN mname_ru.char_value IS NOT NULL THEN '. ' ELSE ' ' END||lname_ru.char_value as name_ru
    , SUBSTR(sign.firstname, 0, 1)||'. '||sign.lastname as name_en
    , sign.telecom as user_phone
    , sign.email as user_email
FROM sign
LEFT JOIN rm_property_value lname_ru ON lname_ru.owner_amos_type = 'SG' AND lname_ru.owner_amos_key = sign.employee_no_i AND lname_ru.property_type_no_i = 42
LEFT JOIN rm_property_value mname_ru ON mname_ru.owner_amos_type = 'SG' AND mname_ru.owner_amos_key = sign.employee_no_i AND mname_ru.property_type_no_i = 41
LEFT JOIN rm_property_value fname_ru ON fname_ru.owner_amos_type = 'SG' AND fname_ru.owner_amos_key = sign.employee_no_i AND fname_ru.property_type_no_i = 40
WHERE sign.user_sign = '@EO_HEADER.prepared_sign@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="USER_APPROVED" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
