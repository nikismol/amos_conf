  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i AS WO" id="WO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ AS AC_Type" id="AC_Type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr AS AC_Registr" id="AC_Registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.text AS First_Step" id="First_Step"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + ( wo_header.issue_date+729)'dd.mm.yyyy') as Issue_Date" id="Issue_Date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (forecast.expected_date+729)'dd.mm.yyyy') AS Due_Date" id="Due_Date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_forecast.partno AS Partno" id="Partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description AS Part" id="Part"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_request_2.qty AS QTY" id="QTY"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (part_request_2.created_date+729)'dd.mm.yyyy') AS Request_Date" id="Request_Date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno AS Order_No" id="Order_No"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (od_detail.confirmed_date+729)'dd.mm.yyyy') AS Confirmed_Date" id="Confirmed_Date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'dd.mm.yyyy') + (od_detail.target_date+729)'dd.mm.yyyy') AS Target_Date" id="Target_Date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  wo_header.event_perfno_i AS WO
        ,aircraft.ac_typ AS AC_Type
        ,wo_header.ac_registr AS AC_Registr
        ,wo_text_description.text AS First_Step
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.issue_date+729),'dd.mm.yyyy') as Issue_Date   
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (forecast.expected_date+729),'dd.mm.yyyy') AS Due_Date
        ,part_forecast.partno AS Partno
        ,part.description AS Part
        ,part_request_2.qty AS QTY
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (part_request_2.created_date+729),'dd.mm.yyyy') AS Request_Date
        ,od_header.orderno AS Order_No
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (od_detail.confirmed_date+729),'dd.mm.yyyy') AS Confirmed_Date
        ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (od_detail.target_date+729),'dd.mm.yyyy') AS Target_Date
FROM forecast
JOIN wo_header ON forecast.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN workstep_link ON wo_header.event_perfno_i = workstep_link.event_perfno_i AND workstep_link.sequenceno ='1'
LEFT JOIN wo_text_description ON workstep_link.descno_i =  wo_text_description.descno_i
LEFT JOIN part_forecast ON wo_header.event_perfno_i = part_forecast.event_perfno_i
/*LEFT JOIN wo_transfer ON wo_header.event_perfno_i = wo_transfer.event_perfno_i AND wo_transfer.is_last_transfer = 'Y' AND wo_transfer.transfer_type IN ('T', 'E')*/
LEFT JOIN part_request_2 ON part_forecast.part_requestno_i = part_request_2.part_requestno_i
LEFT JOIN part ON part_request_2.partno = part.partno
LEFT JOIN od_detail ON part_request_2.partno = od_detail.partno AND od_detail.ext_state = 'O' AND od_detail.order_type = 'P'
LEFT JOIN od_header ON od_detail.orderno_i = od_header.orderno_i
WHERE
    (
        wo_header.ata_chapter LIKE '11%' OR
        wo_header.ata_chapter LIKE '23%' OR
        wo_header.ata_chapter LIKE '25%' OR
        wo_header.ata_chapter LIKE '44%' 
    )
/*AND wo_header.hil = 'Y'*/
AND wo_header.state = 'O'
AND wo_header.type IN ('C', 'P', 'M')
AND part_forecast.status IN (1,2,3) 
AND 
(forecast.expected_date &lt;= FLOOR((SYSDATE+1) - CAST(TIMESTAMP '1971-12-31 00:00:00 UTC' AS DATE))
AND forecast.expected_date &gt;= FLOOR((SYSDATE) - CAST(TIMESTAMP '1971-12-31 00:00:00 UTC' AS DATE))
)
ORDER BY aircraft.ac_typ</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
