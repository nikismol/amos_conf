  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RB" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970''dd.mm.yyyy') + (forecast.expected_date+729)) expected_date" id="expected_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    CASE &#10;                WHEN forecast.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (wo_transfer.absolute_due_date+729) 'dd.Mm.yyyy')&#10;                WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.absolute_due_at_ac))&#10;                ELSE  &#10;                        TO_CHAR(FLOOR (TO_NUMBER(dim.abs_due_at)/60))||':'&#10;                        ||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(dim.abs_due_at) 60)))&lt;10&#10;                        THEN '0'||(TO_CHAR(MOD(TO_NUMBER(dim.abs_due_at) 60)))&#10;                        ELSE (TO_CHAR(MOD(TO_NUMBER(dim.abs_due_at)60)))&#10;                        END       &#10;    END  super_due_at" id="super_due_at"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.dimension" id="forecast.dimension"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;    CASE &#10;                WHEN forecast.dimension = 'D' THEN TO_CHAR(TRUNC(TO_NUMBER((forecast.togo)/60)/24)) &#10;                WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.togo))&#10;                ELSE  &#10;                        TO_CHAR(FLOOR (TO_NUMBER(forecast.togo)/60))||':'&#10;                        ||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(forecast.togo) 60)))&lt;10&#10;                        THEN '0'||(TO_CHAR(MOD(TO_NUMBER(forecast.togo) 60)))&#10;                        ELSE (TO_CHAR(MOD(TO_NUMBER(forecast.togo)60)))&#10;                        END       &#10;    END  super_togo" id="super_togo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_NUMBER(forecast.interval_value) || forecast.interval_dimension_type as Interval" id="Interval"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_event_link.event_name" id="wo_event_link.event_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_event_link.event_display" id="wo_event_link.event_display"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_event_link.event_status" id="wo_event_link.event_status"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_event_link.revision" id="wo_event_link.revision"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="event_effectivity.title as effectivity" id="effectivity"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.comp_partno ||'/'|| wo_header.comp_serialno AS Rotable" id="Rotable"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ext_workorderno" id="wo_header.ext_workorderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_transfer.treq_interval_groupno_i" id="wo_transfer.treq_interval_groupno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;DECODE(wo_event_link.event_type &#10;&#9;&#9;'DOC_EFF' 'Document'&#10;&#9;&#9;'CHTI' 'Check'&#10;&#9;&#9;'TCEFFLI' 'Taskcard '&#10;&#9;&#9;'RORE''Rptables') AS event_type_s" id="event_type_s"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_group" id="aircraft.ac_group"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="WORK_SIGN.workstep_sign as responsible" id="responsible"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname||' '||sign.lastname AS FIO" id="FIO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="department.department||' '||department.description AS DEPT" id="DEPT"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.release_station AS closing_station" id="closing_station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;to_char(to_date('01.01.1970''dd.mm.yyyy') + (wo_header.closing_date+729)) closing_date" id="closing_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (forecast.expected_date+729)) expected_date,
wo_header.event_perfno_i,
    CASE 
                WHEN forecast.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (wo_transfer.absolute_due_date+729), 'dd.Mm.yyyy')
                WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.absolute_due_at_ac))
                ELSE  
                        TO_CHAR(FLOOR (TO_NUMBER(dim.abs_due_at)/60))||':'
                        ||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(dim.abs_due_at), 60)))&lt;10
                        THEN '0'||(TO_CHAR(MOD(TO_NUMBER(dim.abs_due_at), 60)))
                        ELSE (TO_CHAR(MOD(TO_NUMBER(dim.abs_due_at), 60)))
                        END       
    END  super_due_at,
forecast.dimension,
    CASE 
                WHEN forecast.dimension = 'D' THEN TO_CHAR(TRUNC(TO_NUMBER((forecast.togo)/60)/24)) 
                WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.togo))
                ELSE  
                        TO_CHAR(FLOOR (TO_NUMBER(forecast.togo)/60))||':'
                        ||CASE WHEN (TO_CHAR(MOD(TO_NUMBER(forecast.togo), 60)))&lt;10
                        THEN '0'||(TO_CHAR(MOD(TO_NUMBER(forecast.togo), 60)))
                        ELSE (TO_CHAR(MOD(TO_NUMBER(forecast.togo), 60)))
                        END       
    END  super_togo,
TO_NUMBER(forecast.interval_value) || forecast.dimension as Interval,
wo_event_link.event_name,
wo_event_link.event_display,
wo_event_link.event_status,
wo_event_link.revision,
event_effectivity.title as effectivity,
wo_header.ac_registr,
wo_header.comp_partno ||'/'|| wo_header.comp_serialno AS Rotable,
wo_header.ext_workorderno,
wo_transfer.treq_interval_groupno_i,
DECODE(wo_event_link.event_type, 
		'DOC_EFF', 'Document',
		'CHTI', 'Check',
		'TCEFFLI', 'Taskcard ',
		'RORE', 'Rptables') AS event_type_s,
wp_header.wpno,
aircraft.ac_typ,
aircraft.ac_group,
doc_creator.creator_doc AS responsible,
sign_doc.firstname||' '||sign_doc.lastname AS FIO,
department_doc.department||' '||department_doc.description AS DEPT,
wo_header.release_station AS closing_station,
to_char(to_date('01.01.1970', 'dd.mm.yyyy') + (wo_header.closing_date+729)) closing_date
FROM  wo_event_link
LEFT JOIN wo_header ON wo_event_link.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN forecast ON wo_header.event_perfno_i = forecast.event_perfno_i
LEFT JOIN wp_assignment ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN wp_header ON wp_assignment.wpno_i = wp_header.wpno_i
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN event_effectivity_link ON wo_event_link.effectivity_linkno_i = event_effectivity_link.effectivity_linkno_i
LEFT JOIN event_effectivity ON event_effectivity_link.effectivityno_i = event_effectivity.effectivityno_i
LEFT JOIN wo_transfer ON wo_header.event_perfno_i = wo_transfer.event_perfno_i
LEFT JOIN (
                    SELECT     wo_transfer_dimension.event_transferno_i,
                    MAX (wo_transfer_dimension.due_at) AS abs_due_at
                    FROM wo_transfer_dimension
                    GROUP BY wo_transfer_dimension.event_transferno_i
           ) dim ON wo_transfer.event_transferno_i = dim.event_transferno_i
LEFT JOIN   (
                SELECT  worktemplate_link.event_key AS key
                        ,event_template.created_by AS creator_doc
                FROM    worktemplate_link
                LEFT JOIN event_template ON worktemplate_link.wtno_i=event_template.wtno_i AND event_template.revision_status = '1'
                WHERE worktemplate_link.event_type = 'DO'
            ) doc_creator ON wo_event_link.event_key_root = doc_creator.key AND (wo_event_link.event_type = 'DOC_EFF' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MED' AND '@AMOS_VERSION@' NOT LIKE '19.12%')
LEFT JOIN sign sign_doc ON doc_creator.creator_doc = sign_doc.user_sign
LEFT JOIN department department_doc ON sign_doc.department = department_doc.department
WHERE wo_event_link.pending_status = '0'
AND wo_header.state = 'C'
AND aircraft.status &lt;&gt; '9'
AND (wo_event_link.event_type = 'DOC_EFF' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MED' AND '@AMOS_VERSION@' NOT LIKE '19.12%')
AND aircraft.ac_typ = 'B777'
AND wo_event_link.planable_status = '0'
AND wo_transfer.is_last_transfer = 'Y'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
