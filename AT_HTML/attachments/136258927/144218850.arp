  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="BOOL" description="" id="NO_R"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="order_date_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="TSTATE"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="order_date_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="TORDER"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="3.Positions without R-Orders" id="NO_R">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
