        <attribute name="border-left-color">000000</attribute>
        <attribute name="border-bottom-width">0</attribute>
        <attribute name="border-bottom-style">SOLID</attribute>
        <attribute name="border-bottom-color">000000</attribute>
        <attribute name="border-right-width">0</attribute>
        <attribute name="border-right-style">SOLID</attribute>
        <attribute name="border-right-color">000000</attribute>
      </border>
      <attribute name="text">   </attribute>
      <attribute name="text-decoration">NONE</attribute>
      <attribute name="font">SansSerif PLAIN 10</attribute>
      <attribute name="text-align">TOP_LEFT</attribute>
      <attribute name="line-break">AS_IS</attribute>
      <attribute name="splitable">NO</attribute>
      <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
      <attribute name="antialias">false</attribute>
    </view>
  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="MATCL" description="Класс материала / &quot;Material Class&quot;" id="mat_class"/>
        <ds:columnDescriptor amosType="PA" description="Партийный номер / &quot;Part Number&quot;" id="partno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Material Class" id="mat_class">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="Partno" id="partno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="198_AlternativePNWithDiffUnits" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>main DS</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(order by p.partno) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="x.partno" id="x.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when p2.mat_class = 'R'&#10;                then 'Rotable' &#10;            when p2.mat_class = 'C'&#10;                then 'Consumable' &#10;            when p2.mat_class = 'E'&#10;                then 'Expendable'&#10;            when p2.mat_class ='S'&#10;                then 'Service'&#10;      else p2.mat_class&#10;      end mat_class" id="mat_class"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mu.description" id="mu.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="altpartno" id="altpartno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when p2.mat_class = 'R'&#10;                then 'Rotable' &#10;            when p2.mat_class = 'C'&#10;                then 'Consumable' &#10;            when p2.mat_class = 'E'&#10;                then 'Expendable'&#10;            when p2.mat_class ='S'&#10;                then 'Service'&#10;      else p2.mat_class &#10;      end mat_class_2" id="mat_class_2"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mu2.description" id="mu2.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="way" id="way"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.partno@">
          <ds:object>@VAR.partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.mat_class@">
          <ds:object>@VAR.mat_class@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select row_number() over(order by p.partno) num
     , x.partno
     , case when p.mat_class = 'R'
                then 'Rotable' 
            when p.mat_class = 'C'
                then 'Consumable' 
            when p.mat_class = 'E'
                then 'Expendable'
            when p.mat_class ='S'
                then 'Service'
      else p.mat_class
      end mat_class
     , mu.description
     , altpartno
     , case when p2.mat_class = 'R'
                then 'Rotable' 
            when p2.mat_class = 'C'
                then 'Consumable' 
            when p2.mat_class = 'E'
                then 'Expendable'
            when p2.mat_class ='S'
                then 'Service'
      else p2.mat_class 
      end mat_class_2
     , mu2.description
     , way
  from (
        select partno
             , altpartno
             , ' &lt;-&gt; ' way
          from ( 
                select a.partno
                     , a.altpartno
                     , b.partno p2
                     , b.altpartno a2
                     , p.partseqno_i seq_a
                     , p2.partseqno_i seq_p
                  from part_alternate a
                  join part_alternate b on a.altpartno = b.partno 
                                       and b.altpartno = a.partno
                  join part p on a.partno = p.partno
                  join part p2 on b.partno = p2.partno
                 where b.partno is not null
                   and ( p2.partno is null or p.partseqno_i &lt; p2.partseqno_i)
                ) a
         union
        select a.partno
             , a.altpartno
             , ' -&gt; ' way
          from part_alternate a
          left join part_alternate b on a.altpartno = b.partno
         where b.partno is null
       ) x
  join part p on x.partno = p.partno
  join measure_unit mu on p.measure_unit = mu.measure_unit
  join part p2 on x.altpartno = p2.partno
  join measure_unit mu2 on p2.measure_unit = mu2.measure_unit
 where p.measure_unit &lt;&gt; p2.measure_unit
   and /* Partno */
   ( ('@VAR.partno@' is null or
		 p.partno in
		 (select trim(substr('@VAR.partno@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.partno@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.partno@') -
					  length(replace('@VAR.partno@', ',', '')) + 1))
     or ('@VAR.partno@' is null or
		 p2.partno in
		 (select trim(substr('@VAR.partno@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.partno@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.partno@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.partno@') -
					  length(replace('@VAR.partno@', ',', '')) + 1))
   )
   and /* Mat Class */
     ('@VAR.mat_class@' is null or
		 p.mat_class in
		 (select trim(substr('@VAR.mat_class@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.mat_class@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.mat_class@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.mat_class@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.mat_class@') -
					  length(replace('@VAR.mat_class@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
