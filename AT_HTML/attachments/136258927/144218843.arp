  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="state"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_to"/>
        <ds:columnDescriptor amosType="DATE_INT" description="" id="date_from"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="3.Order state:" id="state">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>C&amp;=&amp;Close;O&amp;=&amp;Open;ALL&amp;=&amp;All;</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="2.Date to:" id="date_to">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
        <ds:value amosType="NONE" description="1.Date from:" id="date_from">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="ORDERS_LIST" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.orderno AS orderno" id="orderno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.state@">
          <ds:object>@VAR.state@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_from@">
          <ds:object>@VAR.date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date_to@">
          <ds:object>@VAR.date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT od_header.orderno AS orderno
FROM od_header
WHERE
od_header.order_type = 'R'
AND
(
(od_header.ext_state = 'O' AND '@VAR.state@' = 'O')
OR 
(od_header.ext_state = 'C' AND '@VAR.state@' = 'C')
OR 
(od_header.ext_state IN ('O', 'C') AND '@VAR.state@' = 'ALL' )
)
AND od_header.orderdate&gt;='@VAR.date_from@'
AND od_header.orderdate&lt;='@VAR.date_to@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="r_order" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="oh.order_type" id="oh.order_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="oh.ext_orderno" id="oh.ext_orderno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="typ.description" id="typ.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="adr_details.address||' '||adr_details.address_1 as address_to" id="address_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="adr_detail_afl.address||' '||adr_detail_afl.address_1 as address_afl" id="address_afl"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="adr_afl.name as vendor_from" id="vendor_from"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="adr_to.name as vendor_to" id="vendor_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="adr_to.contact_name as contact_name_to" id="contact_name_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="adr_afl.contact_name AS contact_name_afl" id="contact_name_afl"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tel_to.communication_number as tel_to" id="tel_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="fax_to.communication_number as fax_to" id="fax_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mail_to.communication_number as mail_to" id="mail_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sita_to.communication_number as sita_to" id="sita_to"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="tel_afl.communication_number as tel_afl" id="tel_afl"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="fax_afl.communication_number as fax_afl" id="fax_afl"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mail_afl.communication_number as mail_afl" id="mail_afl"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sita_afl.communication_number as sita_afl" id="sita_afl"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       TO_CHAR(TO_DATE('01.01.1970''DD.MM.YYYY') + (oh.orderdate+729)'DD.MM.YYYY') as orderdate" id="orderdate"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       dbms_lob.substr(oh.header_remarks3001) as remark" id="remark"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.firstname || ' ' || sign.lastname as name" id="name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description=" &#10;       LISTAGG (dl.description'') WITHIN GROUP (ORDER BY dl.source_pk) as text" id="text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@ORDERS_LIST.orderno@">
          <ds:object>@ORDERS_LIST.orderno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT oh.order_type,
       oh.ext_orderno,
       typ.description,
       adr_details.address||' '||adr_details.address_1 as address_to,
	adr_detail_afl.address||' '||adr_detail_afl.address_1 as address_afl,
       adr_afl.name as vendor_from,
       adr_to.name as vendor_to,
	adr_to.contact_name as contact_name_to,
adr_afl.contact_name AS contact_name_afl,
       tel_to.communication_number as tel_to,
       fax_to.communication_number as fax_to,
       mail_to.communication_number as mail_to,
       sita_to.communication_number as sita_to,
       tel_afl.communication_number as tel_afl,
       fax_afl.communication_number as fax_afl,
       mail_afl.communication_number as mail_afl,
       sita_afl.communication_number as sita_afl,
       TO_CHAR(TO_DATE('01.01.1970','DD.MM.YYYY') + (oh.orderdate+729),'DD.MM.YYYY') as orderdate,
       dbms_lob.substr(oh.header_remarks,300,1) as remark,
       sign.firstname || ' ' || sign.lastname as name, 
       LISTAGG (dl.description,', ') WITHIN GROUP (ORDER BY dl.source_pk) as text
FROM od_header oh 
JOIN od_order_type typ ON typ.order_type = oh.order_type 
LEFT JOIN address adr_afl ON adr_afl.vendor = oh.address_issue 
LEFT JOIN address adr_to ON adr_to.vendor = oh.vendor 
LEFT JOIN adr_details ON adr_to.address_i = adr_details.address_i
LEFT JOIN adr_details adr_detail_afl ON adr_afl.address_i = adr_detail_afl.address_i
LEFT JOIN adr_communication_type act_p ON act_p.code='P' 
LEFT JOIN adr_communication_type act_f ON act_f.code='F' 
LEFT JOIN adr_communication_type act_e ON act_e.code='E' 
LEFT JOIN adr_communication_type act_s ON act_s.code='S' 
LEFT JOIN adr_communication tel_to ON tel_to.address_i = adr_to.address_i AND tel_to.communication_type_i = act_p.communication_type_i AND tel_to.is_main = 'Y' 
LEFT JOIN adr_communication fax_to ON fax_to.address_i = adr_to.address_i AND fax_to.communication_type_i = act_f.communication_type_i AND fax_to.is_main = 'Y' 
LEFT JOIN adr_communication mail_to ON mail_to.address_i = adr_to.address_i AND mail_to.communication_type_i = act_e.communication_type_i AND mail_to.is_main = 'Y' 
LEFT JOIN adr_communication sita_to ON sita_to.address_i = adr_to.address_i AND sita_to.communication_type_i = act_s.communication_type_i AND sita_to.is_main = 'Y' 
LEFT JOIN adr_communication tel_afl ON tel_afl.address_i = adr_afl.address_i AND tel_afl.communication_type_i = act_p.communication_type_i AND tel_afl.is_main = 'Y' 
LEFT JOIN adr_communication fax_afl ON fax_afl.address_i = adr_afl.address_i AND fax_afl.communication_type_i = act_f.communication_type_i AND fax_afl.is_main = 'Y' 
LEFT JOIN adr_communication mail_afl ON mail_afl.address_i = adr_afl.address_i AND mail_afl.communication_type_i = act_e.communication_type_i AND mail_afl.is_main = 'Y' 
LEFT JOIN adr_communication sita_afl ON sita_afl.address_i = adr_afl.address_i AND sita_afl.communication_type_i = act_s.communication_type_i AND sita_afl.is_main = 'Y' 
LEFT JOIN (SELECT distinct(det.projectno), det.orderno_i 
           FROM od_detail det
           LEFT JOIN od_header head ON head.orderno_i = det.orderno_i
           WHERE head.orderno = '@ORDERS_LIST.orderno@') det ON det.orderno_i = oh.orderno_i 
LEFT JOIN project pr ON pr.projectno = det.projectno 
LEFT JOIN db_link dl ON dl.source_pk = pr.projectno_i AND dl.source_type = 'PR' AND dbms_lob.substr(dl.link_remarks,30,1) = 'НОМЕР ДОГОВОРА КАСУД'  
LEFT JOIN sign ON sign.user_sign = oh.master_sign  
WHERE orderno = '@ORDERS_LIST.orderno@'
GROUP BY oh.order_type, 
         oh.ext_orderno,
         typ.description,
         adr_afl.name ,
         adr_to.name,
         tel_to.communication_number,
         fax_to.communication_number,
         mail_to.communication_number,
         sita_to.communication_number,
         tel_afl.communication_number,
         fax_afl.communication_number,
         mail_afl.communication_number,
         sita_afl.communication_number,
         oh.priority,
         oh.orderdate,
         dbms_lob.substr(oh.header_remarks,300,1),
         sign.firstname,
         sign.lastname,
  adr_details.address,
	adr_detail_afl.address,
	adr_to.contact_name,
adr_afl.contact_name,
adr_details.address_1,
adr_detail_afl.address_1</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="R_header_text" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="od_header.header_text   AS text" id="text"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@ORDERS_LIST.orderno@">
          <ds:object>@ORDERS_LIST.orderno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
od_header.header_text   AS text
FROM od_header
WHERE od_header.orderno =  '@ORDERS_LIST.orderno@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_R_Priority" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="distinct(det.priority) as priority" id="priority"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@ORDERS_LIST.orderno@">
          <ds:object>@ORDERS_LIST.orderno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT distinct(det.priority) as priority
FROM od_header oh
LEFT JOIN od_detail det ON det.orderno_i = oh.orderno_i
JOIN od_priority op ON op.priority = det.priority
WHERE oh.orderno = '@ORDERS_LIST.orderno@'
AND op.priority_level = (
SELECT MAX(p.priority_level)
FROM od_header h
LEFT JOIN od_detail d ON d.orderno_i = h.orderno_i
JOIN od_priority p ON p.priority = d.priority
WHERE h.orderno = '@ORDERS_LIST.orderno@')</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RO_tab" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="det.posno as nom" id="nom"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det.partno as partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part.description as description" id="description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det.qty as qty" id="qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det.serialno as serialno" id="serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det.purch_price as unit_price" id="unit_price"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det.amount as total_price" id="total_price"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="oh.currency as cur" id="cur"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det.detail_remarks AS STP" id="STP"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det.ac_registr as ac" id="ac"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="det.detail_remarks as ref" id="ref"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;       DECODE(&#10;          det.confirmed_date&#10;          0&#10;          null&#10;          TO_CHAR(&#10;             TO_DATE(&#10;                '01.01.1970'&#10;                'DD.MM.YYYY'&#10;             ) + (det.confirmed_date+729)'DD.MM.YYYY'&#10;          )&#10;       ) as delivery" id="delivery"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@ORDERS_LIST.orderno@">
          <ds:object>@ORDERS_LIST.orderno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT det.posno as nom,
       det.partno as partno,
       part.description as description,
       det.qty as qty,
       det.serialno as serialno,
       det.purch_price as unit_price,
       det.amount as total_price,
       oh.currency as cur,
det.detail_remarks AS STP,
       det.ac_registr as ac,
       det.detail_remarks as ref,
       DECODE(
          det.confirmed_date,
          0,
          null,
          TO_CHAR(
             TO_DATE(
                '01.01.1970',
                'DD.MM.YYYY'
             ) + (det.confirmed_date+729),
             'DD.MM.YYYY'
          )
       ) as delivery 
FROM od_header oh 
LEFT JOIN od_detail det ON det.orderno_i = oh.orderno_i 
JOIN part ON part.partno = det.partno 
WHERE orderno = '@ORDERS_LIST.orderno@' 
ORDER BY det.posno</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="R_total" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="oh.currency as cur" id="cur"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="SUM(det.amount) as total" id="total"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@ORDERS_LIST.orderno@">
          <ds:object>@ORDERS_LIST.orderno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT  oh.currency as cur, SUM(det.amount) as total
FROM od_header oh
LEFT JOIN od_detail det ON det.orderno_i = oh.orderno_i
WHERE orderno = '@ORDERS_LIST.orderno@'
GROUP BY oh.currency</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
