    <view class="LabelReportView" id="2440">
      <attribute name="name">Label_7</attribute>
      <attribute name="position">138 7</attribute>
      <attribute name="size">421 47</attribute>
      <attribute name="visible">YES</attribute>
      <attribute name="auto-resize">NO</attribute>
      <attribute name="rotation">0.0</attribute>
      <conditional_attributes>
        <conditional_attribute id="1">
          <attribute name="text">@PARAMETERS.ORDER_NUMBER_TO_DISPLAY@ AOG</attribute>
          <conditions>
            <condition class="GenericStyleCondition">
              <field id="1">@ORDER.PRIORITY_CODE@</field>
              <field id="2">AOG</field>
              <operator negated="NO">EQUALS</operator>
            </condition>
            <condition class="GenericStyleCondition">
              <field id="1">@PARAMETERS.AOG_SUFFIX@</field>
              <field id="2">Y</field>
              <operator negated="NO">EQUALS</operator>
            </condition>
          </conditions>
        </conditional_attribute>
      </conditional_attributes>
      <attribute name="color">000000</attribute>
      <attribute name="margin">0 0 0 0</attribute>
      <attribute name="padding">0 0 0 0</attribute>
      <attribute name="border">2 SOLID 000000</attribute>
      <attribute name="text">REPAIR ORDER № @ORDERS_LIST.orderno@</attribute>
      <attribute name="text-decoration">NONE</attribute>
      <attribute name="font">SansSerif PLAIN 25</attribute>
