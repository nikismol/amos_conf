    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="296_List_of_booking" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ as AC_Type" id="AC_Type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (history.del_date)'DD.MM.YYYY') as b_date" id="b_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="voucher.description || ' - ' ||history.vm AS booking" id="booking"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno" id="history.partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN history.mat_class = 'R' OR history.serialno &lt;&gt; ' ' THEN history.serialno &#10;&#9;ELSE history.batchno &#10;&#9;END as sn_bn" id="sn_bn"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.condition AS CO" id="CO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ|| ' - ' ||history.ac_registr AS AC" id="AC"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.qty" id="history.qty"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.receiver AS Ord_rec" id="Ord_rec"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.voucherno" id="history.voucherno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_partno@">
          <ds:object>@VAR.v03_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_serialno@">
          <ds:object>@VAR.v04_serialno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_batcno@">
          <ds:object>@VAR.v05_batcno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v06_aicraft@">
          <ds:object>@VAR.v06_aicraft@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v07_vm@">
          <ds:object>@VAR.v07_vm@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v08_date_from@">
          <ds:object>@VAR.v08_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v09_date_to@">
          <ds:object>@VAR.v09_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	aircraft.ac_typ as AC_Type,
	TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (history.del_date), 'DD.MM.YYYY') as b_date, 
	voucher_mode.description || ' - ' ||history.vm AS booking,
 	history.partno,
	CASE WHEN history.mat_class = 'R' OR history.serialno &lt;&gt; ' ' THEN history.serialno 
	ELSE history.batchno 
	END as sn_bn,
	history.condition AS CO,
	history.ac_registr AS AC,
	history.qty,
	history.orderno AS Ord_rec,
	history.voucherno
FROM history
	JOIN entity_header ON history.entityno_i = entity_header.entityno_i
	JOIN voucher_mode ON  history.vm=voucher_mode.vm
	LEFT JOIN aircraft ON history.ac_registr=aircraft.ac_registr
WHERE 1=1
	AND history.partno = '@VAR.v03_partno@'
	AND (REGEXP_LIKE(history.serialno, REPLACE('@VAR.v04_serialno@', ', ', '|')) OR '@VAR.v04_serialno@' IS NULL)
	AND (REGEXP_LIKE(history.batchno, REPLACE('@VAR.v05_batcno@', ', ', '|')) OR '@VAR.v05_batcno@' IS NULL)
	AND (history.ac_registr = '@VAR.v06_aicraft@' OR '@VAR.v06_aicraft@' IS NULL)
	AND (history.vm = '@VAR.v07_vm@' OR '@VAR.v07_vm@' IS NULL)
	AND (history.del_date &gt;= '@VAR.v08_date_from@' OR '@VAR.v08_date_from@' IS NULL)
	AND (history.del_date &lt;= '@VAR.v09_date_to@' OR '@VAR.v09_date_to@' IS NULL)
ORDER BY history.del_date DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="296_Technival_View" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ AS AC_TYP" id="AC_TYP"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(TO_DATE('31.12.1971' 'DD.MM.YYYY') + (history.del_date)'DD.MM.YYYY') as b_date" id="b_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="voucher_mode.description || ' - ' ||history.vm AS booking" id="booking"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.reason AS US_SD" id="US_SD"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.partno AS partno" id="partno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN history.mat_class = 'R'&#10;       OR history.serialno &lt;&gt; ' ' THEN history.serialno ELSE history.batchno END SN_BN" id="SN_BN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.condition AS CO" id="CO"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn)60))'FM00') as TSN" id="TSN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi)60))'FM00') as TBI" id="TBI"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.csn AS CSN" id="CSN"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.cbi AS CBI" id="CBI"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.ac_registr AS AC" id="AC"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.tam)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.tam)60))'FM00') as TAH" id="TAH"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.tac AS TAC" id="TAC"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.event_perfno_i AS WO_JC" id="WO_JC"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.labelno AS label" id="label"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="history.location AS posit" id="posit"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_partno@">
          <ds:object>@VAR.v03_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_serialno@">
          <ds:object>@VAR.v04_serialno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v05_batcno@">
          <ds:object>@VAR.v05_batcno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v06_aicraft@">
          <ds:object>@VAR.v06_aicraft@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v07_vm@">
          <ds:object>@VAR.v07_vm@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v08_date_from@">
          <ds:object>@VAR.v08_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v09_date_to@">
          <ds:object>@VAR.v09_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT 
	aircraft.ac_typ AS AC_TYP,
	TO_CHAR(TO_DATE('31.12.1971', 'DD.MM.YYYY') + (history.del_date), 'DD.MM.YYYY') as b_date, 
	voucher_mode.description || ' - ' ||history.vm AS booking,
	history.reason AS US_SD,
	history.partno AS partno,
	CASE WHEN history.mat_class = 'R' OR history.serialno &lt;&gt; ' ' THEN history.serialno 
		ELSE history.batchno 
	END SN_BN,
	history.condition AS CO,
TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.msn)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.msn),60)),'FM00') as TSN,
	TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.mbi)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.mbi),60)),'FM00') as TBI, 
	history.csn AS CSN,
	history.cbi AS CBI,
	history.ac_registr AS AC,
	TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(history.tam)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(history.tam),60)),'FM00') as TAH,
	history.tac AS TAC,
	history.event_perfno_i AS WO_JC,
	history.labelno AS label,
	history.location AS posit
FROM history
	JOIN entity_header ON history.entityno_i = entity_header.entityno_i
	JOIN voucher_mode ON  history.vm=voucher_mode.vm
	LEFT JOIN aircraft ON history.ac_registr=aircraft.ac_registr
WHERE 
	history.partno= '@VAR.v03_partno@'
	AND (REGEXP_LIKE(history.serialno, REPLACE('@VAR.v04_serialno@', ', ', '|')) OR '@VAR.v04_serialno@' IS NULL)
	AND (REGEXP_LIKE(history.batchno, REPLACE('@VAR.v05_batcno@', ', ', '|')) OR '@VAR.v05_batcno@' IS NULL)
	AND (history.ac_registr = '@VAR.v06_aicraft@' OR '@VAR.v06_aicraft@' IS NULL)
	AND (history.vm = '@VAR.v07_vm@' OR '@VAR.v07_vm@' IS NULL)
	AND (history.del_date &gt;= '@VAR.v08_date_from@' OR '@VAR.v08_date_from@' IS NULL)
	AND (history.del_date &lt;= '@VAR.v09_date_to@' OR '@VAR.v09_date_to@' IS NULL)
ORDER BY history.del_date DESC</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Technival_View_tso" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="NVL(&#10;                          CASE WHEN tsn_unknown='Y' OR oh_tsn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(msn - NVL(msn_oh 0))/60)'FM999999999900')) || ':' &#10;                                     ||TO_CHAR(TRUNC(MOD(TO_NUMBER(msn - NVL(msn_oh 0))60))'FM00') END&#10;                                     'UNK') as TSO" id="TSO"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_partno@">
          <ds:object>@VAR.v03_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_serialno@">
          <ds:object>@VAR.v04_serialno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v07_vm@">
          <ds:object>@VAR.v07_vm@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v08_date_from@">
          <ds:object>@VAR.v08_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v09_date_to@">
          <ds:object>@VAR.v09_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT NVL(
                          CASE WHEN tsn_unknown='Y' OR oh_tsn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(msn - NVL(msn_oh, 0))/60),'FM999999999900')) || ':' 
                                     ||TO_CHAR(TRUNC(MOD(TO_NUMBER(msn - NVL(msn_oh, 0)),60)),'FM00') END
                                     , 'UNK') as TSO
               FROM (
                            SELECT              
                                          NVL(h_assy_oh.historyno_i, h_assy.historyno_i) as oh_historyno_i,
                                          max(NVL(h_assy_oh.historyno_i, h_assy.historyno_i)) over (partition by 1) as max_oh_historyno_i,      
                                          h_assy.msn,
                                          h_assy.csn,
                                          NVL(h_assy_oh.msn, 0) as msn_oh,
                                          NVL(h_assy_oh.csn, 0) as csn_oh,
                                          h_assy.tsn_unknown,
                                          h_assy.csn_unknown,
                                          NVL(h_assy_oh.tsn_unknown, 'N') as oh_tsn_unknown,
                                          NVL(h_assy_oh.csn_unknown, 'N') as oh_csn_unknown 
                            FROM history h_assy
                            LEFT JOIN history h_assy_oh ON h_assy.psn=h_assy_oh.psn AND h_assy_oh.vm in ('B1', 'B7') AND h_assy_oh.condition='OH' AND h_assy_oh.historyno_i&lt;h_assy.historyno_i 
                            WHERE 1=1
                                           AND h_assy.partno = '@VAR.v03_partno@'
                                           AND (REGEXP_LIKE(h_assy.serialno, REPLACE('@VAR.v04_serialno@', ', ', '|')) OR '@VAR.v04_serialno@' IS NULL)
                                           AND (h_assy.vm  = '@VAR.v07_vm@' OR '@VAR.v07_vm@' IS NULL)
                                           AND (h_assy.del_date &gt;= '@VAR.v08_date_from@' OR '@VAR.v08_date_from@' IS NULL)
                                           AND (h_assy.del_date &lt;= '@VAR.v09_date_to@' OR '@VAR.v09_date_to@' IS NULL)
                           )
               WHERE 1=1
                             AND max_oh_historyno_i = oh_historyno_i
            </se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Technival_View_CSO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="NVL(&#10;                         CASE WHEN csn_unknown='Y' OR oh_csn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_NUMBER(csn - NVL(csn_oh 0))) END&#10;                                      'UNK') as CSO" id="CSO"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v03_partno@">
          <ds:object>@VAR.v03_partno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v04_serialno@">
          <ds:object>@VAR.v04_serialno@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v07_vm@">
          <ds:object>@VAR.v07_vm@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v08_date_from@">
          <ds:object>@VAR.v08_date_from@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v09_date_to@">
          <ds:object>@VAR.v09_date_to@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT NVL(
                         CASE WHEN csn_unknown='Y' OR oh_csn_unknown='Y' THEN 'UNK' ELSE TO_CHAR(TO_NUMBER(csn - NVL(csn_oh, 0))) END
                                      , 'UNK') as CSO
FROM (
               SELECT     
                            NVL(h_assy_oh.historyno_i, h_assy.historyno_i) as oh_historyno_i,
                            max(NVL(h_assy_oh.historyno_i, h_assy.historyno_i)) over (partition by 1) as max_oh_historyno_i,      
                            h_assy.msn,
                            h_assy.csn,
                            NVL(h_assy_oh.msn, 0) as msn_oh,
                            NVL(h_assy_oh.csn, 0) as csn_oh,
                            h_assy.tsn_unknown,
                            h_assy.csn_unknown,
                            NVL(h_assy_oh.tsn_unknown, 'N') as oh_tsn_unknown,
                            NVL(h_assy_oh.csn_unknown, 'N') as oh_csn_unknown 
               FROM history h_assy
                            LEFT JOIN history h_assy_oh ON h_assy.psn=h_assy_oh.psn AND h_assy_oh.vm in ('B1', 'B7') AND h_assy_oh.condition='OH' AND h_assy_oh.historyno_i&lt;h_assy.historyno_i 
              WHERE 1=1
                                 AND h_assy.partno = '@VAR.v03_partno@'
                                 AND (REGEXP_LIKE(h_assy.serialno, REPLACE('@VAR.v04_serialno@', ', ', '|')) OR '@VAR.v04_serialno@' IS NULL)
                                 AND (h_assy.vm  = '@VAR.v07_vm@' OR '@VAR.v07_vm@' IS NULL)
                                 AND (h_assy.del_date &gt;= '@VAR.v08_date_from@' OR '@VAR.v08_date_from@' IS NULL)
                                 AND (h_assy.del_date &lt;= '@VAR.v09_date_to@' OR '@VAR.v09_date_to@' IS NULL)  
            )
WHERE 1=1
              AND max_oh_historyno_i = oh_historyno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
