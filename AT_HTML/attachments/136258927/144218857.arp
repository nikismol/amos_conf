    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="221_RMX_SERVICE_AND_ PROTECTION" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_model" id="aircraft.ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.taskcardno as taskcardno" id="taskcardno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="msc_taskcard.title" id="msc_taskcard.title"/>
        <ds:columnDescriptor amosType="DATE" description="wo_header.closing_date" id="wo_header.closing_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.hidden" id="wp_header.hidden"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.mech_sign" id="wo_header.mech_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="sign.department" id="sign.department"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="ROUND(mhrs_requested.request_minutes/602) as planned_dec" id="planned_dec"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(trunc(sysdate) + mhrs_requested.request_minutes/24/60'hh24:mi') as planned_hrs" id="planned_hrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="mhrs_requested.woc as classification" id="classification"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_captured.scope as scope" id="scope"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="time_captured.qualification as skill" id="skill"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@AMOS_VERSION@">
          <ds:object>@AMOS_VERSION@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ac_typ@">
          <ds:object>@VAR.ac_typ@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.classif@">
          <ds:object>@VAR.classif@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.start_date@">
          <ds:object>@VAR.start_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end_date@">
          <ds:object>@VAR.end_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.department@">
          <ds:object>@VAR.department@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select aircraft.ac_typ,
           aircraft.ac_model,
           msc_taskcard.taskcardno as taskcardno,
           msc_taskcard.title,
           wo_header.closing_date,
           wp_header.wpno,
           wp_header.hidden,
           wo_header.mech_sign,
           sign.department
           ,ROUND(mhrs_requested.request_minutes/60, 2) as planned_dec
           ,to_char(trunc(sysdate) + mhrs_requested.request_minutes/24/60, 'hh24:mi') as planned_hrs
           ,mhrs_requested.woc as classification
           ,time_captured.scope as scope
           ,time_captured.qualification as skill
from msc_taskcard
join msc_taskcard_version on msc_taskcard_version.taskcardno_i=msc_taskcard.taskcardno_i
join msc_requirement_tc_link on msc_requirement_tc_link.taskcard_verno_i_mri = msc_taskcard_version.taskcard_verno_i
join wo_event_link on wo_event_link.event_key_parent = msc_requirement_tc_link.req_linkno_i and (wo_event_link.event_type = 'TCEFFLI' AND '@AMOS_VERSION@' LIKE '19.12%' OR wo_event_link.event_type = 'MET' AND '@AMOS_VERSION@' NOT LIKE '19.12%') and wo_event_link.pending_status &lt; 0
join wo_header on wo_event_link.event_perfno_i = wo_header.event_perfno_i
join aircraft on wo_header.ac_registr=aircraft.ac_registr
join wp_assignment on wo_header.event_perfno_i=wp_assignment.event_perfno_i
join wp_header on wp_assignment.wpno_i=wp_header.wpno_i
join sign on wo_header.mech_sign=sign.user_sign
LEFT JOIN (
                    SELECT wo_header.event_perfno_i,
                                  wo_header_4.event_classification as woc,
                                  SUM(rm_resource_requirement.total_hours) as request_minutes
                    FROM wo_header
                    LEFT JOIN wo_header_4 ON wo_header_4.event_perfno_i = wo_header.event_perfno_i
                    LEFT JOIN workstep_link ON workstep_link.event_perfno_i = wo_header.event_perfno_i
                    LEFT JOIN rm_resource_request ON workstep_link.descno_i = rm_resource_request.request_owner_amos_key
                    LEFT JOIN rm_resource_requirement ON rm_resource_requirement.resource_request_noi = rm_resource_request.resource_request_noi
                    GROUP BY wo_header.event_perfno_i, wo_header_4.event_classification
                   ) mhrs_requested ON mhrs_requested.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN time_captured ON wo_header.event_perfno_i = time_captured.primkey AND time_captured.mime_type = 'MET'
where 1=1
            and (
                     aircraft.ac_typ = '@VAR.ac_typ@' /*A32S*/
                     and msc_taskcard.taskcardno IN ('101100-03-AFL',
                                                                              'A20-10-1143-01',
                                                                              'A20-10-1143-02', 
	                                                                'A20-10-1143-03',
                                                                              'A20-10-1152',
                                                                              'A20-10-1152-02',
                                                                              'A20-10-1152-03',
                                                                              'A20-10-1152-04',
                                                                              'A20-10-1152-05',
                                                                              'A20-10-1143-04',
                                                                              'A20-10-1159-03',
                                                                              'A20-10-1159-04',
                                                                              'A20-10-1159-05',
                                                                              'A20-10-1159-06', 
					     'A20-10-1159-01',
					     'A20-10-1159-02', 
					     'A20-10-1159-07', 
					     'A20-10-1159-08', 
					     'A20-10-1159-09'
) 
                    OR
                    aircraft.ac_typ = '@VAR.ac_typ@' /*A330*/
                    and msc_taskcard.taskcardno IN ('101100-01-AFL',
                                                                              '101100-03-AFL',
                                                                              '101100-04-AFL',
                                                                              '101200-09-AFL',
                                                                              '101200-10-AFL',
                                                                              '101100-05-AFL',
                                                                              '101100-06-AFL',
					     '101100-07-AFL', 
					     '101100-08-AFL', 
					     '101200-03-AFL', 
					     '101200-04-AFL',
					     '101200-05-AFL',
					     '101200-01-AFL', 
					     '101200-06-AFL', 
					     '101200-07-AFL', 
					     '101200-09-AFL')
                    OR
                    aircraft.ac_typ = '@VAR.ac_typ@' /*B777*/
                    and msc_taskcard.taskcardno IN ('B3-10-0276-1',
                                                                              'B7-10-0277-1',
                                                                              'B7-10-0277-2',
                                                                              'B7-10-0277-3',
                                                                              'B7-10-0277-6',
                                                                              'B7-10-0277-4',
                                                                              'B7-10-0277-5',
					     'B7-10-0277-7')
	OR 
	aircraft.ac_typ ='@VAR.ac_typ@'/*A350*/
	and msc_taskcard.taskcardno IN ('1011XX-00M02-AFL',
					   '1011XX-00M03-AFL',
					    '1011XX-00M04-AFL', 
					    '1011XX-00M05-AFL',
					    '1011XX-00M06-AFL')
                   )
    and wp_header.station = 'SVO'
    and wp_header.hidden = '@VAR.classif@'
    and wo_header.closing_date &gt;= '@VAR.start_date@'
    and wo_header.closing_date &lt;= '@VAR.end_date@'
    and sign.department = '@VAR.department@'
ORDER BY 1,2,3,5</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="AFL_Date" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="to_char(to_date('01.01.1970' 'DD.MM.YYYY') + (@VAR.start_date@+729)'DD.MM.YYYY') as f_start_date" id="f_start_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;&#9;to_char(to_date('01.01.1970' 'DD.MM.YYYY') + (@VAR.end_date@+729)'DD.MM.YYYY') as f_end_date" id="f_end_date"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.start_date@">
          <ds:object>@VAR.start_date@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.end_date@">
          <ds:object>@VAR.end_date@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select
	to_char(to_date('01.01.1970', 'DD.MM.YYYY') + (@VAR.start_date@+729), 'DD.MM.YYYY') as f_start_date,
	to_char(to_date('01.01.1970', 'DD.MM.YYYY') + (@VAR.end_date@+729), 'DD.MM.YYYY') as f_end_date
from dual</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
