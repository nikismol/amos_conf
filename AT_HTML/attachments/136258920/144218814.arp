            <attribute name="auto-resize">YES</attribute>
            <attribute name="rotation">0.0</attribute>
            <conditional_attributes/>
            <attribute name="color">000000</attribute>
            <attribute name="margin">0 0 0 0</attribute>
            <attribute name="padding">2 0 0 0</attribute>
            <attribute name="border">1 SOLID 000000</attribute>
            <attribute name="text">@INFO.Department@</attribute>
            <attribute name="text-decoration">NONE</attribute>
            <attribute name="font">SansSerif PLAIN 8</attribute>
            <attribute name="text-align">CENTER</attribute>
            <attribute name="line-break">WORD</attribute>
            <attribute name="splitable">NO</attribute>
            <attribute name="trimWhitespaceAroundWildcard">NO</attribute>
            <attribute name="antialias">false</attribute>
          </view>
        </column>
      </column_model>
      <attribute name="data-source">INFO</attribute>
    </view>
  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="" id="ACTYP"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="AC Type:" id="ACTYP">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>A32S&amp;=&amp;A32S;A330&amp;=&amp;A330;A350&amp;=&amp;A350;B737&amp;=&amp;B737;B777&amp;=&amp;B777;RRJ&amp;=&amp;RRJ;</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.event_type AS Event_type" id="Event_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.event||'/'||forecast.event_display AS Event" id="Event"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.requirement AS Requirement" id="Requirement"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.ac_typ AS Ac_typ" id="Ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.ac_registr AS Ac_registr" id="Ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.dimension AS Dimension" id="Dimension"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.event_perfno_i" id="forecast.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;                WHEN forecast.dimension = 'D' THEN TO_CHAR(TRUNC(TO_NUMBER((forecast.togo)/60)/24)) ||' D'&#10;                WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.togo))||' C'&#10;                ELSE  TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.togo)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.togo)60))'FM00') ||' H' &#10;         END AS Togo" id="Togo"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE &#10;&#9;&#9;&#9;&#9;WHEN forecast.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (forecast.absolute_due_at_ac+729) 'dd.Mm.yyyy')&#10;&#9;&#9;&#9;&#9;WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.absolute_due_at_ac))||' C'&#10;&#9;&#9;&#9;&#9;ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.absolute_due_at_ac)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.absolute_due_at_ac)60))'FM00') ||' H' &#10;&#9;&#9; END AS Due_at" id="Due_at"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_DATE('01.01.1970' 'DD.MM.YYYY') + (expected_date+729)'DD.MM.YYYY') Expected_date" id="Expected_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno AS Workpackage" id="Workpackage"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="forecast.workorderno_display AS Workorder" id="Workorder"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN wo_header.issue_sign IS NULL THEN doc_header.created_by ELSE wo_header.issue_sign END AS Sign" id="Sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN wo_header.issue_sign IS NULL THEN sign2.firstname||' '||sign2.lastname ELSE sign.firstname||' '||sign.lastname END AS Name" id="Name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE WHEN wo_header.issue_sign IS NULL THEN sign2.department||' '||department2.description ELSE sign.department||' '||department.description END AS Department" id="Department"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ACTYP@">
          <ds:object>@VAR.ACTYP@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT	 forecast.event_type AS Event_type
		,forecast.event_display AS Event
		,forecast.requirement AS Requirement
		,forecast.ac_typ AS Ac_typ
		,forecast.ac_registr AS Ac_registr 
		,forecast.dimension AS Dimension
        ,forecast.event_perfno_i
		,CASE 
                WHEN forecast.dimension = 'D' THEN TO_CHAR(TRUNC(TO_NUMBER((forecast.togo)/60)/24)) ||' D'
                WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.togo))||' C'
                ELSE  TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.togo)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.togo),60)),'FM00') ||' H' END AS Togo
		,CASE 
				WHEN forecast.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (forecast.absolute_due_at_ac+729), 'dd.Mm.yyyy')
				WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.absolute_due_at_ac))||' C'
				ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.absolute_due_at_ac)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.absolute_due_at_ac),60)),'FM00') ||' H' 
		 END AS Due_at
		,TO_CHAR(TO_DATE('01.01.1970', 'DD.MM.YYYY') + (expected_date+729), 'DD.MM.YYYY') Expected_date
		,wp_header.wpno AS Workpackage
		,forecast.workorderno_display AS Workorder
		,CASE WHEN wo_header.issue_sign IS NULL THEN doc_header.created_by ELSE wo_header.issue_sign END AS Sign
		,CASE WHEN wo_header.issue_sign IS NULL THEN sign2.firstname||' '||sign2.lastname ELSE sign.firstname||' '||sign.lastname END AS Name
		,CASE WHEN wo_header.issue_sign IS NULL THEN sign2.department||' '||department2.description ELSE sign.department||' '||department.description END AS Department
FROM forecast 
LEFT JOIN wo_header ON forecast.event_perfno_i = wo_header.event_perfno_i
LEFT JOIN sign ON wo_header.issue_sign = sign.user_sign
LEFT JOIN department ON sign.department = department.department
LEFT JOIN wp_header ON forecast.wpno_i = wp_header.wpno_i
LEFT JOIN wo_event_link ON wo_event_link.event_perfno_i = forecast.event_perfno_i
LEFT JOIN doc_header ON wo_event_link.event_key_parent = doc_header.docno_i
LEFT JOIN sign sign2 ON doc_header.created_by = sign2.user_sign
LEFT JOIN department department2 ON sign2.department = department2.department
WHERE 
forecast.event_type = 'D'
AND forecast.ac_typ = '@VAR.ACTYP@'
AND  ((forecast.expected_date != 1491308) OR (forecast.calculation_status IN ('E', 'W') AND forecast.expected_date = '-355010'))
AND forecast.wpno_i IS NULL
AND (
(forecast.dimension = 'D' AND TO_CHAR(TRUNC(TO_NUMBER((forecast.togo)/60)/24)) &lt;= 3) OR 
(forecast.dimension = 'H' AND TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.togo)/60),'FM999999999900')) &lt;= 30) OR 
(forecast.dimension = 'C' AND TO_CHAR(TO_NUMBER(forecast.togo)) &lt;= 15) OR
(forecast.dimension NOT IN ('D', 'C', 'H') AND forecast.calculation_status IN ('E', 'W') )
    )
AND forecast.ac_registr NOT IN 
(
    SELECT DISTINCT ac_registr 
    FROM wp_header 
    WHERE 
	(
		TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + (wp_header.end_date), 'dd.mm.yyyy') &gt;= SYSDATE+4
		AND TO_CHAR(TO_DATE('31.12.1971', 'dd.mm.yyyy') + (wp_header.Start_date), 'dd.mm.yyyy') &lt;= SYSDATE
		/* 15-01-2020 
           vtsymbal add new ac_typ A350
        */
		AND '@VAR.ACTYP@' IN ('A32S', 'B777', 'B737', 'A330', 'A350')
	)     OR
	(wp_header.start_date*24*60 + wp_header.start_time &lt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))*(24*60) + TO_CHAR(SYSTIMESTAMP, 'SSSSS')/60
               AND wp_header.end_date*24*60 + wp_header.end_time &gt;= FLOOR(sysdate-to_date('19711231','yyyymmdd'))*(24*60) + TO_CHAR(SYSTIMESTAMP, 'SSSSS')/60 +26*60
	AND  '@VAR.ACTYP@' = 'RRJ')
)
ORDER BY forecast.expected_date</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
