  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="WP" description="" id="wpno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="WP Number" id="wpno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WP_INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Basic Workpackage Information</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno" id="wp_header.wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.station" id="wp_header.station"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.description" id="wp_header.description"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="(a.ac_registr_prefix || a.ac_registr) as ac_registr" id="ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.serialno" id="aircraft.serialno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_model" id="aircraft.ac_model"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.wpno@">
          <ds:object>@VAR.wpno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT
	wp_header.wpno,
	wp_header.station,
	wp_header.description,
	(aircraft.ac_registr_prefix || aircraft.ac_registr) as ac_registr,
	aircraft.serialno,
	aircraft.ac_typ,
	aircraft.ac_model
FROM wp_header
LEFT JOIN aircraft ON wp_header.ac_registr = aircraft.ac_registr
WHERE wp_header.wpno_i='@VAR.wpno@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
