      <attribute name="border">0 SOLID 000000</attribute>
      <attribute name="header-size">0</attribute>
      <attribute name="footer-size">0</attribute>
      <attribute name="orientation">PORTRAIT</attribute>
    </view>
    <content/>
  </page_master>
  <content>
    <view class="BarcodeReportView" id="635">
      <attribute name="name">Barcode_12</attribute>
      <attribute name="position">53 484</attribute>
      <attribute name="size">597 83</attribute>
      <attribute name="visible">YES</attribute>
      <attribute name="auto-resize">NO</attribute>
      <attribute name="rotation">0.0</attribute>
      <conditional_attributes/>
      <attribute name="color">000000</attribute>
      <attribute name="margin">0 0 0 0</attribute>
      <attribute name="padding">5 10 5 10</attribute>
      <attribute name="border">0 SOLID 000000</attribute>
      <attribute name="barcode-content">@Barcode_Workpackage_Aircraft.ac_registr@ @Barcode_Workpackage_Aircraft.wpno@ 0</attribute>
      <attribute name="barcode-type">CODE39</attribute>
      <attribute name="check-character">NO</attribute>
      <attribute name="show-label">YES</attribute>
      <attribute name="font">SansSerif PLAIN 10</attribute>
      <attribute name="text-align">LEFT</attribute>
    </view>
  </content>
  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="WP" description="" id="v01_workpackage"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="01_Workpackage" id="v01_workpackage">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="Barcode_Workpackage_Aircraft" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.wpno as wpno" id="wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wp_header.ac_registr as ac_registr" id="ac_registr"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.v01_workpackage@">
          <ds:object>@VAR.v01_workpackage@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select wp_header.wpno as wpno,
             wp_header.ac_registr as ac_registr
from wp_header
where wp_header.wpno_i='@VAR.v01_workpackage@'</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
