    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_WO_INF" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.issue_sign" id="wo_header.issue_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ATA_CHAPTER" id="wo_header.ATA_CHAPTER"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="DATE" description="&#10;               to_char(to_date('01.01.1970' 'dd.mm.yyyy') + ( wo_header.issue_date+729)'dd.mm.yyyy') as issue_date" id="issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.type" id="wo_header.type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.state" id="wo_header.state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.mel_code" id="wo_header.mel_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header_more.mel_chapter" id="wo_header_more.mel_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_model" id="aircraft.ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="act_text.wa_text" id="act_text.wa_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="desc_text.ws_text" id="desc_text.ws_text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="part_req.req" id="part_req.req"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="used_mhr.mhrs as used_mhrs" id="used_mhrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="planned_mhr.mhrs as planned_mhrs" id="planned_mhrs"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_REG@">
          <ds:object>@VAR.AC_REG@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_TYPE@">
          <ds:object>@VAR.AC_TYPE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ATA@">
          <ds:object>@VAR.ATA@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date1@">
          <ds:object>@VAR.date1@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date2@">
          <ds:object>@VAR.date2@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_STATUS@">
          <ds:object>@VAR.AC_STATUS@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_M@">
          <ds:object>@VAR.WO_TYPE_M@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_C@">
          <ds:object>@VAR.WO_TYPE_C@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_P@">
          <ds:object>@VAR.WO_TYPE_P@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_S@">
          <ds:object>@VAR.WO_TYPE_S@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_ALL@">
          <ds:object>@VAR.WO_TYPE_ALL@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT   
				 wo_header.event_perfno_i
				,wo_header.issue_sign 
				,wo_header.ATA_CHAPTER
				,wo_header.ac_registr
				,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.issue_date+729),'dd.mm.yyyy') as issue_date              
				,wo_header.type
				,wo_header.state
				,wo_header.mel_code
				,wo_header_more.mel_chapter
				,aircraft.ac_typ
				,aircraft.ac_model
				,act_text.wa_text
				,desc_text.ws_text
				,part_req.req
                                                         ,used_mhr.mhrs as used_mhrs
                                                         ,planned_mhr.mhrs as planned_mhrs

FROM wo_header
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN wo_header_4 ON wo_header_more.event_perfno_i = wo_header_4.event_perfno_i
LEFT JOIN 	(
				SELECT workstep_link.event_perfno_i as event_perfno_i,
				RTRIM(XMLAGG(XMLELEMENT(E, wo_text_action.text, '!!!!!').EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as wa_text
				FROM workstep_link
				LEFT JOIN wo_text_description ON workstep_link.descno_i = wo_text_description.descno_i
				LEFT JOIN wo_text_action ON workstep_link.workstep_linkno_i = wo_text_action.workstep_linkno_i
				GROUP BY workstep_link.event_perfno_i
			) act_text ON wo_header.event_perfno_i = act_text.event_perfno_i
LEFT JOIN 	(
				SELECT workstep_link.event_perfno_i as event_perfno_i,
				RTRIM(XMLAGG(XMLELEMENT(E, wo_text_description.text, '!!!!!').EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as ws_text
				FROM workstep_link
				LEFT JOIN wo_text_description ON workstep_link.descno_i=wo_text_description.descno_i
				GROUP BY workstep_link.event_perfno_i
			) desc_text ON wo_header.event_perfno_i = desc_text.event_perfno_i
LEFT JOIN 	(
				SELECT 	workstep_link.event_perfno_i,
                        					RTRIM(XMLAGG(XMLELEMENT(E, part_request_2.partno||'!!!!!'||part.description||'!!!!!'||TO_NUMBER(part_request_2.qty)||' '||part.measure_unit||'!!!!!'||'HBS:'||(CASE WHEN part.reorder IN ('F', 'H') 
						THEN TO_NUMBER(part.reord_level) ELSE TO_NUMBER('') END)||' '||part.measure_unit, ' NEXT REQUEST:').EXTRACT('//text()') ORDER BY workstep_link.sequenceno).GetClobVal(), CHR(10)) as req
				FROM workstep_link
				LEFT JOIN part_request_2 ON workstep_link.workstep_linkno_i=part_request_2.event_key 
				LEFT JOIN part ON part_request_2.partno = part.partno
				GROUP BY workstep_link.event_perfno_i  
			) part_req ON wo_header.event_perfno_i = part_req.event_perfno_i
LEFT JOIN (
                  SELECT TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(SUM(time_captured.duration*time_captured.prod_factor))/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(SUM(time_captured.duration*time_captured.prod_factor)),60)),'FM00') as mhrs,
                                 time_captured.primkey
                   FROM time_captured
                   WHERE 1=1 
                                 AND time_captured.mime_type IN  ('WO', 'MET')
                   GROUP BY time_captured.primkey
                  ) used_mhr ON used_mhr.primkey = wo_header.event_perfno_i  
LEFT JOIN(
                  SELECT TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(SUM(rm_resource_requirement.total_hours))/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(SUM(rm_resource_requirement.total_hours)),60)),'FM00') as mhrs,
                                workstep_link.event_perfno_i
                   FROM rm_resource_requirement
                   LEFT JOIN rm_resource_request ON rm_resource_request.resource_request_noi = rm_resource_requirement.resource_request_noi
                   LEFT JOIN workstep_link ON workstep_link.descno_i = rm_resource_request.request_owner_amos_key
                   GROUP BY workstep_link.event_perfno_i
                  ) planned_mhr ON planned_mhr.event_perfno_i = wo_header.event_perfno_i
WHERE
wo_header.issue_date IS NOT NULL
AND (REGEXP_LIKE( wo_header.ac_registr, REPLACE('@VAR.AC_REG@', ', ', '|')) OR '@VAR.AC_REG@' IS NULL)
AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE( '@VAR.AC_TYPE@', ', ', '|')) OR '@VAR.AC_TYPE@' IS NULL)
AND (REGEXP_LIKE( wo_header.ATA_CHAPTER, REPLACE( '@VAR.ATA@', ', ', '|')) OR '@VAR.ATA@' IS NULL)
AND (wo_header.issue_date &gt;= '@VAR.date1@' OR '@VAR.date1@' IS NULL)
AND (wo_header.issue_date &lt;= '@VAR.date2@' OR '@VAR.date2@' IS NULL)
AND (aircraft.status = '0' AND '@VAR.AC_STATUS@' = '0'
           OR aircraft.status = '9' AND  '@VAR.AC_STATUS@' = '9'
           OR  '@VAR.AC_STATUS@' = 'ALL')
AND (wo_header.type = 'M' AND '@VAR.WO_TYPE_M@' = 'Y'
           OR wo_header.type = 'C' AND '@VAR.WO_TYPE_C@' = 'Y'
           OR wo_header.type = 'P' AND '@VAR.WO_TYPE_P@' = 'Y'
           OR wo_header.type = 'S' AND '@VAR.WO_TYPE_S@' = 'Y'
           OR  '@VAR.WO_TYPE_ALL@' = 'Y')
AND (wo_header.issue_date &gt;= '@VAR.date1@' OR '@VAR.date1@' IS NULL)
AND (wo_header.issue_date &lt;= '@VAR.date2@' OR '@VAR.date2@' IS NULL)</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="RMX_WO_NO_ACTION" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.issue_sign" id="wo_header.issue_sign"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ATA_CHAPTER" id="wo_header.ATA_CHAPTER"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="&#10;               to_char(to_date('01.01.1970' 'dd.mm.yyyy') + ( wo_header.issue_date+729)'dd.mm.yyyy') as issue_date" id="issue_date"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.type" id="wo_header.type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.state" id="wo_header.state"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.mel_code" id="wo_header.mel_code"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header_more.mel_chapter" id="wo_header_more.mel_chapter"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_model" id="aircraft.ac_model"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="workstep_link_2.max_link" id="workstep_link_2.max_link"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_action.text" id="wo_text_action.text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.text" id="wo_text_description.text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="used_mhr.mhrs as used_mhrs" id="used_mhrs"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="planned_mhr.mhrs as planned_mhrs" id="planned_mhrs"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_REG@">
          <ds:object>@VAR.AC_REG@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_TYPE@">
          <ds:object>@VAR.AC_TYPE@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.ATA@">
          <ds:object>@VAR.ATA@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date1@">
          <ds:object>@VAR.date1@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.date2@">
          <ds:object>@VAR.date2@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.AC_STATUS@">
          <ds:object>@VAR.AC_STATUS@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_M@">
          <ds:object>@VAR.WO_TYPE_M@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_C@">
          <ds:object>@VAR.WO_TYPE_C@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_P@">
          <ds:object>@VAR.WO_TYPE_P@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_S@">
          <ds:object>@VAR.WO_TYPE_S@</ds:object>
        </ds:value>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.WO_TYPE_ALL@">
          <ds:object>@VAR.WO_TYPE_ALL@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT   
               wo_header.event_perfno_i
	,wo_header.issue_sign
               ,wo_header.ATA_CHAPTER
               ,wo_header.ac_registr
               ,to_char(to_date('01.01.1970', 'dd.mm.yyyy') + ( wo_header.issue_date+729),'dd.mm.yyyy') as issue_date              
               ,wo_header.type
               ,wo_header.state
               ,wo_header.mel_code
               ,wo_header_more.mel_chapter
               ,aircraft.ac_typ
               ,aircraft.ac_model
               ,workstep_link_2.max_link
               ,wo_text_action.text 
               ,wo_text_description.text
               ,used_mhr.mhrs as used_mhrs
               ,planned_mhr.mhrs as planned_mhrs         
FROM wo_header
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN wo_header_4 ON wo_header_more.event_perfno_i = wo_header_4.event_perfno_i
LEFT JOIN	(
			SELECT MAX(workstep_link.workstep_linkno_i) AS max_link
                                             	,workstep_link.event_perfno_i
			FROM workstep_link
			GROUP BY workstep_link.event_perfno_i
		 ) workstep_link_2 ON wo_header.event_perfno_i = workstep_link_2.event_perfno_i
LEFT JOIN wo_text_action ON workstep_link_2.max_link = wo_text_action.workstep_linkno_i
LEFT JOIN	(
			SELECT MIN(workstep_link.descno_i) AS min_descno_i
                                	            ,workstep_link.event_perfno_i
			FROM workstep_link
			GROUP BY workstep_link.event_perfno_i
		   ) workstep_link_3 ON wo_header.event_perfno_i = workstep_link_3.event_perfno_i
LEFT JOIN wo_text_description ON workstep_link_3.min_descno_i =  wo_text_description.descno_i 
LEFT JOIN (
                  SELECT TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(SUM(time_captured.duration*time_captured.prod_factor))/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(SUM(time_captured.duration*time_captured.prod_factor)),60)),'FM00') as mhrs,
                                 time_captured.primkey
                   FROM time_captured
                   WHERE 1=1 
                                 AND time_captured.mime_type IN  ('WO', 'MET')
                   GROUP BY time_captured.primkey
                  ) used_mhr ON used_mhr.primkey = wo_header.event_perfno_i  
LEFT JOIN(
                  SELECT TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(SUM(rm_resource_requirement.total_hours))/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(SUM(rm_resource_requirement.total_hours)),60)),'FM00') as mhrs,
                                workstep_link.event_perfno_i
                   FROM rm_resource_requirement
                   LEFT JOIN rm_resource_request ON rm_resource_request.resource_request_noi = rm_resource_requirement.resource_request_noi
                   LEFT JOIN workstep_link ON workstep_link.descno_i = rm_resource_request.request_owner_amos_key
                   GROUP BY workstep_link.event_perfno_i
                  ) planned_mhr ON planned_mhr.event_perfno_i = wo_header.event_perfno_i
WHERE
wo_header.issue_date IS NOT NULL
AND wo_header.state = 'O'
AND (REGEXP_LIKE( wo_header.ac_registr, REPLACE('@VAR.AC_REG@', ', ', '|')) OR '@VAR.AC_REG@' IS NULL)
AND (REGEXP_LIKE(aircraft.ac_typ, REPLACE( '@VAR.AC_TYPE@', ', ', '|')) OR '@VAR.AC_TYPE@' IS NULL)
AND (REGEXP_LIKE( wo_header.ATA_CHAPTER, REPLACE( '@VAR.ATA@', ', ', '|')) OR '@VAR.ATA@' IS NULL)
AND (wo_header.issue_date &gt;= '@VAR.date1@' OR '@VAR.date1@' IS NULL)
AND (wo_header.issue_date &lt;= '@VAR.date2@' OR '@VAR.date2@' IS NULL)
AND (aircraft.status = '0' AND '@VAR.AC_STATUS@' = '0'
           OR aircraft.status = '9' AND  '@VAR.AC_STATUS@' = '9'
           OR  '@VAR.AC_STATUS@' = 'ALL')
AND (wo_header.type = 'M' AND '@VAR.WO_TYPE_M@' = 'Y'
           OR wo_header.type = 'C' AND '@VAR.WO_TYPE_C@' = 'Y'
           OR wo_header.type = 'P' AND '@VAR.WO_TYPE_P@' = 'Y'
           OR wo_header.type = 'S' AND '@VAR.WO_TYPE_S@' = 'Y'
           OR  '@VAR.WO_TYPE_ALL@' = 'Y')
AND (wo_header.issue_date &gt;= '@VAR.date1@' OR '@VAR.date1@' IS NULL)
AND (wo_header.issue_date &lt;= '@VAR.date2@' OR '@VAR.date2@' IS NULL)
AND wo_text_action.text IS NULL</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
