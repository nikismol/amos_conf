  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors/>
      <ds:configurationParameters/>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="WO_INFO" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>Unknown data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.event_perfno_i" id="wo_header.event_perfno_i"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header.ac_registr" id="wo_header.ac_registr"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="aircraft.ac_typ" id="aircraft.ac_typ"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="CASE&#10;&#9;&#9;&#9;&#9;WHEN forecast.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970' 'dd.Mm.yyyy') + (forecast.absolute_due_at_ac+729) 'dd.Mm.yyyy')&#10;&#9;&#9;&#9;&#9;WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.absolute_due_at_ac))||' C'&#10;&#9;&#9;&#9;&#9;ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.absolute_due_at_ac)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.absolute_due_at_ac)60))'FM00') ||' H' &#10;                END AS Due_at" id="Due_at"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_text_description.text" id="wo_text_description.text"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(wo_header.est_groundtime)/60)'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(wo_header.est_groundtime)60))'FM00') ||' H' AS est_ground" id="est_ground"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_header_4.event_classification" id="wo_header_4.event_classification"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="special_code_link.special" id="special_code_link.special"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wo_remarks.wo_remarks" id="wo_remarks.wo_remarks"/>
      </ds:columnDescriptors>
      <ds:configurationParameters/>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>SELECT   
               wo_header.event_perfno_i
               ,wo_header.ac_registr
               ,aircraft.ac_typ
               ,CASE
				WHEN forecast.dimension = 'D' THEN TO_CHAR(TO_DATE('01.01.1970', 'dd.Mm.yyyy') + (forecast.absolute_due_at_ac+729), 'dd.Mm.yyyy')
				WHEN forecast.dimension = 'C' THEN TO_CHAR(TO_NUMBER(forecast.absolute_due_at_ac))||' C'
				ELSE TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(forecast.absolute_due_at_ac)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(forecast.absolute_due_at_ac),60)),'FM00') ||' H' 
                END AS Due_at
               ,wo_text_description.text
               ,TO_CHAR(TO_CHAR(TRUNC(TO_NUMBER(wo_header.est_groundtime)/60),'FM999999999900')) || ':' ||TO_CHAR(TRUNC(MOD(TO_NUMBER(wo_header.est_groundtime),60)),'FM00') ||' H' AS est_ground
               ,wo_header_4.event_classification
               ,special_code_link.special
               ,wo_remarks.wo_remarks
FROM wo_header
LEFT JOIN wp_assignment ON wo_header.event_perfno_i = wp_assignment.event_perfno_i
LEFT JOIN forecast ON wo_header.event_perfno_i = forecast.event AND forecast.event_type = 'W'
LEFT JOIN aircraft ON wo_header.ac_registr = aircraft.ac_registr
LEFT JOIN wo_header_more ON wo_header.event_perfno_i = wo_header_more.event_perfno_i
LEFT JOIN wo_header_4 ON wo_header.event_perfno_i = wo_header_4.event_perfno_i
LEFT JOIN	(
			SELECT MAX(workstep_link.workstep_linkno_i) AS max_link
                                             	,workstep_link.event_perfno_i
			FROM workstep_link
			GROUP BY workstep_link.event_perfno_i
		 ) workstep_link_2 ON wo_header.event_perfno_i = workstep_link_2.event_perfno_i
LEFT JOIN workstep_link workstep_link_4 ON workstep_link_2.max_link = workstep_link_4.workstep_linkno_i
LEFT JOIN workstep_link workstep_link_5 ON workstep_link_2.max_link = workstep_link_5.workstep_linkno_i
LEFT JOIN special_code_link ON workstep_link_5.descno_i = special_code_link.source_pk AND special_code_link.SOURCE_TYPE = 'WS'
LEFT JOIN wo_text_action ON workstep_link_2.max_link = wo_text_action.workstep_linkno_i
LEFT JOIN rm_resource_request ON workstep_link_2.max_link = rm_resource_request.request_owner_amos_key AND request_owner_amos_type = 'WS' AND rm_resource_request.resource_request_noi IS NOT NULL
LEFT JOIN	(
			SELECT MIN(workstep_link.descno_i) AS min_descno_i
                                	            ,workstep_link.event_perfno_i
			FROM workstep_link
			GROUP BY workstep_link.event_perfno_i
		   ) workstep_link_3 ON wo_header.event_perfno_i = workstep_link_3.event_perfno_i
LEFT JOIN wo_text_description ON workstep_link_3.min_descno_i =  wo_text_description.descno_i
LEFT JOIN
            (
            SELECT  wo_remarks.event_perfno_i,
                    RTRIM(XMLAGG(XMLELEMENT(E, wo_remarks.text, ',').EXTRACT('//text()') ORDER BY wo_remarks.text).GetClobVal(), CHR(10)) as wo_remarks
            FROM wo_remarks
            GROUP BY   wo_remarks.event_perfno_i
            ) wo_remarks ON wo_header.event_perfno_i = wo_remarks.event_perfno_i
WHERE
wo_header.issue_date IS NOT NULL
AND wp_assignment.wpno_i IS NULL
AND rm_resource_request.resource_request_noi IS NOT NULL
AND wo_header.state = 'O'
AND wo_text_action.actionno_i IS NULL
AND workstep_link_4.workstep_sign IN
(
SELECT DISTINCT login_sign 
FROM user_access 
WHERE user_access.user_group IN ('AEXT_MCC', 'ATS_MCC (TQ)', 'MCC', 'MCC (TQ)', 'MCC CABIN','MCC RRJ', 'MCC-INF')
)
ORDER BY wo_header.event_perfno_i</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
