  <dataSourceList>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="VAR" type="PARAMETER_DATASOURCE" version="2.0">
      <ds:description>Contains all user defined variables and constants.</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="WP" description="Workpackage" id="wpno"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="NONE" description="Workpackage" id="wpno">
          <ds:map>
            <ds:keyValuePair>
              <ds:key>defaultValue</ds:key>
              <ds:data/>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>multi</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>selectionValues</ds:key>
              <ds:data>*</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>relativeDate</ds:key>
              <ds:data>false</ds:data>
            </ds:keyValuePair>
            <ds:keyValuePair>
              <ds:key>mandatory</ds:key>
              <ds:data>true</ds:data>
            </ds:keyValuePair>
          </ds:map>
        </ds:value>
      </ds:configurationParameters>
    </ds:dataSource>
    <ds:dataSource xmlns:ds="http://www.swiss-as.com/xml/datasource_2.0" id="199_Taskcard_Included_In_WP" type="SQL_EDITOR_DATASOURCE" version="2.0">
      <ds:description>main data source</ds:description>
      <ds:columnDescriptors>
        <ds:columnDescriptor amosType="ALPHANUM" description="row_number() over(order by wpnoseqno_i) num" id="num"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="wpno" id="wpno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="e.event_name" id="e.event_name"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="case when taskcard_type = 'O'&#10;             then 'ODT'&#10;            when taskcard_type = 'B'&#10;             then 'BTC'&#10;            when taskcard_type = 'S'&#10;             then 'SRT'&#10;        end taskcard_type" id="taskcard_type"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="seqno_i seqno" id="seqno"/>
        <ds:columnDescriptor amosType="ALPHANUM" description="d.description TCSOURCE" id="TCSOURCE"/>
      </ds:columnDescriptors>
      <ds:configurationParameters>
        <ds:value amosType="ALPHANUM" description="string placeholder" id="@VAR.wpno@">
          <ds:object>@VAR.wpno@</ds:object>
        </ds:value>
      </ds:configurationParameters>
      <ds:sqlEditorDataSource>
        <se:sqlStatement xmlns:se="http://www.swiss-as.com/xml/sqlStatement_2.0" type="TEXT_EDITOR" version="2.0">
          <se:textStatement>select row_number() over(order by wpno, seqno_i) num
     , wpno
     , e.event_name
     , case when taskcard_type = 'O'
             then 'ODT'
            when taskcard_type = 'B'
             then 'BTC'
            when taskcard_type = 'S'
             then 'SRT'
        end taskcard_type
     , seqno_i seqno
     , TCSOURCE 
  from wp_header w
  join wp_assignment a on w.wpno_i = a.wpno_i
  join wo_event_link e on a.event_perfno_i = e.event_perfno_i
                      and event_type = 'TCEFFLI'
                      and taskcard_type in ('O', 'B', 'S')
  join wp_sequence q on e.event_perfno_i = q.event_perfno_i
  join msc_taskcard s on e.event_name = s.taskcardno
  join msc_maintenance_program m on s.mpno_i = m.mpno_i 
                                and m.status = 0
  join msc_taskcard_version mv on s.taskcardno_i = mv.taskcardno_i
  join msc_mprev_taskcards mp_rev on mv.taskcard_verno_i = mp_rev.taskcard_verno_i
  join msc_mp_revision rev on mp_rev.revisionno_i = rev.revisionno_i 
                          /* ревизии */
                          and rev.revision_status not in ('i', 't')
  left join (
             select listagg (description, ', ') within group (order by description) TCSOURCE
                  , source_pk
               from db_link
              where source_type = 'TCLS'
              group by source_pk
            ) d on mv.taskcard_verno_i = d.source_pk
  join (
        select ac_registr
             , ac_typ
          from aircraft
         group by ac_registr
             , ac_typ
       ) i on w.ac_registr = i.ac_registr
          and m.mpno = i.ac_typ
 where /* Workpackage */
   ('@VAR.wpno@' is null or
		 w.wpno_i in
		 (select trim(substr('@VAR.wpno@' || ',',
							  decode(level,
									 1,
									 0,
									 instr('@VAR.wpno@' || ',', ',', 1, level - 1) + 2),
							  instr('@VAR.wpno@' || ',', ',', 1, level) -
							  decode(level,
									 1,
									 1,
									 instr('@VAR.wpno@' || ',', ',', 1, level - 1) + 2)))
			 from dual
		   connect by level &lt;= length('@VAR.wpno@') -
					  length(replace('@VAR.wpno@', ',', '')) + 1))</se:textStatement>
        </se:sqlStatement>
      </ds:sqlEditorDataSource>
    </ds:dataSource>
  </dataSourceList>
</report>
